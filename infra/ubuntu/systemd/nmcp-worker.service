[Unit]
Description=No More Cloud Photos Core Worker (reclaim-only until issue 14)
Documentation=file:/usr/share/doc/nmcp/ubuntu-deployment.md
Requires=nmcp-migrate.service
After=nmcp-migrate.service
PartOf=nmcp.target

[Service]
Type=simple
User=nmcp
Group=nmcp
Slice=nmcp.slice
EnvironmentFile=/etc/nmcp/worker.env
ExecStart=/opt/nmcp/current/bin/core-worker
Restart=on-failure
RestartSec=5s
TimeoutStopSec=330s
KillMode=mixed
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
ReadWritePaths=/var/lib/nmcp/media
UMask=0077

[Install]
WantedBy=nmcp.target
