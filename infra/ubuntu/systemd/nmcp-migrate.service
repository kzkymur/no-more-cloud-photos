[Unit]
Description=No More Cloud Photos database migration
Documentation=file:/usr/share/doc/nmcp/ubuntu-deployment.md
Requires=postgresql.service
After=postgresql.service
Before=nmcp-api.service nmcp-worker.service

[Service]
Type=oneshot
User=nmcp
Group=nmcp
Slice=nmcp.slice
EnvironmentFile=/etc/nmcp/admin.env
ExecStart=/opt/nmcp/current/bin/nmcp-admin migrate up --json
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=nmcp.target
