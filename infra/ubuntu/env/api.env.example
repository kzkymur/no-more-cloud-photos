# Install as /etc/nmcp/api.env, owned by root:root and mode 0600.
NMCP_DATABASE_URL=postgres://nmcp_api:REPLACE_API_PASSWORD@127.0.0.1:5432/nmcp?sslmode=disable
NMCP_STORAGE_ROOT=/var/lib/nmcp/media
NMCP_FILE_BASE_URL=https://REPLACE_TAILNET_HOSTNAME:REPLACE_FILES_PORT/files/
NMCP_CURSOR_HMAC_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
NMCP_API_ADDR=127.0.0.1:8080
NMCP_LOG_LEVEL=info
NMCP_SHUTDOWN_TIMEOUT=30s
