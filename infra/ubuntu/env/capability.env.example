# Install as /etc/nmcp/capability.env, owned by root:root, mode 0644 or 0600.
# NON-SECRET settings for operator nmcp-admin commands, read by systemd (PID 1)
# for both documented invocations (docs/ubuntu-deployment.md, "Running
# nmcp-admin"). Never put a DSN or password here: database credentials arrive
# only through LoadCredential= (check.dsn / repair.dsn / admin.dsn).
NMCP_STORAGE_ROOT=/var/lib/nmcp/media
NMCP_BACKUP_ROOT=/var/lib/nmcp/backups
# Owner-only: read by the root post-restore `maintenance resume` path
# (docs/backup-operations.md). /var/lib/nmcp-restore is root:root 0700; the
# capability (uid nmcp) resume never reads it and refuses a restore maintenance.
NMCP_RESTORE_LEDGER_ROOT=/var/lib/nmcp-restore
# Owner-only: cleanup builds lifecycle URLs. Same value as api.env/worker.env.
NMCP_FILE_BASE_URL=https://REPLACE_TAILNET_HOSTNAME:REPLACE_FILES_PORT/files/
NMCP_LOG_LEVEL=info
NMCP_SHUTDOWN_TIMEOUT=30s
