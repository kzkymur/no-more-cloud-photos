# Install as /etc/nmcp/admin.env, owned by root:root and mode 0600.
NMCP_DATABASE_URL=postgres://nmcp_migrator:REPLACE_MIGRATOR_PASSWORD@127.0.0.1:5432/nmcp?sslmode=disable
NMCP_LOG_LEVEL=info
NMCP_SHUTDOWN_TIMEOUT=30s
# Media and backup roots, the same paths the services use. check, cleanup,
# repair and maintenance resume refuse to run (exit 2) without the storage root.
NMCP_STORAGE_ROOT=/var/lib/nmcp/media
NMCP_BACKUP_ROOT=/var/lib/nmcp/backups
# Capability logins for check / repair / maintenance resume. The documented
# operator invocation (docs/ubuntu-deployment.md, "Running nmcp-admin") passes
# /etc/nmcp/credentials/{check,repair}.dsn with LoadCredential=, and nmcp-admin
# prefers $CREDENTIALS_DIRECTORY/check.dsn and repair.dsn. These two paths are
# only the fallback when no systemd credential is present; nmcp (the operator
# user) cannot read the root:root 0600 files, so do not rely on them.
NMCP_CHECK_DATABASE_URL_FILE=/etc/nmcp/credentials/check.dsn
NMCP_REPAIR_DATABASE_URL_FILE=/etc/nmcp/credentials/repair.dsn
