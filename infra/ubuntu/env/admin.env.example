# Install as /etc/nmcp/admin.env, owned by root:root and mode 0600.
# Used ONLY by nmcp-migrate.service and the release installer's migration
# units. Operator nmcp-admin commands never receive this file: they read
# /etc/nmcp/capability.env, and get the migrator DSN (owner commands, as root)
# from /etc/nmcp/credentials/admin.dsn via LoadCredential=. See
# docs/ubuntu-deployment.md, "Running nmcp-admin".
NMCP_DATABASE_URL=postgres://nmcp_migrator:REPLACE_MIGRATOR_PASSWORD@127.0.0.1:5432/nmcp?sslmode=disable
NMCP_LOG_LEVEL=info
NMCP_SHUTDOWN_TIMEOUT=30s
