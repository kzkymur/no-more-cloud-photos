# Install as /etc/nmcp/admin.env, owned by root:root and mode 0600.
NMCP_DATABASE_URL=postgres://nmcp_migrator:REPLACE_MIGRATOR_PASSWORD@127.0.0.1:5432/nmcp?sslmode=disable
NMCP_LOG_LEVEL=info
NMCP_SHUTDOWN_TIMEOUT=30s
# Capability logins for `nmcp-admin check` / `nmcp-admin repair` only. Each file
# holds one DSN (see infra/ubuntu/credentials/*.dsn.example), root:root 0600.
NMCP_CHECK_DATABASE_URL_FILE=/etc/nmcp/credentials/check.dsn
NMCP_REPAIR_DATABASE_URL_FILE=/etc/nmcp/credentials/repair.dsn
