# Install /etc/nmcp/backup.env root:root 0600. No passwords or restore authority.
NMCP_DATABASE_URL=service=nmcp_backup_control
NMCP_BACKUP_ROOT=/var/lib/nmcp-backup
NMCP_BACKUP_DUMP_SERVICE=nmcp_backup_dump
NMCP_BACKUP_PG_DUMP=/usr/bin/pg_dump
NMCP_BACKUP_PG_RESTORE=/usr/bin/pg_restore
NMCP_LOG_LEVEL=info
NMCP_SHUTDOWN_TIMEOUT=30s
# PGSERVICEFILE, PGPASSFILE and NMCP_BACKUP_DUMP_PASSFILE are set by the unit using %d.
# Notification is required for a fully successful run. Install a reviewed fixed
# executable then add NMCP_BACKUP_NOTIFY_HOOK=/usr/local/libexec/nmcp/backup-notify
# Never use shell syntax, arguments, URLs, or secrets as the hook value.
