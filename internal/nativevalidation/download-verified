#!/usr/bin/env bash
set -euo pipefail

if [[ $# -ne 3 || $1 != /* || ! $3 =~ ^[0-9a-f]{64}$ ]]; then
  printf 'usage: %s ABSOLUTE_TARGET URL SHA256\n' "$0" >&2
  exit 2
fi

target=$1
url=$2
digest=$3
temporary=''
owned_identity=''
owned_fd=''

identity() {
  stat -c '%d:%i' -- "$1" 2>/dev/null
}

cleanup() {
  local status=$?
  trap - EXIT HUP INT TERM
  if [[ -n $temporary ]]; then
    rm -f -- "$temporary" || true
  fi
  if [[ -n $owned_identity && $(identity "$target" || true) == "$owned_identity" ]]; then
    rm -f -- "$target" 2>/dev/null || true
  fi
  if [[ -n $owned_fd ]]; then
    exec {owned_fd}<&-
  fi
  exit "$status"
}
trap cleanup EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

verified() {
  [[ -f $target && ! -L $target ]] &&
    printf '%s  %s\n' "$digest" "$target" | sha256sum --check --status
}

if [[ -e $target || -L $target ]] && ! verified; then
  if [[ -d $target && ! -L $target ]]; then
    printf 'verified download: refusing directory target: %s\n' "$target" >&2
    exit 73
  fi
  rm -f -- "$target"
fi

if ! verified; then
  temporary=$(mktemp "$target.download.XXXXXXXX")
  if curl --fail --location --silent --show-error --retry 2 --retry-all-errors \
    --connect-timeout 30 --max-time 300 "$url" --output "$temporary"; then
    :
  else
    status=$?
    exit "$status"
  fi
  printf '%s  %s\n' "$digest" "$temporary" | sha256sum --check --status
  exec {owned_fd}<"$temporary"
  owned_identity=$(identity "$temporary")
  mv -fT -- "$temporary" "$target"
  temporary=''
fi

if [[ -z $owned_identity ]]; then
  verified
  exit
fi
if [[ $(identity "$target" || true) != "$owned_identity" ]] || ! verified ||
  [[ $(identity "$target" || true) != "$owned_identity" ]]; then
  exit 1
fi
owned_identity=''
exec {owned_fd}<&-
owned_fd=''
