#!/usr/bin/env bash
# Acquire the identity-bound scripts/backup-ci-admission receipt for an
# infra-e2e job and export NMCP_E2E_BUDGET_RECEIPT via GITHUB_ENV.
#
# usage: scripts/infra-e2e-budget-acquire REQUIRED_SECONDS
#
# scripts/backup-ci-admission binds admission to THIS job's own record and
# accepts a run that GitHub still reports as `queued` (siblings waiting for
# runners), so a lagging run status no longer refuses. As a bounded defence,
# admission_refused:run_mismatch is still retried with backoff for at most
# NMCP_E2E_BUDGET_RETRY_SECONDS (default 180) while the API reports THIS run
# (same head and attempt) as `queued` or the API call fails, printing the
# API-reported status each time. A run_mismatch while the API reports any
# other status fails immediately.
#
# admission_refused:job_runner_pending (GitHub already lists THIS job but has
# not recorded its runner yet, normal in a job's first seconds) is retried
# with the same backoff for at most NMCP_E2E_RUNNER_PENDING_SECONDS (default
# 60). The helper still requires exactly one job matching name and runner
# before it admits; every other refusal fails immediately.
#
# Test hooks (scripts/test-infra-e2e-budget-acquire):
#   NMCP_E2E_ADMISSION_HELPER  admission command (default: scripts/backup-ci-admission)
#   NMCP_E2E_RETRY_BACKOFF     space-separated sleeps (default: "5 10 20 30"; the last repeats)
#   NMCP_E2E_RETRY_MAX_ATTEMPTS  cap on helper calls (default 0 = no cap; only the
#                                time window bounds production). Lets the test
#                                count retries without depending on wall-clock time.
set -euo pipefail

required=${1:?usage: infra-e2e-budget-acquire REQUIRED_SECONDS}
root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
helper=${NMCP_E2E_ADMISSION_HELPER:-$root/scripts/backup-ci-admission}
window=${NMCP_E2E_BUDGET_RETRY_SECONDS:-180}
max_attempts=${NMCP_E2E_RETRY_MAX_ATTEMPTS:-0}
case "$max_attempts" in ''|*[!0-9]*) echo "invalid NMCP_E2E_RETRY_MAX_ATTEMPTS" >&2; exit 2 ;; esac
read -r -a backoff <<<"${NMCP_E2E_RETRY_BACKOFF:-5 10 20 30}"
case "$window" in ''|*[!0-9]*) echo "invalid NMCP_E2E_BUDGET_RETRY_SECONDS" >&2; exit 2 ;; esac
pending_window=${NMCP_E2E_RUNNER_PENDING_SECONDS:-60}
case "$pending_window" in ''|*[!0-9]*) echo "invalid NMCP_E2E_RUNNER_PENDING_SECONDS" >&2; exit 2 ;; esac
receipt="$RUNNER_TEMP/.nmcp-e2e-budget.json"
[ ! -e "$receipt" ] || { echo "receipt already exists; never re-acquire" >&2; exit 1; }
deadline=$((SECONDS + window))
pending_deadline=$((SECONDS + pending_window))
umask 077
attempt=0
while :; do
  attempt=$((attempt + 1))
  status=0
  python3 -I "$helper" acquire --repo "$GITHUB_REPOSITORY" \
    --sha "${NMCP_E2E_BUDGET_RUN_SHA:?}" --job-name "${NMCP_E2E_BUDGET_JOB_NAME:?}" \
    --runner-name "$RUNNER_NAME" --run-id "$GITHUB_RUN_ID" --attempt "$GITHUB_RUN_ATTEMPT" \
    --job-seconds "${NMCP_E2E_BUDGET_JOB_SECONDS:?}" \
    --cleanup-seconds "${NMCP_E2E_BUDGET_CLEANUP_SECONDS:?}" \
    --margin-seconds "${NMCP_E2E_BUDGET_MARGIN_SECONDS:?}" \
    --required-seconds "$required" >"$receipt.tmp" 2>"$receipt.err" || status=$?
  if [ "$status" -eq 0 ]; then break; fi
  cat "$receipt.err" >&2
  observed=$(GH_TOKEN=${GITHUB_TOKEN:-} timeout 20 gh api \
    "repos/$GITHUB_REPOSITORY/actions/runs/$GITHUB_RUN_ID/attempts/$GITHUB_RUN_ATTEMPT" \
    --jq '"status=\(.status) head_sha=\(.head_sha) attempt=\(.run_attempt)"' 2>&1 || true)
  echo "admission diagnostics (attempt $attempt): $observed" >&2
  retryable=false
  limit=$deadline
  if grep -qx 'admission_refused:job_runner_pending' "$receipt.err"; then
    retryable=true
    limit=$pending_deadline
  elif grep -qx 'admission_refused:run_mismatch' "$receipt.err"; then
    case "$observed" in
      "status=queued head_sha=$NMCP_E2E_BUDGET_RUN_SHA attempt=$GITHUB_RUN_ATTEMPT") retryable=true ;;
      status=*) ;;  # the API reports another state: a real identity mismatch
      *) retryable=true ;;  # API unavailable: the helper itself still fails closed
    esac
  fi
  index=$((attempt - 1)); [ "$index" -lt "${#backoff[@]}" ] || index=$((${#backoff[@]} - 1))
  pause=${backoff[$index]}
  if [ "$retryable" = true ] && [ "$max_attempts" -gt 0 ] && [ "$attempt" -ge "$max_attempts" ]; then
    echo "admission: retry attempts exhausted ($attempt)" >&2
    rm -f -- "$receipt.tmp" "$receipt.err"
    exit 1
  fi
  if [ "$retryable" != true ] || [ $((SECONDS + pause)) -gt "$limit" ]; then
    if [ "$retryable" = true ]; then
      if [ "$limit" = "$pending_deadline" ]; then
        echo "admission: job runner still not recorded after ${pending_window}s" >&2
      else
        echo "admission: run still queued after ${window}s retry window" >&2
      fi
    fi
    rm -f -- "$receipt.tmp" "$receipt.err"
    exit 1
  fi
  sleep "$pause"
done
rm -f -- "$receipt.err"
mv -- "$receipt.tmp" "$receipt"
echo "NMCP_E2E_BUDGET_RECEIPT=$receipt" >>"$GITHUB_ENV"
echo "budget receipt acquired (required ${required}s, attempt $attempt)"
