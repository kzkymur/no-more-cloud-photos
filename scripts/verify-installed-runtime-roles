#!/usr/bin/env bash
set -euo pipefail
umask 0077

[[ $EUID -eq 0 ]] || { printf 'must run as root\n' >&2; exit 1; }
[[ $# -eq 1 && $1 =~ ^[0-9]+$ ]] || {
  printf 'usage: verify-installed-runtime-roles SQL_FD\n' >&2
  exit 2
}

sql_fd=$1
[[ -r /proc/self/fd/$sql_fd ]] || {
  printf 'runtime verifier descriptor is not readable\n' >&2
  exit 1
}

# The nmcp cluster's port, recorded by install-ubuntu-host. Absent only on
# hosts installed before the port was configurable, which all used 5432.
pg_port=5432
port_record=/etc/nmcp/postgresql-port
if [[ -e $port_record || -L $port_record ]]; then
  if ! [[ -f $port_record && ! -L $port_record \
    && $(/usr/bin/stat -c '%U:%G:%a' "$port_record") == root:root:644 ]]; then
    printf '%s: unsafe PostgreSQL port record\n' "${0##*/}" >&2
    exit 1
  fi
  pg_port=$(<"$port_record")
  if ! [[ $pg_port =~ ^[1-9][0-9]{3,4}$ ]] || ((pg_port > 65535)); then
    printf '%s: invalid PostgreSQL port record\n' "${0##*/}" >&2
    exit 1
  fi
fi

exec /usr/bin/env -i PATH=/usr/bin:/bin LC_ALL=C HOME=/var/lib/postgresql \
  /usr/sbin/runuser -u postgres -- /usr/bin/psql --no-psqlrc \
  --host=/var/run/postgresql --port="$pg_port" --username=postgres --dbname=nmcp \
  --set=ON_ERROR_STOP=1 <&"$sql_fd"
