#!/usr/bin/env python3
"""Pure ownership counterexamples; not a fake root/systemd execution proof."""
import ast
import tempfile
import copy
import hashlib
import importlib.machinery
import importlib.util
from pathlib import Path
import stat
import types
import unittest
loader=importlib.machinery.SourceFileLoader('cleanup',str(Path(__file__).with_name('cleanup-backup-root-fixture')))
spec=importlib.util.spec_from_loader(loader.name,loader)
m=importlib.util.module_from_spec(spec);loader.exec_module(m)
class Ownership(unittest.TestCase):
 def setUp(self):
  self.unit='postgresql@17-nmcp-offline-fixture.service';self.head='a'*40
  self.body=b'[Service]\nType=forking\nPIDFile=/tmp/nmcp-live-pg17-owned/data/postmaster.pid\n'
  self.file=types.SimpleNamespace(st_mode=stat.S_IFREG|0o644,st_uid=0,st_nlink=1,st_dev=1,st_ino=2)
  self.data=types.SimpleNamespace(st_mode=stat.S_IFDIR|0o700,st_dev=1,st_ino=3)
  self.record=dict(head=self.head,unit=self.unit,device=1,inode=2,sha256=hashlib.sha256(self.body).hexdigest(),data='/tmp/nmcp-live-pg17-owned/data',data_device=1,data_inode=3,socket='/run/nmcp-offline-fixture',port=5432,postgres='/opt/nmcp-pg17-ci/bin/postgres')
 def check(self,r=None,f=None,b=None,d=None):m.validate_pg(r or self.record,self.head,self.unit,f or self.file,b or self.body,d or self.data)
 def test_owned(self):self.check()
 def test_identity_and_scope(self):
  for key,value in [('head','b'*40),('unit','postgresql@17-other.service'),('device',9),('inode',9),('sha256','0'*64),('data','/var/lib/postgresql/17/main'),('data_inode',99),('socket','/run/other'),('port',1),('postgres','/bin/other')]:
   r=copy.deepcopy(self.record);r[key]=value
   with self.subTest(key=key),self.assertRaises(AssertionError):self.check(r=r)
 def test_owner_mode_type_links(self):
  for key,value in [('st_uid',1000),('st_mode',stat.S_IFREG|0o666),('st_mode',stat.S_IFLNK|0o644),('st_nlink',2)]:
   f=copy.copy(self.file);setattr(f,key,value)
   with self.subTest(key=key),self.assertRaises(AssertionError):self.check(f=f)
 def test_changed_unit_body(self):
  with self.assertRaises(AssertionError):self.check(b=self.body+b'ExecStart=/bin/other\n')
class RuntimeCredentials(unittest.TestCase):
 def test_absence_is_inspection_not_deletion(self):
  with tempfile.TemporaryDirectory() as d:
   p=Path(d)/'runtime';m.require_runtime_credentials_absent(p)
   p.mkdir()
   with self.assertRaises(AssertionError):m.require_runtime_credentials_absent(p)
   self.assertTrue(p.is_dir())
   link=Path(d)/'dangling';link.symlink_to(Path(d)/'missing')
   with self.assertRaises(AssertionError):m.require_runtime_credentials_absent(link)
   self.assertTrue(link.is_symlink())
 def test_exact_private_copy_contract(self):
  root=Path(__file__).resolve().parent.parent
  source=(root/'scripts/validate-backup-install').read_text().split("<<'PY'\n",1)[1].rsplit('\nPY',1)[0]
  tree=ast.parse(source)
  ns={}
  exec(compile(ast.Module(body=[n for n in tree.body if isinstance(n,ast.FunctionDef) and n.name in ('require','parse_unit','units')],type_ignores=[]),'<validator>','exec'),ns)
  service=(root/'infra/ubuntu/systemd/nmcp-backup.service').read_text()
  timer=(root/'infra/ubuntu/systemd/nmcp-backup.timer').read_text()
  negatives=[
   service.replace('RuntimeDirectoryMode=0700','RuntimeDirectoryMode=0755'),
   service.replace('RuntimeDirectoryPreserve=no','RuntimeDirectoryPreserve=yes'),
   service.replace('ExecStartPre=/usr/bin/install','ExecStartPre=+/usr/bin/install',1),
   service.replace('-m 0600','-m 0640',1),
   service.replace('/run/nmcp-backup/dump.pgpass','/tmp/dump.pgpass',1),
   service+'\nExecStartPre=/usr/bin/true\n',
   service+'\nReadWritePaths=/run\n',
   service.replace('Environment=PGPASSFILE=/run/nmcp-backup/control.pgpass','Environment=PGPASSFILE=%d/control.pgpass'),
  ]
  with tempfile.TemporaryDirectory() as d:
   base=Path(d);(base/'nmcp-backup.timer').write_text(timer)
   (base/'nmcp-backup.service').write_text(service);ns['units'](base)
   for bad in negatives:
    (base/'nmcp-backup.service').write_text(bad)
    with self.subTest(case=negatives.index(bad)),self.assertRaises(ValueError):ns['units'](base)

unittest.main()
