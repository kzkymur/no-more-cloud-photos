#!/usr/bin/python3
"""Safely establish NMCP deployment locks and exec their owner."""

import fcntl
import os
import stat
import sys


RUNTIME = "/run/nmcp-deploy"
PRIMARY = "deploy.lock"
EXECUTION = "migration-execution.lock"


def fail(message: str) -> "NoReturn":
    raise SystemExit(f"acquire-ubuntu-deployment-locks: {message}")


def trusted_directory(path: str) -> int:
    descriptor = os.open(path, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC)
    current = os.fstat(descriptor)
    visible = os.stat(path, follow_symlinks=False)
    if (
        not stat.S_ISDIR(current.st_mode)
        or current.st_uid != 0
        or current.st_gid != 0
        or stat.S_IMODE(current.st_mode) & 0o022
        or (current.st_dev, current.st_ino) != (visible.st_dev, visible.st_ino)
    ):
        fail(f"{path} is not a stable non-writable root-owned directory")
    return descriptor


def runtime_fd() -> int:
    parent_descriptor = trusted_directory("/run")
    try:
        os.mkdir("nmcp-deploy", 0o700, dir_fd=parent_descriptor)
    except FileExistsError:
        pass
    descriptor = os.open(
        "nmcp-deploy",
        os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC,
        dir_fd=parent_descriptor,
    )
    current = os.fstat(descriptor)
    path = os.stat("nmcp-deploy", dir_fd=parent_descriptor, follow_symlinks=False)
    if (
        not stat.S_ISDIR(current.st_mode)
        or current.st_uid != 0
        or current.st_gid != 0
        or stat.S_IMODE(current.st_mode) != 0o700
        or (current.st_dev, current.st_ino) != (path.st_dev, path.st_ino)
    ):
        fail("runtime directory must be stable root:root mode 0700")
    os.close(parent_descriptor)
    return descriptor


def lock_fd(directory: int, name: str) -> int:
    descriptor = os.open(
        name,
        os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW | os.O_CLOEXEC,
        0o600,
        dir_fd=directory,
    )
    current = os.fstat(descriptor)
    path = os.stat(name, dir_fd=directory, follow_symlinks=False)
    if (
        not stat.S_ISREG(current.st_mode)
        or current.st_uid != 0
        or current.st_gid != 0
        or stat.S_IMODE(current.st_mode) != 0o600
        or current.st_nlink != 1
        or (current.st_dev, current.st_ino) != (path.st_dev, path.st_ino)
    ):
        fail(f"{name} must be a stable root:root mode 0600 single-link regular file")
    return descriptor


def install_lock_fds(directory: int, primary: int, execution: int) -> None:
    safe_directory = fcntl.fcntl(directory, fcntl.F_DUPFD_CLOEXEC, 10)
    safe_primary = fcntl.fcntl(primary, fcntl.F_DUPFD_CLOEXEC, 10)
    safe_execution = fcntl.fcntl(execution, fcntl.F_DUPFD_CLOEXEC, 10)
    for descriptor in {directory, primary, execution}:
        os.close(descriptor)
    os.dup2(safe_primary, 9, inheritable=True)
    os.dup2(safe_execution, 8, inheritable=True)
    os.close(safe_primary)
    os.close(safe_execution)
    os.close(safe_directory)


def locked(descriptor: int) -> bool:
    try:
        fcntl.flock(descriptor, fcntl.LOCK_EX | fcntl.LOCK_NB)
        return True
    except BlockingIOError:
        return False


def exec_owner(mode: str, command: list[str]) -> None:
    os.umask(0o077)
    directory = runtime_fd()
    primary = lock_fd(directory, PRIMARY)
    execution = lock_fd(directory, EXECUTION)
    direct = locked(primary)
    if mode == "both":
        if not direct:
            fail("another NMCP deployment operation is active")
        if not locked(execution):
            fail("an orphaned migration execution is still active")
        lock_mode = "direct"
    elif mode == "migration":
        if direct:
            if not locked(execution):
                fail("an orphaned migration execution is still active")
            lock_mode = "direct"
        else:
            if locked(execution):
                fcntl.flock(execution, fcntl.LOCK_UN)
                fail("deployment owner does not hold the execution lease")
            lock_mode = "delegated"
    else:
        fail("unknown acquisition mode")
    install_lock_fds(directory, primary, execution)
    environment = os.environ.copy()
    environment["NMCP_LOCK_MODE"] = lock_mode
    os.execve(command[0], command, environment)


def verify(mode: str) -> None:
    directory = runtime_fd()
    expected = ((9, PRIMARY), (8, EXECUTION))
    for descriptor, name in expected:
        current = os.fstat(descriptor)
        path = os.stat(name, dir_fd=directory, follow_symlinks=False)
        if (
            not stat.S_ISREG(current.st_mode)
            or current.st_uid != 0
            or current.st_gid != 0
            or stat.S_IMODE(current.st_mode) != 0o600
            or current.st_nlink != 1
            or (current.st_dev, current.st_ino) != (path.st_dev, path.st_ino)
        ):
            fail(f"FD {descriptor} is not the stable {name}")
    if mode == "direct":
        if not locked(9) or not locked(8):
            fail("direct owner does not hold both deployment locks")
    elif mode == "delegated":
        if locked(9):
            fcntl.flock(9, fcntl.LOCK_UN)
            fail("delegated consumer unexpectedly acquired the primary lock")
        if locked(8):
            fcntl.flock(8, fcntl.LOCK_UN)
            fail("delegated consumer lacks an execution-lease owner")
    else:
        fail("unknown verification mode")


if len(sys.argv) >= 4 and sys.argv[1] in {"both", "migration"} and sys.argv[2] == "--":
    exec_owner(sys.argv[1], sys.argv[3:])
elif len(sys.argv) == 3 and sys.argv[1] == "verify":
    verify(sys.argv[2])
elif len(sys.argv) == 3 and sys.argv[1] == "validate-parent":
    os.close(trusted_directory(sys.argv[2]))
else:
    fail("usage: (both|migration) -- COMMAND [ARG ...] | verify MODE | validate-parent PATH")
