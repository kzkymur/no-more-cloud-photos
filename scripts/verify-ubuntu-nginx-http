#!/usr/bin/env bash
set -euo pipefail

test_ip=${NMCP_NGINX_TEST_IP:-100.64.0.10}
api_port=${NMCP_NGINX_TEST_API_PORT:-18443}
files_port=${NMCP_NGINX_TEST_FILES_PORT:-19443}
script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
repo_root=$(cd -- "$script_dir/.." && pwd -P)
work=$(mktemp -d)
nginx_pid=
cleanup() {
  if [[ -n $nginx_pid ]]; then kill "$nginx_pid" 2>/dev/null || true; wait "$nginx_pid" 2>/dev/null || true; fi
  rm -rf -- "$work"
}
trap cleanup EXIT

for command in nginx curl openssl python3; do
  command -v "$command" >/dev/null || { printf 'missing command: %s\n' "$command" >&2; exit 1; }
done

mkdir -p "$work/cache/client" "$work/cache/proxy" "$work/media/originals" "$work/media/renditions"
openssl req -x509 -newkey rsa:2048 -nodes -subj /CN=host.example.ts.net -days 1 \
  -keyout "$work/key.pem" -out "$work/cert.pem" >/dev/null 2>&1
"$repo_root/scripts/render-ubuntu-nginx" \
  --template "$repo_root/infra/ubuntu/nginx.conf.in" --output "$work/rendered.conf" \
  --api-listen "$test_ip:$api_port" --files-listen "$test_ip:$files_port" \
  --tailnet-hostname host.example.ts.net
python3 - "$work" <<'PY'
import pathlib, sys
work = pathlib.Path(sys.argv[1])
text = (work / "rendered.conf").read_text()
replacements = {
    "/run/credentials/nmcp-files.service/tls-cert.pem": str(work / "cert.pem"),
    "/run/credentials/nmcp-files.service/tls-key.pem": str(work / "key.pem"),
    "/run/nmcp-nginx/nginx.pid": str(work / "nginx.pid"),
    "/run/nmcp-nginx/client": str(work / "cache/client"),
    "/run/nmcp-nginx/proxy": str(work / "cache/proxy"),
    "/srv/nmcp/originals": str(work / "media/originals"),
    "/srv/nmcp/renditions": str(work / "media/renditions"),
}
for old, new in replacements.items():
    text = text.replace(old, new)
(work / "nginx.conf").write_text(text)
PY

original_id=aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa
rendition_id=bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb
profile_id=cccccccc-cccc-4ccc-8ccc-cccccccccccc
original_dir=$work/media/originals/aa/$original_id
rendition_dir=$work/media/renditions/aa/$original_id/$rendition_id
mkdir -p "$original_dir" "$rendition_dir"
printf '0123456789abcdef' > "$original_dir/original.jpg"
printf 'webp-fixture' > "$rendition_dir/$profile_id.webp"

# A canonical-looking symlink must not be served.
symlink_id=aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaab
mkdir -p "$work/media/originals/aa/$symlink_id"
ln -s "$original_dir/original.jpg" "$work/media/originals/aa/$symlink_id/original.jpg"

nginx -t -c "$work/nginx.conf"
nginx -c "$work/nginx.conf" -g 'daemon off;' >"$work/nginx.stdout" 2>"$work/nginx.stderr" &
nginx_pid=$!
base=https://$test_ip:$files_port
for attempt in {1..30}; do
  if curl --noproxy '*' --insecure --silent --fail --max-time 2 "$base/files-healthz" >/dev/null; then break; fi
  [[ $attempt -lt 30 ]] || { printf 'nginx did not become ready\n' >&2; exit 1; }
  sleep 0.2
done

url=$base/files/originals/aa/$original_id/original.jpg
headers=$work/headers
body=$work/body
status=$(curl --noproxy '*' --insecure --silent --show-error -D "$headers" -o "$body" -w '%{http_code}' "$url")
[[ $status == 200 ]] && cmp -s "$body" "$original_dir/original.jpg"
python3 - "$headers" <<'PY'
import pathlib, sys
headers = pathlib.Path(sys.argv[1]).read_text().lower()
for expected in (
    "content-type: image/jpeg", "accept-ranges: bytes",
    "cache-control: private, max-age=31536000, immutable",
    "x-content-type-options: nosniff",
):
    if expected not in headers:
        raise SystemExit(f"missing header: {expected}")
PY

status=$(curl --noproxy '*' --insecure --silent --show-error --head -o "$headers" -w '%{http_code}' "$url")
[[ $status == 200 ]]

range_case() {
  local range=$1 expected_status=$2 expected_body=${3-}
  local actual
  actual=$(curl --noproxy '*' --insecure --silent --show-error -H "Range: bytes=$range" \
    -D "$headers" -o "$body" -w '%{http_code}' "$url")
  [[ $actual == "$expected_status" ]] || { printf 'range %s returned %s\n' "$range" "$actual" >&2; return 1; }
  if [[ -n $expected_body ]]; then [[ $(<"$body") == "$expected_body" ]]; fi
}
range_case 0-3 206 0123
range_case 4- 206 456789abcdef
range_case -4 206 cdef
range_case 0-1,4-5 206
range_case 99- 416
python3 - "$headers" <<'PY'
import pathlib, sys
if "content-range: bytes */16" not in pathlib.Path(sys.argv[1]).read_text().lower():
    raise SystemExit("416 response lacks the unsatisfied Content-Range")
PY

etag=$(python3 - "$url" <<'PY'
import subprocess, sys
result = subprocess.run(["curl", "--noproxy", "*", "--insecure", "--silent", "--head", sys.argv[1]], check=True, capture_output=True, text=True)
for line in result.stdout.splitlines():
    if line.lower().startswith("etag:"):
        print(line.split(":", 1)[1].strip()); break
else:
    raise SystemExit("ETag missing")
PY
)
status=$(curl --noproxy '*' --insecure --silent -H "If-None-Match: $etag" -o "$body" -w '%{http_code}' "$url")
[[ $status == 304 ]]

assert_status() {
  local expected=$1 request_url=$2; shift 2
  local actual
  actual=$(curl --noproxy '*' --path-as-is --insecure --silent -o /dev/null -w '%{http_code}' "$@" "$request_url")
  [[ $actual == "$expected" ]] || { printf '%s returned %s, expected %s\n' "$request_url" "$actual" "$expected" >&2; return 1; }
}
assert_status 405 "$url" -X POST
assert_status 404 "$base/files/originals/aa/$original_id/"
assert_status 404 "$base/files/originals/aa/$original_id/arbitrary.jpg"
assert_status 404 "$base/files/backups/database.dump"
assert_status 400 "$base/files/originals/../renditions/file.webp"
assert_status 400 "$base/files/originals/%2e%2e/renditions/file.webp"
assert_status 400 "$base/files/originals/%2Fetc/passwd"
assert_status 400 "$base/files/originals/%ZZ"
assert_status 404 "$base/files/originals/ab/$original_id/original.jpg"
assert_status 404 "$base/files/originals/aa/${original_id^^}/original.jpg"
symlink_status=$(curl --noproxy '*' --insecure --silent -o /dev/null -w '%{http_code}' \
  "$base/files/originals/aa/$symlink_id/original.jpg")
[[ $symlink_status != 200 ]]

rendition_url=$base/files/renditions/aa/$original_id/$rendition_id/$profile_id.webp
status=$(curl --noproxy '*' --insecure --silent -D "$headers" -o "$body" -w '%{http_code}' "$rendition_url")
[[ $status == 200 && $(<"$body") == webp-fixture ]]
python3 - "$headers" <<'PY'
import pathlib, sys
if "content-type: image/webp" not in pathlib.Path(sys.argv[1]).read_text().lower():
    raise SystemExit("rendition MIME mismatch")
PY

printf 'Ubuntu production Nginx HTTP verification passed\n'
