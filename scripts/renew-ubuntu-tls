#!/usr/bin/env bash
set -euo pipefail

if [[ $# -ne 2 ]]; then
  printf 'usage: renew-ubuntu-tls CERTIFICATE PRIVATE_KEY\n' >&2
  exit 2
fi
[[ $EUID -eq 0 ]] || { printf 'renew-ubuntu-tls: must run as root\n' >&2; exit 1; }
script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
exec 9>/run/lock/nmcp-deploy.lock
/usr/bin/flock --exclusive --nonblock 9 || { printf 'renew-ubuntu-tls: another NMCP deployment operation is active\n' >&2; exit 1; }
hostname=$(</etc/nmcp/tailnet-hostname)
capture=$(/usr/bin/mktemp -d /run/nmcp-tls-input.XXXXXX)
temporary_link=/etc/nmcp/tls-current.new.$$
cleanup() {
  /usr/bin/rm -rf -- "$capture"
  /usr/bin/rm -f -- "$temporary_link"
}
trap cleanup EXIT
"$script_dir/capture-trusted-inputs" "$capture" "$1" cert.pem "$2" key.pem
/usr/bin/openssl x509 -in "$capture/cert.pem" -noout -checkend 604800 >/dev/null || {
  printf 'renew-ubuntu-tls: certificate must remain valid for at least seven days\n' >&2; exit 1;
}
/usr/bin/openssl x509 -in "$capture/cert.pem" -noout -checkhost "$hostname" >/dev/null
cert_public=$(/usr/bin/openssl x509 -in "$capture/cert.pem" -pubkey -noout | /usr/bin/openssl sha256)
key_public=$(/usr/bin/openssl pkey -in "$capture/key.pem" -pubout | /usr/bin/openssl sha256)
[[ $cert_public == "$key_public" ]] || { printf 'renew-ubuntu-tls: certificate and key do not match\n' >&2; exit 1; }
release_id=$(/usr/bin/sha256sum "$capture/cert.pem" "$capture/key.pem" | /usr/bin/sha256sum | /usr/bin/cut -d' ' -f1)
release=/etc/nmcp/tls-releases/$release_id
if [[ ! -e $release ]]; then
  /usr/bin/install -d -o root -g root -m 0700 "$release"
  /usr/bin/install -o root -g root -m 0600 "$capture/cert.pem" "$release/cert.pem"
  /usr/bin/install -o root -g root -m 0600 "$capture/key.pem" "$release/key.pem"
else
  /usr/bin/cmp --silent "$capture/cert.pem" "$release/cert.pem"
  /usr/bin/cmp --silent "$capture/key.pem" "$release/key.pem"
fi
[[ $(/usr/bin/stat -c '%U:%G:%a' "$release") == root:root:700 \
  && $(/usr/bin/stat -c '%U:%G:%a' "$release/cert.pem") == root:root:600 \
  && $(/usr/bin/stat -c '%U:%G:%a' "$release/key.pem") == root:root:600 ]] || {
  printf 'renew-ubuntu-tls: TLS generation ownership/mode is unsafe\n' >&2; exit 1;
}
old_target=$(/usr/bin/readlink -f /etc/nmcp/tls-current)
/usr/bin/ln -s -- "$release" "$temporary_link"
/usr/bin/mv -Tf -- "$temporary_link" /etc/nmcp/tls-current
if ! /usr/bin/systemctl restart nmcp-files.service || ! /usr/bin/systemctl is-active --quiet nmcp-files.service; then
  /usr/bin/ln -s -- "$old_target" "$temporary_link"
  /usr/bin/mv -Tf -- "$temporary_link" /etc/nmcp/tls-current
  /usr/bin/systemctl restart nmcp-files.service || true
  printf 'renew-ubuntu-tls: Nginx restart failed; previous TLS generation restored\n' >&2
  exit 1
fi
"$script_dir/check-ubuntu-tls-expiry"
printf 'Installed TLS generation %s and restarted Nginx\n' "$release_id"
