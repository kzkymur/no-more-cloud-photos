                killed.stage(
                    fault_hook=lambda point, expected=death_point: (
                        os.kill(os.getpid(), 9) if point == expected else None
                    )
                )
                os._exit(1)
            _, killed_status = os.waitpid(killed_pid, 0)
            assert os.WIFSIGNALED(killed_status) and os.WTERMSIG(killed_status) == 9
            retry = fake_store()
            intent, intent_fd = retry._read_intent()
            assert intent is not None
            assert intent["phase"] == ("planned" if death_point == "after-mkdir" else "bound")
            os.close(intent_fd)
            original_run = subprocess.run
            subprocess.run = lambda *args, **kwargs: subprocess.CompletedProcess(args[0], 0, "")
            try:
                retry.cleanup_project()
            finally:
                subprocess.run = original_run
