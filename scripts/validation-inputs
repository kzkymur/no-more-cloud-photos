#!/usr/bin/env python3
"""Descriptor-confined lifecycle for local validation Compose inputs."""

import array
import errno
import fcntl
import hashlib
import io
import json
import os
import re
import secrets
import socket
import stat
import subprocess
import sys
import tarfile
import tempfile
import time
import zlib


INPUTS = (
    ("NMCP_POSTGRES_INIT_SQL", "infra/validation/postgres-init.sql", "postgres-init.sql"),
    ("NMCP_RUNTIME_ROLES_SQL", "infra/postgresql/runtime-roles.sql", "runtime-roles.sql"),
    ("NMCP_UBUNTU_ROLES_SQL", "infra/ubuntu/postgresql-roles.sql", "postgresql-roles.sql"),
    ("NMCP_VERIFY_ROLE_GRAPH_SQL", "infra/postgresql/verify-runtime-role-graph.sql", "verify-runtime-role-graph.sql"),
    ("NMCP_VERIFY_RUNTIME_ROLES_SQL", "infra/validation/verify-runtime-roles.sql", "verify-runtime-roles.sql"),
)
NOFOLLOW = getattr(os, "O_NOFOLLOW", 0)
DIRECTORY = getattr(os, "O_DIRECTORY", 0)
MEMFD_FLAGS = getattr(os, "MFD_CLOEXEC", 0) | getattr(os, "MFD_ALLOW_SEALING", 0)
REQUIRED_SEALS = (
    getattr(fcntl, "F_SEAL_SEAL", 0)
    | getattr(fcntl, "F_SEAL_SHRINK", 0)
    | getattr(fcntl, "F_SEAL_GROW", 0)
    | getattr(fcntl, "F_SEAL_WRITE", 0)
)
POSTGRES_IMAGE = "postgres:17-alpine@sha256:b0f9560a2de083e2cc7382e75f808c7381a32852a7ec49117deedb300e552b24"


class UnsafeInput(RuntimeError):
    pass


class MissingVolume(UnsafeInput):
    pass


def check_project(project):
    if not project or project[0] not in "abcdefghijklmnopqrstuvwxyz0123456789":
        raise UnsafeInput(f"invalid validation project: {project!r}")
    if any(c not in "abcdefghijklmnopqrstuvwxyz0123456789_-" for c in project):
        raise UnsafeInput(f"invalid validation project: {project!r}")


def check_basename(name, project):
    prefix = project + "."
    suffix = name.removeprefix(prefix)
    if (
        not name
        or name in (".", "..", "/")
        or "/" in name
        or not name.startswith(prefix)
        or len(suffix) != 24
        or any(c not in "0123456789abcdef" for c in suffix)
        or any(c not in "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789._-" for c in name)
    ):
        raise UnsafeInput("Compose input registry does not contain a safe project basename")
    return name


def owned_directory(fd, uid, private=False):
    info = os.fstat(fd)
    if not stat.S_ISDIR(info.st_mode) or info.st_uid != uid:
        raise UnsafeInput("validation directory is not an owned directory")
    if private and stat.S_IMODE(info.st_mode) != 0o700:
        raise UnsafeInput("Compose input directory mode is not 0700")


def same_identity(first_fd, second_fd):
    first, second = os.fstat(first_fd), os.fstat(second_fd)
    return (first.st_dev, first.st_ino) == (second.st_dev, second.st_ino)


def canonical_json(value):
    return json.dumps(value, sort_keys=True, separators=(",", ":")).encode("ascii")


def read_fd(fd):
    size = os.fstat(fd).st_size
    data = os.pread(fd, size, 0)
    if len(data) != size:
        raise UnsafeInput("short read from verified input")
    return data


def sealed_bytes(name, data):
    if not hasattr(os, "memfd_create") or not REQUIRED_SEALS:
        raise UnsafeInput("sealed memfd support is required")
    fd = os.memfd_create(name, MEMFD_FLAGS)
    try:
        view = memoryview(data)
        while view:
            written = os.write(fd, view)
            view = view[written:]
        fcntl.fcntl(fd, fcntl.F_ADD_SEALS, REQUIRED_SEALS)
        if fcntl.fcntl(fd, fcntl.F_GET_SEALS) & REQUIRED_SEALS != REQUIRED_SEALS:
            raise UnsafeInput("verified input memfd was not fully sealed")
        return fd
    except Exception:
        os.close(fd)
        raise


def git_environment(extra=None):
    env = {
        key: value for key, value in os.environ.items()
        if not key.startswith("GIT_")
    }
    if extra:
        env.update(extra)
    return env


def read_limited(fd, limit, label):
    chunks = []
    remaining = limit + 1
    while remaining:
        chunk = os.read(fd, min(remaining, 4096))
        if not chunk:
            break
        chunks.append(chunk)
        remaining -= len(chunk)
    data = b"".join(chunks)
    if len(data) > limit:
        raise UnsafeInput(f"{label} is too large")
    return data


def git_output(gitdir_fd, commondir_fd, *arguments, text=False):
    gitdir = f"/proc/{os.getpid()}/fd/{gitdir_fd}"
    common = f"/proc/{os.getpid()}/fd/{commondir_fd}"
    return subprocess.check_output(
        ["git", "--no-replace-objects", f"--git-dir={gitdir}", *arguments],
        text=text,
        env=git_environment({
            "GIT_COMMON_DIR": common,
            "GIT_OBJECT_DIRECTORY": common + "/objects",
            "GIT_NO_LAZY_FETCH": "1",
        }),
    )


def read_verified_git_object(gitdir_fd, commondir_fd, expected_oid, expected_type, limit):
    if not re.fullmatch(r"(?:[0-9a-f]{40}|[0-9a-f]{64})", expected_oid):
        raise UnsafeInput("invalid expected Git object name")
    gitdir = f"/proc/{os.getpid()}/fd/{gitdir_fd}"
    common = f"/proc/{os.getpid()}/fd/{commondir_fd}"
    process = subprocess.Popen(
        ["git", "--no-replace-objects", f"--git-dir={gitdir}", "cat-file", "--batch"],
        stdin=subprocess.PIPE,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        env=git_environment({
            "GIT_COMMON_DIR": common,
            "GIT_OBJECT_DIRECTORY": common + "/objects",
            "GIT_NO_LAZY_FETCH": "1",
        }),
    )
    try:
        process.stdin.write(expected_oid.encode("ascii") + b"\n")
        process.stdin.close()
        header = process.stdout.readline(1025)
        if not header.endswith(b"\n") or len(header) > 1024:
            raise UnsafeInput("invalid Git object response header")
        fields = header[:-1].split(b" ")
        if len(fields) != 3:
            raise UnsafeInput("Git object is missing or malformed")
        returned_oid, object_type, raw_size = fields
        try:
            size = int(raw_size)
        except ValueError as exc:
            raise UnsafeInput("Git object has an invalid size") from exc
        if (
            returned_oid.decode("ascii", "strict") != expected_oid
            or object_type.decode("ascii", "strict") != expected_type
            or size < 0 or size > limit
        ):
            raise UnsafeInput("Git object identity, type, or size mismatch")
        chunks = []
        remaining = size
        while remaining:
            chunk = process.stdout.read(min(remaining, 65536))
            if not chunk:
                raise UnsafeInput("short Git object response")
            chunks.append(chunk)
            remaining -= len(chunk)
        data = b"".join(chunks)
        if process.stdout.read(1) != b"\n" or process.stdout.read(1) != b"":
            raise UnsafeInput("invalid Git object response terminator")
        if process.wait() != 0:
            raise UnsafeInput("Git object reader failed")
    except Exception:
        if process.poll() is None:
            process.kill()
        process.wait()
        raise
    algorithm = hashlib.sha1 if len(expected_oid) == 40 else hashlib.sha256
    frame = expected_type.encode("ascii") + b" " + str(len(data)).encode("ascii") + b"\0" + data
    if not secrets.compare_digest(algorithm(frame).hexdigest(), expected_oid):
        raise UnsafeInput(f"mutable Git {expected_type} bytes do not match their object name")
    return data


def commit_tree_oid(data, oid_length):
    first = data.split(b"\n", 1)[0]
    prefix = b"tree "
    if not first.startswith(prefix):
        raise UnsafeInput("verified Git commit has no leading tree")
    oid = first[len(prefix):]
    if len(oid) != oid_length or not re.fullmatch(b"[0-9a-f]+", oid):
        raise UnsafeInput("verified Git commit has an invalid tree object name")
    return oid.decode("ascii")


def parse_tree(data, oid_length):
    entries = {}
    offset = 0
    raw_oid_length = oid_length // 2
    while offset < len(data):
        space = data.find(b" ", offset)
        nul = data.find(b"\0", space + 1 if space >= 0 else offset)
        if space <= offset or nul <= space + 1 or nul + 1 + raw_oid_length > len(data):
            raise UnsafeInput("verified Git tree is malformed")
        mode = data[offset:space]
        name = data[space + 1:nul]
        if b"/" in name or name in (b"", b".", b"..") or name in entries:
            raise UnsafeInput("verified Git tree has an unsafe or duplicate name")
        raw_oid = data[nul + 1:nul + 1 + raw_oid_length]
        entries[name] = (mode, raw_oid.hex())
        offset = nul + 1 + raw_oid_length
    return entries


def tree_entry_oid(entries, name, expected_mode, tracked_path):
    try:
        mode, oid = entries[name]
    except KeyError as exc:
        raise UnsafeInput(f"tracked input is absent from verified Git tree: {tracked_path}") from exc
    if mode != expected_mode:
        kind = "tree" if expected_mode == b"40000" else "regular non-executable Git blob"
        raise UnsafeInput(f"tracked input is not a {kind}: {tracked_path}")
    return oid


def verified_commit_inputs(gitdir_fd, commondir_fd, commit_oid):
    oid_length = len(commit_oid)
    cache = {}

    def verified(oid, object_type, limit):
        key = (oid, object_type)
        if key not in cache:
            cache[key] = read_verified_git_object(
                gitdir_fd, commondir_fd, oid, object_type, limit,
            )
        return cache[key]

    commit = verified(commit_oid, "commit", 1024 * 1024)
    root_tree = commit_tree_oid(commit, oid_length)
    snapshots = {}
    for _, tracked_path, _ in INPUTS:
        tree_oid = root_tree
        parts = [os.fsencode(part) for part in tracked_path.split("/")]
        for index, part in enumerate(parts):
            tree = parse_tree(verified(tree_oid, "tree", 64 * 1024 * 1024), oid_length)
            if index < len(parts) - 1:
                tree_oid = tree_entry_oid(tree, part, b"40000", tracked_path)
            else:
                oid = tree_entry_oid(tree, part, b"100644", tracked_path)
                snapshots[tracked_path] = verified(oid, "blob", 64 * 1024 * 1024)
    return snapshots


def read_ref_value(base_fd, reference):
    current = os.dup(base_fd)
    try:
        parts = reference.split("/")
        for part in parts[:-1]:
            next_fd = os.open(part, os.O_RDONLY | DIRECTORY | NOFOLLOW, dir_fd=current)
            os.close(current)
            current = next_fd
        fd = os.open(parts[-1], os.O_RDONLY | NOFOLLOW, dir_fd=current)
        try:
            info = os.fstat(fd)
            if not stat.S_ISREG(info.st_mode):
                raise UnsafeInput("Git reference is not a regular file")
            return read_limited(fd, 4096, "Git reference").decode("ascii").strip()
        finally:
            os.close(fd)
    finally:
        os.close(current)


def read_packed_ref(commondir_fd, reference):
    try:
        fd = os.open("packed-refs", os.O_RDONLY | NOFOLLOW, dir_fd=commondir_fd)
    except FileNotFoundError as exc:
        raise UnsafeInput("repository HEAD reference is missing") from exc
    try:
        info = os.fstat(fd)
        if not stat.S_ISREG(info.st_mode):
            raise UnsafeInput("repository packed-refs is not a regular file")
        data = read_limited(fd, 16 * 1024 * 1024, "repository packed-refs")
    finally:
        os.close(fd)
    matches = []
    encoded = reference.encode("ascii")
    for line in data.splitlines():
        if not line or line.startswith((b"#", b"^")):
            continue
        fields = line.split(b" ", 1)
        if len(fields) != 2:
            raise UnsafeInput("repository packed-refs is malformed")
        if fields[1] == encoded:
            matches.append(fields[0].decode("ascii", "strict"))
    if len(matches) != 1:
        raise UnsafeInput("repository HEAD reference is missing or duplicated")
    return matches[0]


def resolve_pinned_ref(gitdir_fd, commondir_fd, reference):
    for _ in range(8):
        if (
            not re.fullmatch(r"refs/[A-Za-z0-9._/-]+", reference)
            or ".." in reference or "//" in reference or "/." in reference
            or reference.endswith(("/", ".", ".lock"))
        ):
            raise UnsafeInput("repository HEAD contains an unsafe symbolic reference")
        private = reference.startswith(("refs/worktree/", "refs/bisect/", "refs/rewritten/"))
        try:
            value = read_ref_value(gitdir_fd if private else commondir_fd, reference)
        except FileNotFoundError:
            if private:
                raise UnsafeInput("repository worktree-private HEAD reference is missing")
            value = read_packed_ref(commondir_fd, reference)
        if value.startswith("ref: "):
            reference = value[5:]
            continue
        if not re.fullmatch(r"(?:[0-9a-fA-F]{40}|[0-9a-fA-F]{64})", value):
            raise UnsafeInput("repository HEAD reference has an invalid object name")
        return value.lower()
    raise UnsafeInput("repository HEAD reference recursion is too deep")


def resolve_pinned_head(gitdir_fd, commondir_fd):
    head_fd = os.open("HEAD", os.O_RDONLY | NOFOLLOW, dir_fd=gitdir_fd)
    try:
        data = read_limited(head_fd, 4096, "repository HEAD")
    finally:
        os.close(head_fd)
    try:
        value = data.decode("ascii").strip()
    except UnicodeDecodeError as exc:
        raise UnsafeInput("repository HEAD is not ASCII") from exc
    if value.startswith("ref: "):
        reference = value[5:]
        return resolve_pinned_ref(gitdir_fd, commondir_fd, reference)
    else:
        if not re.fullmatch(r"(?:[0-9a-fA-F]{40}|[0-9a-fA-F]{64})", value):
            raise UnsafeInput("repository HEAD contains an invalid object name")
        return value.lower()


def reject_object_alternates(commondir_fd):
    objects_fd = info_fd = None
    try:
        try:
            objects_fd = os.open("objects", os.O_RDONLY | DIRECTORY | NOFOLLOW, dir_fd=commondir_fd)
            info_fd = os.open("info", os.O_RDONLY | DIRECTORY | NOFOLLOW, dir_fd=objects_fd)
        except FileNotFoundError:
            return
        for name in ("alternates", "http-alternates"):
            try:
                os.stat(name, dir_fd=info_fd, follow_symlinks=False)
            except FileNotFoundError:
                continue
            raise UnsafeInput("repository object alternates are not accepted")
    finally:
        for fd in (info_fd, objects_fd):
            if fd is not None:
                os.close(fd)


def reject_unsupported_ref_storage(commondir_fd):
    try:
        info = os.stat("reftable", dir_fd=commondir_fd, follow_symlinks=False)
    except FileNotFoundError:
        info = None
    if info is not None:
        raise UnsafeInput("repository reftable ref storage is not supported")
    try:
        config_fd = os.open("config", os.O_RDONLY | NOFOLLOW, dir_fd=commondir_fd)
    except FileNotFoundError:
        return
    try:
        info = os.fstat(config_fd)
        if not stat.S_ISREG(info.st_mode):
            raise UnsafeInput("repository config is not a regular file")
        config = read_limited(config_fd, 1024 * 1024, "repository config").decode("utf-8")
    except UnicodeDecodeError as exc:
        raise UnsafeInput("repository config is not UTF-8") from exc
    finally:
        os.close(config_fd)
    section = None
    for raw_line in config.splitlines():
        line = raw_line.strip()
        if not line or line.startswith(("#", ";")):
            continue
        if line.startswith("[") and line.endswith("]"):
            section = line[1:-1].strip().lower()
            continue
        if section == "extensions":
            key, separator, value = line.partition("=")
            if separator and key.strip().lower() == "refstorage" and value.strip().lower() != "files":
                raise UnsafeInput("repository ref storage must use loose/packed files")


def canonical_directory(path, label):
    canonical = os.path.realpath(path)
    if os.path.abspath(path) != canonical:
        raise UnsafeInput(f"repository {label} must be canonical and non-symlinked")
    fd = os.open(canonical, os.O_RDONLY | DIRECTORY | NOFOLLOW)
    if os.path.realpath(f"/proc/{os.getpid()}/fd/{fd}") != canonical:
        os.close(fd)
        raise UnsafeInput(f"repository {label} identity is not canonical")
    return canonical, fd


def read_git_path_file(fd, label):
    info = os.fstat(fd)
    if not stat.S_ISREG(info.st_mode) or info.st_size > 4096:
        raise UnsafeInput(f"repository {label} is not a bounded regular file")
    data = os.pread(fd, info.st_size, 0)
    if len(data) != info.st_size:
        raise UnsafeInput(f"short read from repository {label}")
    try:
        line = data.decode("utf-8").removesuffix("\n")
    except UnicodeDecodeError as exc:
        raise UnsafeInput(f"repository {label} is not UTF-8") from exc
    if not line or "\n" in line or "\r" in line:
        raise UnsafeInput(f"repository {label} has invalid syntax")
    return data, line


def resolve_checkout_git(root_path, root_fd, git_entry_fd):
    entry = os.fstat(git_entry_fd)
    entry_data = None
    if stat.S_ISDIR(entry.st_mode):
        gitdir_path = os.path.join(root_path, ".git")
        gitdir_fd = os.dup(git_entry_fd)
    elif stat.S_ISREG(entry.st_mode):
        entry_data, line = read_git_path_file(git_entry_fd, "gitfile")
        if not line.startswith("gitdir: "):
            raise UnsafeInput("repository gitfile does not name a gitdir")
        target = line.removeprefix("gitdir: ")
        if not target:
            raise UnsafeInput("repository gitfile has an empty gitdir")
        if not os.path.isabs(target):
            target = os.path.join(root_path, target)
        gitdir_path, gitdir_fd = canonical_directory(os.path.normpath(target), "gitdir")
    else:
        raise UnsafeInput("repository .git entry has an unsafe type")

    common_path = gitdir_path
    common_fd = os.dup(gitdir_fd)
    common_file_fd = None
    common_data = None
    backlink_data = None
    try:
        try:
            common_file_fd = os.open("commondir", os.O_RDONLY | NOFOLLOW, dir_fd=gitdir_fd)
        except FileNotFoundError:
            pass
        else:
            common_data, common_name = read_git_path_file(common_file_fd, "commondir")
            if not os.path.isabs(common_name):
                common_name = os.path.join(gitdir_path, common_name)
            os.close(common_fd)
            common_path, common_fd = canonical_directory(os.path.normpath(common_name), "commondir")
        if common_data is not None and entry_data is None:
            raise UnsafeInput("directory-style repository gitdir must not redirect commondir")
        if entry_data is not None and common_data is not None:
            worktrees_fd = member_fd = backlink_entry_fd = None
            try:
                if os.path.dirname(gitdir_path) != os.path.join(common_path, "worktrees"):
                    raise UnsafeInput("linked-worktree gitdir is not owned by its commondir")
                worktrees_fd = os.open(
                    "worktrees", os.O_RDONLY | DIRECTORY | NOFOLLOW, dir_fd=common_fd,
                )
                member_fd = os.open(
                    os.path.basename(gitdir_path), os.O_RDONLY | DIRECTORY | NOFOLLOW,
                    dir_fd=worktrees_fd,
                )
                if not same_identity(member_fd, gitdir_fd):
                    raise UnsafeInput("linked-worktree commondir does not own its admin gitdir")
                backlink_fd = os.open("gitdir", os.O_RDONLY | NOFOLLOW, dir_fd=gitdir_fd)
                try:
                    backlink_data, backlink_name = read_git_path_file(backlink_fd, "gitdir backlink")
                finally:
                    os.close(backlink_fd)
                if not os.path.isabs(backlink_name):
                    backlink_name = os.path.join(gitdir_path, backlink_name)
                backlink_name = os.path.abspath(os.path.normpath(backlink_name))
                if backlink_name != os.path.join(root_path, ".git"):
                    raise UnsafeInput("linked-worktree gitdir backlink does not name this checkout")
                backlink_entry_fd = os.open(backlink_name, os.O_RDONLY | NOFOLLOW)
                if not same_identity(backlink_entry_fd, git_entry_fd):
                    raise UnsafeInput("linked-worktree backlink does not identify this checkout gitfile")
            except OSError as exc:
                raise UnsafeInput("linked-worktree admin relationship is unsafe") from exc
            finally:
                for fd in (backlink_entry_fd, member_fd, worktrees_fd):
                    if fd is not None:
                        os.close(fd)
        reject_unsupported_ref_storage(common_fd)
        reject_object_alternates(common_fd)
        return (
            gitdir_path, gitdir_fd, entry_data, common_path, common_fd,
            common_data, backlink_data,
        )
    except Exception:
        os.close(common_fd)
        os.close(gitdir_fd)
        raise
    finally:
        if common_file_fd is not None:
            os.close(common_file_fd)


def open_directory(name, parent_fd, uid, private=False, create=False):
    if create:
        try:
            os.mkdir(name, 0o700, dir_fd=parent_fd)
        except FileExistsError:
            pass
    try:
        fd = os.open(name, os.O_RDONLY | DIRECTORY | NOFOLLOW, dir_fd=parent_fd)
    except OSError as exc:
        raise UnsafeInput(f"unsafe directory component: {name}") from exc
    try:
        owned_directory(fd, uid, private)
        return fd
    except Exception:
        os.close(fd)
        raise


def read_regular(name, parent_fd, uid, mode, limit=None):
    try:
        fd = os.open(name, os.O_RDONLY | NOFOLLOW, dir_fd=parent_fd)
    except OSError as exc:
        raise UnsafeInput(f"missing or unsafe regular file: {name}") from exc
    try:
        info = os.fstat(fd)
        if not stat.S_ISREG(info.st_mode) or info.st_uid != uid or stat.S_IMODE(info.st_mode) != mode:
            raise UnsafeInput(f"wrong type, owner, or mode on file: {name}")
        data = b""
        while True:
            chunk = os.read(fd, 65536)
            if not chunk:
                break
            data += chunk
            if limit is not None and len(data) > limit:
                raise UnsafeInput(f"oversized file: {name}")
        return fd, data
    except Exception:
        os.close(fd)
        raise


def remove_tree(fd):
    for name in os.listdir(fd):
        info = os.stat(name, dir_fd=fd, follow_symlinks=False)
        if stat.S_ISDIR(info.st_mode):
            child = os.open(name, os.O_RDONLY | DIRECTORY | NOFOLLOW, dir_fd=fd)
            try:
                remove_tree(child)
            finally:
                os.close(child)
            os.rmdir(name, dir_fd=fd)
        else:
            os.unlink(name, dir_fd=fd)


class Store:
    def __init__(
        self,
        root_path,
        root_fd,
        validation_fd,
        parent_fd,
        project,
        owner,
        uid=None,
        git_entry_fd=None,
        gitdir_path=None,
        gitdir_fd=None,
        commit_oid=None,
        git_entry_data=None,
        commondir_path=None,
        commondir_fd=None,
        commondir_data=None,
        git_backlink_data=None,
        source_snapshots=None,
    ):
        self.root_path = root_path
        self.root_fd = root_fd
        self.validation_fd = validation_fd
        self.parent_fd = parent_fd
        self.project = project
        self.owner = owner
        self.uid = os.getuid() if uid is None else uid
        self.git_entry_fd = git_entry_fd
        self.gitdir_path = gitdir_path
        self.gitdir_fd = gitdir_fd
        self.commit_oid = commit_oid or ("0" * 40)
        self.git_entry_data = git_entry_data
        self.commondir_path = commondir_path or gitdir_path
        self.commondir_fd = commondir_fd if commondir_fd is not None else gitdir_fd
        self.commondir_data = commondir_data
        self.git_backlink_data = git_backlink_data
        self.source_snapshots = source_snapshots
        self.basename = None
        self.stage_fd = None
        self.input_fds = {}
        self.input_image = None
        self.parent_path = os.path.join(root_path, ".validation", "compose-inputs")

    @property
    def registry(self):
        return self.project + ".registry"

    @property
    def intent(self):
        return self.project + ".intent"

    @property
    def volume(self):
        if self.basename is None:
            raise UnsafeInput("no Compose input stage is loaded")
        return self.project + "_compose-inputs_" + self.basename.removeprefix(self.project + ".")

    def close_stage(self):
        self.close_snapshot_fds()
        self.input_image = None
        if self.stage_fd is not None:
            os.close(self.stage_fd)
            self.stage_fd = None
        self.basename = None

    def close_snapshot_fds(self):
        for fd in self.input_fds.values():
            os.close(fd)
        self.input_fds.clear()

    def verify_git_identity(self):
        if self.gitdir_fd is None:
            return
        entry_fd = gitdir_fd = None
        try:
            entry_fd = os.open(".git", os.O_RDONLY | NOFOLLOW, dir_fd=self.root_fd)
            if not same_identity(self.git_entry_fd, entry_fd):
                raise UnsafeInput("repository git entry identity changed")
            if self.git_entry_data is not None:
                current_entry, _ = read_git_path_file(entry_fd, "gitfile")
                if current_entry != self.git_entry_data:
                    raise UnsafeInput("repository gitfile changed during validation")
            gitdir_fd = os.open(self.gitdir_path, os.O_RDONLY | DIRECTORY | NOFOLLOW)
            if not same_identity(self.gitdir_fd, gitdir_fd):
                raise UnsafeInput("repository gitdir identity changed")
            common_fd = os.open(self.commondir_path, os.O_RDONLY | DIRECTORY | NOFOLLOW)
            if not same_identity(self.commondir_fd, common_fd):
                raise UnsafeInput("repository commondir identity changed")
            reject_unsupported_ref_storage(common_fd)
            reject_object_alternates(common_fd)
            os.close(common_fd)
            if self.commondir_data is not None:
                common_file = os.open("commondir", os.O_RDONLY | NOFOLLOW, dir_fd=self.gitdir_fd)
                try:
                    current_common, _ = read_git_path_file(common_file, "commondir")
                finally:
                    os.close(common_file)
                if current_common != self.commondir_data:
                    raise UnsafeInput("repository commondir link changed during validation")
            if self.git_backlink_data is not None:
                backlink_file = os.open("gitdir", os.O_RDONLY | NOFOLLOW, dir_fd=self.gitdir_fd)
                try:
                    current_backlink, _ = read_git_path_file(backlink_file, "gitdir backlink")
                finally:
                    os.close(backlink_file)
                if current_backlink != self.git_backlink_data:
                    raise UnsafeInput("repository gitdir backlink changed during validation")
            current = resolve_pinned_head(self.gitdir_fd, self.commondir_fd)
            if current != self.commit_oid:
                raise UnsafeInput("repository HEAD changed during validation")
        finally:
            for fd in (gitdir_fd, entry_fd):
                if fd is not None:
                    os.close(fd)

    def verify_chain(self):
        root_fd = validation_fd = parent_fd = None
        try:
            root_fd = os.open(self.root_path, os.O_RDONLY | DIRECTORY | NOFOLLOW)
            if not same_identity(self.root_fd, root_fd):
                raise UnsafeInput("repository root identity changed")
            validation_fd = open_directory(".validation", root_fd, self.uid)
            if not same_identity(self.validation_fd, validation_fd):
                raise UnsafeInput("validation directory identity changed")
            parent_fd = open_directory("compose-inputs", validation_fd, self.uid, private=True)
            if not same_identity(self.parent_fd, parent_fd):
                raise UnsafeInput("Compose input parent identity changed")
        except OSError as exc:
            raise UnsafeInput("pinned Compose input parent is no longer repository-contained") from exc
        finally:
            for fd in (parent_fd, validation_fd, root_fd):
                if fd is not None:
                    os.close(fd)

    def clear_snapshots(self):
        self.close_snapshot_fds()

    def source_data(self, tracked_path):
        self.verify_git_identity()
        if self.gitdir_fd is not None and self.source_snapshots is None:
            self.source_snapshots = verified_commit_inputs(
                self.gitdir_fd, self.commondir_fd, self.commit_oid,
            )
        expected = self.source_snapshots[tracked_path] if self.gitdir_fd is not None else None
        parts = tracked_path.split("/")
        if any(part in ("", ".", "..") for part in parts):
            raise UnsafeInput("invalid tracked input path")
        current = os.dup(self.root_fd)
        try:
            for part in parts[:-1]:
                next_fd = open_directory(part, current, self.uid)
                os.close(current)
                current = next_fd
            fd = os.open(parts[-1], os.O_RDONLY | NOFOLLOW, dir_fd=current)
            try:
                info = os.fstat(fd)
                if not stat.S_ISREG(info.st_mode) or info.st_uid != self.uid:
                    raise UnsafeInput(f"unsafe tracked Compose input: {tracked_path}")
                data = b""
                while True:
                    chunk = os.read(fd, 65536)
                    if not chunk:
                        break
                    data += chunk
                    if expected is not None and len(data) > len(expected):
                        raise UnsafeInput(f"tracked Compose input exceeds its verified Git blob: {tracked_path}")
            finally:
                os.close(fd)
        finally:
            os.close(current)
        if expected is None:
            expected = data
        self.verify_git_identity()
        if data != expected:
            raise UnsafeInput(f"Compose input differs from the exact HEAD blob: {tracked_path}")
        return data

    def write_file(self, directory_fd, name, data, mode):
        temporary = ".tmp-" + secrets.token_hex(12)
        fd = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL | NOFOLLOW, mode, dir_fd=directory_fd)
        try:
            try:
                view = memoryview(data)
                while view:
                    written = os.write(fd, view)
                    view = view[written:]
                os.fchmod(fd, mode)
                os.fsync(fd)
            finally:
                os.close(fd)
            os.replace(temporary, name, src_dir_fd=directory_fd, dst_dir_fd=directory_fd)
        except Exception:
            try:
                os.unlink(temporary, dir_fd=directory_fd)
            except FileNotFoundError:
                pass
            raise

    def snapshot(self, output_name, data):
        return sealed_bytes(f"nmcp-{output_name}", data)

    def _intent_record(self, basename, stage_fd=None):
        root = os.fstat(self.root_fd)
        stage = os.fstat(stage_fd) if stage_fd is not None else None
        record = {
            "schema": 2,
            "phase": "bound" if stage is not None else "planned",
            "owner": self.owner,
            "project": self.project,
            "basename": basename,
            "commit": self.commit_oid,
            "repository": [root.st_dev, root.st_ino],
            "stage": [stage.st_dev, stage.st_ino] if stage is not None else None,
        }
        record["auth"] = hashlib.sha256(canonical_json(record)).hexdigest()
        return record

    def _read_intent(self):
        try:
            fd, raw = read_regular(self.intent, self.parent_fd, self.uid, 0o600, 4096)
        except UnsafeInput as exc:
            try:
                os.stat(self.intent, dir_fd=self.parent_fd, follow_symlinks=False)
            except FileNotFoundError:
                return None, None
            raise exc
        try:
            record = json.loads(raw)
            authenticated = dict(record) if isinstance(record, dict) else {}
            authentication = authenticated.pop("auth", None)
            root = os.fstat(self.root_fd)
            if (
                not isinstance(record, dict)
                or set(record) != {
                    "schema", "phase", "owner", "project", "basename", "commit",
                    "repository", "stage", "auth"
                }
                or record["schema"] != 2
                or record["phase"] not in ("planned", "bound")
                or record["owner"] != self.owner
                or record["project"] != self.project
                or check_basename(record["basename"], self.project) != record["basename"]
                or not isinstance(record["commit"], str)
                or len(record["commit"]) not in (40, 64)
                or record["repository"] != [root.st_dev, root.st_ino]
                or (
                    record["stage"] is not None
                    and (
                        not isinstance(record["stage"], list)
                        or len(record["stage"]) != 2
                        or not all(isinstance(value, int) for value in record["stage"])
                    )
                )
                or (record["phase"] == "planned") != (record["stage"] is None)
                or authentication != hashlib.sha256(canonical_json(authenticated)).hexdigest()
            ):
                raise UnsafeInput("invalid Compose input stage intent")
            return record, fd
        except (UnicodeDecodeError, json.JSONDecodeError, TypeError, KeyError) as exc:
            os.close(fd)
            raise UnsafeInput("invalid Compose input stage intent") from exc
        except Exception:
            os.close(fd)
            raise

    def _unlink_exact(self, name, pinned_fd):
        visible = os.open(name, os.O_RDONLY | NOFOLLOW, dir_fd=self.parent_fd)
        try:
            if not same_identity(pinned_fd, visible):
                raise UnsafeInput(f"{name} identity changed before cleanup")
        finally:
            os.close(visible)
        os.unlink(name, dir_fd=self.parent_fd)
        os.fsync(self.parent_fd)

    def recover_intent(self):
        record, intent_fd = self._read_intent()
        if record is None:
            return
        stage_fd = None
        try:
            basename = record["basename"]
            matches = [
                name for name in os.listdir(self.parent_fd)
                if name == basename or name.startswith(".delete-" + basename + "-")
            ]
            if not matches:
                self._unlink_exact(self.intent, intent_fd)
                return
            if len(matches) != 1:
                raise UnsafeInput("stage intent has ambiguous recovery artifacts")
            visible_name = matches[0]
            stage_fd = open_directory(visible_name, self.parent_fd, self.uid, private=True)
            entries = set(os.listdir(stage_fd))
            if record["phase"] == "planned":
                if entries:
                    raise UnsafeInput("planned stage intent names a nonempty directory")
            else:
                info = os.fstat(stage_fd)
                if record["stage"] != [info.st_dev, info.st_ino]:
                    raise UnsafeInput("bound stage intent identity does not match")
            try:
                os.stat(".owner", dir_fd=stage_fd, follow_symlinks=False)
            except FileNotFoundError:
                raw = None
            else:
                self._read_marker(stage_fd, basename, record)
                raw = True
            if entries and raw is None:
                raise UnsafeInput("nonempty intended stage has no ownership marker")
            detached = visible_name
            if visible_name == basename:
                detached = ".delete-" + basename + "-" + secrets.token_hex(12)
                os.rename(basename, detached, src_dir_fd=self.parent_fd, dst_dir_fd=self.parent_fd)
            detached_fd = os.open(detached, os.O_RDONLY | DIRECTORY | NOFOLLOW, dir_fd=self.parent_fd)
            try:
                if not same_identity(stage_fd, detached_fd):
                    raise UnsafeInput("intended stage changed during recovery detach")
                remove_tree(detached_fd)
            finally:
                os.close(detached_fd)
            os.rmdir(detached, dir_fd=self.parent_fd)
            self._unlink_exact(self.intent, intent_fd)
        finally:
            if stage_fd is not None:
                os.close(stage_fd)
            os.close(intent_fd)

    def stage(self, race_hook=None, fault_hook=None):
        self.verify_chain()
        if self.stage_fd is not None:
            self.verify()
            return self.basename
        self.recover_intent()
        basename = self.project + "." + secrets.token_hex(12)
        self.write_file(
            self.parent_fd, self.intent,
            canonical_json(self._intent_record(basename)) + b"\n", 0o600,
        )
        os.fsync(self.parent_fd)
        os.mkdir(basename, 0o700, dir_fd=self.parent_fd)
        os.fsync(self.parent_fd)
        if fault_hook:
            fault_hook("after-mkdir")
        stage_fd = None
        try:
            stage_fd = open_directory(basename, self.parent_fd, self.uid, private=True)
            self.write_file(
                self.parent_fd, self.intent,
                canonical_json(self._intent_record(basename, stage_fd)) + b"\n", 0o600,
            )
            os.fsync(self.parent_fd)
            if fault_hook:
                fault_hook("after-bind")
            marker = {
                "schema": 1,
                "owner": self.owner,
                "project": self.project,
                "basename": basename,
                "commit": self.commit_oid,
            }
            marker["auth"] = hashlib.sha256(canonical_json(marker)).hexdigest()
            self.write_file(stage_fd, ".owner", canonical_json(marker) + b"\n", 0o600)
            os.fsync(stage_fd)
            if fault_hook:
                fault_hook("after-owner")
            for index, (_, tracked_path, output_name) in enumerate(INPUTS):
                data = self.source_data(tracked_path)
                if race_hook:
                    race_hook(index)
                self.write_file(stage_fd, output_name, data, 0o644)
                if fault_hook:
                    fault_hook(f"after-input-{index}")
            os.fsync(stage_fd)
            if fault_hook:
                fault_hook("after-final-fsync")
            self.basename, self.stage_fd = basename, stage_fd
            self.verify()
            intent, intent_fd = self._read_intent()
            try:
                if intent["basename"] != basename or intent["phase"] != "bound":
                    raise UnsafeInput("Compose input stage intent changed")
                info = os.fstat(self.stage_fd)
                if intent["stage"] != [info.st_dev, info.st_ino]:
                    raise UnsafeInput("Compose input stage intent identity changed")
                self._read_marker(self.stage_fd, basename, intent)
                self._unlink_exact(self.intent, intent_fd)
            finally:
                os.close(intent_fd)
            stage_fd = None
            return basename
        except Exception:
            removed = False
            if stage_fd is not None:
                try:
                    self.close_snapshot_fds()
                    remove_tree(stage_fd)
                    os.rmdir(basename, dir_fd=self.parent_fd)
                    removed = True
                finally:
                    os.close(stage_fd)
                    if self.stage_fd == stage_fd:
                        self.stage_fd = None
                        self.basename = None
            else:
                try:
                    os.rmdir(basename, dir_fd=self.parent_fd)
                    removed = True
                except OSError:
                    pass
            if removed:
                try:
                    intent, intent_fd = self._read_intent()
                    if intent is not None and intent["basename"] == basename:
                        try:
                            self._unlink_exact(self.intent, intent_fd)
                        finally:
                            os.close(intent_fd)
                except UnsafeInput:
                    pass
            raise

    def _open_stage(self, basename):
        self.verify_chain()
        fd = open_directory(basename, self.parent_fd, self.uid, private=True)
        if self.stage_fd is not None:
            old = os.fstat(self.stage_fd)
            new = os.fstat(fd)
            if (old.st_dev, old.st_ino) != (new.st_dev, new.st_ino):
                os.close(fd)
                raise UnsafeInput("Compose input stage identity changed")
            os.close(fd)
            return
        self.basename, self.stage_fd = basename, fd

    def _read_marker(self, stage_fd, basename=None, intent=None):
        marker_fd, raw = read_regular(".owner", stage_fd, self.uid, 0o600, 4096)
        os.close(marker_fd)
        try:
            marker = json.loads(raw)
        except (UnicodeDecodeError, json.JSONDecodeError) as exc:
            raise UnsafeInput("invalid Compose input ownership marker") from exc
        if not isinstance(marker, dict):
            raise UnsafeInput("invalid Compose input ownership marker")
        expected = {"schema", "owner", "project", "basename", "commit", "auth"}
        authenticated = dict(marker)
        authentication = authenticated.pop("auth", None)
        expected_basename = self.basename if basename is None else basename
        if expected_basename is None and isinstance(marker.get("basename"), str):
            expected_basename = check_basename(marker["basename"], self.project)
        if (
            set(marker) != expected
            or marker["schema"] != 1
            or marker["owner"] != self.owner
            or marker["project"] != self.project
            or marker["basename"] != expected_basename
            or not isinstance(marker["commit"], str)
            or len(marker["commit"]) not in (40, 64)
            or (intent is not None and marker["commit"] != intent["commit"])
            or authentication != hashlib.sha256(canonical_json(authenticated)).hexdigest()
        ):
            raise UnsafeInput("invalid Compose input ownership marker")
        return marker

    def _verify_contents(self, stage_fd, verify_sources=True):
        owned_directory(stage_fd, self.uid, private=True)
        expected_names = {".owner", *(output_name for _, _, output_name in INPUTS)}
        if set(os.listdir(stage_fd)) != expected_names:
            raise UnsafeInput("Compose input stage contains unexpected entries")
        marker = self._read_marker(stage_fd)
        if verify_sources:
            self.verify_git_identity()
            if marker["commit"] != self.commit_oid:
                raise UnsafeInput("registered inputs belong to a different commit")
        opened = {}
        try:
            for variable, tracked_path, output_name in INPUTS:
                fd, data = read_regular(output_name, stage_fd, self.uid, 0o644)
                if verify_sources and data != self.source_data(tracked_path):
                    os.close(fd)
                    raise UnsafeInput(f"staged Compose input content drift: {output_name}")
                os.close(fd)
                opened[variable] = self.snapshot(output_name, data)
        except Exception:
            for fd in opened.values():
                os.close(fd)
            raise
        self.close_snapshot_fds()
        self.input_fds = opened

    def verify(self):
        self.verify_chain()
        if self.stage_fd is None or self.basename is None:
            raise UnsafeInput("no Compose input stage is loaded")
        current = os.open(self.basename, os.O_RDONLY | DIRECTORY | NOFOLLOW, dir_fd=self.parent_fd)
        try:
            pinned, visible = os.fstat(self.stage_fd), os.fstat(current)
            if (pinned.st_dev, pinned.st_ino) != (visible.st_dev, visible.st_ino):
                raise UnsafeInput("Compose input stage identity changed")
        finally:
            os.close(current)
        self._verify_contents(self.stage_fd)

    def verify_lifecycle(self):
        self.verify_chain()
        if self.stage_fd is None or self.basename is None:
            raise UnsafeInput("no Compose input stage is loaded")
        current = os.open(self.basename, os.O_RDONLY | DIRECTORY | NOFOLLOW, dir_fd=self.parent_fd)
        try:
            if not same_identity(self.stage_fd, current):
                raise UnsafeInput("Compose input stage identity changed")
        finally:
            os.close(current)
        self._verify_contents(self.stage_fd, verify_sources=False)

    def register(self):
        self.verify()
        root = os.fstat(self.root_fd)
        stage = os.fstat(self.stage_fd)
        record = {
            "schema": 1,
            "owner": self.owner,
            "project": self.project,
            "basename": self.basename,
            "commit": self._read_marker(self.stage_fd)["commit"],
            "repository": [root.st_dev, root.st_ino],
            "stage": [stage.st_dev, stage.st_ino],
        }
        record["auth"] = hashlib.sha256(canonical_json(record)).hexdigest()
        self.write_file(self.parent_fd, self.registry, canonical_json(record) + b"\n", 0o600)

    def restage(self, output_name):
        matches = [(path, name) for _, path, name in INPUTS if name == output_name]
        if len(matches) != 1 or self.stage_fd is None:
            raise UnsafeInput("invalid Compose input restage request")
        tracked_path, name = matches[0]
        self.write_file(self.stage_fd, name, self.source_data(tracked_path), 0o644)
        os.fsync(self.stage_fd)
        self.verify()

    def volume_manifest(self):
        files = {}
        for variable, tracked_path, _ in INPUTS:
            target = (
                "init/10-nmcp-roles.sql"
                if tracked_path == "infra/validation/postgres-init.sql"
                else tracked_path
            )
            data = read_fd(self.input_fds[variable])
            files[target] = {
                "sha256": hashlib.sha256(data).hexdigest(),
                "size": len(data),
                "mode": 0o444,
            }
        manifest = {
            "schema": 1,
            "owner": self.owner,
            "project": self.project,
            "basename": self.basename,
            "commit": self._read_marker(self.stage_fd)["commit"],
            "files": files,
        }
        digest = hashlib.sha256(canonical_json(manifest)).hexdigest()
        completion = canonical_json({"manifest": manifest, "digest": digest}) + b"\n"
        return manifest, digest, completion

    def expected_volume_labels(self, digest):
        return {
            "com.docker.compose.project": self.project,
            "com.docker.compose.volume": "compose-inputs",
            "com.nmcp.validation.owner": self.owner,
            "com.nmcp.validation.run": self.basename,
            "com.nmcp.validation.manifest": digest,
        }

    def expected_image_labels(self, digest):
        return {
            "com.nmcp.validation.kind": "compose-input-image",
            "com.nmcp.validation.owner": self.owner,
            "com.nmcp.validation.project": self.project,
            "com.nmcp.validation.run": self.basename,
            "com.nmcp.validation.manifest": digest,
        }

    def image_paths(self):
        paths = {}
        for variable, tracked_path, _ in INPUTS:
            target = (
                "docker-entrypoint-initdb.d/10-nmcp-roles.sql"
                if tracked_path == "infra/validation/postgres-init.sql"
                else "opt/nmcp-infra/" + tracked_path.removeprefix("infra/")
            )
            paths[target] = read_fd(self.input_fds[variable])
        return paths

    def inspect_image(self, image):
        inspect = subprocess.run(
            ["docker", "image", "inspect", image],
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            check=False,
        )
        if inspect.returncode != 0:
            raise UnsafeInput(f"immutable Compose input image is absent: {image}")
        return json.loads(inspect.stdout)[0]

    def validate_image(self, image):
        _, digest, completion = self.volume_manifest()
        details = self.inspect_image(image)
        labels = (details.get("Config") or {}).get("Labels") or {}
        expected_labels = self.expected_image_labels(digest)
        if any(labels.get(name) != value for name, value in expected_labels.items()):
            raise UnsafeInput("immutable Compose input image labels do not match verified bytes")
        base = self.inspect_image(POSTGRES_IMAGE)
        base_layers = (base.get("RootFS") or {}).get("Layers") or []
        image_layers = (details.get("RootFS") or {}).get("Layers") or []
        if image_layers[: len(base_layers)] != base_layers or len(image_layers) <= len(base_layers):
            raise UnsafeInput("immutable Compose input image is not derived from the pinned PostgreSQL image")
        base_config, image_config = base.get("Config") or {}, details.get("Config") or {}
        for key in (
            "Entrypoint", "Cmd", "User", "WorkingDir", "Env", "StopSignal",
            "Healthcheck", "Shell", "Volumes", "ExposedPorts",
        ):
            if image_config.get(key) != base_config.get(key):
                raise UnsafeInput(f"immutable Compose input image changed base configuration: {key}")
        result = subprocess.run(
            [
                "docker", "run", "--rm", "--network", "none", "--read-only",
                "--entrypoint", "tar", image, "-c", "-C", "/",
                "docker-entrypoint-initdb.d",
                "opt/nmcp-infra", "opt/nmcp-input-manifest",
            ],
            stdout=subprocess.PIPE,
            check=True,
        )
        expected_files = self.image_paths()
        expected_files["opt/nmcp-input-manifest/.nmcp-complete"] = completion
        expected_directories = {
            "docker-entrypoint-initdb.d",
            "opt/nmcp-infra", "opt/nmcp-infra/postgresql", "opt/nmcp-infra/ubuntu",
            "opt/nmcp-infra/validation", "opt/nmcp-input-manifest",
        }
        with tarfile.open(fileobj=io.BytesIO(result.stdout), mode="r:*") as contents:
            files = {}
            directories = set()
            for member in contents.getmembers():
                name = member.name.removeprefix("./").rstrip("/")
                if member.isfile():
                    stream = contents.extractfile(member)
                    files[name] = stream.read() if stream is not None else b""
                    if member.mode != 0o444 or member.uid != 0 or member.gid != 0:
                        raise UnsafeInput(f"unsafe immutable input image metadata: {name}")
                elif member.isdir():
                    directories.add(name)
                else:
                    raise UnsafeInput(f"unsafe immutable input image entry: {name}")
            if files != expected_files or directories != expected_directories:
                raise UnsafeInput("immutable Compose input image inventory or bytes differ")

    def publish_image(self):
        self.verify()
        if self.input_image is not None:
            self.validate_image(self.input_image)
            return self.input_image
        _, digest, completion = self.volume_manifest()
        labels = self.expected_image_labels(digest)
        context = io.BytesIO()
        image_paths = self.image_paths()
        dockerfile = [f"FROM {POSTGRES_IMAGE}"]
        with tarfile.open(fileobj=context, mode="w") as archive:
            for name, data in image_paths.items():
                context_name = "payload/" + name
                entry = tarfile.TarInfo(context_name)
                entry.mode = 0o444
                entry.size = len(data)
                archive.addfile(entry, io.BytesIO(data))
                dockerfile.append(f"COPY --chown=0:0 {context_name} /{name}")
            completion_name = "payload/opt/nmcp-input-manifest/.nmcp-complete"
            entry = tarfile.TarInfo(completion_name)
            entry.mode = 0o444
            entry.size = len(completion)
            archive.addfile(entry, io.BytesIO(completion))
            dockerfile.append(
                f"COPY --chown=0:0 {completion_name} /opt/nmcp-input-manifest/.nmcp-complete"
            )
            installed = ["/" + name for name in image_paths]
            installed.append("/opt/nmcp-input-manifest/.nmcp-complete")
            dockerfile.append("RUN chmod 0444 " + " ".join(installed))
            dockerfile_data = ("\n".join(dockerfile) + "\n").encode("ascii")
            entry = tarfile.TarInfo("Dockerfile")
            entry.mode = 0o444
            entry.size = len(dockerfile_data)
            archive.addfile(entry, io.BytesIO(dockerfile_data))
        build = ["docker", "build", "--quiet", "--pull=false", "--network", "none"]
        for name, value in labels.items():
            build.extend(("--label", f"{name}={value}"))
        build.append("-")
        result = subprocess.run(build, input=context.getvalue(), stdout=subprocess.PIPE, check=True)
        image = result.stdout.decode("ascii").strip().splitlines()[-1]
        if not image.startswith("sha256:"):
            raise UnsafeInput("Docker did not return an immutable image ID")
        self.validate_image(image)
        self.input_image = image
        return image

    def inspect_volume(self, volume):
        inspect = subprocess.run(
            ["docker", "volume", "inspect", volume],
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            check=False,
        )
        if inspect.returncode != 0:
            raise MissingVolume(f"Compose input volume is absent: {volume}")
        return json.loads(inspect.stdout)[0]

    def volume_archive(self, volume):
        result = subprocess.run(
            [
                "docker", "run", "--rm", "--network", "none",
                "--volume", f"{volume}:/inputs:ro",
                "--entrypoint", "tar",
                "postgres:17-alpine@sha256:b0f9560a2de083e2cc7382e75f808c7381a32852a7ec49117deedb300e552b24",
                "-c", "-C", "/inputs", ".",
            ],
            stdout=subprocess.PIPE,
            check=True,
        )
        return result.stdout

    def validate_volume(self, volume, allow_empty=False):
        manifest, digest, completion = self.volume_manifest()
        details = self.inspect_volume(volume)
        labels = details.get("Labels") or {}
        expected_labels = self.expected_volume_labels(digest)
        if any(labels.get(name) != value for name, value in expected_labels.items()):
            raise UnsafeInput("Compose input volume labels do not match the verified manifest")
        archive = self.volume_archive(volume)
        with tarfile.open(fileobj=io.BytesIO(archive), mode="r:*") as contents:
            members = {}
            for member in contents.getmembers():
                name = member.name.removeprefix("./").rstrip("/")
                if name in ("", "."):
                    continue
                if name in members:
                    raise UnsafeInput("Compose input volume contains duplicate entries")
                members[name] = member
            if allow_empty and not members:
                return
            expected_dirs = {"init", "infra", "infra/postgresql", "infra/ubuntu", "infra/validation"}
            expected_files = set(manifest["files"]) | {".nmcp-complete"}
            if set(members) != expected_dirs | expected_files:
                raise UnsafeInput(
                    "Compose input volume inventory is incomplete or unexpected: "
                    + repr(sorted(members))
                )
            for name in expected_dirs:
                member = members[name]
                if not member.isdir() or member.mode != 0o555 or member.uid != 0 or member.gid != 0:
                    raise UnsafeInput(f"unsafe Compose input volume directory metadata: {name}")
            for name in expected_files:
                member = members[name]
                if not member.isfile() or member.mode != 0o444 or member.uid != 0 or member.gid != 0:
                    raise UnsafeInput(f"unsafe Compose input volume file metadata: {name}")
                stream = contents.extractfile(member)
                data = stream.read() if stream is not None else b""
                if name == ".nmcp-complete":
                    if data != completion:
                        raise UnsafeInput("Compose input volume completion record is invalid")
                    continue
                expected = manifest["files"][name]
                if len(data) != expected["size"] or hashlib.sha256(data).hexdigest() != expected["sha256"]:
                    raise UnsafeInput(f"Compose input volume content drift: {name}")

    def remove_volume(self, volume, labels):
        command = ["docker", "volume", "prune", "--all", "--force"]
        for name, value in sorted(labels.items()):
            command.extend(("--filter", f"label={name}={value}"))
        subprocess.run(command, stdout=subprocess.DEVNULL, check=True)
        try:
            remaining = self.inspect_volume(volume)
        except MissingVolume:
            return
        current = remaining.get("Labels") or {}
        if all(current.get(name) == value for name, value in labels.items()):
            raise UnsafeInput("owned Compose input volume remains after filtered prune")
        raise UnsafeInput("foreign replacement preserved after filtered volume prune")

    def publish(self, create_hook=None):
        self.verify()
        volume = self.volume
        manifest, digest, completion = self.volume_manifest()
        expected_labels = self.expected_volume_labels(digest)
        try:
            self.validate_volume(volume)
            self.publish_image()
            return volume
        except MissingVolume:
            pass
        except UnsafeInput:
            details = self.inspect_volume(volume)
            labels = details.get("Labels") or {}
            if any(labels.get(name) != value for name, value in expected_labels.items()):
                raise
            self.remove_volume(volume, expected_labels)

        archive = io.BytesIO()
        with tarfile.open(fileobj=archive, mode="w") as output:
            for name in ("init", "infra", "infra/postgresql", "infra/ubuntu", "infra/validation"):
                entry = tarfile.TarInfo(name)
                entry.type = tarfile.DIRTYPE
                entry.mode = 0o555
                output.addfile(entry)
            for variable, tracked_path, _ in INPUTS:
                name = "init/10-nmcp-roles.sql" if tracked_path == "infra/validation/postgres-init.sql" else tracked_path
                data = read_fd(self.input_fds[variable])
                entry = tarfile.TarInfo(name)
                entry.mode = 0o444
                entry.size = len(data)
                output.addfile(entry, io.BytesIO(data))
            entry = tarfile.TarInfo(".nmcp-complete")
            entry.mode = 0o444
            entry.size = len(completion)
            output.addfile(entry, io.BytesIO(completion))
        if create_hook:
            create_hook(volume, expected_labels)
        last_error = None
        for _ in range(2):
            labels_match = False
            try:
                create = ["docker", "volume", "create"]
                for name, value in expected_labels.items():
                    create.extend(("--label", f"{name}={value}"))
                create.append(volume)
                subprocess.run(create, stdout=subprocess.DEVNULL, check=True)
                details = self.inspect_volume(volume)
                labels = details.get("Labels") or {}
                labels_match = all(labels.get(name) == value for name, value in expected_labels.items())
                if not labels_match:
                    raise UnsafeInput("Compose input volume create race produced unowned labels")
                self.validate_volume(volume, allow_empty=True)
                subprocess.run(
                    [
                        "docker", "run", "--rm", "--interactive", "--network", "none",
                        "--volume", f"{volume}:/inputs",
                        "--entrypoint", "sh",
                        "postgres:17-alpine@sha256:b0f9560a2de083e2cc7382e75f808c7381a32852a7ec49117deedb300e552b24",
                        "-eu", "-c", "tar -x -C /inputs",
                    ],
                    input=archive.getvalue(),
                    stdout=subprocess.DEVNULL,
                    check=True,
                )
                self.validate_volume(volume)
                self.publish_image()
                return volume
            except Exception as exc:
                last_error = exc
                if not labels_match:
                    raise
                try:
                    self.remove_volume(volume, expected_labels)
                except Exception:
                    pass
        raise last_error

    def volume_security_test(self):
        volume = self.publish()
        image = "postgres:17-alpine@sha256:b0f9560a2de083e2cc7382e75f808c7381a32852a7ec49117deedb300e552b24"
        corruptions = (
            ("content bytes", "printf evil > /inputs/infra/postgresql/runtime-roles.sql"),
            ("file mode", "chmod 0644 /inputs/infra/postgresql/runtime-roles.sql"),
            ("missing completion", "rm /inputs/.nmcp-complete"),
            ("missing expected entry", "rm /inputs/infra/postgresql/runtime-roles.sql"),
            ("unexpected entry", "touch /inputs/unexpected"),
        )
        for label, mutation in corruptions:
            subprocess.run(
                [
                    "docker", "run", "--rm", "--network", "none", "--volume", f"{volume}:/inputs",
                    "--entrypoint", "sh", image, "-eu", "-c", mutation,
                ],
                stdout=subprocess.DEVNULL,
                check=True,
            )
            try:
                self.validate_volume(volume)
            except UnsafeInput:
                pass
            else:
                raise UnsafeInput(f"Compose input volume accepted isolated corruption: {label}")
            if self.publish() != volume:
                raise UnsafeInput("Compose input volume identity changed during repair")
            self.validate_volume(volume)
        self.unpublish()

        def create_partial(name, labels):
            create = ["docker", "volume", "create"]
            for label, value in labels.items():
                create.extend(("--label", f"{label}={value}"))
            create.append(name)
            subprocess.run(create, stdout=subprocess.DEVNULL, check=True)
            subprocess.run(
                [
                    "docker", "run", "--rm", "--network", "none", "--volume", f"{name}:/inputs",
                    "--entrypoint", "sh", image, "-eu", "-c", "mkdir -p /inputs/infra; printf partial > /inputs/infra/partial",
                ],
                stdout=subprocess.DEVNULL,
                check=True,
            )

        self.publish(create_hook=create_partial)
        self.validate_volume(volume)
        return volume

    def image_security_test(self):
        volume = self.publish()
        image = self.input_image
        if not image:
            raise UnsafeInput("immutable Compose input image was not published")
        subprocess.run(
            [
                "docker", "run", "--rm", "--network", "none",
                "--volume", f"{volume}:/inputs", "--entrypoint", "sh", POSTGRES_IMAGE,
                "-eu", "-c", "printf consumer-race > /inputs/infra/postgresql/runtime-roles.sql; rm -f /inputs/.nmcp-complete",
            ],
            stdout=subprocess.DEVNULL,
            check=True,
        )
        self.validate_image(image)
        return image

    def seed_partial_volume_and_wait(self):
        if os.environ.get("NMCP_VALIDATION_KILL_TEST") != "1":
            raise UnsafeInput("partial-volume kill test is not enabled")
        self.verify()
        volume = self.volume
        _, digest, _ = self.volume_manifest()
        labels = self.expected_volume_labels(digest)
        try:
            self.remove_volume(volume, labels)
        except MissingVolume:
            pass
        create = ["docker", "volume", "create"]
        for label, value in labels.items():
            create.extend(("--label", f"{label}={value}"))
        create.append(volume)
        subprocess.run(create, stdout=subprocess.DEVNULL, check=True)
        subprocess.run(
            [
                "docker", "run", "--rm", "--network", "none", "--volume", f"{volume}:/inputs",
                "--entrypoint", "sh",
                "postgres:17-alpine@sha256:b0f9560a2de083e2cc7382e75f808c7381a32852a7ec49117deedb300e552b24",
                "-eu", "-c", "mkdir -p /inputs/infra; printf killed-partial > /inputs/infra/partial",
            ],
            stdout=subprocess.DEVNULL,
            check=True,
        )
        ready = os.environ.get("NMCP_VALIDATION_KILL_READY")
        if ready:
            ready_fd = os.open(ready, os.O_WRONLY | os.O_CREAT | os.O_EXCL | NOFOLLOW, 0o600)
            try:
                os.write(ready_fd, (volume + "\n").encode("ascii"))
                os.fsync(ready_fd)
            finally:
                os.close(ready_fd)
        while True:
            time.sleep(60)

    def unpublish(self):
        volume = self.volume
        inspect = subprocess.run(
            ["docker", "volume", "inspect", volume],
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            check=False,
        )
        if inspect.returncode != 0:
            return
        details = json.loads(inspect.stdout)[0]
        labels = details.get("Labels") or {}
        if (
            labels.get("com.docker.compose.project") != self.project
            or labels.get("com.docker.compose.volume") != "compose-inputs"
            or labels.get("com.nmcp.validation.owner") != self.owner
            or labels.get("com.nmcp.validation.run") != self.basename
        ):
            raise UnsafeInput("refusing to remove an unowned Compose input volume")
        self.remove_volume(volume, {
            "com.docker.compose.project": self.project,
            "com.docker.compose.volume": "compose-inputs",
            "com.nmcp.validation.owner": self.owner,
            "com.nmcp.validation.run": self.basename,
        })

    def _read_registry_record(self):
        self.verify_chain()
        try:
            fd, data = read_regular(self.registry, self.parent_fd, self.uid, 0o600, 4096)
        except UnsafeInput as exc:
            try:
                os.stat(self.registry, dir_fd=self.parent_fd, follow_symlinks=False)
            except FileNotFoundError:
                return None, None
            raise exc
        try:
            record = json.loads(data)
            authenticated = dict(record) if isinstance(record, dict) else {}
            authentication = authenticated.pop("auth", None)
            root = os.fstat(self.root_fd)
            if (
                not isinstance(record, dict)
                or set(record) != {
                    "schema", "owner", "project", "basename", "commit",
                    "repository", "stage", "auth"
                }
                or record["schema"] != 1
                or record["owner"] != self.owner
                or record["project"] != self.project
                or check_basename(record["basename"], self.project) != record["basename"]
                or not isinstance(record["commit"], str)
                or len(record["commit"]) not in (40, 64)
                or record["repository"] != [root.st_dev, root.st_ino]
                or not isinstance(record["stage"], list)
                or len(record["stage"]) != 2
                or not all(isinstance(value, int) for value in record["stage"])
                or authentication != hashlib.sha256(canonical_json(authenticated)).hexdigest()
            ):
                raise UnsafeInput("invalid Compose input registry")
            return record, fd
        except (UnicodeDecodeError, json.JSONDecodeError, TypeError, KeyError) as exc:
            os.close(fd)
            raise UnsafeInput("invalid Compose input registry") from exc
        except Exception:
            os.close(fd)
            raise

    def _read_registry(self):
        record, fd = self._read_registry_record()
        return (record["basename"] if record is not None else None), fd

    def read_registry(self):
        name, fd = self._read_registry()
        if fd is not None:
            os.close(fd)
        return name

    def load(self, lifecycle=False):
        basename = self.read_registry()
        if basename is None:
            return None
        try:
            self._open_stage(basename)
        except UnsafeInput:
            if lifecycle:
                try:
                    os.stat(basename, dir_fd=self.parent_fd, follow_symlinks=False)
                except FileNotFoundError:
                    self.basename = basename
                    return basename
            raise
        if lifecycle:
            self.verify_lifecycle()
        else:
            self.verify()
        return basename

    def remove(self, race_hook=None):
        if self.stage_fd is None:
            return
        self.verify_lifecycle()
        registered, registry_fd = self._read_registry()
        if registered is not None and registered != self.basename:
            os.close(registry_fd)
            raise UnsafeInput("Compose input registry identity changed")
        detached = ".delete-" + self.basename + "-" + secrets.token_hex(12)
        try:
            if race_hook:
                race_hook()
            os.rename(self.basename, detached, src_dir_fd=self.parent_fd, dst_dir_fd=self.parent_fd)
        except Exception:
            if registry_fd is not None:
                os.close(registry_fd)
            raise
        candidate = None
        exact_detach = False
        try:
            candidate = os.open(detached, os.O_RDONLY | DIRECTORY | NOFOLLOW, dir_fd=self.parent_fd)
            if not same_identity(self.stage_fd, candidate):
                raise UnsafeInput("Compose input stage changed before cleanup detach")
            exact_detach = True
            self.clear_snapshots()
            remove_tree(candidate)
            os.close(candidate)
            candidate = None
            os.rmdir(detached, dir_fd=self.parent_fd)
            if registered is not None:
                visible = os.open(self.registry, os.O_RDONLY | NOFOLLOW, dir_fd=self.parent_fd)
                try:
                    if not same_identity(registry_fd, visible):
                        raise UnsafeInput("Compose input registry changed before cleanup")
                finally:
                    os.close(visible)
                os.unlink(self.registry, dir_fd=self.parent_fd)
            self.close_stage()
        finally:
            if candidate is not None:
                os.close(candidate)
            if registry_fd is not None:
                os.close(registry_fd)
            if not exact_detach:
                try:
                    os.stat(self.basename, dir_fd=self.parent_fd, follow_symlinks=False)
                except FileNotFoundError:
                    try:
                        os.rename(detached, self.basename, src_dir_fd=self.parent_fd, dst_dir_fd=self.parent_fd)
                    except FileNotFoundError:
                        pass

    def cleanup_project(self, failure_hook=None):
        self.close_stage()
        errors = []
        candidates = []
        intent = intent_fd = None
        registered_record = registered_record_fd = None
        try:
            intent, intent_fd = self._read_intent()
        except Exception as exc:
            errors.append(f"intent: {exc}")
        try:
            registered_record, registered_record_fd = self._read_registry_record()
        except Exception as exc:
            errors.append(f"registry: {exc}")
        finally:
            if registered_record_fd is not None:
                os.close(registered_record_fd)
        for name in os.listdir(self.parent_fd):
            if name.startswith(".delete-" + self.project + "."):
                candidates.append(name)
                continue
            try:
                check_basename(name, self.project)
                candidates.append(name)
            except UnsafeInput:
                pass
        for name in candidates:
            path_fd = stage_fd = detached_fd = None
            detached = name
            try:
                path_fd = os.open(
                    name, os.O_PATH | DIRECTORY | NOFOLLOW, dir_fd=self.parent_fd,
                )
                stage_info = os.fstat(path_fd)
                if not stat.S_ISDIR(stage_info.st_mode) or stage_info.st_uid != self.uid:
                    raise UnsafeInput("cleanup stage has unsafe type or owner")
                registered_owned = registered_record is not None and (
                    name == registered_record["basename"]
                    or name.startswith(".delete-" + registered_record["basename"] + "-")
                ) and registered_record["stage"] == [stage_info.st_dev, stage_info.st_ino]
                if stat.S_IMODE(stage_info.st_mode) != 0o700:
                    if not registered_owned:
                        raise UnsafeInput("unregistered cleanup stage has unsafe mode")
                    os.chmod(f"/proc/{os.getpid()}/fd/{path_fd}", 0o700)
                stage_fd = os.open(
                    f"/proc/{os.getpid()}/fd/{path_fd}", os.O_RDONLY | DIRECTORY,
                )
                if not same_identity(path_fd, stage_fd):
                    raise UnsafeInput("cleanup stage identity changed during mode recovery")
                owned_directory(stage_fd, self.uid, private=True)
                try:
                    os.stat(".owner", dir_fd=stage_fd, follow_symlinks=False)
                except FileNotFoundError:
                    marker = None
                else:
                    try:
                        marker = self._read_marker(stage_fd)
                    except UnsafeInput:
                        if not registered_owned:
                            raise
                        marker = None
                if marker is None:
                    if registered_owned:
                        basename = registered_record["basename"]
                    elif intent is None or (
                            name != intent["basename"]
                            and not name.startswith(".delete-" + intent["basename"] + "-")
                    ):
                        raise UnsafeInput("stage has no matching cleanup intent")
                    else:
                        basename = intent["basename"]
                        entries = set(os.listdir(stage_fd))
                        info = os.fstat(stage_fd)
                        if intent["phase"] == "planned":
                            if entries:
                                raise UnsafeInput("planned cleanup intent names a nonempty directory")
                        elif intent["stage"] != [info.st_dev, info.st_ino]:
                            raise UnsafeInput("bound cleanup intent identity does not match")
                        elif entries:
                            raise UnsafeInput("nonempty intended stage has no ownership marker")
                else:
                    basename = marker["basename"]
                    if name != basename and not name.startswith(".delete-" + basename + "-"):
                        raise UnsafeInput("invalid cleanup ownership marker")
                    if intent is not None and (
                        basename == intent["basename"]
                        or name.startswith(".delete-" + intent["basename"] + "-")
                    ):
                        info = os.fstat(stage_fd)
                        if intent["phase"] != "bound" or intent["stage"] != [info.st_dev, info.st_ino]:
                            raise UnsafeInput("cleanup marker does not match bound stage identity")
                        if marker["commit"] != intent["commit"]:
                            raise UnsafeInput("cleanup marker commit does not match stage intent")
                if failure_hook:
                    failure_hook("stage", name)
                if name == basename:
                    detached = ".delete-" + basename + "-" + secrets.token_hex(12)
                    os.rename(name, detached, src_dir_fd=self.parent_fd, dst_dir_fd=self.parent_fd)
                    detached_fd = os.open(detached, os.O_RDONLY | DIRECTORY | NOFOLLOW, dir_fd=self.parent_fd)
                    if not same_identity(stage_fd, detached_fd):
                        raise UnsafeInput("cleanup stage identity changed during detach")
                    os.close(stage_fd)
                    stage_fd = detached_fd
                    detached_fd = None
                remove_tree(stage_fd)
                os.close(stage_fd)
                stage_fd = None
                os.rmdir(detached, dir_fd=self.parent_fd)
            except Exception as exc:
                errors.append(f"stage {name}: {exc}")
            finally:
                for fd in (detached_fd, stage_fd, path_fd):
                    if fd is not None:
                        os.close(fd)

        volumes = subprocess.run(
            ["docker", "volume", "ls", "--quiet", "--filter", f"label=com.docker.compose.project={self.project}"],
            stdout=subprocess.PIPE,
            text=True,
            check=False,
        )
        if volumes.returncode != 0:
            errors.append("volume discovery failed")
        else:
            for volume in volumes.stdout.split():
                try:
                    details = self.inspect_volume(volume)
                    labels = details.get("Labels") or {}
                    if labels.get("com.docker.compose.volume") != "compose-inputs":
                        continue
                    if labels.get("com.nmcp.validation.owner") != self.owner:
                        raise UnsafeInput("refusing to remove an unowned Compose input volume")
                    run = labels.get("com.nmcp.validation.run", "")
                    if not run.startswith(self.project + "."):
                        raise UnsafeInput("Compose input volume has an invalid run identity")
                    if failure_hook:
                        failure_hook("volume", volume)
                    self.remove_volume(volume, labels)
                except MissingVolume:
                    continue
                except Exception as exc:
                    errors.append(f"volume {volume}: {exc}")

        registry_fd = None
        try:
            registered, registry_fd = self._read_registry()
            if registry_fd is not None:
                remaining = any(
                    name == registered or name.startswith(".delete-" + registered + "-")
                    for name in os.listdir(self.parent_fd)
                )
                if not remaining and not errors:
                    if failure_hook:
                        failure_hook("registry", self.registry)
                    self._unlink_exact(self.registry, registry_fd)
        except Exception as exc:
            errors.append(f"registry: {exc}")
        finally:
            if registry_fd is not None:
                os.close(registry_fd)

        if intent_fd is not None:
            try:
                remaining = any(
                    name == intent["basename"]
                    or name.startswith(".delete-" + intent["basename"] + "-")
                    for name in os.listdir(self.parent_fd)
                )
                if not remaining:
                    self._unlink_exact(self.intent, intent_fd)
            except Exception as exc:
                errors.append(f"intent cleanup: {exc}")
            finally:
                os.close(intent_fd)
        if errors:
            raise UnsafeInput("cleanup failures: " + "; ".join(errors))

    def _docker_ids(self, resource, label_name="com.docker.compose.project"):
        command = ["docker", resource, "ls", "--quiet", "--filter", f"label={label_name}={self.project}"]
        if resource == "container":
            command.insert(3, "--all")
        result = subprocess.run(command, stdout=subprocess.PIPE, text=True, check=False)
        if result.returncode != 0:
            raise UnsafeInput(f"Docker {resource} discovery failed")
        return list(dict.fromkeys(result.stdout.split()))

    def _docker_labels(self, resource, identity):
        details = subprocess.run(
            ["docker", resource, "inspect", identity],
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            check=False,
        )
        if details.returncode != 0:
            raise UnsafeInput(f"Docker {resource} inspect failed: {identity}")
        try:
            records = json.loads(details.stdout)
            if not isinstance(records, list) or len(records) != 1:
                raise ValueError("wrong record count")
            record = records[0]
        except (json.JSONDecodeError, TypeError, ValueError) as exc:
            raise UnsafeInput(f"Docker {resource} inspect returned invalid data: {identity}") from exc
        if resource in ("container", "image"):
            return (record.get("Config") or {}).get("Labels") or {}
        return record.get("Labels") or {}

    def _prune_project_volumes(self):
        result = subprocess.run(
            [
                "docker", "volume", "prune", "--all", "--force",
                "--filter", f"label=com.docker.compose.project={self.project}",
                "--filter", f"label=com.nmcp.validation.owner={self.owner}",
            ],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.PIPE,
            text=True,
            check=False,
        )
        if result.returncode != 0:
            raise UnsafeInput("Docker owned volume prune failed")

    def docker_lifecycle(self, action, stdio=None):
        if action not in ("down", "reset", "logs"):
            raise UnsafeInput("invalid Docker lifecycle action")
        errors = []
        kwargs = {}
        if stdio is not None:
            kwargs = {"stdin": stdio[0], "stdout": stdio[1], "stderr": stdio[2]}
        try:
            containers = self._docker_ids("container")
        except Exception as exc:
            errors.append(f"container discovery: {exc}")
            containers = []
        owned_containers = []
        for container in containers:
            try:
                labels = self._docker_labels("container", container)
            except Exception as exc:
                errors.append(f"container inspect {container}: {exc}")
                continue
            if labels.get("com.nmcp.validation.owner") != self.owner:
                errors.append(f"foreign container {container}")
                continue
            owned_containers.append(container)
        if action == "logs":
            for container in sorted(owned_containers):
                result = subprocess.run(["docker", "logs", container], check=False, **kwargs)
                if result.returncode != 0:
                    errors.append(f"container logs {container}")
        else:
            for container in owned_containers:
                stopped = subprocess.run(
                    ["docker", "container", "stop", "--time", "20", container],
                    stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False,
                )
                if stopped.returncode != 0:
                    errors.append(f"container stop {container}")
            for container in owned_containers:
                removed = subprocess.run(
                    ["docker", "container", "rm", "--force", container],
                    stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False,
                )
                if removed.returncode != 0:
                    errors.append(f"container remove {container}")

            try:
                networks = self._docker_ids("network")
            except Exception as exc:
                errors.append(f"network discovery: {exc}")
                networks = []
            for network in networks:
                try:
                    labels = self._docker_labels("network", network)
                except Exception as exc:
                    errors.append(f"network inspect {network}: {exc}")
                    continue
                if labels.get("com.nmcp.validation.owner") != self.owner:
                    errors.append(f"foreign network {network}")
                    continue
                removed = subprocess.run(
                    ["docker", "network", "rm", network], stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL, check=False,
                )
                if removed.returncode != 0:
                    errors.append(f"network remove {network}")

        if action == "reset":
            try:
                volumes = self._docker_ids("volume")
            except Exception as exc:
                errors.append(f"volume discovery: {exc}")
                volumes = []
            for volume in volumes:
                try:
                    labels = self._docker_labels("volume", volume)
                except Exception as exc:
                    errors.append(f"volume inspect {volume}: {exc}")
                    continue
                if labels.get("com.nmcp.validation.owner") != self.owner:
                    errors.append(f"foreign volume {volume}")
            try:
                self._prune_project_volumes()
            except Exception as exc:
                errors.append(f"volume prune: {exc}")
            try:
                remaining_volumes = self._docker_ids("volume")
            except Exception as exc:
                errors.append(f"volume rediscovery: {exc}")
                remaining_volumes = []
            for volume in remaining_volumes:
                try:
                    labels = self._docker_labels("volume", volume)
                    kind = "owned volume retained" if labels.get("com.nmcp.validation.owner") == self.owner else "foreign volume"
                    errors.append(f"{kind} {volume}")
                except Exception as exc:
                    errors.append(f"volume reinspection {volume}: {exc}")

            try:
                images = self._docker_ids("image", "com.nmcp.validation.project")
            except Exception as exc:
                errors.append(f"image discovery: {exc}")
                images = []
            for image in images:
                try:
                    labels = self._docker_labels("image", image)
                except Exception as exc:
                    errors.append(f"image inspect {image}: {exc}")
                    continue
                if (
                    labels.get("com.nmcp.validation.kind") != "compose-input-image"
                    or labels.get("com.nmcp.validation.owner") != self.owner
                ):
                    errors.append(f"foreign input image {image}")
                    continue
                removed = subprocess.run(
                    ["docker", "image", "rm", image], stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL, check=False,
                )
                if removed.returncode != 0:
                    errors.append(f"input image remove {image}")
        if errors:
            raise UnsafeInput("Docker lifecycle failures: " + "; ".join(errors))

    def run(self, argv, race_hook=None, stdio=None):
        self.verify()
        if race_hook:
            race_hook()
        self.verify_chain()
        env = os.environ.copy()
        env["NMCP_COMPOSE_INPUT_VOLUME"] = self.volume
        if self.input_image is not None:
            self.validate_image(self.input_image)
            env["NMCP_POSTGRES_INPUT_IMAGE"] = self.input_image
        for variable in self.input_fds:
            fd = self.input_fds[variable]
            env[variable] = f"/proc/{os.getpid()}/fd/{fd}"
        kwargs = {}
        if stdio is not None:
            kwargs = {"stdin": stdio[0], "stdout": stdio[1], "stderr": stdio[2]}
        return subprocess.call(argv, env=env, **kwargs)

    def run_lifecycle(self, argv, stdio=None):
        self.verify_chain()
        env = os.environ.copy()
        env["NMCP_COMPOSE_INPUT_VOLUME"] = (
            self.volume if self.basename is not None else self.project + "_compose-inputs-none"
        )
        kwargs = {}
        if stdio is not None:
            kwargs = {"stdin": stdio[0], "stdout": stdio[1], "stderr": stdio[2]}
        return subprocess.call(argv, env=env, **kwargs)


def respond(sock, payload):
    sock.send(json.dumps(payload, separators=(",", ":")).encode())


def serve(sock, child, store, allowed_commands=None):
    sock.settimeout(0.1)
    while child.poll() is None:
        try:
            raw, ancillary, _, _ = sock.recvmsg(
                1024 * 1024, socket.CMSG_SPACE(3 * array.array("i").itemsize)
            )
        except socket.timeout:
            continue
        if not raw:
            break
        passed_fds = []
        try:
            for level, kind, data in ancillary:
                if level == socket.SOL_SOCKET and kind == socket.SCM_RIGHTS:
                    values = array.array("i")
                    values.frombytes(data[: len(data) - (len(data) % values.itemsize)])
                    passed_fds.extend(values)
            request = json.loads(raw)
            command = request["command"]
            if allowed_commands is not None and command not in allowed_commands:
                raise UnsafeInput("command is unavailable in lifecycle-only mode")
            if command == "stage":
                result = store.stage()
            elif command == "load":
                result = store.load()
            elif command == "load-lifecycle":
                result = store.load(lifecycle=True)
            elif command == "verify":
                store.verify()
                result = True
            elif command == "register":
                store.register()
                result = True
            elif command == "restage":
                store.restage(request["name"])
                result = True
            elif command == "publish":
                result = store.publish()
            elif command == "volume-test":
                result = store.volume_security_test()
            elif command == "image-test":
                result = store.image_security_test()
            elif command == "seed-partial-and-wait":
                store.seed_partial_volume_and_wait()
                result = True
            elif command == "unpublish":
                store.unpublish()
                result = True
            elif command == "remove":
                store.remove()
                result = True
            elif command == "cleanup":
                store.cleanup_project()
                result = True
            elif command in ("docker-down", "docker-reset", "docker-logs"):
                if len(passed_fds) != 3:
                    raise UnsafeInput("Docker lifecycle command did not provide stdin/stdout/stderr")
                store.docker_lifecycle(command.removeprefix("docker-"), stdio=passed_fds)
                result = True
            elif command == "run":
                if len(passed_fds) != 3:
                    raise UnsafeInput("validation command did not provide stdin/stdout/stderr")
                result = store.run(request["argv"], stdio=passed_fds)
            elif command == "run-lifecycle":
                if len(passed_fds) != 3:
                    raise UnsafeInput("validation command did not provide stdin/stdout/stderr")
                result = store.run_lifecycle(request["argv"], stdio=passed_fds)
            else:
                raise UnsafeInput(f"unknown validation input command: {command}")
            respond(sock, {"ok": True, "result": result})
        except Exception as exc:
            respond(sock, {"ok": False, "error": str(exc)})
        finally:
            for passed_fd in passed_fds:
                os.close(passed_fd)
    return child.wait()


def invoke(root, project, script, arguments):
    check_project(project)
    uid = os.getuid()
    root_path = os.path.realpath(root)
    if os.path.abspath(root) != root_path:
        raise UnsafeInput("validation repository root must be canonical and non-symlinked")
    lifecycle_commands = {
        "down": frozenset(("docker-down",)),
        "logs": frozenset(("docker-logs",)),
        "reset": frozenset(("docker-reset", "cleanup")),
    }
    allowed_commands = lifecycle_commands.get(arguments[0]) if len(arguments) == 1 else None
    root_fd = os.open(root_path, os.O_RDONLY | DIRECTORY | NOFOLLOW)
    validation_fd = parent_fd = git_entry_fd = gitdir_fd = commondir_fd = None
    gitdir_path = git_entry_data = commondir_path = commondir_data = git_backlink_data = None
    commit_oid = source_snapshots = None
    lock_sock = None
    try:
        owned_directory(root_fd, uid)
        if allowed_commands is None:
            git_entry_fd = os.open(".git", os.O_RDONLY | NOFOLLOW, dir_fd=root_fd)
            (
                gitdir_path, gitdir_fd, git_entry_data,
                commondir_path, commondir_fd, commondir_data, git_backlink_data,
            ) = resolve_checkout_git(root_path, root_fd, git_entry_fd)
            commit_oid = resolve_pinned_head(gitdir_fd, commondir_fd)
            source_snapshots = verified_commit_inputs(gitdir_fd, commondir_fd, commit_oid)
            if resolve_pinned_head(gitdir_fd, commondir_fd) != commit_oid:
                raise UnsafeInput("repository HEAD changed while snapshotting verified inputs")
        validation_fd = open_directory(".validation", root_fd, uid, create=True)
        parent_fd = open_directory("compose-inputs", validation_fd, uid, private=True, create=True)
        root_info = os.fstat(root_fd)
        lock_name = "\0nmcp-validation-" + hashlib.sha256(
            f"{uid}:{root_info.st_dev}:{root_info.st_ino}:{project}".encode()
        ).hexdigest()
        while True:
            candidate = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            try:
                candidate.bind(lock_name)
                lock_sock = candidate
                break
            except OSError as exc:
                candidate.close()
                if exc.errno != errno.EADDRINUSE:
                    raise
                time.sleep(0.05)
        owner = hashlib.sha256(os.fsencode(root_path)).hexdigest()
        server_sock, child_sock = socket.socketpair(socket.AF_UNIX, socket.SOCK_SEQPACKET)
        os.set_inheritable(child_sock.fileno(), True)
        env = os.environ.copy()
        env["NMCP_VALIDATION_INPUTS_MANAGED"] = "1"
        env["NMCP_VALIDATION_INPUTS_PROJECT"] = project
        env["NMCP_VALIDATION_INPUTS_FD"] = str(child_sock.fileno())
        child = subprocess.Popen([script, *arguments], env=env, pass_fds=(child_sock.fileno(),))
        child_sock.close()
        store = Store(
            root_path,
            root_fd,
            validation_fd,
            parent_fd,
            project,
            owner,
            uid,
            git_entry_fd,
            gitdir_path,
            gitdir_fd,
            commit_oid,
            git_entry_data,
            commondir_path,
            commondir_fd,
            commondir_data,
            git_backlink_data,
            source_snapshots,
        )
        try:
            return serve(server_sock, child, store, allowed_commands)
        finally:
            if store.stage_fd is not None and store.read_registry() != store.basename:
                cleanup_errors = []
                try:
                    store.docker_lifecycle("reset")
                except Exception as exc:
                    cleanup_errors.append(str(exc))
                try:
                    store.cleanup_project()
                except Exception as exc:
                    cleanup_errors.append(str(exc))
                if cleanup_errors:
                    raise UnsafeInput("unregistered validation cleanup failed: " + "; ".join(cleanup_errors))
            store.close_stage()
            server_sock.close()
    finally:
        if lock_sock is not None:
            lock_sock.close()
        for fd in (commondir_fd, gitdir_fd, git_entry_fd, parent_fd, validation_fd, root_fd):
            if fd is not None:
                os.close(fd)


def client(command, argv):
    fd = int(os.environ["NMCP_VALIDATION_INPUTS_FD"])
    sock = socket.socket(fileno=os.dup(fd))
    request = {"command": command}
    if command in ("run", "run-lifecycle", "docker-down", "docker-reset", "docker-logs"):
        request["argv"] = argv
    elif command == "restage":
        if len(argv) != 1:
            raise UnsafeInput("restage requires one output basename")
        request["name"] = argv[0]
    payload = json.dumps(request, separators=(",", ":")).encode()
    if command in ("run", "run-lifecycle", "docker-down", "docker-reset", "docker-logs"):
        descriptors = array.array("i", (0, 1, 2))
        sock.sendmsg([payload], [(socket.SOL_SOCKET, socket.SCM_RIGHTS, descriptors)])
    else:
        sock.send(payload)
    raw_response = sock.recv(1024 * 1024)
    if not raw_response:
        raise UnsafeInput("validation input supervisor terminated without a response")
    response = json.loads(raw_response)
    if not response["ok"]:
        raise UnsafeInput(response["error"])
    result = response["result"]
    if command in ("stage", "load", "load-lifecycle", "publish", "volume-test", "image-test") and result is not None:
        print(result)
    return result if command == "run" else 0


def expect_denied(label, operation):
    try:
        operation()
    except (UnsafeInput, OSError):
        return
    raise AssertionError(f"accepted {label}")


def self_test():
    project = "stage-test"
    owner = "a" * 64
    uid = os.getuid()
    with tempfile.TemporaryDirectory() as temporary:
        root = os.path.join(temporary, "repo")
        outside = os.path.join(temporary, "outside")
        os.mkdir(root, 0o700)
        os.mkdir(outside, 0o700)
        with open(os.path.join(root, "README"), "w", encoding="ascii") as stream:
            stream.write("validation test repository\n")
        for _, tracked_path, _ in INPUTS:
            path = os.path.join(root, tracked_path)
            os.makedirs(os.path.dirname(path), exist_ok=True)
            with open(path, "w", encoding="ascii") as stream:
                stream.write("version one: " + tracked_path + "\n")
        subprocess.run(["git", "init", "--quiet", root], check=True)
        subprocess.run(["git", "-C", root, "add", "."], check=True)
        commit_env = os.environ | {
            "GIT_AUTHOR_NAME": "validation-test",
            "GIT_AUTHOR_EMAIL": "validation@example.invalid",
            "GIT_COMMITTER_NAME": "validation-test",
            "GIT_COMMITTER_EMAIL": "validation@example.invalid",
        }
        subprocess.run(["git", "-C", root, "commit", "--quiet", "-m", "test"], env=commit_env, check=True)
        for _, tracked_path, _ in INPUTS:
            with open(os.path.join(root, tracked_path), "w", encoding="ascii") as stream:
                stream.write("version two: " + tracked_path + "\n")
        subprocess.run(["git", "-C", root, "commit", "--quiet", "-am", "second"], env=commit_env, check=True)
        source_modes = {}
        for _, tracked_path, _ in INPUTS:
            path = os.path.join(root, tracked_path)
            os.chmod(path, 0o600)
            source_modes[tracked_path] = stat.S_IMODE(os.stat(path).st_mode)
        assert source_modes == {tracked_path: 0o600 for _, tracked_path, _ in INPUTS}
        sentinel = os.path.join(outside, "sentinel")
        with open(sentinel, "w", encoding="ascii") as stream:
            stream.write("unchanged")
        root_fd = os.open(root, os.O_RDONLY | DIRECTORY | NOFOLLOW)
        os.mkdir(".validation", 0o700, dir_fd=root_fd)
        validation_fd = open_directory(".validation", root_fd, uid)
        os.mkdir("compose-inputs", 0o700, dir_fd=validation_fd)
        parent_fd = open_directory("compose-inputs", validation_fd, uid, private=True)

        git_entry_fd = os.open(".git", os.O_RDONLY | NOFOLLOW, dir_fd=root_fd)
        gitdir_path = os.path.join(root, ".git")
        gitdir_fd = os.open(gitdir_path, os.O_RDONLY | DIRECTORY | NOFOLLOW)
        pinned_commit = subprocess.check_output(
            ["git", "-C", root, "rev-parse", "HEAD"], text=True
        ).strip()
        provenance = Store(
            root,
            root_fd,
            validation_fd,
            parent_fd,
            "provenance-test",
            owner,
            uid,
            git_entry_fd,
            gitdir_path,
            gitdir_fd,
            pinned_commit,
        )
        before_provenance = set(os.listdir(parent_fd))
        switched = False
        def switch_head(index):
            nonlocal switched
            if index == 0 and not switched:
                subprocess.run(["git", "-C", root, "checkout", "--quiet", "HEAD^"], check=True)
                switched = True
        expect_denied("mid-stage HEAD switch", lambda: provenance.stage(race_hook=switch_head))
        assert set(os.listdir(parent_fd)) == before_provenance
        subprocess.run(["git", "-C", root, "checkout", "--quiet", pinned_commit], check=True)

        persisted = Store(
            root, root_fd, validation_fd, parent_fd, "lifecycle-test", owner, uid,
            git_entry_fd, gitdir_path, gitdir_fd, pinned_commit,
        )
        persisted.stage()
        persisted.register()
        persisted.close_stage()
        subprocess.run(["git", "-C", root, "checkout", "--quiet", "HEAD^"], check=True)
        older_commit = subprocess.check_output(["git", "-C", root, "rev-parse", "HEAD"], text=True).strip()
        strict_reload = Store(
            root, root_fd, validation_fd, parent_fd, "lifecycle-test", owner, uid,
            git_entry_fd, gitdir_path, gitdir_fd, older_commit,
        )
        expect_denied("registered stage after HEAD switch", strict_reload.load)
        strict_reload.close_stage()
        lifecycle_reload = Store(
            root, root_fd, validation_fd, parent_fd, "lifecycle-test", owner, uid,
            git_entry_fd, gitdir_path, gitdir_fd, older_commit,
        )
        assert lifecycle_reload.load(lifecycle=True)
        lifecycle_reload.cleanup_project()
        subprocess.run(["git", "-C", root, "checkout", "--quiet", pinned_commit], check=True)

        local_edit = Store(
            root, root_fd, validation_fd, parent_fd, "local-edit-test", owner, uid,
            git_entry_fd, gitdir_path, gitdir_fd, pinned_commit,
        )
        local_edit.stage()
        local_edit.register()
        local_edit.close_stage()
        with open(os.path.join(root, INPUTS[0][1]), "a", encoding="ascii") as stream:
            stream.write("local edit\n")
        edited_reload = Store(
            root, root_fd, validation_fd, parent_fd, "local-edit-test", owner, uid,
            git_entry_fd, gitdir_path, gitdir_fd, pinned_commit,
        )
        assert edited_reload.load(lifecycle=True)
        edited_reload.cleanup_project()
        subprocess.run(["git", "-C", root, "checkout", "--quiet", pinned_commit], check=True)
        for _, tracked_path, _ in INPUTS:
            data = subprocess.check_output(
                ["git", "-C", root, "cat-file", "blob", f"{pinned_commit}:{tracked_path}"]
            )
            with open(os.path.join(root, tracked_path), "wb") as stream:
                stream.write(data)
            os.chmod(os.path.join(root, tracked_path), 0o600)

        invoke_owner = hashlib.sha256(os.fsencode(os.path.realpath(root))).hexdigest()
        lifecycle = Store(
            root, root_fd, validation_fd, parent_fd, "command-lifecycle", invoke_owner, uid,
            git_entry_fd, gitdir_path, gitdir_fd, pinned_commit,
        )
        lifecycle.stage()
        lifecycle.register()
        lifecycle_basename = lifecycle.basename
        lifecycle.close_stage()
        subprocess.run(["git", "-C", root, "checkout", "--quiet", "HEAD^"], check=True)
        with open(os.path.join(root, INPUTS[0][1]), "a", encoding="ascii") as stream:
            stream.write("lifecycle local edit\n")
        lifecycle_child = os.path.join(temporary, "lifecycle-child")
        helper = os.path.realpath(__file__)
        with open(lifecycle_child, "w", encoding="ascii") as stream:
            stream.write(
                "#!/bin/sh\nset -eu\n"
                "case \"$1\" in\n"
                f"  logs) python3 {helper!r} client docker-logs ;;\n"
                f"  down) python3 {helper!r} client docker-down ;;\n"
                f"  reset) python3 {helper!r} client docker-reset; python3 {helper!r} client cleanup ;;\n"
                "esac\n"
            )
        os.chmod(lifecycle_child, 0o700)
        fake_bin = os.path.join(temporary, "fake-bin")
        os.mkdir(fake_bin, 0o700)
        fake_docker = os.path.join(fake_bin, "docker")
        with open(fake_docker, "w", encoding="ascii") as stream:
            stream.write("#!/bin/sh\nexit 0\n")
        os.chmod(fake_docker, 0o700)
        lifecycle_stage_path = os.path.join(root, ".validation", "compose-inputs", lifecycle_basename)
        os.chmod(lifecycle_stage_path, 0)
        moved_git_entry = os.path.join(temporary, "lifecycle-moved-git")
        os.rename(os.path.join(root, ".git"), moved_git_entry)
        original_path = os.environ.get("PATH", "")
        os.environ["PATH"] = fake_bin + os.pathsep + original_path
        try:
            assert invoke(root, "command-lifecycle", lifecycle_child, ["logs"]) == 0
            with open(os.path.join(root, ".git"), "wb") as stream:
                stream.write(b"corrupt gitfile\n")
            assert invoke(root, "command-lifecycle", lifecycle_child, ["down"]) == 0
            os.unlink(os.path.join(root, ".git"))
            moved_head = os.path.join(moved_git_entry, "HEAD")
            with open(moved_head, "rb") as stream:
                moved_head_data = stream.read()
            with open(moved_head, "wb") as stream:
                stream.write(b"invalid HEAD\n")
            assert invoke(root, "command-lifecycle", lifecycle_child, ["reset"]) == 0
            with open(moved_head, "wb") as stream:
                stream.write(moved_head_data)
        finally:
            os.environ["PATH"] = original_path
            try:
                os.unlink(os.path.join(root, ".git"))
            except FileNotFoundError:
                pass
            os.rename(moved_git_entry, os.path.join(root, ".git"))
        assert lifecycle.read_registry() is None

        wrapper_root = os.path.join(temporary, "wrapper-root")
        wrapper_scripts = os.path.join(wrapper_root, "scripts")
        os.makedirs(wrapper_scripts, mode=0o700)
        wrapper = os.path.join(wrapper_scripts, "validation-env")
        wrapper_helper = os.path.join(wrapper_scripts, "validation-inputs")
        for source, destination in (
            (os.path.join(os.path.dirname(helper), "validation-env"), wrapper),
            (helper, wrapper_helper),
        ):
            with open(source, "rb") as input_stream, open(destination, "wb") as output_stream:
                output_stream.write(input_stream.read())
            os.chmod(destination, 0o700)
        wrapper_bin = os.path.join(temporary, "wrapper-bin")
