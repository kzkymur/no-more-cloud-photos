            "com.docker.compose.volume": "compose-inputs",
            "com.nmcp.validation.owner": owner,
            "com.nmcp.validation.run": project + "." + "1" * 24,
        }}
        def remove_fake_volume(volume, labels):
            attempted.append(("removed", volume))
            remaining_volumes.remove(volume)
        aggregate.remove_volume = remove_fake_volume
        failures = {("stage", first_stage), ("volume", volume_names[0])}
        def fail_cleanup(kind, name):
            attempted.append((kind, name))
            if (kind, name) in failures:
                raise OSError("injected cleanup failure")
        try:
            try:
                aggregate.cleanup_project(failure_hook=fail_cleanup)
            except UnsafeInput as exc:
                message = str(exc)
                assert first_stage in message and volume_names[0] in message
            else:
                raise AssertionError("cleanup accepted injected independent failures")
            assert ("stage", second_basename) in attempted
            assert ("volume", volume_names[1]) in attempted
            assert ("removed", volume_names[1]) in attempted
            assert remaining_volumes == {volume_names[0]}
            assert aggregate.read_registry() == first_stage
            aggregate.cleanup_project()
            assert ("removed", volume_names[0]) in attempted
            assert not remaining_volumes
            assert aggregate.read_registry() is None
        finally:
            subprocess.run = original_run
            aggregate.inspect_volume = original_inspect
            aggregate.remove_volume = original_remove_volume

