#!/usr/bin/env python3
"""Descriptor-confined lifecycle for local validation Compose inputs."""

import array
import errno
import fcntl
import hashlib
import io
import json
import os
import secrets
import socket
import stat
import subprocess
import sys
import tarfile
import tempfile
import time


INPUTS = (
    ("NMCP_POSTGRES_INIT_SQL", "infra/validation/postgres-init.sql", "postgres-init.sql"),
    ("NMCP_RUNTIME_ROLES_SQL", "infra/postgresql/runtime-roles.sql", "runtime-roles.sql"),
    ("NMCP_UBUNTU_ROLES_SQL", "infra/ubuntu/postgresql-roles.sql", "postgresql-roles.sql"),
    ("NMCP_VERIFY_ROLE_GRAPH_SQL", "infra/postgresql/verify-runtime-role-graph.sql", "verify-runtime-role-graph.sql"),
    ("NMCP_VERIFY_RUNTIME_ROLES_SQL", "infra/validation/verify-runtime-roles.sql", "verify-runtime-roles.sql"),
)
NOFOLLOW = getattr(os, "O_NOFOLLOW", 0)
DIRECTORY = getattr(os, "O_DIRECTORY", 0)
MEMFD_FLAGS = getattr(os, "MFD_CLOEXEC", 0) | getattr(os, "MFD_ALLOW_SEALING", 0)
REQUIRED_SEALS = (
    getattr(fcntl, "F_SEAL_SEAL", 0)
    | getattr(fcntl, "F_SEAL_SHRINK", 0)
    | getattr(fcntl, "F_SEAL_GROW", 0)
    | getattr(fcntl, "F_SEAL_WRITE", 0)
)


class UnsafeInput(RuntimeError):
    pass


class MissingVolume(UnsafeInput):
    pass


def check_project(project):
    if not project or project[0] not in "abcdefghijklmnopqrstuvwxyz0123456789":
        raise UnsafeInput(f"invalid validation project: {project!r}")
    if any(c not in "abcdefghijklmnopqrstuvwxyz0123456789_-" for c in project):
        raise UnsafeInput(f"invalid validation project: {project!r}")


def check_basename(name, project):
    prefix = project + "."
    suffix = name.removeprefix(prefix)
    if (
        not name
        or name in (".", "..", "/")
        or "/" in name
        or not name.startswith(prefix)
        or len(suffix) != 24
        or any(c not in "0123456789abcdef" for c in suffix)
        or any(c not in "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789._-" for c in name)
    ):
        raise UnsafeInput("Compose input registry does not contain a safe project basename")
    return name


def owned_directory(fd, uid, private=False):
    info = os.fstat(fd)
    if not stat.S_ISDIR(info.st_mode) or info.st_uid != uid:
        raise UnsafeInput("validation directory is not an owned directory")
    if private and stat.S_IMODE(info.st_mode) != 0o700:
        raise UnsafeInput("Compose input directory mode is not 0700")


def same_identity(first_fd, second_fd):
    first, second = os.fstat(first_fd), os.fstat(second_fd)
    return (first.st_dev, first.st_ino) == (second.st_dev, second.st_ino)


def canonical_json(value):
    return json.dumps(value, sort_keys=True, separators=(",", ":")).encode("ascii")


def read_fd(fd):
    size = os.fstat(fd).st_size
    data = os.pread(fd, size, 0)
    if len(data) != size:
        raise UnsafeInput("short read from verified input")
    return data


def sealed_bytes(name, data):
    if not hasattr(os, "memfd_create") or not REQUIRED_SEALS:
        raise UnsafeInput("sealed memfd support is required")
    fd = os.memfd_create(name, MEMFD_FLAGS)
    try:
        view = memoryview(data)
        while view:
            written = os.write(fd, view)
            view = view[written:]
        fcntl.fcntl(fd, fcntl.F_ADD_SEALS, REQUIRED_SEALS)
        if fcntl.fcntl(fd, fcntl.F_GET_SEALS) & REQUIRED_SEALS != REQUIRED_SEALS:
            raise UnsafeInput("verified input memfd was not fully sealed")
        return fd
    except Exception:
        os.close(fd)
        raise


def open_directory(name, parent_fd, uid, private=False, create=False):
    if create:
        try:
            os.mkdir(name, 0o700, dir_fd=parent_fd)
        except FileExistsError:
            pass
    try:
        fd = os.open(name, os.O_RDONLY | DIRECTORY | NOFOLLOW, dir_fd=parent_fd)
    except OSError as exc:
        raise UnsafeInput(f"unsafe directory component: {name}") from exc
    try:
        owned_directory(fd, uid, private)
        return fd
    except Exception:
        os.close(fd)
        raise


def read_regular(name, parent_fd, uid, mode, limit=None):
    try:
        fd = os.open(name, os.O_RDONLY | NOFOLLOW, dir_fd=parent_fd)
    except OSError as exc:
        raise UnsafeInput(f"missing or unsafe regular file: {name}") from exc
    try:
        info = os.fstat(fd)
        if not stat.S_ISREG(info.st_mode) or info.st_uid != uid or stat.S_IMODE(info.st_mode) != mode:
            raise UnsafeInput(f"wrong type, owner, or mode on file: {name}")
        data = b""
        while True:
            chunk = os.read(fd, 65536)
            if not chunk:
                break
            data += chunk
            if limit is not None and len(data) > limit:
                raise UnsafeInput(f"oversized file: {name}")
        return fd, data
    except Exception:
        os.close(fd)
        raise


def remove_tree(fd):
    for name in os.listdir(fd):
        info = os.stat(name, dir_fd=fd, follow_symlinks=False)
        if stat.S_ISDIR(info.st_mode):
            child = os.open(name, os.O_RDONLY | DIRECTORY | NOFOLLOW, dir_fd=fd)
            try:
                remove_tree(child)
            finally:
                os.close(child)
            os.rmdir(name, dir_fd=fd)
        else:
            os.unlink(name, dir_fd=fd)


class Store:
    def __init__(
        self,
        root_path,
        root_fd,
        validation_fd,
        parent_fd,
        project,
        owner,
        uid=None,
        git_entry_fd=None,
        gitdir_path=None,
        gitdir_fd=None,
        commit_oid=None,
    ):
        self.root_path = root_path
        self.root_fd = root_fd
        self.validation_fd = validation_fd
        self.parent_fd = parent_fd
        self.project = project
        self.owner = owner
        self.uid = os.getuid() if uid is None else uid
        self.git_entry_fd = git_entry_fd
        self.gitdir_path = gitdir_path
        self.gitdir_fd = gitdir_fd
        self.commit_oid = commit_oid or ("0" * 40)
        self.basename = None
        self.stage_fd = None
        self.input_fds = {}
        self.parent_path = os.path.join(root_path, ".validation", "compose-inputs")

    @property
    def registry(self):
        return self.project + ".registry"

    @property
    def volume(self):
        if self.basename is None:
            raise UnsafeInput("no Compose input stage is loaded")
        return self.project + "_compose-inputs_" + self.basename.removeprefix(self.project + ".")

    def close_stage(self):
        self.close_snapshot_fds()
        if self.stage_fd is not None:
            os.close(self.stage_fd)
            self.stage_fd = None
        self.basename = None

    def close_snapshot_fds(self):
        for fd in self.input_fds.values():
            os.close(fd)
        self.input_fds.clear()

    def verify_git_identity(self):
        if self.gitdir_fd is None:
            return
        entry_fd = gitdir_fd = None
        try:
            entry_fd = os.open(".git", os.O_RDONLY | NOFOLLOW, dir_fd=self.root_fd)
            if not same_identity(self.git_entry_fd, entry_fd):
                raise UnsafeInput("repository git entry identity changed")
            gitdir_fd = os.open(self.gitdir_path, os.O_RDONLY | DIRECTORY | NOFOLLOW)
            if not same_identity(self.gitdir_fd, gitdir_fd):
                raise UnsafeInput("repository gitdir identity changed")
            current = subprocess.check_output(
                ["git", f"--git-dir=/proc/{os.getpid()}/fd/{self.gitdir_fd}", "rev-parse", "--verify", "HEAD^{commit}"],
                text=True,
            ).strip()
            if current != self.commit_oid:
                raise UnsafeInput("repository HEAD changed during validation")
        finally:
            for fd in (gitdir_fd, entry_fd):
                if fd is not None:
                    os.close(fd)

    def verify_chain(self):
        root_fd = validation_fd = parent_fd = None
        try:
            root_fd = os.open(self.root_path, os.O_RDONLY | DIRECTORY | NOFOLLOW)
            if not same_identity(self.root_fd, root_fd):
                raise UnsafeInput("repository root identity changed")
            validation_fd = open_directory(".validation", root_fd, self.uid)
            if not same_identity(self.validation_fd, validation_fd):
                raise UnsafeInput("validation directory identity changed")
            parent_fd = open_directory("compose-inputs", validation_fd, self.uid, private=True)
            if not same_identity(self.parent_fd, parent_fd):
                raise UnsafeInput("Compose input parent identity changed")
        except OSError as exc:
            raise UnsafeInput("pinned Compose input parent is no longer repository-contained") from exc
        finally:
            for fd in (parent_fd, validation_fd, root_fd):
                if fd is not None:
                    os.close(fd)

    def clear_snapshots(self):
        self.close_snapshot_fds()

    def source_data(self, tracked_path):
        self.verify_git_identity()
        parts = tracked_path.split("/")
        if any(part in ("", ".", "..") for part in parts):
            raise UnsafeInput("invalid tracked input path")
        current = os.dup(self.root_fd)
        try:
            for part in parts[:-1]:
                next_fd = open_directory(part, current, self.uid)
                os.close(current)
                current = next_fd
            fd = os.open(parts[-1], os.O_RDONLY | NOFOLLOW, dir_fd=current)
            try:
                info = os.fstat(fd)
                if not stat.S_ISREG(info.st_mode) or info.st_uid != self.uid:
                    raise UnsafeInput(f"unsafe tracked Compose input: {tracked_path}")
                data = b""
                while True:
                    chunk = os.read(fd, 65536)
                    if not chunk:
                        break
                    data += chunk
            finally:
                os.close(fd)
        finally:
            os.close(current)
        expected = subprocess.check_output(
            ["git", f"--git-dir=/proc/{os.getpid()}/fd/{self.gitdir_fd}", "cat-file", "blob", f"{self.commit_oid}:{tracked_path}"],
        ) if self.gitdir_fd is not None else data
        self.verify_git_identity()
        if data != expected:
            raise UnsafeInput(f"Compose input differs from the exact HEAD blob: {tracked_path}")
        return data

    def write_file(self, directory_fd, name, data, mode):
        temporary = ".tmp-" + secrets.token_hex(12)
        fd = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL | NOFOLLOW, mode, dir_fd=directory_fd)
        try:
            try:
                view = memoryview(data)
                while view:
                    written = os.write(fd, view)
                    view = view[written:]
                os.fchmod(fd, mode)
                os.fsync(fd)
            finally:
                os.close(fd)
            os.replace(temporary, name, src_dir_fd=directory_fd, dst_dir_fd=directory_fd)
        except Exception:
            try:
                os.unlink(temporary, dir_fd=directory_fd)
            except FileNotFoundError:
                pass
            raise

    def snapshot(self, output_name, data):
        return sealed_bytes(f"nmcp-{output_name}", data)

    def stage(self, race_hook=None):
        self.verify_chain()
        if self.stage_fd is not None:
            self.verify()
            return self.basename
        basename = self.project + "." + secrets.token_hex(12)
        os.mkdir(basename, 0o700, dir_fd=self.parent_fd)
        stage_fd = None
        try:
            stage_fd = open_directory(basename, self.parent_fd, self.uid, private=True)
            marker = {
                "schema": 1,
                "owner": self.owner,
                "project": self.project,
                "basename": basename,
                "commit": self.commit_oid,
            }
            marker["auth"] = hashlib.sha256(canonical_json(marker)).hexdigest()
            self.write_file(stage_fd, ".owner", canonical_json(marker) + b"\n", 0o600)
            for index, (_, tracked_path, output_name) in enumerate(INPUTS):
                data = self.source_data(tracked_path)
                if race_hook:
                    race_hook(index)
                self.write_file(stage_fd, output_name, data, 0o644)
            os.fsync(stage_fd)
            self.basename, self.stage_fd = basename, stage_fd
            stage_fd = None
            self.verify()
            return basename
        except Exception:
            if stage_fd is not None:
                try:
                    remove_tree(stage_fd)
                    os.rmdir(basename, dir_fd=self.parent_fd)
                finally:
                    os.close(stage_fd)
            else:
                try:
                    os.rmdir(basename, dir_fd=self.parent_fd)
                except OSError:
                    pass
            raise

    def _open_stage(self, basename):
        self.verify_chain()
        fd = open_directory(basename, self.parent_fd, self.uid, private=True)
        if self.stage_fd is not None:
            old = os.fstat(self.stage_fd)
            new = os.fstat(fd)
            if (old.st_dev, old.st_ino) != (new.st_dev, new.st_ino):
                os.close(fd)
                raise UnsafeInput("Compose input stage identity changed")
            os.close(fd)
            return
        self.basename, self.stage_fd = basename, fd

    def _read_marker(self, stage_fd):
        marker_fd, raw = read_regular(".owner", stage_fd, self.uid, 0o600, 4096)
        os.close(marker_fd)
        try:
            marker = json.loads(raw)
        except (UnicodeDecodeError, json.JSONDecodeError) as exc:
            raise UnsafeInput("invalid Compose input ownership marker") from exc
        if not isinstance(marker, dict):
            raise UnsafeInput("invalid Compose input ownership marker")
        expected = {"schema", "owner", "project", "basename", "commit", "auth"}
        authenticated = dict(marker)
        authentication = authenticated.pop("auth", None)
        if (
            set(marker) != expected
            or marker["schema"] != 1
            or marker["owner"] != self.owner
            or marker["project"] != self.project
            or marker["basename"] != self.basename
            or not isinstance(marker["commit"], str)
            or len(marker["commit"]) not in (40, 64)
            or authentication != hashlib.sha256(canonical_json(authenticated)).hexdigest()
        ):
            raise UnsafeInput("invalid Compose input ownership marker")
        return marker

    def _verify_contents(self, stage_fd, verify_sources=True):
        owned_directory(stage_fd, self.uid, private=True)
        expected_names = {".owner", *(output_name for _, _, output_name in INPUTS)}
        if set(os.listdir(stage_fd)) != expected_names:
            raise UnsafeInput("Compose input stage contains unexpected entries")
        marker = self._read_marker(stage_fd)
        if verify_sources:
            self.verify_git_identity()
            if marker["commit"] != self.commit_oid:
                raise UnsafeInput("registered inputs belong to a different commit")
        opened = {}
        try:
            for variable, tracked_path, output_name in INPUTS:
                fd, data = read_regular(output_name, stage_fd, self.uid, 0o644)
                if verify_sources and data != self.source_data(tracked_path):
                    os.close(fd)
                    raise UnsafeInput(f"staged Compose input content drift: {output_name}")
                os.close(fd)
                opened[variable] = self.snapshot(output_name, data)
        except Exception:
            for fd in opened.values():
                os.close(fd)
            raise
        self.close_snapshot_fds()
        self.input_fds = opened

    def verify(self):
        self.verify_chain()
        if self.stage_fd is None or self.basename is None:
            raise UnsafeInput("no Compose input stage is loaded")
        current = os.open(self.basename, os.O_RDONLY | DIRECTORY | NOFOLLOW, dir_fd=self.parent_fd)
        try:
            pinned, visible = os.fstat(self.stage_fd), os.fstat(current)
            if (pinned.st_dev, pinned.st_ino) != (visible.st_dev, visible.st_ino):
                raise UnsafeInput("Compose input stage identity changed")
        finally:
            os.close(current)
        self._verify_contents(self.stage_fd)

    def verify_lifecycle(self):
        self.verify_chain()
        if self.stage_fd is None or self.basename is None:
            raise UnsafeInput("no Compose input stage is loaded")
        current = os.open(self.basename, os.O_RDONLY | DIRECTORY | NOFOLLOW, dir_fd=self.parent_fd)
        try:
            if not same_identity(self.stage_fd, current):
                raise UnsafeInput("Compose input stage identity changed")
        finally:
            os.close(current)
        self._verify_contents(self.stage_fd, verify_sources=False)

    def register(self):
        self.verify()
        self.write_file(self.parent_fd, self.registry, (self.basename + "\n").encode(), 0o600)

    def restage(self, output_name):
        matches = [(path, name) for _, path, name in INPUTS if name == output_name]
        if len(matches) != 1 or self.stage_fd is None:
            raise UnsafeInput("invalid Compose input restage request")
        tracked_path, name = matches[0]
        self.write_file(self.stage_fd, name, self.source_data(tracked_path), 0o644)
        os.fsync(self.stage_fd)
        self.verify()

    def volume_manifest(self):
        files = {}
        for variable, tracked_path, _ in INPUTS:
            target = (
                "init/10-nmcp-roles.sql"
                if tracked_path == "infra/validation/postgres-init.sql"
                else tracked_path
            )
            data = read_fd(self.input_fds[variable])
            files[target] = {
                "sha256": hashlib.sha256(data).hexdigest(),
                "size": len(data),
                "mode": 0o444,
            }
        manifest = {
            "schema": 1,
            "owner": self.owner,
            "project": self.project,
            "basename": self.basename,
            "commit": self._read_marker(self.stage_fd)["commit"],
            "files": files,
        }
        digest = hashlib.sha256(canonical_json(manifest)).hexdigest()
        completion = canonical_json({"manifest": manifest, "digest": digest}) + b"\n"
        return manifest, digest, completion

    def expected_volume_labels(self, digest):
        return {
            "com.docker.compose.project": self.project,
            "com.docker.compose.volume": "compose-inputs",
            "com.nmcp.validation.owner": self.owner,
            "com.nmcp.validation.run": self.basename,
            "com.nmcp.validation.manifest": digest,
        }

    def inspect_volume(self, volume):
        inspect = subprocess.run(
            ["docker", "volume", "inspect", volume],
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            check=False,
        )
        if inspect.returncode != 0:
            raise MissingVolume(f"Compose input volume is absent: {volume}")
        return json.loads(inspect.stdout)[0]

    def volume_archive(self, volume):
        result = subprocess.run(
            [
                "docker", "run", "--rm", "--network", "none",
                "--volume", f"{volume}:/inputs:ro",
                "--entrypoint", "tar",
                "postgres:17-alpine@sha256:b0f9560a2de083e2cc7382e75f808c7381a32852a7ec49117deedb300e552b24",
                "-c", "-C", "/inputs", ".",
            ],
            stdout=subprocess.PIPE,
            check=True,
        )
        return result.stdout

    def validate_volume(self, volume, allow_empty=False):
        manifest, digest, completion = self.volume_manifest()
        details = self.inspect_volume(volume)
        labels = details.get("Labels") or {}
        expected_labels = self.expected_volume_labels(digest)
        if any(labels.get(name) != value for name, value in expected_labels.items()):
            raise UnsafeInput("Compose input volume labels do not match the verified manifest")
        archive = self.volume_archive(volume)
        with tarfile.open(fileobj=io.BytesIO(archive), mode="r:*") as contents:
            members = {}
            for member in contents.getmembers():
                name = member.name.removeprefix("./").rstrip("/")
                if name in ("", "."):
                    continue
                if name in members:
                    raise UnsafeInput("Compose input volume contains duplicate entries")
                members[name] = member
            if allow_empty and not members:
                return
            expected_dirs = {"init", "infra", "infra/postgresql", "infra/ubuntu", "infra/validation"}
            expected_files = set(manifest["files"]) | {".nmcp-complete"}
            if set(members) != expected_dirs | expected_files:
                raise UnsafeInput(
                    "Compose input volume inventory is incomplete or unexpected: "
                    + repr(sorted(members))
                )
            for name in expected_dirs:
                member = members[name]
                if not member.isdir() or member.mode != 0o555 or member.uid != 0 or member.gid != 0:
                    raise UnsafeInput(f"unsafe Compose input volume directory metadata: {name}")
            for name in expected_files:
                member = members[name]
                if not member.isfile() or member.mode != 0o444 or member.uid != 0 or member.gid != 0:
                    raise UnsafeInput(f"unsafe Compose input volume file metadata: {name}")
                stream = contents.extractfile(member)
                data = stream.read() if stream is not None else b""
                if name == ".nmcp-complete":
                    if data != completion:
                        raise UnsafeInput("Compose input volume completion record is invalid")
                    continue
                expected = manifest["files"][name]
                if len(data) != expected["size"] or hashlib.sha256(data).hexdigest() != expected["sha256"]:
                    raise UnsafeInput(f"Compose input volume content drift: {name}")

    def remove_volume(self, volume):
        subprocess.run(["docker", "volume", "rm", volume], stdout=subprocess.DEVNULL, check=True)

    def publish(self, create_hook=None):
        self.verify()
        volume = self.volume
        manifest, digest, completion = self.volume_manifest()
        expected_labels = self.expected_volume_labels(digest)
        try:
            self.validate_volume(volume)
            return volume
        except MissingVolume:
            pass
        except UnsafeInput:
            details = self.inspect_volume(volume)
            labels = details.get("Labels") or {}
            if any(labels.get(name) != value for name, value in expected_labels.items()):
                raise
            self.remove_volume(volume)

        archive = io.BytesIO()
        with tarfile.open(fileobj=archive, mode="w") as output:
            for name in ("init", "infra", "infra/postgresql", "infra/ubuntu", "infra/validation"):
                entry = tarfile.TarInfo(name)
                entry.type = tarfile.DIRTYPE
                entry.mode = 0o555
                output.addfile(entry)
            for variable, tracked_path, _ in INPUTS:
                name = "init/10-nmcp-roles.sql" if tracked_path == "infra/validation/postgres-init.sql" else tracked_path
                data = read_fd(self.input_fds[variable])
                entry = tarfile.TarInfo(name)
                entry.mode = 0o444
                entry.size = len(data)
                output.addfile(entry, io.BytesIO(data))
            entry = tarfile.TarInfo(".nmcp-complete")
            entry.mode = 0o444
            entry.size = len(completion)
            output.addfile(entry, io.BytesIO(completion))
        if create_hook:
            create_hook(volume, expected_labels)
        last_error = None
        for _ in range(2):
            labels_match = False
            try:
                create = ["docker", "volume", "create"]
                for name, value in expected_labels.items():
                    create.extend(("--label", f"{name}={value}"))
                create.append(volume)
                subprocess.run(create, stdout=subprocess.DEVNULL, check=True)
                details = self.inspect_volume(volume)
                labels = details.get("Labels") or {}
                labels_match = all(labels.get(name) == value for name, value in expected_labels.items())
                if not labels_match:
                    raise UnsafeInput("Compose input volume create race produced unowned labels")
                self.validate_volume(volume, allow_empty=True)
                subprocess.run(
                    [
                        "docker", "run", "--rm", "--interactive", "--network", "none",
                        "--volume", f"{volume}:/inputs",
                        "--entrypoint", "sh",
                        "postgres:17-alpine@sha256:b0f9560a2de083e2cc7382e75f808c7381a32852a7ec49117deedb300e552b24",
                        "-eu", "-c", "tar -x -C /inputs",
                    ],
                    input=archive.getvalue(),
                    stdout=subprocess.DEVNULL,
                    check=True,
                )
                self.validate_volume(volume)
                return volume
            except Exception as exc:
                last_error = exc
                if not labels_match:
                    raise
                subprocess.run(
                    ["docker", "volume", "rm", volume],
                    stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL,
                    check=False,
                )
        raise last_error

    def volume_security_test(self):
        volume = self.publish()
        image = "postgres:17-alpine@sha256:b0f9560a2de083e2cc7382e75f808c7381a32852a7ec49117deedb300e552b24"
        subprocess.run(
            [
                "docker", "run", "--rm", "--network", "none", "--volume", f"{volume}:/inputs",
                "--entrypoint", "sh", image, "-eu", "-c",
                "chmod 0644 /inputs/infra/postgresql/runtime-roles.sql; printf evil > /inputs/infra/postgresql/runtime-roles.sql; "
                "rm /inputs/.nmcp-complete; touch /inputs/unexpected",
            ],
            stdout=subprocess.DEVNULL,
            check=True,
        )
        self.publish()
        self.validate_volume(volume)
        self.unpublish()

        def create_partial(name, labels):
            create = ["docker", "volume", "create"]
            for label, value in labels.items():
                create.extend(("--label", f"{label}={value}"))
            create.append(name)
            subprocess.run(create, stdout=subprocess.DEVNULL, check=True)
            subprocess.run(
                [
                    "docker", "run", "--rm", "--network", "none", "--volume", f"{name}:/inputs",
                    "--entrypoint", "sh", image, "-eu", "-c", "mkdir -p /inputs/infra; printf partial > /inputs/infra/partial",
                ],
                stdout=subprocess.DEVNULL,
                check=True,
            )

        self.publish(create_hook=create_partial)
        self.validate_volume(volume)
        return volume

    def seed_partial_volume_and_wait(self):
        if os.environ.get("NMCP_VALIDATION_KILL_TEST") != "1":
            raise UnsafeInput("partial-volume kill test is not enabled")
        self.verify()
        volume = self.volume
        _, digest, _ = self.volume_manifest()
        labels = self.expected_volume_labels(digest)
        try:
            self.remove_volume(volume)
        except subprocess.CalledProcessError:
            pass
        create = ["docker", "volume", "create"]
        for label, value in labels.items():
            create.extend(("--label", f"{label}={value}"))
        create.append(volume)
        subprocess.run(create, stdout=subprocess.DEVNULL, check=True)
        subprocess.run(
            [
                "docker", "run", "--rm", "--network", "none", "--volume", f"{volume}:/inputs",
                "--entrypoint", "sh",
                "postgres:17-alpine@sha256:b0f9560a2de083e2cc7382e75f808c7381a32852a7ec49117deedb300e552b24",
                "-eu", "-c", "mkdir -p /inputs/infra; printf killed-partial > /inputs/infra/partial",
            ],
            stdout=subprocess.DEVNULL,
            check=True,
        )
        while True:
            time.sleep(60)

    def unpublish(self):
        volume = self.volume
        inspect = subprocess.run(
            ["docker", "volume", "inspect", volume],
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            check=False,
        )
        if inspect.returncode != 0:
            return
        details = json.loads(inspect.stdout)[0]
        labels = details.get("Labels") or {}
        if (
            labels.get("com.docker.compose.project") != self.project
            or labels.get("com.docker.compose.volume") != "compose-inputs"
            or labels.get("com.nmcp.validation.owner") != self.owner
            or labels.get("com.nmcp.validation.run") != self.basename
        ):
            raise UnsafeInput("refusing to remove an unowned Compose input volume")
        subprocess.run(["docker", "volume", "rm", volume], stdout=subprocess.DEVNULL, check=True)

    def _read_registry(self):
        self.verify_chain()
        try:
            fd, data = read_regular(self.registry, self.parent_fd, self.uid, 0o600, 512)
        except UnsafeInput as exc:
            try:
                os.stat(self.registry, dir_fd=self.parent_fd, follow_symlinks=False)
            except FileNotFoundError:
                return None, None
            raise exc
        try:
            name = data.decode("ascii").removesuffix("\n")
        except UnicodeDecodeError as exc:
            os.close(fd)
            raise UnsafeInput("non-ASCII Compose input registry") from exc
        if "\n" in name or "\r" in name:
            os.close(fd)
            raise UnsafeInput("invalid Compose input registry")
        try:
            return check_basename(name, self.project), fd
        except Exception:
            os.close(fd)
            raise

    def read_registry(self):
        name, fd = self._read_registry()
        if fd is not None:
            os.close(fd)
        return name

    def load(self, lifecycle=False):
        basename = self.read_registry()
        if basename is None:
            return None
        try:
            self._open_stage(basename)
        except UnsafeInput:
            if lifecycle:
                try:
                    os.stat(basename, dir_fd=self.parent_fd, follow_symlinks=False)
                except FileNotFoundError:
                    self.basename = basename
                    return basename
            raise
        if lifecycle:
            self.verify_lifecycle()
        else:
            self.verify()
        return basename

    def remove(self, race_hook=None):
        if self.stage_fd is None:
            return
        self.verify_lifecycle()
        registered, registry_fd = self._read_registry()
        if registered is not None and registered != self.basename:
            os.close(registry_fd)
            raise UnsafeInput("Compose input registry identity changed")
        detached = ".delete-" + self.basename + "-" + secrets.token_hex(12)
        try:
            if race_hook:
                race_hook()
            os.rename(self.basename, detached, src_dir_fd=self.parent_fd, dst_dir_fd=self.parent_fd)
        except Exception:
            if registry_fd is not None:
                os.close(registry_fd)
            raise
        candidate = None
        exact_detach = False
        try:
            candidate = os.open(detached, os.O_RDONLY | DIRECTORY | NOFOLLOW, dir_fd=self.parent_fd)
            if not same_identity(self.stage_fd, candidate):
                raise UnsafeInput("Compose input stage changed before cleanup detach")
            exact_detach = True
            self.clear_snapshots()
            remove_tree(candidate)
            os.close(candidate)
            candidate = None
            os.rmdir(detached, dir_fd=self.parent_fd)
            if registered is not None:
                visible = os.open(self.registry, os.O_RDONLY | NOFOLLOW, dir_fd=self.parent_fd)
                try:
                    if not same_identity(registry_fd, visible):
                        raise UnsafeInput("Compose input registry changed before cleanup")
                finally:
                    os.close(visible)
                os.unlink(self.registry, dir_fd=self.parent_fd)
            self.close_stage()
        finally:
            if candidate is not None:
                os.close(candidate)
            if registry_fd is not None:
                os.close(registry_fd)
            if not exact_detach:
                try:
                    os.stat(self.basename, dir_fd=self.parent_fd, follow_symlinks=False)
                except FileNotFoundError:
                    try:
                        os.rename(detached, self.basename, src_dir_fd=self.parent_fd, dst_dir_fd=self.parent_fd)
                    except FileNotFoundError:
                        pass

    def cleanup_project(self):
        self.close_stage()
        errors = []
        candidates = []
        for name in os.listdir(self.parent_fd):
            if name.startswith(".delete-" + self.project + "."):
                candidates.append(name)
                continue
            try:
                check_basename(name, self.project)
                candidates.append(name)
            except UnsafeInput:
                pass
        for name in candidates:
            stage_fd = detached_fd = None
            detached = name
            try:
                stage_fd = open_directory(name, self.parent_fd, self.uid, private=True)
                marker_fd, raw = read_regular(".owner", stage_fd, self.uid, 0o600, 4096)
                os.close(marker_fd)
                marker = json.loads(raw)
                if not isinstance(marker, dict):
                    raise UnsafeInput("invalid cleanup ownership marker")
                basename = marker.get("basename") if isinstance(marker, dict) else None
                authenticated = dict(marker)
                authentication = authenticated.pop("auth", None)
                if (
                    marker.get("schema") != 1
                    or marker.get("owner") != self.owner
                    or marker.get("project") != self.project
                    or not isinstance(basename, str)
                    or not basename.startswith(self.project + ".")
                    or (name != basename and not name.startswith(".delete-" + basename + "-"))
                    or authentication != hashlib.sha256(canonical_json(authenticated)).hexdigest()
                ):
                    raise UnsafeInput("invalid cleanup ownership marker")
                if name == basename:
                    detached = ".delete-" + basename + "-" + secrets.token_hex(12)
                    os.rename(name, detached, src_dir_fd=self.parent_fd, dst_dir_fd=self.parent_fd)
                    detached_fd = os.open(detached, os.O_RDONLY | DIRECTORY | NOFOLLOW, dir_fd=self.parent_fd)
                    if not same_identity(stage_fd, detached_fd):
                        raise UnsafeInput("cleanup stage identity changed during detach")
                    os.close(stage_fd)
                    stage_fd = detached_fd
                    detached_fd = None
                remove_tree(stage_fd)
                os.close(stage_fd)
                stage_fd = None
                os.rmdir(detached, dir_fd=self.parent_fd)
            except Exception as exc:
                errors.append(f"stage {name}: {exc}")
            finally:
                for fd in (detached_fd, stage_fd):
                    if fd is not None:
                        os.close(fd)

        volumes = subprocess.run(
            ["docker", "volume", "ls", "--quiet", "--filter", f"label=com.docker.compose.project={self.project}"],
            stdout=subprocess.PIPE,
            text=True,
            check=False,
        )
        if volumes.returncode != 0:
            errors.append("volume discovery failed")
        else:
            for volume in volumes.stdout.split():
                try:
                    details = self.inspect_volume(volume)
                    labels = details.get("Labels") or {}
                    if labels.get("com.docker.compose.volume") != "compose-inputs":
                        continue
                    if labels.get("com.nmcp.validation.owner") != self.owner:
                        raise UnsafeInput("refusing to remove an unowned Compose input volume")
                    run = labels.get("com.nmcp.validation.run", "")
                    if not run.startswith(self.project + "."):
                        raise UnsafeInput("Compose input volume has an invalid run identity")
                    self.remove_volume(volume)
                except Exception as exc:
                    errors.append(f"volume {volume}: {exc}")

        if not errors:
            try:
                registered, registry_fd = self._read_registry()
                if registry_fd is not None:
                    remaining = any(
                        name == registered or name.startswith(".delete-" + registered + "-")
                        for name in os.listdir(self.parent_fd)
                    )
                    if not remaining:
                        visible = os.open(self.registry, os.O_RDONLY | NOFOLLOW, dir_fd=self.parent_fd)
                        try:
                            if not same_identity(registry_fd, visible):
                                raise UnsafeInput("registry identity changed during cleanup")
                        finally:
                            os.close(visible)
                        os.unlink(self.registry, dir_fd=self.parent_fd)
                    os.close(registry_fd)
            except Exception as exc:
                errors.append(f"registry: {exc}")
        if errors:
            raise UnsafeInput("cleanup failures: " + "; ".join(errors))

    def run(self, argv, race_hook=None, stdio=None):
        self.verify()
        if race_hook:
            race_hook()
        self.verify_chain()
        env = os.environ.copy()
        env["NMCP_COMPOSE_INPUT_VOLUME"] = self.volume
        for variable in self.input_fds:
            fd = self.input_fds[variable]
            env[variable] = f"/proc/{os.getpid()}/fd/{fd}"
        kwargs = {}
        if stdio is not None:
            kwargs = {"stdin": stdio[0], "stdout": stdio[1], "stderr": stdio[2]}
        return subprocess.call(argv, env=env, **kwargs)

    def run_lifecycle(self, argv, stdio=None):
        self.verify_chain()
        env = os.environ.copy()
        env["NMCP_COMPOSE_INPUT_VOLUME"] = (
            self.volume if self.basename is not None else self.project + "_compose-inputs-none"
        )
        kwargs = {}
        if stdio is not None:
            kwargs = {"stdin": stdio[0], "stdout": stdio[1], "stderr": stdio[2]}
        return subprocess.call(argv, env=env, **kwargs)


def respond(sock, payload):
    sock.send(json.dumps(payload, separators=(",", ":")).encode())


def serve(sock, child, store):
    sock.settimeout(0.1)
    while child.poll() is None:
        try:
            raw, ancillary, _, _ = sock.recvmsg(
                1024 * 1024, socket.CMSG_SPACE(3 * array.array("i").itemsize)
            )
        except socket.timeout:
            continue
        if not raw:
            break
        passed_fds = []
        try:
            for level, kind, data in ancillary:
                if level == socket.SOL_SOCKET and kind == socket.SCM_RIGHTS:
                    values = array.array("i")
                    values.frombytes(data[: len(data) - (len(data) % values.itemsize)])
                    passed_fds.extend(values)
            request = json.loads(raw)
            command = request["command"]
            if command == "stage":
                result = store.stage()
            elif command == "load":
                result = store.load()
            elif command == "load-lifecycle":
                result = store.load(lifecycle=True)
            elif command == "verify":
                store.verify()
                result = True
            elif command == "register":
                store.register()
                result = True
            elif command == "restage":
                store.restage(request["name"])
                result = True
            elif command == "publish":
                result = store.publish()
            elif command == "volume-test":
                result = store.volume_security_test()
            elif command == "seed-partial-and-wait":
                store.seed_partial_volume_and_wait()
                result = True
            elif command == "unpublish":
                store.unpublish()
                result = True
            elif command == "remove":
                store.remove()
                result = True
            elif command == "cleanup":
                store.cleanup_project()
                result = True
            elif command == "run":
                if len(passed_fds) != 3:
                    raise UnsafeInput("validation command did not provide stdin/stdout/stderr")
                result = store.run(request["argv"], stdio=passed_fds)
            elif command == "run-lifecycle":
                if len(passed_fds) != 3:
                    raise UnsafeInput("validation command did not provide stdin/stdout/stderr")
                result = store.run_lifecycle(request["argv"], stdio=passed_fds)
            else:
                raise UnsafeInput(f"unknown validation input command: {command}")
            respond(sock, {"ok": True, "result": result})
        except Exception as exc:
            respond(sock, {"ok": False, "error": str(exc)})
        finally:
            for passed_fd in passed_fds:
                os.close(passed_fd)
    return child.wait()


def invoke(root, project, script, arguments):
    check_project(project)
    uid = os.getuid()
    root_path = os.path.realpath(root)
    if os.path.abspath(root) != root_path:
        raise UnsafeInput("validation repository root must be canonical and non-symlinked")
    root_fd = os.open(root_path, os.O_RDONLY | DIRECTORY | NOFOLLOW)
    validation_fd = parent_fd = git_entry_fd = gitdir_fd = None
    lock_sock = None
    try:
        owned_directory(root_fd, uid)
        git_entry_fd = os.open(".git", os.O_RDONLY | NOFOLLOW, dir_fd=root_fd)
        gitdir_path = subprocess.check_output(
            ["git", "-C", root_path, "rev-parse", "--absolute-git-dir"], text=True
        ).strip()
        if os.path.realpath(gitdir_path) != gitdir_path:
            raise UnsafeInput("repository gitdir must be canonical and non-symlinked")
        gitdir_fd = os.open(gitdir_path, os.O_RDONLY | DIRECTORY | NOFOLLOW)
        commit_oid = subprocess.check_output(
            ["git", f"--git-dir=/proc/{os.getpid()}/fd/{gitdir_fd}", "rev-parse", "--verify", "HEAD^{commit}"],
            text=True,
        ).strip()
        validation_fd = open_directory(".validation", root_fd, uid, create=True)
        parent_fd = open_directory("compose-inputs", validation_fd, uid, private=True, create=True)
        root_info = os.fstat(root_fd)
        lock_name = "\0nmcp-validation-" + hashlib.sha256(
            f"{uid}:{root_info.st_dev}:{root_info.st_ino}:{project}".encode()
        ).hexdigest()
        while True:
            candidate = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            try:
                candidate.bind(lock_name)
                lock_sock = candidate
                break
            except OSError as exc:
                candidate.close()
                if exc.errno != errno.EADDRINUSE:
                    raise
                time.sleep(0.05)
        owner = hashlib.sha256(os.fsencode(root_path)).hexdigest()
        server_sock, child_sock = socket.socketpair(socket.AF_UNIX, socket.SOCK_SEQPACKET)
        os.set_inheritable(child_sock.fileno(), True)
        env = os.environ.copy()
        env["NMCP_VALIDATION_INPUTS_MANAGED"] = "1"
        env["NMCP_VALIDATION_INPUTS_PROJECT"] = project
        env["NMCP_VALIDATION_INPUTS_FD"] = str(child_sock.fileno())
        child = subprocess.Popen([script, *arguments], env=env, pass_fds=(child_sock.fileno(),))
        child_sock.close()
        store = Store(
            root_path,
            root_fd,
            validation_fd,
            parent_fd,
            project,
            owner,
            uid,
            git_entry_fd,
            gitdir_path,
            gitdir_fd,
            commit_oid,
        )
        try:
            return serve(server_sock, child, store)
        finally:
            if store.stage_fd is not None and store.read_registry() != store.basename:
                store.cleanup_project()
            store.close_stage()
            server_sock.close()
    finally:
        if lock_sock is not None:
            lock_sock.close()
        for fd in (gitdir_fd, git_entry_fd, parent_fd, validation_fd, root_fd):
            if fd is not None:
                os.close(fd)


def client(command, argv):
    fd = int(os.environ["NMCP_VALIDATION_INPUTS_FD"])
    sock = socket.socket(fileno=os.dup(fd))
    request = {"command": command}
    if command in ("run", "run-lifecycle"):
        request["argv"] = argv
    elif command == "restage":
        if len(argv) != 1:
            raise UnsafeInput("restage requires one output basename")
        request["name"] = argv[0]
    payload = json.dumps(request, separators=(",", ":")).encode()
    if command in ("run", "run-lifecycle"):
        descriptors = array.array("i", (0, 1, 2))
        sock.sendmsg([payload], [(socket.SOL_SOCKET, socket.SCM_RIGHTS, descriptors)])
    else:
        sock.send(payload)
    response = json.loads(sock.recv(1024 * 1024))
    if not response["ok"]:
        raise UnsafeInput(response["error"])
    result = response["result"]
    if command in ("stage", "load", "load-lifecycle", "publish", "volume-test") and result is not None:
        print(result)
    return result if command == "run" else 0


def expect_denied(label, operation):
    try:
        operation()
    except (UnsafeInput, OSError):
        return
    raise AssertionError(f"accepted {label}")


def self_test():
    project = "stage-test"
    owner = "a" * 64
    uid = os.getuid()
    with tempfile.TemporaryDirectory() as temporary:
        root = os.path.join(temporary, "repo")
        outside = os.path.join(temporary, "outside")
        os.mkdir(root, 0o700)
        os.mkdir(outside, 0o700)
        with open(os.path.join(root, "README"), "w", encoding="ascii") as stream:
            stream.write("validation test repository\n")
        for _, tracked_path, _ in INPUTS:
            path = os.path.join(root, tracked_path)
            os.makedirs(os.path.dirname(path), exist_ok=True)
            with open(path, "w", encoding="ascii") as stream:
                stream.write("version one: " + tracked_path + "\n")
        subprocess.run(["git", "init", "--quiet", root], check=True)
        subprocess.run(["git", "-C", root, "add", "."], check=True)
        commit_env = os.environ | {
            "GIT_AUTHOR_NAME": "validation-test",
            "GIT_AUTHOR_EMAIL": "validation@example.invalid",
            "GIT_COMMITTER_NAME": "validation-test",
            "GIT_COMMITTER_EMAIL": "validation@example.invalid",
        }
        subprocess.run(["git", "-C", root, "commit", "--quiet", "-m", "test"], env=commit_env, check=True)
        for _, tracked_path, _ in INPUTS:
            with open(os.path.join(root, tracked_path), "w", encoding="ascii") as stream:
                stream.write("version two: " + tracked_path + "\n")
        subprocess.run(["git", "-C", root, "commit", "--quiet", "-am", "second"], env=commit_env, check=True)
        sentinel = os.path.join(outside, "sentinel")
        with open(sentinel, "w", encoding="ascii") as stream:
            stream.write("unchanged")
        root_fd = os.open(root, os.O_RDONLY | DIRECTORY | NOFOLLOW)
        os.mkdir(".validation", 0o700, dir_fd=root_fd)
        validation_fd = open_directory(".validation", root_fd, uid)
        os.mkdir("compose-inputs", 0o700, dir_fd=validation_fd)
        parent_fd = open_directory("compose-inputs", validation_fd, uid, private=True)

        git_entry_fd = os.open(".git", os.O_RDONLY | NOFOLLOW, dir_fd=root_fd)
        gitdir_path = os.path.join(root, ".git")
        gitdir_fd = os.open(gitdir_path, os.O_RDONLY | DIRECTORY | NOFOLLOW)
        pinned_commit = subprocess.check_output(
            ["git", "-C", root, "rev-parse", "HEAD"], text=True
        ).strip()
        provenance = Store(
            root,
            root_fd,
            validation_fd,
            parent_fd,
            "provenance-test",
            owner,
            uid,
            git_entry_fd,
            gitdir_path,
            gitdir_fd,
            pinned_commit,
        )
        before_provenance = set(os.listdir(parent_fd))
        switched = False
        def switch_head(index):
            nonlocal switched
            if index == 0 and not switched:
                subprocess.run(["git", "-C", root, "checkout", "--quiet", "HEAD^"], check=True)
                switched = True
        expect_denied("mid-stage HEAD switch", lambda: provenance.stage(race_hook=switch_head))
        assert set(os.listdir(parent_fd)) == before_provenance
        subprocess.run(["git", "-C", root, "checkout", "--quiet", pinned_commit], check=True)

        persisted = Store(
            root, root_fd, validation_fd, parent_fd, "lifecycle-test", owner, uid,
            git_entry_fd, gitdir_path, gitdir_fd, pinned_commit,
        )
        persisted.stage()
        persisted.register()
        persisted.close_stage()
        subprocess.run(["git", "-C", root, "checkout", "--quiet", "HEAD^"], check=True)
        older_commit = subprocess.check_output(["git", "-C", root, "rev-parse", "HEAD"], text=True).strip()
        strict_reload = Store(
            root, root_fd, validation_fd, parent_fd, "lifecycle-test", owner, uid,
            git_entry_fd, gitdir_path, gitdir_fd, older_commit,
        )
        expect_denied("registered stage after HEAD switch", strict_reload.load)
        strict_reload.close_stage()
        lifecycle_reload = Store(
            root, root_fd, validation_fd, parent_fd, "lifecycle-test", owner, uid,
            git_entry_fd, gitdir_path, gitdir_fd, older_commit,
        )
        assert lifecycle_reload.load(lifecycle=True)
        lifecycle_reload.cleanup_project()
        subprocess.run(["git", "-C", root, "checkout", "--quiet", pinned_commit], check=True)

        local_edit = Store(
            root, root_fd, validation_fd, parent_fd, "local-edit-test", owner, uid,
            git_entry_fd, gitdir_path, gitdir_fd, pinned_commit,
        )
        local_edit.stage()
        local_edit.register()
        local_edit.close_stage()
        with open(os.path.join(root, INPUTS[0][1]), "a", encoding="ascii") as stream:
            stream.write("local edit\n")
        edited_reload = Store(
            root, root_fd, validation_fd, parent_fd, "local-edit-test", owner, uid,
            git_entry_fd, gitdir_path, gitdir_fd, pinned_commit,
        )
        assert edited_reload.load(lifecycle=True)
        edited_reload.cleanup_project()
        subprocess.run(["git", "-C", root, "checkout", "--quiet", pinned_commit], check=True)
        os.close(gitdir_fd)
        os.close(git_entry_fd)

        moved_validation = os.path.join(temporary, "moved-validation")
        os.rename(os.path.join(root, ".validation"), moved_validation)
        os.symlink(outside, os.path.join(root, ".validation"))
        assert os.fstat(validation_fd).st_ino == os.stat(moved_validation).st_ino
        expect_denied("parent symlink", lambda: open_directory(".validation", root_fd, uid))
        os.unlink(os.path.join(root, ".validation"))
        os.rename(moved_validation, os.path.join(root, ".validation"))
        moved_inputs = os.path.join(temporary, "moved-inputs")
        inputs_path = os.path.join(root, ".validation", "compose-inputs")
        os.rename(inputs_path, moved_inputs)
        os.symlink(outside, inputs_path)
        expect_denied("intermediate symlink", lambda: open_directory("compose-inputs", validation_fd, uid))
        os.unlink(inputs_path)
        os.rename(moved_inputs, inputs_path)

        for bad in (b"", b".\n", b"..\n", b"/\n", b"../outside\n"):
            fd = os.open(project + ".registry", os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600, dir_fd=parent_fd)
            os.write(fd, bad)
            os.close(fd)
            store = Store(root, root_fd, validation_fd, parent_fd, project, owner, uid)
            expect_denied(repr(bad), store.load)
        os.unlink(project + ".registry", dir_fd=parent_fd)

        def fake_store():
            store = Store(root, root_fd, validation_fd, parent_fd, project, owner, uid)
            store.source_data = lambda path: (path + "\n").encode()
            return store

        store = fake_store()
        basename = store.stage()
        store.register()
        leaf = os.path.join(root, ".validation", "compose-inputs", basename, "postgres-init.sql")
        os.unlink(leaf)
        os.symlink(sentinel, leaf)
        expect_denied("leaf symlink", store.verify)
        store.close_stage()

        store = fake_store()
        basename = store.stage()
        store.register()
        stage_path = os.path.join(root, ".validation", "compose-inputs", basename)
        moved = os.path.join(outside, basename)
        os.rename(stage_path, moved)
        os.symlink(moved, stage_path)
        store.close_stage()
        expect_denied("moved-outside reload", store.load)
        os.unlink(stage_path)
        os.rename(moved, stage_path)
        store.load()

        moved_parent = os.path.join(temporary, "moved-compose-inputs")
        os.rename(inputs_path, moved_parent)
        os.symlink(outside, inputs_path)
        store.close_stage()
        expect_denied("moved-outside registry reload", store.load)
        os.unlink(inputs_path)
        os.rename(moved_parent, inputs_path)
        store.load()

        def mutate_sealed_snapshots():
            assert len(store.input_fds) == len(INPUTS)
            for fd in store.input_fds.values():
                os.fchmod(fd, 0o600)
                for operation in (
                    lambda fd=fd: os.ftruncate(fd, 0),
                    lambda fd=fd: os.pwrite(fd, b"evil", 0),
                ):
                    try:
                        operation()
                    except OSError as exc:
                        assert exc.errno in (errno.EPERM, errno.EBUSY), exc
                    else:
                        raise AssertionError("sealed snapshot accepted content mutation")
        def swap_stage():
            os.rename(stage_path, os.path.join(outside, "original"))
            os.symlink(outside, stage_path)
        command = [
            sys.executable,
            "-c",
            "import os,sys,json; expected=json.loads(sys.argv[1]); "
            "assert all(open(os.environ[name], 'rb').read() == value.encode() for name,value in expected.items())",
            json.dumps({variable: tracked_path + "\n" for variable, tracked_path, _ in INPUTS}),
        ]
        assert store.run(command, race_hook=mutate_sealed_snapshots) == 0

        expect_denied("verify-to-cleanup swap", lambda: store.remove(race_hook=swap_stage))
        assert open(sentinel, encoding="ascii").read() == "unchanged"
        if os.path.islink(stage_path):
            os.unlink(stage_path)
        detached = [name for name in os.listdir(os.path.join(root, ".validation", "compose-inputs")) if name.startswith(".delete-")]
        for name in detached:
            path = os.path.join(root, ".validation", "compose-inputs", name)
            if os.path.islink(path):
                os.unlink(path)

        partial = fake_store()
        calls = 0
        def failing_source(path):
            nonlocal calls
            calls += 1
            if calls == 2:
                raise UnsafeInput("injected partial-stage failure")
            return b"safe\n"
        partial.source_data = failing_source
        before = set(os.listdir(os.path.join(root, ".validation", "compose-inputs")))
        expect_denied("partial staging", partial.stage)
        after = set(os.listdir(os.path.join(root, ".validation", "compose-inputs")))
        assert before == after

        stranded = fake_store()
        stranded_basename = stranded.stage()
        stranded.register()
        stranded_name = ".delete-" + stranded_basename + "-stranded"
        os.rename(stranded_basename, stranded_name, src_dir_fd=parent_fd, dst_dir_fd=parent_fd)
        stranded.close_stage()
        stranded.cleanup_project()
        assert stranded.read_registry() is None
        assert stranded_name not in os.listdir(parent_fd)

        lock_name = project + ".lock-test"
        lock_a = os.open(lock_name, os.O_RDWR | os.O_CREAT | NOFOLLOW, 0o600, dir_fd=parent_fd)
        lock_b = os.open(lock_name, os.O_RDWR | NOFOLLOW, dir_fd=parent_fd)
        fcntl.flock(lock_a, fcntl.LOCK_EX)
        pid = os.fork()
        if pid == 0:
            start = time.monotonic()
            fcntl.flock(lock_b, fcntl.LOCK_EX)
            os._exit(0 if time.monotonic() - start >= 0.15 else 1)
        time.sleep(0.2)
        fcntl.flock(lock_a, fcntl.LOCK_UN)
        _, status = os.waitpid(pid, 0)
        assert os.waitstatus_to_exitcode(status) == 0
        os.close(lock_a)
        os.close(lock_b)
        assert open(sentinel, encoding="ascii").read() == "unchanged"
        os.close(parent_fd)
        os.close(validation_fd)
        os.close(root_fd)

        sleeper = os.path.join(root, "sleep-validation")
        with open(sleeper, "w", encoding="ascii") as stream:
            stream.write("#!/bin/sh\nsleep \"$1\"\n")
        os.chmod(sleeper, 0o700)
        helper = os.path.realpath(__file__)
        def timed_invocations(projects):
            started = time.monotonic()
            children = [
                subprocess.Popen([sys.executable, helper, "invoke", root, name, sleeper, "0.3"])
                for name in projects
            ]
            assert all(child.wait() == 0 for child in children)
            return time.monotonic() - started
        serialized = timed_invocations(("concurrent", "concurrent"))
        parallel = timed_invocations(("peer-a", "peer-b"))
        assert serialized >= 0.55, serialized
        assert parallel < serialized - 0.15, (serialized, parallel)

        first = subprocess.Popen([sys.executable, helper, "invoke", root, "lock-replacement", sleeper, "0.4"])
        time.sleep(0.1)
        lock_path = os.path.join(root, ".validation", "compose-inputs", "lock-replacement.lock")
        with open(lock_path, "w", encoding="ascii") as stream:
            stream.write("first")
        os.rename(lock_path, lock_path + ".moved")
        with open(lock_path, "w", encoding="ascii") as stream:
            stream.write("replacement")
        second_started = time.monotonic()
        second = subprocess.Popen([sys.executable, helper, "invoke", root, "lock-replacement", sleeper, "0.1"])
        assert first.wait() == 0 and second.wait() == 0
        assert time.monotonic() - second_started >= 0.35
    print("validation input security tests passed")
    return 0


def main():
    try:
        if len(sys.argv) >= 2 and sys.argv[1] == "invoke":
            if len(sys.argv) < 5:
                raise UnsafeInput("invoke requires ROOT PROJECT SCRIPT [ARGS...]")
            return invoke(sys.argv[2], sys.argv[3], sys.argv[4], sys.argv[5:])
        if len(sys.argv) >= 3 and sys.argv[1] == "client":
            return client(sys.argv[2], sys.argv[3:])
        if sys.argv[1:] == ["self-test"]:
            return self_test()
        raise UnsafeInput("usage: validation-inputs {invoke|client|self-test} ...")
    except (UnsafeInput, OSError, subprocess.CalledProcessError) as exc:
        print(f"error: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
