        os.close(marker_fd)
        valid_marker = json.loads(valid_marker_raw)
        def marker_bytes(change):
            changed = dict(valid_marker)
            changed.pop("auth")
            change(changed)
            changed["auth"] = hashlib.sha256(canonical_json(changed)).hexdigest()
            return canonical_json(changed) + b"\n"
        malformed_markers = (
            ("extra marker key", marker_bytes(lambda value: value.__setitem__("extra", True))),
            ("missing marker schema", marker_bytes(lambda value: value.pop("schema"))),
            ("wrong marker schema", marker_bytes(lambda value: value.__setitem__("schema", 2))),
            ("marker commit mismatch", marker_bytes(
                lambda value: value.__setitem__("commit", "f" * len(marker_intent["commit"]))
            )),
        )
        original_run = subprocess.run
        subprocess.run = lambda *args, **kwargs: subprocess.CompletedProcess(args[0], 0, "")
        try:
            for label, malformed_marker in malformed_markers:
                marker_store.write_file(marker_stage_fd, ".owner", malformed_marker, 0o600)
                expect_denied(label, marker_store.cleanup_project)
                assert marker_intent["basename"] in os.listdir(parent_fd)
            marker_store.write_file(marker_stage_fd, ".owner", valid_marker_raw, 0o600)
            os.close(marker_stage_fd)
            marker_stage_fd = None
            marker_store.cleanup_project()
        finally:
            subprocess.run = original_run
            if marker_stage_fd is not None:
                os.close(marker_stage_fd)

