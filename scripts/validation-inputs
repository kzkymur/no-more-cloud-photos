        malformed_tree_cases = (
            b"100644 truncated\0short",
            b"100644 duplicate\0" + bytes.fromhex(pinned_commit) + b"100644 duplicate\0" + bytes.fromhex(pinned_commit),
            b"100644 ../unsafe\0" + bytes.fromhex(pinned_commit),
            b"100644 missing-object-name",
        )
        for malformed_tree in malformed_tree_cases:
            expect_denied(
                "malformed verified Git tree",
                lambda data=malformed_tree: parse_tree(data, len(pinned_commit)),
            )
        invalid_mode_entries = {b"infra": (b"100644", pinned_commit)}
        expect_denied(
            "non-tree intermediate tracked entry",
            lambda: tree_entry_oid(invalid_mode_entries, b"infra", b"40000", INPUTS[0][1]),
        )
        invalid_mode_entries = {b"postgres-init.sql": (b"100755", pinned_commit)}
        expect_denied(
            "executable final tracked entry",
            lambda: tree_entry_oid(
                invalid_mode_entries, b"postgres-init.sql", b"100644", INPUTS[0][1],
            ),
        )

        oversized_path = os.path.join(root, INPUTS[0][1])
        with open(oversized_path, "rb") as stream:
            oversized_original = stream.read()
        oversized = subprocess.Popen(
            [sys.executable, helper, "invoke", root, "oversized-source", delayed_stage_child],
            env=git_environment(), stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
        )
        time.sleep(0.1)
        with open(oversized_path, "ab") as stream:
            stream.write(b"oversized after verified snapshot\n")
        assert oversized.wait() != 0
        with open(oversized_path, "wb") as stream:
            stream.write(oversized_original)
        os.chmod(oversized_path, 0o600)

        reftable_root = os.path.join(temporary, "reftable-repo")
        subprocess.run(
            ["git", "init", "--quiet", "--ref-format=reftable", reftable_root],
            env=git_environment(), check=True,
        )
        reftable_root_fd = os.open(reftable_root, os.O_RDONLY | DIRECTORY | NOFOLLOW)
        reftable_entry_fd = os.open(".git", os.O_RDONLY | DIRECTORY | NOFOLLOW, dir_fd=reftable_root_fd)
        try:
            expect_denied(
                "unsupported reftable repository",
                lambda: resolve_checkout_git(reftable_root, reftable_root_fd, reftable_entry_fd),
            )
        finally:
            os.close(reftable_entry_fd)
            os.close(reftable_root_fd)

        foreign_gitdir = os.path.join(temporary, "foreign.git")
        subprocess.run(
            ["git", "clone", "--quiet", "--bare", root, foreign_gitdir],
            env=git_environment(), check=True,
        )
        subprocess.run(
            ["git", f"--git-dir={foreign_gitdir}", "update-ref", "HEAD", pinned_commit + "^"],
            env=git_environment(), check=True,
        )
        directory_commondir = os.path.join(root, ".git", "commondir")
        with open(directory_commondir, "w", encoding="utf-8") as stream:
            stream.write(foreign_gitdir + "\n")
        try:
            assert subprocess.run(
                [sys.executable, helper, "invoke", root, "directory-foreign-commondir", stage_child],
                env=git_environment(), stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
            ).returncode != 0
        finally:
            os.unlink(directory_commondir)
        foreign_env = git_environment({
            "GIT_DIR": foreign_gitdir,
            "GIT_WORK_TREE": outside,
            "GIT_COMMON_DIR": foreign_gitdir,
            "GIT_OBJECT_DIRECTORY": os.path.join(foreign_gitdir, "objects"),
            "GIT_ALTERNATE_OBJECT_DIRECTORIES": os.path.join(foreign_gitdir, "objects"),
        })
        assert subprocess.run(
            [sys.executable, helper, "invoke", root, "foreign-git-env", stage_child],
            env=foreign_env,
        ).returncode == 0
        subprocess.run(
            ["git", "-C", root, "replace", pinned_commit, older_commit],
            env=git_environment(), check=True,
        )
        try:
            assert subprocess.run(
                [sys.executable, helper, "invoke", root, "replace-ref-test", stage_child],
                env=git_environment(),
            ).returncode == 0
        finally:
            subprocess.run(
                ["git", "-C", root, "replace", "-d", pinned_commit],
                env=git_environment(), check=True,
            )

        def substitute_loose_object(oid, object_type, data):
            path = os.path.join(root, ".git", "objects", oid[:2], oid[2:])
            with open(path, "rb") as stream:
                original = stream.read()
            replacement = path + ".replacement"
            frame = object_type.encode("ascii") + b" " + str(len(data)).encode("ascii") + b"\0" + data
            with open(replacement, "wb") as stream:
                stream.write(zlib.compress(frame))
            os.replace(replacement, path)
            return path, original

        def restore_loose_object(path, original):
            replacement = path + ".restore"
            with open(replacement, "wb") as stream:
                stream.write(original)
            os.replace(replacement, path)

        commit_data = subprocess.check_output(
            ["git", "-C", root, "cat-file", "commit", pinned_commit], env=git_environment(),
        )
        commit_path, original_commit_object = substitute_loose_object(
            pinned_commit, "commit", commit_data + b"\nsubstituted commit bytes\n",
        )
        try:
            assert subprocess.check_output(
                ["git", "-C", root, "cat-file", "commit", pinned_commit], env=git_environment(),
            ).endswith(b"substituted commit bytes\n")
            assert subprocess.run(
                [sys.executable, helper, "invoke", root, "loose-commit-substitution", stage_child],
                env=git_environment(), stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
            ).returncode != 0
        finally:
            restore_loose_object(commit_path, original_commit_object)

        root_tree_oid = subprocess.check_output(
            ["git", "-C", root, "rev-parse", f"{pinned_commit}^{{tree}}"],
            env=git_environment(), text=True,
        ).strip()
        root_tree_data = subprocess.check_output(
            ["git", "-C", root, "cat-file", "tree", root_tree_oid], env=git_environment(),
        )
        assert b"README\0" in root_tree_data
        tree_path, original_tree_object = substitute_loose_object(
            root_tree_oid, "tree", root_tree_data.replace(b"README\0", b"READMX\0", 1),
        )
        try:
            assert subprocess.run(
                [sys.executable, helper, "invoke", root, "loose-tree-substitution", stage_child],
                env=git_environment(), stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
            ).returncode != 0
        finally:
            restore_loose_object(tree_path, original_tree_object)

        attacked_path = INPUTS[0][1]
        blob_oid = subprocess.check_output(
            ["git", "-C", root, "rev-parse", f"{pinned_commit}:{attacked_path}"],
            env=git_environment(), text=True,
        ).strip()
        with open(os.path.join(root, attacked_path), "rb") as stream:
            original_worktree_data = stream.read()
        attacker_data = b"attacker-controlled SQL bytes\n"
        blob_path, original_blob_object = substitute_loose_object(blob_oid, "blob", attacker_data)
        with open(os.path.join(root, attacked_path), "wb") as stream:
            stream.write(attacker_data)
        try:
            assert subprocess.check_output(
                ["git", "-C", root, "cat-file", "blob", blob_oid], env=git_environment(),
            ) == attacker_data
            assert subprocess.run(
                [sys.executable, helper, "invoke", root, "loose-blob-substitution", stage_child],
                env=git_environment(), stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
            ).returncode != 0
        finally:
            restore_loose_object(blob_path, original_blob_object)
            with open(os.path.join(root, attacked_path), "wb") as stream:
                stream.write(original_worktree_data)
            os.chmod(os.path.join(root, attacked_path), 0o600)

        snapshot_ready = os.path.join(temporary, "verified-snapshot-ready")
        snapshot_env = git_environment({"NMCP_DELAY_READY": snapshot_ready})
        snapshot_reuse = subprocess.Popen(
            [sys.executable, helper, "invoke", root, "verified-snapshot-reuse", delayed_stage_child],
            env=snapshot_env, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
        )
        deadline = time.monotonic() + 5
        while not os.path.exists(snapshot_ready) and time.monotonic() < deadline:
            if snapshot_reuse.poll() is not None:
                break
            time.sleep(0.01)
        assert os.path.exists(snapshot_ready)
        blob_path, original_blob_object = substitute_loose_object(blob_oid, "blob", attacker_data)
        try:
            assert snapshot_reuse.wait() == 0
        finally:
            if snapshot_reuse.poll() is None:
                snapshot_reuse.kill()
                snapshot_reuse.wait()
            restore_loose_object(blob_path, original_blob_object)

        moved_gitdir = os.path.join(temporary, "moved-root-gitdir")
        root_swap = subprocess.Popen(
            [sys.executable, helper, "invoke", root, "directory-git-swap", delayed_stage_child],
            env=git_environment(), stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
        )
        time.sleep(0.1)
        os.rename(os.path.join(root, ".git"), moved_gitdir)
        os.symlink(foreign_gitdir, os.path.join(root, ".git"))
        assert root_swap.wait() != 0
        os.unlink(os.path.join(root, ".git"))
        os.rename(moved_gitdir, os.path.join(root, ".git"))

        linked = os.path.join(temporary, "linked-worktree")
        subprocess.run(
            ["git", "-C", root, "worktree", "add", "--quiet", "--detach", linked, pinned_commit],
            env=git_environment(), check=True,
        )
        assert subprocess.run(
            [sys.executable, helper, "invoke", linked, "foreign-linked-env", stage_child],
            env=foreign_env,
        ).returncode == 0
        linked_gitfile = os.path.join(linked, ".git")
        with open(linked_gitfile, "rb") as stream:
            linked_gitfile_data = stream.read()
        linked_admin_path = linked_gitfile_data.decode("utf-8").strip().removeprefix("gitdir: ")
        linked_common_file = os.path.join(linked_admin_path, "commondir")
        with open(linked_common_file, "rb") as stream:
            linked_common_data = stream.read()
        try:
            with open(linked_common_file, "wb") as stream:
                stream.write((foreign_gitdir + "\n").encode("utf-8"))
            assert subprocess.run(
                [sys.executable, helper, "invoke", linked, "foreign-linked-commondir", stage_child],
                env=git_environment(), stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
            ).returncode != 0
        finally:
            with open(linked_common_file, "wb") as stream:
                stream.write(linked_common_data)
        gitfile_swap = subprocess.Popen(
            [sys.executable, helper, "invoke", linked, "gitfile-swap", delayed_stage_child],
            env=git_environment(), stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
        )
        time.sleep(0.1)
        with open(linked_gitfile, "wb") as stream:
            stream.write(f"gitdir: {foreign_gitdir}\n".encode("utf-8"))
        assert gitfile_swap.wait() != 0
        with open(linked_gitfile, "wb") as stream:
            stream.write(linked_gitfile_data)

        linked_foreign = os.path.join(temporary, "linked-worktree-foreign")
        subprocess.run(
            ["git", "-C", root, "worktree", "add", "--quiet", "--detach", linked_foreign, pinned_commit],
            env=git_environment(), check=True,
        )
        with open(os.path.join(linked_foreign, ".git"), "rb") as stream:
            foreign_pairing = stream.read()
        with open(linked_gitfile, "wb") as stream:
            stream.write(foreign_pairing)
        assert subprocess.run(
            [sys.executable, helper, "invoke", linked, "foreign-linked-pairing", stage_child],
            env=git_environment(), stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
        ).returncode != 0
        with open(linked_gitfile, "wb") as stream:
            stream.write(linked_gitfile_data)

        private_ref = "refs/worktree/validation-head"
        subprocess.run(
            ["git", "-C", linked, "update-ref", private_ref, pinned_commit],
            env=git_environment(), check=True,
        )
        subprocess.run(
            ["git", "-C", linked, "symbolic-ref", "HEAD", private_ref],
            env=git_environment(), check=True,
        )
        assert subprocess.check_output(
            ["git", "-C", linked, "rev-parse", "HEAD^{commit}"],
            env=git_environment(), text=True,
        ).strip() == pinned_commit
        linked_root_fd = os.open(linked, os.O_RDONLY | DIRECTORY | NOFOLLOW)
        linked_entry_fd = os.open(".git", os.O_RDONLY | NOFOLLOW, dir_fd=linked_root_fd)
        (
            linked_gitdir_path, linked_gitdir_fd, _, _, linked_common_fd, _, _,
        ) = resolve_checkout_git(linked, linked_root_fd, linked_entry_fd)
        common_file = os.path.join(linked_gitdir_path, "commondir")
        with open(common_file, "rb") as stream:
            common_file_data = stream.read()
        try:
            assert resolve_pinned_head(linked_gitdir_fd, linked_common_fd) == pinned_commit
            with open(common_file, "wb") as stream:
                stream.write((foreign_gitdir + "\n").encode("utf-8"))
            assert git_output(
                linked_gitdir_fd, linked_common_fd,
                "rev-parse", "--verify", private_ref, text=True,
            ).strip() == pinned_commit
            assert resolve_pinned_head(linked_gitdir_fd, linked_common_fd) == pinned_commit
        finally:
            with open(common_file, "wb") as stream:
                stream.write(common_file_data)
            for fd in (linked_common_fd, linked_gitdir_fd, linked_entry_fd, linked_root_fd):
                os.close(fd)
        subprocess.run(
            ["git", "-C", linked, "checkout", "--quiet", "--detach", pinned_commit],
            env=git_environment(), check=True,
        )
        subprocess.run(
            ["git", "-C", linked, "update-ref", "-d", private_ref],
            env=git_environment(), check=True,
        )
        subprocess.run(
            ["git", "-C", root, "worktree", "remove", "--force", linked_foreign],
            env=git_environment(), check=True,
        )
        subprocess.run(
            ["git", "-C", root, "worktree", "remove", "--force", linked],
            env=git_environment(), check=True,
        )

        sleeper = os.path.join(root, "sleep-validation")
        with open(sleeper, "w", encoding="ascii") as stream:
            stream.write("#!/bin/sh\nsleep \"$1\"\n")
        os.chmod(sleeper, 0o700)
        def timed_invocations(projects):
            started = time.monotonic()
            children = [
                subprocess.Popen([sys.executable, helper, "invoke", root, name, sleeper, "0.3"])
                for name in projects
            ]
            assert all(child.wait() == 0 for child in children)
            return time.monotonic() - started
        serialized = timed_invocations(("concurrent", "concurrent"))
        parallel = timed_invocations(("peer-a", "peer-b"))
        assert serialized >= 0.55, serialized
        assert parallel < serialized - 0.15, (serialized, parallel)

        first = subprocess.Popen([sys.executable, helper, "invoke", root, "lock-replacement", sleeper, "0.4"])
        time.sleep(0.1)
        lock_path = os.path.join(root, ".validation", "compose-inputs", "lock-replacement.lock")
        with open(lock_path, "w", encoding="ascii") as stream:
            stream.write("first")
        os.rename(lock_path, lock_path + ".moved")
        with open(lock_path, "w", encoding="ascii") as stream:
            stream.write("replacement")
        second_started = time.monotonic()
        second = subprocess.Popen([sys.executable, helper, "invoke", root, "lock-replacement", sleeper, "0.1"])
        assert first.wait() == 0 and second.wait() == 0
        assert time.monotonic() - second_started >= 0.35
    print("validation input security tests passed")
    return 0


def main():
    try:
        if len(sys.argv) >= 2 and sys.argv[1] == "invoke":
            if len(sys.argv) < 5:
                raise UnsafeInput("invoke requires ROOT PROJECT SCRIPT [ARGS...]")
            return invoke(sys.argv[2], sys.argv[3], sys.argv[4], sys.argv[5:])
        if len(sys.argv) >= 3 and sys.argv[1] == "client":
            return client(sys.argv[2], sys.argv[3:])
        if sys.argv[1:] == ["self-test"]:
            return self_test()
        raise UnsafeInput("usage: validation-inputs {invoke|client|self-test} ...")
    except (UnsafeInput, OSError, subprocess.CalledProcessError) as exc:
        print(f"error: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
