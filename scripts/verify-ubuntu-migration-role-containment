#!/usr/bin/env python3
"""Causally verify fixed-unit containment and SIGKILL recovery."""

import fcntl
import json
import os
import secrets
import signal
import subprocess
import sys
import time


UNIT = "nmcp-migration-role-verifier.service"
READY = "/opt/nmcp-role-compatibility/test-work/kill/supervisor-kill.ready"
PID_FILES = ("wrapper.pid", "admin.pid", "descendant.pid")
ENV = {"PATH": "/usr/bin:/bin:/usr/sbin:/sbin", "LC_ALL": "C", "LANG": "C", "HOME": "/root"}
SUCCESS = "Ubuntu migration role compatibility verification passed"


def fail(message):
    raise RuntimeError(message)


def run(argv, **kwargs):
    return subprocess.run(argv, cwd="/", env=ENV, text=True, **kwargs)


def show(*properties):
    result = run(("/usr/bin/systemctl", "show", UNIT, *(f"--property={item}" for item in properties)),
                 check=False, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    values = dict(line.split("=", 1) for line in result.stdout.splitlines() if "=" in line)
    if result.returncode and not values:
        return {"LoadState": "not-found", "ActiveState": "inactive", "InvocationID": ""}
    return values


def wait_path(path, timeout=900):
    deadline = time.monotonic() + timeout
    while not os.path.exists(path):
        if time.monotonic() >= deadline:
            fail(f"timed out waiting for {path}")
        time.sleep(0.1)


def reset_signal_paths(name):
    for suffix in ("ready", "release"):
        try:
            os.unlink(f"/run/nmcp-ci/{name}.{suffix}")
        except FileNotFoundError:
            pass


def reset_paths(*paths):
    for path in paths:
        try:
            os.unlink(path)
        except FileNotFoundError:
            pass


def release(name):
    path = f"/run/nmcp-ci/{name}.release"
    descriptor = os.open(path,
                         os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
    try:
        os.write(descriptor, b"release\n")
        os.fsync(descriptor)
    finally:
        os.close(descriptor)
    directory = os.open("/run/nmcp-ci", os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    try:
        os.fsync(directory)
    finally:
        os.close(directory)


def wait_unit_absent(timeout=30):
    deadline = time.monotonic() + timeout
    while show("LoadState").get("LoadState") != "not-found":
        if time.monotonic() >= deadline:
            fail("fixed unit did not unload during containment test")
        time.sleep(0.1)


def assert_client_lock_reusable():
    descriptor = os.open("/run/nmcp-ci/client.lock", os.O_RDWR | os.O_NOFOLLOW)
    try:
        fcntl.flock(descriptor, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        fail("client lock was not reusable after client exit")
    finally:
        os.close(descriptor)


def assert_client_failure(result, mode):
    if result.returncode == 0 or SUCCESS in result.stdout:
        fail(f"client fault unexpectedly succeeded or emitted canonical success: {mode}")
    state = show("LoadState", "ControlGroup")
    if state.get("LoadState") != "not-found":
        fail(f"client fault left the fixed unit loaded: {mode}: {state}")
    if cgroup_pids(state.get("ControlGroup", "")):
        fail(f"client fault left control-group processes: {mode}: {state}")
    if cgroup_pids("/system.slice/" + UNIT):
        fail(f"client fault left processes in the fixed unit cgroup: {mode}")
    assert_client_lock_reusable()


def fast_recovery(client, repo, commit, go_binary, context):
    recovered = run(("/usr/bin/python3", "-I", "-S", client, repo, commit, go_binary,
                     "fast-success"), stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    if recovered.returncode or recovered.stdout.count(SUCCESS) != 1:
        fail(f"fast clean recovery failed after {context}: {recovered.stdout} {recovered.stderr}")
    wait_unit_absent()
    assert_client_lock_reusable()


def pid_exists(pid):
    try:
        os.kill(pid, 0)
        return True
    except ProcessLookupError:
        return False


def cgroup_pids(control_group):
    root = "/sys/fs/cgroup" + control_group
    found = []
    if not os.path.isdir(root):
        return found
    for directory, directories, files in os.walk(root, followlinks=False):
        directories[:] = [name for name in directories if not os.path.islink(os.path.join(directory, name))]
        if "cgroup.procs" in files:
            with open(os.path.join(directory, "cgroup.procs"), encoding="ascii") as source:
                found.extend(int(value) for value in source.read().split())
    return sorted(set(found))


def process_has_inode(pid, expected):
    try:
        names = os.listdir(f"/proc/{pid}/fd")
    except FileNotFoundError:
        return False
    for name in names:
        try:
            value = os.stat(f"/proc/{pid}/fd/{name}")
        except FileNotFoundError:
            continue
        if (value.st_dev, value.st_ino) == expected:
            return True
    return False


def intent_entry(path):
    with open("/run/nmcp-ci/cleanup-intent.json", encoding="ascii") as source:
        document = json.load(source)
    matches = [entry for entry in document["entries"] if entry["path"] == path]
    if len(matches) != 1:
        fail(f"cleanup intent does not identify exactly one target: {path}")
    return matches[0]


def run_root_entry():
    with open("/run/nmcp-ci/cleanup-intent.json", encoding="ascii") as source:
        entries = json.load(source)["entries"]
    matches = [entry for entry in entries if entry["path"].startswith("/run/nmcp-ci/transaction-")]
    if len(matches) != 1:
        fail("cleanup intent does not identify exactly one transaction root")
    return matches[0]


def observable_identity(path, recorded):
    try:
        value = os.lstat(path)
    except FileNotFoundError:
        return recorded
    return {"dev": value.st_dev, "ino": value.st_ino}


def assert_replaced_or_absent(path, identity):
    if identity is None:
        return
    try:
        current = os.lstat(path)
    except FileNotFoundError:
        return
    if (current.st_dev, current.st_ino) == (identity["dev"], identity["ino"]):
        fail(f"prior cleanup-intent inode survived recovery: {path}")


def main():
    if os.geteuid() != 0 or len(sys.argv) != 5:
        fail("usage: containment CLIENT REPOSITORY CURRENT_COMMIT ABSOLUTE_GO")
    client, repo, commit, go_binary = sys.argv[1:]
    client_faults = (
        "client-fault-after-launch", "client-fault-missing-invocation",
        "client-fault-after-invocation", "client-fault-after-properties",
        "client-fault-at-terminal", "client-fault-after-journal",
    )
    for mode in client_faults:
        if mode == "client-fault-missing-invocation":
            reset_signal_paths(mode)
            process = subprocess.Popen(
                ("/usr/bin/python3", "-I", "-S", client, repo, commit, go_binary, mode),
                cwd="/", env=ENV, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True,
            )
            wait_path(f"/run/nmcp-ci/{mode}.ready", timeout=30)
            matching = show("LoadState", "InvocationID", "Description", "Environment", "ExecStart")
            if (matching.get("LoadState") != "loaded" or not matching.get("InvocationID")
                    or "NMCP_VERIFIER_NONCE=" not in matching.get("Environment", "")
                    or "NMCP_VERIFIER_NONCE=" not in matching.get("ExecStart", "")):
                fail("matching-nonce adoption fixture lacks the real launched service identity")
            release(mode)
            fault_stdout, fault_stderr = process.communicate(timeout=30)
            faulted = subprocess.CompletedProcess(process.args, process.returncode,
                                                  fault_stdout, fault_stderr)
        else:
            faulted = run(("/usr/bin/python3", "-I", "-S", client, repo, commit, go_binary, mode),
                          stdout=subprocess.PIPE, stderr=subprocess.PIPE)
        assert_client_failure(faulted, mode)
        if mode == "client-fault-missing-invocation" and "missing exact invocation identity" not in faulted.stderr:
            fail("matching-nonce adoption test did not exercise missing initial InvocationID")
        fast_recovery(client, repo, commit, go_binary, mode)

    for boundary in ("kill", "stop", "wait", "reset", "unload"):
        mode = "client-cleanup-fault-" + boundary
        faulted = run(("/usr/bin/python3", "-I", "-S", client, repo, commit, go_binary, mode),
                      stdout=subprocess.PIPE, stderr=subprocess.PIPE)
        assert_client_failure(faulted, mode)
        if f"injected cleanup {boundary} failure after real action" not in faulted.stderr:
            fail(f"cleanup fault hook did not report after its real action: {boundary}")
        fast_recovery(client, repo, commit, go_binary, mode)

    for signal_name, signum in (("int", signal.SIGINT), ("term", signal.SIGTERM),
                                ("hup", signal.SIGHUP), ("quit", signal.SIGQUIT)):
        for boundary in ("kill", "stop", "wait", "reset", "unload"):
            mode = f"client-signal-{signal_name}-{boundary}"
            marker = f"/run/nmcp-ci/{mode}.ready"
            reset_paths(marker)
            cancelled = subprocess.Popen(
                ("/usr/bin/python3", "-I", "-S", client, repo, commit, go_binary, mode),
                cwd="/", env=ENV, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True,
            )
            wait_path(marker, timeout=30)
            os.kill(cancelled.pid, signum)
            cancelled_stdout, cancelled_stderr = cancelled.communicate(timeout=30)
            result = subprocess.CompletedProcess(cancelled.args, cancelled.returncode,
                                                 cancelled_stdout, cancelled_stderr)
            assert_client_failure(result, mode)
            if "cancelled by signal" not in cancelled_stderr:
                fail(f"client did not report latched cancellation after teardown: {mode}")
            fast_recovery(client, repo, commit, go_binary, mode)

    prior = None
    for stage in ("after-intent", "after-mkdir", "after-open", "after-register"):
        faulted = run(("/usr/bin/python3", "-I", "-S", client, repo, commit, go_binary,
                       f"run-root:{stage}"), stdout=subprocess.PIPE, stderr=subprocess.PIPE)
        if faulted.returncode == 0 or "Ubuntu migration role compatibility verification passed" in faulted.stdout:
            fail(f"SIGKILL fault window unexpectedly succeeded: {stage}")
        if not os.path.exists("/run/nmcp-ci/cleanup-intent.json"):
            fail(f"SIGKILL fault window was not durably registered: {stage}")
        if prior is not None:
            assert_replaced_or_absent(*prior)
        entry = run_root_entry()
        prior = (entry["path"], observable_identity(entry["path"], entry["identity"]))
    for target in ("/usr/local/libexec/nmcp", "/var/lib/nmcp", "/opt/nmcp-role-compatibility"):
        for stage in ("after-intent", "after-mkdir", "after-open", "after-register"):
            faulted = run(("/usr/bin/python3", "-I", "-S", client, repo, commit, go_binary,
                           f"path:{target}:{stage}"), stdout=subprocess.PIPE, stderr=subprocess.PIPE)
            if faulted.returncode == 0 or "Ubuntu migration role compatibility verification passed" in faulted.stdout:
                fail(f"persistent-path SIGKILL fault unexpectedly succeeded: {target}:{stage}")
            if prior is not None:
                assert_replaced_or_absent(*prior)
            entry = intent_entry(target)
            prior = (target, observable_identity(target, entry["identity"]))
    first = subprocess.Popen(("/usr/bin/python3", "-I", "-S", client, repo, commit, go_binary,
                              "containment-supervisor-kill"), cwd="/", env=ENV,
                             stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
    wait_path(READY)
    state = show("InvocationID", "MainPID", "ActiveState", "ControlGroup")
    invocation = state["InvocationID"]
    main_pid = int(state["MainPID"])
    if state["ActiveState"] != "active" or main_pid <= 1:
        fail(f"containment invocation is not active: {state}")
    base = os.path.dirname(READY)
    descendants = []
    for name in PID_FILES:
        with open(os.path.join(base, name), encoding="ascii") as source:
            descendants.append(int(source.read().strip()))
    if not all(pid_exists(pid) for pid in descendants):
        fail("nested wrapper/admin descendant was not live before supervisor death")
    all_service_pids = cgroup_pids(state["ControlGroup"])
    if not set(descendants) <= set(all_service_pids):
        fail("recorded nested processes are outside the fixed unit control group")
    with open("/run/nmcp-ci/lock-keeper.pid", encoding="ascii") as source:
        keeper_pid = int(source.read().strip())
    lock_identity = os.stat("/run/nmcp-ci/transaction.lock")
    if keeper_pid == main_pid or keeper_pid not in all_service_pids or not process_has_inode(
            keeper_pid, (lock_identity.st_dev, lock_identity.st_ino)):
        fail("independent in-cgroup lock keeper does not hold the transaction lock inode")

    # The requesting client is deliberately distinct from the service. Its
    # death must neither release transaction serialization nor kill the unit.
    os.kill(first.pid, signal.SIGKILL)
    first.wait()
    if show("InvocationID", "ActiveState") != {"InvocationID": invocation, "ActiveState": "active"}:
        fail("client death changed the running service invocation")
    second = run(("/usr/bin/python3", "-I", "-S", client, repo, commit, go_binary),
                 stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    if second.returncode == 0 or not any(message in second.stderr for message in ("occupied", "control group is not empty")):
        fail("second invocation overlapped the live orphaned client service")
    os.kill(main_pid, signal.SIGKILL)
    if pid_exists(keeper_pid):
        lock = os.open("/run/nmcp-ci/transaction.lock", os.O_RDWR | os.O_NOFOLLOW)
        try:
            try:
                fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except BlockingIOError:
                pass
            else:
                fail("live in-cgroup lock keeper released the transaction lock")
        finally:
            os.close(lock)
    deadline = time.monotonic() + 20
    while show("InvocationID", "ActiveState")["ActiveState"] not in ("inactive", "failed"):
        if time.monotonic() >= deadline:
            fail("systemd did not bound containment teardown")
        time.sleep(0.1)
    if cgroup_pids(state["ControlGroup"]) or any(pid_exists(pid) for pid in all_service_pids):
        fail("a service descendant escaped KillMode=control-group")
    lock = os.open("/run/nmcp-ci/transaction.lock", os.O_RDWR | os.O_NOFOLLOW)
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    finally:
        os.close(lock)
    # This harness killed the nonce-owning client and then its supervisor. A
    # different launch nonce must not authorize a later client to name-clean it.
    run(("/usr/bin/systemctl", "reset-failed", UNIT), check=True,
        stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    wait_unit_absent()

    # Client A must retain client.lock after its service reaches terminal state.
    # Client B cannot reap/reuse the name until A attests and fully unloads it.
    for name in ("client-terminal-race-a", "client-terminal-race-a-unloaded",
                  "client-terminal-race-b"):
        reset_signal_paths(name)
    attempting_b = "/run/nmcp-ci/client-terminal-race-b.attempting"
    acquired_b = "/run/nmcp-ci/client-terminal-race-b.acquired"
    started_b = "/run/nmcp-ci/client-terminal-race-b.started"
    reset_paths(attempting_b, acquired_b, started_b)
    recovered = subprocess.Popen(
        ("/usr/bin/python3", "-I", "-S", client, repo, commit, go_binary, "client-terminal-race-a"),
        cwd="/", env=ENV, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True,
    )
    wait_path("/run/nmcp-ci/client-terminal-race-a.ready")
    terminal_a = show("InvocationID", "ActiveState", "SubState", "ControlGroup")
    invocation_a = terminal_a["InvocationID"]
    if terminal_a["ActiveState"] != "active" or terminal_a["SubState"] != "exited":
        fail(f"client A did not pause at terminal state: {terminal_a}")
    waiting = subprocess.Popen(
        ("/usr/bin/python3", "-I", "-S", client, repo, commit, go_binary, "client-terminal-race-b"),
        cwd="/", env=ENV, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True,
    )
    wait_path(attempting_b, timeout=30)
    if (waiting.poll() is not None or os.path.exists(acquired_b) or os.path.exists(started_b)
            or os.path.exists("/run/nmcp-ci/client-terminal-race-b.ready")):
        fail("client B did not block behind terminal-state client A")
    if show("InvocationID")["InvocationID"] != invocation_a:
        fail("client B replaced client A before A unloaded")
    release("client-terminal-race-a")
    wait_path("/run/nmcp-ci/client-terminal-race-a-unloaded.ready", timeout=60)
    if show("LoadState").get("LoadState") != "not-found":
        fail("client A reported teardown before the fixed name unloaded")
    if (waiting.poll() is not None or os.path.exists(acquired_b) or os.path.exists(started_b)
            or os.path.exists("/run/nmcp-ci/client-terminal-race-b.ready")):
        fail("client B acquired client.lock before A confirmed unload")
    release("client-terminal-race-a-unloaded")
    recovered_stdout, recovered_stderr = recovered.communicate(timeout=60)
    if recovered.returncode:
        fail(f"clean recovery client A failed: {recovered_stdout} {recovered_stderr}")
    wait_path(acquired_b, timeout=60)
    wait_path(started_b, timeout=60)
    wait_path("/run/nmcp-ci/client-terminal-race-b.ready", timeout=60)
    terminal_b = show("InvocationID", "ActiveState")
    if terminal_b["InvocationID"] == invocation_a:
        fail("client B did not launch a distinct post-unload invocation")
    release("client-terminal-race-b")
    waiting.communicate(timeout=60)
    if waiting.returncode == 0:
        fail("client B fault transaction unexpectedly succeeded")
    if os.path.exists("/run/nmcp-ci/cleanup-intent.json"):
        # B intentionally SIGKILLed its supervisor after proving serialization;
        # the following invocation must recover this durable intent.
        pass
    if prior is not None:
        assert_replaced_or_absent(*prior)

    # Replace an owned unit behind a paused client. Its finally block must
    # detect InvocationID loss and never issue a name-based command to B.
    reset_signal_paths("client-reuse-pause")
    replaced = subprocess.Popen(
        ("/usr/bin/python3", "-I", "-S", client, repo, commit, go_binary, "client-reuse-pause"),
        cwd="/", env=ENV, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True,
    )
    wait_path("/run/nmcp-ci/client-reuse-pause.ready", timeout=60)
    replaced_a = show("InvocationID", "ActiveState", "ControlGroup", "Environment")
    replaced_invocation = replaced_a["InvocationID"]
    replaced_environment = replaced_a["Environment"]
    run(("/usr/bin/systemctl", "kill", "--kill-whom=all", "--signal=KILL", UNIT),
        check=False, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    deadline = time.monotonic() + 20
    while show("InvocationID", "ActiveState")["ActiveState"] not in ("failed", "inactive"):
        if time.monotonic() >= deadline:
            fail("reused-name source invocation did not stop")
        time.sleep(0.1)
    if show("InvocationID")["InvocationID"] != replaced_invocation:
        fail("reused-name source changed before reset")
    run(("/usr/bin/systemctl", "reset-failed", UNIT), check=True,
        stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    wait_unit_absent()
    sentinel_nonce = secrets.token_hex(32)
    if replaced_environment == f"NMCP_VERIFIER_NONCE={sentinel_nonce}":
        fail("reused-name counterexample accidentally reused client A's nonce")
    sentinel = run(("/usr/bin/systemd-run", "--quiet", f"--unit={UNIT}", "--service-type=exec",
                    f"--description=NMCP migration role verifier {sentinel_nonce}",
                    f"--property=Environment=NMCP_VERIFIER_NONCE={sentinel_nonce}",
                    "--property=KillMode=control-group", "/usr/bin/sleep", "300"),
                   check=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    del sentinel
    sentinel_state = show("InvocationID", "ActiveState", "MainPID", "Environment")
    sentinel_invocation = sentinel_state["InvocationID"]
    if sentinel_invocation == replaced_invocation or sentinel_state["ActiveState"] != "active":
        fail("reused-name sentinel did not own a distinct live invocation")
    if sentinel_state.get("Environment") != f"NMCP_VERIFIER_NONCE={sentinel_nonce}":
        fail("reused-name sentinel did not expose its mismatched nonce")
    release("client-reuse-pause")
    replaced.communicate(timeout=60)
    if replaced.returncode == 0 or "launch identity lost" not in replaced.stderr:
        fail("client did not fail safely after fixed-name ownership loss")
    after_replaced = show("InvocationID", "ActiveState", "MainPID")
    if after_replaced["InvocationID"] != sentinel_invocation or after_replaced["ActiveState"] != "active":
        fail("old client teardown touched the reused-name sentinel")
    run(("/usr/bin/systemctl", "kill", "--kill-whom=all", "--signal=KILL", UNIT), check=False,
        stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    deadline = time.monotonic() + 20
    while show("ActiveState").get("ActiveState") not in ("failed", "inactive"):
        if time.monotonic() >= deadline:
            fail("reused-name sentinel did not stop")
        time.sleep(0.1)
    run(("/usr/bin/systemctl", "reset-failed", UNIT), check=False,
        stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    wait_unit_absent()

    retained = run(("/usr/bin/python3", "-I", "-S", client, repo, commit, go_binary,
                    "retained-cleanup-dependency"), stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    if retained.returncode == 0:
        fail("retained database dependency did not fail cleanup")
    if "Ubuntu migration role compatibility verification passed" in retained.stdout:
        fail("failed retained-dependency cleanup emitted success")
    if "drop database exited" not in retained.stdout or "drop roles exited" not in retained.stdout:
        fail("cleanup did not independently report database and role failures")
    recovered = run(("/usr/bin/python3", "-I", "-S", client, repo, commit, go_binary),
                    stdout=None, stderr=None)
    if recovered.returncode or os.path.exists("/run/nmcp-ci/cleanup-intent.json"):
        fail("retained-dependency recovery did not harden and clean")
    for path in tuple(
            f"/run/nmcp-ci/{name}{suffix}"
            for name in (
                *client_faults,
                "client-terminal-race-a", "client-terminal-race-a-unloaded",
                "client-terminal-race-b", "client-reuse-pause",
            )
            for suffix in (".ready", ".release", ".attempting", ".acquired", ".started")):
        reset_paths(path)
    for signal_name in ("int", "term", "hup", "quit"):
        for boundary in ("kill", "stop", "wait", "reset", "unload"):
            reset_paths(f"/run/nmcp-ci/client-signal-{signal_name}-{boundary}.ready")
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except Exception as error:
        print(f"containment-test: {error}", file=sys.stderr)
        raise SystemExit(1)
