def fail(message):
    raise RuntimeError(message)


class EvidenceFailure(RuntimeError):
    pass


class SerializedDiagnosticFailure(RuntimeError):
    def __init__(self, payload):
        super().__init__("serialized containment diagnostic")
        self.payload = payload


class PersistentCgroupFinalityFailure(RuntimeError):
    def __init__(self, result, errors, recorded_scanned, canonical_scanned):
        super().__init__("; ".join(
            retained_diagnostic(error, f"{name} cgroup scan failed")
            for name, error in errors))
        self.result = result
        self.errors = tuple(errors)
        self.recorded_scanned = recorded_scanned
        self.canonical_scanned = canonical_scanned


class ProducerEpochFailure(RuntimeError):
    def __init__(self, category, evidence):
        super().__init__(category)
        self.category = category
        self.evidence = evidence


def diagnostic_errno(error):
    try:
        number = error.errno
    except BaseException:
        return "unknown"
    return number if type(number) is int else "unknown"


def evidence_failure_number(phase, operation, resource_class, number):
    if (phase not in DIAGNOSTIC_PHASES or operation not in DIAGNOSTIC_OPERATIONS
            or resource_class not in DIAGNOSTIC_RESOURCES):
        phase, operation, resource_class = "uncategorized", "unknown", "unknown"
    if type(number) is not int and number != "unknown":
        number = "unknown"
    return EvidenceFailure(
        f"phase={phase} operation={operation} resource={resource_class} errno={number}")


def evidence_failure(phase, operation, resource_class, error):
    number = diagnostic_errno(error) if isinstance(error, OSError) else "unknown"
    return evidence_failure_number(phase, operation, resource_class, number)


def retained_diagnostic(error, fallback):
    return str(error) if isinstance(error, EvidenceFailure) else fallback


def os_call(phase, operation, resource_class, function, *args, **kwargs):
    try:
        return function(*args, **kwargs)
    except OSError as error:
        raise evidence_failure(phase, operation, resource_class, error) from None


def counter_failure(phase, operation, category):
    if (phase not in DIAGNOSTIC_PHASES or operation not in ("parse", "read")
            or category not in COUNTER_CATEGORIES):
        phase, operation, category = "uncategorized", "read", "io"
    return EvidenceFailure(
        f"phase={phase} operation={operation} resource=counter category={category}")


def parse_counter(phase, payload):
    if len(payload) > COUNTER_BYTE_LIMIT:
        raise counter_failure(phase, "parse", "oversize")
    if not payload:
        raise counter_failure(phase, "parse", "empty")
    try:
        value = payload.decode("ascii")
    except UnicodeDecodeError:
        raise counter_failure(phase, "parse", "non-ascii") from None
    digits = value[:-1]
    if (not value.endswith("\n") or not digits
            or (digits != "0" and (digits[0] == "0" or not digits.isdecimal()))
            or (digits == "0" and len(digits) != 1)):
        raise counter_failure(phase, "parse", "non-canonical")
    number = int(digits)
    if number > COUNTER_MAX:
        raise counter_failure(phase, "parse", "overflow")
    return number


def counter_identity(phase, metadata):
    if not stat.S_ISREG(metadata.st_mode):
        raise counter_failure(phase, "read", "unsafe-type")
    if stat.S_IMODE(metadata.st_mode) != 0o600:
        raise counter_failure(phase, "read", "unsafe-mode")
    if metadata.st_uid != 0 or metadata.st_gid != 0:
        raise counter_failure(phase, "read", "unsafe-owner")
    return metadata.st_dev, metadata.st_ino


def aggregate_counter_failure(primary_error, cleanup_errors):
    categories = []
    for error in cleanup_errors:
        rendered = str(error)
        category = rendered.rsplit("category=", 1)[-1]
        categories.append(category if category in COUNTER_CATEGORIES else "io")
    prefix = str(primary_error) if primary_error is not None else "counter cleanup failed"
    return EvidenceFailure(prefix + "; cleanup=" + "|".join(categories))


def try_nonblocking_flock(descriptor, phase, resource_class):
    try:
        fcntl.flock(descriptor, fcntl.LOCK_EX | fcntl.LOCK_NB)
        return True
    except BlockingIOError as error:
        number = diagnostic_errno(error)
        if number == errno.EWOULDBLOCK:
            return False
        raise evidence_failure_number(phase, "flock", resource_class, number) from None
    except OSError as error:
        raise evidence_failure(phase, "flock", resource_class, error) from None


def popen(phase, argv, **kwargs):
    try:
        return subprocess.Popen(argv, **kwargs)
    except OSError as error:
        raise evidence_failure(phase, "popen", "process", error) from None


def raise_walk_error(error):
    raise error


def cgroup_walk_error(phase, error):
    if isinstance(error, FileNotFoundError):
        raise error
    raise evidence_failure(phase, "walk", "cgroup", error) from None


def cgroup_stat(phase, path, resource_class="cgroup"):
    try:
        return os.lstat(path)
    except FileNotFoundError:
        raise
    except OSError as error:
        raise evidence_failure(phase, "stat", resource_class, error) from None


def cgroup_walk(phase, root):
    try:
        yield from os.walk(
            root, topdown=True, onerror=functools.partial(cgroup_walk_error, phase),
            followlinks=False)
    except (FileNotFoundError, RuntimeError):
        raise
    except OSError as error:
        raise evidence_failure(phase, "walk", "cgroup", error) from None


def cgroup_open(phase, path):
    try:
        return open(path, encoding="ascii")
    except FileNotFoundError:
        raise
    except OSError as error:
        raise evidence_failure(phase, "open", "cgroup", error) from None


def cgroup_fstat(phase, source):
    try:
        return os.fstat(source.fileno())
    except FileNotFoundError:
        raise
    except OSError as error:
        raise evidence_failure(phase, "stat", "evidence", error) from None


def cgroup_read(phase, source):
    try:
        return source.read()
    except FileNotFoundError:
        raise
    except OSError as error:
        raise evidence_failure(phase, "read", "evidence", error) from None


def cgroup_close(phase, source):
    try:
        source.close()
    except OSError as error:
        raise evidence_failure(phase, "close", "evidence", error) from None


def path_exists(phase, resource_class, path):
    try:
        os.stat(path)
        return True
    except FileNotFoundError:
        return False
    except OSError as error:
        raise evidence_failure(phase, "stat", resource_class, error) from None


def process_communicate(phase, process, timeout):
    return os_call(phase, "communicate", "process",
                   process.communicate, timeout=timeout)


def process_wait(phase, process, timeout):
    return os_call(phase, "wait", "process", process.wait, timeout=timeout)


def read_pid(path, phase):
    source = os_call(phase, "open", "pid", open, path, encoding="ascii")
    try:
        value = os_call(phase, "read", "pid", source.read)
    finally:
        os_call(phase, "close", "pid", source.close)
    try:
        return int(value.strip())
    except ValueError:
        fail("PID evidence was malformed")


def open_transaction_lock():
    return os_call("transaction-lock", "open", "transaction", os.open,
                   "/run/nmcp-ci/transaction.lock", os.O_RDWR | os.O_NOFOLLOW)


def lock_transaction(descriptor):
    return try_nonblocking_flock(descriptor, "transaction-lock", "transaction")


def close_transaction_lock(descriptor):
    os_call("transaction-lock", "close", "transaction", os.close, descriptor)


def evidence_identity(value):
    return (value.st_dev, value.st_ino, value.st_mode, value.st_uid,
            value.st_gid, value.st_nlink, value.st_size,
            value.st_mtime_ns, value.st_ctime_ns)


def read_anchored_json(descriptor, observed, resource_class):
    if (not stat.S_ISREG(observed.st_mode) or observed.st_uid != 0 or observed.st_gid != 0
            or observed.st_nlink != 1 or stat.S_IMODE(observed.st_mode) != 0o600):
        fail(f"{resource_class} has unsafe ownership, type, mode, or link count")
    os_call("intent-window", "seek", resource_class, os.lseek, descriptor, 0, os.SEEK_SET)
    raw = os_call("intent-window", "read", resource_class, os.read,
                  descriptor, observed.st_size + 1)
    after = os_call("intent-window", "stat", resource_class, os.fstat, descriptor)
    if evidence_identity(after) != evidence_identity(observed) or len(raw) != observed.st_size:
        fail(f"{resource_class} changed while anchored")
    try:
        document = json.loads(raw)
    except (UnicodeDecodeError, json.JSONDecodeError):
        fail(f"{resource_class} was not canonical JSON")
    canonical = (json.dumps(document, sort_keys=True, separators=(",", ":")) + "\n").encode("ascii")
    if raw != canonical:
        fail(f"{resource_class} was not canonical JSON")
    return raw, document


def persistent_failure_classification(stdout, stderr):
    return {
        "success_in_stdout": SUCCESS in stdout,
        "property_unknown": PERSISTENT_PROPERTY_ERROR in stderr,
        "action_unavailable": PERSISTENT_ACTION_ERROR in stderr,
    }


def persistent_result_violation(returncode, classification, lock_handoff_error, cleanup_error,
                                lock_reuse_error, post_cleanup, post_cleanup_cgroup):
    return bool(
        returncode == 0 or classification["success_in_stdout"]
        or not (classification["property_unknown"] or classification["action_unavailable"])
        or lock_handoff_error or cleanup_error or lock_reuse_error
        or post_cleanup.get("LoadState") != "not-found" or post_cleanup_cgroup
    )


def persistent_special_result_violation(returncode, stdout, stderr, evidence_case, boundary,
                                        intercepted, attempted):
    expected = {
        "parse": ("kill", 2, "owned kill command remains unavailable: "),
        "timeout": ("wait", 4, "unit properties remain unknown: "),
    }
    expected_boundary, expected_interceptions, cleanup_prefix = expected[evidence_case]
    interception = f"intercepted {expected_boundary} command before attempt"
    cleanup = cleanup_prefix + "; ".join(
        interception for _attempt in range(expected_interceptions))
    expected_stderr = (
        "verification-client: injected client failure before cleanup boundary test; "
        f"cleanup failed: {cleanup}\n")
    return bool(
        returncode != 1 or stdout != "" or stderr != expected_stderr
        or boundary != expected_boundary
        or intercepted != expected_interceptions or attempted != 0
    )


def parse_client_result(payload):
    try:
        encoded = payload.encode("ascii") if type(payload) is str else b""
    except UnicodeEncodeError:
        encoded = b""
    if not encoded or len(encoded) > RESULT_BYTE_LIMIT:
        fail("client result schema was absent or oversized")
    if "\n" in payload or "\r" in payload or payload != payload.strip():
        fail("client result schema was not one canonical line")
    prefix, separator, body = payload.partition(":")
    if not separator or prefix + ":" != RESULT_PREFIX:
        fail("client result schema prefix changed")
    fields = body.split(";")
    expected_names = (
        "primary", "events", "events_complete", "final_scanned", "final_observed",
        "final_empty", "return", "stdout", "success",
    )
    if len(fields) != len(expected_names):
        fail("client result schema field count changed")
    values = {}
    for field, expected_name in zip(fields, expected_names):
        name, field_separator, value = field.partition("=")
        if not field_separator or name != expected_name or not value or name in values:
            fail("client result schema fields were missing, duplicated, or reordered")
        values[name] = value
    if values["primary"] not in RESULT_PRIMARY_CATEGORIES:
        fail("client result schema primary category was unknown")
    if values["events"] == "-":
        events = ()
    else:
        raw_events = values["events"].split(",")
        if len(raw_events) > RESULT_EVENT_LIMIT:
            fail("client result schema event trace exceeded its bound")
        parsed_events = []
        for expected_ordinal, raw_event in enumerate(raw_events):
            parts = raw_event.split(".")
            if len(parts) != 6:
                fail("client result schema event was malformed")
            raw_ordinal, boundary, category, *raw_counts = parts
            if (boundary not in RESULT_BOUNDARIES
                    or category not in RESULT_CLEANUP_CATEGORIES
                    or boundary == "none" and category != "unexpected"):
                fail("client result schema event category or boundary was unknown")
            counts = []
            for value in (raw_ordinal, *raw_counts):
                if (not value.isascii() or not value.isdecimal()
                        or (value != "0" and value.startswith("0"))):
                    fail("client result schema event count was malformed")
                count = int(value)
                if count > COUNTER_MAX:
                    fail("client result schema event count exceeded its bound")
                counts.append(count)
            if counts[0] != expected_ordinal:
                fail("client result schema event ordinals were not contiguous")
            parsed_events.append((expected_ordinal, boundary, category, *counts[1:]))
        events = tuple(parsed_events)
    flags = {}
    for name in ("events_complete", "final_scanned", "final_observed", "final_empty",
                 "return", "stdout", "success"):
        if values[name] not in ("0", "1"):
            fail("client result schema flag was malformed")
        flags[name] = int(values[name])
    if flags["final_empty"] and not (flags["final_scanned"] and flags["final_observed"]):
        fail("client result schema final evidence was contradictory")
    return {
        "primary": values["primary"], "events": events, **flags,
    }


def client_stderr_evidence(stderr):
    try:
        encoded = stderr.encode("ascii")
    except (AttributeError, UnicodeEncodeError):
        encoded = b""
    lines = stderr.splitlines(keepends=True) if type(stderr) is str else []
    leading_whitespace = bool(stderr and stderr[0].isspace())
    trailing_whitespace = bool(stderr and not stderr.endswith("\n") and stderr[-1].isspace())
    shape = bool(
        encoded and len(encoded) <= CLIENT_STDERR_BYTE_LIMIT and len(lines) == 2
        and all(line.endswith("\n") for line in lines)
        and lines[0].startswith(RESULT_PREFIX)
        and lines[1].startswith("verification-client: ")
        and RESULT_PREFIX not in lines[1]
        and not leading_whitespace and not trailing_whitespace
    )
    parsed = None
    if shape:
        try:
            parsed = parse_client_result(lines[0][:-1])
        except RuntimeError:
            shape = False
    return parsed, {
        "shape": shape, "line_count": len(lines), "byte_count": len(encoded),
        "byte_bounded": bool(encoded and len(encoded) <= CLIENT_STDERR_BYTE_LIMIT),
        "leading_whitespace": leading_whitespace,
        "trailing_whitespace": trailing_whitespace,
    }


def expected_persistent_result(case, boundary):
    if case not in ("normal", "parse", "timeout"):
        fail("persistent evidence case was not explicitly labeled")
    categories = {
        "show": (("show", "property-unavailable"),),
        "kill": (("kill", "kill-unavailable"),),
        "stop": (("stop", "stop-unavailable"), ("unload", "unload-timeout")),
        "wait": (("wait", "property-unavailable"),),
        "reset": (("reset", "reset-unavailable"), ("unload", "unload-timeout")),
        "unload": (("unload", "property-unavailable"),),
    }[boundary]
    events = tuple(
         (ordinal, event_boundary, category,
          (3 if boundary in ("show", "wait", "unload") else 1)
          if event_boundary == boundary else 0,
          (4 if boundary in ("show", "wait", "unload") else 2)
          if event_boundary == boundary else 0, 0)
        for ordinal, (event_boundary, category) in enumerate(categories))
    return {
        "primary": "cleanup-test", "events": events,
        "events_complete": 1, "final_scanned": 1, "final_observed": 1, "final_empty": 1,
        "return": 1, "stdout": 0, "success": 0,
    }


def retain_persistent_cgroup(recorded, state):
    control_group = state.get("ControlGroup")
    if control_group is None:
        if state.get("LoadState") == "loaded":
            fail("loaded persistent state omitted its requested control group")
        control_group = ""
    if type(control_group) is not str:
        fail("persistent state returned an invalid control group")
    if control_group:
        if recorded and control_group != recorded:
            fail("persistent control group changed after attestation")
        return control_group, "attested"
    if recorded:
        return recorded, "attested"
    fail("persistent containment omitted its attested control group")


def persistent_cgroup_finality(recorded, category, reader):
    if category != "attested":
        fail("persistent recorded control group lacked a closed category")
    if not recorded:
        fail("persistent finality lacked an attested control group")
    result = {"recorded": [], "canonical": []}
    errors = []
    recorded_scanned = False
    canonical_scanned = False
    for name, path in (("recorded", recorded), ("canonical", "/system.slice/" + UNIT)):
        if name == "recorded":
            recorded_scanned = True
        else:
            canonical_scanned = True
        try:
            result[name] = reader(path)
        except BaseException as error:
            errors.append((name, error))
    if errors:
        raise PersistentCgroupFinalityFailure(
            result, errors, recorded_scanned, canonical_scanned)
    return result, recorded_scanned, canonical_scanned


def evaluate_persistent_result(case, expected_case, lifecycle_category, expected_lifecycle,
                               parsed, stderr_shape, expected_result, returncode, stdout,
                               intercepted, attempted, lock_handoff_error, cleanup_error,
                               cleanup_categories, lock_reuse_error,
                               expected_signed_cleanup_required, signed_cleanup_required,
                               signed_cleanup_ran, release_ok, reap_ok, unit_absent,
                               recorded_category, recorded_required, recorded_path_present,
                               recorded_scanned, canonical_scanned, recorded_empty, canonical_empty,
                               artifacts_absent):
    schema = parsed or {}
    predicates = {
        "case_exact": case == expected_case,
        "lifecycle_match": lifecycle_category == expected_lifecycle,
        "schema_shape": stderr_shape["shape"],
        "schema_exact": parsed == expected_result,
        "primary_exact": schema.get("primary") == expected_result["primary"],
        "events_exact": schema.get("events") == expected_result["events"],
        "return_match": returncode == expected_result["return"] == schema.get("return"),
        "stdout_match": stdout == "" and schema.get("stdout") == expected_result["stdout"],
        "success_match": SUCCESS not in stdout and schema.get("success") == expected_result["success"],
        "events_complete": schema.get("events_complete") == 1,
        "final_scanned": schema.get("final_scanned") == 1,
        "final_observed": schema.get("final_observed") == 1,
        "final_empty": schema.get("final_empty") == 1,
        "intercept_match": (intercepted == sum(event[4] for event in expected_result["events"])
                            == sum(event[4] for event in schema.get("events", ()))),
        "attempt_match": (attempted == sum(event[5] for event in expected_result["events"])
                          == sum(event[5] for event in schema.get("events", ()))),
        "retry_match": (sum(event[3] for event in schema.get("events", ()))
                        == sum(event[3] for event in expected_result["events"])),
        "lock_handoff_ok": not lock_handoff_error,
        "cleanup_error_empty": not cleanup_error,
        "cleanup_categories": cleanup_categories == (),
        "lock_reuse": not lock_reuse_error,
        "signed_cleanup_required": signed_cleanup_required == expected_signed_cleanup_required,
        "signed_cleanup_ran": signed_cleanup_ran == signed_cleanup_required,
        "release": release_ok,
        "reap": reap_ok,
        "unit_absent": unit_absent,
        "recorded_category": recorded_category == "attested",
        "recorded_required": recorded_required and recorded_path_present,
        "recorded_scan": recorded_scanned,
        "canonical_scan": canonical_scanned,
        "recorded_empty": recorded_empty,
        "canonical_empty": canonical_empty,
        "artifacts_absent": artifacts_absent,
    }
    return predicates


def persistent_scalar_diagnostic(case, boundary, lifecycle_category, predicates, stderr_shape):
    lifecycle = lifecycle_category if lifecycle_category in (
        "none", "non-canonical", "timeout", "unexpected") else "unexpected"
    bits = {name: diagnostic_bit(value) for name, value in predicates.items()}
    byte_class = ("bounded" if stderr_shape["byte_bounded"] else
                  "empty" if stderr_shape["byte_count"] == 0 else "over")
    fields = (
        ("case", case), ("boundary", boundary), ("life", lifecycle),
        ("release", bits["release"]), ("reap", bits["reap"]),
        ("signed_req", bits["signed_cleanup_required"]),
        ("signed_ran", bits["signed_cleanup_ran"]), ("absent", bits["unit_absent"]),
        ("rec_cat", bits["recorded_category"]), ("rec_req", bits["recorded_required"]),
        ("rec_scan", bits["recorded_scan"]), ("can_scan", bits["canonical_scan"]),
        ("rec_empty", bits["recorded_empty"]), ("can_empty", bits["canonical_empty"]),
        ("handoff", bits["lock_handoff_ok"]), ("reuse", bits["lock_reuse"]),
        ("artifacts", bits["artifacts_absent"]),
        ("cleanup_empty", bits["cleanup_error_empty"]),
        ("cleanup_cats", bits["cleanup_categories"]),
        ("ev_complete", bits["events_complete"]),
        ("fin_scan", bits["final_scanned"]),
        ("fin_seen", bits["final_observed"]), ("fin_empty", bits["final_empty"]),
        ("case_exact", bits["case_exact"]), ("life_match", bits["lifecycle_match"]),
        ("schema_shape", bits["schema_shape"]), ("schema_exact", bits["schema_exact"]),
        ("primary", bits["primary_exact"]), ("events", bits["events_exact"]),
        ("ret", bits["return_match"]), ("out", bits["stdout_match"]),
        ("success", bits["success_match"]), ("retry", bits["retry_match"]),
        ("intercept", bits["intercept_match"]), ("attempt", bits["attempt_match"]),
        ("se_lines", str(stderr_shape["line_count"])), ("se_bytes", byte_class),
        ("se_lws", diagnostic_bit(stderr_shape["leading_whitespace"])),
        ("se_tws", diagnostic_bit(stderr_shape["trailing_whitespace"])),
    )
    return serialize_diagnostic("persistent", "result", fields, complete=True)


def stale_expected_rejection(state):
    safe_names = ("LoadState", "InvocationID", "ActiveState", "SubState", "ControlGroup")
    safe = {name: state.get(name) for name in safe_names if name in state}
    return STALE_REJECTION_PREFIX + str(safe) + "\n"


def stale_client_classification(attempted, returncode, stdout, stderr, expected_human):
    result_available = attempted and type(returncode) is int
    success_marker = result_available and SUCCESS in stdout
    accepted = result_available and (returncode == 0 or success_marker)
    parsed, stderr_shape = client_stderr_evidence(stderr)
    lines = stderr.splitlines(keepends=True) if type(stderr) is str else []
    machine_contract = bool(
        stderr_shape["shape"] and parsed is not None
        and parsed["primary"] == "verification" and parsed["events"] == ()
        and parsed["events_complete"] == 1 and parsed["final_scanned"] == 1
        and parsed["final_observed"] == 1 and parsed["final_empty"] == 1
        and parsed["return"] == 1 and parsed["stdout"] == 0 and parsed["success"] == 0)
    human_rejection = bool(
        stderr_shape["shape"] and len(lines) == 2 and lines[1] == expected_human)
    result_contract = bool(
        result_available and returncode == 1 and stdout == "" and not success_marker
        and machine_contract and human_rejection)
    return {
        "attempted": bool(attempted),
        "result_available": result_available,
        "accepted": accepted,
        "success_marker": success_marker,
        "machine_contract": machine_contract,
        "human_rejection": human_rejection,
        "result_contract": result_contract,
        "expected_rejection": result_contract,
        "wrong_reason": (result_available and returncode != 0
                         and not success_marker and not result_contract),
    }


def diagnostic_bit(value):
    return "1" if bool(value) else "0"


def stale_failure_category(classification, identity_changed, fixture_error):
    if classification["accepted"]:
        return "accepted"
    if classification["wrong_reason"] and identity_changed:
        return "result-identity"
    if classification["wrong_reason"]:
        return "wrong-reason"
    if identity_changed:
        return "identity-change"
    if fixture_error:
        return "fixture-error"
    return "cleanup-error"


def stale_failure_message(failure_category, client_zero, classification, unit_absent,
                          recorded_empty, canonical_empty, identity_unchanged, identity_changed,
                          cleanup_attempted, cleanup_succeeded, lock_reusable,
                          artifacts_removed, post_evidence_complete, ready, released, ack,
                          error_category, fixture_error, client_output, cleanup_error):
    if failure_category not in ("accepted", "wrong-reason", "identity-change",
                                "result-identity", "fixture-error", "cleanup-error"):
        failure_category = "invalid"
    if error_category not in ("none", "fixture", "release", "state", "identity",
                              "action", "post", "lock", "paths"):
        error_category = "invalid"
    fields = (
        ("attempted", diagnostic_bit(classification["attempted"])),
        ("result_available", diagnostic_bit(classification["result_available"])),
        ("client_zero", diagnostic_bit(client_zero)),
        ("success_marker", diagnostic_bit(classification["success_marker"])),
        ("machine_contract", diagnostic_bit(classification["machine_contract"])),
        ("human_rejection", diagnostic_bit(classification["human_rejection"])),
        ("result_contract", diagnostic_bit(classification["result_contract"])),
        ("expected_rejection", diagnostic_bit(classification["expected_rejection"])),
        ("wrong_reason", diagnostic_bit(classification["wrong_reason"])),
        ("unit_absent", diagnostic_bit(unit_absent)),
        ("recorded_empty", diagnostic_bit(recorded_empty)),
        ("canonical_empty", diagnostic_bit(canonical_empty)),
        ("identity_unchanged", diagnostic_bit(identity_unchanged)),
        ("identity_changed", diagnostic_bit(identity_changed)),
        ("cleanup_attempted", diagnostic_bit(cleanup_attempted)),
        ("cleanup_succeeded", diagnostic_bit(cleanup_succeeded)),
        ("lock_reusable", diagnostic_bit(lock_reusable)),
        ("artifacts_removed", diagnostic_bit(artifacts_removed)),
        ("post_evidence_complete", diagnostic_bit(post_evidence_complete)),
        ("ready", diagnostic_bit(ready)), ("release", diagnostic_bit(released)),
        ("ack", diagnostic_bit(ack)), ("error_category", error_category),
        ("fixture_error", diagnostic_bit(fixture_error)),
        ("client_output", diagnostic_bit(client_output)),
        ("cleanup_error", diagnostic_bit(cleanup_error)),
    )
    return serialize_diagnostic("stale", failure_category, fields, complete=True)


def sanitized_diagnostic_text(value, active_nonce=None):
    if isinstance(value, subprocess.TimeoutExpired):
        text = "subprocess timed out"
    elif isinstance(value, subprocess.CalledProcessError):
        text = f"subprocess failed with status {value.returncode}"
    elif isinstance(value, OSError):
        number = diagnostic_errno(value)
        text = f"phase=uncategorized operation=unknown resource=unknown errno={number}"
    else:
        try:
            text = str(value)
        except BaseException:
            text = "diagnostic conversion failed"
    if active_nonce:
        text = text.replace(active_nonce, "<redacted-nonce>")
    if any(marker in text for name in ("Description", "Environment", "ExecStart", "Command")
           for marker in (name + "=", "'" + name + "':", '"' + name + '\":')):
        text = "diagnostic contained redacted launch identity"
    index = 0
    parts = []
    hexadecimal = "0123456789abcdefABCDEF"
    while index < len(text):
        candidate = text[index:index + 64]
        candidate_hex = True
        for character in candidate:
            if character not in hexadecimal:
                candidate_hex = False
                break
        if len(candidate) == 64 and candidate_hex:
            parts.append("<redacted-hex64>")
            index += 64
        else:
            parts.append(text[index])
            index += 1
    text = "".join(parts)
    return text


def render_diagnostic_message(message):
    return (DIAGNOSTIC_PREFIX + ascii(message) + "\n").encode("ascii")


def serialize_diagnostic(scenario, failure_class, fields=(), detail=None,
                         active_nonce=None, complete=False):
    if (not scenario or not failure_class
            or any(character not in "abcdefghijklmnopqrstuvwxyz-" for character in scenario)
            or any(character not in "abcdefghijklmnopqrstuvwxyz-" for character in failure_class)):
        raise RuntimeError("diagnostic class was not a closed token")
    parts = [f"scenario={scenario}", f"failure={failure_class}"]
    names = set()
    for name, value in fields:
        if (not name or name in names
                or any(character not in "abcdefghijklmnopqrstuvwxyz_" for character in name)):
            raise RuntimeError("diagnostic field schema was not unique and closed")
        value = str(value)
        if (not value or any(character not in "abcdefghijklmnopqrstuvwxyz0123456789_-" for character in value)):
            raise RuntimeError("diagnostic field value was not a closed token")
        names.add(name)
        parts.append(f"{name}={value}")
    fixed = ";".join(parts)

    if detail is None:
        payload = render_diagnostic_message(fixed)
    else:
        text = sanitized_diagnostic_text(detail, active_nonce)
        payload = render_diagnostic_message(fixed + ";detail=" + text)
        if len(payload) > DIAGNOSTIC_TEXT_LIMIT and not complete:
            marker = "...<truncated>"
            low, high = 0, len(text)
            while low < high:
                middle = (low + high + 1) // 2
                candidate = render_diagnostic_message(
                    fixed + ";detail=" + text[:middle] + marker)
                if len(candidate) <= DIAGNOSTIC_TEXT_LIMIT:
                    low = middle
                else:
                    high = middle - 1
            payload = render_diagnostic_message(fixed + ";detail=" + text[:low] + marker)
    if len(payload) > DIAGNOSTIC_TEXT_LIMIT:
        raise RuntimeError("complete diagnostic exceeded its outer byte bound")
    return payload


def validate_serialized_diagnostic(payload):
    prefix = (DIAGNOSTIC_PREFIX + "'").encode("ascii")
    if (type(payload) is not bytes or not payload or len(payload) > DIAGNOSTIC_TEXT_LIMIT
            or not payload.startswith(prefix) or not payload.endswith(b"'\n")
            or payload.count(b"\n") != 1):
        raise RuntimeError("serialized diagnostic framing was invalid")
    try:
        message = payload[len(prefix):-2].decode("ascii")
    except UnicodeDecodeError:
        raise RuntimeError("serialized diagnostic was not ASCII") from None
    pairs = []
    for part in message.split(";"):
        name, separator, value = part.partition("=")
        if (not separator or not name or not value
                or any(character not in "abcdefghijklmnopqrstuvwxyz_" for character in name)
                or any(character not in "abcdefghijklmnopqrstuvwxyz0123456789_-" for character in value)):
            raise RuntimeError("serialized diagnostic schema was invalid")
        pairs.append((name, value))
    if (len(pairs) < 2 or pairs[0][0] != "scenario" or pairs[1][0] != "failure"
            or pairs[0][1] not in ("persistent", "producer", "stale")
            or (pairs[0][1] == "persistent" and pairs[1][1] != "result")
            or (pairs[0][1] == "producer" and pairs[1][1] not in (
                "producer-exit-before-ready", "producer-timeout-before-ready"))
            or (pairs[0][1] == "stale" and pairs[1][1] not in (
                "accepted", "wrong-reason", "identity-change", "result-identity",
                "fixture-error", "cleanup-error", "invalid"))):
        raise RuntimeError("serialized diagnostic class was invalid")
    serialized_fields = tuple(pairs[2:])
    field_names = tuple(name for name, _value in serialized_fields)
    fields_by_name = dict(serialized_fields)
    if pairs[0][1] == "persistent":
        expected_names = (
            "case", "boundary", "life", "release", "reap", "signed_req", "signed_ran",
            "absent", "rec_cat", "rec_req", "rec_scan", "can_scan", "rec_empty",
            "can_empty", "handoff", "reuse", "artifacts", "cleanup_empty",
            "cleanup_cats", "ev_complete", "fin_scan", "fin_seen", "fin_empty",
            "case_exact", "life_match", "schema_shape", "schema_exact", "primary",
            "events", "ret", "out", "success", "retry", "intercept", "attempt",
            "se_lines", "se_bytes", "se_lws", "se_tws",
        )
        bit_names = expected_names[3:35] + expected_names[37:]
        line_count = fields_by_name.get("se_lines", "")
        valid_domains = (
            fields_by_name.get("case") in ("normal", "parse", "timeout")
            and fields_by_name.get("boundary") in ("show", "kill", "stop", "wait", "reset", "unload")
            and fields_by_name.get("life") in ("none", "non-canonical", "timeout", "unexpected")
            and all(fields_by_name.get(name) in ("0", "1") for name in bit_names)
            and line_count != "" and all(character in "0123456789" for character in line_count)
            and (line_count == "0" or line_count[0] != "0")
            and fields_by_name.get("se_bytes") in ("bounded", "empty", "over")
        )
    elif pairs[0][1] == "stale":
        expected_names = (
            "attempted", "result_available", "client_zero", "success_marker",
            "machine_contract", "human_rejection", "result_contract",
            "expected_rejection", "wrong_reason", "unit_absent", "recorded_empty",
            "canonical_empty", "identity_unchanged", "identity_changed", "cleanup_attempted",
            "cleanup_succeeded", "lock_reusable", "artifacts_removed",
            "post_evidence_complete", "ready", "release", "ack", "error_category",
            "fixture_error", "client_output", "cleanup_error",
        )
        bit_names = expected_names[:22] + expected_names[23:]
        valid_domains = (
            all(fields_by_name.get(name) in ("0", "1") for name in bit_names)
            and fields_by_name.get("error_category") in (
                "none", "fixture", "release", "state", "identity", "action", "post",
                "lock", "paths", "invalid")
        )
    else:
        expected_names = (
            "stage", "target", "client", "return_code", "result", "load",
            "active", "sub", "mainpid", "unit_result", "identity", "environment",
            "transaction", "journal", "ready", "reap", "cleanup", "unit_absent",
            "recorded_scan", "canonical_scan", "recorded_empty", "canonical_empty",
            "client_lock", "transaction_lock",
        )
        bit_names = expected_names[15:16] + expected_names[17:]
        return_code = fields_by_name.get("return_code", "")
        mainpid = fields_by_name.get("mainpid", "")
        valid_domains = (
            fields_by_name.get("stage") in INTENT_STAGES
            and fields_by_name.get("target") in set(INTENT_TARGETS.values())
            and fields_by_name.get("client") in ("exited", "live", "unknown")
            and return_code != "" and (return_code == "unknown"
                or return_code.lstrip("-").isdecimal())
            and fields_by_name.get("result") in ("exact", "invalid", "unavailable")
            and fields_by_name.get("load") in ("loaded", "not-found", "unknown")
            and fields_by_name.get("active") in ("active", "failed", "inactive", "unknown")
            and fields_by_name.get("sub") in ("running", "exited", "failed", "dead", "unknown")
            and mainpid != "" and (mainpid == "unknown" or mainpid.isdecimal())
            and fields_by_name.get("unit_result") in (
                "success", "exit-code", "signal", "timeout", "unknown")
            and fields_by_name.get("identity") in ("exact", "mismatch", "absent", "unknown")
            and fields_by_name.get("environment") in ("exact", "mismatch", "absent", "unknown")
            and fields_by_name.get("transaction") in ("blocked", "reusable", "unknown")
            and fields_by_name.get("journal") in (
                "signed", "unsigned", "absent", "unknown")
            and fields_by_name.get("ready") in ("present", "absent", "unknown")
            and fields_by_name.get("cleanup") in (
                "complete", "action", "cgroup", "lock", "reap", "state",
                "unsigned-loaded", "multiple", "unknown")
            and all(fields_by_name.get(name) in ("0", "1") for name in bit_names)
        )
    if field_names != expected_names or not valid_domains:
        raise RuntimeError("serialized diagnostic fields were incomplete")
    trusted = serialize_diagnostic(
        pairs[0][1], pairs[1][1], serialized_fields, complete=True)
    if trusted != payload:
        raise RuntimeError("serialized diagnostic was not canonical and complete")
    return payload


def top_level_diagnostic(error):
    if isinstance(error, OSError):
        detail = evidence_failure("uncategorized", "unknown", "unknown", error)
        return serialize_diagnostic(
            "containment", "os-error", (("finality", "unknown"),), detail=detail)
    return serialize_diagnostic(
        "containment", "unexpected", (("finality", "unknown"),), detail=error)


def write_diagnostic(stream, error):
    payload = (validate_serialized_diagnostic(error.payload)
               if isinstance(error, SerializedDiagnosticFailure)
               else top_level_diagnostic(error))
    offset = 0
    while offset < len(payload):
        written = stream.write(payload[offset:])
        if type(written) is not int or written <= 0 or written > len(payload) - offset:
            raise RuntimeError("diagnostic stream write was not complete")
        offset += written
    stream.flush()
    return len(payload)


def sanitized_state(state):
    if state is None:
        return "explicit-absence"
    safe_names = ("LoadState", "InvocationID", "ActiveState", "SubState", "ControlGroup",
                  "Result", "ExecMainCode", "ExecMainStatus", "ExecMainPID", "MainPID",
                  "EvidenceError", *SERVICE_PROPERTIES)
    safe = {name: state.get(name) for name in safe_names if name in state}
    return sanitized_diagnostic_text(safe)


def assert_machine_result_contract():
    expected = expected_persistent_result("parse", "kill")
    line = (RESULT_PREFIX + "primary=cleanup-test;events=0.kill.kill-unavailable.1.2.0;"
            "events_complete=1;final_scanned=1;final_observed=1;final_empty=1;"
            "return=1;stdout=0;success=0")
    stderr = line + "\nverification-client: " + "x" * 700 + "\n"
    parsed, shape = client_stderr_evidence(stderr)
    if parsed != expected or not shape["shape"]:
        fail("canonical persistent client result schema was rejected")
    mixed = parse_client_result(
        RESULT_PREFIX + "primary=cleanup-test;events="
        "0.show.property-recovered.1.1.1,1.show.property-unavailable.3.4.1,"
        "2.stop.stop-unavailable.1.2.0,"
        "3.unload.unload-timeout.0.0.0,4.final.cgroup-residue.0.0.0,"
        "5.final.cgroup-observation.0.0.0,6.final.unexpected.0.0.0;"
        "events_complete=1;final_scanned=1;final_observed=1;final_empty=0;"
        "return=1;stdout=0;success=0")
    if mixed["events"] != (
            (0, "show", "property-recovered", 1, 1, 1),
            (1, "show", "property-unavailable", 3, 4, 1),
            (2, "stop", "stop-unavailable", 1, 2, 0),
            (3, "unload", "unload-timeout", 0, 0, 0),
            (4, "final", "cgroup-residue", 0, 0, 0),
            (5, "final", "cgroup-observation", 0, 0, 0),
            (6, "final", "unexpected", 0, 0, 0)):
        fail("mixed recovered, final residue, and unknown cleanup ordering changed")
    malformed = (
        line.replace("primary=cleanup-test", "primary=unknown"),
        line.replace("kill.kill-unavailable", "unknown.kill-unavailable"),
        line.replace("kill.kill-unavailable", "kill.unexpected-category"),
        line.replace("0.kill.kill-unavailable.1.2.0", "0.kill.kill-unavailable.1.2.0,0.kill.kill-unavailable.1.2.0"),
        line.replace("events=0.kill.kill-unavailable.1.2.0", "events=1.kill.kill-unavailable.1.2.0"),
        line.replace(".1.2.0", ".01.2.0"),
        line.replace(".1.2.0", ".1.-1.0"),
        line.replace(".1.2.0", ".1.2.1000000"),
        line.replace(";events=0.kill.kill-unavailable.1.2.0", ""),
        line.replace(";return=1", ";extra=0;return=1"),
        line.replace("primary=cleanup-test;events=", "events=0.kill.kill-unavailable.1.2.0;primary=cleanup-test;events="),
        line.replace("events_complete=1", "events_complete=2"),
        line.replace("final_scanned=1", "final_scanned=0"),
        line.replace("final_observed=1", "final_observed=0"),
        line + " ", " " + line, line + "\n", line + "\nextra",
    )
    for mutation in malformed:
        try:
            parse_client_result(mutation)
        except RuntimeError:
            continue
        fail("client result parser accepted a malformed schema mutation")
    for mutated_stderr in (
            line + "\n", "verification-client: human only\n",
            line + "\nverification-client: human\nextra\n",
            " " + line + "\nverification-client: human\n",
            line + "\nverification-client: human"):
        _parsed, mutated_shape = client_stderr_evidence(mutated_stderr)
        if mutated_shape["shape"]:
            fail("client stderr extractor accepted missing, bypassed, padded, or extra schema data")

    facts = {
        "case": "parse", "expected_case": "parse",
        "lifecycle_category": "non-canonical", "expected_lifecycle": "non-canonical",
        "parsed": parsed, "stderr_shape": shape, "expected_result": expected,
        "returncode": 1, "stdout": "", "intercepted": 2, "attempted": 0,
        "lock_handoff_error": "", "cleanup_error": "", "cleanup_categories": (),
        "lock_reuse_error": "", "expected_signed_cleanup_required": True,
        "signed_cleanup_required": True, "signed_cleanup_ran": True,
        "release_ok": True, "reap_ok": True, "unit_absent": True,
        "recorded_category": "attested", "recorded_required": True,
        "recorded_path_present": True, "recorded_scanned": True, "canonical_scanned": True,
        "recorded_empty": True, "canonical_empty": True, "artifacts_absent": True,
    }
    predicates = evaluate_persistent_result(**facts)
    if not all(predicates.values()):
        fail("valid persistent result failed an independent contract predicate")
    mutations = {
        "case_exact": ("case", "normal"),
        "lifecycle_match": ("lifecycle_category", "timeout"),
        "schema_shape": ("stderr_shape", {**shape, "shape": False}),
        "schema_exact": ("parsed", {**parsed, "events": ((0, "kill", "kill-unavailable", 0, 2, 0),)}),
        "events_complete": ("parsed", {**parsed, "events_complete": 0}),
        "final_scanned": ("parsed", {**parsed, "final_scanned": 0}),
        "final_observed": ("parsed", {**parsed, "final_observed": 0}),
        "final_empty": ("parsed", {**parsed, "final_empty": 0}),
        "return_match": ("returncode", 0), "stdout_match": ("stdout", "extra"),
        "intercept_match": ("intercepted", 1), "attempt_match": ("attempted", 1),
        "lock_handoff_ok": ("lock_handoff_error", "failed"),
        "cleanup_error_empty": ("cleanup_error", "failed"),
        "cleanup_categories": ("cleanup_categories", ("unexpected",)),
        "lock_reuse": ("lock_reuse_error", "failed"),
        "signed_cleanup_required": ("signed_cleanup_required", False),
        "signed_cleanup_ran": ("signed_cleanup_ran", False),
        "release": ("release_ok", False), "reap": ("reap_ok", False),
        "unit_absent": ("unit_absent", False),
        "recorded_category": ("recorded_category", "unexpected"),
        "recorded_required": ("recorded_path_present", False),
        "recorded_scan": ("recorded_scanned", False),
        "canonical_scan": ("canonical_scanned", False),
        "recorded_empty": ("recorded_empty", False),
        "canonical_empty": ("canonical_empty", False),
        "artifacts_absent": ("artifacts_absent", False),
    }
    for expected_false, (name, value) in mutations.items():
        changed = {**facts, name: value}
        observed = evaluate_persistent_result(**changed)
        if observed.get(expected_false) is not False or all(observed.values()):
            fail(f"persistent evaluator lost hidden conjunct: {expected_false}")
    labels = {
        "release": "release", "reap": "reap",
        "signed_cleanup_required": "signed_req", "signed_cleanup_ran": "signed_ran",
        "unit_absent": "absent", "recorded_category": "rec_cat",
        "recorded_required": "rec_req", "recorded_scan": "rec_scan",
        "canonical_scan": "can_scan", "recorded_empty": "rec_empty",
        "canonical_empty": "can_empty", "lock_handoff_ok": "handoff",
        "lock_reuse": "reuse", "artifacts_absent": "artifacts",
        "cleanup_error_empty": "cleanup_empty", "cleanup_categories": "cleanup_cats",
        "events_complete": "ev_complete", "final_scanned": "fin_scan",
        "final_observed": "fin_seen", "final_empty": "fin_empty",
        "case_exact": "case_exact", "lifecycle_match": "life_match",
        "schema_shape": "schema_shape", "schema_exact": "schema_exact",
        "primary_exact": "primary", "events_exact": "events",
        "return_match": "ret", "stdout_match": "out", "success_match": "success",
        "retry_match": "retry", "intercept_match": "intercept", "attempt_match": "attempt",
    }
    if set(labels) != set(predicates):
        fail("persistent diagnostic field map omitted or invented a predicate")
    worst_shape = {**shape, "line_count": 999999, "byte_count": 999999,
                   "byte_bounded": False}
    all_true = persistent_scalar_diagnostic(
        "parse", "unload", "non-canonical", {name: True for name in predicates}, worst_shape)
    all_false = persistent_scalar_diagnostic(
        "parse", "unload", "non-canonical", {name: False for name in predicates}, worst_shape)
    for emitted, bit in ((all_true, "1"), (all_false, "0")):
        text = emitted.decode("ascii")
        if (len(emitted) > DIAGNOSTIC_TEXT_LIMIT or "<truncated>" in text
                or "x" * 64 in text or not text.endswith("'\n")):
            fail("persistent scalar diagnostic was truncated, unbounded, or retained bulky data")
        for label in labels.values():
            if text.count(f";{label}={bit}") != 1:
                fail("persistent scalar diagnostic lost a unique predicate field")
    for predicate, label in labels.items():
        values = {name: True for name in predicates}
        values[predicate] = False
        text = persistent_scalar_diagnostic(
            "parse", "unload", "non-canonical", values, worst_shape).decode("ascii")
        if text.count(f";{label}=0") != 1:
            fail("persistent scalar diagnostic lost a single-failure predicate")
        for other in set(labels.values()) - {label}:
            if text.count(f";{other}=1") != 1:
                fail("persistent scalar diagnostic changed an unrelated predicate")
    for case in ("normal", "parse", "timeout"):
        for lifecycle in ("none", "non-canonical", "timeout", "unexpected"):
            for byte_count, byte_bounded in ((0, False), (999999, True), (999999, False)):
                emitted = persistent_scalar_diagnostic(
                    case, "unload", lifecycle, predicates,
                    {**shape, "line_count": 999999, "byte_count": byte_count,
                     "byte_bounded": byte_bounded})
                if len(emitted) > DIAGNOSTIC_TEXT_LIMIT:
                    fail("persistent scalar diagnostic class exceeded its outer byte bound")


def assert_persistent_cgroup_routing_contract():
    calls = []
    reader = lambda path: calls.append(path) or []
    recorded, category = retain_persistent_cgroup(
        "", {"LoadState": "loaded", "ControlGroup": "/recorded"})
    recorded, category = retain_persistent_cgroup(
        recorded, {"LoadState": "not-found"})
    result, recorded_scanned, canonical_scanned = persistent_cgroup_finality(
        recorded, category, reader)
    if (recorded != "/recorded" or category != "attested"
            or not recorded_scanned or not canonical_scanned
            or result != {"recorded": [], "canonical": []}
            or calls != ["/recorded", "/system.slice/" + UNIT]):
        fail("live persistent control group was not retained and independently scanned")
    for label, outcomes in (
            ("recorded-error-canonical-residue", ("error", [41])),
            ("recorded-error-canonical-empty", ("error", [])),
            ("recorded-residue-canonical-error", ([42], "error")),
            ("recorded-empty-canonical-error", ([], "error")),
            ("both-error", ("error", "error"))):
        calls.clear()
        failing_reader = lambda path: calls.append(path) or (
            {}["error"] if outcomes[len(calls) - 1] == "error"
            else outcomes[len(calls) - 1])
        try:
            persistent_cgroup_finality(recorded, category, failing_reader)
        except PersistentCgroupFinalityFailure as error:
            expected_result = {
                "recorded": [] if outcomes[0] == "error" else outcomes[0],
                "canonical": [] if outcomes[1] == "error" else outcomes[1],
            }
            if (calls != ["/recorded", "/system.slice/" + UNIT]
                    or error.result != expected_result
                    or not error.recorded_scanned or not error.canonical_scanned
                    or tuple(name for name, _error in error.errors) != tuple(
                        name for name, outcome in zip(("recorded", "canonical"), outcomes)
                        if outcome == "error")):
                fail(f"persistent final scan did not preserve independent evidence: {label}")
        else:
            fail(f"persistent final scan failure unexpectedly succeeded: {label}")
    for state in (
            {"LoadState": "loaded", "ControlGroup": ""},
            {"LoadState": "loaded", "ControlGroup": "/replacement"}):
        try:
            retain_persistent_cgroup("/recorded", state)
        except RuntimeError:
            if state["ControlGroup"] == "":
                fail("later empty terminal control group discarded its retained path")
            continue
        if state["ControlGroup"]:
            fail("persistent control group replacement was accepted")
    try:
        retain_persistent_cgroup("", {"LoadState": "loaded", "ControlGroup": ""})
    except RuntimeError:
        return
    fail("persistent containment accepted an empty initial control group")


def assert_persistent_failure_contract():
    cases = (
        ("", "verification-client: unit properties remain unknown: intercepted", (False, True, False)),
        ("", "verification-client: owned stop command remains unavailable: intercepted", (False, False, True)),
        (SUCCESS + "\n", "verification-client: unrelated error", (True, False, False)),
        ("", "verification-client: unrelated error", (False, False, False)),
    )
    for stdout, stderr, expected in cases:
        classification = persistent_failure_classification(stdout, stderr)
        observed = tuple(classification[name] for name in (
            "success_in_stdout", "property_unknown", "action_unavailable"))
        if observed != expected:
            fail(f"persistent failure classification changed: {observed!r} != {expected!r}")
    secret = "a" * 64
    rendered = top_level_diagnostic(
        RuntimeError(secret + ":" + "x" * DIAGNOSTIC_TEXT_LIMIT)).decode("ascii")
    if secret in rendered or "<redacted-hex64>" not in rendered or "<truncated>" not in rendered:
        fail("persistent failure diagnostics lost redaction or bounded output")
    property_failure = persistent_failure_classification("", cases[0][1])
    success_failure = persistent_failure_classification(SUCCESS, "")
    unrelated_failure = persistent_failure_classification("", cases[3][1])
    absent = {"LoadState": "not-found"}
    scenarios = (
        (persistent_result_violation(0, property_failure, "", "", "", absent, []), True),
        (persistent_result_violation(1, success_failure, "", "", "", absent, []), True),
        (persistent_result_violation(1, unrelated_failure, "", "", "", absent, []), True),
        (persistent_result_violation(1, property_failure, "", "cleanup failed", "", absent, []), True),
        (persistent_result_violation(1, property_failure, "lock failed", "", "", absent, []), True),
        (persistent_result_violation(1, property_failure, "", "", "", absent, []), False),
    )
    if any(observed is not expected for observed, expected in scenarios):
        fail("persistent cleanup-first result classification changed")
    primary = "verification-client: injected client failure before cleanup boundary test; cleanup failed: "
    kill_interception = "intercepted kill command before attempt"
    wait_interception = "intercepted wait command before attempt"
    kill_stderr = (primary + "owned kill command remains unavailable: "
                   + "; ".join((kill_interception,) * 2) + "\n")
    wait_stderr = (primary + "unit properties remain unknown: "
                   + "; ".join((wait_interception,) * 4) + "\n")
    special_scenarios = (
        (persistent_special_result_violation(1, "", kill_stderr, "parse", "kill", 2, 0), False),
        (persistent_special_result_violation(
            1, "", kill_stderr.replace("owned kill", "owned stop"),
            "parse", "kill", 2, 0), True),
        (persistent_special_result_violation(
            1, SUCCESS + "\nextra", kill_stderr, "parse", "kill", 2, 0), True),
        (persistent_special_result_violation(
            1, "", "prefix" + kill_stderr, "parse", "kill", 2, 0), True),
        (persistent_special_result_violation(
            1, "", kill_stderr + "suffix", "parse", "kill", 2, 0), True),
        (persistent_special_result_violation(
            1, "", kill_stderr + "extra\n", "parse", "kill", 2, 0), True),
        (persistent_special_result_violation(1, "", wait_stderr, "timeout", "wait", 4, 0), False),
        (persistent_special_result_violation(
            1, "", wait_stderr.replace("intercepted wait", "intercepted show"),
            "timeout", "wait", 4, 0), True),
        (persistent_special_result_violation(
            1, "", kill_stderr, "timeout", "wait", 4, 0), True),
        (persistent_special_result_violation(
            1, "", wait_stderr + "extra", "timeout", "wait", 4, 0), True),
        (persistent_special_result_violation(0, "", kill_stderr, "parse", "kill", 2, 0), True),
        (persistent_special_result_violation(2, "", kill_stderr, "parse", "kill", 2, 0), True),
        (persistent_special_result_violation(1, "", kill_stderr, "parse", "kill", 1, 0), True),
        (persistent_special_result_violation(1, "", kill_stderr, "parse", "kill", 2, 1), True),
    )
    if any(observed is not expected for observed, expected in special_scenarios):
        fail("special persistent client result classification changed")


def run(phase, argv, **kwargs):
    kwargs.setdefault("timeout", 18 * 60)
    try:
        return subprocess.run(argv, cwd="/", env=ENV, text=True, **kwargs)
    except OSError as error:
        raise evidence_failure(phase, "run", "process", error) from None


def parse_unit_properties(result, requested):
    if result.returncode:
        fail(f"containment systemctl show failed with status {result.returncode}")
    if not result.stdout:
        fail("containment systemctl show returned empty output")
    values = {}
    for line in result.stdout.splitlines():
        key, separator, value = line.partition("=")
        if not separator or not key or key in values:
            fail("containment systemctl show returned malformed output")
        values[key] = value
    if values.get("LoadState") == "not-found":
        return values
    missing = [name for name in requested if name not in values]
    if missing:
        fail(f"containment systemctl show omitted required properties: {', '.join(missing)}")
    return values


def show(phase, *properties):
    requested = tuple(dict.fromkeys(("LoadState", *properties)))
    errors = []
    for attempt in range(4):
        try:
            result = run(phase, ("/usr/bin/systemctl", "show", UNIT,
                          *(f"--property={item}" for item in requested)), check=False,
                         stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=1)
            values = parse_unit_properties(result, requested)
            return values
        except (OSError, subprocess.SubprocessError, RuntimeError) as error:
            errors.append(error)
            if attempt < 3:
                time.sleep(0.05 * (2 ** attempt))
    fail("containment unit properties remain unknown: "
         + "; ".join(sanitized_diagnostic_text(error) for error in errors))


def assert_property_parser_contract(client):
    try:
        client_namespace = runpy.run_path(client, run_name="nmcp_client_parser_fixture")
    except OSError as error:
        raise evidence_failure("runpy", "read", "client", error) from None
    client_parser = client_namespace["parse_unit_properties"]
    successful_terminal_state = client_namespace["successful_terminal_state"]
    requested = ("LoadState", "ExecStart")
    minimal_absence = subprocess.CompletedProcess(
        ("systemctl", "show"), 0, "LoadState=not-found\n", ""
    )
    loaded_full = subprocess.CompletedProcess(
        ("systemctl", "show"), 0,
        "LoadState=loaded\nExecStart={ path=/usr/bin/true ; argv[]=/usr/bin/true ; }\n", ""
    )
    rejected = (
        subprocess.CompletedProcess(("systemctl", "show"), 1, "", "not found"),
        subprocess.CompletedProcess(("systemctl", "show"), 0, "", ""),
        subprocess.CompletedProcess(("systemctl", "show"), 0, "LoadState=not-found\nbroken\n", ""),
        subprocess.CompletedProcess(("systemctl", "show"), 0, "LoadState=loaded\n", ""),
    )
    for parser_name, parser in (("client", client_parser), ("containment", parse_unit_properties)):
        absent = parser(minimal_absence, requested)
        if absent != {"LoadState": "not-found"}:
            fail(f"{parser_name} parser did not accept exact minimal explicit absence")
        loaded = parser(loaded_full, requested)
        if loaded.get("LoadState") != "loaded" or "ExecStart" not in loaded:
            fail(f"{parser_name} parser lost complete loaded identity")
        for result in rejected:
            try:
                parser(result, requested)
            except RuntimeError:
                pass
            else:
                fail(f"{parser_name} parser accepted unknown or incomplete unit state")
        transition = iter((loaded_full, minimal_absence))
        if parser(next(transition), requested).get("LoadState") != "loaded":
            fail(f"{parser_name} parser lost transitional loaded state")
        if parser(next(transition), requested).get("LoadState") != "not-found":
            fail(f"{parser_name} parser did not complete on minimal transitional absence")
    successful_state = {
        "Result": "success", "ExecMainStatus": "0",
        "ActiveState": "active", "SubState": "exited",
    }
    for code in ("1", "exited"):
        if not successful_terminal_state({**successful_state, "ExecMainCode": code}):
            fail(f"terminal success rejected strict CLD_EXITED spelling: {code!r}")
    if not successful_terminal_state({**successful_state, "ExecMainCode": "1", "ExecMainStatus": 0}):
        fail("terminal success rejected exact integer zero status")
    for code in ("", " 1", "1 ", "01", "Exited", "EXITED", " exited", "exited ",
                 "0", "2", "3", "killed", "dumped", 1, True, None):
        if successful_terminal_state({**successful_state, "ExecMainCode": code}):
            fail(f"terminal success accepted non-CLD_EXITED code: {code!r}")
    rejected_terminal_states = (
        {**successful_state, "ExecMainCode": "1", "ExecMainStatus": "1"},
        {**successful_state, "ExecMainCode": "1", "ExecMainStatus": False},
        {**successful_state, "ExecMainCode": "1", "Result": "exit-code"},
        {**successful_state, "ExecMainCode": "1", "ActiveState": "failed"},
        {**successful_state, "ExecMainCode": "1", "SubState": "dead"},
        {key: value for key, value in {**successful_state, "ExecMainCode": "1"}.items()
         if key != "Result"},
        {key: value for key, value in {**successful_state, "ExecMainCode": "1"}.items()
         if key != "ExecMainCode"},
        {key: value for key, value in {**successful_state, "ExecMainCode": "1"}.items()
         if key != "ExecMainStatus"},
        {key: value for key, value in {**successful_state, "ExecMainCode": "1"}.items()
         if key != "ActiveState"},
        {key: value for key, value in {**successful_state, "ExecMainCode": "1"}.items()
         if key != "SubState"},
    )
    if any(successful_terminal_state(state) for state in rejected_terminal_states):
        fail("terminal success accepted non-success result, status, or terminal state")


def wait_path(phase, path, timeout=900):
    deadline = time.monotonic() + timeout
    while not path_exists(phase, "marker", path):
        if time.monotonic() >= deadline:
            fail(f"timed out waiting for {path}")
        time.sleep(0.1)


def validated_payload_marker(phase, path, expected_payload, resource_class="marker"):
    root = "/run/nmcp-ci"
    if (os.path.dirname(path) != root or os.path.basename(path) in ("", ".", "..")
            or not isinstance(expected_payload, bytes) or not expected_payload):
        fail("launch barrier marker path or payload was unsafe")
    directory = os_call(phase, "open", "directory", os.open, root,
                        os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    descriptor = None
    try:
        try:
            descriptor = os.open(os.path.basename(path),
                                 os.O_RDONLY | os.O_NONBLOCK | os.O_NOFOLLOW,
                                 dir_fd=directory)
        except FileNotFoundError:
            return False
        except OSError as error:
            raise evidence_failure(phase, "open", resource_class, error) from None
        before = os_call(phase, "stat", resource_class, os.fstat, descriptor)
        if (not stat.S_ISREG(before.st_mode) or before.st_uid != 0 or before.st_gid != 0
                or before.st_nlink != 1 or stat.S_IMODE(before.st_mode) != 0o600):
            fail("launch barrier marker has unsafe identity")
        payload = os_call(
            phase, "read", resource_class, os.read, descriptor, len(expected_payload) + 1)
        after = os_call(phase, "stat", resource_class, os.fstat, descriptor)
        current = os_call(phase, "stat", resource_class, os.stat, os.path.basename(path),
                          dir_fd=directory, follow_symlinks=False)
        identity = (before.st_dev, before.st_ino, before.st_mode, before.st_uid,
                    before.st_gid, before.st_nlink, before.st_size)
        if (identity != (after.st_dev, after.st_ino, after.st_mode, after.st_uid,
                         after.st_gid, after.st_nlink, after.st_size)
                or identity != (current.st_dev, current.st_ino, current.st_mode, current.st_uid,
                                 current.st_gid, current.st_nlink, current.st_size)
                or before.st_size != len(expected_payload)
                or payload != expected_payload):
            fail("launch barrier marker was malformed or replaced")
        return True
    finally:
        if descriptor is not None:
            os_call(phase, "close", resource_class, os.close, descriptor)
        os_call(phase, "close", "directory", os.close, directory)


def validated_marker(phase, path, nonce):
    return validated_payload_marker(phase, path, (nonce + "\n").encode("ascii"))


def persistent_launch_barriers(phase):
    names = os_call(phase, "listdir", "directory", os.listdir, "/run/nmcp-ci")
    prefix = "launch-"
    suffix = ".required"
    return tuple(sorted(
        barrier_name for barrier_name in names
        if barrier_name.startswith(prefix) and barrier_name.endswith(suffix)
        and len(barrier_name) == len(prefix) + 64 + len(suffix)
        and all(character in "0123456789abcdef"
                for character in barrier_name[len(prefix):-len(suffix)])))


def wait_persistent_launch_required(phase, baseline, timeout=10):
    deadline = time.monotonic() + timeout
    while True:
        candidates = tuple(
            name for name in persistent_launch_barriers(phase) if name not in baseline)
        if len(candidates) > 1:
            fail("multiple persistent launch barrier declarations appeared")
        if candidates:
            return candidates[0][len("launch-"):-len(".required")]
        if time.monotonic() >= deadline:
            fail("timed out awaiting persistent launch barrier declaration")
        time.sleep(0.05)


def persistent_launch_paths(nonce):
    if (type(nonce) is not str or len(nonce) != 64
            or any(character not in "0123456789abcdef" for character in nonce)):
        fail("persistent launch nonce was not canonical")
    base = "/run/nmcp-ci/launch-" + nonce
    return base + ".required", base + ".ready", base + ".release"


def wait_validated_marker(phase, path, nonce, timeout=10):
    deadline = time.monotonic() + timeout
    while not validated_marker(phase, path, nonce):
        if time.monotonic() >= deadline:
            fail("timed out awaiting validated launch barrier readiness")
        time.sleep(0.05)


def reset_signal_paths(phase, name):
    for suffix in ("ready", "release"):
        try:
            os.unlink(f"/run/nmcp-ci/{name}.{suffix}")
        except FileNotFoundError:
            pass
        except OSError as error:
            raise evidence_failure(phase, "unlink", "marker", error) from None


def reset_paths(phase, *paths):
    for path in paths:
        try:
            os.unlink(path)
        except FileNotFoundError:
            pass
        except OSError as error:
            raise evidence_failure(phase, "unlink", "marker", error) from None


def counter(phase, path):
    observed = False
    for _attempt in range(COUNTER_READ_ATTEMPTS):
        anchor = None
        descriptor = None
        primary_error = None
        cleanup_errors = []
        retry = False
        result = None
        try:
            anchor = os.open(path, os.O_PATH | os.O_NOFOLLOW)
        except FileNotFoundError:
            if not observed and _attempt == 0:
                return 0
            raise counter_failure(phase, "read", "rebound") from None
        except OSError:
            raise counter_failure(phase, "read", "io") from None
        observed = True
        try:
            try:
                identity = counter_identity(phase, os.fstat(anchor))
                descriptor = os.open(
                    f"/proc/self/fd/{anchor}", os.O_RDONLY | os.O_NONBLOCK)
                descriptor_identity = counter_identity(phase, os.fstat(descriptor))
            except OSError:
                raise counter_failure(phase, "read", "io") from None
            if descriptor_identity != identity:
                raise counter_failure(phase, "read", "rebound")
            payload = bytearray()
            while len(payload) <= COUNTER_BYTE_LIMIT:
                try:
                    chunk = os.read(descriptor, COUNTER_BYTE_LIMIT + 1 - len(payload))
                except OSError:
                    raise counter_failure(phase, "read", "io") from None
                if not chunk:
                    break
                payload.extend(chunk)
            try:
                after = os.fstat(descriptor)
            except OSError:
                raise counter_failure(phase, "read", "io") from None
            if counter_identity(phase, after) != identity:
                raise counter_failure(phase, "read", "rebound")
            value = parse_counter(phase, bytes(payload))
            try:
                current = os.stat(path, follow_symlinks=False)
            except FileNotFoundError:
                retry = True
            except OSError:
                raise counter_failure(phase, "read", "io") from None
            if not retry and counter_identity(phase, current) == identity:
                result = value
        except BaseException as error:
            primary_error = error
        finally:
            for opened in (descriptor, anchor):
                if opened is not None:
                    try:
                        os.close(opened)
                    except OSError:
                        cleanup_errors.append(counter_failure(phase, "read", "io"))
        if primary_error is not None:
            if cleanup_errors:
                raise aggregate_counter_failure(primary_error, cleanup_errors) from None
            raise primary_error
        if cleanup_errors:
            raise aggregate_counter_failure(None, cleanup_errors) from None
        if retry:
            continue
        if result is not None:
            return result
    raise counter_failure(phase, "read", "rebound")


def wait_counter(phase, path, expected, timeout=30):
    deadline = time.monotonic() + timeout
    while counter(phase, path) < expected:
        if time.monotonic() >= deadline:
            raise counter_failure(phase, "read", "timeout")
        time.sleep(0.02)


def release(phase, name):
    root = "/run/nmcp-ci"
    path = f"{root}/{name}.release"
    nonce = name[len("launch-"):] if name.startswith("launch-") else ""
    payload = ((nonce + "\n").encode("ascii")
               if len(nonce) == 64 and all(character in "0123456789abcdef" for character in nonce)
               else b"release\n")
    directory = os_call(phase, "open", "directory", os.open, root,
                        os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    descriptor = None
    try:
        try:
            descriptor = os.open(name + ".release",
                                 os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW,
                                 0o600, dir_fd=directory)
        except FileExistsError:
            os_call(phase, "close", "directory", os.close, directory)
            directory = None
            if not validated_payload_marker(phase, path, payload, "release"):
                fail("existing release disappeared during validation")
            return
        except OSError as error:
            raise evidence_failure(phase, "open", "release", error) from None
        written = 0
        while written < len(payload):
            count = os_call(phase, "write", "release", os.write,
                            descriptor, payload[written:])
            if count <= 0 or count > len(payload) - written:
                fail("short write while publishing release")
            written += count
        os_call(phase, "chmod", "release", os.fchmod, descriptor, 0o600)
        os_call(phase, "fsync", "release", os.fsync, descriptor)
        opened = os_call(phase, "stat", "release", os.fstat, descriptor)
        current = os_call(phase, "stat", "release", os.stat, name + ".release",
                          dir_fd=directory, follow_symlinks=False)
        identity = lambda value: (value.st_dev, value.st_ino, value.st_mode, value.st_uid,
                                  value.st_gid, value.st_nlink, value.st_size)
        if (not stat.S_ISREG(opened.st_mode) or opened.st_uid != 0 or opened.st_gid != 0
                or opened.st_nlink != 1 or stat.S_IMODE(opened.st_mode) != 0o600
                or identity(opened) != identity(current) or opened.st_size != len(payload)):
            fail("published release had unsafe identity")
        os_call(phase, "fsync", "directory", os.fsync, directory)
    finally:
        if descriptor is not None:
            os_call(phase, "close", "release", os.close, descriptor)
        if directory is not None:
            os_call(phase, "close", "directory", os.close, directory)
    if not validated_payload_marker(phase, path, payload, "release"):
        fail("published release disappeared before validation")


def wait_unit_absent(phase, timeout=30):
    deadline = time.monotonic() + timeout
    while show(phase, "LoadState").get("LoadState") != "not-found":
        if time.monotonic() >= deadline:
            fail("fixed unit did not unload during containment test")
        time.sleep(0.1)


def assert_client_lock_reusable():
    descriptor = os_call("transaction-lock", "open", "lock", os.open, "/run/nmcp-ci/client.lock",
                         os.O_RDWR | os.O_NOFOLLOW)
    try:
        if not try_nonblocking_flock(descriptor, "transaction-lock", "lock"):
            fail("client lock was not reusable after client exit")
    finally:
        os_call("transaction-lock", "close", "lock", os.close, descriptor)


def assert_client_lock_held():
    descriptor = os_call("transaction-lock", "open", "lock", os.open, "/run/nmcp-ci/client.lock",
                         os.O_RDWR | os.O_NOFOLLOW)
    try:
        if not try_nonblocking_flock(descriptor, "transaction-lock", "lock"):
            return
        fail("client released its lock before proving owned unload")
    finally:
        os_call("transaction-lock", "close", "lock", os.close, descriptor)


def assert_transaction_lock_held():
    descriptor = open_transaction_lock()
    try:
        if not lock_transaction(descriptor):
            return
        fail("supervisor released its transaction lock before launch attestation")
    finally:
        close_transaction_lock(descriptor)


def assert_transaction_lock_reusable():
    descriptor = open_transaction_lock()
    try:
        if not lock_transaction(descriptor):
            fail("transaction lock was not reusable after producer exit")
    finally:
        close_transaction_lock(descriptor)


def assert_client_failure(result, mode, phase):
    if result.returncode == 0 or SUCCESS in result.stdout:
        fail(f"client fault unexpectedly succeeded or emitted canonical success: {mode}")
    state = show(phase, "LoadState", "ControlGroup")
    if state.get("LoadState") != "not-found":
        fail(f"client fault left the fixed unit loaded: {mode}: {sanitized_state(state)}")
    if cgroup_pids(state.get("ControlGroup", ""), phase):
        fail(f"client fault left control-group processes: {mode}: {sanitized_state(state)}")
    if cgroup_pids("/system.slice/" + UNIT, phase):
        fail(f"client fault left processes in the fixed unit cgroup: {mode}")
    assert_client_lock_reusable()


def expected_signal_result(mode, signum):
    boundary = mode.rsplit("-", 1)[1]
    if boundary in ("startup", "work"):
        primary = "cancelled"
        events = ()
        human = f"verification client cancelled by signal {signum}"
    elif boundary in ("kill", "stop", "wait", "reset", "unload"):
        primary = "cleanup-test"
        events = ((0, "final", "cancelled", 0, 0, 0),)
        stage = "before cleanup boundary test" if boundary in ("kill", "wait") else "at terminal cleanup boundary test"
        human = (f"injected client failure {stage}; cleanup failed: "
                 f"verification client cancelled by signal {signum}")
    else:
        fail("client signal result used an unknown lifecycle boundary")
    return ({
        "primary": primary, "events": events, "events_complete": 1,
        "final_scanned": 1, "final_observed": 1, "final_empty": 1,
        "return": 1, "stdout": 0, "success": 0,
    }, human)


def signal_result_contract(result, mode, signum):
    parsed, shape = client_stderr_evidence(result.stderr)
    expected, human = expected_signal_result(mode, signum)
    lines = result.stderr.splitlines(keepends=True) if type(result.stderr) is str else []
    return bool(
        result.returncode == 1 and result.stdout == "" and SUCCESS not in result.stdout
        and shape["shape"] and parsed == expected and len(lines) == 2
        and lines[1] == "verification-client: " + human + "\n")


def assert_cancelled_result(result, mode, signum):
    assert_client_failure(result, mode, "signal-cleanup")
    if not signal_result_contract(result, mode, signum):
        fail(f"client signal result did not match its exact lifecycle schema: {mode}")


def fast_recovery(client, repo, commit, go_binary, context, phase):
    recovered = run(phase, ("/usr/bin/python3", "-I", "-S", client, repo, commit, go_binary,
                     "fast-success"), stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    if recovered.returncode or recovered.stdout.count(SUCCESS) != 1:
        fail(f"fast clean recovery failed after {context} with status {recovered.returncode}; "
             f"success_count={recovered.stdout.count(SUCCESS)}")
    wait_unit_absent(phase)
    assert_client_lock_reusable()


def fault_paths(mode, boundary):
    prefix = f"/run/nmcp-ci/{mode}.{boundary}"
    return prefix + ".intercepted", prefix + ".attempted"


def assert_interception(mode, boundary, phase, *, persistent=False):
    intercepted, attempted = fault_paths(mode, boundary)
    minimum = 4 if persistent and boundary in ("show", "wait", "unload") else 2 if persistent else 1
    if counter(phase, intercepted) < minimum:
        fail(f"command path was not intercepted as required: {mode}")
    attempts = counter(phase, attempted)
    if persistent and attempts:
        fail(f"persistent interception reached the real command path: {mode}: {attempts}")
    if not persistent and attempts < 1:
        fail(f"transient interception did not retry the real command path: {mode}")


def cleanup_fixture_invocation(invocation, phase):
    state = show(phase, "InvocationID", "ActiveState", "ControlGroup")
    if state["LoadState"] == "not-found":
        return
    if state.get("InvocationID") != invocation:
        fail("persistent-fault cleanup refused a different invocation: "
             + sanitized_state(state))
    run(phase, ("/usr/bin/systemctl", "stop", UNIT),
        check=False, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    deadline = time.monotonic() + 20
    while True:
        state = show(phase, "InvocationID", "ActiveState")
        if state["LoadState"] == "not-found":
            return
        if state.get("InvocationID") != invocation:
            fail("persistent-fault cleanup observed name reuse: " + sanitized_state(state))
        if state.get("ActiveState") in ("failed", "inactive"):
            break
        if time.monotonic() >= deadline:
            fail("persistent-fault invocation did not terminate: " + sanitized_state(state))
        time.sleep(0.1)
    run(phase, ("/usr/bin/systemctl", "reset-failed", UNIT), check=True,
        stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    wait_unit_absent(phase)


def unique_json_object(pairs):
    value = {}
    for key, item in pairs:
        if key in value:
            fail("duplicate key in structured command property")
        value[key] = item
    return value


def parse_structured_command(result, property_name):
    if result.returncode:
        fail(f"busctl {property_name} failed with status {result.returncode}")
    try:
        payload = json.loads(result.stdout, object_pairs_hook=unique_json_object)
    except (TypeError, ValueError):
        fail(f"busctl {property_name} returned malformed JSON")
    expected_type = "a(sasbttttuii)" if property_name == "ExecStart" else "a(sasasttttuii)"
    if (type(payload) is not dict or set(payload) != {"type", "data"}
            or payload.get("type") != expected_type
            or type(payload.get("data")) is not list or len(payload["data"]) != 1):
        fail(f"busctl {property_name} returned an unexpected exact property shape")
    record = payload["data"][0]
    if type(record) is not list or len(record) != 10:
        fail(f"busctl {property_name} did not return exactly one complete command tuple")
    path, argv, behavior, *runtime = record
    strings = [path, *(argv if type(argv) is list else [])]
    if (type(path) is not str or not path.startswith("/") or type(argv) is not list
            or not argv or any(type(item) is not str for item in argv)
            or argv[0] != path or any(not item or any(not character.isprintable()
                                                     for character in item)
                                     for item in strings)):
        fail(f"busctl {property_name} returned an invalid exact path or argv")
    if ((property_name == "ExecStart" and type(behavior) is not bool)
            or (property_name == "ExecStartEx"
                and (type(behavior) is not list
                     or any(type(flag) is not str for flag in behavior)))):
        fail(f"busctl {property_name} returned an invalid behavior field")
    if behavior not in (False, []):
        fail(f"busctl {property_name} enabled unsupported ignore-failure or command flags")
    if (any(type(value) is not int for value in runtime)
            or any(value < 0 or value > 2 ** 64 - 1 for value in runtime[:4])
            or runtime[4] < 0 or runtime[4] > 2 ** 32 - 1
            or any(value < -(2 ** 31) or value > 2 ** 31 - 1 for value in runtime[5:])):
        fail(f"busctl {property_name} returned invalid runtime metadata")
    return {"path": path, "argv": tuple(argv)}


def structured_command_identity(exec_start_result, exec_start_ex_result):
    command = parse_structured_command(exec_start_result, "ExecStart")
    extended = parse_structured_command(exec_start_ex_result, "ExecStartEx")
    if command != extended:
        fail("structured ExecStart and ExecStartEx command identities disagree")
    return command


def launch_identity_signature(invocation, description, environment, path, argv):
    return {
        "InvocationID": invocation, "Description": description, "Environment": environment,
        "Command": {"path": path, "argv": tuple(argv)}, **SERVICE_PROPERTIES,
    }


def launch_identity_matches(state, signature):
    expected_keys = {"InvocationID", "Description", "Environment", "Command",
                     *SERVICE_PROPERTIES}
    return (set(signature) == expected_keys and state.get("LoadState") == "loaded"
            and all(state.get(name) == expected for name, expected in signature.items()))


def persistent_handoff_state_accepted(boundary, state, signature, recorded_cgroup_pids):
    loaded_exact = (state.get("LoadState") == "loaded"
                    and launch_identity_matches(state, signature))
    unloaded_after_reset = (boundary == "unload" and state.get("LoadState") == "not-found"
                              and not recorded_cgroup_pids)
    return loaded_exact or unloaded_after_reset


def stale_identity_evidence(state, signature, expected_main_pid, control_group_pids):
    evidence = {
        "signature_unchanged": launch_identity_matches(state, signature),
        "terminal_unchanged": (
            state.get("ActiveState") == "failed" and state.get("SubState") == "failed"
            and state.get("Result") == "exit-code"
            and state.get("ExecMainCode") in ("1", "exited")
            and state.get("ExecMainStatus") == "73"),
        "pid_unchanged": state.get("ExecMainPID") == expected_main_pid,
        "cgroup_empty": not control_group_pids,
    }
    evidence["identity_unchanged"] = all(evidence.values())
    return evidence


def stale_terminal_matches(state, signature, expected_main_pid, control_group_pids):
    return stale_identity_evidence(
        state, signature, expected_main_pid, control_group_pids)["identity_unchanged"]


def structured_command_fixture_result(property_name, path, argv, behavior, runtime):
    property_type = "a(sasbttttuii)" if property_name == "ExecStart" else "a(sasasttttuii)"
    payload = {"type": property_type, "data": [[path, list(argv), behavior, *runtime]]}
    return subprocess.CompletedProcess(("busctl", property_name), 0, json.dumps(payload), "")


def assert_launch_identity_contract():
    path = "/usr/bin/env"
    argv = (path, "-i", "KEY=value", "/opt/nmcp/helper", "--mode", "exact")
    active_runtime = (100, 10, 0, 0, 1234, 0, 0)
    terminal_runtime = (100, 10, 200, 20, 1234, 1, 73)
    active_command = structured_command_identity(
        structured_command_fixture_result("ExecStart", path, argv, False, active_runtime),
        structured_command_fixture_result("ExecStartEx", path, argv, [], active_runtime))
    terminal_command = structured_command_identity(
        structured_command_fixture_result("ExecStart", path, argv, False, terminal_runtime),
        structured_command_fixture_result("ExecStartEx", path, argv, [], terminal_runtime))
    signature = launch_identity_signature("a" * 32, "exact fixture", "KEY=value", path, argv)
    active = {"LoadState": "loaded", "Command": active_command,
              "InvocationID": "a" * 32, "Description": "exact fixture",
              "Environment": "KEY=value", **SERVICE_PROPERTIES}
    terminal = {**active, "Command": terminal_command, "ActiveState": "failed",
                "SubState": "failed", "Result": "exit-code", "ExecMainCode": "1",
                "ExecMainStatus": "73", "ExecMainPID": "1234"}
    if (not launch_identity_matches(active, signature)
            or not stale_terminal_matches(terminal, signature, "1234", [])):
        fail("launch identity rejected valid mutable runtime metadata transition")
    changed_commands = (
        {"path": "/bin/false", "argv": argv},
        {"path": path, "argv": ("/bin/false", *argv[1:])},
        {"path": path, "argv": (*argv[:-1], "wrong")},
        {"path": path, "argv": (*argv[:-2], argv[-1], argv[-2])},
        {"path": path, "argv": argv[:-1]},
        {"path": path, "argv": (*argv, "extra")},
    )
    for command in changed_commands:
        if launch_identity_matches({**terminal, "Command": command}, signature):
            fail("launch identity accepted changed path, argv value, order, or count")
    changed_states = (
        {**terminal, "InvocationID": "b" * 32},
        {**terminal, "Environment": "KEY=wrong"},
        {**terminal, "ActiveState": "inactive"},
        {**terminal, "Result": "success"},
        {**terminal, "ExecMainStatus": "0"},
    )
    if any(stale_terminal_matches(state, signature, "1234", []) for state in changed_states):
        fail("terminal phase accepted changed identity or terminal status")
    if (stale_terminal_matches({**terminal, "ExecMainPID": "999"}, signature, "1234", [])
            or stale_terminal_matches(terminal, signature, "1234", [1234])):
        fail("terminal phase accepted cgroup residue")
    rejected_results = (
        subprocess.CompletedProcess(("busctl",), 1, "", "structured query failed"),
        subprocess.CompletedProcess(("busctl",), 0, '{"type":"x","type":"y","data":[]}', ""),
        subprocess.CompletedProcess(("busctl",), 0, '{"type":"x","data":[]} trailing', ""),
        subprocess.CompletedProcess(("busctl",), 0, '{"type":"x\\q","data":[]}', ""),
        subprocess.CompletedProcess(("busctl",), 0, '[]', ""),
        subprocess.CompletedProcess(("busctl",), 0,
                                    json.dumps({"type": "a(sasbttttuii)", "data": []}), ""),
        subprocess.CompletedProcess(("busctl",), 0,
                                    json.dumps({"type": "a(sasbttttuii)",
                                                "data": [[path, list(argv), False,
                                                          *active_runtime],
                                                         [path, list(argv), False,
                                                          *active_runtime]]}), ""),
        subprocess.CompletedProcess(("busctl",), 0,
                                    json.dumps({"type": "a(sasbttttuii)",
                                                "data": [[path, list(argv), False]]}), ""),
        structured_command_fixture_result("ExecStart", "relative", argv, False, active_runtime),
        structured_command_fixture_result("ExecStart", path, ("/bin/false", *argv[1:]),
                                          False, active_runtime),
        structured_command_fixture_result("ExecStart", path, (path, "bad\narg"), False,
                                          active_runtime),
        structured_command_fixture_result("ExecStart", path, (path, "bad\u0085arg"), False,
                                          active_runtime),
        structured_command_fixture_result("ExecStart", path, argv, False,
                                          (2 ** 64, *active_runtime[1:])),
        structured_command_fixture_result("ExecStart", path, argv, False,
                                          (*active_runtime[:4], 2 ** 32,
                                           *active_runtime[5:])),
        structured_command_fixture_result("ExecStart", path, argv, False,
                                          (*active_runtime[:5], 2 ** 31,
                                           active_runtime[6])),
        structured_command_fixture_result("ExecStart", path, argv, True, active_runtime),
        structured_command_fixture_result("ExecStartEx", path, argv, ["ignore-failure"],
                                          active_runtime),
    )
    for result in rejected_results:
        property_name = "ExecStartEx" if "ExecStartEx" in result.args else "ExecStart"
        try:
            parse_structured_command(result, property_name)
        except RuntimeError:
            continue
        fail("structured command parser accepted malformed, multiple, or unsafe command data")
    disagreement = structured_command_fixture_result(
        "ExecStartEx", path, (*argv[:-1], "wrong"), [], terminal_runtime)
    try:
        structured_command_identity(
            structured_command_fixture_result("ExecStart", path, argv, False, terminal_runtime),
            disagreement)
    except RuntimeError:
        return
    fail("structured ExecStartEx disagreement was accepted")


def assert_persistent_handoff_contract():
    path = "/usr/bin/env"
    argv = (path, "-i", "KEY=value", "/opt/nmcp/helper", "--mode", "exact")
    signature = launch_identity_signature("a" * 32, "exact fixture", "KEY=value", path, argv)
    loaded = {
        "LoadState": "loaded", "InvocationID": "a" * 32,
        "Description": "exact fixture", "Environment": "KEY=value",
        "Command": {"path": path, "argv": argv}, **SERVICE_PROPERTIES,
    }
    absent = {"LoadState": "not-found"}
    if (not persistent_handoff_state_accepted("unload", absent, signature, [])
            or not persistent_handoff_state_accepted("unload", loaded, signature, [])):
        fail("persistent unload handoff rejected explicit absence or exact retained identity")
    rejected = (
        ("reset", absent, []),
        ("unload", {**loaded, "InvocationID": "b" * 32}, []),
        ("unload", absent, [1234]),
    )
    if any(persistent_handoff_state_accepted(boundary, state, signature, pids)
           for boundary, state, pids in rejected):
        fail("persistent handoff accepted wrong boundary, identity, or recorded cgroup residue")


def persistent_supervisor_mode(mode):
    boundary = mode.rsplit("-", 1)[1]
    if boundary in ("kill", "wait"):
        return "fast-hold"
    if boundary == "stop":
        return "fast-success"
    return "fast-fail"


def persistent_launch_signature(state, repo, commit, go_binary, mode):
    environment = state.get("Environment", "")
    prefix = NONCE_VARIABLE + "="
    nonce = environment[len(prefix):] if environment.startswith(prefix) else ""
    if (len(nonce) != 64
            or any(character not in "0123456789abcdef" for character in nonce)
            or environment != prefix + nonce):
        fail(f"persistent-fault fixture has invalid exact nonce environment: {mode}: "
             f"{sanitized_state(state)}")
    supervisor_argv = ("/usr/bin/python3", "-I", "-S", PROGRAM,
                       os.path.abspath(os.path.join("/", repo)), commit, go_binary, nonce,
                       persistent_supervisor_mode(mode),
                       "--persistent-launch-required=/run/nmcp-ci/launch-" + nonce + ".required")
    expected_argv = ("/usr/bin/env", "-i", "PATH=/usr/bin:/bin:/usr/sbin:/sbin",
                     "LC_ALL=C", "LANG=C", "HOME=/root", prefix + nonce,
                     *supervisor_argv)
    invocation = state.get("InvocationID", "")
    valid_invocation = (len(invocation) == 32
                        and all(character in "0123456789abcdef" for character in invocation))
    signature = launch_identity_signature(invocation, DESCRIPTION_PREFIX + nonce, prefix + nonce,
                                          "/usr/bin/env", expected_argv)
    if not valid_invocation or not launch_identity_matches(state, signature):
        fail(f"persistent-fault fixture lacks exact launch signature: {mode}: "
             f"{sanitized_state(state)}")
    return signature


def assert_launch_signature_counterexamples(state, repo, commit, go_binary, mode):
    argv = state["Command"]["argv"]
    required = "--persistent-launch-required=/run/nmcp-ci/launch-"
    marker_index = -1
    index = 0
    for argument in argv:
        if argument[:len(required)] == required:
            marker_index = index
        index += 1
    if marker_index != len(argv) - 1:
        fail("persistent launch required marker was not the final argument")
    mutations = {
        "description": ("Description", "wrong verifier description"),
        "environment": ("Environment", f"{NONCE_VARIABLE}={'0' * 64}"),
        "exec-start": ("Command", {"path": "/usr/bin/env",
                                      "argv": tuple("/bin/false" if item == PROGRAM else item
                                                    for item in argv)}),
        "required-marker-omitted": ("Command", {"path": "/usr/bin/env",
                                                   "argv": argv[:-1]}),
        "required-marker-wrong": ("Command", {"path": "/usr/bin/env",
                                                 "argv": (*argv[:-1], required + "0" * 64
                                                          + ".required")}),
        "required-marker-reordered": ("Command", {"path": "/usr/bin/env",
                                                     "argv": (*argv[:-2], argv[-1], argv[-2])}),
        "fixed-property": ("KillMode", "process"),
    }
    for label, (property_name, replacement) in mutations.items():
        changed = dict(state)
        changed[property_name] = replacement
        try:
            persistent_launch_signature(changed, repo, commit, go_binary, mode)
        except RuntimeError:
            continue
        fail(f"persistent launch signature accepted mismatched {label}")


def signed_launch_state(signature, phase):
    return signed_launch_state_until(signature, phase, time.monotonic() + 10)


def cleanup_signed_launch(signature, phase):
    deadline = time.monotonic() + 20
    state = signed_launch_state_until(signature, phase, deadline)
    if state["LoadState"] == "not-found":
        return
    state = signed_launch_state_until(signature, phase, deadline)
    if state["LoadState"] == "not-found":
        return
    timeout = bounded_cleanup_timeout(deadline - time.monotonic(), 20)
    stopped = run(phase, ("/usr/bin/systemctl", "stop", UNIT), check=False,
                  stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=timeout)
    if stopped.returncode:
        fail(f"persistent-fault stop failed with status {stopped.returncode}")
    while True:
        state = signed_launch_state_until(signature, phase, deadline)
        if state["LoadState"] == "not-found":
            return
        if state.get("ActiveState") in ("failed", "inactive"):
            break
        if time.monotonic() >= deadline:
            fail("persistent-fault signed launch did not terminate: " + sanitized_state(state))
        time.sleep(0.1)
    deadline = time.monotonic() + 30
    state = signed_launch_state_until(signature, phase, deadline)
    if state["LoadState"] == "not-found":
        return
    timeout = bounded_cleanup_timeout(deadline - time.monotonic(), 5)
    run(phase, ("/usr/bin/systemctl", "reset-failed", UNIT), check=True,
        stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=timeout)
    while True:
        state = signed_launch_state_until(signature, phase, deadline)
        if state["LoadState"] == "not-found":
            return
        if time.monotonic() >= deadline:
            fail("persistent-fault signed launch did not unload")
        time.sleep(0.1)


def cleanup_signed_launch_if_owned(lock_held, signature, state, phase, cleanup):
    if state.get("LoadState") != "loaded" or not lock_held:
        return False
    if signature is None:
        raise RuntimeError("loaded post-exit unit lacks an attested launch signature")
    cleanup(signature, phase)
    return True


def bounded_cleanup_timeout(remaining, cap):
    if remaining <= 0 or cap <= 0:
        fail("stale cleanup deadline exhausted")
    return min(remaining, cap)


def assert_cleanup_deadline_contract():
    cases = ((7, 3, 3), (2, 5, 2), (0.000001, 20, 0.000001), (90, 18 * 60, 90))
    if any(bounded_cleanup_timeout(remaining, cap) != expected
           for remaining, cap, expected in cases):
        fail("stale cleanup timeout capping changed")
    for remaining, cap in ((0, 1), (-1, 1), (1, 0)):
        try:
            bounded_cleanup_timeout(remaining, cap)
        except RuntimeError:
            continue
        fail("stale cleanup accepted a nonpositive remaining budget")


def show_until(phase, deadline, *properties):
    requested = tuple(dict.fromkeys(("LoadState", *properties)))
    errors = []
    for attempt in range(4):
        try:
            timeout = bounded_cleanup_timeout(deadline - time.monotonic(), 1)
            result = run(phase, ("/usr/bin/systemctl", "show", UNIT,
                          *(f"--property={item}" for item in requested)), check=False,
                         stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=timeout)
            return parse_unit_properties(result, requested)
        except (OSError, subprocess.SubprocessError, RuntimeError) as error:
            errors.append(error)
            if attempt < 3:
                delay = bounded_cleanup_timeout(deadline - time.monotonic(),
                                                  0.05 * (2 ** attempt))
                time.sleep(delay)
    fail("bounded stale unit properties remain unknown: "
         + "; ".join(sanitized_diagnostic_text(error) for error in errors))


def read_structured_command_until(phase, deadline):
    results = []
    for property_name in ("ExecStart", "ExecStartEx"):
        timeout = bounded_cleanup_timeout(deadline - time.monotonic(), 1)
        results.append(run(phase, ("/usr/bin/busctl", "--system", "--json=short", "get-property",
                            "org.freedesktop.systemd1", SYSTEMD_UNIT_OBJECT,
                            "org.freedesktop.systemd1.Service", property_name), check=False,
                           stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=timeout))
    return structured_command_identity(*results)


def show_identity_until(phase, deadline, *properties):
    state = show_until(phase, deadline, *IDENTITY_PROPERTIES, *properties)
    if state.get("LoadState") == "loaded":
        state["Command"] = read_structured_command_until(phase, deadline)
    return state


def signed_launch_state_until(signature, phase, deadline):
    state = show_identity_until(phase, deadline, "ActiveState", "ControlGroup")
    if state.get("LoadState") == "not-found":
        return state
    if not launch_identity_matches(state, signature):
        fail("bounded stale launch signature changed; refusing name action: "
             + sanitized_state(state))
    return state


def cleanup_signed_launch_until(signature, phase, deadline):
    state = signed_launch_state_until(signature, phase, deadline)
    if state["LoadState"] == "not-found":
        return
    timeout = bounded_cleanup_timeout(deadline - time.monotonic(), 20)
    stopped = run(phase, ("/usr/bin/systemctl", "stop", UNIT), check=False,
                  stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=timeout)
    if stopped.returncode:
        fail(f"bounded stale stop failed with status {stopped.returncode}")
    while True:
        state = signed_launch_state_until(signature, phase, deadline)
        if state["LoadState"] == "not-found":
            return
        if state.get("ActiveState") in ("failed", "inactive"):
            break
        delay = bounded_cleanup_timeout(deadline - time.monotonic(), 0.1)
        time.sleep(delay)
    state = signed_launch_state_until(signature, phase, deadline)
    if state["LoadState"] == "not-found":
        return
    timeout = bounded_cleanup_timeout(deadline - time.monotonic(), 5)
    reset = run(phase, ("/usr/bin/systemctl", "reset-failed", UNIT), check=False,
                stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=timeout)
    if reset.returncode:
        fail(f"bounded stale reset failed with status {reset.returncode}")
    while True:
        state = signed_launch_state_until(signature, phase, deadline)
        if state["LoadState"] == "not-found":
            return
        delay = bounded_cleanup_timeout(deadline - time.monotonic(), 0.1)
        time.sleep(delay)


def pid_exists(pid, phase):
    try:
        os.kill(pid, 0)
        return True
    except ProcessLookupError:
        return False
    except OSError as error:
        raise evidence_failure(phase, "kill", "process", error) from None


def cgroup_pids(control_group, phase):
    if not control_group:
        return []
    root = "/sys/fs/cgroup" + control_group
    previous = None
    root_anchor = None
    topology_anchor = None
    previous_absent = False
    residue_seen = False
    for _attempt in range(CGROUP_SNAPSHOT_ATTEMPTS):
        try:
            root_stat = cgroup_stat(phase, root)
            previous_absent = False
            if not stat.S_ISDIR(root_stat.st_mode):
                fail("unit control group is not a directory")
            root_identity = (root_stat.st_dev, root_stat.st_ino)
            if root_anchor is None:
                root_anchor = root_identity
            elif root_identity != root_anchor:
                raise evidence_failure(
                    phase, "stat", "evidence", OSError(errno.ESTALE, "reused"))
            found = []
            identities = []

            for directory, directories, files in cgroup_walk(phase, root):
                directory_stat = cgroup_stat(phase, directory)
                if not stat.S_ISDIR(directory_stat.st_mode):
                    fail("unit control group traversal changed type")
                relative = os.path.relpath(directory, root)
                identities.append((relative, directory, directory_stat.st_dev, directory_stat.st_ino))
                kept = []
                for name in directories:
                    child = os.path.join(directory, name)
                    child_stat = cgroup_stat(phase, child)
                    if stat.S_ISDIR(child_stat.st_mode):
                        kept.append(name)
                directories[:] = kept
                if "cgroup.procs" in files:
                    path = os.path.join(directory, "cgroup.procs")
                    source = cgroup_open(phase, path)
                    try:
                        before = cgroup_fstat(phase, source)
                        values = cgroup_read(phase, source).split()
                        after = cgroup_fstat(phase, source)
                    finally:
                        cgroup_close(phase, source)
                    if (before.st_dev, before.st_ino) != (after.st_dev, after.st_ino):
                        raise evidence_failure(
                            phase, "stat", "evidence", OSError(errno.ESTALE, "reused"))
                    parsed = [int(value) for value in values]
                    found.extend(parsed)
                    residue_seen = residue_seen or bool(parsed)
            after_root = cgroup_stat(phase, root)
            if not stat.S_ISDIR(after_root.st_mode):
                fail("unit control group changed type")
            if (after_root.st_dev, after_root.st_ino) != root_anchor:
                raise evidence_failure(
                    phase, "stat", "evidence", OSError(errno.ESTALE, "reused"))
            canonical = tuple(sorted((relative, device, inode)
                                     for relative, _directory, device, inode in identities))
            if topology_anchor is None:
                topology_anchor = canonical
            elif canonical != topology_anchor:
                raise evidence_failure(
                    phase, "stat", "evidence", OSError(errno.ESTALE, "topology changed"))
            for _relative, directory, device, inode in identities:
                current = cgroup_stat(phase, directory)
                if not stat.S_ISDIR(current.st_mode):
                    fail("unit control group traversal changed type")
                if (current.st_dev, current.st_ino) != (device, inode):
                    raise evidence_failure(
                        phase, "stat", "evidence", OSError(errno.ESTALE, "reused"))
            snapshot = (root_identity, canonical, tuple(sorted(set(found))))
        except FileNotFoundError:
            try:
                rechecked = cgroup_stat(phase, root)
            except FileNotFoundError:
                previous = None
                if not residue_seen and previous_absent:
                    return []
                previous_absent = True
                continue
            except OSError as error:
                raise evidence_failure(phase, "stat", "cgroup", error) from None
            if not stat.S_ISDIR(rechecked.st_mode):
                fail("unit control group changed type")
            if root_anchor is not None and (rechecked.st_dev, rechecked.st_ino) != root_anchor:
                raise evidence_failure(
                    phase, "stat", "evidence", OSError(errno.ESTALE, "reused"))
            previous = None
            previous_absent = False
            continue
        except ValueError:
            fail("unit control group contained malformed process evidence")
        if snapshot == previous and (not residue_seen or bool(snapshot[2])):
            return list(snapshot[2])
        previous = snapshot
    raise evidence_failure(phase, "walk", "evidence", OSError(errno.EAGAIN, "unstable"))


def process_has_inode(pid, expected, phase):
    try:
        names = os.listdir(f"/proc/{pid}/fd")
    except FileNotFoundError:
        return False
    except OSError as error:
        raise evidence_failure(phase, "listdir", "pid", error) from None
    for name in names:
        try:
            value = os.stat(f"/proc/{pid}/fd/{name}")
        except FileNotFoundError:
            continue
        except OSError as error:
            raise evidence_failure(phase, "stat", "pid", error) from None
        if (value.st_dev, value.st_ino) == expected:
            return True
    return False


def assert_keeper_lock_coherent(keeper_pid, expected):
    if not pid_exists(keeper_pid, "service-death"):
        return
    lock = open_transaction_lock()
    try:
        if (lock_transaction(lock)
                and process_has_inode(keeper_pid, expected, "service-death")):
            fail("live matching in-cgroup lock keeper released the transaction lock")
    finally:
        close_transaction_lock(lock)


def intent_entry(document, path):
    matches = [entry for entry in document["entries"] if entry["path"] == path]
    if len(matches) != 1:
        fail(f"cleanup intent does not identify exactly one target: {path}")
    return matches[0]


def run_root_entry(document):
    entries = document["entries"]
    matches = [entry for entry in entries if entry["path"].startswith("/run/nmcp-ci/transaction-")]
    if len(matches) != 1:
        fail("cleanup intent does not identify exactly one transaction root")
    return matches[0]


def observable_identity(path, recorded):
    try:
        value = os.lstat(path)
    except FileNotFoundError:
        return recorded
    except OSError as error:
        raise evidence_failure("intent-window", "stat", "evidence", error) from None
    return {"dev": value.st_dev, "ino": value.st_ino}


def assert_replaced_or_absent(path, identity):
    if identity is None:
        return
    try:
        current = os.lstat(path)
    except FileNotFoundError:
        return
    except OSError as error:
        raise evidence_failure("intent-window", "stat", "evidence", error) from None
    if (current.st_dev, current.st_ino) == (identity["dev"], identity["ino"]):
        fail(f"prior cleanup-intent inode survived recovery: {path}")


def intent_launch_signature(state, repo, commit, go_binary, mode, nonce=None):
    environment = state.get("Environment", "")
    prefix = NONCE_VARIABLE + "="
    observed_nonce = environment[len(prefix):] if environment.startswith(prefix) else ""
    if nonce is not None and observed_nonce != nonce:
        fail("intent producer nonce changed between ready and unit state")
    if (len(observed_nonce) != 64
            or any(character not in "0123456789abcdef" for character in observed_nonce)
            or environment != prefix + observed_nonce):
        fail("intent producer environment was not one exact nonce")
    supervisor_argv = ("/usr/bin/python3", "-I", "-S", PROGRAM,
                       os.path.abspath(os.path.join("/", repo)), commit, go_binary,
                       observed_nonce, mode)
    expected_argv = ("/usr/bin/env", "-i", "PATH=/usr/bin:/bin:/usr/sbin:/sbin",
                     "LC_ALL=C", "LANG=C", "HOME=/root", prefix + observed_nonce,
                     *supervisor_argv)
    invocation = state.get("InvocationID", "")
    signature = launch_identity_signature(
        invocation, DESCRIPTION_PREFIX + observed_nonce, environment,
        "/usr/bin/env", expected_argv)
    if (len(invocation) != 32
            or any(character not in "0123456789abcdef" for character in invocation)
            or not launch_identity_matches(state, signature)):
        fail("intent producer lacked its exact nonce, argv, mode, and fixed-unit identity")
    return observed_nonce, signature


def producer_unit_evidence(repo, commit, go_binary, mode, deadline):
    state = show_identity_until(
        "intent-window", deadline, "ActiveState", "SubState", "MainPID", "Result",
        "ControlGroup")
    if state.get("LoadState") == "not-found":
        return state, None, None
    try:
        nonce, signature = intent_launch_signature(
            state, repo, commit, go_binary, mode)
    except RuntimeError:
        return state, None, None
    return state, nonce, signature


def exact_failed_producer_result(process, stdout, stderr):
    parsed, shape = client_stderr_evidence(stderr)
    return bool(
        type(process.returncode) is int and process.returncode == 1
        and type(stdout) is str and stdout == "" and SUCCESS not in stdout
        and shape["shape"] and parsed is not None
        and parsed["primary"] != "none"
        and parsed["return"] == 1 and parsed["stdout"] == 0 and parsed["success"] == 0
        and parsed["events_complete"] == 1 and parsed["final_scanned"] == 1
        and parsed["final_observed"] == 1 and parsed["final_empty"] == 1)


def communicate_producer_once(process, lifecycle, timeout):
    if lifecycle["communicated"]:
        return lifecycle["stdout"], lifecycle["stderr"]
    lifecycle["communicated"] = True
    stdout, stderr = process_communicate("intent-window", process, timeout)
    lifecycle["stdout"], lifecycle["stderr"] = stdout, stderr
    lifecycle["reaped"] = process.poll() is not None
    lifecycle["result_exact"] = exact_failed_producer_result(process, stdout, stderr)
    return stdout, stderr


def intent_journal_evidence(stage, expected_target, nonce):
    try:
        descriptor = os.open(
            "/run/nmcp-ci/cleanup-intent.json", os.O_RDONLY | os.O_NOFOLLOW)
    except FileNotFoundError:
        return "absent"
    except OSError:
        return "unknown"
    try:
        observed = os.fstat(descriptor)
        _raw, document = read_anchored_json(descriptor, observed, "cleanup-intent")
        epoch = document.get("epoch")
        target = epoch.get("target") if type(epoch) is dict else None
        target_matches = (type(target) is str and (
            target.startswith("/run/nmcp-ci/transaction-")
            if expected_target == "run-root" else target == expected_target))
        if (set(document) == {"version", "epoch", "entries"}
                and document.get("version") == 2 and type(epoch) is dict
                and set(epoch) == {"nonce", "stage", "target"}
                and epoch.get("nonce") == nonce and epoch.get("stage") == stage
                and target_matches):
            return "signed"
        return "unsigned"
    except BaseException:
        return "unknown"
    finally:
        try:
            os.close(descriptor)
        except OSError:
            pass


def producer_wait_evidence(process, stage, expected_target, prior, repo, commit, go_binary, mode,
                           deadline, lifecycle):
    state = {"LoadState": "not-found"}
    nonce = None
    signature = None
    recorded_cgroup = ""
    while True:
        observation_deadline = min(deadline, time.monotonic() + 2)
        try:
            state, observed_nonce, observed_signature = producer_unit_evidence(
                repo, commit, go_binary, mode, observation_deadline)
            if observed_signature is not None:
                nonce, signature = observed_nonce, observed_signature
                recorded_cgroup = state.get("ControlGroup", "") or recorded_cgroup
        except BaseException:
            pass
        ready_present = path_exists(
            "intent-window", "marker", "/run/nmcp-ci/cleanup-intent.ready")
        if ready_present:
            anchor = open_intent_epoch(
                stage, expected_target, prior, repo, commit, go_binary, mode)
            anchor["recorded_cgroup"] = anchor["state"].get("ControlGroup", "")
            return anchor, {"state": anchor["state"], "nonce": anchor["nonce"],
                            "signature": anchor["signature"],
                            "recorded_cgroup": anchor["recorded_cgroup"],
                            "ready": "present", "journal": "signed",
                            "transaction": "blocked"}
        return_code = process.poll()
        if return_code is not None:
            communicate_producer_once(process, lifecycle, 10)
            journal = intent_journal_evidence(stage, expected_target, nonce) if nonce else "unknown"
            raise ProducerEpochFailure("producer-exit-before-ready", {
                "state": dict(state), "nonce": nonce, "signature": signature,
                "recorded_cgroup": recorded_cgroup, "ready": "absent",
                "journal": journal, "transaction": producer_transaction_state(),
                "client": "exited",
                "return_code": return_code if type(return_code) is int else "unknown",
                "result": "exact" if lifecycle["result_exact"] else "invalid",
            })
        if time.monotonic() >= deadline:
            journal = intent_journal_evidence(stage, expected_target, nonce) if nonce else "unknown"
            raise ProducerEpochFailure("producer-timeout-before-ready", {
                "state": dict(state), "nonce": nonce, "signature": signature,
                "recorded_cgroup": recorded_cgroup, "ready": "absent",
                "journal": journal, "transaction": producer_transaction_state(),
                "client": "live", "return_code": "unknown", "result": "unavailable",
            })
        time.sleep(min(0.05, max(0, deadline - time.monotonic())))


def producer_transaction_state():
    descriptor = None
    try:
        descriptor = open_transaction_lock()
        return "reusable" if lock_transaction(descriptor) else "blocked"
    except BaseException:
        return "unknown"
    finally:
        if descriptor is not None:
            try:
                close_transaction_lock(descriptor)
            except BaseException:
                pass


def open_intent_epoch(stage, expected_target, prior, repo, commit, go_binary, mode):
    ready_path = "/run/nmcp-ci/cleanup-intent.ready"
    ready_fd = os_call("intent-window", "open", "marker", os.open, ready_path,
                       os.O_RDONLY | os.O_NOFOLLOW)
    try:
        ready_stat = os_call("intent-window", "stat", "marker", os.fstat, ready_fd)
        _ready_raw, ready = read_anchored_json(ready_fd, ready_stat, "marker")
        ready_current = os_call("intent-window", "stat", "marker", os.stat, ready_path,
                                follow_symlinks=False)
        if evidence_identity(ready_current) != evidence_identity(ready_stat):
            fail("intent epoch ready marker was replaced while anchored")
    finally:
        os_call("intent-window", "close", "marker", os.close, ready_fd)
    if set(ready) != {"journal_dev", "journal_ino", "nonce", "pid", "stage", "target"}:
        fail("intent epoch ready marker schema changed")
    nonce = ready["nonce"]
    target = ready["target"]
    if (type(nonce) is not str or len(nonce) != 64
            or any(character not in "0123456789abcdef" for character in nonce)
            or ready["stage"] != stage or type(target) is not str
            or (expected_target == "run-root" and not target.startswith("/run/nmcp-ci/transaction-"))
            or (expected_target != "run-root" and target != expected_target)
            or type(ready["pid"]) is not int or ready["pid"] <= 1
            or type(ready["journal_dev"]) is not int or type(ready["journal_ino"]) is not int):
        fail(f"intent epoch ready marker did not bind {expected_target}:{stage}")
    state = show_identity_until(
        "intent-window", time.monotonic() + 10, "MainPID", "ActiveState", "SubState",
        "Result", "ControlGroup")
    _observed_nonce, signature = intent_launch_signature(
        state, repo, commit, go_binary, mode, nonce)
    if (state.get("ActiveState") != "active" or state.get("SubState") != "running"
            or int(state.get("MainPID", "0")) != ready["pid"]):
        fail(f"intent epoch marker did not bind the live supervisor: {expected_target}:{stage}")
    descriptor = os_call("intent-window", "open", "cleanup-intent", os.open,
                         "/run/nmcp-ci/cleanup-intent.json", os.O_RDONLY | os.O_NOFOLLOW)
    try:
        observed = os_call("intent-window", "stat", "cleanup-intent", os.fstat, descriptor)
        raw, document = read_anchored_json(descriptor, observed, "cleanup-intent")
        current = os_call("intent-window", "stat", "cleanup-intent", os.stat,
                          "/run/nmcp-ci/cleanup-intent.json", follow_symlinks=False)
        epoch = document.get("epoch")
        if (set(document) != {"version", "epoch", "entries"} or document["version"] != 2
                or type(epoch) is not dict or set(epoch) != {"nonce", "stage", "target"}
                or epoch != {"nonce": nonce, "stage": stage, "target": target}
                or (observed.st_dev, observed.st_ino) != (ready["journal_dev"], ready["journal_ino"])
                or evidence_identity(current) != evidence_identity(observed)):
            fail(f"cleanup intent epoch did not bind {expected_target}:{stage}")
        if prior is not None:
            if nonce == prior["nonce"]:
                fail("next cleanup intent epoch reused the prior nonce")
            assert_replaced_or_absent(prior["target"], prior["target_identity"])
            if (observed.st_dev, observed.st_ino) == prior["journal_identity"]:
                fail("prior cleanup-intent inode survived recovery")
        entry = run_root_entry(document) if expected_target == "run-root" else intent_entry(document, target)
        return {"descriptor": descriptor, "raw": raw, "stat": observed, "document": document,
                "entry": entry, "nonce": nonce, "pid": ready["pid"], "target": target,
                "signature": signature, "state": state}
    except BaseException:
        os_call("intent-window", "close", "cleanup-intent", os.close, descriptor)
        raise


def snapshot_intent_epoch(anchor, label):
    try:
        raw, document = read_anchored_json(
            anchor["descriptor"], anchor["stat"], "cleanup-intent")
        current = os_call("intent-window", "stat", "cleanup-intent", os.stat,
                          "/run/nmcp-ci/cleanup-intent.json", follow_symlinks=False)
        after = os_call("intent-window", "stat", "cleanup-intent", os.fstat,
                        anchor["descriptor"])
        if (raw != anchor["raw"] or document != anchor["document"]
                or evidence_identity(after) != evidence_identity(anchor["stat"])
                or evidence_identity(current) != evidence_identity(anchor["stat"])):
            fail(f"cleanup intent epoch changed after intended kill: {label}")
        target_identity = observable_identity(anchor["target"], anchor["entry"]["identity"])
        return {"nonce": anchor["nonce"], "target": anchor["target"],
                "target_identity": target_identity,
                "journal_identity": (anchor["stat"].st_dev, anchor["stat"].st_ino)}
    finally:
        os_call("intent-window", "close", "cleanup-intent", os.close,
                anchor["descriptor"])


def terminate_and_reap_producer(process, lifecycle):
    errors = []
    if process.poll() is None:
        try:
            os_call("intent-window", "kill", "process", process.terminate)
            process_wait("intent-window", process, 5)
        except BaseException as error:
            errors.append(error)
    if process.poll() is None:
        try:
            os_call("intent-window", "kill", "process", process.kill)
            process_wait("intent-window", process, 5)
        except BaseException as error:
            errors.append(error)
    if not lifecycle["communicated"] and process.poll() is not None:
        try:
            communicate_producer_once(process, lifecycle, 5)
        except BaseException as error:
            errors.append(error)
    lifecycle["reaped"] = process.poll() is not None
    return errors


def producer_epoch_finality(process, lifecycle, evidence, repo, commit, go_binary, mode):
    errors = []
    categories = []
    errors.extend(terminate_and_reap_producer(process, lifecycle))
    if errors:
        categories.append("reap")
    signature = evidence.get("signature")
    recorded_cgroup = evidence.get("recorded_cgroup", "")
    state = {"LoadState": "unknown"}
    deadline = time.monotonic() + 45
    try:
        state = show_identity_until(
            "intent-window", deadline, "ActiveState", "SubState", "MainPID", "Result",
            "ControlGroup")
        recorded_cgroup = state.get("ControlGroup", "") or recorded_cgroup
        if state.get("LoadState") == "loaded" and signature is None:
            try:
                _nonce, signature = intent_launch_signature(
                    state, repo, commit, go_binary, mode, evidence.get("nonce"))
            except BaseException:
                categories.append("unsigned-loaded")
        if state.get("LoadState") == "loaded" and signature is not None:
            cleanup_signed_launch_until(signature, "intent-window", deadline)
    except BaseException as error:
        errors.append(error)
        categories.append("action")
    try:
        state = show_until(
            "intent-window", deadline, "ActiveState", "SubState", "MainPID", "Result",
            "ControlGroup")
        recorded_cgroup = state.get("ControlGroup", "") or recorded_cgroup
    except BaseException as error:
        errors.append(error)
        categories.append("state")
        state = {"LoadState": "unknown"}
    scans = {"recorded": ["unobserved"], "canonical": ["unobserved"]}
    scanned = {"recorded": False, "canonical": False}
    for name, path in (("recorded", recorded_cgroup),
                       ("canonical", "/system.slice/" + UNIT)):
        if not path:
            errors.append(RuntimeError("intent producer lacked a recorded cgroup"))
            categories.append("cgroup")
            continue
        scanned[name] = True
        try:
            scans[name] = cgroup_pids(path, "intent-window")
        except BaseException as error:
            errors.append(error)
            categories.append("cgroup")
    lock_results = {"client": False, "transaction": False}
    try:
        assert_client_lock_reusable()
        lock_results["client"] = True
    except BaseException as error:
        errors.append(error)
        categories.append("lock")
    try:
        assert_transaction_lock_reusable()
        lock_results["transaction"] = True
    except BaseException as error:
        errors.append(error)
        categories.append("lock")
    unique_categories = tuple(dict.fromkeys(categories))
    cleanup = ("complete" if not unique_categories else
               unique_categories[0] if len(unique_categories) == 1 else "multiple")
    return {
        "state": state, "signature": signature, "recorded_cgroup": recorded_cgroup,
        "scans": scans, "scanned": scanned, "locks": lock_results,
        "cleanup": cleanup, "errors": tuple(errors),
        "reaped": lifecycle["reaped"],
        "unit_absent": state.get("LoadState") == "not-found",
    }


def closed_state_value(value, allowed):
    return value if type(value) is str and value in allowed else "unknown"


def producer_failure_message(category, stage, expected_target, evidence, finality):
    state = evidence.get("state") or {"LoadState": "unknown"}
    mainpid = state.get("MainPID", "unknown")
    if type(mainpid) is not str:
        mainpid = str(mainpid) if type(mainpid) is int and mainpid >= 0 else "unknown"
    if not mainpid.isdecimal():
        mainpid = "unknown"
    load = closed_state_value(state.get("LoadState"), ("loaded", "not-found"))
    identity = ("absent" if load == "not-found" else
                "exact" if evidence.get("signature") is not None else
                "mismatch" if load == "loaded" else "unknown")
    environment = ("absent" if load == "not-found" else
                   "exact" if evidence.get("signature") is not None else
                   "mismatch" if state.get("Environment") else "unknown")
    fields = (
        ("stage", stage), ("target", INTENT_TARGETS[expected_target]),
        ("client", evidence.get("client", "unknown")),
        ("return_code", evidence.get("return_code", "unknown")),
        ("result", evidence.get("result", "unknown")),
        ("load", load),
        ("active", closed_state_value(
            state.get("ActiveState"), ("active", "failed", "inactive"))),
        ("sub", closed_state_value(
            state.get("SubState"), ("running", "exited", "failed", "dead"))),
        ("mainpid", mainpid),
        ("unit_result", closed_state_value(
            state.get("Result"), ("success", "exit-code", "signal", "timeout"))),
        ("identity", identity), ("environment", environment),
        ("transaction", evidence.get("transaction", "unknown")),
        ("journal", evidence.get("journal", "unknown")),
        ("ready", evidence.get("ready", "unknown")),
        ("reap", diagnostic_bit(finality["reaped"])),
        ("cleanup", finality["cleanup"]),
        ("unit_absent", diagnostic_bit(finality["unit_absent"])),
        ("recorded_scan", diagnostic_bit(finality["scanned"]["recorded"])),
        ("canonical_scan", diagnostic_bit(finality["scanned"]["canonical"])),
        ("recorded_empty", diagnostic_bit(not finality["scans"]["recorded"])),
        ("canonical_empty", diagnostic_bit(not finality["scans"]["canonical"])),
        ("client_lock", diagnostic_bit(finality["locks"]["client"])),
        ("transaction_lock", diagnostic_bit(finality["locks"]["transaction"])),
    )
    return serialize_diagnostic("producer", category, fields, complete=True)


def exercise_intent_epoch(client, repo, commit, go_binary, stage, expected_target, prior):
    label = (f"run-root:{stage}" if expected_target == "run-root"
             else f"path:{expected_target}:{stage}")
    reset_paths("intent-window", "/run/nmcp-ci/cleanup-intent.ready",
                "/run/nmcp-ci/cleanup-intent.ready.new")
    process = popen("intent-window", ("/usr/bin/python3", "-I", "-S", client, repo,
                    commit, go_binary, label), cwd="/", env=ENV,
                    stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
    lifecycle = {"communicated": False, "stdout": "", "stderr": "",
                 "reaped": False, "result_exact": False}
    evidence = {"state": {"LoadState": "unknown"}, "nonce": None,
                "signature": None, "recorded_cgroup": "", "ready": "unknown",
                "journal": "unknown", "transaction": "unknown"}
    anchor = None
    snapshot = None
    primary = None
    try:
        anchor, evidence = producer_wait_evidence(
            process, stage, expected_target, prior, repo, commit, go_binary, label,
            time.monotonic() + PRODUCER_WAIT_SECONDS, lifecycle)
        os_call("intent-window", "kill", "process", os.kill, anchor["pid"], signal.SIGKILL)
        stdout, _stderr = communicate_producer_once(process, lifecycle, 60)
        if process.returncode == 0 or SUCCESS in stdout or not lifecycle["result_exact"]:
            fail(f"intent producer did not return its exact failed result: {label}")
        snapshot = snapshot_intent_epoch(anchor, label)
        anchor = None
    except BaseException as error:
        primary = error
        if isinstance(error, ProducerEpochFailure):
            evidence = error.evidence
    finally:
        if anchor is not None:
            try:
                os_call("intent-window", "close", "cleanup-intent", os.close,
                        anchor["descriptor"])
            except BaseException:
                pass
        finality = producer_epoch_finality(
            process, lifecycle, evidence, repo, commit, go_binary, label)
    if isinstance(primary, ProducerEpochFailure):
        raise SerializedDiagnosticFailure(producer_failure_message(
            primary.category, stage, expected_target, evidence, finality))
    if primary is not None:
        raise primary
    if (finality["cleanup"] != "complete" or not finality["unit_absent"]
            or any(finality["scans"].values()) or not all(finality["locks"].values())
            or not lifecycle["reaped"]):
        fail(f"intent producer finality was incomplete: {label}")
    return snapshot


def main():
    if os.geteuid() != 0 or len(sys.argv) != 5:
        fail("usage: containment CLIENT REPOSITORY CURRENT_COMMIT ABSOLUTE_GO")
    client, repo, commit, go_binary = sys.argv[1:]
    assert_property_parser_contract(client)
    assert_persistent_failure_contract()
    assert_machine_result_contract()
    assert_persistent_cgroup_routing_contract()
    assert_cleanup_deadline_contract()
    assert_launch_identity_contract()
    assert_persistent_handoff_contract()

    # A stale loaded fixed name is never launch-ready merely because it is
    # failed and cgroup-empty. The new client must fail without touching it.
    stale_fixture_id = secrets.token_hex(32)
    stale_signal_name = f"stale-fixed-{stale_fixture_id}"
    stale_helper = f"/run/nmcp-ci/{stale_signal_name}.py"
    stale_helper_new = stale_helper + ".new"
    stale_ready = f"/run/nmcp-ci/{stale_signal_name}.ready"
    stale_release = f"/run/nmcp-ci/{stale_signal_name}.release"
    stale_release_ack = stale_release + ".seen"
    stale_program = """import os
import sys
import time
ready, release = sys.argv[1:]
ready_new = ready + ".new"
descriptor = os.open(ready_new, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
try:
    os.write(descriptor, b"ready\\n")
    os.fsync(descriptor)
finally:
    os.close(descriptor)
os.replace(ready_new, ready)
directory = os.open("/run/nmcp-ci", os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
try:
    os.fsync(directory)
finally:
    os.close(directory)
deadline = time.monotonic() + 120
while not os.path.exists(release):
    if time.monotonic() >= deadline:
        raise SystemExit(2)
    time.sleep(0.02)
release_ack = release + ".seen"
release_ack_new = release_ack + ".new"
descriptor = os.open(release_ack_new, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
try:
    os.write(descriptor, b"seen\\n")
    os.fsync(descriptor)
finally:
    os.close(descriptor)
os.replace(release_ack_new, release_ack)
directory = os.open("/run/nmcp-ci", os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
try:
    os.fsync(directory)
finally:
    os.close(directory)
raise SystemExit(73)
"""
    stale_expected_environment = f"NMCP_VERIFIER_NONCE={stale_fixture_id}"
    stale_expected_argv = ("/usr/bin/python3", "-I", "-S", stale_helper, stale_ready,
                           stale_release)
    stale_expected_properties = {
        "Description": DESCRIPTION_PREFIX + stale_fixture_id,
        "Environment": stale_expected_environment,
        **SERVICE_PROPERTIES,
    }
    stale_invocation = None
    stale_main_pid = None
    stale_signature = None
    stale_observed = {}
    stale_failure = None
    stale_launch_return = None
    stale_launch_stdout = ""
    stale_launch_stderr = ""
    stale_ready_seen = False
    stale_release_seen = False
    stale_release_ack_seen = False
    stale_cleanup_attempted = False
    stale_release_error = None
    stale_state_error = None
    stale_identity_error = None
    stale_action_error = None
    stale_post_error = None
    stale_lock_error = None
    stale_path_error = None
    stale_artifacts_removed = False
    stale_post_cleanup = {}
    stale_post_cleanup_cgroup = None
    stale_post_evidence_complete = False
    stale_recorded_cgroup = ""
    stale_rejected_return = None
    stale_rejected_stdout = ""
    stale_rejected_stderr = ""
    stale_client_attempted = False
    stale_expected_human = ""
    stale_client_class = stale_client_classification(False, None, "", "", "")
    stale_identity_unchanged = False
    stale_identity_changed = False
    stale_after_identity = {
        "signature_unchanged": False, "terminal_unchanged": False,
        "pid_unchanged": False, "cgroup_empty": False, "identity_unchanged": False,
    }
    stale_lock_reusable = False
    stale_after_client = {}
    try:
        reset_paths("stale-setup", stale_helper, stale_helper_new, stale_ready, stale_ready + ".new",
                    stale_release, stale_release_ack, stale_release_ack + ".new")
        stale_helper_descriptor = os_call(
            "stale-setup", "open", "helper", os.open, stale_helper_new,
            os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o500)
        try:
            os_call("stale-setup", "write", "helper", os.write,
                    stale_helper_descriptor, stale_program.encode("ascii"))
            os_call("stale-setup", "chmod", "helper", os.fchmod,
                    stale_helper_descriptor, 0o500)
            os_call("stale-setup", "fsync", "helper", os.fsync,
                    stale_helper_descriptor)
        finally:
            os_call("stale-setup", "close", "helper", os.close,
                    stale_helper_descriptor)
        os_call("stale-setup", "replace", "helper", os.replace,
                stale_helper_new, stale_helper)
        stale_directory = os_call(
            "stale-setup", "open", "directory", os.open, "/run/nmcp-ci",
            os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
        try:
            os_call("stale-setup", "fsync", "directory", os.fsync,
                    stale_directory)
        finally:
            os_call("stale-setup", "close", "directory", os.close,
                    stale_directory)
        launched = run("stale-setup", ("/usr/bin/systemd-run", "--quiet", f"--unit={UNIT}",
                        "--service-type=exec",
                        f"--description={stale_expected_properties['Description']}",
                        f"--property=Environment={stale_expected_environment}",
                        "--property=KillMode=control-group", "--property=SendSIGKILL=yes",
                        "--property=TimeoutStopSec=15s", "--property=RuntimeMaxSec=15min",
                        "--property=Delegate=no", "--property=RemainAfterExit=yes",
                        "--property=User=root", "--property=Group=root", "--property=UMask=0077",
                        "--property=WorkingDirectory=/", "--property=StandardOutput=journal",
                        "--property=StandardError=journal", *stale_expected_argv), check=False,
                       stdout=subprocess.PIPE, stderr=subprocess.PIPE)
        stale_launch_return = launched.returncode
        stale_launch_stdout = launched.stdout
        stale_launch_stderr = launched.stderr
        if launched.returncode:
            fail("stale fixed-unit launch failed before ready handoff")
        wait_path("stale-attestation", stale_ready, timeout=30)
        stale_ready_seen = True
        stale_observed = show_identity_until("stale-attestation",
            time.monotonic() + 10, "ActiveState", "SubState", "Result", "MainPID",
            "ExecMainPID", "ControlGroup")
        stale_invocation = stale_observed.get("InvocationID")
        stale_main_pid = stale_observed.get("MainPID")
        stale_recorded_cgroup = stale_observed.get("ControlGroup", "")
        valid_stale_invocation = (len(stale_invocation or "") == 32
                                  and all(character in "0123456789abcdef"
                                          for character in stale_invocation))
        stale_signature = launch_identity_signature(
            stale_invocation, stale_expected_properties["Description"],
            stale_expected_environment, "/usr/bin/python3", stale_expected_argv)
        if (not valid_stale_invocation
                or not launch_identity_matches(stale_observed, stale_signature)
                or stale_observed.get("SubState") != "running"
                or stale_observed.get("ActiveState") != "active"
                or int(stale_main_pid or "0") <= 0
                or stale_observed.get("ExecMainPID") != stale_main_pid):
            fail("stale fixed-unit did not reach its exact synchronized running state")
        release("stale-attestation", stale_signal_name)
        stale_release_seen = True
        wait_path("stale-attestation", stale_release_ack, timeout=30)
        stale_release_ack_seen = True
        deadline = time.monotonic() + 20
        while True:
            stale_observed = show_identity_until("stale-attestation",
                deadline, "ActiveState", "SubState", "Result", "ExecMainPID",
                "ExecMainCode", "ExecMainStatus", "ControlGroup")
            stale_recorded_cgroup = (stale_observed.get("ControlGroup", "")
                                     or stale_recorded_cgroup)
            if not launch_identity_matches(stale_observed, stale_signature):
                fail("stale fixed-unit identity changed or disappeared before failure attestation")
            if stale_observed.get("ActiveState") == "failed":
                break
            if time.monotonic() >= deadline:
                fail("released stale fixed-unit did not reach failed state: "
                     f"state={sanitized_state(stale_observed)}")
            time.sleep(0.1)
        if not stale_terminal_matches(
                stale_observed, stale_signature, stale_main_pid,
                cgroup_pids(stale_observed.get("ControlGroup", ""), "stale-attestation")):
            fail("released stale fixed-unit had an unexpected exact terminal state")
        stale_expected_human = stale_expected_rejection(stale_observed)
        stale_client_attempted = True
        rejected = run("stale-attestation", ("/usr/bin/python3", "-I", "-S", client, repo, commit, go_binary,
                        "fast-success"), stdout=subprocess.PIPE, stderr=subprocess.PIPE)
        stale_rejected_return = rejected.returncode
        stale_rejected_stdout = rejected.stdout
        stale_rejected_stderr = rejected.stderr
        stale_after_client = show_identity_until("stale-attestation",
            time.monotonic() + 10, "ActiveState", "SubState", "Result", "ExecMainPID",
            "ExecMainCode", "ExecMainStatus", "ControlGroup")
        stale_after_client_pids = cgroup_pids(
            stale_after_client.get("ControlGroup", ""), "stale-attestation")
        stale_after_identity = stale_identity_evidence(
            stale_after_client, stale_signature, stale_main_pid, stale_after_client_pids)
        stale_identity_unchanged = stale_after_identity["identity_unchanged"]
        stale_identity_changed = not stale_identity_unchanged
        stale_client_class = stale_client_classification(
            stale_client_attempted, rejected.returncode, rejected.stdout, rejected.stderr,
            stale_expected_human)
        if stale_client_class["expected_rejection"] and stale_identity_unchanged:
            assert_client_lock_reusable()
            stale_lock_reusable = True
    except Exception as error:
        stale_failure = error
    finally:
        try:
            release("stale-cleanup", stale_signal_name)
            stale_release_seen = True
        except Exception as error:
            stale_release_error = sanitized_diagnostic_text(error)
        if (path_exists("stale-cleanup", "marker", stale_ready)
                and not path_exists("stale-cleanup", "marker", stale_release_ack)):
            release_deadline = time.monotonic() + 5
            while (not path_exists("stale-cleanup", "marker", stale_release_ack)
                   and time.monotonic() < release_deadline):
                time.sleep(0.02)
        stale_release_ack_seen = path_exists("stale-cleanup", "marker", stale_release_ack)
        if path_exists("stale-cleanup", "marker", stale_ready) and not stale_release_ack_seen:
            stale_release_error = stale_release_error or "ready helper did not acknowledge release"
        cleanup_deadline = time.monotonic() + 90
        stale_absence_confirmed = False
        while time.monotonic() < cleanup_deadline:
            try:
                partial = show_identity_until(
                    "stale-cleanup", cleanup_deadline, "ActiveState", "ControlGroup")
            except Exception as error:
                stale_state_error = sanitized_diagnostic_text(error)
                if time.monotonic() >= cleanup_deadline:
                    break
                time.sleep(bounded_cleanup_timeout(cleanup_deadline - time.monotonic(), 0.1))
                continue
            stale_state_error = None
            stale_post_cleanup = partial
            stale_recorded_cgroup = partial.get("ControlGroup", "") or stale_recorded_cgroup
            if partial.get("LoadState") == "not-found":
                stale_absence_confirmed = True
                break
            if stale_signature is None and len(partial.get("InvocationID", "")) == 32:
                candidate_signature = launch_identity_signature(
                    partial.get("InvocationID"), stale_expected_properties["Description"],
                    stale_expected_environment, "/usr/bin/python3", stale_expected_argv)
                if (all(character in "0123456789abcdef"
                        for character in partial.get("InvocationID", ""))
                        and launch_identity_matches(partial, candidate_signature)):
                    stale_signature = candidate_signature
            if stale_signature is None or not launch_identity_matches(partial, stale_signature):
                stale_identity_error = sanitized_diagnostic_text(
                    f"ownership={sanitized_state(partial)}")
                if time.monotonic() >= cleanup_deadline:
                    break
                time.sleep(bounded_cleanup_timeout(cleanup_deadline - time.monotonic(), 0.1))
                continue
            stale_cleanup_attempted = True
            try:
                cleanup_signed_launch_until(stale_signature, "stale-cleanup", cleanup_deadline)
            except Exception as error:
                stale_action_error = stale_action_error or sanitized_diagnostic_text(error)
            if time.monotonic() >= cleanup_deadline:
                break
            time.sleep(bounded_cleanup_timeout(cleanup_deadline - time.monotonic(), 0.1))
        if not stale_absence_confirmed:
            stale_identity_error = stale_identity_error or "explicit unit absence remained unknown"
        try:
            stale_post_cleanup = show_until(
                "stale-cleanup", cleanup_deadline, "LoadState", "ControlGroup")
            stale_post_cleanup_cgroup = {
                "recorded": cgroup_pids(stale_recorded_cgroup, "stale-cleanup"),
                "canonical": cgroup_pids("/system.slice/" + UNIT, "stale-cleanup"),
            }
            stale_post_evidence_complete = True
            if (stale_post_cleanup.get("LoadState") != "not-found"
                    or any(stale_post_cleanup_cgroup.values())):
                stale_post_error = sanitized_diagnostic_text(
                    f"post={sanitized_state(stale_post_cleanup)}; "
                    f"cgroup={stale_post_cleanup_cgroup}")
        except Exception as error:
            stale_post_error = sanitized_diagnostic_text(error)
        try:
            assert_client_lock_reusable()
            stale_lock_reusable = True
        except Exception as error:
            stale_lock_error = sanitized_diagnostic_text(error)
        if (stale_post_evidence_complete and stale_post_error is None
                and stale_identity_error is None and stale_action_error is None
                and stale_post_cleanup.get("LoadState") == "not-found"
                and not any(stale_post_cleanup_cgroup.values())):
            try:
                reset_paths("stale-cleanup", stale_helper, stale_helper_new, stale_ready, stale_ready + ".new",
                            stale_release, stale_release_ack, stale_release_ack + ".new")
                stale_artifacts_removed = True
            except Exception as error:
                stale_path_error = sanitized_diagnostic_text(error)
        else:
            stale_path_error = "owned helper and release preserved pending confirmed absence"
    if (not stale_client_class["expected_rejection"] or stale_identity_changed
            or stale_failure is not None or stale_release_error or stale_state_error or stale_identity_error
            or stale_action_error or stale_post_error or stale_lock_error or stale_path_error):
        stale_client_class = stale_client_classification(
            stale_client_attempted, stale_rejected_return, stale_rejected_stdout,
            stale_rejected_stderr, stale_expected_human)
        recorded_empty = bool(stale_post_evidence_complete and stale_post_cleanup_cgroup
                              and not stale_post_cleanup_cgroup["recorded"])
        canonical_empty = bool(stale_post_evidence_complete and stale_post_cleanup_cgroup
                               and not stale_post_cleanup_cgroup["canonical"])
        unit_absent = bool(stale_post_evidence_complete
                           and stale_post_cleanup.get("LoadState") == "not-found")
        cleanup_error = bool(stale_release_error or stale_state_error or stale_identity_error
                             or stale_action_error or stale_post_error or stale_lock_error
                             or stale_path_error)
        cleanup_succeeded = bool(unit_absent and recorded_empty and canonical_empty
                                 and stale_lock_reusable and stale_artifacts_removed
                                 and not cleanup_error)
        failure_category = stale_failure_category(
            stale_client_class, stale_identity_changed, stale_failure is not None)
        error_flags = (
            ("fixture", stale_failure is not None), ("release", bool(stale_release_error)),
            ("state", bool(stale_state_error)), ("identity", bool(stale_identity_error)),
            ("action", bool(stale_action_error)), ("post", bool(stale_post_error)),
            ("lock", bool(stale_lock_error)), ("paths", bool(stale_path_error)),
        )
        error_category = next((name for name, present in error_flags if present), "none")
        raise SerializedDiagnosticFailure(stale_failure_message(
            failure_category, stale_rejected_return == 0, stale_client_class, unit_absent,
            recorded_empty, canonical_empty, stale_identity_unchanged, stale_identity_changed,
            stale_cleanup_attempted, cleanup_succeeded, stale_lock_reusable,
            stale_artifacts_removed, stale_post_evidence_complete, stale_ready_seen,
            stale_release_seen, stale_release_ack_seen, error_category,
            stale_failure is not None, bool(stale_rejected_stdout), cleanup_error))

    client_faults = (
        "client-fault-after-launch", "client-fault-missing-invocation",
        "client-fault-after-invocation", "client-fault-after-properties",
        "client-fault-at-terminal", "client-fault-after-journal",
        "client-property-fault-immediate", "client-property-fault-recovery",
        "client-property-fault-owned",
    )
    property_boundaries = {
        "client-property-fault-immediate": "immediate",
        "client-property-fault-recovery": "recovery",
        "client-property-fault-owned": "owned-state",
    }
    for mode in client_faults:
        boundary = property_boundaries.get(mode)
        if boundary:
            reset_paths("transient-cleanup", *fault_paths(mode, boundary))
        if mode == "client-fault-missing-invocation":
            reset_signal_paths("client-fault", mode)
            process = popen("client-fault",
                ("/usr/bin/python3", "-I", "-S", client, repo, commit, go_binary, mode),
                cwd="/", env=ENV, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True,
            )
            wait_path("client-fault", f"/run/nmcp-ci/{mode}.ready", timeout=30)
            matching = show(
                "client-fault", "LoadState", "InvocationID", "Description", "Environment",
                "ExecStart")
            if (matching.get("LoadState") != "loaded" or not matching.get("InvocationID")
                    or "NMCP_VERIFIER_NONCE=" not in matching.get("Environment", "")
                    or "NMCP_VERIFIER_NONCE=" not in matching.get("ExecStart", "")):
                fail("matching-nonce adoption fixture lacks the real launched service identity")
            release("client-fault", mode)
            fault_stdout, fault_stderr = process_communicate("client-fault", process, 30)
            faulted = subprocess.CompletedProcess(process.args, process.returncode,
                                                  fault_stdout, fault_stderr)
        else:
            faulted = run("client-fault", ("/usr/bin/python3", "-I", "-S", client, repo, commit, go_binary, mode),
                          stdout=subprocess.PIPE, stderr=subprocess.PIPE)
        assert_client_failure(faulted, mode, "client-fault")
        if mode == "client-fault-missing-invocation" and "missing exact invocation identity" not in faulted.stderr:
            fail("matching-nonce adoption test did not exercise missing initial InvocationID")
        if boundary:
            assert_interception(mode, boundary, "transient-cleanup")
            if f"intercepted {boundary} command before attempt" not in faulted.stderr:
                fail(f"property retry did not retain its initial real error: {mode}")
        fast_recovery(client, repo, commit, go_binary, mode, "client-fault")

    for budget_boundary in ("launch", "service", "journal"):
        budget_mode = f"client-work-budget-{budget_boundary}"
        budget_ready = f"/run/nmcp-ci/{budget_mode}.ready"
        unloaded_ready = f"/run/nmcp-ci/{budget_mode}-unloaded.ready"
        reset_paths("work-budget", budget_ready, unloaded_ready,
                    f"/run/nmcp-ci/{budget_mode}-unloaded.release")
        budgeted = popen("work-budget",
            ("/usr/bin/python3", "-I", "-S", client, repo, commit, go_binary, budget_mode),
            cwd="/", env=ENV, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True,
        )
        wait_path("work-budget", budget_ready, timeout=30)
        budget_started = time.monotonic()
        wait_path("work-budget", unloaded_ready, timeout=30)
        budget_elapsed = time.monotonic() - budget_started
        if show("work-budget", "LoadState", "ControlGroup").get("LoadState") != "not-found":
            fail(f"work-budget teardown did not explicitly unload: {budget_boundary}")
        if cgroup_pids("/system.slice/" + UNIT, "work-budget"):
            fail(f"work-budget teardown left cgroup processes: {budget_boundary}")
        assert_client_lock_held()
        release("work-budget", budget_mode + "-unloaded")
        budget_stdout, budget_stderr = process_communicate("work-budget", budgeted, 30)
        budget_result = subprocess.CompletedProcess(budgeted.args, budgeted.returncode,
                                                    budget_stdout, budget_stderr)
        assert_client_failure(budget_result, budget_mode, "work-budget")
        if f"absolute client work budget exhausted at {budget_boundary}" not in budget_stderr:
            fail(f"work-budget fault did not exhaust at {budget_boundary}")
        if budget_elapsed < 0.7 or budget_elapsed > 20:
            fail(f"work-budget reserve timing was not bounded: {budget_boundary}: {budget_elapsed:.3f}s")
        fast_recovery(client, repo, commit, go_binary, budget_mode, "work-budget")

    slow_mode = "client-work-budget-slow-cleanup"
    slow_ready = f"/run/nmcp-ci/{slow_mode}.ready"
    slow_unloaded = f"/run/nmcp-ci/{slow_mode}-unloaded.ready"
    slow_paths = {boundary: fault_paths(slow_mode, boundary)
                  for boundary in ("show", "kill", "stop")}
    reset_paths("slow-cleanup", slow_ready, slow_unloaded, f"/run/nmcp-ci/{slow_mode}-unloaded.release",
                *(path for paths in slow_paths.values() for path in paths))
    slow = popen("slow-cleanup",
        ("/usr/bin/python3", "-I", "-S", client, repo, commit, go_binary, slow_mode),
        cwd="/", env=ENV, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True,
    )
    wait_path("slow-cleanup", slow_ready, timeout=30)
    slow_started = time.monotonic()
    wait_path("slow-cleanup", slow_unloaded, timeout=175)
    slow_elapsed = time.monotonic() - slow_started
    expected_slow_counts = {"show": (1, 1), "kill": (2, 0), "stop": (1, 1)}
    for boundary, (expected_intercepted, expected_attempted) in expected_slow_counts.items():
        intercepted, attempted = slow_paths[boundary]
        if (counter("slow-cleanup", intercepted), counter("slow-cleanup", attempted)) != (
                expected_intercepted, expected_attempted):
            fail(f"slow sequential cleanup evidence changed at {boundary}")
    if slow_elapsed < 25 or slow_elapsed > 175:
        fail(f"slow cleanup delay/retry was not bounded: {slow_elapsed:.3f}s")
    slow_state = show("slow-cleanup", "LoadState", "ControlGroup")
    if slow_state.get("LoadState") != "not-found":
        fail("slow cleanup did not explicitly unload: " + sanitized_state(slow_state))
    if (cgroup_pids(slow_state.get("ControlGroup", ""), "slow-cleanup")
            or cgroup_pids("/system.slice/" + UNIT, "slow-cleanup")):
        fail("slow cleanup left fixed-unit cgroup processes")
    assert_client_lock_held()
    release("slow-cleanup", slow_mode + "-unloaded")
    slow_stdout, slow_stderr = process_communicate("slow-cleanup", slow, 30)
    slow_result = subprocess.CompletedProcess(slow.args, slow.returncode,
                                              slow_stdout, slow_stderr)
    assert_client_failure(slow_result, slow_mode, "slow-cleanup")
    if ("absolute client work budget exhausted at slow-cleanup" not in slow_stderr
            or "injected slow owned show failure before action" not in slow_stderr
            or "injected slow owned kill failure before action" not in slow_stderr
            or "injected slow owned stop failure before action" not in slow_stderr):
        fail("slow cleanup lost its work-cutoff or retained cleanup error")
    fast_recovery(client, repo, commit, go_binary, slow_mode, "slow-cleanup")

    for boundary in ("show", "kill", "stop", "wait", "reset", "unload"):
        mode = "client-cleanup-fault-" + boundary
        intercepted, attempted = fault_paths(mode, boundary)
        blocked = f"/run/nmcp-ci/{mode}.blocked"
        reset_paths("transient-cleanup", intercepted, attempted, blocked,
                    f"/run/nmcp-ci/{mode}.release")
        if boundary == "stop":
            process = popen("transient-cleanup",
                ("/usr/bin/python3", "-I", "-S", client, repo, commit, go_binary, mode),
                cwd="/", env=ENV, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True,
            )
            wait_path("transient-cleanup", blocked, timeout=30)
            stopped = show("transient-cleanup", "ActiveState", "SubState", "InvocationID")
            if (stopped.get("ActiveState") != "active"
                    or counter("transient-cleanup", attempted)):
                fail("intercepted first stop attempt acted on the unit: "
                     + sanitized_state(stopped))
            release("transient-cleanup", mode)
            fault_stdout, fault_stderr = process_communicate("transient-cleanup", process, 30)
            faulted = subprocess.CompletedProcess(process.args, process.returncode,
                                                  fault_stdout, fault_stderr)
        else:
            faulted = run("transient-cleanup", ("/usr/bin/python3", "-I", "-S", client, repo, commit, go_binary, mode),
                          stdout=subprocess.PIPE, stderr=subprocess.PIPE)
        assert_client_failure(faulted, mode, "transient-cleanup")
        assert_interception(mode, boundary, "transient-cleanup")
        if f"intercepted {boundary} command before attempt" not in faulted.stderr:
            fail(f"cleanup fault did not retain its initial real error: {boundary}")
        fast_recovery(client, repo, commit, go_binary, mode, "transient-cleanup")

    persistent_cases = tuple(
        (boundary, "normal")
        for boundary in ("show", "kill", "stop", "wait", "reset", "unload")) + (
            ("kill", "parse"), ("wait", "timeout"),
        )
    for boundary, evidence_case in persistent_cases:
        case_label = evidence_case
        mode = "client-cleanup-persistent-" + boundary
        intercepted, attempted = fault_paths(mode, boundary)
        handoff_ready = f"/run/nmcp-ci/{mode}.handoff.ready"
        handoff_release = f"/run/nmcp-ci/{mode}.handoff.release"
        reset_paths("persistent-cleanup", intercepted, attempted, handoff_ready, handoff_release)
        launch_barrier_baseline = persistent_launch_barriers("persistent-cleanup")
        process = popen("persistent-cleanup",
            ("/usr/bin/python3", "-I", "-S", client, repo, commit, go_binary, mode),
            cwd="/", env=ENV, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True,
        )
        expected_interceptions = 4 if boundary in ("show", "wait", "unload") else 2
        lifecycle_error = ""
        observed = {"EvidenceError": "pre-handoff state unavailable"}
        signature = None
        recorded_cgroup = ""
        recorded_cgroup_category = "unobserved"
        observed_interceptions = None
        fault_stdout = ""
        fault_stderr = ""
        release_ok = False
        reap_ok = False
        requires_live = persistent_supervisor_mode(mode) == "fast-hold"
        launch_required = ""
        launch_ready = ""
        launch_release = ""
        nonce = ""
        try:
            nonce = wait_persistent_launch_required(
                "persistent-cleanup", launch_barrier_baseline, timeout=10)
            launch_required, launch_ready, launch_release = persistent_launch_paths(nonce)
            if not validated_marker("persistent-cleanup", launch_required, nonce):
                fail("persistent launch barrier declaration disappeared")
            wait_validated_marker("persistent-cleanup", launch_ready, nonce, timeout=10)
            early_observed = show_identity_until(
                "persistent-cleanup", time.monotonic() + 10, "ControlGroup")
            if early_observed.get("LoadState") != "loaded":
                fail("persistent launch barrier did not retain a loaded service")
            if early_observed.get("Environment") != f"{NONCE_VARIABLE}={nonce}":
                fail("validated launch barrier did not match loaded immutable unit identity")
            signature = persistent_launch_signature(
                early_observed, repo, commit, go_binary, mode)
            assert_launch_signature_counterexamples(
                early_observed, repo, commit, go_binary, mode)
            recorded_cgroup, recorded_cgroup_category = retain_persistent_cgroup(
                recorded_cgroup, early_observed)
            if not cgroup_pids(recorded_cgroup, "persistent-cleanup"):
                fail("persistent launch barrier had no live service cgroup process")
            assert_transaction_lock_held()
            assert_client_lock_held()
            release("persistent-cleanup", "launch-" + nonce)
            wait_counter("persistent-cleanup", intercepted, expected_interceptions, timeout=30)
            observed_interceptions = counter("persistent-cleanup", intercepted)
            if observed_interceptions != expected_interceptions:
                fail("persistent interception count changed before handoff")
            wait_path("persistent-cleanup", handoff_ready, timeout=30)
            observed = show_identity_until(
                "persistent-cleanup", time.monotonic() + 10, "ControlGroup")
            if observed.get("LoadState") == "loaded":
                recorded_cgroup, recorded_cgroup_category = retain_persistent_cgroup(
                    recorded_cgroup, observed)
            handoff_pids = (cgroup_pids(recorded_cgroup, "persistent-cleanup")
                            if recorded_cgroup else [])
            if not persistent_handoff_state_accepted(
                    boundary, observed, signature, handoff_pids):
                fail("persistent handoff lacked exact retained identity or unload finality")
            if evidence_case != "normal" and not requires_live:
                fail("injected persistent evidence case did not use fast-hold")
            if requires_live and not handoff_pids:
                fail("fast-hold persistent handoff had no live service cgroup process")
            if not requires_live and handoff_pids:
                fail("terminal persistent handoff retained live service cgroup processes")
            assert_client_lock_held()
            if evidence_case == "parse":
                malformed = os_call("persistent-cleanup", "open", "counter", os.open, intercepted,
                                    os.O_WRONLY | os.O_TRUNC | os.O_NOFOLLOW)
                try:
                    os_call("persistent-cleanup", "write", "counter", os.write,
                            malformed, b"01\n")
                    os_call("persistent-cleanup", "fsync", "counter", os.fsync, malformed)
                finally:
                    os_call("persistent-cleanup", "close", "counter", os.close, malformed)
                counter("persistent-cleanup", intercepted)
            elif evidence_case == "timeout":
                wait_counter("persistent-cleanup", intercepted, COUNTER_MAX, timeout=0)
        except BaseException as error:
            lifecycle_error = retained_diagnostic(error, "persistent handoff observation failed")
        finally:
            try:
                if launch_release:
                    release("persistent-cleanup", "launch-" + nonce)
            except BaseException as error:
                lifecycle_error = "; ".join(item for item in (
                    lifecycle_error, retained_diagnostic(error, "persistent launch release failed"))
                    if item)
            try:
                release("persistent-cleanup", mode + ".handoff")
                release_ok = validated_payload_marker(
                    "persistent-cleanup", handoff_release, b"release\n", "release")
            except BaseException as error:
                lifecycle_error = "; ".join(item for item in (
                    lifecycle_error, retained_diagnostic(error, "persistent handoff release failed"))
                    if item)
            try:
                fault_stdout, fault_stderr = process_communicate(
                    "persistent-cleanup", process, 60)
                reap_ok = process.poll() is not None
            except BaseException as error:
                lifecycle_error = "; ".join(item for item in (
                    lifecycle_error, retained_diagnostic(error, "persistent client wait failed"))
                    if item)
                if process.poll() is None:
                    try:
                        os_call("persistent-cleanup", "kill", "process", process.terminate)
                        fault_stdout, fault_stderr = process_communicate(
                            "persistent-cleanup", process, 30)
                        reap_ok = process.poll() is not None
                    except BaseException as terminate_error:
                        lifecycle_error = "; ".join(item for item in (
                            lifecycle_error,
                            retained_diagnostic(terminate_error,
                                                "persistent client termination failed")) if item)
                        if process.poll() is None:
                            try:
                                os_call("persistent-cleanup", "kill", "process", process.kill)
                                process_wait("persistent-cleanup", process, 10)
                                reap_ok = process.poll() is not None
                            except BaseException as kill_error:
                                lifecycle_error = "; ".join(item for item in (
                                    lifecycle_error,
                                    retained_diagnostic(kill_error,
                                                        "persistent client reap failed")) if item)
        faulted = subprocess.CompletedProcess(process.args, process.returncode,
                                               fault_stdout, fault_stderr)
        cleanup_error = ""
        if signature is None:
            try:
                recovered_observed = show_identity_until(
                    "persistent-cleanup", time.monotonic() + 10, "ControlGroup")
                if recovered_observed.get("LoadState") != "not-found":
                    signature = persistent_launch_signature(
                        recovered_observed, repo, commit, go_binary, mode)
                    observed = recovered_observed
                recorded_cgroup, recorded_cgroup_category = retain_persistent_cgroup(
                    recorded_cgroup, recovered_observed)
            except BaseException as error:
                cleanup_error = "; ".join(item for item in (
                    cleanup_error,
                    retained_diagnostic(error, "post-handoff ownership recovery failed")) if item)
        try:
            after_exit = (show("persistent-cleanup", "LoadState", "ControlGroup")
                          if signature is None
                          else signed_launch_state(signature, "persistent-cleanup"))
            recorded_cgroup, recorded_cgroup_category = retain_persistent_cgroup(
                recorded_cgroup, after_exit)
        except BaseException as error:
            after_exit = {"EvidenceError": "post-exit state capture failed"}
            cleanup_error = retained_diagnostic(error, "post-exit state capture failed")
        cleanup_lock = None
        lock_held = False
        lock_handoff_error = ""
        try:
            cleanup_lock = os_call("persistent-cleanup", "open", "lock", os.open,
                                   "/run/nmcp-ci/client.lock", os.O_RDWR | os.O_NOFOLLOW)
            if try_nonblocking_flock(cleanup_lock, "persistent-cleanup", "lock"):
                lock_held = True
            else:
                lock_handoff_error = "cleanup lock handoff failed"
        except BaseException as error:
            lock_handoff_error = retained_diagnostic(error, "cleanup lock handoff failed")
        signed_cleanup_ran = False
        try:
            signed_cleanup_ran = cleanup_signed_launch_if_owned(
                lock_held, signature, after_exit, "persistent-cleanup", cleanup_signed_launch)
        except BaseException as error:
            cleanup_error = "; ".join(
                item for item in (cleanup_error, retained_diagnostic(error, "signed cleanup failed"))
                if item)
        try:
            post_cleanup = show_identity_until("persistent-cleanup", time.monotonic() + 10,
                                               "ActiveState", "ControlGroup")
            recorded_cgroup, recorded_cgroup_category = retain_persistent_cgroup(
                recorded_cgroup, post_cleanup)
        except BaseException as error:
            post_cleanup = {"EvidenceError": "post-cleanup state capture failed"}
            cleanup_error = "; ".join(
                item for item in (
                    cleanup_error, retained_diagnostic(error, "post-cleanup state capture failed"))
                if item)
        try:
            post_cleanup_cgroup, recorded_cgroup_scanned, canonical_cgroup_scanned = persistent_cgroup_finality(
                recorded_cgroup, recorded_cgroup_category,
                lambda control_group: cgroup_pids(control_group, "persistent-cleanup"))
        except PersistentCgroupFinalityFailure as error:
            post_cleanup_cgroup = error.result
            recorded_cgroup_scanned = error.recorded_scanned
            canonical_cgroup_scanned = error.canonical_scanned
            cleanup_error = "; ".join(
                item for item in (
                    cleanup_error, retained_diagnostic(error, "cgroup evidence capture failed"))
                if item)
        except BaseException as error:
            post_cleanup_cgroup = {
                "recorded": ["capture-failed"], "canonical": ["capture-failed"],
            }
            recorded_cgroup_scanned = False
            canonical_cgroup_scanned = False
            cleanup_error = "; ".join(
                item for item in (
                    cleanup_error, retained_diagnostic(error, "cgroup evidence setup failed"))
                if item)
        finally:
            if cleanup_lock is not None:
                if lock_held:
                    try:
                        os_call("persistent-cleanup", "flock", "lock", fcntl.flock,
                                cleanup_lock, fcntl.LOCK_UN)
                    except BaseException as error:
                        cleanup_error = "; ".join(
                            item for item in (
                                cleanup_error, retained_diagnostic(error, "lock release failed"))
                            if item)
                try:
                    os_call("persistent-cleanup", "close", "lock", os.close, cleanup_lock)
                except BaseException as error:
                    cleanup_error = "; ".join(
                        item for item in (
                            cleanup_error, retained_diagnostic(error, "lock close failed"))
                        if item)
        lock_reuse_error = ""
        try:
            assert_client_lock_reusable()
        except BaseException as error:
            lock_reuse_error = retained_diagnostic(error, "client lock reuse check failed")
        observed_attempts = counter("persistent-cleanup", attempted)
        expected_lifecycle = {
            "normal": "none", "parse": "non-canonical", "timeout": "timeout",
        }[case_label]
        lifecycle_category = {
            "": "none",
            "phase=persistent-cleanup operation=parse resource=counter category=non-canonical":
                "non-canonical",
            "phase=persistent-cleanup operation=read resource=counter category=timeout": "timeout",
        }.get(lifecycle_error, "unexpected")
        parsed_result, stderr_shape = client_stderr_evidence(faulted.stderr)
        expected_result = expected_persistent_result(case_label, boundary)
        signed_cleanup_required = after_exit.get("LoadState") == "loaded"
        expected_signed_cleanup_required = boundary in ("show", "stop", "reset")
        unit_absent = post_cleanup.get("LoadState") == "not-found"
        recorded_empty = not post_cleanup_cgroup["recorded"]
        canonical_empty = not post_cleanup_cgroup["canonical"]
        cleanup_categories = () if not cleanup_error else ("unexpected",)
        artifacts_absent = False
        try:
            reset_paths("persistent-cleanup", intercepted, attempted,
                        handoff_ready, handoff_release, launch_required, launch_ready, launch_release)
            artifacts_absent = not any(
                path_exists("persistent-cleanup", "marker", path)
                for path in (intercepted, attempted, handoff_ready, handoff_release,
                             launch_required, launch_ready, launch_release))
        except BaseException as error:
            cleanup_error = "; ".join(item for item in (
                cleanup_error, retained_diagnostic(error, "fixture artifact cleanup failed")) if item)
            cleanup_categories = ("unexpected",)
        predicates = evaluate_persistent_result(
            case_label, evidence_case, lifecycle_category, expected_lifecycle,
            parsed_result, stderr_shape, expected_result, faulted.returncode, faulted.stdout,
            observed_interceptions, observed_attempts, lock_handoff_error, cleanup_error,
            cleanup_categories, lock_reuse_error, expected_signed_cleanup_required,
            signed_cleanup_required, signed_cleanup_ran, release_ok, reap_ok, unit_absent,
            recorded_cgroup_category, True, bool(recorded_cgroup),
            recorded_cgroup_scanned, canonical_cgroup_scanned,
            recorded_empty, canonical_empty, artifacts_absent)
        if not all(predicates.values()):
            raise SerializedDiagnosticFailure(persistent_scalar_diagnostic(
                case_label, boundary, lifecycle_category, predicates, stderr_shape))
        fast_recovery(client, repo, commit, go_binary, mode, "persistent-cleanup")

    for signal_name, signum in (("int", signal.SIGINT), ("term", signal.SIGTERM),
                                ("hup", signal.SIGHUP), ("quit", signal.SIGQUIT)):
        for lifecycle in ("startup", "work"):
            mode = f"client-signal-{signal_name}-{lifecycle}"
            marker = f"/run/nmcp-ci/{mode}.ready"
            reset_paths("signal-cleanup", marker)
            cancelled = popen("signal-cleanup",
                ("/usr/bin/python3", "-I", "-S", client, repo, commit, go_binary, mode),
                cwd="/", env=ENV, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True,
            )
            wait_path("signal-cleanup", marker, timeout=30)
            os_call("signal-cleanup", "kill", "process", os.kill, cancelled.pid, signum)
            cancelled_stdout, cancelled_stderr = process_communicate(
                "signal-cleanup", cancelled, 30)
            result = subprocess.CompletedProcess(cancelled.args, cancelled.returncode,
                                                 cancelled_stdout, cancelled_stderr)
            assert_cancelled_result(result, mode, signum)
            fast_recovery(client, repo, commit, go_binary, mode, "signal-cleanup")
        for boundary in ("kill", "stop", "wait", "reset", "unload"):
            mode = f"client-signal-{signal_name}-{boundary}"
            marker = f"/run/nmcp-ci/{mode}.ready"
            reset_paths("signal-cleanup", marker)
            cancelled = popen("signal-cleanup",
                ("/usr/bin/python3", "-I", "-S", client, repo, commit, go_binary, mode),
                cwd="/", env=ENV, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True,
            )
            wait_path("signal-cleanup", marker, timeout=30)
            os_call("signal-cleanup", "kill", "process", os.kill, cancelled.pid, signum)
            cancelled_stdout, cancelled_stderr = process_communicate(
                "signal-cleanup", cancelled, 30)
            result = subprocess.CompletedProcess(cancelled.args, cancelled.returncode,
                                                 cancelled_stdout, cancelled_stderr)
            assert_cancelled_result(result, mode, signum)
            fast_recovery(client, repo, commit, go_binary, mode, "signal-cleanup")

    prior = None
    for stage in INTENT_STAGES:
        prior = exercise_intent_epoch(
            client, repo, commit, go_binary, stage, "run-root", prior)
    for target in ("/usr/local/libexec/nmcp", "/var/lib/nmcp", "/opt/nmcp-role-compatibility"):
        for stage in INTENT_STAGES:
            prior = exercise_intent_epoch(
                client, repo, commit, go_binary, stage, target, prior)
    first = popen("preflight", ("/usr/bin/python3", "-I", "-S", client, repo, commit, go_binary,
                              "containment-supervisor-kill"), cwd="/", env=ENV,
                             stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
    wait_path("preflight", READY)
    state = show("preflight", "InvocationID", "MainPID", "ActiveState", "ControlGroup")
    invocation = state["InvocationID"]
    main_pid = int(state["MainPID"])
    if state["ActiveState"] != "active" or main_pid <= 1:
        fail("containment invocation is not active: " + sanitized_state(state))
    base = os.path.dirname(READY)
    descendants = []
    for name in PID_FILES:
        descendants.append(read_pid(os.path.join(base, name), "preflight"))
    if not all(pid_exists(pid, "preflight") for pid in descendants):
        fail("nested wrapper/admin descendant was not live before supervisor death")
    all_service_pids = cgroup_pids(state["ControlGroup"], "preflight")
    if not set(descendants) <= set(all_service_pids):
        fail("recorded nested processes are outside the fixed unit control group")
    keeper_pid = read_pid("/run/nmcp-ci/lock-keeper.pid", "preflight")
    lock_identity = os_call("transaction-lock", "stat", "transaction", os.stat,
                            "/run/nmcp-ci/transaction.lock")
    if keeper_pid == main_pid or keeper_pid not in all_service_pids or not process_has_inode(
            keeper_pid, (lock_identity.st_dev, lock_identity.st_ino), "preflight"):
        fail("independent in-cgroup lock keeper does not hold the transaction lock inode")

    # The requesting client is deliberately distinct from the service. Its
    # death must neither release transaction serialization nor kill the unit.
    os_call("preflight", "kill", "process", os.kill, first.pid, signal.SIGKILL)
    process_wait("client-death", first, 30)
    orphaned = show("client-death", "InvocationID", "ActiveState")
    if orphaned.get("InvocationID") != invocation or orphaned.get("ActiveState") != "active":
        fail("client death changed the running service invocation")
    second = run("client-death", ("/usr/bin/python3", "-I", "-S", client, repo, commit, go_binary),
                 stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    if second.returncode == 0 or not any(message in second.stderr for message in ("occupied", "control group is not empty")):
        fail("second invocation overlapped the live orphaned client service")
    os_call("service-death", "kill", "process", os.kill, main_pid, signal.SIGKILL)
    assert_keeper_lock_coherent(keeper_pid, (lock_identity.st_dev, lock_identity.st_ino))
    deadline = time.monotonic() + 20
    while show("service-death", "InvocationID", "ActiveState")["ActiveState"] not in (
            "inactive", "failed"):
        if time.monotonic() >= deadline:
            fail("systemd did not bound containment teardown")
        time.sleep(0.1)
    if (cgroup_pids(state["ControlGroup"], "service-death")
            or any(pid_exists(pid, "service-death") for pid in all_service_pids)):
        fail("a service descendant escaped KillMode=control-group")
    lock = open_transaction_lock()
    try:
        if not lock_transaction(lock):
            fail("transaction lock remained held after containment teardown")
    finally:
        close_transaction_lock(lock)
    # This harness killed the nonce-owning client and then its supervisor. A
    # different launch nonce must not authorize a later client to name-clean it.
    run("service-death", ("/usr/bin/systemctl", "reset-failed", UNIT), check=True,
        stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    wait_unit_absent("service-death")

    # Client A must retain client.lock after its service reaches terminal state.
    # Client B cannot reap/reuse the name until A attests and fully unloads it.
    for name in ("client-terminal-race-a", "client-terminal-race-a-unloaded",
                  "client-terminal-race-b"):
        reset_signal_paths("terminal-race", name)
    attempting_b = "/run/nmcp-ci/client-terminal-race-b.attempting"
    acquired_b = "/run/nmcp-ci/client-terminal-race-b.acquired"
    started_b = "/run/nmcp-ci/client-terminal-race-b.started"
    reset_paths("terminal-race", attempting_b, acquired_b, started_b)
    recovered = popen("terminal-race",
        ("/usr/bin/python3", "-I", "-S", client, repo, commit, go_binary, "client-terminal-race-a"),
        cwd="/", env=ENV, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True,
    )
    wait_path("terminal-race", "/run/nmcp-ci/client-terminal-race-a.ready")
    terminal_a = show("terminal-race", "InvocationID", "ActiveState", "SubState", "ControlGroup")
    invocation_a = terminal_a["InvocationID"]
    if terminal_a["ActiveState"] != "active" or terminal_a["SubState"] != "exited":
        fail("client A did not pause at terminal state: " + sanitized_state(terminal_a))
    waiting = popen("terminal-race",
        ("/usr/bin/python3", "-I", "-S", client, repo, commit, go_binary, "client-terminal-race-b"),
        cwd="/", env=ENV, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True,
    )
    wait_path("terminal-race", attempting_b, timeout=30)
    if (waiting.poll() is not None or path_exists("terminal-race", "marker", acquired_b)
            or path_exists("terminal-race", "marker", started_b)
            or path_exists("terminal-race", "marker", "/run/nmcp-ci/client-terminal-race-b.ready")):
        fail("client B did not block behind terminal-state client A")
    if show("terminal-race", "InvocationID")["InvocationID"] != invocation_a:
        fail("client B replaced client A before A unloaded")
    release("terminal-race", "client-terminal-race-a")
    wait_path("terminal-race", "/run/nmcp-ci/client-terminal-race-a-unloaded.ready", timeout=60)
    if show("terminal-race", "LoadState").get("LoadState") != "not-found":
        fail("client A reported teardown before the fixed name unloaded")
    if (waiting.poll() is not None or path_exists("terminal-race", "marker", acquired_b)
            or path_exists("terminal-race", "marker", started_b)
            or path_exists("terminal-race", "marker", "/run/nmcp-ci/client-terminal-race-b.ready")):
        fail("client B acquired client.lock before A confirmed unload")
    release("terminal-race", "client-terminal-race-a-unloaded")
    recovered_stdout, recovered_stderr = process_communicate("terminal-race", recovered, 60)
    if recovered.returncode:
        fail(f"clean recovery client A failed with status {recovered.returncode}; "
             f"stdout_present={bool(recovered_stdout)}; stderr_present={bool(recovered_stderr)}")
    wait_path("terminal-race", acquired_b, timeout=60)
    wait_path("terminal-race", started_b, timeout=60)
    wait_path("terminal-race", "/run/nmcp-ci/client-terminal-race-b.ready", timeout=60)
    terminal_b = show("terminal-race", "InvocationID", "ActiveState")
    if terminal_b["InvocationID"] == invocation_a:
        fail("client B did not launch a distinct post-unload invocation")
    release("terminal-race", "client-terminal-race-b")
    process_communicate("terminal-race", waiting, 60)
    if waiting.returncode == 0:
        fail("client B fault transaction unexpectedly succeeded")
    if path_exists("terminal-race", "cleanup-intent", "/run/nmcp-ci/cleanup-intent.json"):
        # B intentionally SIGKILLed its supervisor after proving serialization;
        # the following invocation must recover this durable intent.
        pass
    if prior is not None:
        assert_replaced_or_absent(prior["target"], prior["target_identity"])

    # Replace an owned unit behind a paused client. Its finally block must
    # detect InvocationID loss and never issue a name-based command to B.
    reset_signal_paths("name-reuse", "client-reuse-pause")
    replaced = popen("name-reuse",
        ("/usr/bin/python3", "-I", "-S", client, repo, commit, go_binary, "client-reuse-pause"),
        cwd="/", env=ENV, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True,
    )
    wait_path("name-reuse", "/run/nmcp-ci/client-reuse-pause.ready", timeout=60)
    replaced_a = show("name-reuse", "InvocationID", "ActiveState", "ControlGroup", "Environment")
    replaced_invocation = replaced_a["InvocationID"]
    replaced_environment = replaced_a["Environment"]
    run("name-reuse", ("/usr/bin/systemctl", "kill", "--kill-whom=all", "--signal=KILL", UNIT),
        check=False, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    deadline = time.monotonic() + 20
    while show("name-reuse", "InvocationID", "ActiveState")["ActiveState"] not in (
            "failed", "inactive"):
        if time.monotonic() >= deadline:
            fail("reused-name source invocation did not stop")
        time.sleep(0.1)
    if show("name-reuse", "InvocationID")["InvocationID"] != replaced_invocation:
        fail("reused-name source changed before reset")
    run("name-reuse", ("/usr/bin/systemctl", "reset-failed", UNIT), check=True,
        stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    wait_unit_absent("name-reuse")
    sentinel_nonce = secrets.token_hex(32)
    if replaced_environment == f"NMCP_VERIFIER_NONCE={sentinel_nonce}":
        fail("reused-name counterexample accidentally reused client A's nonce")
    sentinel = run("name-reuse", ("/usr/bin/systemd-run", "--quiet", f"--unit={UNIT}", "--service-type=exec",
                    f"--description=NMCP migration role verifier {sentinel_nonce}",
                    f"--property=Environment=NMCP_VERIFIER_NONCE={sentinel_nonce}",
                    "--property=KillMode=control-group", "/usr/bin/sleep", "300"),
                   check=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    del sentinel
    sentinel_state = show("name-reuse", "InvocationID", "ActiveState", "MainPID", "Environment")
    sentinel_invocation = sentinel_state["InvocationID"]
    if sentinel_invocation == replaced_invocation or sentinel_state["ActiveState"] != "active":
        fail("reused-name sentinel did not own a distinct live invocation")
    if sentinel_state.get("Environment") != f"NMCP_VERIFIER_NONCE={sentinel_nonce}":
        fail("reused-name sentinel did not expose its mismatched nonce")
    release("name-reuse", "client-reuse-pause")
    process_communicate("name-reuse", replaced, 60)
    if replaced.returncode == 0 or "launch identity lost" not in replaced.stderr:
        fail("client did not fail safely after fixed-name ownership loss")
    after_replaced = show("name-reuse", "InvocationID", "ActiveState", "MainPID")
    if after_replaced["InvocationID"] != sentinel_invocation or after_replaced["ActiveState"] != "active":
        fail("old client teardown touched the reused-name sentinel")
    run("name-reuse", ("/usr/bin/systemctl", "kill", "--kill-whom=all", "--signal=KILL", UNIT), check=False,
        stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    deadline = time.monotonic() + 20
    while show("name-reuse", "ActiveState").get("ActiveState") not in ("failed", "inactive"):
        if time.monotonic() >= deadline:
            fail("reused-name sentinel did not stop")
        time.sleep(0.1)
    run("name-reuse", ("/usr/bin/systemctl", "reset-failed", UNIT), check=False,
        stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    wait_unit_absent("name-reuse")

    retained = run("retained-cleanup", ("/usr/bin/python3", "-I", "-S", client, repo, commit, go_binary,
                    "retained-cleanup-dependency"), stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    if retained.returncode == 0:
        fail("retained database dependency did not fail cleanup")
    if "Ubuntu migration role compatibility verification passed" in retained.stdout:
        fail("failed retained-dependency cleanup emitted success")
    if (CLEANUP_DATABASE_FAILURE not in retained.stderr
            or CLEANUP_ROLES_FAILURE not in retained.stderr):
        fail("cleanup did not independently report database and role failures")
    recovered = run("retained-cleanup", ("/usr/bin/python3", "-I", "-S", client, repo, commit, go_binary),
                    stdout=None, stderr=None)
    if (recovered.returncode
            or path_exists("retained-cleanup", "cleanup-intent",
                           "/run/nmcp-ci/cleanup-intent.json")):
        fail("retained-dependency recovery did not harden and clean")
    marker_suffixes = (".ready", ".release", ".attempting", ".acquired", ".started")
    for name in (*client_faults,):
        for suffix in marker_suffixes:
            reset_paths("client-fault", f"/run/nmcp-ci/{name}{suffix}")
    for suffix in marker_suffixes:
        reset_paths("work-budget", f"/run/nmcp-ci/{budget_mode}{suffix}")
        reset_paths("slow-cleanup", f"/run/nmcp-ci/{slow_mode}{suffix}")
    for name in ("client-terminal-race-a", "client-terminal-race-a-unloaded",
                 "client-terminal-race-b"):
        for suffix in marker_suffixes:
            reset_paths("terminal-race", f"/run/nmcp-ci/{name}{suffix}")
    for suffix in marker_suffixes:
        reset_paths("name-reuse", f"/run/nmcp-ci/client-reuse-pause{suffix}")
    for signal_name in ("int", "term", "hup", "quit"):
        for boundary in ("kill", "stop", "wait", "reset", "unload"):
            reset_paths("signal-cleanup",
                        f"/run/nmcp-ci/client-signal-{signal_name}-{boundary}.ready")
    for boundary in ("show", "kill", "stop", "wait", "reset", "unload"):
        mode = f"client-cleanup-fault-{boundary}"
        reset_paths("transient-cleanup", *fault_paths(mode, boundary),
                    f"/run/nmcp-ci/{mode}.blocked", f"/run/nmcp-ci/{mode}.release")
        mode = f"client-cleanup-persistent-{boundary}"
        reset_paths("persistent-cleanup", *fault_paths(mode, boundary),
                    f"/run/nmcp-ci/{mode}.blocked", f"/run/nmcp-ci/{mode}.release")
    reset_paths("intent-window", "/run/nmcp-ci/cleanup-intent.ready",
                "/run/nmcp-ci/cleanup-intent.ready.new")
    for mode, boundary in property_boundaries.items():
        reset_paths("transient-cleanup", *fault_paths(mode, boundary))
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except Exception as error:
        write_diagnostic(sys.stderr.buffer, error)
        raise SystemExit(1)
