#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
script="$root/scripts/validation-env"
compose_file="$root/infra/validation/compose.yaml"
owner=$(printf '%s' "$root" | sha256sum | cut -c1-64)
owner_short=$(printf '%s' "$owner" | cut -c1-12)
project=${NMCP_VALIDATION_PROJECT:-nmcp-validation-$owner_short}
api_port=${NMCP_API_PORT:-18080}
files_port=${NMCP_FILES_PORT:-18443}
export NMCP_VALIDATION_OWNER=$owner NMCP_API_PORT=$api_port NMCP_FILES_PORT=$files_port
validation_dir="$root/.validation"
input_parent="$validation_dir/compose-inputs"
input_root=
input_helper="$root/scripts/validation-inputs"

case "$project" in
  ""|[!a-z0-9]*|*[!a-z0-9_-]*)
    echo "error: invalid NMCP_VALIDATION_PROJECT: $project" >&2
    exit 2
    ;;
esac

if [ "${NMCP_VALIDATION_INPUTS_MANAGED:-}" != 1 ] ||
   [ "${NMCP_VALIDATION_INPUTS_PROJECT:-}" != "$project" ]; then
  unset NMCP_VALIDATION_INPUTS_MANAGED NMCP_VALIDATION_INPUTS_FD NMCP_VALIDATION_INPUTS_PROJECT
  exec python3 "$input_helper" invoke "$root" "$project" "$script" "$@"
fi

validation_inputs() {
  python3 "$input_helper" client "$@"
}

export_compose_inputs() {
  export NMCP_POSTGRES_INIT_SQL="$input_root/postgres-init.sql"
  export NMCP_RUNTIME_ROLES_SQL="$input_root/runtime-roles.sql"
  export NMCP_UBUNTU_ROLES_SQL="$input_root/postgresql-roles.sql"
  export NMCP_VERIFY_ROLE_GRAPH_SQL="$input_root/verify-runtime-role-graph.sql"
  export NMCP_VERIFY_RUNTIME_ROLES_SQL="$input_root/verify-runtime-roles.sql"
}

stage_compose_inputs() {
  if [ -n "$input_root" ]; then
    verify_compose_inputs
    return
  fi
  basename=$(validation_inputs stage)
  input_root="$input_parent/$basename"
  export_compose_inputs
}

verify_compose_inputs() {
  validation_inputs verify
}

remove_compose_inputs() {
  validation_inputs cleanup
  input_root=
}

register_compose_inputs() {
  validation_inputs register
}

load_registered_inputs() {
  load_command=${1:-load}
  registered=$(validation_inputs "$load_command")
  [ -n "$registered" ] || return 0
  input_root="$input_parent/$registered"
  export_compose_inputs
}

expect_compose_inputs_denied() {
  label=$1
  if verify_compose_inputs >/dev/null 2>&1; then
    echo "error: Compose input verifier accepted $label" >&2
    exit 1
  fi
}

restage_postgres_init() {
  validation_inputs restage postgres-init.sql
}

check_compose_input_negatives() {
  stage_compose_inputs
  target="$input_root/postgres-init.sql"

  rm -- "$target"
  ln -s "$root/infra/validation/postgres-init.sql" "$target"
  expect_compose_inputs_denied "symlink replacement"
  rm -- "$target"
  restage_postgres_init

  printf '\n-- unexpected replacement\n' >>"$target"
  expect_compose_inputs_denied "wrong content replacement"
  restage_postgres_init

  chmod 0600 "$target"
  expect_compose_inputs_denied "container-unreadable mode"
  restage_postgres_init

  rm -- "$target"
  expect_compose_inputs_denied "missing staged input"
  restage_postgres_init

  docker run --rm --entrypoint sh --volume "$input_root:/stage" \
    postgres:17-alpine@sha256:b0f9560a2de083e2cc7382e75f808c7381a32852a7ec49117deedb300e552b24 \
    -c 'chown 0:0 /stage/postgres-init.sql'
  expect_compose_inputs_denied "wrong staged owner"
  rm -- "$target"
  restage_postgres_init
}

check_staging_security() (
  source_modes_before=$(stat -c '%a:%u:%g:%n' \
    "$root/infra/validation/postgres-init.sql" \
    "$root/infra/postgresql/runtime-roles.sql" \
    "$root/infra/ubuntu/postgresql-roles.sql" \
    "$root/infra/postgresql/verify-runtime-role-graph.sql" \
    "$root/infra/validation/verify-runtime-roles.sql")
  python3 "$input_helper" self-test
  registered=$(validation_inputs load)
  if [ -n "$registered" ]; then
    input_root="$input_parent/$registered"
    export_compose_inputs
  else
    stage_compose_inputs
    trap remove_compose_inputs EXIT HUP INT TERM
    register_compose_inputs
  fi
  verify_compose_inputs
  validation_inputs run python3 -c '
import os
names = (
    "NMCP_POSTGRES_INIT_SQL",
    "NMCP_RUNTIME_ROLES_SQL",
    "NMCP_UBUNTU_ROLES_SQL",
    "NMCP_VERIFY_ROLE_GRAPH_SQL",
    "NMCP_VERIFY_RUNTIME_ROLES_SQL",
)
for name in names:
    path = os.environ[name]
    assert path.startswith("/proc/") and "/fd/" in path
    assert open(path, "rb").read()
'
  volume=$(validation_inputs publish)
  [ "$(validation_inputs publish)" = "$volume" ]
  [ "$(validation_inputs volume-test)" = "$volume" ]
  input_image=$(validation_inputs image-test)
  case "$input_image" in sha256:*) ;; *) echo "error: immutable input image is not content-addressed" >&2; return 1 ;; esac
  validation_inputs run sh -eu -c '
test "$NMCP_POSTGRES_INPUT_IMAGE" = "$2"
docker run --rm --network none --entrypoint sh \
  --volume "$1:/inputs:ro" \
  postgres:17-alpine@sha256:b0f9560a2de083e2cc7382e75f808c7381a32852a7ec49117deedb300e552b24 \
  -eu -c "test ! -e /inputs/.nmcp-complete"
docker run --rm --network none --read-only --entrypoint sh "$2" \
  -eu -c "test -s /docker-entrypoint-initdb.d/10-nmcp-roles.sql; test -s /opt/nmcp-infra/postgresql/runtime-roles.sql; test -s /opt/nmcp-input-manifest/.nmcp-complete"
  ' sh "$volume" "$input_image"
  if [ -z "$registered" ]; then
    validation_inputs docker-reset
    remove_compose_inputs
    trap - EXIT HUP INT TERM
  fi
  source_modes_after=$(stat -c '%a:%u:%g:%n' \
    "$root/infra/validation/postgres-init.sql" \
    "$root/infra/postgresql/runtime-roles.sql" \
    "$root/infra/ubuntu/postgresql-roles.sql" \
    "$root/infra/postgresql/verify-runtime-role-graph.sql" \
    "$root/infra/validation/verify-runtime-roles.sql")
  [ "$source_modes_after" = "$source_modes_before" ] || {
    echo "error: Compose input source modes or ownership changed during staging" >&2
    return 1
  }

  kill_project="${project}-killed-publisher"
  kill_dir=$(mktemp -d "$validation_dir/killed-publisher.XXXXXX")
  chmod 0700 "$kill_dir"
  ready="$kill_dir/ready"
  publisher_pid=
  cleanup_killed_publisher() {
    if [ -n "$publisher_pid" ] && kill -0 "$publisher_pid" 2>/dev/null; then
      kill -KILL "$publisher_pid" 2>/dev/null || true
      wait "$publisher_pid" 2>/dev/null || true
    fi
    NMCP_VALIDATION_PROJECT=$kill_project "$script" reset >/dev/null 2>&1 || true
    rm -rf -- "$kill_dir"
  }
  trap cleanup_killed_publisher EXIT HUP INT TERM
  NMCP_VALIDATION_PROJECT=$kill_project NMCP_VALIDATION_KILL_TEST=1 \
    NMCP_VALIDATION_KILL_READY=$ready "$script" kill-publish-test \
    >"$kill_dir/publisher.log" 2>&1 &
  publisher_pid=$!
  attempts=0
  while [ ! -s "$ready" ]; do
    kill -0 "$publisher_pid" 2>/dev/null || {
      echo "error: killed-publisher fixture exited before publishing a partial volume" >&2
      return 1
    }
    attempts=$((attempts + 1))
    [ "$attempts" -lt 300 ] || {
      echo "error: timed out waiting for partial Compose input volume" >&2
      return 1
    }
    sleep 0.1
  done
  partial_volume=$(cat "$ready")
  docker run --rm --network none --volume "$partial_volume:/inputs:ro" --entrypoint sh \
    postgres:17-alpine@sha256:b0f9560a2de083e2cc7382e75f808c7381a32852a7ec49117deedb300e552b24 \
    -eu -c 'test "$(cat /inputs/infra/partial)" = killed-partial; test ! -e /inputs/.nmcp-complete'
  kill -KILL "$publisher_pid"
  if wait "$publisher_pid" 2>/dev/null; then
    echo "error: killed validation input supervisor exited successfully" >&2
    return 1
  fi
  publisher_pid=
  killed_child=$(cat "$ready.child")
  attempts=0
  while kill -0 "$killed_child" 2>/dev/null; do
    attempts=$((attempts + 1))
    [ "$attempts" -lt 100 ] || {
      echo "error: killed publisher child did not terminate" >&2
      return 1
    }
    sleep 0.1
  done
  NMCP_VALIDATION_PROJECT=$kill_project "$script" recover-publish-test
  NMCP_VALIDATION_PROJECT=$kill_project "$script" reset >/dev/null 2>&1
  trap - EXIT HUP INT TERM
  rm -rf -- "$kill_dir"
)

compose() {
  stage_compose_inputs
  validation_inputs publish >/dev/null
  validation_inputs run docker compose --project-name "$project" --file "$compose_file" "$@"
}

require_tools() {
  for tool in docker curl git python3 sha256sum; do
    command -v "$tool" >/dev/null 2>&1 || { echo "error: $tool is required" >&2; exit 1; }
  done
  docker compose version >/dev/null 2>&1 || { echo "error: docker compose v2 is required" >&2; exit 1; }
}

assert_owned() {
  for type in container volume network; do
    case "$type" in
      container) resources=$(docker container ls --all --quiet --filter "label=com.docker.compose.project=$project") ;;
      volume) resources=$(docker volume ls --quiet --filter "label=com.docker.compose.project=$project") ;;
      network) resources=$(docker network ls --quiet --filter "label=com.docker.compose.project=$project") ;;
    esac
    for resource in $resources; do
      case "$type" in
        container) actual=$(docker container inspect --format '{{ index .Config.Labels "com.nmcp.validation.owner" }}' "$resource") ;;
        *) actual=$(docker "$type" inspect --format '{{ index .Labels "com.nmcp.validation.owner" }}' "$resource") ;;
      esac
      if [ "$actual" != "$owner" ]; then
        echo "error: refusing to operate on $type $resource for project $project: owner mismatch" >&2
        return 1
      fi
    done
  done
}

cleanup() {
  cleanup_status=0
  validation_inputs docker-reset || cleanup_status=1
  remove_compose_inputs || cleanup_status=1
  return "$cleanup_status"
}

prepare_storage() {
  compose run --rm --no-deps storage-init
}

check_legacy_quarantine_guard() {
  compose run --rm --no-deps --entrypoint sh storage-init -eu -c '
    mkdir -p /var/lib/nmcp/media/quarantine
  '
  if prepare_storage >/dev/null 2>&1; then
    echo "error: storage initialization accepted empty legacy dotless quarantine" >&2
    exit 1
  fi
  compose run --rm --no-deps --entrypoint sh storage-init -eu -c '
    rmdir /var/lib/nmcp/media/quarantine
  '
  compose run --rm --no-deps --entrypoint sh storage-init -eu -c '
    mkdir -p /var/lib/nmcp/media/quarantine
    printf legacy-sentinel >/var/lib/nmcp/media/quarantine/private-sentinel
  '
  if prepare_storage >/dev/null 2>&1; then
    echo "error: storage initialization accepted legacy dotless quarantine" >&2
    exit 1
  fi
  compose run --rm --no-deps --entrypoint sh storage-init -eu -c '
    [ "$(cat /var/lib/nmcp/media/quarantine/private-sentinel)" = legacy-sentinel ]
    rm /var/lib/nmcp/media/quarantine/private-sentinel
    rmdir /var/lib/nmcp/media/quarantine
  '
}

write_fixture() {
  compose run --rm --no-deps --entrypoint sh api -eu -c '
    original=/var/lib/nmcp/media/originals/00/00000000-0000-4000-8000-000000000000
    rendition=/var/lib/nmcp/media/renditions/00/00000000-0000-4000-8000-000000000000/11111111-1111-4111-8111-111111111111
    symlink=/var/lib/nmcp/media/originals/33/33333333-3333-4333-8333-333333333333
    rendition_symlink=/var/lib/nmcp/media/renditions/44/44444444-4444-4444-8444-444444444444/55555555-5555-4555-8555-555555555555
    wrong_original=/var/lib/nmcp/media/originals/ff/00000000-0000-4000-8000-000000000000
    wrong_rendition=/var/lib/nmcp/media/renditions/ff/00000000-0000-4000-8000-000000000000/11111111-1111-4111-8111-111111111111
    mkdir -p "$original" "$rendition" "$symlink" "$rendition_symlink" "$wrong_original" "$wrong_rendition" /var/lib/nmcp/media/backups
    printf "0123456789abcdef" >"$original/original.jpg"
    printf "rendition-webp!" >"$rendition/22222222-2222-4222-8222-222222222222.webp"
    printf "wrong-original" >"$wrong_original/original.jpg"
    printf "wrong-rendition" >"$wrong_rendition/22222222-2222-4222-8222-222222222222.webp"
    printf "private-sentinel" >/var/lib/nmcp/media/backups/secret.dump
    printf "quarantine-sentinel" >/var/lib/nmcp/media/.quarantine/private-sentinel
    rm -f "$symlink/original.jpg"
    ln -s /etc/passwd "$symlink/original.jpg"
    rm -f "$rendition_symlink/66666666-6666-4666-8666-666666666666.webp"
    ln -s /etc/passwd "$rendition_symlink/66666666-6666-4666-8666-666666666666.webp"
    chmod 0600 "$original/original.jpg" "$rendition/22222222-2222-4222-8222-222222222222.webp" \
      "$wrong_original/original.jpg" "$wrong_rendition/22222222-2222-4222-8222-222222222222.webp" \
      /var/lib/nmcp/media/backups/secret.dump /var/lib/nmcp/media/.quarantine/private-sentinel
  '
}

start_environment() {
  prepare_storage
  if ! compose up --build --detach --wait; then
    # Compose cannot express an always-run dependency. Force the same hardened
    # exact graph after a failed migration before cleanup destroys the fixture.
    compose run --rm --no-deps role-harden || true
    compose logs migrate role-compatibility role-harden >&2 || true
    return 1
  fi
  write_fixture
}

write_retention_markers() {
  compose exec -T api sh -eu -c 'printf "%s" "$1" >/var/lib/nmcp/media/backups/retained.marker; chmod 0600 /var/lib/nmcp/media/backups/retained.marker' sh "$retention_token"
  compose exec -T postgres psql --username nmcp_migrator --dbname nmcp --set ON_ERROR_STOP=1 --command \
    "CREATE TABLE validation_retention_marker (value text PRIMARY KEY); INSERT INTO validation_retention_marker VALUES ('$retention_token');"
}

assert_retention_markers() {
  compose exec -T api sh -eu -c '[ "$(cat /var/lib/nmcp/media/backups/retained.marker)" = "$1" ]' sh "$retention_token"
  value=$(compose exec -T postgres psql --username nmcp_migrator --dbname nmcp --tuples-only --no-align --set ON_ERROR_STOP=1 --command \
    "SELECT value FROM validation_retention_marker;")
  [ "$value" = "$retention_token" ] || { echo "error: database retention marker was not preserved" >&2; exit 1; }
}

expect_status() {
  expected=$1
  shift
  actual=$(curl --insecure --silent --output /dev/null --write-out '%{http_code}' "$@")
  if [ "$actual" != "$expected" ]; then
    echo "error: expected HTTP $expected, got $actual: curl $*" >&2
    exit 1
  fi
}

fetch() {
  expected=$1
  output=$2
  headers=$3
  shift 3
  actual=$(curl --insecure --silent --show-error --dump-header "$headers" --output "$output" --write-out '%{http_code}' "$@")
  [ "$actual" = "$expected" ] || { echo "error: expected HTTP $expected, got $actual" >&2; exit 1; }
}

assert_header() {
  pattern=$1
  file=$2
  grep -Eiq "$pattern" "$file" || { echo "error: missing response header matching $pattern" >&2; exit 1; }
}

assert_running() {
  service=$1
  id=$(compose ps --quiet "$service")
  [ -n "$id" ] || { echo "error: $service container is absent" >&2; exit 1; }
  [ "$(docker inspect --format '{{.State.Running}}' "$id")" = true ] || { echo "error: $service is not running" >&2; exit 1; }
}

database_query() {
  user=$1
  password=$2
  shift 2
  compose exec -T -e "PGPASSWORD=$password" postgres \
    psql --host 127.0.0.1 --username "$user" --dbname nmcp --set ON_ERROR_STOP=1 "$@"
}

expect_database_denied() {
  user=$1
  password=$2
  statement=$3
  if database_query "$user" "$password" --command "$statement" >/dev/null 2>&1; then
    echo "error: database role $user executed forbidden statement: $statement" >&2
    exit 1
  fi
}

runtime_migration_command() {
  user=$1
  password=$2
  action=$3
  compose run --rm --no-deps \
    -e "NMCP_DATABASE_URL=postgres://$user:$password@postgres:5432/nmcp?sslmode=disable" \
    migrate nmcp-admin migrate "$action" --json
}

run_ubuntu_role_bootstrap() {
  local mode=${1:-FALSE}
  compose exec -T postgres psql --username nmcp_bootstrap --dbname nmcp \
    --set ON_ERROR_STOP=1 --set "nmcp_migration_compatibility=$mode" \
    --file /opt/nmcp-infra/ubuntu/postgresql-roles.sql
}

expect_ubuntu_role_bootstrap_denied() {
  label=$1
  mode=${2:-FALSE}
  if run_ubuntu_role_bootstrap "$mode" >/dev/null 2>&1; then
    echo "error: Ubuntu PostgreSQL bootstrap accepted $label" >&2
    exit 1
  fi
}

bootstrap_catalog_value() {
  compose exec -T postgres psql --username nmcp_bootstrap --dbname nmcp \
    --tuples-only --no-align --set ON_ERROR_STOP=1 --command "$1"
}

run_runtime_role_verifier() {
  compose exec -T postgres psql --username nmcp_bootstrap --dbname nmcp \
    --set ON_ERROR_STOP=1 --file /opt/nmcp-infra/validation/verify-runtime-roles.sql
}

expect_runtime_role_verifier_denied() {
  label=$1
  if verifier_output=$(run_runtime_role_verifier 2>&1); then
    echo "error: runtime role verifier accepted $label" >&2
    exit 1
  fi
  # The catalog error contains no connection string or credential. Keep its
  # SQLSTATE/cause visible so a rejected counterexample remains auditable.
  printf 'expected runtime role verifier rejection (%s):\n%s\n' \
    "$label" "$verifier_output" >&2
}

check_runtime_role_verifier_negatives() {
  compose exec -T postgres psql --username nmcp_bootstrap --dbname nmcp \
    --set ON_ERROR_STOP=1 --command \
    "ALTER FUNCTION public.nmcp_append_check_finding(nmcp_uuid_v4,nmcp_uuid_v4,text,text,text,nmcp_uuid_v4,nmcp_uuid_v4,nmcp_uuid_v4,nmcp_uuid_v4,nmcp_uuid_v4,nmcp_uuid_v4,text,text,bigint,text,text,bigint,text,timestamptz,timestamptz,timestamptz) SECURITY INVOKER"
  expect_runtime_role_verifier_denied "check API SECURITY INVOKER drift"
  compose exec -T postgres psql --username nmcp_bootstrap --dbname nmcp \
    --set ON_ERROR_STOP=1 --command \
    "ALTER FUNCTION public.nmcp_append_check_finding(nmcp_uuid_v4,nmcp_uuid_v4,text,text,text,nmcp_uuid_v4,nmcp_uuid_v4,nmcp_uuid_v4,nmcp_uuid_v4,nmcp_uuid_v4,nmcp_uuid_v4,text,text,bigint,text,text,bigint,text,timestamptz,timestamptz,timestamptz) SECURITY DEFINER"

  compose exec -T postgres psql --username nmcp_bootstrap --dbname nmcp \
    --set ON_ERROR_STOP=1 --command \
    "GRANT EXECUTE ON FUNCTION public.nmcp_begin_repair_run(nmcp_uuid_v4,nmcp_uuid_v4,nmcp_uuid_v4,text) TO PUBLIC"
  expect_runtime_role_verifier_denied "repair API PUBLIC EXECUTE drift"
  compose exec -T postgres psql --username nmcp_bootstrap --dbname nmcp \
    --set ON_ERROR_STOP=1 --command \
    "REVOKE EXECUTE ON FUNCTION public.nmcp_begin_repair_run(nmcp_uuid_v4,nmcp_uuid_v4,nmcp_uuid_v4,text) FROM PUBLIC"

  compose exec -T postgres psql --username nmcp_bootstrap --dbname nmcp \
    --set ON_ERROR_STOP=1 --command \
    "ALTER FUNCTION public.nmcp_finish_repair_run(nmcp_uuid_v4) OWNER TO nmcp_check_function_owner"
  expect_runtime_role_verifier_denied "repair API owner drift"
  compose exec -T postgres psql --username nmcp_bootstrap --dbname nmcp \
    --set ON_ERROR_STOP=1 --command \
    "ALTER FUNCTION public.nmcp_finish_repair_run(nmcp_uuid_v4) OWNER TO nmcp_repair_function_owner; \
REVOKE ALL ON FUNCTION public.nmcp_finish_repair_run(nmcp_uuid_v4) FROM nmcp_check_function_owner; \
GRANT EXECUTE ON FUNCTION public.nmcp_finish_repair_run(nmcp_uuid_v4) TO nmcp_repair_runtime"

  compose exec -T postgres psql --username nmcp_bootstrap --dbname nmcp \
    --set ON_ERROR_STOP=1 --command \
    "ALTER FUNCTION public.nmcp_prepare_repair_manifest_item(nmcp_uuid_v4,nmcp_uuid_v4,nmcp_uuid_v4,nmcp_uuid_v4) SET search_path=pg_catalog,pg_temp"
  expect_runtime_role_verifier_denied "repair API search_path drift"
  compose exec -T postgres psql --username nmcp_bootstrap --dbname nmcp \
    --set ON_ERROR_STOP=1 --command \
    "ALTER FUNCTION public.nmcp_prepare_repair_manifest_item(nmcp_uuid_v4,nmcp_uuid_v4,nmcp_uuid_v4,nmcp_uuid_v4) SET search_path=public,pg_catalog,pg_temp"

  compose exec -T postgres psql --username nmcp_bootstrap --dbname nmcp \
    --set ON_ERROR_STOP=1 --command \
    "GRANT EXECUTE ON FUNCTION public.nmcp_seal_check_report(nmcp_uuid_v4,bigint,timestamptz) TO nmcp_repair_runtime"
  expect_runtime_role_verifier_denied "check API unintended repair EXECUTE drift"
  compose exec -T postgres psql --username nmcp_bootstrap --dbname nmcp \
    --set ON_ERROR_STOP=1 --command \
    "REVOKE EXECUTE ON FUNCTION public.nmcp_seal_check_report(nmcp_uuid_v4,bigint,timestamptz) FROM nmcp_repair_runtime"

  compose exec -T postgres psql --username nmcp_bootstrap --dbname nmcp \
    --set ON_ERROR_STOP=1 --command \
    "REVOKE EXECUTE ON FUNCTION public.nmcp_complete_check_source(nmcp_uuid_v4,text,text) FROM nmcp_check_runtime"
  expect_runtime_role_verifier_denied "check API missing intended EXECUTE"
  compose exec -T postgres psql --username nmcp_bootstrap --dbname nmcp \
    --set ON_ERROR_STOP=1 --command \
    "GRANT EXECUTE ON FUNCTION public.nmcp_complete_check_source(nmcp_uuid_v4,text,text) TO nmcp_check_runtime"

  compose exec -T postgres psql --username nmcp_bootstrap --dbname nmcp \
    --set ON_ERROR_STOP=1 --command \
    "GRANT EXECUTE ON FUNCTION public.nmcp_complete_check_source(nmcp_uuid_v4,text,text) TO nmcp_check_runtime WITH GRANT OPTION"
  expect_runtime_role_verifier_denied "check API EXECUTE grant option drift"
  compose exec -T postgres psql --username nmcp_bootstrap --dbname nmcp \
    --set ON_ERROR_STOP=1 --command \
    "REVOKE GRANT OPTION FOR EXECUTE ON FUNCTION public.nmcp_complete_check_source(nmcp_uuid_v4,text,text) FROM nmcp_check_runtime"

  compose exec -T postgres psql --username nmcp_bootstrap --dbname nmcp \
    --set ON_ERROR_STOP=1 --command \
    "GRANT EXECUTE ON FUNCTION public.nmcp_register_upload_attempt(nmcp_uuid_v4,nmcp_uuid_v4) TO nmcp_runtime WITH GRANT OPTION"
  expect_runtime_role_verifier_denied "upload API EXECUTE grant option drift"
  compose exec -T postgres psql --username nmcp_bootstrap --dbname nmcp \
    --set ON_ERROR_STOP=1 --command \
    "REVOKE GRANT OPTION FOR EXECUTE ON FUNCTION public.nmcp_register_upload_attempt(nmcp_uuid_v4,nmcp_uuid_v4) FROM nmcp_runtime"

  compose exec -T postgres psql --username nmcp_bootstrap --dbname nmcp \
    --set ON_ERROR_STOP=1 --command \
    "GRANT EXECUTE ON FUNCTION public.nmcp_begin_repair_run(nmcp_uuid_v4,nmcp_uuid_v4,nmcp_uuid_v4,text) TO nmcp_repair_runtime WITH GRANT OPTION"
  expect_runtime_role_verifier_denied "repair API EXECUTE grant option drift"
  compose exec -T postgres psql --username nmcp_bootstrap --dbname nmcp \
    --set ON_ERROR_STOP=1 --command \
    "REVOKE GRANT OPTION FOR EXECUTE ON FUNCTION public.nmcp_begin_repair_run(nmcp_uuid_v4,nmcp_uuid_v4,nmcp_uuid_v4,text) FROM nmcp_repair_runtime"

  run_runtime_role_verifier
}

check_role_bootstrap_rerun() {
  # Execute the actual production bootstrap twice and prove it normalizes every
  # membership edge it owns, including concrete API and Worker logins.
  run_ubuntu_role_bootstrap
  compose exec -T postgres psql --username nmcp_bootstrap --dbname nmcp \
    --set ON_ERROR_STOP=1 --command \
    "GRANT nmcp_runtime TO nmcp_worker_runtime,nmcp_api WITH ADMIN TRUE, INHERIT FALSE, SET TRUE; \
GRANT nmcp_worker_runtime TO nmcp_worker WITH ADMIN TRUE, INHERIT FALSE, SET TRUE; \
GRANT nmcp_purge_function_owner,nmcp_check_function_owner,nmcp_repair_function_owner \
TO nmcp_migrator WITH ADMIN TRUE, INHERIT TRUE, SET FALSE;"
  run_ubuntu_role_bootstrap

  # Compatibility mode changes only the three owner-edge inherit bits and is
  # rerunnable from an exact interrupted compatibility state.
  run_ubuntu_role_bootstrap TRUE
  [ "$(bootstrap_catalog_value "SELECT count(*) FROM pg_auth_members WHERE member='nmcp_migrator'::regrole AND roleid IN ('nmcp_purge_function_owner'::regrole,'nmcp_check_function_owner'::regrole,'nmcp_repair_function_owner'::regrole) AND NOT admin_option AND inherit_option AND set_option")" = 3 ]
  run_ubuntu_role_bootstrap TRUE
  run_ubuntu_role_bootstrap

  # Compatibility accepts only the collective all-hardened or all-compatible
  # owner graph. Every partial three-edge state is unsupported drift.
  for pattern in 001 010 011 100 101 110; do
    purge=$(printf '%s' "$pattern" | cut -c1)
    check=$(printf '%s' "$pattern" | cut -c2)
    repair=$(printf '%s' "$pattern" | cut -c3)
    expected_bits="${check}${purge}${repair}"
    [ "$purge" = 1 ] && purge=TRUE || purge=FALSE
    [ "$check" = 1 ] && check=TRUE || check=FALSE
    [ "$repair" = 1 ] && repair=TRUE || repair=FALSE
    compose exec -T postgres psql --username nmcp_bootstrap --dbname nmcp \
      --set ON_ERROR_STOP=1 --command \
      "GRANT nmcp_purge_function_owner TO nmcp_migrator WITH ADMIN FALSE, INHERIT $purge, SET TRUE; \
GRANT nmcp_check_function_owner TO nmcp_migrator WITH ADMIN FALSE, INHERIT $check, SET TRUE; \
GRANT nmcp_repair_function_owner TO nmcp_migrator WITH ADMIN FALSE, INHERIT $repair, SET TRUE"
    expect_ubuntu_role_bootstrap_denied "mixed owner inheritance graph $pattern" TRUE
    [ "$(bootstrap_catalog_value "SELECT string_agg(inherit_option::int::text, '' ORDER BY roleid::regrole::text) FROM pg_auth_members WHERE member='nmcp_migrator'::regrole AND roleid IN ('nmcp_check_function_owner'::regrole,'nmcp_purge_function_owner'::regrole,'nmcp_repair_function_owner'::regrole)")" = "$expected_bits" ] || {
      echo "error: mixed graph $pattern was changed after rejected compatibility preflight" >&2
      exit 1
    }
    run_ubuntu_role_bootstrap
  done

  compose exec -T postgres psql --username nmcp_bootstrap --dbname nmcp \
    --set ON_ERROR_STOP=1 --command "REVOKE nmcp_check_function_owner FROM nmcp_migrator"
  expect_ubuntu_role_bootstrap_denied "missing owner membership" TRUE
  run_ubuntu_role_bootstrap
  compose exec -T postgres psql --username nmcp_bootstrap --dbname nmcp \
    --set ON_ERROR_STOP=1 --command \
    "GRANT nmcp_check_function_owner TO nmcp_migrator WITH ADMIN TRUE, INHERIT FALSE, SET TRUE"
  expect_ubuntu_role_bootstrap_denied "owner membership ADMIN option" TRUE
  run_ubuntu_role_bootstrap
  compose exec -T postgres psql --username nmcp_bootstrap --dbname nmcp \
    --set ON_ERROR_STOP=1 --command \
    "GRANT nmcp_check_function_owner TO nmcp_migrator WITH ADMIN FALSE, INHERIT FALSE, SET FALSE"
  expect_ubuntu_role_bootstrap_denied "owner membership SET option" TRUE
  run_ubuntu_role_bootstrap

  # Compatibility preflight rejects and transactionally preserves even a
  # poison on an otherwise allowed edge; it never normalizes before widening.
  compose exec -T postgres psql --username nmcp_bootstrap --dbname nmcp \
    --set ON_ERROR_STOP=1 --command \
    "GRANT nmcp_runtime TO nmcp_api WITH ADMIN TRUE, INHERIT FALSE, SET TRUE"
  if run_ubuntu_role_bootstrap TRUE >/dev/null 2>&1; then
    echo "error: compatibility preflight normalized a poisoned edge" >&2
    exit 1
  fi
  [ "$(bootstrap_catalog_value "SELECT admin_option::int || ':' || inherit_option::int || ':' || set_option::int FROM pg_auth_members WHERE roleid='nmcp_runtime'::regrole AND member='nmcp_api'::regrole")" = "1:0:1" ]
  run_ubuntu_role_bootstrap

  # Unsafe attributes fail without being normalized behind the operator's back.
  compose exec -T postgres psql --username nmcp_bootstrap --dbname nmcp \
    --set ON_ERROR_STOP=1 --command "ALTER ROLE nmcp_check_runtime LOGIN"
  expect_ubuntu_role_bootstrap_denied "unsafe stable-role attributes"
  [ "$(bootstrap_catalog_value "SELECT rolcanlogin FROM pg_roles WHERE rolname='nmcp_check_runtime'")" = t ]
  compose exec -T postgres psql --username nmcp_bootstrap --dbname nmcp \
    --set ON_ERROR_STOP=1 --command "ALTER ROLE nmcp_check_runtime NOLOGIN"

  # Extra stable nesting is rejected and retained after transactional failure.
  compose exec -T postgres psql --username nmcp_bootstrap --dbname nmcp \
    --set ON_ERROR_STOP=1 --command \
    "GRANT nmcp_repair_runtime TO nmcp_check_runtime WITH ADMIN FALSE, INHERIT FALSE, SET FALSE"
  expect_ubuntu_role_bootstrap_denied "extra stable-role nesting"
  [ "$(bootstrap_catalog_value "SELECT count(*) FROM pg_auth_members WHERE roleid='nmcp_repair_runtime'::regrole AND member='nmcp_check_runtime'::regrole")" = 1 ]
  compose exec -T postgres psql --username nmcp_bootstrap --dbname nmcp \
    --set ON_ERROR_STOP=1 --command "REVOKE nmcp_repair_runtime FROM nmcp_check_runtime"

  # A rogue login directly inheriting a managed login is an inbound edge.
  compose exec -T postgres psql --username nmcp_bootstrap --dbname nmcp \
    --set ON_ERROR_STOP=1 --command \
    "CREATE ROLE nmcp_graph_probe LOGIN; GRANT nmcp_api TO nmcp_graph_probe WITH ADMIN FALSE, INHERIT TRUE, SET TRUE"
  expect_ubuntu_role_bootstrap_denied "rogue inbound login membership"
  compose exec -T postgres psql --username nmcp_bootstrap --dbname nmcp \
    --set ON_ERROR_STOP=1 --command \
    "REVOKE nmcp_api FROM nmcp_graph_probe; DROP ROLE nmcp_graph_probe"

  # A two-hop path into the migrator reaches all function owners. Poison an
  # owned edge too: failed bootstrap must roll its attempted repair back.
  compose exec -T postgres psql --username nmcp_bootstrap --dbname nmcp \
    --set ON_ERROR_STOP=1 --command \
    "CREATE ROLE nmcp_graph_bridge NOLOGIN; CREATE ROLE nmcp_graph_probe LOGIN; \
GRANT nmcp_migrator TO nmcp_graph_bridge WITH ADMIN FALSE, INHERIT FALSE, SET TRUE; \
GRANT nmcp_graph_bridge TO nmcp_graph_probe WITH ADMIN FALSE, INHERIT FALSE, SET TRUE; \
GRANT nmcp_runtime TO nmcp_api WITH ADMIN TRUE, INHERIT FALSE, SET TRUE"
  expect_ubuntu_role_bootstrap_denied "transitive rogue migrator reachability"
  [ "$(bootstrap_catalog_value "SELECT admin_option::int || ':' || inherit_option::int || ':' || set_option::int FROM pg_auth_members WHERE roleid='nmcp_runtime'::regrole AND member='nmcp_api'::regrole")" = "1:0:1" ]
  compose exec -T postgres psql --username nmcp_bootstrap --dbname nmcp \
    --set ON_ERROR_STOP=1 --command \
    "REVOKE nmcp_graph_bridge FROM nmcp_graph_probe; \
REVOKE nmcp_migrator FROM nmcp_graph_bridge; \
DROP ROLE nmcp_graph_probe,nmcp_graph_bridge"
  run_ubuntu_role_bootstrap
}

check_database_role_boundary() {
  for identity in \
    nmcp_migrator:nmcp-migrator-validation-only \
    nmcp_api:nmcp-api-validation-only \
    nmcp_worker:nmcp-worker-validation-only; do
    user=${identity%%:*}
    password=${identity#*:}
    actual=$(database_query "$user" "$password" --tuples-only --no-align --command 'SELECT current_user')
    [ "$actual" = "$user" ] || { echo "error: expected database role $user, got $actual" >&2; exit 1; }
  done
  check_role_bootstrap_rerun
  run_runtime_role_verifier
  check_runtime_role_verifier_negatives
  expect_database_denied nmcp_worker nmcp-worker-validation-only \
    "UPDATE purge_file_progress SET disposition=disposition WHERE false"
  expect_database_denied nmcp_worker nmcp-worker-validation-only \
    "DELETE FROM purge_file_progress WHERE false"
  expect_database_denied nmcp_worker nmcp-worker-validation-only \
    "TRUNCATE purge_file_progress"
  expect_database_denied nmcp_worker nmcp-worker-validation-only \
    "ALTER TABLE purge_file_progress DISABLE TRIGGER ALL"
  expect_database_denied nmcp_worker nmcp-worker-validation-only \
    "CREATE TABLE nmcp_runtime_ddl_probe (id integer)"
  expect_database_denied nmcp_api nmcp-api-validation-only \
    "SELECT * FROM purge_file_progress LIMIT 0"
  for identity in \
    nmcp_api:nmcp-api-validation-only \
    nmcp_worker:nmcp-worker-validation-only; do
    user=${identity%%:*}
    password=${identity#*:}
    runtime_migration_command "$user" "$password" status >/dev/null
    if runtime_migration_command "$user" "$password" up >/dev/null 2>&1; then
      echo "error: runtime database role $user applied migrations" >&2
      exit 1
    fi
    for capability in \
      nmcp_check_runtime nmcp_repair_runtime \
      nmcp_check_function_owner nmcp_repair_function_owner; do
      expect_database_denied "$user" "$password" "SET ROLE $capability"
    done
  done
}

check_processes_and_isolation() {
  assert_running api
  assert_running worker
  assert_running files
  assert_running postgres

  # The bootstrap counterexamples intentionally commit poisoned membership
  # graphs between independent verifier calls. Never expose a live API/Worker
  # connection pool to those states: stop and prove both processes exited
  # cleanly, restore and independently verify the graph, then restart them.
  api_id=$(compose ps --all --quiet api)
  worker_id=$(compose ps --all --quiet worker)
  compose stop api worker
  for service_id in "api:$api_id" "worker:$worker_id"; do
    service=${service_id%%:*}
    id=${service_id#*:}
    [ "$(docker inspect --format '{{.State.Running}}' "$id")" = false ] || {
      echo "error: $service remained live during destructive role probes: $id" >&2
      exit 1
    }
    exit_code=$(docker inspect --format '{{.State.ExitCode}}' "$id")
    if [ "$exit_code" != 0 ]; then
      compose logs --no-color "$service" >&2 || true
      echo "error: $service process did not shut down cleanly before role probes (exit $exit_code): $id" >&2
      exit 1
    fi
  done
  check_database_role_boundary
  compose start api worker
  compose up --detach --wait api worker
  assert_running api
  assert_running worker

  files_id=$(compose ps --quiet files)
  postgres_id=$(compose ps --quiet postgres)
  postgres_image=$(docker inspect --format '{{.Image}}' "$postgres_id")
  case "$postgres_image" in sha256:*) ;; *) echo "error: PostgreSQL consumer did not use an immutable image ID" >&2; exit 1 ;; esac
  [ "$(docker image inspect --format '{{ index .Config.Labels "com.nmcp.validation.kind" }}' "$postgres_image")" = compose-input-image ]
  [ "$(docker image inspect --format '{{ index .Config.Labels "com.nmcp.validation.owner" }}' "$postgres_image")" = "$owner" ]
  [ "$(docker image inspect --format '{{ index .Config.Labels "com.nmcp.validation.project" }}' "$postgres_image")" = "$project" ]
  for sql_service in postgres role-compatibility role-harden; do
    sql_id=$(compose ps --all --quiet "$sql_service")
    [ "$(docker inspect --format '{{.Image}}' "$sql_id")" = "$postgres_image" ] || {
      echo "error: $sql_service did not consume the same immutable SQL image" >&2
      exit 1
    }
    docker inspect "$sql_id" | python3 -c '
import json,sys
container=json.load(sys.stdin)[0]
for mount in (container["HostConfig"].get("Mounts") or []):
    assert mount.get("Target") not in ("/docker-entrypoint-initdb.d","/opt/nmcp-infra"), mount
'
  done
  files_networks=$(docker inspect --format '{{range $name, $_ := .NetworkSettings.Networks}}{{println $name}}{{end}}' "$files_id")
  postgres_networks=$(docker inspect --format '{{range $name, $_ := .NetworkSettings.Networks}}{{println $name}}{{end}}' "$postgres_id")
  [ "$(printf '%s\n' "$files_networks" | grep -c .)" = 1 ]
  [ "$(printf '%s\n' "$postgres_networks" | grep -c .)" = 1 ]
  [ "$files_networks" != "$postgres_networks" ] || { echo "error: File Server shares the PostgreSQL network" >&2; exit 1; }

  docker inspect "$files_id" | python3 -c '
import json, sys
container = json.load(sys.stdin)[0]
expected_volumes = {
    "/srv/nmcp/originals": "originals",
    "/srv/nmcp/renditions": "renditions",
}
configured = container["HostConfig"].get("Mounts") or []
assert len(configured) == 2, configured
for mount in configured:
    target = mount.get("Target")
    assert mount.get("Type") == "volume", mount
    assert target in expected_volumes and mount.get("ReadOnly") is True, mount
    assert (mount.get("VolumeOptions") or {}).get("Subpath") == expected_volumes[target], mount
def size_bytes(value):
    suffixes = {"k": 1024, "m": 1024**2, "g": 1024**3}
    value = value.lower()
    if value[-1:] in suffixes:
        return int(value[:-1]) * suffixes[value[-1]]
    return int(value)
def normalized_tmpfs(value):
    parsed = {}
    for item in value.split(","):
        key, raw = item.split("=", 1)
        assert key not in parsed, value
        if key == "size":
            parsed[key] = size_bytes(raw)
        elif key == "mode":
            # Compose accepts an octal spelling while Engine may report the
            # equivalent numeric mode in decimal through HostConfig.
            parsed[key] = int(raw, 8) if raw.startswith("0") else int(raw)
        elif key in {"uid", "gid"}:
            parsed[key] = int(raw)
        else:
            raise AssertionError(("unexpected tmpfs option", item))
    return parsed
expected_tmpfs = {
    "/var/cache/nginx": {"size": 16 * 1024**2, "mode": 0o700},
    "/var/run": {"size": 1024**2, "mode": 0o700},
    "/tmp": {"size": 4 * 1024**2, "uid": 10001, "gid": 10001, "mode": 0o700},
}
configured_tmpfs = container["HostConfig"].get("Tmpfs") or {}
assert set(configured_tmpfs) == set(expected_tmpfs), configured_tmpfs
for destination, options in configured_tmpfs.items():
    assert normalized_tmpfs(options) == expected_tmpfs[destination], (destination, options)
expected_actual_volumes = {
    ("/srv/nmcp/originals", "volume", False),
    ("/srv/nmcp/renditions", "volume", False),
}
actual = container.get("Mounts") or []
for mount in actual:
    destination = mount.get("Destination")
    assert ".quarantine" not in destination and destination != "/var/lib/nmcp/media", mount
actual_set = {(m.get("Destination"), m.get("Type"), m.get("RW")) for m in actual}
assert len(actual) == len(expected_actual_volumes) and actual_set == expected_actual_volumes, actual
'
  docker exec "$files_id" cat /proc/self/mountinfo | python3 -c '
import sys
expected = {
    "/srv/nmcp/originals": (None, False),
    "/srv/nmcp/renditions": (None, False),
    "/var/cache/nginx": ("tmpfs", True),
    # Alpine resolves the configured /var/run symlink to /run in mountinfo.
    "/run": ("tmpfs", True),
    "/tmp": ("tmpfs", True),
}
actual = {}
for line in sys.stdin:
    fields = line.split()
    separator = fields.index("-")
    destination = fields[4]
    if destination not in expected:
        continue
    assert destination not in actual, (destination, line)
    actual[destination] = (fields[separator + 1], "rw" in fields[5].split(","))
assert set(actual) == set(expected), actual
for destination, (filesystem, writable) in actual.items():
    expected_filesystem, expected_writable = expected[destination]
    if expected_filesystem is not None:
        assert filesystem == expected_filesystem, (destination, filesystem)
    assert writable is expected_writable, (destination, writable)
'

}

check() (
  tmp=$(mktemp -d)
  trap 'rm -rf "$tmp"' EXIT HUP INT TERM
  base="https://127.0.0.1:$files_port"
  original="$base/files/originals/00/00000000-0000-4000-8000-000000000000/original.jpg"
  rendition="$base/files/renditions/00/00000000-0000-4000-8000-000000000000/11111111-1111-4111-8111-111111111111/22222222-2222-4222-8222-222222222222.webp"

  compose exec -T api sh -eu -c '
    [ "$(cat /var/lib/nmcp/media/originals/00/00000000-0000-4000-8000-000000000000/original.jpg)" = 0123456789abcdef ]
    [ "$(cat /var/lib/nmcp/media/renditions/00/00000000-0000-4000-8000-000000000000/11111111-1111-4111-8111-111111111111/22222222-2222-4222-8222-222222222222.webp)" = rendition-webp! ]
    [ "$(cat /var/lib/nmcp/media/backups/secret.dump)" = private-sentinel ]
    [ -L /var/lib/nmcp/media/originals/33/33333333-3333-4333-8333-333333333333/original.jpg ]
    [ -L /var/lib/nmcp/media/renditions/44/44444444-4444-4444-8444-444444444444/55555555-5555-4555-8555-555555555555/66666666-6666-4666-8666-666666666666.webp ]
    [ -f /var/lib/nmcp/media/originals/ff/00000000-0000-4000-8000-000000000000/original.jpg ]
    [ -f /var/lib/nmcp/media/renditions/ff/00000000-0000-4000-8000-000000000000/11111111-1111-4111-8111-111111111111/22222222-2222-4222-8222-222222222222.webp ]
    [ ! -e /var/lib/nmcp/media/quarantine ]
    [ "$(stat -c %u:%g:%a /var/lib/nmcp/media/.quarantine)" = 10001:10001:700 ]
    [ "$(stat -c %d /var/lib/nmcp/media)" = "$(stat -c %d /var/lib/nmcp/media/.quarantine)" ]
    [ "$(cat /var/lib/nmcp/media/.quarantine/private-sentinel)" = quarantine-sentinel ]
  '

  expect_status 200 "http://127.0.0.1:$api_port/healthz"
  expect_status 200 "http://127.0.0.1:$api_port/readyz"
  fetch 200 "$tmp/body" "$tmp/headers" "$original"
  [ "$(cat "$tmp/body")" = 0123456789abcdef ]
  assert_header '^content-type: image/jpeg' "$tmp/headers"
  assert_header '^accept-ranges: bytes' "$tmp/headers"
  assert_header '^cache-control: private, max-age=31536000, immutable' "$tmp/headers"
  assert_header '^x-content-type-options: nosniff' "$tmp/headers"

  fetch 200 "$tmp/rendition" "$tmp/rendition-headers" "$rendition"
  [ "$(cat "$tmp/rendition")" = rendition-webp! ]
  assert_header '^content-type: image/webp' "$tmp/rendition-headers"
  assert_header '^accept-ranges: bytes' "$tmp/rendition-headers"
  assert_header '^cache-control: private, max-age=31536000, immutable' "$tmp/rendition-headers"
  assert_header '^x-content-type-options: nosniff' "$tmp/rendition-headers"

  python3 - "$files_port" "/files/originals/00/00000000-0000-4000-8000-000000000000/original.jpg" 16 image/jpeg <<'PY'
import socket, ssl, sys
port = int(sys.argv[1])
path, size, mime = sys.argv[2:]
ctx = ssl._create_unverified_context()
with socket.create_connection(("127.0.0.1", port), timeout=5) as raw:
    with ctx.wrap_socket(raw, server_hostname="localhost") as conn:
        conn.sendall(f"HEAD {path} HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n".encode())
        response = b""
        while True:
            chunk = conn.recv(65536)
            if not chunk:
                break
            response += chunk
headers, body = response.split(b"\r\n\r\n", 1)
assert headers.startswith(b"HTTP/1.1 200"), headers
assert f"Content-Length: {size}\r\n".encode() in headers + b"\r\n", headers
assert f"Content-Type: {mime}\r\n".encode() in headers + b"\r\n", headers
assert b"Accept-Ranges: bytes\r\n" in headers + b"\r\n", headers
assert b"Cache-Control: private, max-age=31536000, immutable\r\n" in headers + b"\r\n", headers
assert b"X-Content-Type-Options: nosniff\r\n" in headers + b"\r\n", headers
assert body == b"", body
PY
  python3 - "$files_port" "/files/renditions/00/00000000-0000-4000-8000-000000000000/11111111-1111-4111-8111-111111111111/22222222-2222-4222-8222-222222222222.webp" 15 image/webp <<'PY'
import socket, ssl, sys
port = int(sys.argv[1])
path, size, mime = sys.argv[2:]
ctx = ssl._create_unverified_context()
with socket.create_connection(("127.0.0.1", port), timeout=5) as raw:
    with ctx.wrap_socket(raw, server_hostname="localhost") as conn:
        conn.sendall(f"HEAD {path} HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n".encode())
        response = b""
        while True:
            chunk = conn.recv(65536)
            if not chunk:
                break
            response += chunk
headers, body = response.split(b"\r\n\r\n", 1)
assert headers.startswith(b"HTTP/1.1 200"), headers
assert f"Content-Length: {size}\r\n".encode() in headers + b"\r\n", headers
assert f"Content-Type: {mime}\r\n".encode() in headers + b"\r\n", headers
assert b"Accept-Ranges: bytes\r\n" in headers + b"\r\n", headers
assert b"Cache-Control: private, max-age=31536000, immutable\r\n" in headers + b"\r\n", headers
assert b"X-Content-Type-Options: nosniff\r\n" in headers + b"\r\n", headers
assert body == b"", body
PY

  fetch 206 "$tmp/body" "$tmp/headers" --range 2-5 "$original"
  [ "$(cat "$tmp/body")" = 2345 ]
  assert_header '^content-range: bytes 2-5/16' "$tmp/headers"
  fetch 206 "$tmp/body" "$tmp/headers" --range 4- "$original"
  [ "$(cat "$tmp/body")" = 456789abcdef ]
  assert_header '^content-range: bytes 4-15/16' "$tmp/headers"
  fetch 206 "$tmp/body" "$tmp/headers" --range -4 "$original"
  [ "$(cat "$tmp/body")" = cdef ]
  assert_header '^content-range: bytes 12-15/16' "$tmp/headers"
  fetch 206 "$tmp/multi" "$tmp/multi-headers" --range 0-1,4-5 "$original"
  python3 - "$tmp/multi-headers" "$tmp/multi" 16 01 45 <<'PY'
import re, sys
headers = open(sys.argv[1], "rb").read()
body = open(sys.argv[2], "rb").read()
total, first, second = (value.encode() for value in sys.argv[3:])
match = re.search(br"(?im)^content-type: multipart/byteranges; boundary=([^\r\n]+)", headers)
assert match, headers
boundary = b"--" + match.group(1)
parts = body.split(boundary)
assert parts[0] == b"\r\n" and parts[-1] == b"--\r\n", parts
actual = []
for part in parts[1:-1]:
    assert part.startswith(b"\r\n") and part.endswith(b"\r\n"), part
    part_headers, payload = part[2:-2].split(b"\r\n\r\n", 1)
    content_range = re.search(br"(?im)^Content-Range: ([^\r\n]+)", part_headers).group(1)
    actual.append((content_range, payload))
assert actual == [(b"bytes 0-1/" + total, first), (b"bytes 4-5/" + total, second)], actual
PY

  fetch 416 "$tmp/body" "$tmp/headers" --range 99-100 "$original"
  assert_header '^content-range: bytes \*/16' "$tmp/headers"
  assert_header '^accept-ranges: bytes' "$tmp/headers"
  assert_header '^x-content-type-options: nosniff' "$tmp/headers"

  fetch 206 "$tmp/body" "$tmp/headers" --range 2-5 "$rendition"
  [ "$(cat "$tmp/body")" = ndit ]
  assert_header '^content-range: bytes 2-5/15' "$tmp/headers"
  assert_header '^accept-ranges: bytes' "$tmp/headers"
  assert_header '^x-content-type-options: nosniff' "$tmp/headers"
  fetch 206 "$tmp/body" "$tmp/headers" --range 4- "$rendition"
  [ "$(cat "$tmp/body")" = ition-webp! ]
  assert_header '^content-range: bytes 4-14/15' "$tmp/headers"
  fetch 206 "$tmp/body" "$tmp/headers" --range -4 "$rendition"
  [ "$(cat "$tmp/body")" = ebp! ]
  assert_header '^content-range: bytes 11-14/15' "$tmp/headers"
  fetch 206 "$tmp/rendition-multi" "$tmp/rendition-multi-headers" --range 0-1,4-5 "$rendition"
  python3 - "$tmp/rendition-multi-headers" "$tmp/rendition-multi" 15 re it <<'PY'
import re, sys
headers = open(sys.argv[1], "rb").read()
body = open(sys.argv[2], "rb").read()
total, first, second = (value.encode() for value in sys.argv[3:])
match = re.search(br"(?im)^content-type: multipart/byteranges; boundary=([^\r\n]+)", headers)
assert match, headers
boundary = b"--" + match.group(1)
parts = body.split(boundary)
assert parts[0] == b"\r\n" and parts[-1] == b"--\r\n", parts
actual = []
for part in parts[1:-1]:
    assert part.startswith(b"\r\n") and part.endswith(b"\r\n"), part
    part_headers, payload = part[2:-2].split(b"\r\n\r\n", 1)
    content_range = re.search(br"(?im)^Content-Range: ([^\r\n]+)", part_headers).group(1)
    actual.append((content_range, payload))
assert actual == [(b"bytes 0-1/" + total, first), (b"bytes 4-5/" + total, second)], actual
PY
  fetch 416 "$tmp/body" "$tmp/headers" --range 99-100 "$rendition"
  assert_header '^content-range: bytes \*/15' "$tmp/headers"
  assert_header '^accept-ranges: bytes' "$tmp/headers"
  assert_header '^x-content-type-options: nosniff' "$tmp/headers"

  expect_status 405 --request POST "$original"
  expect_status 404 "$base/files/backups/secret.dump"
  expect_status 404 "$base/files/.quarantine/private-sentinel"
  expect_status 404 "$base/files/originals/ff/00000000-0000-4000-8000-000000000000/original.jpg"
  expect_status 404 "$base/files/renditions/ff/00000000-0000-4000-8000-000000000000/11111111-1111-4111-8111-111111111111/22222222-2222-4222-8222-222222222222.webp"
  symlink_status=$(curl --insecure --silent --output /dev/null --write-out '%{http_code}' "$base/files/originals/33/33333333-3333-4333-8333-333333333333/original.jpg")
  case "$symlink_status" in 400|403|404) ;; *) echo "error: canonical symlink escape returned HTTP $symlink_status" >&2; exit 1 ;; esac
  rendition_symlink_status=$(curl --insecure --silent --output /dev/null --write-out '%{http_code}' "$base/files/renditions/44/44444444-4444-4444-8444-444444444444/55555555-5555-4555-8555-555555555555/66666666-6666-4666-8666-666666666666.webp")
  case "$rendition_symlink_status" in 400|403|404) ;; *) echo "error: canonical rendition symlink escape returned HTTP $rendition_symlink_status" >&2; exit 1 ;; esac

  fetch 400 "$tmp/attack" "$tmp/attack-headers" --path-as-is "$base/files/originals/ignored/../00/00000000-0000-4000-8000-000000000000/original.jpg"
  [ "$(cat "$tmp/attack")" != "0123456789abcdef" ]
  fetch 400 "$tmp/attack" "$tmp/attack-headers" --path-as-is "$base/files/renditions/ignored/../00/00000000-0000-4000-8000-000000000000/11111111-1111-4111-8111-111111111111/22222222-2222-4222-8222-222222222222.webp"
  [ "$(cat "$tmp/attack")" != "rendition-webp!" ]
  fetch 400 "$tmp/attack" "$tmp/attack-headers" --path-as-is "$base/files/originals%2f00/00000000-0000-4000-8000-000000000000/original.jpg"
  [ "$(cat "$tmp/attack")" != "0123456789abcdef" ]
  fetch 400 "$tmp/attack" "$tmp/attack-headers" --path-as-is "$base/files/renditions%2f00/00000000-0000-4000-8000-000000000000/11111111-1111-4111-8111-111111111111/22222222-2222-4222-8222-222222222222.webp"
  [ "$(cat "$tmp/attack")" != "rendition-webp!" ]

  directory_status=$(curl --insecure --silent --output "$tmp/directory" --write-out '%{http_code}' "$base/files/originals/")
  [ "$directory_status" != 200 ] || { echo "error: directory listing is enabled" >&2; exit 1; }
  ! grep -qi '<title>Index of' "$tmp/directory"
  expect_status 400 --path-as-is "$base/files/originals/../backups/secret.dump"
  escaped_status=$(curl --insecure --path-as-is --silent --output /dev/null --write-out '%{http_code}' "$base/files/originals/%2e%2e/backups/secret.dump")
  case "$escaped_status" in 400|404) ;; *) echo "error: encoded traversal returned HTTP $escaped_status" >&2; exit 1 ;; esac
  malformed_status=$(curl --insecure --path-as-is --silent --output /dev/null --write-out '%{http_code}' "$base/files/originals/%zz")
  [ "$malformed_status" = 400 ] || { echo "error: malformed escape returned HTTP $malformed_status" >&2; exit 1; }

  check_processes_and_isolation
  compose exec -T files nginx -t
  compose exec -T worker sh -eu -c 'exiftool -ver; /opt/nmcp/bin/ffprobe -version; prlimit --version; dpkg-query --show ca-certificates curl ffmpeg libde265-0 libexif12 libimage-exiftool-perl libwebpdemux2 util-linux'
  still_capabilities=$(compose exec -T worker /opt/nmcp/bin/nmcp-still-helper capabilities --protocol 1 --threads 1 --srgb-icc /opt/nmcp/share/sRGB2014.icc)
  printf '%s\n' "$still_capabilities"
  for expected in '"libvips":"8.18.7"' '"libheif":"1.23.5"' '"libraw":"0.22.2-Release"' '"libaom":"v3.8.2"' '"lcms2":"2.14"'; do
    printf '%s' "$still_capabilities" | grep -F "$expected" >/dev/null
  done
  animation_capabilities=$(compose exec -T worker sh -eu -c 'exec /opt/nmcp/bin/nmcp-animation-helper capabilities --protocol 1 --threads 1 --srgb-icc /proc/self/fd/3 3</opt/nmcp/share/sRGB2014.icc')
  printf '%s\n' "$animation_capabilities"
  for expected in '"libwebp":"1.6.0"' '"libwebp-demux":"1.6.0"' '"libwebp-mux":"1.6.0"' '"giflib":"5.2.2"' '"libheif":"1.23.5"' '"libaom":"v3.8.2"' '"lcms2":"2.14"'; do
    printf '%s' "$animation_capabilities" | grep -F "$expected" >/dev/null
  done
  video_capabilities=$(compose exec -T worker sh -eu -c 'exec /opt/nmcp/bin/nmcp-video-helper capabilities --protocol 1 --threads 1 --srgb-icc /proc/self/fd/3 3</opt/nmcp/share/sRGB2014.icc')
  printf '%s\n' "$video_capabilities"
  for expected in '"ffmpeg":"9.0.2"' '"libsvtav1":"4.2.0"' '"zimg":"3.0.6"' '"libaom":"v3.8.2"' '"video_encoder":"libsvtav1"' '"audio_encoder":"aac-lc"' '"tone_map":"zscale+hable"'; do
    printf '%s' "$video_capabilities" | grep -F "$expected" >/dev/null
  done
  compose exec -T worker sh -eu -c '
    printf "%s  %s\n" 384b832de3412066743b52a75ee906b6fb9fb8d9e09e936fc2c43223815c6e0a /opt/nmcp/share/sRGB2014.icc | sha256sum --check
    du -sh /opt/nmcp
    for executable in /opt/nmcp/bin/nmcp-still-helper /opt/nmcp/bin/nmcp-animation-helper /opt/nmcp/bin/ffmpeg /opt/nmcp/bin/ffprobe; do
      closure=$(ldd "$executable")
      printf "%s\n" "$closure"
      ! printf "%s\n" "$closure" | grep -F "not found"
    done
    test -f /opt/nmcp/share/nmcp/still-toolchain.manifest
    test -f /opt/nmcp/share/nmcp/video-toolchain.manifest
  '
  for required in NMCP_STILL_HELPER_PATH NMCP_ANIMATION_HELPER_PATH NMCP_VIDEO_HELPER_PATH NMCP_PRLIMIT_PATH NMCP_SRGB_ICC_PATH NMCP_SRGB_ICC_SHA256; do
    output="$tmp/worker-missing-$required"
    if compose run --rm --no-deps -e "$required=" worker >"$output" 2>&1; then
      echo "error: Worker started without $required" >&2
      exit 1
    fi
    grep -F "$required is required" "$output" >/dev/null || {
      echo "error: Worker did not report missing $required" >&2
      cat "$output" >&2
      exit 1
    }
  done
  image_id=$(compose images -q api)
  docker image inspect "$image_id" --format 'core_image_bytes={{.Size}}'
  compose exec -T postgres postgres --version
  compose exec -T files nginx -v
  echo "validation environment checks passed"
)

verify_isolation() {
  peer_project="${project}-peer"
  peer_api_port=${NMCP_ISOLATION_API_PORT:-28080}
  peer_files_port=${NMCP_ISOLATION_FILES_PORT:-28443}
  NMCP_VALIDATION_PROJECT=$peer_project NMCP_API_PORT=$peer_api_port NMCP_FILES_PORT=$peer_files_port "$script" up
  NMCP_VALIDATION_PROJECT=$peer_project NMCP_API_PORT=$peer_api_port NMCP_FILES_PORT=$peer_files_port "$script" check
  broken_compose="$validation_dir/compose.yaml.lifecycle-test.$$"
  (
    restore_compose() {
      rm -f -- "$compose_file"
      mv -- "$broken_compose" "$compose_file"
    }
    mv -- "$compose_file" "$broken_compose"
    trap restore_compose EXIT HUP INT TERM
    printf 'invalid: [\n' >"$compose_file"
    NMCP_VALIDATION_PROJECT=$peer_project NMCP_API_PORT=$peer_api_port NMCP_FILES_PORT=$peer_files_port "$script" logs >/dev/null
    NMCP_VALIDATION_PROJECT=$peer_project NMCP_API_PORT=$peer_api_port NMCP_FILES_PORT=$peer_files_port "$script" down
    restore_compose
    trap - EXIT HUP INT TERM
  )
  NMCP_VALIDATION_PROJECT=$peer_project NMCP_API_PORT=$peer_api_port NMCP_FILES_PORT=$peer_files_port "$script" up
  peer_run=$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1],encoding="ascii"))["basename"])' \
    "$input_parent/$peer_project.registry")
  rm -- "$input_parent/$peer_run/postgres-init.sql"
  printf 'damaged lifecycle stage\n' >"$input_parent/$peer_run/runtime-roles.sql"
  printf '{damaged owner marker\n' >"$input_parent/$peer_run/.owner"
  (
    restore_compose() {
      rm -f -- "$compose_file"
      mv -- "$broken_compose" "$compose_file"
    }
    mv -- "$compose_file" "$broken_compose"
    trap restore_compose EXIT HUP INT TERM
    printf 'invalid: [\n' >"$compose_file"
    NMCP_VALIDATION_PROJECT=$peer_project NMCP_API_PORT=$peer_api_port NMCP_FILES_PORT=$peer_files_port "$script" reset
    restore_compose
    trap - EXIT HUP INT TERM
  )
  [ ! -e "$input_parent/$peer_project.registry" ]
  [ ! -e "$input_parent/$peer_run" ]
  ! docker container ls --all --quiet --filter "label=com.docker.compose.project=$peer_project" | grep .
  ! docker network ls --quiet --filter "label=com.docker.compose.project=$peer_project" | grep .
  ! docker volume ls --quiet --filter "label=com.docker.compose.project=$peer_project" | grep .
  check

  docker volume create --label "com.docker.compose.project=$guard_project" --label com.nmcp.validation.owner=foreign "$guard_volume" >/dev/null
  if NMCP_VALIDATION_PROJECT=$guard_project "$script" reset; then
    echo "error: ownership guard accepted a foreign resource" >&2
    exit 1
  fi
  docker volume rm "$guard_volume" >/dev/null
}

if [ "${1:-}" = staging-test ]; then
  check_staging_security
  exit
fi

if [ "${1:-}" = kill-publish-test ] && [ "${NMCP_VALIDATION_KILL_TEST:-}" = 1 ]; then
  printf '%s\n' "$$" >"$NMCP_VALIDATION_KILL_READY.child"
  stage_compose_inputs
  register_compose_inputs
  validation_inputs seed-partial-and-wait
  exit
fi

if [ "${1:-}" = recover-publish-test ]; then
  load_registered_inputs load
  [ -n "$input_root" ] || {
    echo "error: killed publisher did not retain its registered stage" >&2
    exit 1
  }
  validation_inputs publish >/dev/null
  exit
fi

require_tools
case "${1:-}" in
  down|reset|logs) ;;
  *)
    assert_owned
    load_registered_inputs load
    ;;
esac
case "${1:-}" in
  up)
    complete=false
    trap 'if [ "$complete" != true ]; then cleanup; fi' EXIT HUP INT TERM
    start_environment
    register_compose_inputs
    complete=true
    trap - EXIT HUP INT TERM
    ;;
  check)
    check
    ;;
  verify)
    peer_project="${project}-peer"
    guard_project="${project}-guard-$$"
    guard_volume="${guard_project}_foreign"
    retention_token="retained-$owner-$$"
    cleanup_all() {
      cleanup_status=0
      NMCP_VALIDATION_PROJECT=$peer_project NMCP_API_PORT=${NMCP_ISOLATION_API_PORT:-28080} NMCP_FILES_PORT=${NMCP_ISOLATION_FILES_PORT:-28443} "$script" reset || cleanup_status=1
      if docker volume inspect "$guard_volume" >/dev/null 2>&1; then
        docker volume rm "$guard_volume" >/dev/null || cleanup_status=1
      fi
      cleanup || cleanup_status=1
      return "$cleanup_status"
    }
    trap cleanup_all EXIT HUP INT TERM
    cleanup
    check_staging_security
    check_compose_input_negatives
    check_legacy_quarantine_guard
    start_environment
    check
    write_retention_markers
    compose down --remove-orphans
    start_environment
    assert_retention_markers
    check
    verify_isolation
    cleanup_all
    trap - EXIT HUP INT TERM
    ;;
  down)
    validation_inputs docker-down
    ;;
  reset)
    cleanup
    ;;
  logs)
    validation_inputs docker-logs
    ;;
  *)
    echo "usage: scripts/validation-env {up|check|verify|down|reset|logs|staging-test}" >&2
    exit 2
    ;;
esac
