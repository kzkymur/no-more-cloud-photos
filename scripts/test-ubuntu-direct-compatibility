#!/usr/bin/env python3
"""Small unprivileged tests for direct runner failure propagation and snapshots."""
import importlib.machinery
import importlib.util
from pathlib import Path
import subprocess
import tempfile
import unittest
from unittest.mock import patch

path = Path(__file__).with_name('verify-ubuntu-direct-compatibility')
loader = importlib.machinery.SourceFileLoader('direct', str(path))
spec = importlib.util.spec_from_loader(loader.name, loader)
direct = importlib.util.module_from_spec(spec)
loader.exec_module(direct)


class DirectTests(unittest.TestCase):
    def test_failure_propagates(self):
        with self.assertRaises(subprocess.CalledProcessError):
            direct.run('/bin/sh', '-c', 'exit 42')

    def test_deadline_is_failure(self):
        with patch.object(direct.time, 'sleep'):
            with self.assertRaisesRegex(RuntimeError, 'deadline: missing'):
                direct.wait_for(lambda: False, 'missing')

    def test_snapshot_is_exact_commit_not_dirty_worktree(self):
        with tempfile.TemporaryDirectory() as temp:
            repo = Path(temp) / 'repo'
            repo.mkdir()
            def git(*args):
                return subprocess.check_output(['git', '-C', str(repo), *args], text=True).strip()
            git('init', '--quiet')
            (repo / 'asset').write_text('committed')
            git('add', 'asset')
            git('-c', 'user.name=Test', '-c', 'user.email=test@example.invalid', 'commit', '--quiet', '-m', 'snapshot')
            sha = git('rev-parse', 'HEAD')
            (repo / 'asset').write_text('dirty')
            (repo / 'untracked').write_text('untracked')
            destination = Path(temp) / 'snapshot'
            direct.snapshot(str(repo), sha, destination)
            self.assertEqual((destination / 'asset').read_text(), 'committed')
            self.assertFalse((destination / 'untracked').exists())


if __name__ == '__main__':
    unittest.main()
