#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat >&2 <<'EOF'
usage: install-ubuntu-host --config-dir DIR --api-listen IP:PORT \
  --files-listen IP:PORT --tailnet-hostname NAME \
  --postgresql-unit postgresql@VERSION-CLUSTER.service \
  --tls-cert FILE --tls-key FILE

Installs (but does not start) Ubuntu system assets. Inputs must be below
root-owned, non-group/world-writable paths. UFW must already be active with
default incoming deny and exact Tailnet-interface rules for both TLS ports.
EOF
  exit 2
}

config_dir=''
api_listen=''
files_listen=''
tailnet_hostname=''
postgresql_unit=''
tls_cert=''
tls_key=''
while (($#)); do
  case "$1" in
    --config-dir) (($# >= 2)) || usage; config_dir=$2; shift 2 ;;
    --api-listen) (($# >= 2)) || usage; api_listen=$2; shift 2 ;;
    --files-listen) (($# >= 2)) || usage; files_listen=$2; shift 2 ;;
    --tailnet-hostname) (($# >= 2)) || usage; tailnet_hostname=$2; shift 2 ;;
    --postgresql-unit) (($# >= 2)) || usage; postgresql_unit=$2; shift 2 ;;
    --tls-cert) (($# >= 2)) || usage; tls_cert=$2; shift 2 ;;
    --tls-key) (($# >= 2)) || usage; tls_key=$2; shift 2 ;;
    -h|--help) usage ;;
    *) usage ;;
  esac
done

[[ $EUID -eq 0 ]] || { printf 'install-ubuntu-host: must run as root\n' >&2; exit 1; }
[[ -n $config_dir && -n $api_listen && -n $files_listen && -n $tailnet_hostname \
  && -n $postgresql_unit && -n $tls_cert && -n $tls_key ]] || usage
script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
repo_root=$(cd -- "$script_dir/.." && pwd -P)

exec 9>/run/lock/nmcp-deploy.lock
/usr/bin/flock --exclusive --nonblock 9 || {
  printf 'install-ubuntu-host: another NMCP deployment operation is active\n' >&2
  exit 1
}
read -r files_load files_active files_sub < <(
  /usr/bin/systemctl show nmcp-files.service \
    --property=LoadState --property=ActiveState --property=SubState --value \
    | /usr/bin/xargs
)
if [[ $files_load != not-found \
  && ! ( $files_active == inactive && $files_sub == dead ) ]]; then
  printf 'install-ubuntu-host: nmcp-files.service must be exactly inactive/dead before reinstall\n' >&2
  exit 1
fi
for command in /usr/sbin/nginx /usr/sbin/ufw /usr/bin/systemd-analyze \
  /usr/bin/systemd-sysusers /usr/bin/systemd-tmpfiles /usr/bin/openssl /usr/bin/python3; do
  [[ -x $command ]] || { printf 'install-ubuntu-host: missing %s\n' "$command" >&2; exit 1; }
done
/usr/bin/python3 - <<'PY'
values = {}
with open("/etc/os-release", encoding="utf-8") as source:
    for line in source:
        if "=" in line:
            key, value = line.rstrip("\n").split("=", 1)
            values[key] = value.strip('"')
if values.get("ID") != "ubuntu" or values.get("VERSION_ID") != "24.04":
    raise SystemExit("install-ubuntu-host: only Ubuntu 24.04 is supported")
PY

[[ $postgresql_unit =~ ^postgresql@[A-Za-z0-9_.-]+\.service$ \
  && $postgresql_unit != postgresql@.service ]] || {
  printf 'install-ubuntu-host: PostgreSQL dependency must name one concrete cluster unit\n' >&2
  exit 1
}
[[ $(/usr/bin/systemctl show --property=LoadState --value -- "$postgresql_unit") == loaded ]] || {
  printf 'install-ubuntu-host: concrete PostgreSQL unit is not loaded: %s\n' "$postgresql_unit" >&2
  exit 1
}
capture=$(/usr/bin/mktemp -d /run/nmcp-host-input.XXXXXX)
cleanup() { /usr/bin/rm -rf -- "$capture"; }
trap cleanup EXIT
"$script_dir/capture-trusted-inputs" "$capture" \
  "$config_dir/admin.env" admin.env "$config_dir/api.env" api.env \
  "$config_dir/worker.env" worker.env "$tls_cert" cert.pem "$tls_key" key.pem
"$script_dir/validate-ubuntu-config" --config-dir "$capture" \
  --tailnet-hostname "$tailnet_hostname" --files-listen "$files_listen"

read -r tailnet_ip api_port files_port < <(/usr/bin/python3 - "$api_listen" "$files_listen" <<'PY'
import ipaddress, sys
def split(value):
    if value.startswith("["):
        end = value.index("]")
        return str(ipaddress.ip_address(value[1:end])), int(value[end + 2:])
    host, port = value.rsplit(":", 1)
    return str(ipaddress.ip_address(host)), int(port)
api_ip, api_port = split(sys.argv[1])
files_ip, files_port = split(sys.argv[2])
if api_ip != files_ip:
    raise SystemExit("API and File Server listeners must use the same reviewed Tailnet IP")
print(api_ip, api_port, files_port)
PY
)
"$script_dir/verify-ubuntu-firewall" --tailnet-ip "$tailnet_ip" \
  --api-port "$api_port" --files-port "$files_port"

"$script_dir/verify-ubuntu-tls-certificate" \
  "$capture/cert.pem" "$tailnet_hostname" "$capture/key.pem"

/usr/bin/install -d -o root -g root -m 0700 /etc/nmcp /etc/nmcp/tls-releases
for name in admin.env api.env worker.env; do
  /usr/bin/install -o root -g root -m 0600 "$capture/$name" "/etc/nmcp/$name"
done
/usr/bin/printf '%s\n' "$tailnet_hostname" > /etc/nmcp/tailnet-hostname
/usr/bin/printf '%s\n' "$postgresql_unit" > /etc/nmcp/postgresql-unit
/usr/bin/chown root:root /etc/nmcp/tailnet-hostname /etc/nmcp/postgresql-unit
/usr/bin/chmod 0600 /etc/nmcp/tailnet-hostname /etc/nmcp/postgresql-unit

tls_id=$(/usr/bin/sha256sum "$capture/cert.pem" "$capture/key.pem" | /usr/bin/sha256sum | /usr/bin/cut -d' ' -f1)
tls_release=/etc/nmcp/tls-releases/$tls_id
if [[ ! -e $tls_release ]]; then
  /usr/bin/install -d -o root -g root -m 0700 "$tls_release"
  /usr/bin/install -o root -g root -m 0600 "$capture/cert.pem" "$tls_release/cert.pem"
  /usr/bin/install -o root -g root -m 0600 "$capture/key.pem" "$tls_release/key.pem"
else
  /usr/bin/cmp --silent "$capture/cert.pem" "$tls_release/cert.pem"
  /usr/bin/cmp --silent "$capture/key.pem" "$tls_release/key.pem"
fi
[[ $(/usr/bin/stat -c '%U:%G:%a' "$tls_release") == root:root:700 \
  && $(/usr/bin/stat -c '%U:%G:%a' "$tls_release/cert.pem") == root:root:600 \
  && $(/usr/bin/stat -c '%U:%G:%a' "$tls_release/key.pem") == root:root:600 ]] || {
  printf 'install-ubuntu-host: TLS generation ownership/mode is unsafe\n' >&2; exit 1;
}
tls_link=/etc/nmcp/tls-current.new.$$
/usr/bin/ln -s -- "$tls_release" "$tls_link"
/usr/bin/mv -Tf -- "$tls_link" /etc/nmcp/tls-current

# Nginx configuration is non-secret and separately traversable by User=nmcp.
/usr/bin/install -d -o root -g root -m 0755 /etc/nmcp-nginx
"$repo_root/scripts/render-ubuntu-nginx" \
  --template "$repo_root/infra/ubuntu/nginx.conf.in" \
  --output /etc/nmcp-nginx/nginx.conf \
  --api-listen "$api_listen" --files-listen "$files_listen" \
  --tailnet-hostname "$tailnet_hostname"
/usr/bin/chown root:root /etc/nmcp-nginx/nginx.conf
/usr/bin/chmod 0644 /etc/nmcp-nginx/nginx.conf

/usr/bin/install -o root -g root -m 0644 "$repo_root/infra/ubuntu/sysusers.d/nmcp.conf" /etc/sysusers.d/nmcp.conf
/usr/bin/install -o root -g root -m 0644 "$repo_root/infra/ubuntu/tmpfiles.d/nmcp.conf" /etc/tmpfiles.d/nmcp.conf
/usr/bin/systemd-sysusers /etc/sysusers.d/nmcp.conf
/usr/bin/systemd-tmpfiles --create /etc/tmpfiles.d/nmcp.conf
/usr/bin/install -d -o root -g root -m 0700 /var/lib/nmcp/deployment

for unit in nmcp.slice nmcp-migrate.service nmcp-api.service nmcp-worker.service \
  nmcp-files.service nmcp-tls-expiry.service nmcp-tls-expiry.timer nmcp.target; do
  /usr/bin/install -o root -g root -m 0644 "$repo_root/infra/ubuntu/systemd/$unit" "/etc/systemd/system/$unit"
done
/usr/bin/install -d -o root -g root -m 0755 /etc/systemd/system/nmcp-migrate.service.d
"$script_dir/render-ubuntu-postgresql-dependency" --unit "$postgresql_unit" \
  --output /etc/systemd/system/nmcp-migrate.service.d/10-postgresql.conf
/usr/bin/install -d -o root -g root -m 0755 /etc/systemd/system/postgresql@.service.d
/usr/bin/install -o root -g root -m 0644 \
  "$repo_root/infra/ubuntu/systemd/postgresql@.service.d/10-nmcp-slice.conf" \
  /etc/systemd/system/postgresql@.service.d/10-nmcp-slice.conf
/usr/bin/install -d -o root -g root -m 0755 /usr/local/libexec/nmcp /usr/share/doc/nmcp
for script in check-ubuntu-services check-ubuntu-tls-expiry renew-ubuntu-tls \
  capture-trusted-inputs run-ubuntu-migration validate-ubuntu-config \
  verify-ubuntu-firewall verify-ubuntu-tls-certificate; do
  /usr/bin/install -o root -g root -m 0755 "$repo_root/scripts/$script" "/usr/local/libexec/nmcp/$script"
done
/usr/bin/install -o root -g root -m 0644 "$repo_root/docs/ubuntu-deployment.md" /usr/share/doc/nmcp/ubuntu-deployment.md

/usr/bin/dpkg-query -W -f='${binary:Package}\t${Version}\n' \
  ca-certificates curl ffmpeg libimage-exiftool-perl nginx-core postgresql tzdata ufw util-linux \
  > /var/lib/nmcp/deployment/runtime-packages.txt
/usr/bin/chown root:root /var/lib/nmcp/deployment/runtime-packages.txt
/usr/bin/chmod 0600 /var/lib/nmcp/deployment/runtime-packages.txt

/usr/bin/systemctl daemon-reload
/usr/bin/systemctl enable --now nmcp-tls-expiry.timer
/usr/local/libexec/nmcp/check-ubuntu-tls-expiry
printf 'Host assets installed. Stage and activate a release; activation enables nmcp.target.\n'
