    if (os.path.dirname(path) != RUN or os.path.basename(path) in ("", ".", "..")
            or not isinstance(expected_payload, bytes) or not expected_payload):
        fail(f"unsafe {resource_class} path or payload")
    directory = os_call(phase, "open", "directory", os.open, RUN,
                        os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    descriptor = None
    try:
        try:
            descriptor = os.open(os.path.basename(path),
                                 os.O_RDONLY | os.O_NONBLOCK | os.O_NOFOLLOW,
                                 dir_fd=directory)
        except FileNotFoundError:
            return False
        except OSError as error:
            raise evidence_failure(phase, "open", resource_class, error) from None
        before = os_call(phase, "stat", resource_class, os.fstat, descriptor)
        identity = marker_identity(before, resource_class)
        payload = os_call(phase, "read", resource_class, os.read, descriptor,
                          len(expected_payload) + 1)
        after = os_call(phase, "stat", resource_class, os.fstat, descriptor)
        current = os_call(phase, "stat", resource_class, os.stat,
                          os.path.basename(path), dir_fd=directory, follow_symlinks=False)
        if (marker_identity(after, resource_class) != identity
                or marker_identity(current, resource_class) != identity
                or before.st_size != len(expected_payload) or payload != expected_payload):
            fail(f"{resource_class} was malformed or replaced")
        return True
    finally:
        if descriptor is not None:
            os_call(phase, "close", resource_class, os.close, descriptor)
        os_call(phase, "close", "directory", os.close, directory)
''', "client anchored exact marker validation changed")
    require_exact_function(tree, "durable_marker", '''def durable_marker(phase, name, payload=b"ready\\n"):
    path = f"{RUN}/{name}"
    if "/" in name or name in ("", ".", ".."):
        fail("unsafe marker name")
    directory = os_call(phase, "open", "directory", os.open, RUN,
                        os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    descriptor = None
    try:
        try:
            descriptor = os.open(name, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW,
                                 0o600, dir_fd=directory)
        except FileExistsError:
            os_call(phase, "close", "directory", os.close, directory)
            directory = None
            if not validated_marker(phase, path, payload):
                fail("existing marker disappeared during validation")
            return
        except OSError as error:
            raise evidence_failure(phase, "open", "marker", error) from None
        written = 0
        while written < len(payload):
            count = os_call(phase, "write", "marker", os.write, descriptor, payload[written:])
            if count <= 0 or count > len(payload) - written:
                fail("short write while publishing marker")
            written += count
        os_call(phase, "chmod", "marker", os.fchmod, descriptor, 0o600)
        os_call(phase, "fsync", "marker", os.fsync, descriptor)
        opened = os_call(phase, "stat", "marker", os.fstat, descriptor)
        current = os_call(phase, "stat", "marker", os.stat, name,
                          dir_fd=directory, follow_symlinks=False)
        if marker_identity(opened) != marker_identity(current):
            fail("marker was replaced while published")
        os_call(phase, "fsync", "directory", os.fsync, directory)
    finally:
        if descriptor is not None:
            os_call(phase, "close", "marker", os.close, descriptor)
        if directory is not None:
            os_call(phase, "close", "directory", os.close, directory)
    if not validated_marker(phase, path, payload):
        fail("published marker disappeared before validation")
''', "client attempting/acquired markers must be durably fsynced")
