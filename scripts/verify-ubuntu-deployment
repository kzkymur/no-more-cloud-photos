           for marker in (name + "=", "'" + name + "':", '"' + name + '\":')):
        text = "diagnostic contained redacted launch identity"
    index = 0
    parts = []
    hexadecimal = "0123456789abcdefABCDEF"
    while index < len(text):
        candidate = text[index:index + 64]
        candidate_hex = True
        for character in candidate:
            if character not in hexadecimal:
                candidate_hex = False
                break
        if len(candidate) == 64 and candidate_hex:
            parts.append("<redacted-hex64>")
            index += 64
        else:
            parts.append(text[index])
            index += 1
    text = "".join(parts)
    if len(text) > DIAGNOSTIC_TEXT_LIMIT:
        text = text[:DIAGNOSTIC_TEXT_LIMIT] + "...<truncated>"
    rendered = repr(text)
    return (rendered[:DIAGNOSTIC_TEXT_LIMIT] + "...<truncated>"
            if len(rendered) > DIAGNOSTIC_TEXT_LIMIT else rendered)
''', "containment persistent diagnostics redaction or bound changed")
