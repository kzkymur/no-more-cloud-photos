#!/usr/bin/env python3
"""Fail-closed static and parser checks for Ubuntu production assets."""

import ast
import copy
import os
import pathlib
import re
import shutil
import stat
import subprocess
import sys
import tempfile

try:
    import yaml
except ImportError:
    yaml = None


ROOT = pathlib.Path(__file__).resolve().parent.parent
UBUNTU = ROOT / "infra" / "ubuntu"


def require(condition: bool, message: str) -> None:
    if not condition:
        raise RuntimeError(message)


def run(command, **kwargs):
    print("+", " ".join(map(str, command)))
    return subprocess.run(command, check=True, text=True, **kwargs)


def text(path: pathlib.Path) -> str:
    return path.read_text(encoding="utf-8")


def workflow_step(steps: list[dict], name: str) -> tuple[int, dict]:
    matches = [
        (index, step)
        for index, step in enumerate(steps)
        if isinstance(step, dict) and step.get("name") == name
    ]
    require(len(matches) == 1, f"Ubuntu workflow needs exactly one active {name} step")
    return matches[0]


def require_unconditional(mapping: dict, label: str) -> None:
    require("if" not in mapping, f"{label} must be unconditional")
    require(
        "continue-on-error" not in mapping
        or mapping["continue-on-error"] in (False, "false"),
        f"{label} must fail closed",
    )


def require_default_run_context(mapping: dict, label: str) -> None:
    require(
        "shell" not in mapping and "working-directory" not in mapping,
        f"{label} must use the reviewed shell and working directory",
    )


def shell_commands(run_text: str) -> list[str]:
    logical = re.sub(r"\\\s*\n\s*", " ", run_text)
    return [
        " ".join(line.strip().split())
        for line in logical.splitlines()
        if line.strip() and not line.lstrip().startswith("#")
    ]


def require_positive_workflow_paths(patterns: list, event_name: str) -> set[str]:
    positive_paths = set()
    for pattern in patterns:
        require(
            isinstance(pattern, str),
            f"Ubuntu workflow {event_name} paths must contain only strings",
        )
        require(
            not pattern.startswith("!"),
            f"Ubuntu workflow {event_name} paths must not contain exclusions",
        )
        positive_paths.add(pattern)
    return positive_paths


EXPECTED_RUNTIME_VERIFIER_HELPER = """#!/usr/bin/env bash
set -euo pipefail

[[ $EUID -eq 0 ]] || { printf 'must run as root\\n' >&2; exit 1; }
[[ $# -eq 1 ]] || { printf 'usage: %s REPOSITORY_ROOT\\n' "$0" >&2; exit 2; }
repo_root=$(/usr/bin/readlink -f -- "$1")
source_path="$repo_root/infra/validation/verify-runtime-roles.sql"
installed_path=/usr/local/libexec/nmcp/postgresql/verify-runtime-roles.sql
[[ -f $source_path ]] || { printf 'runtime verifier source is not a regular file\\n' >&2; exit 1; }
/usr/bin/install -o root -g root -m 0644 -- "$source_path" "$installed_path"
[[ $(/usr/bin/stat --format='%F:%u:%g:%a' -- "$installed_path") == 'regular file:0:0:644' ]] || {
  printf 'unsafe installed runtime verifier ownership, type, or mode\\n' >&2
  exit 1
}
exec /usr/sbin/runuser -u postgres -- /usr/bin/psql --no-psqlrc --dbname=nmcp \\
  --set=ON_ERROR_STOP=1 --file="$installed_path"
"""


def validate_migration_role_verifier(helper_source: str, compatibility_source: str) -> None:
    require(
        helper_source == EXPECTED_RUNTIME_VERIFIER_HELPER,
        "installed runtime verifier helper differs from the complete reviewed program",
    )
    invocation = (
        "assert_runtime_boundary() {\n"
        '  /usr/local/libexec/nmcp/verify-installed-runtime-roles "$repo_root" >/dev/null\n'
        "}\n"
    )
    invocation_context = (
        "assert_hardened() {\n"
        "  /usr/sbin/runuser -u postgres -- /usr/bin/psql --no-psqlrc --dbname=nmcp \\\n"
        "    --file=/usr/local/libexec/nmcp/postgresql/verify-runtime-role-graph.sql >/dev/null\n"
        "}\n"
        + invocation
        + "assert_compatibility() {\n"
    )
    install_context = (
        "/usr/bin/install -d -o root -g root -m 0755 /usr/local/libexec/nmcp/postgresql \\\n"
        "  /opt/nmcp-role-compatibility/current/bin /opt/nmcp-role-compatibility/v18/bin\n"
        "/usr/bin/install -d -o root -g root -m 0700 /var/lib/nmcp/deployment\n"
        "/usr/bin/install -o root -g root -m 0755 \\\n"
        '  "$repo_root/scripts/set-ubuntu-migration-role-mode" \\\n'
        '  "$repo_root/scripts/run-ubuntu-migration-compatibility" \\\n'
        '  "$repo_root/scripts/verify-installed-runtime-roles" /usr/local/libexec/nmcp/\n'
        "/usr/bin/install -o root -g root -m 0644 \\\n"
        '  "$repo_root/infra/postgresql/runtime-roles.sql" \\\n'
        '  "$repo_root/infra/postgresql/verify-runtime-role-graph.sql" \\\n'
        "  /usr/local/libexec/nmcp/postgresql/\n"
    )
    require(
        compatibility_source.count(invocation) == 1
        and compatibility_source.count(invocation_context) == 1
        and compatibility_source.count(install_context) == 1
        and compatibility_source.count("assert_runtime_boundary()") == 1
        and compatibility_source.count(
            '"$repo_root/scripts/verify-installed-runtime-roles"'
        ) == 1
        and compatibility_source.count(
            '/usr/local/libexec/nmcp/verify-installed-runtime-roles "$repo_root"'
        ) == 1
        and "verify-runtime-roles.sql" not in compatibility_source
        and "if false" not in compatibility_source,
        "migration compatibility evidence does not uniquely install and invoke the reviewed helper",
    )


def verify_migration_role_verifier_mutations(
    helper_source: str, compatibility_source: str
) -> None:
    unsafe_helper = helper_source.replace("-o root", "-o postgres", 1).replace(
        "/usr/bin/stat --format='%F:%u:%g:%a'", "/usr/bin/true", 1
    )
    mutations = {
        "non-root active install": helper_source.replace("-o root", "-o postgres", 1),
        "unsafe active mode": helper_source.replace("-m 0644", "-m 0640", 1),
        "missing active metadata check": helper_source.replace(
            "/usr/bin/stat --format='%F:%u:%g:%a'", "/usr/bin/true", 1
        ),
        "source-path execution": helper_source.replace(
            '--file="$installed_path"', '--file="$source_path"', 1
        ),
        "dead-code reviewed decoy with unsafe active commands": (
            "if false; then\n" + helper_source + "fi\n" + unsafe_helper
        ),
        "dead function reviewed decoy": "reviewed_decoy() {\n" + helper_source + "}\n" + unsafe_helper,
        "heredoc reviewed decoy": "cat <<'REVIEWED'\n" + helper_source + "REVIEWED\n" + unsafe_helper,
        "commented reviewed decoy": "\n".join(
            "# " + line for line in helper_source.splitlines()
        ) + "\n" + unsafe_helper,
        "duplicate reviewed helper": helper_source + helper_source,
    }
    for label, mutation in mutations.items():
        try:
            validate_migration_role_verifier(mutation, compatibility_source)
        except RuntimeError as error:
            require("complete reviewed program" in str(error), str(error))
        else:
            raise RuntimeError(f"runtime verifier validator accepted {label}")

    dead_invocation = compatibility_source.replace(
        "assert_runtime_boundary() {",
        "if false; then\nassert_runtime_boundary() {",
        1,
    ).replace(
        "}\nassert_compatibility() {",
        "}\nfi\nassert_compatibility() {",
        1,
    )
    try:
        validate_migration_role_verifier(helper_source, dead_invocation)
    except RuntimeError as error:
        require("uniquely install and invoke" in str(error), str(error))
    else:
        raise RuntimeError("runtime verifier validator accepted dead helper invocation")

    install_start = compatibility_source.index(
        "/usr/bin/install -d -o root -g root -m 0755 /usr/local/libexec/nmcp/postgresql"
    )
    install_end = compatibility_source.index(
        "  /usr/local/libexec/nmcp/postgresql/\n", install_start
    ) + len("  /usr/local/libexec/nmcp/postgresql/\n")
    reviewed_install = compatibility_source[install_start:install_end]
    unsafe_install = reviewed_install.replace(
        "/usr/bin/install -o root -g root -m 0755 \\\n",
        "/usr/bin/install -o root -g root -m 0700 \\\n",
        1,
    )
    dead_install = compatibility_source.replace(
        reviewed_install,
        "if false; then\n" + reviewed_install + "fi\n" + unsafe_install,
        1,
    )
    try:
        validate_migration_role_verifier(helper_source, dead_install)
    except RuntimeError as error:
        require("uniquely install and invoke" in str(error), str(error))
    else:
        raise RuntimeError("runtime verifier validator accepted dead reviewed install decoy")


def validate_ubuntu_workflow(source: str) -> None:
    require(yaml is not None, "PyYAML is required to validate the Ubuntu workflow")
    workflow = yaml.safe_load(source)
    require(isinstance(workflow, dict), "Ubuntu workflow root must be a mapping")
    trigger_key = "on" if "on" in workflow else True
    require(
        set(workflow) == {"name", trigger_key, "permissions", "concurrency", "jobs"},
        "Ubuntu workflow top-level contract changed",
    )
    require(workflow["name"] == "Ubuntu deployment", "Ubuntu workflow name changed")
    require(workflow["permissions"] == {"contents": "read"}, "Ubuntu workflow permissions changed")
    require(
        workflow["concurrency"]
        == {"group": "ubuntu-deployment-${{ github.ref }}", "cancel-in-progress": True},
        "Ubuntu workflow concurrency contract changed",
    )
    require("defaults" not in workflow, "Ubuntu workflow must not override run defaults")
    triggers = workflow[trigger_key]
    require(isinstance(triggers, dict), "Ubuntu workflow triggers must be a mapping")
    require(
        set(triggers) == {"pull_request", "push", "workflow_dispatch"},
        "Ubuntu workflow trigger set changed",
    )
    require(
        triggers["workflow_dispatch"] in (None, {}),
        "Ubuntu workflow_dispatch trigger must remain unconditional",
    )
    require(
        isinstance(triggers["push"], dict)
        and set(triggers["push"]) == {"branches", "paths"},
        "Ubuntu workflow push trigger mapping changed",
    )
    require(
        triggers["push"].get("branches") == ["main"],
        "Ubuntu workflow push branches must be exactly main",
    )
    require(
        isinstance(triggers["pull_request"], dict)
        and set(triggers["pull_request"]) == {"paths"},
        "Ubuntu workflow pull_request trigger mapping changed",
    )
    expected_paths = [
        ".github/workflows/ubuntu-deployment.yml",
        "docs/ubuntu-deployment.md",
        "infra/ubuntu/**",
        "infra/postgresql/**",
        "infra/validation/verify-runtime-roles.sql",
        "infra/validation/repair-mount-verifier/**",
        "cmd/nmcp-admin/**",
        "internal/database/**",
        "internal/reconciliation/**",
        "internal/storage/**",
        "go.mod",
        "go.sum",
        "scripts/assert-ubuntu-files-endpoint",
        "scripts/capture-trusted-inputs",
        "scripts/check-ubuntu-services",
        "scripts/check-ubuntu-tls-expiry",
        "scripts/install-ubuntu-host",
        "scripts/install-ubuntu-release",
        "scripts/acquire-ubuntu-deployment-locks",
        "scripts/handoff-ubuntu-migration-lock",
        "scripts/render-ubuntu-nginx",
        "scripts/render-ubuntu-postgresql-dependency",
        "scripts/renew-ubuntu-tls",
        "scripts/run-ubuntu-migration",
        "scripts/run-ubuntu-migration-compatibility",
        "scripts/set-ubuntu-migration-role-mode",
        "scripts/validate-ubuntu-config",
        "scripts/verify-ubuntu-deployment",
        "scripts/verify-ubuntu-config-boundaries",
        "scripts/verify-ubuntu-firewall",
        "scripts/verify-ubuntu-firewall-fixtures",
        "scripts/verify-ubuntu-installed-nginx",
        "scripts/verify-installed-runtime-roles",
        "scripts/verify-ubuntu-migration-lock",
        "scripts/verify-ubuntu-migration-role-compatibility",
        "scripts/verify-ubuntu-repair-mount-boundaries",
        "scripts/verify-ubuntu-nginx-http",
        "scripts/verify-ubuntu-postgresql-dependency",
        "scripts/verify-ubuntu-service-gate",
        "scripts/verify-ubuntu-release-failures",
        "scripts/verify-ubuntu-tls-certificate",
        "scripts/verify-ubuntu-systemd-mounts",
        "scripts/verify-ubuntu-systemd-environment",
        "scripts/verify-ubuntu-trusted-inputs",
    ]
    for event_name in ("pull_request", "push"):
        event = triggers.get(event_name)
        require(isinstance(event, dict), f"Ubuntu workflow {event_name} trigger must be a mapping")
        event_paths = event.get("paths")
        require(isinstance(event_paths, list), f"Ubuntu workflow {event_name} paths must be a list")
        require_positive_workflow_paths(event_paths, event_name)
        require(
            event_paths == expected_paths,
            f"Ubuntu workflow {event_name} paths differ from the exact reviewed list",
        )
    jobs = workflow.get("jobs")
    require(isinstance(jobs, dict), "Ubuntu workflow jobs must be a mapping")
    require(set(jobs) == {"verify"}, "Ubuntu workflow evidence must run in the verify job")
    job = jobs["verify"]
    require(isinstance(job, dict), "Ubuntu verify job must be a mapping")
    require(
        set(job) == {"runs-on", "timeout-minutes", "steps"},
        "Ubuntu verify job mapping changed",
    )
    require_unconditional(job, "Ubuntu verify job")
    require("defaults" not in job, "Ubuntu verify job must not override run defaults")
    require(job.get("runs-on") == "ubuntu-24.04", "Ubuntu verify job runner changed")
    require(job.get("timeout-minutes") == 20, "Ubuntu verify job timeout changed")
    require("container" not in job, "Ubuntu verify job must execute on the host runner")
    steps = job.get("steps")
    require(isinstance(steps, list), "Ubuntu verify job steps must be a list")

    checkout_matches = [
        (index, step)
        for index, step in enumerate(steps)
        if isinstance(step, dict) and str(step.get("uses", "")).startswith("actions/checkout@")
    ]
    require(len(checkout_matches) == 1, "Ubuntu workflow needs exactly one active checkout step")
    checkout_index, checkout = checkout_matches[0]
    require_unconditional(checkout, "Ubuntu checkout step")
    require(set(checkout) == {"uses", "with"}, "Ubuntu checkout step mapping changed")
    require(checkout.get("uses") == "actions/checkout@v6", "Ubuntu checkout action changed")
    checkout_with = checkout.get("with")
    require(
        isinstance(checkout_with, dict)
        and set(checkout_with) == {"fetch-depth"}
        and checkout_with["fetch-depth"] in (0, "0"),
        "Ubuntu checkout must fetch exact historical commits",
    )

    setup_index, setup = workflow_step(steps, "Install Go")
    require_unconditional(setup, "Ubuntu Go setup step")
    require(
        set(setup) == {"name", "uses", "with"},
        "Ubuntu Go setup step mapping changed",
    )
    require(
        setup.get("uses")
        == "actions/setup-go@b7ad1dad31e06c5925ef5d2fc7ad053ef454303e",
        "Ubuntu historical migration build does not pin the reviewed Go action",
    )
    setup_with = setup.get("with")
    require(isinstance(setup_with, dict), "Ubuntu Go setup inputs must be a mapping")
    require(
        str(setup_with.get("go-version")) == "1.27.1"
        and setup_with.get("cache") in (True, "true"),
        "Ubuntu historical migration build does not pin the reviewed Go toolchain",
    )

    dependency_index, dependency = workflow_step(
        steps, "Install parser and HTTP test dependencies"
    )
    require_unconditional(dependency, "Ubuntu parser dependency step")
    require_default_run_context(dependency, "Ubuntu parser dependency step")
    require(
        set(dependency) == {"name", "run"},
        "Ubuntu parser dependency step mapping changed",
    )
    dependency_commands = shell_commands(str(dependency.get("run", "")))
    require(
        dependency_commands == [
            "sudo apt-get update",
            "sudo apt-get install --yes --no-install-recommends ffmpeg libimage-exiftool-perl nginx-core postgresql python3-yaml shellcheck util-linux",
        ],
        "Ubuntu workflow parser dependency commands changed",
    )

    shellcheck_index, shellcheck = workflow_step(steps, "Check shell scripts")
    require_unconditional(shellcheck, "Ubuntu ShellCheck step")
    require_default_run_context(shellcheck, "Ubuntu ShellCheck step")
    require(
        set(shellcheck) == {"name", "run"},
        "Ubuntu ShellCheck step mapping changed",
    )
    expected_shellcheck = (
        "/usr/bin/shellcheck scripts/install-ubuntu-host scripts/install-ubuntu-release "
        "scripts/check-ubuntu-tls-expiry scripts/renew-ubuntu-tls "
        "scripts/run-ubuntu-migration scripts/run-ubuntu-migration-compatibility "
        "scripts/set-ubuntu-migration-role-mode scripts/verify-ubuntu-migration-lock "
        "scripts/verify-ubuntu-migration-role-compatibility scripts/verify-ubuntu-repair-mount-boundaries "
        "scripts/verify-ubuntu-config-boundaries scripts/verify-ubuntu-firewall-fixtures "
        "scripts/verify-ubuntu-installed-nginx scripts/verify-ubuntu-nginx-http "
        "scripts/verify-ubuntu-postgresql-dependency scripts/verify-ubuntu-release-failures "
        "scripts/verify-ubuntu-service-gate scripts/verify-ubuntu-tls-certificate "
        "scripts/verify-ubuntu-systemd-environment scripts/verify-ubuntu-systemd-mounts "
        "scripts/verify-ubuntu-trusted-inputs scripts/verify-installed-runtime-roles"
    )
    require(
        shell_commands(str(shellcheck.get("run", ""))) == [expected_shellcheck],
        "Ubuntu workflow ShellCheck command differs from the exact reviewed file set",
    )

    static_index, static = workflow_step(steps, "Verify deployment assets")
    require_unconditional(static, "Ubuntu deployment asset verification step")
    require_default_run_context(static, "Ubuntu deployment asset verification step")
    require(
        static.get("run") == "/usr/bin/python3 scripts/verify-ubuntu-deployment",
        "Ubuntu workflow bypasses the structural deployment verifier",
    )

    mount_index, mount = workflow_step(steps, "Verify privileged repair mount boundaries")
    require_unconditional(mount, "Ubuntu privileged repair mount step")
    require_default_run_context(mount, "Ubuntu privileged repair mount step")
    require(
        shell_commands(str(mount.get("run", ""))) == [
            "go test -c -o /tmp/nmcp-storage-repair.test ./internal/storage",
            "go build -o /tmp/nmcp-repair-late-bind ./infra/validation/repair-mount-verifier",
            "sudo scripts/verify-ubuntu-repair-mount-boundaries /tmp/nmcp-storage-repair.test /tmp/nmcp-repair-late-bind",
        ],
        "Ubuntu workflow bypasses privileged repair mount evidence",
    )

    migration_index, migration = workflow_step(
        steps, "Verify migration role compatibility and hardening"
    )
    require_unconditional(migration, "Ubuntu migration compatibility step")
    require_default_run_context(migration, "Ubuntu migration compatibility step")
    expected_commands = [
        "go build -o /tmp/nmcp-admin-current ./cmd/nmcp-admin",
        "mkdir /tmp/nmcp-v18-source",
        "git archive 172583179d860619ae2c79505971e10ae7f394fc | tar -x -C /tmp/nmcp-v18-source",
        "(cd /tmp/nmcp-v18-source && go build -o /tmp/nmcp-admin-v18 ./cmd/nmcp-admin)",
        "sudo scripts/verify-ubuntu-migration-role-compatibility /tmp/nmcp-admin-current /tmp/nmcp-admin-v18",
    ]
    require(
        shell_commands(str(migration.get("run", ""))) == expected_commands,
        "Ubuntu workflow lost the executable v18-to-v19 migration binary contract",
    )
    require(
        (checkout_index, setup_index, dependency_index, shellcheck_index) == (0, 1, 2, 3)
        and shellcheck_index
        < static_index < mount_index < migration_index,
        "Ubuntu workflow evidence steps are not in dependency order",
    )
    for index, step in enumerate(steps):
        if isinstance(step, dict) and "run" in step:
            label = step.get("name", f"step {index}")
            require_default_run_context(step, f"Ubuntu run step {label}")


def expect_workflow_rejected(source: str, label: str, expected_error: str) -> None:
    try:
        validate_ubuntu_workflow(source)
    except RuntimeError as error:
        require(
            expected_error in str(error),
            f"{label} failed for the wrong reason: {error}",
        )
        return
    raise RuntimeError(f"Ubuntu workflow validator accepted {label}")


def verify_ubuntu_workflow_mutations(source: str) -> None:
    workflow = yaml.safe_load(source)

    missing_dispatch = copy.deepcopy(workflow)
    missing_dispatch.get("on", missing_dispatch.get(True)).pop("workflow_dispatch")
    expect_workflow_rejected(
        yaml.safe_dump(missing_dispatch, sort_keys=False),
        "missing manual workflow trigger",
        "Ubuntu workflow trigger set changed",
    )

    wrong_push_branch = copy.deepcopy(workflow)
    wrong_push_branch.get("on", wrong_push_branch.get(True))["push"]["branches"] = [
        "develop"
    ]
    expect_workflow_rejected(
        yaml.safe_dump(wrong_push_branch, sort_keys=False),
        "wrong push branch",
        "Ubuntu workflow push branches must be exactly main",
    )

    for route_key, route_value in (
        ("tags", ["*"]),
        ("tags-ignore", ["release-* "]),
        ("branches-ignore", ["develop"]),
    ):
        extra_push_route = copy.deepcopy(workflow)
        extra_push_route.get("on", extra_push_route.get(True))["push"][route_key] = route_value
        expect_workflow_rejected(
            yaml.safe_dump(extra_push_route, sort_keys=False),
            f"extra push {route_key} route",
            "Ubuntu workflow push trigger mapping changed",
        )

    for route_key, route_value in (
        ("branches", ["main"]),
        ("branches-ignore", ["develop"]),
        ("types", ["opened"]),
    ):
        extra_pr_route = copy.deepcopy(workflow)
        extra_pr_route.get("on", extra_pr_route.get(True))["pull_request"][route_key] = route_value
        expect_workflow_rejected(
            yaml.safe_dump(extra_pr_route, sort_keys=False),
            f"extra pull_request {route_key} route",
            "Ubuntu workflow pull_request trigger mapping changed",
        )

    extra_trigger = copy.deepcopy(workflow)
    extra_trigger.get("on", extra_trigger.get(True))["schedule"] = [
        {"cron": "0 0 * * *"}
    ]
    expect_workflow_rejected(
        yaml.safe_dump(extra_trigger, sort_keys=False),
        "extra bypass trigger",
        "Ubuntu workflow trigger set changed",
    )

    missing_shellcheck = copy.deepcopy(workflow)
    missing_shellcheck_steps = missing_shellcheck["jobs"]["verify"]["steps"]
    shellcheck_index, _ = workflow_step(missing_shellcheck_steps, "Check shell scripts")
    missing_shellcheck_steps.pop(shellcheck_index)
    expect_workflow_rejected(
        yaml.safe_dump(missing_shellcheck, sort_keys=False),
        "missing ShellCheck gate",
        "Ubuntu workflow needs exactly one active Check shell scripts step",
    )

    incomplete_shellcheck = copy.deepcopy(workflow)
    _, incomplete_shellcheck_step = workflow_step(
        incomplete_shellcheck["jobs"]["verify"]["steps"], "Check shell scripts"
    )
    incomplete_shellcheck_step["run"] = str(incomplete_shellcheck_step["run"]).replace(
        " scripts/verify-ubuntu-repair-mount-boundaries", ""
    )
    expect_workflow_rejected(
        yaml.safe_dump(incomplete_shellcheck, sort_keys=False),
        "ShellCheck file removal",
        "Ubuntu workflow ShellCheck command differs from the exact reviewed file set",
    )

    bypassed_shellcheck = copy.deepcopy(workflow)
    _, bypassed_shellcheck_step = workflow_step(
        bypassed_shellcheck["jobs"]["verify"]["steps"], "Check shell scripts"
    )
    bypassed_shellcheck_step["run"] = "/bin/true"
    expect_workflow_rejected(
        yaml.safe_dump(bypassed_shellcheck, sort_keys=False),
        "bypassed ShellCheck command",
        "Ubuntu workflow ShellCheck command differs from the exact reviewed file set",
    )

    disabled_shellcheck = copy.deepcopy(workflow)
    _, disabled_shellcheck_step = workflow_step(
        disabled_shellcheck["jobs"]["verify"]["steps"], "Check shell scripts"
    )
    disabled_shellcheck_step["if"] = False
    expect_workflow_rejected(
        yaml.safe_dump(disabled_shellcheck, sort_keys=False),
        "disabled ShellCheck gate",
        "Ubuntu ShellCheck step must be unconditional",
    )

    non_gating_shellcheck = copy.deepcopy(workflow)
    _, non_gating_shellcheck_step = workflow_step(
        non_gating_shellcheck["jobs"]["verify"]["steps"], "Check shell scripts"
    )
    non_gating_shellcheck_step["continue-on-error"] = True
    expect_workflow_rejected(
        yaml.safe_dump(non_gating_shellcheck, sort_keys=False),
        "non-gating ShellCheck step",
        "Ubuntu ShellCheck step must fail closed",
    )

    shadowed_shellcheck = copy.deepcopy(workflow)
    shadowed_shellcheck_steps = shadowed_shellcheck["jobs"]["verify"]["steps"]
    shellcheck_index, shadowed_shellcheck_step = workflow_step(
        shadowed_shellcheck_steps, "Check shell scripts"
    )
    shadowed_shellcheck_steps.insert(
        shellcheck_index,
        {"name": "Shadow ShellCheck", "run": "printf '#!/bin/sh\\nexit 0\\n' > /tmp/shellcheck"},
    )
    shadowed_shellcheck_step["env"] = {"PATH": "/tmp:/usr/bin:/bin"}
    expect_workflow_rejected(
        yaml.safe_dump(shadowed_shellcheck, sort_keys=False),
        "PATH-shadowed ShellCheck with prior executable step",
        "Ubuntu ShellCheck step mapping changed",
    )

    shellcheck_env = copy.deepcopy(workflow)
    _, shellcheck_env_step = workflow_step(
        shellcheck_env["jobs"]["verify"]["steps"], "Check shell scripts"
    )
    shellcheck_env_step["env"] = {"PATH": "/tmp:/usr/bin:/bin"}
    expect_workflow_rejected(
        yaml.safe_dump(shellcheck_env, sort_keys=False),
        "ShellCheck PATH override",
        "Ubuntu ShellCheck step mapping changed",
    )

    unused_shellcheck = copy.deepcopy(workflow)
    unused_shellcheck_steps = unused_shellcheck["jobs"]["verify"]["steps"]
    shellcheck_index, shellcheck_step = workflow_step(
        unused_shellcheck_steps, "Check shell scripts"
    )
    unused_shellcheck["x-unused-shellcheck"] = [
        unused_shellcheck_steps.pop(shellcheck_index)
    ]
    expect_workflow_rejected(
        yaml.safe_dump(unused_shellcheck, sort_keys=False),
        "unused ShellCheck evidence block",
        "Ubuntu workflow top-level contract changed",
    )

    reordered_shellcheck = copy.deepcopy(workflow)
    reordered_shellcheck_steps = reordered_shellcheck["jobs"]["verify"]["steps"]
    shellcheck_index, shellcheck_step = workflow_step(
        reordered_shellcheck_steps, "Check shell scripts"
    )
    static_index, _ = workflow_step(
        reordered_shellcheck_steps, "Verify deployment assets"
    )
    reordered_shellcheck_steps.insert(
        static_index + 1, reordered_shellcheck_steps.pop(shellcheck_index)
    )
    expect_workflow_rejected(
        yaml.safe_dump(reordered_shellcheck, sort_keys=False),
        "out-of-order ShellCheck gate",
        "Ubuntu workflow evidence steps are not in dependency order",
    )

    workflow_defaults = copy.deepcopy(workflow)
    workflow_defaults["defaults"] = {"run": {"shell": "/bin/true {0}"}}
    expect_workflow_rejected(
        yaml.safe_dump(workflow_defaults, sort_keys=False),
        "workflow-level neutralizing shell default",
        "Ubuntu workflow top-level contract changed",
    )

    job_defaults = copy.deepcopy(workflow)
    job_defaults["jobs"]["verify"]["defaults"] = {"run": {"shell": "/bin/true {0}"}}
    expect_workflow_rejected(
        yaml.safe_dump(job_defaults, sort_keys=False),
        "job-level neutralizing shell default",
        "Ubuntu verify job mapping changed",
    )

    historical_checkout = copy.deepcopy(workflow)
    checkout = next(
        step
        for step in historical_checkout["jobs"]["verify"]["steps"]
        if isinstance(step, dict) and str(step.get("uses", "")).startswith("actions/checkout@")
    )
    checkout["with"]["ref"] = "ea644c9ad47a35af67b8598758eb717bd2a86e57"
    expect_workflow_rejected(
        yaml.safe_dump(historical_checkout, sort_keys=False),
        "historical checkout ref override",
        "Ubuntu checkout must fetch exact historical commits",
    )

    step_shell = copy.deepcopy(workflow)
    _, shell_migration = workflow_step(
        step_shell["jobs"]["verify"]["steps"],
        "Verify migration role compatibility and hardening",
    )
    shell_migration["shell"] = "/bin/true {0}"
    expect_workflow_rejected(
        yaml.safe_dump(step_shell, sort_keys=False),
        "step-level neutralizing shell",
        "Ubuntu migration compatibility step must use the reviewed shell and working directory",
    )

    step_directory = copy.deepcopy(workflow)
    _, directory_migration = workflow_step(
        step_directory["jobs"]["verify"]["steps"],
        "Verify migration role compatibility and hardening",
    )
    directory_migration["working-directory"] = "/tmp"
    expect_workflow_rejected(
        yaml.safe_dump(step_directory, sort_keys=False),
        "step-level working-directory override",
        "Ubuntu migration compatibility step must use the reviewed shell and working directory",
    )

    disabled_mount = copy.deepcopy(workflow)
    _, disabled_mount_step = workflow_step(
        disabled_mount["jobs"]["verify"]["steps"],
        "Verify privileged repair mount boundaries",
    )
    disabled_mount_step["if"] = False
    expect_workflow_rejected(
        yaml.safe_dump(disabled_mount, sort_keys=False),
        "disabled privileged repair mount evidence",
        "Ubuntu privileged repair mount step must be unconditional",
    )

    unprivileged_mount = copy.deepcopy(workflow)
    _, unprivileged_mount_step = workflow_step(
        unprivileged_mount["jobs"]["verify"]["steps"],
        "Verify privileged repair mount boundaries",
    )
    unprivileged_mount_step["run"] = str(unprivileged_mount_step["run"]).replace(
        "sudo scripts/verify-ubuntu-repair-mount-boundaries",
        "scripts/verify-ubuntu-repair-mount-boundaries",
    )
    expect_workflow_rejected(
        yaml.safe_dump(unprivileged_mount, sort_keys=False),
        "unprivileged repair mount evidence",
        "Ubuntu workflow bypasses privileged repair mount evidence",
    )

    unrelated_step_shell = copy.deepcopy(workflow)
    _, privileged_inputs = workflow_step(
        unrelated_step_shell["jobs"]["verify"]["steps"],
        "Verify privileged input capture counterexamples",
    )
    privileged_inputs["shell"] = "/bin/true {0}"
    expect_workflow_rejected(
        yaml.safe_dump(unrelated_step_shell, sort_keys=False),
        "neutralizing shell on another security evidence step",
        "Ubuntu run step Verify privileged input capture counterexamples must use the reviewed shell and working directory",
    )

    missing_path = copy.deepcopy(workflow)
    missing_triggers = missing_path.get("on", missing_path.get(True))
    missing_triggers["pull_request"]["paths"].remove(
        "infra/validation/verify-runtime-roles.sql"
    )
    expect_workflow_rejected(
        yaml.safe_dump(missing_path, sort_keys=False),
        "missing checker verifier workflow path",
        "Ubuntu workflow pull_request paths differ from the exact reviewed list",
    )

    for event_name in ("pull_request", "push"):
        excluded_path = copy.deepcopy(workflow)
        excluded_triggers = excluded_path.get("on", excluded_path.get(True))
        excluded_triggers[event_name]["paths"].append(
            "!infra/validation/verify-runtime-roles.sql"
        )
        expect_workflow_rejected(
            yaml.safe_dump(excluded_path, sort_keys=False),
            f"later checker verifier exclusion in {event_name} paths",
            f"Ubuntu workflow {event_name} paths must not contain exclusions",
        )
        missing_repair_path = copy.deepcopy(workflow)
        repair_triggers = missing_repair_path.get("on", missing_repair_path.get(True))
        repair_triggers[event_name]["paths"].remove("internal/storage/**")
        expect_workflow_rejected(
            yaml.safe_dump(missing_repair_path, sort_keys=False),
            f"missing repair storage path in {event_name}",
            f"Ubuntu workflow {event_name} paths differ from the exact reviewed list",
        )

    disabled = copy.deepcopy(workflow)
    disabled_steps = disabled["jobs"]["verify"]["steps"]
    _, disabled_setup = workflow_step(disabled_steps, "Install Go")
    disabled_setup["if"] = False
    expect_workflow_rejected(
        yaml.safe_dump(disabled, sort_keys=False),
        "disabled Go setup evidence",
        "Ubuntu Go setup step must be unconditional",
    )

    unused = copy.deepcopy(workflow)
    unused_steps = unused["jobs"]["verify"]["steps"]
    _, active_migration = workflow_step(
        unused_steps, "Verify migration role compatibility and hardening"
    )
    unused["x-unused-reviewed-steps"] = [copy.deepcopy(active_migration)]
    active_migration["run"] = "/bin/true"
    expect_workflow_rejected(
        yaml.safe_dump(unused, sort_keys=False),
        "unused migration evidence block",
        "Ubuntu workflow top-level contract changed",
    )

    non_gating = copy.deepcopy(workflow)
    non_gating_steps = non_gating["jobs"]["verify"]["steps"]
    _, non_gating_migration = workflow_step(
        non_gating_steps, "Verify migration role compatibility and hardening"
    )
    non_gating_migration["continue-on-error"] = "${{ true }}"
    expect_workflow_rejected(
        yaml.safe_dump(non_gating, sort_keys=False),
        "non-gating migration evidence",
        "Ubuntu migration compatibility step must fail closed",
    )

    reordered = copy.deepcopy(workflow)
    reordered_steps = reordered["jobs"]["verify"]["steps"]
    setup_index, setup = workflow_step(reordered_steps, "Install Go")
    migration_index, _ = workflow_step(
        reordered_steps, "Verify migration role compatibility and hardening"
    )
    reordered_steps.insert(migration_index + 1, reordered_steps.pop(setup_index))
    expect_workflow_rejected(
        yaml.safe_dump(reordered, sort_keys=False),
        "out-of-order migration dependencies",
        "Ubuntu workflow evidence steps are not in dependency order",
    )


def main() -> int:
    scripts = [
        ROOT / "scripts" / "install-ubuntu-host",
        ROOT / "scripts" / "install-ubuntu-release",
        ROOT / "scripts" / "verify-ubuntu-nginx-http",
        ROOT / "scripts" / "verify-ubuntu-systemd-mounts",
        ROOT / "scripts" / "verify-ubuntu-installed-nginx",
        ROOT / "scripts" / "verify-ubuntu-postgresql-dependency",
        ROOT / "scripts" / "verify-ubuntu-service-gate",
        ROOT / "scripts" / "verify-ubuntu-config-boundaries",
        ROOT / "scripts" / "verify-ubuntu-firewall-fixtures",
        ROOT / "scripts" / "verify-ubuntu-trusted-inputs",
        ROOT / "scripts" / "renew-ubuntu-tls",
        ROOT / "scripts" / "check-ubuntu-tls-expiry",
        ROOT / "scripts" / "run-ubuntu-migration",
        ROOT / "scripts" / "run-ubuntu-migration-compatibility",
        ROOT / "scripts" / "set-ubuntu-migration-role-mode",
        ROOT / "scripts" / "verify-ubuntu-migration-role-compatibility",
        ROOT / "scripts" / "verify-ubuntu-repair-mount-boundaries",
        ROOT / "scripts" / "verify-ubuntu-migration-lock",
        ROOT / "scripts" / "verify-ubuntu-release-failures",
        ROOT / "scripts" / "verify-ubuntu-tls-certificate",
        ROOT / "scripts" / "verify-ubuntu-systemd-environment",
    ]
    for script in scripts:
        require(os.access(script, os.X_OK), f"{script.name} is not executable")
        run(["bash", "-n", script])
    render = ROOT / "scripts" / "render-ubuntu-nginx"
    python_scripts = [
        render, ROOT / "scripts" / "assert-ubuntu-files-endpoint",
        ROOT / "scripts" / "validate-ubuntu-config",
        ROOT / "scripts" / "render-ubuntu-postgresql-dependency",
        ROOT / "scripts" / "verify-ubuntu-firewall",
        ROOT / "scripts" / "capture-trusted-inputs",
        ROOT / "scripts" / "check-ubuntu-services",
        ROOT / "scripts" / "acquire-ubuntu-deployment-locks",
        ROOT / "scripts" / "handoff-ubuntu-migration-lock",
    ]
    for script in python_scripts:
        require(os.access(script, os.X_OK), f"{script.name} is not executable")
        ast.parse(text(script), filename=str(script))

    ubuntu_workflow = text(ROOT / ".github" / "workflows" / "ubuntu-deployment.yml")
    validate_ubuntu_workflow(ubuntu_workflow)
    verify_ubuntu_workflow_mutations(ubuntu_workflow)

    units = UBUNTU / "systemd"
    slice_text = text(units / "nmcp.slice")
    require("CPUQuota=200%" in slice_text, "aggregate CPU ceiling changed")
    require("MemoryMax=4G" in slice_text, "aggregate memory ceiling changed")
    for name in ("nmcp-migrate.service", "nmcp-api.service", "nmcp-worker.service", "nmcp-files.service"):
        unit = text(units / name)
        require("Slice=nmcp.slice" in unit, f"{name} escapes aggregate slice")
        if name != "nmcp-migrate.service":
            require("User=nmcp" in unit and "Group=nmcp" in unit, f"{name} identity changed")
        require("NoNewPrivileges=yes" in unit and "ProtectSystem=strict" in unit, f"{name} hardening missing")
        require("CPUQuota=" not in unit and "MemoryMax=" not in unit, f"{name} duplicates aggregate budget")
    require("NMCP_API_ADDR=127.0.0.1:8080" in text(UBUNTU / "env" / "api.env.example"), "API example is not loopback-only")
    require((units / "postgresql@.service.d" / "10-nmcp-slice.conf").is_file(), "PostgreSQL instance slice drop-in missing")
    timers = {path.name for path in UBUNTU.rglob("*.timer")}
    require(timers == {"nmcp-tls-expiry.timer"}, "only independent TLS expiry monitoring may have a timer")
    migrate_unit = text(units / "nmcp-migrate.service")
    require("postgresql.service" not in migrate_unit, "migration still depends on PostgreSQL meta-unit")
    require(
        "ExecStart=/usr/local/libexec/nmcp/run-ubuntu-migration" in migrate_unit,
        "systemd migration bypasses the deployment serializer",
    )
    require("RemainAfterExit=yes" in migrate_unit, "successful migration is not retained for dependent starts")
    for dependent in ("nmcp-api.service", "nmcp-worker.service"):
        dependent_text = text(units / dependent)
        require(
            "Requires=nmcp-migrate.service" in dependent_text and "After=nmcp-migrate.service" in dependent_text,
            f"{dependent} lost its production migration dependency edge",
        )
    tmpfiles_text = text(UBUNTU / "tmpfiles.d" / "nmcp.conf")
    require(
        "d /run/nmcp-deploy 0700 root root" in tmpfiles_text
        and "f /run/nmcp-deploy/deploy.lock 0600 root root" in tmpfiles_text,
        "shared migration lock ownership/mode is missing",
    )
    require(
        "f /run/nmcp-deploy/migration-execution.lock 0600 root root" in tmpfiles_text,
        "owner-death migration execution lease is missing",
    )
    require(
        tmpfiles_text.count("d /var/lib/nmcp/media/.quarantine 0700 nmcp nmcp -") == 1
        and "/var/lib/nmcp/media/quarantine" not in tmpfiles_text,
        "canonical private .quarantine tmpfiles entry is missing or duplicated",
    )
    compose_text = text(ROOT / "infra" / "validation" / "compose.yaml")
    require(
        "install -d -o 10001 -g 10001 -m 0700" in compose_text
        and "/var/lib/nmcp/media/.quarantine" in compose_text
        and "legacy dotless quarantine requires reviewed migration" in compose_text,
        "validation storage does not reject legacy state and create private .quarantine",
    )
    environment_examples = "\n".join(text(path) for path in sorted((UBUNTU / "env").glob("*.example")))
    require("NMCP_QUARANTINE" not in environment_examples, "quarantine path became environment-configurable")
    cli_contract = text(ROOT / "docs" / "contracts" / "core-api.md")
    storage_contract = text(ROOT / "docs" / "contracts" / "state-and-storage.md")
    require("--quarantine-dir" not in cli_contract, "CLI contract still permits a quarantine path override")
    require(
        "${NMCP_STORAGE_ROOT}/.quarantine" in storage_contract,
        "storage contract lost the canonical quarantine path",
    )
    host_install = text(ROOT / "scripts" / "install-ubuntu-host")
    require(
        "legacy /var/lib/nmcp/media/quarantine exists" in host_install
        and "existing canonical quarantine ownership, mode, or device is unsafe" in host_install
        and "stat -c '%d' /var/lib/nmcp/media/.quarantine" in host_install,
        "host installation lacks quarantine upgrade/owner/mode/device preflight",
    )
    require(
        "handoff-ubuntu-migration-lock" in host_install,
        "migration execution-lease handoff helper is not installed",
    )
    require("User=root" in migrate_unit, "migration serializer must own the root-only lock")
    migration_runner = text(ROOT / "scripts" / "run-ubuntu-migration")
    migration_compatibility = text(ROOT / "scripts" / "run-ubuntu-migration-compatibility")
    migration_role_compatibility = text(
        ROOT / "scripts" / "verify-ubuntu-migration-role-compatibility"
    )
    runtime_verifier_helper_path = ROOT / "scripts" / "verify-installed-runtime-roles"
    runtime_verifier_helper = text(runtime_verifier_helper_path)
    require(
        stat.S_IMODE(runtime_verifier_helper_path.stat().st_mode) == 0o755,
        "installed runtime verifier helper must be executable mode 0755",
    )
    validate_migration_role_verifier(runtime_verifier_helper, migration_role_compatibility)
    verify_migration_role_verifier_mutations(
        runtime_verifier_helper, migration_role_compatibility
    )
    role_mode = text(ROOT / "scripts" / "set-ubuntu-migration-role-mode")
    release_installer = text(ROOT / "scripts" / "install-ubuntu-release")
    require(
        "run-ubuntu-migration-compatibility" in migration_runner
        and "setpriv --reuid=nmcp --regid=nmcp" in migration_compatibility
        and 'trap \'finalize "$?"\' EXIT' in migration_compatibility,
        "migration compatibility wrapper does not drop to nmcp and harden on exit",
    )
    require(
        "postgresql-role-bootstrap.sha256" in role_mode
        and "/usr/bin/env -i /usr/sbin/runuser -u postgres" in role_mode
        and "--host=/var/run/postgresql" in role_mode
        and "--port=5432" in role_mode
        and "--username=postgres" in role_mode
        and "verify-runtime-role-graph.sql" in role_mode
        and "systemctl stop nmcp-migrate.service" in release_installer,
        "migration role bootstrap is not pinned, peer-authenticated, verified, and readiness-gated",
    )
    role_bootstrap = text(UBUNTU / "postgresql-roles.sql")
    shared_roles = text(ROOT / "infra" / "postgresql" / "runtime-roles.sql")
    require(
        "BEGIN;" in role_bootstrap and "COMMIT;" in role_bootstrap
        and "nmcp_api_role nmcp_api" in role_bootstrap
        and "nmcp_worker_role nmcp_worker" in role_bootstrap,
        "Ubuntu role bootstrap is not one complete managed-graph transaction",
    )
    require(
        "nmcp_allowed_membership" in shared_roles
        and "actual.roleid IN" in shared_roles
        and "actual.member IN" in shared_roles,
        "shared role bootstrap does not close both sides of managed edges",
    )
    validation_script = text(ROOT / "scripts" / "validation-env")
    require(
        'container["HostConfig"].get("Mounts")' in validation_script
        and 'container["HostConfig"].get("Tmpfs")' in validation_script
        and 'mount.get("Type") == "volume"' in validation_script
        and 'normalized_tmpfs(options) == expected_tmpfs[destination]' in validation_script
        and 'actual_set == expected_actual_volumes' in validation_script
        and '/proc/self/mountinfo' in validation_script,
        "validation does not inspect every configured File Server mount type",
    )

    files_unit = text(units / "nmcp-files.service")
    for required in (
        "InaccessiblePaths=/var/lib/nmcp",
        "BindReadOnlyPaths=/var/lib/nmcp/media/originals:/srv/nmcp/originals",
        "BindReadOnlyPaths=/var/lib/nmcp/media/renditions:/srv/nmcp/renditions",
        "LoadCredential=tls-key.pem:/etc/nmcp/tls-current/key.pem",
        "ExecStartPre=/usr/sbin/nginx -t -c /etc/nmcp-nginx/nginx.conf",
        "CapabilityBoundingSet=CAP_NET_BIND_SERVICE",
    ):
        require(required in files_unit, f"Nginx boundary missing: {required}")
    require("ReadWritePaths=" not in files_unit, "Nginx received a writable host path")
    require(".quarantine" not in files_unit, "Nginx received the quarantine path")

    nginx_template = text(UBUNTU / "nginx.conf.in")
    require(nginx_template.count("alias ") == 2, "Nginx must expose exactly two aliases")
    require("alias /srv/nmcp/originals/" in nginx_template, "originals alias missing")
    require("alias /srv/nmcp/renditions/" in nginx_template, "renditions alias missing")
    require(".quarantine" not in nginx_template, "Nginx template exposes quarantine")
    require("proxy_pass http://127.0.0.1:8080" in nginx_template, "API upstream is not loopback")
    require("autoindex off" in nginx_template and "Accept-Ranges" in nginx_template, "file response boundary missing")
    require("private, max-age=31536000, immutable" in nginx_template, "private cache contract missing")
    require("@@NMCP_API_TLS_LISTEN@@" in nginx_template and "@@NMCP_FILES_TLS_LISTEN@@" in nginx_template, "listen token missing")

    with tempfile.TemporaryDirectory(prefix="nmcp-ubuntu-verify-") as raw:
        temporary = pathlib.Path(raw)
        rendered = temporary / "nginx.conf"
        run([
            render,
            "--template", UBUNTU / "nginx.conf.in",
            "--output", rendered,
            "--api-listen", "100.64.0.10:8443",
            "--files-listen", "100.64.0.10:9443",
            "--tailnet-hostname", "host.example.ts.net",
        ])
        rendered_text = text(rendered)
        require("@@NMCP_" not in rendered_text, "renderer left a token")
        rejected = subprocess.run([
            render,
            "--template", UBUNTU / "nginx.conf.in",
            "--output", temporary / "rejected.conf",
            "--api-listen", "0.0.0.0:8443",
            "--files-listen", "100.64.0.10:9443",
            "--tailnet-hostname", "host.example.ts.net",
        ], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        require(rejected.returncode != 0, "renderer accepted a wildcard listener")

        nginx = shutil.which("nginx")
        openssl = shutil.which("openssl")
        if nginx and openssl:
            cert = temporary / "cert.pem"
            key = temporary / "key.pem"
            run([
                openssl, "req", "-x509", "-newkey", "rsa:2048", "-nodes",
                "-subj", "/CN=host.example.ts.net", "-days", "1",
                "-keyout", key, "-out", cert,
            ], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            cache = temporary / "cache"
            (cache / "client").mkdir(parents=True)
            (cache / "proxy").mkdir()
            test_config = rendered_text.replace(
                "/run/credentials/nmcp-files.service/tls-cert.pem", str(cert)
            ).replace(
                "/run/credentials/nmcp-files.service/tls-key.pem", str(key)
            ).replace(
                "/run/nmcp-nginx/nginx.pid", str(temporary / "nginx.pid")
            ).replace(
                "/run/nmcp-nginx/client", str(cache / "client")
            ).replace(
                "/run/nmcp-nginx/proxy", str(cache / "proxy")
            ).replace(
                "100.64.0.10:8443", "127.0.0.1:18443"
            ).replace(
                "100.64.0.10:9443", "127.0.0.1:19443"
            )
            test_path = temporary / "nginx-test.conf"
            test_path.write_text(test_config, encoding="utf-8")
            run([nginx, "-t", "-c", test_path])
        else:
            print("SKIP: nginx/openssl unavailable; parser test must run in CI", file=sys.stderr)

    analyzer = shutil.which("systemd-analyze")
    if analyzer:
        unit_files = [
            units / "nmcp.slice", *sorted(units.glob("nmcp-*.service")),
            *sorted(units.glob("nmcp-*.timer")), units / "nmcp.target"
        ]
        environment = os.environ.copy()
        environment["SYSTEMD_UNIT_PATH"] = f"{units}:/usr/lib/systemd/system:/lib/systemd/system"
        result = subprocess.run(
            [analyzer, "verify", *unit_files], text=True, capture_output=True, env=environment
        )
        output = result.stdout + result.stderr
        forbidden = ("Unknown key", "Failed to parse", "Ignoring unknown escape", "Invalid section")
        require(not any(item in output for item in forbidden), f"systemd parser warning:\n{output}")
        def allowed_missing(line: str) -> bool:
            return (
                "Command /opt/nmcp/current/bin/" in line
                or "Command /usr/sbin/nginx is not executable:" in line
                or "Command /usr/local/libexec/nmcp/" in line
            )
        unexpected = [
            line for line in output.splitlines()
            if line.strip() and not allowed_missing(line)
        ]
        require(not unexpected, "unexpected systemd verification output:\n" + "\n".join(unexpected))
        require(result.returncode in (0, 1), f"systemd-analyze exited {result.returncode}")
    else:
        print("SKIP: systemd-analyze unavailable; parser test must run in CI", file=sys.stderr)

    print("Ubuntu deployment static verification passed")
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (OSError, RuntimeError, UnicodeError) as error:
        print(f"verify-ubuntu-deployment: {error}", file=sys.stderr)
        sys.exit(1)
