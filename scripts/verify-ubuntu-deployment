        'cleanup_errors.append((label, RuntimeError(f"{label} could not run: {error}")))': 1,
        'cleanup_errors.append((label + "-report", error))': 1,
        'cleanup_errors.append((label + "-report", report_error))': 1,
    }
    require(all(cleanup_loop_source.count(fragment) == count
                for fragment, count in checked_cleanup_fragments.items()),
            "supervisor normal database cleanup commands must remain independently checked")
    require(source.index('print("Ubuntu migration role compatibility verification passed", flush=True)')
            > source.index('if cleanup_errors:'),
            "supervisor success marker must follow successful cleanup")
    require(source.count('print("Ubuntu migration role compatibility verification passed", flush=True)') == 1,
            "supervisor success marker must follow the one outer cleanup decision")
    outer_main = named_function(tree, "main")
    resource_initialization = ast.parse('''resources = {
    "lock_fd": None, "lock_keeper": None, "lock_keeper_group": None,
    "snapshot_fd": None, "retained_process": None, "retained_group": None,
    "lock_held": False, "intents_acquired": False,
    "keeper_marker": False, "database_cleanup": False,
}
''').body[0]
    require(ast.dump(outer_main.body[2]) == ast.dump(resource_initialization)
            and source.count("supervisor_cleanup_errors = cleanup_supervisor(resources)") == 1
            and source.count("result = run_supervisor_body(resources)") == 1,
            "supervisor resources must be initialized before one outer acquisition/cleanup system")
    cleanup_transition = ast.parse('''try:
    try:
        result = run_supervisor_body(resources)
    except BaseException as error:
        primary_error = error
finally:
    CLEANUP_TRANSITION_ERRORS = SIGNAL_ERRORS
    try:
        signal.pthread_sigmask(signal.SIG_BLOCK, HANDLED_TERMINATION_SIGNALS)
    except BaseException as error:
        CLEANUP_TRANSITION_ERRORS.append(("cleanup-transition-mask", error))
    supervisor_cleanup_errors = cleanup_supervisor(resources)
    cleanup_errors = (*(
        item for item in CLEANUP_TRANSITION_ERRORS if item[1] is not primary_error
    ), *supervisor_cleanup_errors)
''').body[0]
    require(len(outer_main.body) > 4
            and isinstance(outer_main.body[0], ast.Global)
            and outer_main.body[0].names == ["CLEANUP_TRANSITION_ERRORS"]
            and ast.dump(outer_main.body[1]) == ast.dump(
                ast.parse("SIGNAL_ERRORS.clear()").body[0])
            and ast.dump(outer_main.body[5]) == ast.dump(cleanup_transition)
            and not any(
                isinstance(node, ast.Attribute) and node.attr == "SIG_SETMASK"
                for node in ast.walk(outer_main)),
            "supervisor cleanup transition must latch, evidence, and non-restoringly mask every handled signal")
    nonce_contract = (
        'if os.geteuid() != 0 or len(sys.argv) not in (5, 6, 7):',
        'optional = list(sys.argv[5:])',
        'if optional and optional[-1].startswith("--persistent-launch-required="):',
        'launch_required = optional.pop().partition("=")[2]',
        'if len(optional) > 1:',
        'nonce = sys.argv[4]',
        'if (len(nonce) != 64 or any(character not in "0123456789abcdef" for character in nonce)',
        'or os.environ.get("NMCP_VERIFIER_NONCE") != nonce):',
        'die("supervisor launch nonce does not match its environment")',
        'FAULT_MODE = optional[0] if optional else ""',
    )
    require(all(source.count(fragment) == 1 for fragment in nonce_contract),
            "supervisor nonce argv/environment validation changed")
    require(source.count('resources["database_cleanup"] = True') == 1
            and source.index('resources["database_cleanup"] = True')
                < source.index('run(("/usr/bin/systemctl", "start", "postgresql"))')
            and source.index('resources["database_cleanup"] = True')
                > source.index('fsync_directory("/var/lib/nmcp/deployment")'),
            "supervisor database cleanup eligibility must begin immediately before PostgreSQL startup")
    acquisition_order = (
        'fcntl.flock(lock_fd, fcntl.LOCK_EX)',
        'resources["lock_held"] = True',
        'resources["intents_acquired"] = True',
        'recover_intents()\n    intents = []',
    )
    acquisition_positions = tuple(source.find(fragment) for fragment in acquisition_order)
    keeper_order = (
        'lock_keeper = launch_lock_keeper(resources, lock_fd)',
        'keeper_pid_fd = os.open(LOCK_KEEPER_PID_PATH,',
        'resources["keeper_marker"] = True',
    )
    keeper_positions = tuple(source.find(fragment) for fragment in keeper_order)
    require(all(position >= 0 for position in (*acquisition_positions, *keeper_positions))
            and acquisition_positions == tuple(sorted(acquisition_positions))
            and keeper_positions == tuple(sorted(keeper_positions)),
            "supervisor cleanup eligibility flags must follow actual resource acquisition")
    cleanup_source = ast.get_source_segment(source, cleanup_node) or ""
    require_exact_function(tree, "terminate_process_group", '''def terminate_process_group(group, category, timeout, cleanup_errors):
    if group is None:
        return True
    process = group["process"]
    pgid = group["pgid"]
    try:
        live = process_group_exists(pgid)
    except BaseException as error:
        cleanup_errors.append((category + "-probe", error))
        live = None
    if live is False:
        try:
            process.poll()
        except BaseException as error:
            cleanup_errors.append((category + "-reap", error))
        return True
    if live is True:
        try:
            os.killpg(pgid, signal.SIGTERM)
        except ProcessLookupError:
            live = False
        except BaseException as error:
            cleanup_errors.append((category + "-kill", error))
    timing_failed = False
    try:
        deadline = time.monotonic() + timeout
    except BaseException as error:
        cleanup_errors.append((category + "-wait-timing", error))
        timing_failed = True
        deadline = None
    while live is True and deadline is not None:
        try:
            expired = time.monotonic() >= deadline
        except BaseException as error:
            cleanup_errors.append((category + "-wait-timing", error))
            timing_failed = True
            break
        if expired:
            break
        try:
            process.poll()
        except BaseException as error:
            cleanup_errors.append((category + "-reap", error))
        try:
            live = process_group_exists(pgid)
        except BaseException as error:
            cleanup_errors.append((category + "-probe", error))
            live = None
            break
        if live:
            try:
                time.sleep(0.05)
            except BaseException as error:
                cleanup_errors.append((category + "-wait-timing", error))
                timing_failed = True
                break
    if live is True:
        try:
            os.killpg(pgid, signal.SIGKILL)
        except ProcessLookupError:
            live = False
        except BaseException as error:
            cleanup_errors.append((category + "-force-kill", error))
        try:
            deadline = time.monotonic() + timeout
        except BaseException as error:
            cleanup_errors.append((category + "-force-wait-timing", error))
            timing_failed = True
            deadline = None
        while live is True and deadline is not None:
            try:
                expired = time.monotonic() >= deadline
            except BaseException as error:
                cleanup_errors.append((category + "-force-wait-timing", error))
                timing_failed = True
                break
            if expired:
                break
            try:
                process.poll()
            except BaseException as error:
                cleanup_errors.append((category + "-reap", error))
            try:
                live = process_group_exists(pgid)
            except BaseException as error:
                cleanup_errors.append((category + "-probe", error))
                live = None
                break
            if live:
                try:
                    time.sleep(0.05)
                except BaseException as error:
                    cleanup_errors.append((category + "-force-wait-timing", error))
                    timing_failed = True
                    break
    if live is False and not timing_failed:
        try:
            process.poll()
        except BaseException as error:
            cleanup_errors.append((category + "-reap", error))
        return True
    cleanup_errors.append((category + "-containment-retained", RuntimeError(
        "process-group absence was not confirmed; transaction containment retained")))
    return False
''', "supervisor bounded process-group termination and quarantine categorization changed")
    quarantine_fragments = (
        'active_dead = terminate_process_group(',
        'retained_dead = terminate_process_group(',
        'if not (active_dead and retained_dead):\n        return tuple(cleanup_errors)',
        'keeper_dead = terminate_process_group(',
        'if not keeper_dead:\n        return tuple(cleanup_errors)',
        '("snapshot-close", error)', '("lock-keeper-marker-unlink", error)',
        '("lock-keeper-marker-fsync", error)', '("intent-recovery", error)',
        '("lock-close", error)',
    )
    require(all(cleanup_source.count(fragment) == 1 for fragment in quarantine_fragments)
            and cleanup_source.index('if not (active_dead and retained_dead):')
                < cleanup_source.index('cleanup_commands = (')
            and cleanup_source.index('if not keeper_dead:')
                < cleanup_source.index('os.unlink(LOCK_KEEPER_PID_PATH)')
                < cleanup_source.index('recover_intents()')
                < cleanup_source.index('os.close(lock_fd)'),
            "supervisor unconfirmed process death must retain transaction containment")
    aggregate_nodes = [
        node for node in tree.body
        if isinstance(node, ast.ClassDef) and node.name == "SupervisorCleanupFailure"
    ]
    cleanup_scope_nodes = [
        node for node in tree.body
        if isinstance(node, ast.ClassDef) and node.name == "CleanupScope"
    ]
    expected_cleanup_scope = ast.parse('''class CleanupScope:
    def __init__(self):
        self.actions = []

    def __enter__(self):
        return self

    def defer(self, category, function, *args, **kwargs):
        self.actions.append((category, function, args, kwargs))

    def __exit__(self, _kind, primary_error, _traceback):
        cleanup_errors = []
        for category, function, args, kwargs in reversed(self.actions):
            try:
                function(*args, **kwargs)
            except BaseException as error:
                cleanup_errors.append((category, error))
        if cleanup_errors:
            cause = primary_error if primary_error is not None else cleanup_errors[0][1]
            raise SupervisorCleanupFailure(primary_error, cleanup_errors) from cause
        return False
''').body[0]
    require(len(cleanup_scope_nodes) == 1
            and ast.dump(cleanup_scope_nodes[0]) == ast.dump(expected_cleanup_scope),
            "supervisor local cleanup aggregation/reverse-attempt contract changed")
    # Bind exact reviewed source fragments rather than ast.dump(): CPython may
    # add AST fields between patch-supported interpreter versions even when the
    # executable source and the semantic mutation contracts below are identical.
    reviewed_cleanup_snapshots = {
        "aggregate": "a7aa62116c41625b896ae355ee4caffa95d3eaaa78a3326acfdca0bfbad1b3df",
        "cleanup": "272bdf83b09cb93d6dfaaab409128e75232d56cc2c4748b781c6623881c87908",
        "main": "8b2e50531eb0817c4c5ab0fd371f39b15b24a1903897ce0355096197468f2f8b",
    }
    observed_cleanup_snapshots = {
        "aggregate": stable_node_source_digest(source, aggregate_nodes[0])
        if len(aggregate_nodes) == 1 else "",
        "cleanup": stable_node_source_digest(source, cleanup_node),
        "main": stable_node_source_digest(source, outer_main),
    }
    require(observed_cleanup_snapshots == reviewed_cleanup_snapshots,
            "supervisor reviewed cleanup control-flow snapshot changed")


def validate_client(source: str, *, enforce_snapshot: bool = True) -> None:
    tree = ast.parse(source, filename="verify-ubuntu-migration-role-client")
    # This client handles nonce-bearing argv, captured subprocess streams, and
    # journal bytes. Bind its canonical UTF-8/LF source as version-neutral
    # defense in depth, never as source authentication; semantic mutation tests
    # bypass this snapshot and must be rejected by the detailed inventories below.
    if enforce_snapshot:
        require(stable_source_digest(source)
                == "5ead6b684489aaa8793b6870ce9918eb47c8224ddfb34907e3c3a659c5a21d15",
                "client reviewed stable UTF-8/LF source snapshot changed")
    imports = [node for node in tree.body if isinstance(node, (ast.Import, ast.ImportFrom))]
    expected_imports = ast.parse('''import fcntl
import errno
import functools
import os
import select
import secrets
import shlex
import signal
import stat
import subprocess
import sys
import time
''').body
    require([ast.dump(node) for node in imports] == [ast.dump(node) for node in expected_imports],
            "client imports must remain the reviewed closed module set")
    evidence_classes = [
        node for node in tree.body
        if isinstance(node, ast.ClassDef) and node.name == "EvidenceFailure"
    ]
    expected_evidence_class = ast.parse('''class EvidenceFailure(RuntimeError):
    pass
''').body[0]
    require(len(evidence_classes) == 1
            and ast.dump(evidence_classes[0]) == ast.dump(expected_evidence_class),
            "client categorized evidence failure type changed")
    cancellation_classes = [
        node for node in tree.body
        if isinstance(node, ast.ClassDef) and node.name == "CancellationFailure"
    ]
    expected_cancellation_class = ast.parse('''class CancellationFailure(PrimaryFailure):
    def __init__(self, signum):
        super().__init__("cancelled", f"verification client cancelled by signal {signum}")
''').body[0]
    require(len(cancellation_classes) == 1
            and ast.dump(cancellation_classes[0]) == ast.dump(expected_cancellation_class),
            "client typed cancellation failure changed")
    cleanup_classes = [
        node for node in tree.body
        if isinstance(node, ast.ClassDef) and node.name == "CleanupFailure"
    ]
    expected_cleanup_class = ast.parse('''class CleanupFailure(RuntimeError):
    def __init__(self, message, constituents=()):
        super().__init__(message)
        self.constituents = tuple(constituents)
''').body[0]
    require(len(cleanup_classes) == 1
            and ast.dump(cleanup_classes[0]) == ast.dump(expected_cleanup_class),
            "client cleanup failure constituent retention changed")
    cgroup_classes = [
        node for node in tree.body
        if isinstance(node, ast.ClassDef) and node.name == "CgroupFailure"
    ]
    expected_cgroup_class = ast.parse('''class CgroupFailure(CleanupFailure):
    def __init__(self, message, residue_error, observation_errors):
        self.residue_error = residue_error
        self.observation_errors = tuple(observation_errors)
        super().__init__(message, tuple(
            error for error in (residue_error, *self.observation_errors) if error is not None))
''').body[0]
    require(len(cgroup_classes) == 1
            and ast.dump(cgroup_classes[0]) == ast.dump(expected_cgroup_class),
            "client structured cgroup failure identity changed")
    require_exact_assignment(tree, "RESULT_PREFIX", 'RESULT_PREFIX = "NMCP_CLIENT_RESULT_V1:"',
                             "client result prefix changed")
    require_exact_assignment(tree, "RESULT_BYTE_LIMIT", "RESULT_BYTE_LIMIT = select.PIPE_BUF",
                               "client result bound changed")
    require_exact_assignment(tree, "RESULT_EVENT_LIMIT", "RESULT_EVENT_LIMIT = 48",
                              "client result event bound changed")
    require_exact_assignment(tree, "CANCELLATION_FAILURE", "CANCELLATION_FAILURE = None",
                              "client cancellation identity latch changed")
    require_exact_assignment(tree, "CANCELLATION_ACCOUNTED", "CANCELLATION_ACCOUNTED = False",
                              "client cancellation accounting latch changed")
    require_exact_assignment(tree, "PRIMARY_CATEGORIES", '''PRIMARY_CATEGORIES = (
    "none", "cleanup-test", "cancelled", "verification", "unexpected",
)
''', "client primary result categories changed")
    require_exact_assignment(tree, "CLEANUP_BOUNDARIES", '''CLEANUP_BOUNDARIES = (
    "none", "show", "kill", "stop", "wait", "reset", "unload", "final")
''', "client cleanup result boundaries changed")
    require_exact_assignment(tree, "CLEANUP_CATEGORIES", '''CLEANUP_CATEGORIES = (
    "property-recovered", "kill-recovered", "stop-recovered", "reset-recovered",
    "property-unavailable", "kill-unavailable", "stop-unavailable", "reset-unavailable",
    "wait-timeout", "unload-timeout", "cgroup-residue", "cgroup-observation", "deadline",
    "cancelled", "unexpected",
)
''', "client cleanup result categories changed")
    require_exact_function(tree, "cleanup_result", '''def cleanup_result(category, boundary, errors=()):
    global RESULT_EVENTS_COMPLETE
    if boundary not in CLEANUP_BOUNDARIES:
        boundary = "none"
    if category not in CLEANUP_CATEGORIES or (boundary == "none" and category != "unexpected"):
        category = "unexpected"
    if len(RESULT_EVENTS) < RESULT_EVENT_LIMIT:
        snapshot = (RETRIES.get(boundary, 0), INTERCEPTIONS.get(boundary, 0),
                    ATTEMPTS.get(boundary, 0))
        RESULT_EVENTS.append((len(RESULT_EVENTS), boundary, category, *snapshot))
    else:
        RESULT_EVENTS_COMPLETE = False
    RESULT_MAPPED_CLEANUP_ERRORS.update(id(error) for error in errors)
''', "client cleanup result aggregation changed")
    require_exact_function(tree, "cleanup_fail", '''def cleanup_fail(category, boundary, message):
    error = CleanupFailure(message)
    cleanup_result(category, boundary, (error,))
    raise error
''', "client categorized cleanup failure mapping changed")
    require_exact_function(tree, "cleanup_error_mapped", '''def cleanup_error_mapped(error):
    if isinstance(error, CleanupFailure) and error.constituents:
        return all(cleanup_error_mapped(constituent) for constituent in error.constituents)
    return id(error) in RESULT_MAPPED_CLEANUP_ERRORS
''', "client per-error cleanup mapping changed")
    require_exact_function(tree, "record_cgroup_failure", '''def record_cgroup_failure(error, boundary):
    if not isinstance(error, CgroupFailure):
        cleanup_result("unexpected", boundary, (error,))
        return
    if error.residue_error is not None:
        cleanup_result("cgroup-residue", boundary, (error.residue_error,))
    if error.observation_errors:
        cleanup_result("cgroup-observation", boundary, error.observation_errors)
''', "client cgroup result classification must preserve every constituent identity")
    require_exact_function(tree, "aggregate_cleanup_failure", '''def aggregate_cleanup_failure(errors, nonce):
    diagnostics = []
    for error in errors:
        append_unique_diagnostic(diagnostics, sanitized_diagnostic(error, nonce))
    return CleanupFailure(
        sanitized_diagnostic("; ".join(diagnostics), nonce), tuple(errors))
''', "client aggregate cleanup failure must retain every constituent identity")
    require_exact_function(tree, "cleanup_retry", '''def cleanup_retry(boundary):
    if boundary not in CLEANUP_BOUNDARIES:
        boundary = "none"
    RETRIES[boundary] = RETRIES.get(boundary, 0) + 1
''', "client cleanup retry aggregation changed")
    require('''            wait_error = CleanupFailure(
                f"owned unit did not terminate its control group: {sanitized_state(state)}")
            cleanup_result("cgroup-residue" if occupants else "wait-timeout",
                           "wait", (wait_error,))
            errors.append(wait_error)''' in source,
            "client wait deadline must record classified immutable causal evidence")
    require_exact_function(tree, "property_result_boundary", '''def property_result_boundary(context):
    return {
        "show": "show", "prelaunch": "show", "immediate": "show",
        "recovery": "show", "owned-state": "show", "wait": "wait", "unload": "unload",
    }.get(context)
''', "client property result context routing changed")
    require_exact_function(tree, "property_command_path", '''def property_command_path(phase, context, result_boundary):
    before_interceptions = INTERCEPTIONS.get(context, 0)
    before_attempts = ATTEMPTS.get(context, 0)
    try:
        command_path(phase, context)
    finally:
        if context != result_boundary:
            INTERCEPTIONS[result_boundary] = (
                INTERCEPTIONS.get(result_boundary, 0)
                + INTERCEPTIONS.get(context, 0) - before_interceptions)
            ATTEMPTS[result_boundary] = (
                ATTEMPTS.get(result_boundary, 0) + ATTEMPTS.get(context, 0) - before_attempts)
''', "client property result counters changed")
    require_exact_function(tree, "primary_result_category", '''def primary_result_category(error):
    if error is None:
        return "none"
    return error.category if isinstance(error, PrimaryFailure) else "unexpected"
''', "client primary result derivation changed")
    require_exact_function(tree, "cancellation_exception", '''def cancellation_exception():
    global CANCELLATION_FAILURE
    if not CANCELLED:
        return None
    if CANCELLATION_FAILURE is None:
        CANCELLATION_FAILURE = CancellationFailure(CANCELLED[0])
    return CANCELLATION_FAILURE
''', "client cancellation detection must create a typed primary failure")
    require_exact_function(tree, "terminal_cancellation_exception", '''def terminal_cancellation_exception():
    pending = signal.sigpending() & CANCELLATION_SIGNALS
    cancellation = cancellation_exception()
    return cancellation or (CancellationFailure(min(pending)) if pending else None)
''', "client terminal cancellation must recheck both pending signals and the latch")
    require_exact_function(tree, "check_cancelled", '''def check_cancelled():
    error = cancellation_exception()
    if error is not None:
        raise error
''', "client cancellation checks must raise the typed primary failure directly")
    require_exact_function(tree, "primary_exception", '''def primary_exception(error, boundary):
    if isinstance(error, CgroupFailure):
        record_cgroup_failure(error, boundary)
    if isinstance(error, CancellationFailure):
        return error
    if isinstance(error, PrimaryFailure):
        return error
    return (PrimaryFailure("verification", str(error))
            if isinstance(error, RuntimeError) else error)
''', "client primary exception conversion must retain structured cgroup evidence")
    require_exact_function(tree, "preserve_primary", '''def preserve_primary(primary_error, error, boundary):
    candidate = primary_exception(error, boundary)
    if primary_error is None:
        return candidate
    cleanup_result("cancelled" if isinstance(candidate, CancellationFailure) else "unexpected",
                   boundary, (candidate,))
    return primary_error
''', "client first primary, including cancellation, must remain authoritative")
    require_exact_function(tree, "account_latched_cancellation", '''def account_latched_cancellation(primary_error, cleanup_errors, cancellation):
    global CANCELLATION_ACCOUNTED
    if cancellation is None or CANCELLATION_ACCOUNTED:
        return primary_error, cleanup_errors
    CANCELLATION_ACCOUNTED = True
    if isinstance(primary_error, CancellationFailure):
        return primary_error, cleanup_errors
    if primary_error is None:
        return cancellation, cleanup_errors
    if not cleanup_error_mapped(cancellation):
        cleanup_result("cancelled", "final", (cancellation,))
    if not any(error is cancellation for error in cleanup_errors):
        cleanup_errors = [*cleanup_errors, cancellation]
    return primary_error, cleanup_errors
