                         os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
    try:
        os_call(phase, "write", "marker", os.write, descriptor, b"ready\\n")
        os_call(phase, "fsync", "marker", os.fsync, descriptor)
    finally:
        os_call(phase, "close", "marker", os.close, descriptor)
    directory = os_call(phase, "open", "directory", os.open, RUN,
                        os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    try:
        os_call(phase, "fsync", "directory", os.fsync, directory)
    finally:
        os_call(phase, "close", "directory", os.close, directory)
''', "client attempting/acquired markers must be durably fsynced")
    require_exact_function(tree, "exhaust_work_budget", '''def exhaust_work_budget(boundary):
    global COMMAND_DEADLINE
    COMMAND_DEADLINE = min(COMMAND_DEADLINE,
                           time.monotonic() + WORK_BUDGET_FAULT_SECONDS)
    durable_marker("work", f"client-work-budget-{boundary}.ready")
    while time.monotonic() < COMMAND_DEADLINE:
        time.sleep(min(0.05, max(0, COMMAND_DEADLINE - time.monotonic())))
    fail(f"absolute client work budget exhausted at {boundary}")
''', "client accelerated work-budget exhaustion marker/deadline changed")
    require_exact_function(tree, "valid_invocation", '''def valid_invocation(value):
    return len(value) == 32 and all(character in "0123456789abcdef" for character in value)
''', "client exact InvocationID validator changed")
    contract = (
