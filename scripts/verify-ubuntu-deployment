            '    if False:')),
        ("stale loaded identity change accepted", replace_once(containment,
            '    if (unchanged.get("InvocationID") != stale_invocation or unchanged.get("ActiveState") != "failed"\n            or unchanged.get("Environment") != f"NMCP_VERIFIER_NONCE={stale_nonce}"):',
            '    if False:')),
        ("stale loaded cleanup omitted", replace_once(containment,
            '    cleanup_exact_invocation(stale_invocation)\n    wait_unit_absent()',
