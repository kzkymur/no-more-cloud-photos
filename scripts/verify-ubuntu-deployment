def validate_client(source: str, *, enforce_snapshot: bool = True) -> None:
    tree = ast.parse(source, filename="verify-ubuntu-migration-role-client")
    # This client handles nonce-bearing argv, captured subprocess streams, and
    # journal bytes. Bind its canonical UTF-8/LF source as version-neutral
    # defense in depth, never as source authentication; semantic mutation tests
    # bypass this snapshot and must be rejected by the detailed inventories below.
    if enforce_snapshot:
        require(stable_source_digest(source)
                == "9d64a5d8afed40e8c65c0555da1ad67788e42f6612b9a3cd85876127485b1538",
                "client reviewed stable UTF-8/LF source snapshot changed")
    imports = [node for node in tree.body if isinstance(node, (ast.Import, ast.ImportFrom))]
    expected_imports = ast.parse('''import fcntl
import errno
import functools
import os
import select
import secrets
import shlex
import signal
import stat
import subprocess
import sys
import time
''').body
    require([ast.dump(node) for node in imports] == [ast.dump(node) for node in expected_imports],
            "client imports must remain the reviewed closed module set")
    evidence_classes = [
        node for node in tree.body
        if isinstance(node, ast.ClassDef) and node.name == "EvidenceFailure"
    ]
    expected_evidence_class = ast.parse('''class EvidenceFailure(RuntimeError):
    pass
''').body[0]
    require(len(evidence_classes) == 1
            and ast.dump(evidence_classes[0]) == ast.dump(expected_evidence_class),
            "client categorized evidence failure type changed")
    require(literal_assignment(tree, "CGROUP_SNAPSHOT_ATTEMPTS") == 4
            and literal_assignment(tree, "RECORDED_CGROUP_LIMIT") == 64
            and literal_assignment(tree, "CANONICAL_CGROUP")
                == "/system.slice/nmcp-migration-role-verifier.service"
            and literal_assignment(tree, "CGROUP_RESIDUE_FAILURE") == "fixed-cgroup-residue=true"
            and literal_assignment(tree, "DIAGNOSTIC_PHASES") == (
                "final-close", "immediate", "journal", "launch", "ownership-read",
                "prelaunch", "recovery", "source-publication", "startup", "teardown",
                "transaction-lock", "uncategorized", "unload", "work")
            and literal_assignment(tree, "DIAGNOSTIC_OPERATIONS") == (
                "chdir", "chmod", "close", "fdopen", "flock", "flush", "fsync", "kill", "mkdir", "open",
                "popen", "read", "replace", "run", "seek", "set-blocking", "stat", "truncate",
                "unknown", "unlink", "wait", "walk", "write")
            and literal_assignment(tree, "DIAGNOSTIC_RESOURCES") == (
                "cgroup", "counter", "directory", "evidence", "helper", "journal", "lock", "marker",
                "process", "runtime-root", "unknown"),
            "client closed diagnostic/cgroup constants changed")
    require_exact_function(tree, "evidence_failure", '''def evidence_failure(phase, operation, resource_class, error):
    if (phase not in DIAGNOSTIC_PHASES or operation not in DIAGNOSTIC_OPERATIONS
            or resource_class not in DIAGNOSTIC_RESOURCES):
        phase, operation, resource_class = "uncategorized", "unknown", "unknown"
    number = error.errno if isinstance(error, OSError) and type(error.errno) is int else errno.EIO
    return EvidenceFailure(
        f"phase={phase} operation={operation} resource={resource_class} errno={number}")
''', "client OS evidence diagnostics must use only closed literal categories and numeric errno")
    require_exact_function(tree, "top_level_diagnostic", '''def top_level_diagnostic(error):
    if isinstance(error, OSError):
        return str(evidence_failure("uncategorized", "unknown", "unknown", error))
    return sanitized_diagnostic(error, None)
''', "client top-level fallback must retain the exact uncategorized OSError alarm")
    cgroup_source = ast.get_source_segment(source, named_function(tree, "cgroup_pids")) or ""
    cgroup_contract = (
        "for _attempt in range(CGROUP_SNAPSHOT_ATTEMPTS):",
        "cgroup_walk(phase, root)", "before = cgroup_fstat(phase, source)",
        "after = cgroup_fstat(phase, source)", "after_root = cgroup_stat(phase, root)",
        "if (before.st_dev, before.st_ino) != (after.st_dev, after.st_ino):",
        "if root_anchor is None:", "elif root_identity != root_anchor:",
        "if (after_root.st_dev, after_root.st_ino) != root_anchor:",
        "if root_anchor is not None and (rechecked.st_dev, rechecked.st_ino) != root_anchor:",
        "canonical = tuple(sorted((relative, device, inode)",
        "for _relative, directory, device, inode in identities:",
        "if (current.st_dev, current.st_ino) != (device, inode):",
        "residue_seen = False", "parsed = [int(value) for value in values]",
        "found.extend(parsed)", "residue_seen = residue_seen or bool(parsed)",
        "if not residue_seen and previous_absent:",
        "previous = None\n                if not residue_seen and previous_absent:",
        "previous = None\n            previous_absent = False\n            continue",
        'except ValueError:\n            fail("unit control group contained malformed process evidence")',
        "if snapshot == previous and (not residue_seen or bool(snapshot[2])):",
        'raise evidence_failure(phase, "walk", "evidence", OSError(errno.EAGAIN, "unstable"))',
    )
    require(all(cgroup_source.count(fragment) == 1 for fragment in cgroup_contract)
            and cgroup_source.count("except FileNotFoundError:") == 2
            and cgroup_source.count("if not stat.S_ISDIR(current.st_mode):") == 1
            and cgroup_source.count('if not control_group:\n        fail("unit control group path is missing")') == 1
            and cgroup_source.count("return []") == 1,
            "client coherent cgroup snapshot/retry contract changed")
    client_cgroup_boundaries = {
        "cgroup_walk_error": '(phase, "walk", "cgroup", error)',
        "cgroup_stat": '(phase, "stat", resource_class, error)',
        "cgroup_walk": 'functools.partial(cgroup_walk_error, phase)',
        "cgroup_open": '(phase, "open", "cgroup", error)',
        "cgroup_fstat": '(phase, "stat", "evidence", error)',
        "cgroup_read": '(phase, "read", "evidence", error)',
        "cgroup_close": '(phase, "close", "evidence", error)',
    }
    require(all(fragment in (ast.get_source_segment(source, named_function(tree, name)) or "")
                for name, fragment in client_cgroup_boundaries.items()),
            "client cgroup boundaries lost exact closed operation labels")
    require_exact_assignment(tree, "RECORDED_CGROUP", "RECORDED_CGROUP = []",
                             "client retained control-group state changed")
    require_exact_function(tree, "retain_control_group", '''def retain_control_group(state):
    if state.get("LoadState") == "not-found":
        return
    control_group = state.get("ControlGroup")
    if (type(control_group) is not str or not control_group.startswith("/")
            or control_group == "/" or os.path.normpath(control_group) != control_group):
        fail("loaded fixed unit has an invalid control group path")
    if control_group not in RECORDED_CGROUP:
        RECORDED_CGROUP.append(control_group)
    if len(RECORDED_CGROUP) > RECORDED_CGROUP_LIMIT:
        fail("too many fixed unit control group paths were observed")
''', "client must append every valid loaded-state control group across explicit absence")
    require_exact_function(tree, "fixed_cgroup_paths", '''def fixed_cgroup_paths():
    return tuple(dict.fromkeys((*RECORDED_CGROUP, CANONICAL_CGROUP)))
''', "client fixed cgroup paths must include retained and canonical paths exactly once")
    require_exact_function(tree, "cgroup_observation_error", '''def cgroup_observation_error(phase, error):
    if isinstance(error, EvidenceFailure):
        return error
    if isinstance(error, OSError):
        return evidence_failure(phase, "unknown", "cgroup", error)
    return evidence_failure(phase, "unknown", "cgroup", OSError(errno.EIO, "observation failed"))
''', "client cgroup observation errors must retain only typed closed diagnostics")
    require_exact_function(tree, "append_unique_diagnostic", '''def append_unique_diagnostic(diagnostics, diagnostic):
    if type(diagnostic) is not str:
        fail("diagnostic aggregation requires a string")
    if diagnostic not in diagnostics:
        diagnostics.append(diagnostic)
''', "client diagnostic aggregation must preserve ordered distinct safe strings exactly once")
    require_exact_function(tree, "fixed_cgroup_residue", '''def fixed_cgroup_residue(phase):
    residue = {}
    errors = []
    for control_group in fixed_cgroup_paths():
        try:
            pids = cgroup_pids(control_group, phase)
        except BaseException as error:
            diagnostic = cgroup_observation_error(phase, error)
            append_unique_diagnostic(errors, str(diagnostic))
            continue
        if pids:
            residue[control_group] = pids
    return residue, tuple(errors)
''', "client must exhaustively retain residue and deduplicated observation failures")
    require_exact_function(tree, "assert_fixed_cgroups_empty", '''def assert_fixed_cgroups_empty(phase):
    residue, errors = fixed_cgroup_residue(phase)
    failures = ([CGROUP_RESIDUE_FAILURE] if residue else []) + list(errors)
    if failures:
        fail(sanitized_diagnostic("; ".join(failures), None))
''', "client must prioritize residue and bound safe exhaustive cgroup observation failures")
    require_exact_function(tree, "assert_prelaunch_absent", '''def assert_prelaunch_absent(state):
    retain_control_group(state)
    assert_fixed_cgroups_empty("prelaunch")
    if state.get("LoadState") != "not-found":
        fail("fixed verification unit is not explicitly absent: "
             f"{sanitized_state(state)}")
''', "client prelaunch must inspect retained/canonical cgroups before loaded-state rejection")
    require_exact_function(tree, "resolve_outcome", '''def resolve_outcome(primary_error, cleanup_errors, nonce):
    try:
