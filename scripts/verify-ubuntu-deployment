        if isinstance(node, ast.NamedExpr):
            persistent_binding_violations.append(node)
        elif (isinstance(node, ast.Name)
                and node.id in {"__builtins__", "exec", "eval", "compile", "__import__",
                                "getattr", "setattr", "delattr", "globals", "locals", "vars"}):
            persistent_binding_violations.append(node)
        elif (isinstance(node, ast.Name) and node.id in protected_persistent_bindings
                and isinstance(node.ctx, (ast.Store, ast.Del))
                and node not in reviewed_persistent_assignments):
            persistent_binding_violations.append(node)
        elif (isinstance(node, (ast.Global, ast.Nonlocal))
              and protected_persistent_bindings.intersection(node.names)):
            persistent_binding_violations.append(node)
        elif (isinstance(node, ast.Attribute) and node.attr in protected_persistent_bindings
              and isinstance(node.ctx, (ast.Store, ast.Del))
              and node not in reviewed_evidence_attribute_stores):
            persistent_binding_violations.append(node)
        elif (isinstance(node, ast.Attribute)
              and isinstance(node.ctx, (ast.Store, ast.Del))
              and node not in reviewed_evidence_attribute_stores):
            persistent_binding_violations.append(node)
        elif (isinstance(node, ast.Subscript) and isinstance(node.ctx, (ast.Store, ast.Del))
              and any(isinstance(child, ast.Name)
                      and child.id in expected_module_assignments for child in ast.walk(node.value))):
            persistent_binding_violations.append(node)
        elif (isinstance(node, ast.Call) and isinstance(node.func, ast.Attribute)
              and node.func.attr in {"update", "setdefault", "pop", "popitem", "clear",
