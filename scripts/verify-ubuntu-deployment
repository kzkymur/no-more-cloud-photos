    expected_finally = ast.parse('''try:
    pass
finally:
    cleanup_deadline = min(total_deadline, time.monotonic() + CLEANUP_BUDGET)
    COMMAND_DEADLINE = cleanup_deadline
    CLEANUP_ACTIVE = True
    previous_mask = signal.pthread_sigmask(signal.SIG_BLOCK, CANCELLATION_SIGNALS)
    try:
        if launch_attempted and invocation is None:
            try:
                discovered = launch_state("recovery", context="recovery")
                candidate_invocation = discovered.get("InvocationID", "")
                if discovered.get("LoadState") == "not-found":
                    assert_fixed_cgroups_empty("teardown")
                elif (valid_invocation(candidate_invocation)
                      and launch_matches(discovered, nonce, exec_argv)):
                    invocation = candidate_invocation
                    teardown_owned(invocation, nonce, exec_argv)
                else:
                    cleanup_errors.append(RuntimeError(
                        "launched unit has no safe nonce-bound identity: "
                        f"{sanitized_state(discovered)}"))
            except BaseException as error:
                cleanup_errors.append(error)
        elif launch_attempted:
            try:
                teardown_owned(invocation, nonce, exec_argv)
            except BaseException as error:
                cleanup_errors.append(error)
    finally:
        signal.pthread_sigmask(signal.SIG_SETMASK, previous_mask)
        CLEANUP_ACTIVE = False
    if requested_mode in WORK_BUDGET_MODES:
        try:
            client_pause("unload", requested_mode + "-unloaded")
        except BaseException as error:
            cleanup_errors.append(error)
    COMMAND_DEADLINE = work_deadline
    if CANCELLED:
        cancellation = RuntimeError(f"verification client cancelled by signal {CANCELLED[0]}")
        if primary_error is None:
            primary_error = cancellation
        elif str(cancellation) not in str(primary_error):
            cleanup_errors.append(cancellation)
    if RECOVERED_ERRORS:
        cleanup_errors.extend(RECOVERED_ERRORS)
''').body[0].finalbody
    require(len(launch_try.handlers) == 1
            and ast.dump(launch_try.handlers[0]) == ast.dump(expected_handler)
            and [ast.dump(node) for node in launch_try.finalbody]
            == [ast.dump(node) for node in expected_finally],
            "client post-launch failures must aggregate owned teardown errors")
    require(ast.dump(launch_try.finalbody[0]) == ast.dump(ast.parse(
                "cleanup_deadline = min(total_deadline, time.monotonic() + CLEANUP_BUDGET)"
            ).body[0])
            and ast.dump(launch_try.finalbody[1]) == ast.dump(
                ast.parse("COMMAND_DEADLINE = cleanup_deadline").body[0])
            and ast.dump(launch_try.finalbody[5]) == ast.dump(
                ast.parse('''if requested_mode in WORK_BUDGET_MODES:
    try:
        client_pause("unload", requested_mode + "-unloaded")
    except BaseException as error:
        cleanup_errors.append(error)
''').body[0])
            and ast.dump(launch_try.finalbody[6]) == ast.dump(
                ast.parse("COMMAND_DEADLINE = work_deadline").body[0]),
            "client cleanup budget must encompass only signal-blocked owned teardown")
    deadline_assignments = [
        node for node in ast.walk(tree) if isinstance(node, ast.Assign)
        and len(node.targets) == 1 and isinstance(node.targets[0], ast.Name)
        and node.targets[0].id == "COMMAND_DEADLINE"
    ]
    top_deadline_assignments = [node for node in tree.body if node in deadline_assignments]
    exhaust_node = named_function(tree, "exhaust_work_budget")
    exhaust_deadline_assignments = [
        node for node in ast.walk(exhaust_node) if node in deadline_assignments
    ]
    require(len(top_deadline_assignments) == 1 and len(exhaust_deadline_assignments) == 1,
            "client COMMAND_DEADLINE initialization/helper assignment changed")
    expected_deadline_assignments = (
        *top_deadline_assignments,
        *exhaust_deadline_assignments,
        lock_try.body[total_deadline_starts[0] + 2],
        launch_try.finalbody[1],
        launch_try.finalbody[6],
    )
    deadline_stores_or_deletes = [
        node for node in ast.walk(tree) if isinstance(node, ast.Name)
        and node.id == "COMMAND_DEADLINE" and isinstance(node.ctx, (ast.Store, ast.Del))
    ]
    expected_deadline_targets = [node.targets[0] for node in expected_deadline_assignments]
    exact_deadline_function_names = [
        node for function_name in (
            "bounded_deadline", "bounded_journal_evidence", "command", "command_path", "exhaust_work_budget",
            "wait_unloaded", "teardown_owned",
        )
        for node in ast.walk(named_function(tree, function_name))
        if isinstance(node, ast.Name) and node.id == "COMMAND_DEADLINE"
    ]
    expected_deadline_names = [
        top_deadline_assignments[0].targets[0],
        *exact_deadline_function_names,
        lock_try.body[total_deadline_starts[0] + 2].targets[0],
        launch_try.finalbody[1].targets[0],
        launch_try.finalbody[6].targets[0],
    ]
    all_deadline_names = [
        node for node in ast.walk(tree)
        if isinstance(node, ast.Name) and node.id == "COMMAND_DEADLINE"
    ]
    indirect_deadline_mutations = [
        node for node in ast.walk(tree)
        if isinstance(node, ast.Attribute) and node.attr == "COMMAND_DEADLINE"
        and isinstance(node.ctx, (ast.Store, ast.Del))
        or isinstance(node, ast.Subscript) and isinstance(node.ctx, (ast.Store, ast.Del))
        and constant_string(node.slice) == "COMMAND_DEADLINE"
    ]
    deadline_globals = [
        node for node in ast.walk(tree)
        if isinstance(node, ast.Global) and "COMMAND_DEADLINE" in node.names
    ]
    expected_globals = {
        ast.dump(ast.parse("global COMMAND_DEADLINE").body[0]),
        ast.dump(ast.parse("global CLEANUP_ACTIVE, COMMAND_DEADLINE, REQUESTED_MODE").body[0]),
    }
    forbidden_reflection = {
        "eval", "exec", "compile", "getattr", "setattr", "delattr",
        "globals", "locals", "vars", "__import__", "_getframe",
        "__getattribute__", "__setattr__", "__delattr__",
    }
    reflection_nodes = [
        node for node in ast.walk(tree)
        if isinstance(node, ast.Name)
        and node.id in forbidden_reflection | {"importlib", "builtins", "__builtins__"}
        or isinstance(node, ast.Attribute)
        and node.attr in forbidden_reflection | {
            "__dict__", "__globals__", "f_globals", "f_locals", "gi_frame", "cr_frame", "tb_frame",
            "__code__", "__closure__", "__defaults__", "__kwdefaults__",
            "modules", "importlib", "builtins",
        }
        or isinstance(node, ast.Attribute) and isinstance(node.value, ast.Name)
        and node.value.id == "sys" and node.attr == "modules"
        or isinstance(node, ast.Import)
        and any(alias.name.split(".", 1)[0] in {"__main__", "importlib", "builtins"}
                for alias in node.names)
        or isinstance(node, ast.ImportFrom)
        and (node.module or "").split(".", 1)[0] in {"__main__", "importlib", "builtins"}
        or isinstance(node, ast.ImportFrom)
        and any(alias.name == "*" for alias in node.names)
    ]
    top_level_functions = [node for node in tree.body if isinstance(node, ast.FunctionDef)]
    protected_callable_names = {node.name for node in top_level_functions}
    require(len(protected_callable_names) == len(top_level_functions),
            "client top-level helper definitions must have unique protected names")
    callable_stores_or_deletes = [
        node for node in ast.walk(tree) if isinstance(node, ast.Name)
        and node.id in protected_callable_names and isinstance(node.ctx, (ast.Store, ast.Del))
    ]
    callable_scope_declarations = [
        node for node in ast.walk(tree) if isinstance(node, (ast.Global, ast.Nonlocal))
        and protected_callable_names.intersection(node.names)
    ]
    callable_attribute_stores_or_deletes = [
        node for node in ast.walk(tree) if isinstance(node, ast.Attribute)
        and node.attr in protected_callable_names and isinstance(node.ctx, (ast.Store, ast.Del))
    ]
    callable_binders = []
    for node in ast.walk(tree):
        names = []
        if isinstance(node, ast.arg):
            names.append(node.arg)
        elif isinstance(node, ast.ExceptHandler) and node.name:
            names.append(node.name)
        elif isinstance(node, ast.alias):
            names.append(node.asname or node.name.split(".", 1)[0])
        elif isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef, ast.ClassDef)):
            if node not in top_level_functions:
                names.append(node.name)
        elif isinstance(node, (ast.MatchAs, ast.MatchStar)) and node.name:
            names.append(node.name)
        elif isinstance(node, ast.MatchMapping) and node.rest:
            names.append(node.rest)
        if protected_callable_names.intersection(names):
            callable_binders.append(node)
    callable_string_indirection = [
        node for node in ast.walk(tree) if constant_string(node) in protected_callable_names
    ]
    computed_deadline_strings = [
        node for node in ast.walk(tree)
        if constant_string(node) is not None
        and "COMMAND_DEADLINE" in constant_string(node)
    ]
    require(len(top_deadline_assignments) == 1
            and ast.dump(top_deadline_assignments[0])
            == ast.dump(ast.parse("COMMAND_DEADLINE = None").body[0])
            and len(exhaust_deadline_assignments) == 1
            and len(deadline_assignments) == len(expected_deadline_assignments) == 5
            and all(any(node is expected for expected in expected_deadline_targets)
                    for node in deadline_stores_or_deletes)
            and len(deadline_stores_or_deletes) == len(expected_deadline_targets)
            and len(all_deadline_names) == len(expected_deadline_names)
            and all(any(node is expected for expected in expected_deadline_names)
                    for node in all_deadline_names)
            and not indirect_deadline_mutations
            and {ast.dump(node) for node in deadline_globals} == expected_globals
            and len(deadline_globals) == 2
            and not reflection_nodes
            and not computed_deadline_strings,
            "client COMMAND_DEADLINE mutation surface exceeds the reviewed assignments")
    require(not callable_stores_or_deletes
            and not callable_scope_declarations
            and not callable_attribute_stores_or_deletes
            and not callable_binders
            and not callable_string_indirection,
            "client protected helper binding has an unreviewed rebind or mutation path")
    budget_constants = {
        "PROPERTY_RETRIES", "PROPERTY_RETRY_BUDGET", "TOTAL_BUDGET", "CLEANUP_RESERVE",
        "CLEANUP_BUDGET", "ACTION_ATTEMPTS", "ACTION_TIMEOUTS",
        "ACTION_RETRY_BACKOFF", "KILL_WAIT_TIMEOUT", "UNLOAD_TIMEOUT",
        "CLEANUP_MARGIN", "CLEANUP_ENVELOPE", "WORK_BUDGET_FAULT_SECONDS",
        "SLOW_PROPERTY_FAULT_SECONDS", "SLOW_ACTION_FAULT_SECONDS", "WORK_BUDGET_MODES",
    }
    security_constants = {
        "UNIT", "RUN", "PROGRAM", "PATH", "ENVIRONMENT", "NONCE_VARIABLE",
        "DESCRIPTION_PREFIX", "SERVICE_PROPERTIES", "CLIENT_FAULTS", "CANCELLATION_SIGNALS",
        "SUCCESS", "CLEANUP_DATABASE_FAILURE", "CLEANUP_ROLES_FAILURE",
        "JOURNAL_TIMEOUT", "JOURNAL_BYTE_LIMIT", "JOURNAL_LINE_LIMIT",
        "JOURNAL_QUERY_LINE_LIMIT",
    }
    protected_constants = budget_constants | security_constants
    expected_protected_load_counts = {
        "ACTION_ATTEMPTS": 6, "ACTION_RETRY_BACKOFF": 3, "ACTION_TIMEOUTS": 3,
        "CANCELLATION_SIGNALS": 4, "CLEANUP_BUDGET": 2, "CLEANUP_ENVELOPE": 1,
        "CLEANUP_DATABASE_FAILURE": 3, "CLEANUP_ROLES_FAILURE": 3,
        "CLEANUP_MARGIN": 1, "CLEANUP_RESERVE": 2, "CLIENT_FAULTS": 1,
        "DESCRIPTION_PREFIX": 2, "ENVIRONMENT": 2, "JOURNAL_BYTE_LIMIT": 3,
        "JOURNAL_LINE_LIMIT": 1, "JOURNAL_QUERY_LINE_LIMIT": 1,
        "JOURNAL_TIMEOUT": 1, "KILL_WAIT_TIMEOUT": 2,
        "NONCE_VARIABLE": 3, "PATH": 1, "PROGRAM": 3, "PROPERTY_RETRIES": 2,
        "PROPERTY_RETRY_BUDGET": 2, "RUN": 13, "SERVICE_PROPERTIES": 3,
        "SLOW_ACTION_FAULT_SECONDS": 1, "SLOW_PROPERTY_FAULT_SECONDS": 1,
        "SUCCESS": 5, "TOTAL_BUDGET": 2, "UNIT": 3, "UNLOAD_TIMEOUT": 2,
        "WORK_BUDGET_FAULT_SECONDS": 1, "WORK_BUDGET_MODES": 2,
    }
    observed_protected_load_counts = {
        name: sum(1 for node in ast.walk(tree) if isinstance(node, ast.Name)
                  and node.id == name and isinstance(node.ctx, ast.Load))
        for name in protected_constants
    }
    budget_state = budget_constants | {"total_deadline", "work_deadline", "COMMAND_DEADLINE"}
    module_budget_assignments = {}
    for name in budget_constants:
        matches = [
            node for node in tree.body if isinstance(node, ast.Assign)
            and len(node.targets) == 1 and isinstance(node.targets[0], ast.Name)
            and node.targets[0].id == name
        ]
        require(len(matches) == 1, f"client must define budget constant {name} exactly once")
        module_budget_assignments[name] = matches[0]
    module_security_assignments = {}
    for name in security_constants:
        matches = [
            node for node in tree.body if isinstance(node, ast.Assign)
            and len(node.targets) == 1 and isinstance(node.targets[0], ast.Name)
            and node.targets[0].id == name
        ]
        require(len(matches) == 1, f"client must define security constant {name} exactly once")
        module_security_assignments[name] = matches[0]
    allowed_protected_strings = {
        id(node) for node in ast.walk(module_security_assignments["ENVIRONMENT"])
        if constant_string(node) in protected_constants
    }
    protected_string_indirection = [
        node for node in ast.walk(tree) if constant_string(node) in protected_constants
        and id(node) not in allowed_protected_strings
    ]
    total_assignment = lock_try.body[total_deadline_starts[0]]
    work_assignment = lock_try.body[total_deadline_starts[0] + 1]
    exact_budget_regions = (
        total_assignment, work_assignment,
        envelope_assignment, startup_matches[0],
        named_function(tree, "command_path"), named_function(tree, "unit_properties"),
        named_function(tree, "owned_command"), named_function(tree, "retry_owned_command"),
        named_function(tree, "wait_unloaded"), named_function(tree, "teardown_owned"), exhaust_node,
        *main_node.body[routing_starts[0]:routing_starts[0] + 2],
        launch_try.finalbody[0], launch_try.finalbody[5],
    )
    expected_constant_names = [
        assignment.targets[0] for assignment in module_budget_assignments.values()
    ] + [
        node for region in exact_budget_regions for node in ast.walk(region)
        if isinstance(node, ast.Name) and node.id in budget_constants
        and isinstance(node.ctx, ast.Load)
    ]
    observed_constant_names = [
        node for node in ast.walk(tree)
        if isinstance(node, ast.Name) and node.id in budget_constants
    ]
    exact_local_budget_regions = (
        total_assignment, work_assignment,
        lock_try.body[total_deadline_starts[0] + 2],
        launch_try.finalbody[0], launch_try.finalbody[1], launch_try.finalbody[6],
    )
    expected_local_budget_names = [
        node for region in exact_local_budget_regions for node in ast.walk(region)
        if isinstance(node, ast.Name) and node.id in {"total_deadline", "work_deadline"}
    ]
    observed_local_budget_names = [
        node for node in ast.walk(tree)
        if isinstance(node, ast.Name) and node.id in {"total_deadline", "work_deadline"}
    ]
    expected_budget_targets = [
        *[assignment.targets[0] for assignment in module_budget_assignments.values()],
        total_assignment.targets[0], work_assignment.targets[0],
        *expected_deadline_targets,
    ]
    observed_budget_stores_or_deletes = [
        node for node in ast.walk(tree) if isinstance(node, ast.Name)
        and node.id in budget_state and isinstance(node.ctx, (ast.Store, ast.Del))
    ]
    budget_scope_declarations = [
        node for node in ast.walk(tree) if isinstance(node, (ast.Global, ast.Nonlocal))
        and budget_state.intersection(node.names)
    ]
    mutable_budget_names = {
        "ACTION_TIMEOUTS", "SLOW_ACTION_FAULT_SECONDS", "WORK_BUDGET_MODES",
        "ENVIRONMENT", "SERVICE_PROPERTIES", "CLIENT_FAULTS", "CANCELLATION_SIGNALS",
    }
    mutable_budget_item_changes = [
        node for node in ast.walk(tree) if isinstance(node, ast.Subscript)
        and isinstance(node.value, ast.Name) and node.value.id in mutable_budget_names
        and isinstance(node.ctx, (ast.Store, ast.Del))
    ]
    mutating_methods = {
        "add", "clear", "difference_update", "discard", "intersection_update", "pop",
        "popitem", "remove", "setdefault", "symmetric_difference_update", "update",
    }
    mutable_budget_method_changes = [
        node for node in ast.walk(tree) if isinstance(node, ast.Call)
        and isinstance(node.func, ast.Attribute) and node.func.attr in mutating_methods
        and isinstance(node.func.value, ast.Name) and node.func.value.id in mutable_budget_names
    ]
    mutable_alias_binders = []
    reviewed_mutable_assignments = {
        id(assignment) for assignment in (
            *module_budget_assignments.values(), *module_security_assignments.values()
        )
    }
    reviewed_mutable_assignment_counts = {
        ast.dump(ast.parse('''delay = (SLOW_PROPERTY_FAULT_SECONDS if name == "show"
         else SLOW_ACTION_FAULT_SECONDS[name])
''').body[0]): 1,
        ast.dump(ast.parse('''state = unit_properties(phase, "LoadState", "InvocationID", "ActiveState", "SubState",
                         "ControlGroup", "Description", "Environment", "ExecStart",
                         *SERVICE_PROPERTIES, *properties, context=context)
''').body[0]): 1,
        ast.dump(ast.parse('''result = command(("/usr/bin/systemctl", *arguments, UNIT), "teardown", check=False,
                 timeout=ACTION_TIMEOUTS[arguments[0]])
''').body[0]): 1,
        ast.dump(ast.parse(
            "previous_mask = signal.pthread_sigmask(signal.SIG_BLOCK, CANCELLATION_SIGNALS)"
        ).body[0]): 2,
        ast.dump(ast.parse('''process = subprocess.Popen(argv, cwd="/", env=ENVIRONMENT, stdout=subprocess.PIPE,
                           stderr=subprocess.DEVNULL)
''').body[0]): 1,
    }
    observed_reviewed_mutable_assignments = {
        dump: sum(1 for node in ast.walk(tree) if isinstance(node, ast.Assign)
                  and ast.dump(node) == dump)
        for dump in reviewed_mutable_assignment_counts
    }
    for node in ast.walk(tree):
        if not isinstance(node, (ast.Assign, ast.AnnAssign, ast.NamedExpr)):
            continue
        value = node.value
        if (id(node) not in reviewed_mutable_assignments
                and ast.dump(node) not in reviewed_mutable_assignment_counts and any(
            isinstance(candidate, ast.Name) and candidate.id in mutable_budget_names
            and isinstance(candidate.ctx, ast.Load) for candidate in ast.walk(value)
        )):
            mutable_alias_binders.append(node)
    expected_protected_targets = {
        id(assignment.targets[0])
        for assignment in (*module_budget_assignments.values(), *module_security_assignments.values())
    }
    observed_protected_stores_or_deletes = [
        node for node in ast.walk(tree) if isinstance(node, ast.Name)
        and node.id in protected_constants and isinstance(node.ctx, (ast.Store, ast.Del))
    ]
    protected_attribute_stores_or_deletes = [
        node for node in ast.walk(tree) if isinstance(node, ast.Attribute)
        and node.attr in protected_constants and isinstance(node.ctx, (ast.Store, ast.Del))
    ]
    protected_scope_declarations = [
        node for node in ast.walk(tree) if isinstance(node, (ast.Global, ast.Nonlocal))
        and protected_constants.intersection(node.names)
    ]
    reviewed_mutable_iterations = {
        ast.dump(ast.parse('''for signum in CANCELLATION_SIGNALS:
    signal.signal(signum, interrupted)
''').body[0]): 1,
        ast.dump(ast.parse('''all(state.get(name) == expected
    for name, expected in SERVICE_PROPERTIES.items())
''', mode="eval").body.args[0].generators[0]): 1,
    }
    observed_reviewed_mutable_iterations = {
        dump: sum(1 for node in ast.walk(tree)
                  if isinstance(node, (ast.For, ast.AsyncFor, ast.comprehension))
                  and ast.dump(node) == dump)
        for dump in reviewed_mutable_iterations
    }
    mutable_binding_escapes = []
    for node in ast.walk(tree):
        expressions = []
        if isinstance(node, (ast.For, ast.AsyncFor, ast.comprehension)):
            expressions.append(node.iter)
        elif isinstance(node, ast.Match):
            expressions.append(node.subject)
        elif isinstance(node, ast.withitem):
            expressions.append(node.context_expr)
        elif isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef, ast.Lambda)):
            expressions.extend((*node.args.defaults, *[value for value in node.args.kw_defaults
                                                        if value is not None]))
        if (expressions and ast.dump(node) not in reviewed_mutable_iterations
                and any(isinstance(candidate, ast.Name)
                        and candidate.id in mutable_budget_names
                        and isinstance(candidate.ctx, ast.Load)
                        for expression in expressions for candidate in ast.walk(expression))):
            mutable_binding_escapes.append(node)
    budget_string_binders = []
    for node in ast.walk(tree):
        names = []
        if isinstance(node, ast.arg):
            names.append(node.arg)
        elif isinstance(node, ast.ExceptHandler) and node.name:
            names.append(node.name)
        elif isinstance(node, ast.alias):
            names.append(node.asname or node.name.split(".", 1)[0])
        elif isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef, ast.ClassDef)):
            names.append(node.name)
        elif isinstance(node, (ast.MatchAs, ast.MatchStar)) and node.name:
            names.append(node.name)
        elif isinstance(node, ast.MatchMapping) and node.rest:
            names.append(node.rest)
        if (budget_state | protected_constants).intersection(names):
            budget_string_binders.append(node)
    require(len(observed_constant_names) == len(expected_constant_names)
            and observed_protected_load_counts == expected_protected_load_counts
            and not protected_string_indirection
            and len(observed_protected_stores_or_deletes) == len(expected_protected_targets)
            and all(id(node) in expected_protected_targets
                    for node in observed_protected_stores_or_deletes)
            and not protected_scope_declarations
            and not protected_attribute_stores_or_deletes
            and all(any(node is expected for expected in expected_constant_names)
                    for node in observed_constant_names)
            and len(observed_local_budget_names) == len(expected_local_budget_names)
            and all(any(node is expected for expected in expected_local_budget_names)
                    for node in observed_local_budget_names)
            and len(observed_budget_stores_or_deletes) == len(expected_budget_targets)
            and all(any(node is expected for expected in expected_budget_targets)
                    for node in observed_budget_stores_or_deletes)
            and len(budget_scope_declarations) == len(deadline_globals)
            and all(any(node is expected for expected in deadline_globals)
                    for node in budget_scope_declarations)
            and not mutable_budget_item_changes
            and not mutable_budget_method_changes
            and not mutable_alias_binders
            and observed_reviewed_mutable_assignments == reviewed_mutable_assignment_counts
            and not mutable_binding_escapes
            and observed_reviewed_mutable_iterations == reviewed_mutable_iterations
            and not budget_string_binders,
            "client budget state has an unreviewed assignment, alias, deletion, or rebind")
    exhaust_calls = [
        node for node in ast.walk(tree) if isinstance(node, ast.Call)
        and isinstance(node.func, ast.Name) and node.func.id == "exhaust_work_budget"
    ]
    expected_exhaust_guards = {
        ast.dump(ast.parse(f'requested_mode == "client-work-budget-{boundary}"',
                           mode="eval").body): boundary
        for boundary in ("launch", "service", "journal", "slow-cleanup")
    }
    observed_exhaust_guards = {}
    for call in exhaust_calls:
        parent = parents.get(call)
        require(isinstance(parent, ast.Expr) and isinstance(parents.get(parent), ast.If),
                "client work-budget exhaustion calls must be directly guarded")
        guard = parents[parent]
        require(len(guard.body) == 1 and guard.body[0] is parent and not guard.orelse
                and len(call.args) == 1 and isinstance(call.args[0], ast.Constant),
                "client work-budget exhaustion guard changed")
        observed_exhaust_guards[ast.dump(guard.test)] = call.args[0].value
    require(len(exhaust_calls) == 4 and observed_exhaust_guards == expected_exhaust_guards,
            "client may accelerate work exhaustion only at the four reviewed boundaries")
    expected_outcome = ast.parse('''resolve_outcome(primary_error, cleanup_errors, nonce)
if requested_mode == "client-terminal-race-a":
    client_pause("unload", "client-terminal-race-a-unloaded")
''').body
    require([ast.dump(node) for node in lock_try.body[launch_index + 1:]]
            == [ast.dump(node) for node in expected_outcome],
            "client must immediately resolve primary/cleanup errors after the inner finally")
    expected_post_lock = ast.parse('''print(SUCCESS, flush=True)
return result
''').body
    lock_index = main_node.body.index(lock_try)
    require([ast.dump(node) for node in main_node.body[lock_index + 1:]]
            == [ast.dump(node) for node in expected_post_lock],
            "client must emit success only after client.lock closes successfully")

    invocation_assignments = [
        node for node in ast.walk(main_node)
        if isinstance(node, ast.Assign) and len(node.targets) == 1
        and isinstance(node.targets[0], ast.Name) and node.targets[0].id == "invocation"
    ]
    null_assignments = [
        node for node in invocation_assignments
        if isinstance(node.value, ast.Constant) and node.value.value is None
    ]
    validated_assignments = [node for node in invocation_assignments if node not in null_assignments]
    expected_validations = {
        ast.dump(ast.parse("valid_invocation(candidate_invocation) and launch_matches(observed, nonce, exec_argv)", mode="eval").body),
        ast.dump(ast.parse("valid_invocation(candidate_invocation) and launch_matches(discovered, nonce, exec_argv)", mode="eval").body),
    }
    require(len(null_assignments) == 1 and len(validated_assignments) == 2
            and all(isinstance(parents.get(node), ast.If)
                    and ast.dump(parents[node].test) in expected_validations
                    and parents[node].body[0] is node
                    for node in validated_assignments),
            "client may assign an owned InvocationID only after nonce-bound launch validation")

    literal_systemctl = []
    for function in (node for node in tree.body if isinstance(node, ast.FunctionDef)):
        for call in ast.walk(function):
            if (isinstance(call, ast.Call) and isinstance(call.func, ast.Name)
                    and call.func.id == "command" and call.args
                    and isinstance(call.args[0], ast.Tuple) and call.args[0].elts
                    and isinstance(call.args[0].elts[0], ast.Constant)
                    and call.args[0].elts[0].value == "/usr/bin/systemctl"
                    and (len(call.args[0].elts) < 2
                         or not isinstance(call.args[0].elts[1], ast.Constant)
                         or call.args[0].elts[1].value != "show")):
                literal_systemctl.append(function.name)
    require(literal_systemctl == ["owned_command"],
            "client name-based systemctl action bypasses exact InvocationID revalidation")

    retry_source = ast.get_source_segment(source, named_function(tree, "retry_owned_command")) or ""
    retry_contract = (
        "for attempt in range(ACTION_ATTEMPTS):", "cleanup_boundary(name)",
        "acted = owned_command(invocation, nonce, service_command, action, *arguments)",
        "RECOVERED_ERRORS.extend(errors)", "if attempt + 1 < ACTION_ATTEMPTS:",
        "time.sleep(ACTION_RETRY_BACKOFF)", "owned {name} command remains unavailable",
    )
    require(all(retry_source.count(fragment) == 1 for fragment in retry_contract),
            "client cleanup actions must retry the same owned command and retain initial failures")
    teardown = ast.get_source_segment(source, named_function(tree, "teardown_owned")) or ""
    teardown_contract = (
        'errors = []',
        'context="show"', 'deadline = bounded_deadline(KILL_WAIT_TIMEOUT)',
        'cleanup_boundary("wait")', 'context="wait"',
        'occupants, observation_errors = fixed_cgroup_residue("teardown")',
        'for diagnostic in observation_errors:\n            append_unique_diagnostic(errors, diagnostic)',
        'if occupants and not kill_sent:',
        'retry_owned_command(invocation, nonce, service_command,\n                                    "kill", "kill", "--kill-whom=all", "--signal=KILL")',
        'retry_owned_command(invocation, nonce, service_command, "stop", "stop")',
        'retry_owned_command(invocation, nonce, service_command, "reset", "reset-failed")',
        'wait_unloaded(invocation, nonce, service_command)',
    )
    require(all(teardown.count(fragment) == 1 for fragment in teardown_contract)
            and teardown.count("append_unique_diagnostic(") == 11
            and teardown.count('assert_fixed_cgroups_empty("teardown")') == 3
            and teardown.count('"; ".join(errors)') == 2
            and "errors.append(" not in teardown and "errors.extend(" not in teardown,
            "client teardown must retry pre-action failures and aggregate kill/stop/wait/reset/unload errors")
    require(teardown.count('owned_state("teardown", invocation, nonce, service_command') == 3,
            "client teardown must revalidate full ownership before each poll/name operation")
    wait_source = ast.get_source_segment(source, named_function(tree, "wait_unloaded")) or ""
    require(wait_source.count('owned_state("unload", invocation, nonce, service_command, context="unload")') == 1
            and 'cleanup_boundary("unload")' in wait_source
            and "timeout=UNLOAD_TIMEOUT" in wait_source
            and "deadline = bounded_deadline(timeout)" in wait_source
            and 'fail("absolute client cleanup deadline exhausted while awaiting owned unload")' in wait_source,
            "client unload polling/fault boundary ownership contract changed")

    require_exact_function(tree, "record_counter", '''def record_counter(phase, name):
    path = f"{RUN}/{REQUESTED_MODE}.{name}"
    descriptor = None
    counter = None
    try:
        descriptor = os_call(phase, "open", "evidence", os.open, path,
                             os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW, 0o600)
        try:
            counter = os_call(phase, "fdopen", "counter", os.fdopen,
                              descriptor, "r+", encoding="ascii")
        except BaseException:
            os_call(phase, "close", "counter", os.close, descriptor)
            raise
        descriptor = None
        value = os_call(phase, "read", "evidence", counter.read).strip()
        os_call(phase, "seek", "evidence", counter.seek, 0)
        os_call(phase, "truncate", "evidence", counter.truncate)
        os_call(phase, "write", "evidence", counter.write,
                str((int(value) if value else 0) + 1) + "\\n")
        os_call(phase, "flush", "evidence", counter.flush)
        os_call(phase, "fsync", "evidence", os.fsync, counter.fileno())
    except OSError as error:
        raise evidence_failure(phase, "write", "evidence", error) from None
    except ValueError:
        fail("command interception evidence was malformed")
    finally:
        if counter is not None:
            os_call(phase, "close", "evidence", counter.close)
''', "client counter fdopen ownership transfer and exact operation labels changed")
    command_path_source = ast.get_source_segment(source, named_function(tree, "command_path")) or ""
    command_path_contract = (
        'REQUESTED_MODE == "client-cleanup-fault-" + name',
        'REQUESTED_MODE == "client-work-budget-slow-cleanup"',
        'REQUESTED_MODE == "client-cleanup-persistent-" + name',
        '"client-property-fault-immediate": "immediate"',
        '"client-property-fault-recovery": "recovery"',
        '"client-property-fault-owned": "owned-state"',
        'slow_limit = {"show": 1, "kill": ACTION_ATTEMPTS, "stop": 1}.get(name, 0)',
        'record_counter(phase, name + ".intercepted")',
        'record_counter(phase, name + ".attempted")',
        'delay = (SLOW_PROPERTY_FAULT_SECONDS if name == "show"',
        'fail(f"injected slow owned {name} failure before action")',
        'if REQUESTED_MODE == "client-cleanup-fault-stop":',
        'durable_marker(phase, REQUESTED_MODE + ".blocked")',
        'required = 4 if name in ("show", "wait", "unload") else ACTION_ATTEMPTS',
        'if persistent and interception == required:',
        'durable_marker(phase, REQUESTED_MODE + ".handoff.ready")',
        'release = f"{RUN}/{REQUESTED_MODE}.handoff.release"',
        'fail("timed out awaiting persistent-fault teardown handoff")',
        'fail(f"intercepted {name} command before attempt")',
    )
    require(all(command_path_source.count(fragment) == 1 for fragment in command_path_contract)
            and command_path_source.index('fail(f"intercepted {name} command before attempt")')
            < command_path_source.index('record_counter(phase, name + ".attempted")'),
            "client fault hooks must intercept before real actions and count retries exactly")

    fault_fragments = (
        'if requested_mode in ("client-fault-missing-invocation",\n                                      "client-property-fault-recovery"):\n                    candidate_invocation = ""',
        'if requested_mode == "client-fault-missing-invocation":\n                client_pause("work", "client-fault-missing-invocation")',
        'if requested_mode == "client-fault-after-launch":\n                fail("injected client failure after launch")',
        'owned_state("ownership-read", invocation, nonce, exec_argv)\n            if requested_mode == "client-fault-after-invocation":',
        'if requested_mode == "client-fault-after-properties":\n                fail("injected client failure after property attestation")',
        'if requested_mode == "client-fault-at-terminal":\n                fail("injected client failure at terminal state")',
        'if requested_mode == "client-fault-after-journal":\n                fail("injected client failure after journal capture")',
        'if requested_mode == "client-work-budget-launch":\n                    exhaust_work_budget("launch")',
        'if requested_mode == "client-work-budget-service":\n                exhaust_work_budget("service")',
        'if requested_mode == "client-work-budget-journal":\n                exhaust_work_budget("journal")',
        'if requested_mode == "client-work-budget-slow-cleanup":\n                exhaust_work_budget("slow-cleanup")',
    )
    require(all(source.count(fragment) == 1 for fragment in fault_fragments),
            "client launch/invocation/property/terminal/journal fault boundaries changed")


def validate_containment(source: str, phase: str) -> None:
    tree = ast.parse(source, filename="verify-ubuntu-migration-role-containment")
    require_exact_function(tree, "retained_diagnostic", '''def retained_diagnostic(error, fallback):
    return str(error) if isinstance(error, EvidenceFailure) else fallback
''', "containment aggregation may retain only typed categorized diagnostics")
    cgroup_source = ast.get_source_segment(source, named_function(tree, "cgroup_pids")) or ""
    cgroup_contract = (
        "cgroup_walk(phase, root)", "before = cgroup_fstat(phase, source)",
        "after = cgroup_fstat(phase, source)", "after_root = cgroup_stat(phase, root)",
        "if (before.st_dev, before.st_ino) != (after.st_dev, after.st_ino):",
        "canonical = tuple(sorted((relative, device, inode)",
        "elif canonical != topology_anchor:",
        "if (current.st_dev, current.st_ino) != (device, inode):",
        "residue_seen = False", "parsed = [int(value) for value in values]",
        "found.extend(parsed)", "residue_seen = residue_seen or bool(parsed)",
        "if not residue_seen and previous_absent:",
        "previous = None\n                if not residue_seen and previous_absent:",
        "previous = None\n            previous_absent = False\n            continue",
        'except ValueError:\n            fail("unit control group contained malformed process evidence")',
        "snapshot = (root_identity, canonical, tuple(sorted(set(found))))",
        "if snapshot == previous and (not residue_seen or bool(snapshot[2])):",
        'raise evidence_failure(phase, "walk", "evidence", OSError(errno.EAGAIN, "unstable"))',
    )
    require(all(cgroup_source.count(fragment) == 1 for fragment in cgroup_contract)
            and cgroup_source.count("if not stat.S_ISDIR(current.st_mode):") == 1,
            "containment cgroup snapshot must bind canonical paths and identities")
    containment_cgroup_boundaries = {
        "cgroup_walk_error": '(phase, "walk", "cgroup", error)',
        "cgroup_stat": '(phase, "stat", resource_class, error)',
        "cgroup_walk": 'functools.partial(cgroup_walk_error, phase)',
        "cgroup_open": '(phase, "open", "cgroup", error)',
        "cgroup_fstat": '(phase, "stat", "evidence", error)',
        "cgroup_read": '(phase, "read", "evidence", error)',
        "cgroup_close": '(phase, "close", "evidence", error)',
    }
    require(all(fragment in (ast.get_source_segment(source, named_function(tree, name)) or "")
                for name, fragment in containment_cgroup_boundaries.items()),
            "containment cgroup boundaries lost exact closed operation labels")
    require(literal_assignment(tree, "UNIT") == "nmcp-migration-role-verifier.service",
            "containment fixed unit name changed")
    require(literal_assignment(tree, "PID_FILES") == ("wrapper.pid", "admin.pid", "descendant.pid"),
            "containment nested process evidence changed")
    require(literal_assignment(tree, "SUCCESS") == "Ubuntu migration role compatibility verification passed",
            "containment canonical success marker changed")
    require(literal_assignment(tree, "PROGRAM") == "/run/nmcp-ci/supervisor.py"
            and literal_assignment(tree, "NONCE_VARIABLE") == "NMCP_VERIFIER_NONCE"
            and literal_assignment(tree, "DESCRIPTION_PREFIX") == "NMCP migration role verifier ",
            "containment persistent launch labels changed")
    require(literal_assignment(tree, "SERVICE_PROPERTIES") == {
        "Type": "exec", "KillMode": "control-group", "SendSIGKILL": "yes",
        "TimeoutStopUSec": "15s", "RuntimeMaxUSec": "15min", "Delegate": "no",
        "RemainAfterExit": "yes", "User": "root", "Group": "root", "UMask": "0077",
        "WorkingDirectory": "/", "StandardOutput": "journal", "StandardError": "journal",
    }, "containment persistent fixed service property table changed")
    launch_property_assignments = [
        node for node in tree.body if isinstance(node, ast.Assign) and len(node.targets) == 1
        and isinstance(node.targets[0], ast.Name) and node.targets[0].id == "IDENTITY_PROPERTIES"
    ]
    expected_launch_properties = ast.parse(
        'IDENTITY_PROPERTIES = ("InvocationID", "Description", "Environment", '
        '*SERVICE_PROPERTIES)'
    ).body[0]
    require(len(launch_property_assignments) == 1
            and ast.dump(launch_property_assignments[0]) == ast.dump(expected_launch_properties)
            and literal_assignment(tree, "SYSTEMD_UNIT_OBJECT")
                == "/org/freedesktop/systemd1/unit/nmcp_2dmigration_2drole_2dverifier_2eservice",
            "containment retained full launch signature fields changed")
    require_exact_function(tree, "run", '''def run(phase, argv, **kwargs):
    kwargs.setdefault("timeout", 18 * 60)
    try:
        return subprocess.run(argv, cwd="/", env=ENV, text=True, **kwargs)
    except OSError as error:
        raise evidence_failure(phase, "run", "process", error) from None
''', "containment subprocesses must have a bounded default wait")
    require_exact_function(tree, "parse_unit_properties", '''def parse_unit_properties(result, requested):
    if result.returncode:
        fail(f"containment systemctl show failed with status {result.returncode}")
    if not result.stdout:
        fail("containment systemctl show returned empty output")
    values = {}
    for line in result.stdout.splitlines():
        key, separator, value = line.partition("=")
        if not separator or not key or key in values:
            fail("containment systemctl show returned malformed output")
        values[key] = value
    if values.get("LoadState") == "not-found":
        return values
    missing = [name for name in requested if name not in values]
    if missing:
        fail(f"containment systemctl show omitted required properties: {', '.join(missing)}")
    return values
''', "containment property parser must completely parse explicit absence and full loaded identity")
    require_exact_function(tree, "show", '''def show(phase, *properties):
    requested = tuple(dict.fromkeys(("LoadState", *properties)))
    errors = []
    for attempt in range(4):
        try:
            result = run(phase, ("/usr/bin/systemctl", "show", UNIT,
                          *(f"--property={item}" for item in requested)), check=False,
                         stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=1)
            values = parse_unit_properties(result, requested)
            return values
        except (OSError, subprocess.SubprocessError, RuntimeError) as error:
            errors.append(error)
            if attempt < 3:
                time.sleep(0.05 * (2 ** attempt))
    fail("containment unit properties remain unknown: "
         + "; ".join(bounded_sanitized_repr(error) for error in errors))
''', "containment property reads must fail closed with bounded retry")
    closed_phases = set(literal_assignment(tree, "DIAGNOSTIC_PHASES"))
    phase_argument_indexes = {
        "run": 0, "popen": 0, "process_wait": 0, "process_communicate": 0,
        "pid_exists": 1, "read_pid": 1, "process_has_inode": 2,
        "wait_path": 0, "release": 0, "reset_signal_paths": 0, "reset_paths": 0,
        "counter": 0, "wait_counter": 0, "assert_interception": 2,
    }
    forwarding_regions = {
        "show", "assert_client_failure", "fast_recovery", "cleanup_fixture_invocation",
        "cleanup_signed_launch",
        "show_until", "read_structured_command_until", "cleanup_signed_launch_until",
        "wait_counter", "assert_interception",
    }
    main_phase_inventory = {}
    for function in (node for node in tree.body if isinstance(node, ast.FunctionDef)):
        for call in ast.walk(function):
            if (not isinstance(call, ast.Call) or not isinstance(call.func, ast.Name)
                    or call.func.id not in phase_argument_indexes):
                continue
            index = phase_argument_indexes[call.func.id]
            require(len(call.args) > index, "containment process boundary lacks an explicit phase")
            argument = call.args[index]
            if function.name in forwarding_regions:
                require(isinstance(argument, ast.Name) and argument.id == "phase",
                        "containment forwarding process phase changed")
            else:
                require(isinstance(argument, ast.Constant)
                        and type(argument.value) is str and argument.value in closed_phases,
                        "containment process boundary phase must be a closed literal")
            if function.name == "main":
                key = (call.func.id, argument.value)
                main_phase_inventory[key] = main_phase_inventory.get(key, 0) + 1
    require(main_phase_inventory == {
        ("pid_exists", "preflight"): 1, ("pid_exists", "service-death"): 1,
        ("popen", "client-fault"): 1, ("popen", "name-reuse"): 1,
        ("popen", "persistent-cleanup"): 1, ("popen", "preflight"): 1,
        ("popen", "signal-cleanup"): 1, ("popen", "slow-cleanup"): 1,
        ("popen", "terminal-race"): 2, ("popen", "transient-cleanup"): 1,
        ("popen", "work-budget"): 1,
        ("process_communicate", "client-fault"): 1,
        ("process_communicate", "name-reuse"): 1,
        ("process_communicate", "persistent-cleanup"): 1,
        ("process_communicate", "signal-cleanup"): 1,
        ("process_communicate", "slow-cleanup"): 1,
        ("process_communicate", "terminal-race"): 2,
        ("process_communicate", "transient-cleanup"): 1,
        ("process_communicate", "work-budget"): 1,
        ("process_has_inode", "preflight"): 1,
        ("process_wait", "client-death"): 1, ("read_pid", "preflight"): 2,
        ("run", "client-death"): 1, ("run", "client-fault"): 1,
        ("run", "intent-window"): 2, ("run", "name-reuse"): 5,
        ("run", "retained-cleanup"): 2, ("run", "service-death"): 1,
        ("run", "stale-attestation"): 1, ("run", "stale-setup"): 1,
        ("run", "transient-cleanup"): 1,
        ("assert_interception", "persistent-cleanup"): 1,
        ("assert_interception", "transient-cleanup"): 2,
        ("counter", "persistent-cleanup"): 2, ("counter", "slow-cleanup"): 2,
        ("counter", "transient-cleanup"): 1,
        ("release", "client-fault"): 1, ("release", "name-reuse"): 1,
        ("release", "persistent-cleanup"): 1, ("release", "slow-cleanup"): 1,
        ("release", "stale-attestation"): 1, ("release", "stale-cleanup"): 1,
        ("release", "terminal-race"): 3, ("release", "transient-cleanup"): 1,
        ("release", "work-budget"): 1,
        ("reset_paths", "client-fault"): 1, ("reset_paths", "name-reuse"): 1,
        ("reset_paths", "persistent-cleanup"): 2,
        ("reset_paths", "signal-cleanup"): 2, ("reset_paths", "slow-cleanup"): 2,
        ("reset_paths", "stale-cleanup"): 1, ("reset_paths", "stale-setup"): 1,
        ("reset_paths", "terminal-race"): 2,
        ("reset_paths", "transient-cleanup"): 4, ("reset_paths", "work-budget"): 2,
        ("reset_signal_paths", "client-fault"): 1,
        ("reset_signal_paths", "name-reuse"): 1,
        ("reset_signal_paths", "terminal-race"): 1,
        ("wait_counter", "persistent-cleanup"): 1,
        ("wait_path", "client-fault"): 1, ("wait_path", "name-reuse"): 1,
        ("wait_path", "persistent-cleanup"): 1, ("wait_path", "preflight"): 1,
        ("wait_path", "signal-cleanup"): 1, ("wait_path", "slow-cleanup"): 2,
        ("wait_path", "stale-attestation"): 2, ("wait_path", "terminal-race"): 6,
        ("wait_path", "transient-cleanup"): 1, ("wait_path", "work-budget"): 2,
    }, "containment process lifecycle phase inventory changed")
    require("if not values" not in source and "return {\"LoadState\": \"not-found\"" not in source,
            "containment must not infer absence from an empty or failed property query")
    require_exact_function(tree, "assert_property_parser_contract", '''def assert_property_parser_contract(client):
    try:
        client_namespace = runpy.run_path(client, run_name="nmcp_client_parser_fixture")
    except OSError as error:
        raise evidence_failure("runpy", "read", "client", error) from None
    client_parser = client_namespace["parse_unit_properties"]
    successful_terminal_state = client_namespace["successful_terminal_state"]
    requested = ("LoadState", "ExecStart")
    minimal_absence = subprocess.CompletedProcess(
        ("systemctl", "show"), 0, "LoadState=not-found\\n", ""
    )
    loaded_full = subprocess.CompletedProcess(
        ("systemctl", "show"), 0,
        "LoadState=loaded\\nExecStart={ path=/usr/bin/true ; argv[]=/usr/bin/true ; }\\n", ""
    )
    rejected = (
        subprocess.CompletedProcess(("systemctl", "show"), 1, "", "not found"),
        subprocess.CompletedProcess(("systemctl", "show"), 0, "", ""),
        subprocess.CompletedProcess(("systemctl", "show"), 0, "LoadState=not-found\\nbroken\\n", ""),
        subprocess.CompletedProcess(("systemctl", "show"), 0, "LoadState=loaded\\n", ""),
    )
    for parser_name, parser in (("client", client_parser), ("containment", parse_unit_properties)):
        absent = parser(minimal_absence, requested)
        if absent != {"LoadState": "not-found"}:
            fail(f"{parser_name} parser did not accept exact minimal explicit absence")
        loaded = parser(loaded_full, requested)
        if loaded.get("LoadState") != "loaded" or "ExecStart" not in loaded:
            fail(f"{parser_name} parser lost complete loaded identity")
        for result in rejected:
            try:
                parser(result, requested)
            except RuntimeError:
                pass
            else:
                fail(f"{parser_name} parser accepted unknown or incomplete unit state")
        transition = iter((loaded_full, minimal_absence))
        if parser(next(transition), requested).get("LoadState") != "loaded":
            fail(f"{parser_name} parser lost transitional loaded state")
        if parser(next(transition), requested).get("LoadState") != "not-found":
            fail(f"{parser_name} parser did not complete on minimal transitional absence")
    successful_state = {
        "Result": "success", "ExecMainStatus": "0",
        "ActiveState": "active", "SubState": "exited",
    }
    for code in ("1", "exited"):
        if not successful_terminal_state({**successful_state, "ExecMainCode": code}):
            fail(f"terminal success rejected strict CLD_EXITED spelling: {code!r}")
    if not successful_terminal_state({**successful_state, "ExecMainCode": "1", "ExecMainStatus": 0}):
        fail("terminal success rejected exact integer zero status")
    for code in ("", " 1", "1 ", "01", "Exited", "EXITED", " exited", "exited ",
                 "0", "2", "3", "killed", "dumped", 1, True, None):
        if successful_terminal_state({**successful_state, "ExecMainCode": code}):
            fail(f"terminal success accepted non-CLD_EXITED code: {code!r}")
    rejected_terminal_states = (
        {**successful_state, "ExecMainCode": "1", "ExecMainStatus": "1"},
        {**successful_state, "ExecMainCode": "1", "ExecMainStatus": False},
        {**successful_state, "ExecMainCode": "1", "Result": "exit-code"},
        {**successful_state, "ExecMainCode": "1", "ActiveState": "failed"},
        {**successful_state, "ExecMainCode": "1", "SubState": "dead"},
        {key: value for key, value in {**successful_state, "ExecMainCode": "1"}.items()
         if key != "Result"},
        {key: value for key, value in {**successful_state, "ExecMainCode": "1"}.items()
         if key != "ExecMainCode"},
        {key: value for key, value in {**successful_state, "ExecMainCode": "1"}.items()
         if key != "ExecMainStatus"},
        {key: value for key, value in {**successful_state, "ExecMainCode": "1"}.items()
         if key != "ActiveState"},
        {key: value for key, value in {**successful_state, "ExecMainCode": "1"}.items()
         if key != "SubState"},
    )
    if any(successful_terminal_state(state) for state in rejected_terminal_states):
        fail("terminal success accepted non-success result, status, or terminal state")
''', "containment parser fixture must causally exercise both live parsers")
    runpy_imports = [
        node for node in tree.body if isinstance(node, ast.Import)
        and [(alias.name, alias.asname) for alias in node.names] == [("runpy", None)]
    ]
    require(len(runpy_imports) == 1, "containment parser fixture must import runpy exactly once")
    require_exact_function(tree, "persistent_failure_classification", '''def persistent_failure_classification(stdout, stderr):
    return {
        "success_in_stdout": SUCCESS in stdout,
        "property_unknown": PERSISTENT_PROPERTY_ERROR in stderr,
        "action_unavailable": PERSISTENT_ACTION_ERROR in stderr,
    }
''', "containment persistent failure classification changed")
    require_exact_function(tree, "persistent_result_violation", '''def persistent_result_violation(returncode, classification, lock_handoff_error, cleanup_error,
                                lock_reuse_error, post_cleanup, post_cleanup_cgroup):
    return bool(
        returncode == 0 or classification["success_in_stdout"]
        or not (classification["property_unknown"] or classification["action_unavailable"])
        or lock_handoff_error or cleanup_error or lock_reuse_error
        or post_cleanup.get("LoadState") != "not-found" or post_cleanup_cgroup
    )
''', "containment persistent cleanup-first result predicate changed")
    require_exact_function(tree, "bounded_sanitized_repr", '''def bounded_sanitized_repr(value, active_nonce=None):
    if isinstance(value, subprocess.TimeoutExpired):
        text = "subprocess timed out"
    elif isinstance(value, subprocess.CalledProcessError):
        text = f"subprocess failed with status {value.returncode}"
    elif isinstance(value, OSError):
        number = value.errno if type(value.errno) is int else errno.EIO
        text = f"phase=uncategorized operation=unknown resource=unknown errno={number}"
