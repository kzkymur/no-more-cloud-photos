            key = (node.value.id, node.attr)
            actual_module_attributes[key] = actual_module_attributes.get(key, 0) + 1
        if isinstance(node, ast.Attribute):
            chain = rooted_attribute_chain(node)
            if chain is not None and chain.split(".", 1)[0] in reviewed_imports:
                actual_recursive_module_attributes[chain] = (
                    actual_recursive_module_attributes.get(chain, 0) + 1)
