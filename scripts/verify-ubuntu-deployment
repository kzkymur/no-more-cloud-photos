EXPECTED_STEP_NAMES = [
    None, "Install Go", "Install parser and HTTP test dependencies",
    "Run trusted migration compatibility transaction", "Check shell scripts",
    "Verify deployment assets", "Verify privileged repair mount boundaries",
    "Verify configuration and firewall counterexamples",
    "Verify privileged input capture counterexamples", "Verify systemd EnvironmentFile effective values",
    "Verify production Nginx HTTP contract", "Verify exact installed Nginx service and TLS renewal",
    "Verify systemd read-only storage namespace", "Verify concrete PostgreSQL stopped-instance recovery",
    "Verify whole-service activation failure counterexamples", "Verify migration serialization races",
    "Verify release activation and rollback failure transactions", "Verify immutable release staging",
