        "persistent imported fcntl function replaced",
        "persistent imported os function replaced",
        "persistent getattr builtins exec replacement",
        "persistent imported module alias write",
        "persistent exec callable alias",
        "persistent getattr callable alias namespace write",
        "persistent extra runpy execution",
        "persistent nested builtins import execution",
        "persistent top-level generic runner execution",
        "persistent executable function default",
        "persistent extra module constant",
        "persistent module mapping mutation",
        "persistent recursive os callee cleanup suppression",
        "persistent walrus os callee cleanup suppression",
        "persistent recursive fcntl callee",
        "persistent recursive json callee",
        "persistent recursive runpy callee",
        "persistent recursive secrets callee",
        "persistent recursive shlex callee",
        "persistent recursive signal attribute",
        "persistent recursive subprocess callee",
        "persistent recursive sys callee",
        "persistent recursive time callee",
        "persistent builtin callee shadow",
        "persistent builtin callee lambda shadow",
        "persistent builtin callee pattern shadow",
        "persistent builtin callee exception shadow",
        "persistent relocated cleanup intent assertion",
        "persistent padded cleanup intent assertion",
        "persistent split cleanup intent assertion",
        "persistent alternate cleanup intent branch",
        "persistent early return before retained cleanup",
        "persistent inverted sentinel nonce condition",
        "stale ready wait omitted",
        "stale release omitted before classification",
        "stale failure classified before release",
        "stale invocation pin omitted",
        "stale result check omitted",
        "stale distinctive status check omitted",
        "stale failure timeout omitted",
        "stale cleanup finally disabled",
        "stale mismatched identity cleanup allowed",
        "stale diagnostic launch stderr omitted",
        "stale signal paths not reset before launch",
        "stale helper atomic publication omitted",
        "stale ready publication made non-atomic",
        "stale immediate exit race restored",
        "stale artifacts removed after identity failure",
        "stale artifacts removed after cleanup failure",
        "stale artifacts removed after post-state failure",
        "stale release deleted without confirmed absence",
        "stale residue artifacts not preserved",
        "stale release acknowledgment wait omitted",
        "stale client stdout capture omitted",
        "stale client diagnostic return omitted",
        "stale client diagnostic streams omitted",
        "stale after-client state substituted",
        "stale ownership mismatch made transient",
    }
    for label, mutation in containment_mutations:
        if label in runtime_valid_containment_mutations:
            ast.parse(mutation, filename=f"<containment mutation: {label}>")
            compile(mutation, f"<containment mutation: {label}>", "exec")
        expect_rejected(lambda value: validate_containment(value, phase), mutation, label,
                        "containment")
    stage_mutations = [
        ("manifest omission allowed", replace_once(stage, "        if actual != expected:", "        if actual < expected:"), "manifest/inventory"),
        ("manifest extra allowed", replace_once(stage, "        if actual != expected:", "        if expected <= actual:"), "manifest/inventory"),
        ("allowlist inventory omission", replace_once(stage, '    "verify-stage": ("closed snapshot verifier", 0o500),\n', ""), "explicit asset allowlist"),
        ("manifest purpose omission", replace_once(stage, '"name", "purpose", "provenance_commit"', '"name", "provenance_commit"'), "manifest/inventory"),
        ("manifest mode omission", replace_once(stage, '"type", "uid", "gid", "mode", "size"', '"type", "uid", "gid", "size"'), "manifest/inventory"),
        ("manifest toolchain omission", replace_once(stage, '"provenance_tree", "toolchain", "type"', '"provenance_tree", "type"'), "manifest/inventory"),
    ]
    for label, mutation, expected in stage_mutations:
        expect_rejected(validate_stage_verifier, mutation, label, expected)
    phase_mutations = [
        ("phase arm omitted", replace_once(phase, "  fresh-current)", "  fresh-current-disabled)")),
        ("phase arm extra", replace_once(phase, "  fresh-current)", "  extra)\n    :\n    ;;\n  fresh-current)")),
        ("phase arm reordered", replace_once(phase, "  fresh-current)", "  current-rerun)")),
        ("phase repository read", replace_once(phase, "case $phase in", "/usr/bin/git status\ncase $phase in")),
        ("phase wrapper fd path", replace_once(phase, 'wrapper=${NMCP_WRAPPER:?missing staged wrapper descriptor}', 'wrapper=/usr/local/libexec/nmcp/run-ubuntu-migration-compatibility')),
        ("containment nested setsid omitted", phase.replace('/usr/bin/setsid "$wrapper" "$work/kill/nmcp-admin" migrate up --json &', '"$wrapper" "$work/kill/nmcp-admin" migrate up --json &', 1)),
    ]
    for label, mutation in phase_mutations:
        if "setsid" in label:
            expect_rejected(lambda value: validate_containment(containment, value), mutation,
                            label, "nested setsid containment")
            continue
        if "repository" in label:
            expected = "must not read repository"
        elif "fd path" in label:
            expected = "descriptor environment"
        else:
            expected = "phase table"
        expect_rejected(validate_compatibility_phase, mutation, label, expected)
    helper_mutations = [
        ("helper SQL path", replace_once(helper, '<&"$sql_fd"', '--file=/tmp/verify.sql'), "SQL descriptor"),
        ("helper repository argument", replace_once(helper, "sql_fd=$1", "repo_root=$1"), "exactly one SQL descriptor"),
    ]
    for label, mutation, expected in helper_mutations:
        expect_rejected(validate_runtime_helper, mutation, label, expected)
    wrapper_mutations = [
        ("migration role-mode fd path", replace_once(migration_wrapper,
            'role_mode=${NMCP_ROLE_MODE:-/usr/local/libexec/nmcp/set-ubuntu-migration-role-mode}',
            'role_mode=/usr/local/libexec/nmcp/set-ubuntu-migration-role-mode')),
        ("runtime roles fd path", replace_once(role_mode,
            'bootstrap=${NMCP_RUNTIME_ROLES:-$bootstrap_dir/runtime-roles.sql}',
            'bootstrap=$bootstrap_dir/runtime-roles.sql')),
        ("role graph fd path", replace_once(role_mode,
            'verifier=${NMCP_VERIFY_ROLE_GRAPH:-$bootstrap_dir/verify-runtime-role-graph.sql}',
            'verifier=$bootstrap_dir/verify-runtime-role-graph.sql')),
        ("migration numeric fd rejection", replace_once(migration_wrapper,
            'if [[ $admin =~ ^/proc/self/fd/[0-9]+$ ]]; then',
            'if [[ $admin == /proc/self/fd/3 ]]; then')),
        ("migration signal global omission", replace_once(migration_wrapper,
            'signal_status=0', 'signal_status=')),
        ("migration inner SIGKILL wrong target", replace_once(migration_wrapper,
            '/usr/bin/kill -KILL -- "-$child_pid" 2>/dev/null || true',
            '/usr/bin/kill -KILL -- "$child_pid" 2>/dev/null || true')),
        ("role-mode numeric fd rejection", replace_once(role_mode,
            'if [[ $path =~ ^/proc/self/fd/[0-9]+$ ]]; then',
            'if [[ $path == /proc/self/fd/3 ]]; then')),
    ]
    for label, mutation in wrapper_mutations:
        if label.startswith("migration"):
            expect_rejected(lambda value: validate_fd_wrappers(value, role_mode), mutation,
                            label, "migration wrapper")
        else:
            expect_rejected(lambda value: validate_fd_wrappers(migration_wrapper, value), mutation,
                            label, "role-mode wrapper")


def verify_validation_env_mutations(source: str) -> None:
    mutations = (
        ("missing postgres init preflight", replace_once(
            source, '    "$root/infra/validation/postgres-init.sql" \\\n', "")),
        ("SQL preflight permits owner-read only", replace_once(source, '      4|5|6|7) ;;', '      0|1|2|3|4|5|6|7) ;;')),
        ("SQL preflight inaccurate remediation", replace_once(source, '(chmod 0644)', '(chmod 0600)')),
        ("SQL preflight omitted for up", replace_once(
            source, '  up)\n    require_container_readable_sql_fixtures\n', '  up)\n')),
        ("SQL preflight added to down", replace_once(
            source, '  down)\n    compose down --remove-orphans\n',
            '  down)\n    require_container_readable_sql_fixtures\n    compose down --remove-orphans\n')),
    )
    for label, mutation in mutations:
        expect_rejected(validate_validation_env, mutation, label, "validation-env")


def main() -> int:
    scripts = [
        ROOT / "scripts" / "install-ubuntu-host",
        ROOT / "scripts" / "install-ubuntu-release",
        ROOT / "scripts" / "verify-ubuntu-nginx-http",
        ROOT / "scripts" / "verify-ubuntu-systemd-mounts",
        ROOT / "scripts" / "verify-ubuntu-installed-nginx",
        ROOT / "scripts" / "verify-ubuntu-postgresql-dependency",
        ROOT / "scripts" / "verify-ubuntu-service-gate",
        ROOT / "scripts" / "verify-ubuntu-config-boundaries",
        ROOT / "scripts" / "verify-ubuntu-firewall-fixtures",
        ROOT / "scripts" / "verify-ubuntu-trusted-inputs",
        ROOT / "scripts" / "renew-ubuntu-tls",
        ROOT / "scripts" / "check-ubuntu-tls-expiry",
        ROOT / "scripts" / "run-ubuntu-migration",
        ROOT / "scripts" / "run-ubuntu-migration-compatibility",
        ROOT / "scripts" / "set-ubuntu-migration-role-mode",
        ROOT / "scripts" / "verify-ubuntu-migration-role-compatibility",
        ROOT / "scripts" / "verify-ubuntu-repair-mount-boundaries",
        ROOT / "scripts" / "verify-ubuntu-migration-lock",
        ROOT / "scripts" / "verify-ubuntu-release-failures",
        ROOT / "scripts" / "verify-ubuntu-tls-certificate",
        ROOT / "scripts" / "verify-ubuntu-systemd-environment",
    ]
    for script in scripts:
        require(os.access(script, os.X_OK), f"{script.name} is not executable")
        run(["bash", "-n", script])
    render = ROOT / "scripts" / "render-ubuntu-nginx"
    python_scripts = [
        render, ROOT / "scripts" / "assert-ubuntu-files-endpoint",
        ROOT / "scripts" / "validate-ubuntu-config",
        ROOT / "scripts" / "render-ubuntu-postgresql-dependency",
        ROOT / "scripts" / "verify-ubuntu-firewall",
        ROOT / "scripts" / "capture-trusted-inputs",
        ROOT / "scripts" / "check-ubuntu-services",
        ROOT / "scripts" / "acquire-ubuntu-deployment-locks",
        ROOT / "scripts" / "handoff-ubuntu-migration-lock",
        ROOT / "scripts" / "verify-ubuntu-migration-role-stage",
        ROOT / "scripts" / "verify-ubuntu-migration-role-supervisor",
        ROOT / "scripts" / "verify-ubuntu-migration-role-client",
        ROOT / "scripts" / "verify-ubuntu-migration-role-containment",
        ROOT / "scripts" / "verify-ubuntu-diagnostic-fixtures",
    ]
    for script in python_scripts:
        require(os.access(script, os.X_OK), f"{script.name} is not executable")
        ast.parse(text(script), filename=str(script))

    ubuntu_workflow = text(ROOT / ".github" / "workflows" / "ubuntu-deployment.yml")
    validate_ubuntu_workflow(ubuntu_workflow)
    verify_ubuntu_workflow_mutations(ubuntu_workflow)

    units = UBUNTU / "systemd"
    slice_text = text(units / "nmcp.slice")
    require("CPUQuota=200%" in slice_text, "aggregate CPU ceiling changed")
    require("MemoryMax=4G" in slice_text, "aggregate memory ceiling changed")
    for name in ("nmcp-migrate.service", "nmcp-api.service", "nmcp-worker.service", "nmcp-files.service"):
        unit = text(units / name)
        require("Slice=nmcp.slice" in unit, f"{name} escapes aggregate slice")
        if name != "nmcp-migrate.service":
            require("User=nmcp" in unit and "Group=nmcp" in unit, f"{name} identity changed")
        require("NoNewPrivileges=yes" in unit and "ProtectSystem=strict" in unit, f"{name} hardening missing")
        require("CPUQuota=" not in unit and "MemoryMax=" not in unit, f"{name} duplicates aggregate budget")
    require("NMCP_API_ADDR=127.0.0.1:8080" in text(UBUNTU / "env" / "api.env.example"), "API example is not loopback-only")
    require((units / "postgresql@.service.d" / "10-nmcp-slice.conf").is_file(), "PostgreSQL instance slice drop-in missing")
    timers = {path.name for path in UBUNTU.rglob("*.timer")}
    require(timers == {"nmcp-tls-expiry.timer"}, "only independent TLS expiry monitoring may have a timer")
    migrate_unit = text(units / "nmcp-migrate.service")
    require("postgresql.service" not in migrate_unit, "migration still depends on PostgreSQL meta-unit")
    require(
        "ExecStart=/usr/local/libexec/nmcp/run-ubuntu-migration" in migrate_unit,
        "systemd migration bypasses the deployment serializer",
    )
    require("RemainAfterExit=yes" in migrate_unit, "successful migration is not retained for dependent starts")
    for dependent in ("nmcp-api.service", "nmcp-worker.service"):
        dependent_text = text(units / dependent)
        require(
            "Requires=nmcp-migrate.service" in dependent_text and "After=nmcp-migrate.service" in dependent_text,
            f"{dependent} lost its production migration dependency edge",
        )
    tmpfiles_text = text(UBUNTU / "tmpfiles.d" / "nmcp.conf")
    require(
        "d /run/nmcp-deploy 0700 root root" in tmpfiles_text
        and "f /run/nmcp-deploy/deploy.lock 0600 root root" in tmpfiles_text,
        "shared migration lock ownership/mode is missing",
    )
    require(
        "f /run/nmcp-deploy/migration-execution.lock 0600 root root" in tmpfiles_text,
        "owner-death migration execution lease is missing",
    )
    require(
        tmpfiles_text.count("d /var/lib/nmcp/media/.quarantine 0700 nmcp nmcp -") == 1
        and "/var/lib/nmcp/media/quarantine" not in tmpfiles_text,
        "canonical private .quarantine tmpfiles entry is missing or duplicated",
    )
    compose_text = text(ROOT / "infra" / "validation" / "compose.yaml")
    require(
        "install -d -o 10001 -g 10001 -m 0700" in compose_text
        and "/var/lib/nmcp/media/.quarantine" in compose_text
        and "legacy dotless quarantine requires reviewed migration" in compose_text,
        "validation storage does not reject legacy state and create private .quarantine",
    )
    environment_examples = "\n".join(text(path) for path in sorted((UBUNTU / "env").glob("*.example")))
    require("NMCP_QUARANTINE" not in environment_examples, "quarantine path became environment-configurable")
    cli_contract = text(ROOT / "docs" / "contracts" / "core-api.md")
    storage_contract = text(ROOT / "docs" / "contracts" / "state-and-storage.md")
    require("--quarantine-dir" not in cli_contract, "CLI contract still permits a quarantine path override")
    require(
        "${NMCP_STORAGE_ROOT}/.quarantine" in storage_contract,
        "storage contract lost the canonical quarantine path",
    )
    host_install = text(ROOT / "scripts" / "install-ubuntu-host")
    require(
        "legacy /var/lib/nmcp/media/quarantine exists" in host_install
        and "existing canonical quarantine ownership, mode, or device is unsafe" in host_install
        and "stat -c '%d' /var/lib/nmcp/media/.quarantine" in host_install,
        "host installation lacks quarantine upgrade/owner/mode/device preflight",
    )
    require(
        "handoff-ubuntu-migration-lock" in host_install,
        "migration execution-lease handoff helper is not installed",
    )
    require("User=root" in migrate_unit, "migration serializer must own the root-only lock")
    migration_runner = text(ROOT / "scripts" / "run-ubuntu-migration")
    migration_compatibility = text(ROOT / "scripts" / "run-ubuntu-migration-compatibility")
    migration_role_compatibility = text(
        ROOT / "scripts" / "verify-ubuntu-migration-role-compatibility"
    )
    runtime_verifier_helper_path = ROOT / "scripts" / "verify-installed-runtime-roles"
    runtime_verifier_helper = text(runtime_verifier_helper_path)
    require(
        stat.S_IMODE(runtime_verifier_helper_path.stat().st_mode) == 0o755,
        "installed runtime verifier helper must be executable mode 0755",
    )
    stage_verifier = text(ROOT / "scripts" / "verify-ubuntu-migration-role-stage")
    supervisor = text(ROOT / "scripts" / "verify-ubuntu-migration-role-supervisor")
    client = text(ROOT / "scripts" / "verify-ubuntu-migration-role-client")
    containment = text(ROOT / "scripts" / "verify-ubuntu-migration-role-containment")
    diagnostic_fixture_path = ROOT / "scripts" / "verify-ubuntu-diagnostic-fixtures"
    diagnostic_fixture = text(diagnostic_fixture_path)
    require(stat.S_IMODE(diagnostic_fixture_path.stat().st_mode) == 0o755,
            "diagnostic fixture executable mode changed")
    validate_diagnostic_fixture(diagnostic_fixture)
    dead_fdopen_fixture = replace_once(
        diagnostic_fixture,
        "    actual_boundary_cases(client, containment)",
        "    if False:\n        actual_boundary_cases(client, containment)")
    expect_rejected(validate_diagnostic_fixture, dead_fdopen_fixture,
                    "fdopen causal fixture call is dead", "source snapshot changed")
    dead_lock_gate_fixture = replace_once(
        diagnostic_fixture,
        "    signed_cleanup_lock_cases(containment)",
        "    if False:\n        signed_cleanup_lock_cases(containment)")
    expect_rejected(validate_diagnostic_fixture, dead_lock_gate_fixture,
                    "signed cleanup lock fixture call is dead", "source snapshot changed")
    dead_cgroup_lifecycle_fixture = replace_once(
        diagnostic_fixture,
        "    client_cgroup_lifecycle_cases(client)",
        "    if False:\n        client_cgroup_lifecycle_cases(client)")
    expect_rejected(validate_diagnostic_fixture, dead_cgroup_lifecycle_fixture,
                    "client cgroup lifecycle fixture call is dead", "source snapshot changed")
    dead_final_residue_fixture = replace_once(
        diagnostic_fixture,
        "    client_final_residue_diagnostic_cases(client)",
        "    if False:\n        client_final_residue_diagnostic_cases(client)")
    expect_rejected(validate_diagnostic_fixture, dead_final_residue_fixture,
                    "client final residue fixture call is dead", "source snapshot changed")
    dead_cgroup_observation_fixture = replace_once(
        diagnostic_fixture,
        "    client_cgroup_observation_cases(client)",
        "    if False:\n        client_cgroup_observation_cases(client)")
    expect_rejected(validate_diagnostic_fixture, dead_cgroup_observation_fixture,
                    "client cgroup observation fixture call is dead", "source snapshot changed")
    dead_cgroup_dedup_fixture = replace_once(
        diagnostic_fixture,
        "    client_cgroup_diagnostic_dedup_cases(client)",
        "    if False:\n        client_cgroup_diagnostic_dedup_cases(client)")
    expect_rejected(validate_diagnostic_fixture, dead_cgroup_dedup_fixture,
                    "client cgroup diagnostic dedup fixture call is dead", "source snapshot changed")
    dead_phase_routing_fixture = replace_once(
        diagnostic_fixture,
        "    client_phase_routing_cases(client)",
        "    if False:\n        client_phase_routing_cases(client)")
    expect_rejected(validate_diagnostic_fixture, dead_phase_routing_fixture,
                    "client phase routing fixture call is dead", "source snapshot changed")
    role_mode = text(ROOT / "scripts" / "set-ubuntu-migration-role-mode")
    validate_runtime_helper(runtime_verifier_helper)
    validate_stage_verifier(stage_verifier)
    validate_compatibility_phase(migration_role_compatibility)
    validate_supervisor(supervisor)
    validate_client(client)
    validate_containment(containment, migration_role_compatibility)
    verify_nonce_safe_diagnostics(
        ROOT / "scripts" / "verify-ubuntu-migration-role-client",
        ROOT / "scripts" / "verify-ubuntu-migration-role-containment",
    )
    run((str(diagnostic_fixture_path),))
    validate_fd_wrappers(migration_compatibility, role_mode)
    verify_supervisor_mutations(
        supervisor,
        stage_verifier,
        migration_role_compatibility,
        client,
        containment,
        runtime_verifier_helper,
        migration_compatibility,
        role_mode,
    )
    release_installer = text(ROOT / "scripts" / "install-ubuntu-release")
    require(
        "run-ubuntu-migration-compatibility" in migration_runner
        and "setpriv --reuid=nmcp --regid=nmcp" in migration_compatibility
        and 'trap \'finalize "$?"\' EXIT' in migration_compatibility,
        "migration compatibility wrapper does not drop to nmcp and harden on exit",
    )
    require(
        "postgresql-role-bootstrap.sha256" in role_mode
        and "/usr/bin/env -i /usr/sbin/runuser -u postgres" in role_mode
        and "--host=/var/run/postgresql" in role_mode
        and "--port=5432" in role_mode
        and "--username=postgres" in role_mode
        and "verify-runtime-role-graph.sql" in role_mode
        and "systemctl stop nmcp-migrate.service" in release_installer,
        "migration role bootstrap is not pinned, peer-authenticated, verified, and readiness-gated",
    )
    role_bootstrap = text(UBUNTU / "postgresql-roles.sql")
    shared_roles = text(ROOT / "infra" / "postgresql" / "runtime-roles.sql")
    require(
        "BEGIN;" in role_bootstrap and "COMMIT;" in role_bootstrap
        and "nmcp_api_role nmcp_api" in role_bootstrap
        and "nmcp_worker_role nmcp_worker" in role_bootstrap,
        "Ubuntu role bootstrap is not one complete managed-graph transaction",
    )
    require(
        "nmcp_allowed_membership" in shared_roles
        and "actual.roleid IN" in shared_roles
        and "actual.member IN" in shared_roles,
        "shared role bootstrap does not close both sides of managed edges",
    )
    validation_script = text(ROOT / "scripts" / "validation-env")
    validate_validation_env(validation_script)
    verify_validation_env_mutations(validation_script)
    require(
        'container["HostConfig"].get("Mounts")' in validation_script
        and 'container["HostConfig"].get("Tmpfs")' in validation_script
        and 'mount.get("Type") == "volume"' in validation_script
        and 'normalized_tmpfs(options) == expected_tmpfs[destination]' in validation_script
        and 'actual_set == expected_actual_volumes' in validation_script
        and '/proc/self/mountinfo' in validation_script,
        "validation does not inspect every configured File Server mount type",
    )

    files_unit = text(units / "nmcp-files.service")
    for required in (
        "InaccessiblePaths=/var/lib/nmcp",
        "BindReadOnlyPaths=/var/lib/nmcp/media/originals:/srv/nmcp/originals",
        "BindReadOnlyPaths=/var/lib/nmcp/media/renditions:/srv/nmcp/renditions",
        "LoadCredential=tls-key.pem:/etc/nmcp/tls-current/key.pem",
        "ExecStartPre=/usr/sbin/nginx -t -c /etc/nmcp-nginx/nginx.conf",
        "CapabilityBoundingSet=CAP_NET_BIND_SERVICE",
    ):
        require(required in files_unit, f"Nginx boundary missing: {required}")
    require("ReadWritePaths=" not in files_unit, "Nginx received a writable host path")
    require(".quarantine" not in files_unit, "Nginx received the quarantine path")

    nginx_template = text(UBUNTU / "nginx.conf.in")
    require(nginx_template.count("alias ") == 2, "Nginx must expose exactly two aliases")
    require("alias /srv/nmcp/originals/" in nginx_template, "originals alias missing")
    require("alias /srv/nmcp/renditions/" in nginx_template, "renditions alias missing")
    require(".quarantine" not in nginx_template, "Nginx template exposes quarantine")
    require("proxy_pass http://127.0.0.1:8080" in nginx_template, "API upstream is not loopback")
    require("autoindex off" in nginx_template and "Accept-Ranges" in nginx_template, "file response boundary missing")
    require("private, max-age=31536000, immutable" in nginx_template, "private cache contract missing")
    require("@@NMCP_API_TLS_LISTEN@@" in nginx_template and "@@NMCP_FILES_TLS_LISTEN@@" in nginx_template, "listen token missing")

    with tempfile.TemporaryDirectory(prefix="nmcp-ubuntu-verify-") as raw:
        temporary = pathlib.Path(raw)
        rendered = temporary / "nginx.conf"
        run([
            render,
            "--template", UBUNTU / "nginx.conf.in",
            "--output", rendered,
            "--api-listen", "100.64.0.10:8443",
            "--files-listen", "100.64.0.10:9443",
            "--tailnet-hostname", "host.example.ts.net",
        ])
        rendered_text = text(rendered)
        require("@@NMCP_" not in rendered_text, "renderer left a token")
        rejected = subprocess.run([
            render,
            "--template", UBUNTU / "nginx.conf.in",
            "--output", temporary / "rejected.conf",
            "--api-listen", "0.0.0.0:8443",
            "--files-listen", "100.64.0.10:9443",
            "--tailnet-hostname", "host.example.ts.net",
        ], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        require(rejected.returncode != 0, "renderer accepted a wildcard listener")

        nginx = shutil.which("nginx")
        openssl = shutil.which("openssl")
        if nginx and openssl:
            cert = temporary / "cert.pem"
            key = temporary / "key.pem"
            run([
                openssl, "req", "-x509", "-newkey", "rsa:2048", "-nodes",
                "-subj", "/CN=host.example.ts.net", "-days", "1",
                "-keyout", key, "-out", cert,
            ], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            cache = temporary / "cache"
            (cache / "client").mkdir(parents=True)
            (cache / "proxy").mkdir()
            test_config = rendered_text.replace(
                "/run/credentials/nmcp-files.service/tls-cert.pem", str(cert)
            ).replace(
                "/run/credentials/nmcp-files.service/tls-key.pem", str(key)
            ).replace(
                "/run/nmcp-nginx/nginx.pid", str(temporary / "nginx.pid")
            ).replace(
                "/run/nmcp-nginx/client", str(cache / "client")
            ).replace(
                "/run/nmcp-nginx/proxy", str(cache / "proxy")
            ).replace(
                "100.64.0.10:8443", "127.0.0.1:18443"
            ).replace(
                "100.64.0.10:9443", "127.0.0.1:19443"
            )
            test_path = temporary / "nginx-test.conf"
            test_path.write_text(test_config, encoding="utf-8")
            run([nginx, "-t", "-c", test_path])
        else:
            print("SKIP: nginx/openssl unavailable; parser test must run in CI", file=sys.stderr)

    analyzer = shutil.which("systemd-analyze")
    if analyzer:
        unit_files = [
            units / "nmcp.slice", *sorted(units.glob("nmcp-*.service")),
            *sorted(units.glob("nmcp-*.timer")), units / "nmcp.target"
        ]
        environment = os.environ.copy()
        environment["SYSTEMD_UNIT_PATH"] = f"{units}:/usr/lib/systemd/system:/lib/systemd/system"
        result = subprocess.run(
            [analyzer, "verify", *unit_files], text=True, capture_output=True, env=environment
        )
        output = result.stdout + result.stderr
        forbidden = ("Unknown key", "Failed to parse", "Ignoring unknown escape", "Invalid section")
        require(not any(item in output for item in forbidden), f"systemd parser warning:\n{output}")
        def allowed_missing(line: str) -> bool:
            return (
                "Command /opt/nmcp/current/bin/" in line
                or "Command /usr/sbin/nginx is not executable:" in line
                or "Command /usr/local/libexec/nmcp/" in line
            )
        unexpected = [
            line for line in output.splitlines()
            if line.strip() and not allowed_missing(line)
        ]
        require(not unexpected, "unexpected systemd verification output:\n" + "\n".join(unexpected))
        require(result.returncode in (0, 1), f"systemd-analyze exited {result.returncode}")
    else:
        print("SKIP: systemd-analyze unavailable; parser test must run in CI", file=sys.stderr)

    print("Ubuntu deployment static verification passed")
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (OSError, RuntimeError, UnicodeError) as error:
        print(f"verify-ubuntu-deployment: {error}", file=sys.stderr)
        sys.exit(1)
