#!/usr/bin/env python3
"""Fail-closed static and parser checks for Ubuntu production assets."""

import ast
import hashlib
import os
import pathlib
import re
import runpy
import shutil
import stat
import subprocess
import sys
import tempfile

try:
    import yaml
except ImportError:
    yaml = None


ROOT = pathlib.Path(__file__).resolve().parent.parent
UBUNTU = ROOT / "infra" / "ubuntu"


def require(condition: bool, message: str) -> None:
    if not condition:
        raise RuntimeError(message)


def run(command, **kwargs):
    print("+", " ".join(map(str, command)))
    return subprocess.run(command, check=True, text=True, **kwargs)


def text(path: pathlib.Path) -> str:
    raw = path.read_bytes()
    require(raw.endswith(b"\n") and b"\r" not in raw,
            f"{path} must use canonical UTF-8/LF source bytes")
    return raw.decode("utf-8", errors="strict")


def stable_source_digest(source: str) -> str:
    require(isinstance(source, str) and source.endswith("\n") and "\r" not in source,
            "reviewed source must use canonical UTF-8/LF text")
    encoded = source.encode("utf-8", errors="strict")
    require(encoded.decode("utf-8", errors="strict") == source,
            "reviewed source did not round-trip canonical UTF-8")
    return hashlib.sha256(encoded).hexdigest()


def verify_nonce_safe_diagnostics(client_path: pathlib.Path, containment_path: pathlib.Path) -> None:
    client = runpy.run_path(str(client_path), run_name="nmcp_client_diagnostic_fixture")
    containment = runpy.run_path(
        str(containment_path), run_name="nmcp_containment_diagnostic_fixture")
    nonce = "0123456789abcdef" * 4
    other_hex64 = "f" * 64
    derived_path = "/run/nmcp-ci/" + nonce + "/owned"
    secret = "nonce-bearing-secret"

    def assert_clean(rendered, label):
        require(nonce not in rendered and other_hex64 not in rendered
                and derived_path not in rendered
                and re.search(r"(?i)[0-9a-f]{64}", rendered) is None,
                f"{label} diagnostic retained nonce-bearing data")
        require(len(rendered) <= 540, f"{label} diagnostic is not bounded")

    service_argv = ("/usr/bin/systemd-run", f"--description={nonce}", derived_path)
    timeout = subprocess.TimeoutExpired(
        service_argv, 1, output=secret + nonce, stderr=other_hex64 + derived_path)
    original_run = subprocess.run
    try:
        subprocess.run = lambda *_args, **_kwargs: (_ for _ in ()).throw(timeout)
        try:
            client["command"](service_argv, "launch")
        except RuntimeError as error:
            rendered = client["sanitized_diagnostic"](error, nonce)
        else:
            raise RuntimeError("client timeout diagnostic fixture did not fail")
    finally:
        subprocess.run = original_run
    assert_clean(rendered, "client TimeoutExpired")
    require("timed out" in rendered and "/usr/bin/systemd-run" not in rendered
            and secret not in rendered,
            "client TimeoutExpired diagnostic is not status-only")

    client_cases = (
        RuntimeError("launch stderr " + secret + nonce + derived_path),
        RuntimeError("cleanup state Description=" + secret + " ExecStart=" + other_hex64),
        RuntimeError("top fallback " + nonce + derived_path + "x" * 900),
    )
    for index, error in enumerate(client_cases):
        assert_clean(client["sanitized_diagnostic"](error, nonce), f"client case {index}")
    state = {"LoadState": "loaded", "InvocationID": "a" * 32,
             "ActiveState": "failed", "Result": "exit-code",
             "Description": secret + nonce, "Environment": nonce,
             "ExecStart": derived_path, "Command": service_argv}
    state_rendered = str(client["sanitized_state"](state))
    assert_clean(state_rendered, "client owned state")
    require(secret not in state_rendered, "client owned state retained redacted fields")

    success = client["SUCCESS"]
    database_failure = client["CLEANUP_DATABASE_FAILURE"]
    roles_failure = client["CLEANUP_ROLES_FAILURE"]
    require(client["parse_journal_evidence"]((success + "\n").encode("ascii"))
            == (True, False, False)
            and client["parse_journal_evidence"](b"") == (False, False, False)
            and client["parse_journal_evidence"](
                (database_failure + "\n" + roles_failure + "\n").encode("ascii"))
            == (False, True, True),
            "client journal parser rejected canonical or absent evidence")
    separated = {
        label: separator.join(nonce[index:index + 2] for index in range(0, len(nonce), 2))
        for label, separator in (("colon", ":"), ("space", " "), ("hyphen", "-"))
    }
    hostile_journal = {
        "uppercase hex": success + ":" + nonce.upper() + "\n",
        **{label: success + ":" + value + "\n" for label, value in separated.items()},
        "CRLF": success + "\r\n",
        "ANSI": "\x1b[32m" + success + "\x1b[0m\n",
        "C0": success + "\x00\n",
        "C1": success + "\u0085\n",
        "zero width": success[:8] + "\u200d" + success[8:] + "\n",
        "bidi": success[:8] + "\u202e" + success[8:] + "\n",
        "NFKC": "Ｕ" + success[1:] + "\n",
        "field fragments": "MESSAGE=" + success + "\n",
        "multiline aggregation": success + "\n" + nonce + "\n",
        "duplicate category": database_failure + "\n" + database_failure + "\n",
        "reordered categories": roles_failure + "\n" + database_failure + "\n",
        "success with failure": database_failure + "\n" + success + "\n",
        "truncated canonical": success,
        "boundary padding": success + "\n" + "x" * (client["JOURNAL_BYTE_LIMIT"] - len(success) - 1),
    }
    for label, value in hostile_journal.items():
        payload = value.encode("utf-8")
        try:
            client["parse_journal_evidence"](payload)
        except RuntimeError as error:
            rendered = client["sanitized_diagnostic"](error, nonce)
            assert_clean(rendered, f"client journal {label}")
            require(value not in rendered and success not in rendered,
                    f"client journal {label} diagnostic retained raw evidence")
        else:
            raise RuntimeError(f"client journal parser accepted {label}")
    overflow = (success + "\n").encode("ascii") + b"x" * client["JOURNAL_BYTE_LIMIT"]
    try:
        client["parse_journal_evidence"](overflow)
    except RuntimeError as error:
        assert_clean(client["sanitized_diagnostic"](error, nonce), "client journal overflow")
    else:
        raise RuntimeError("client journal parser accepted byte overflow")

    class FakeJournalProcess:
        def __init__(self, payload, status=0):
            read_fd, write_fd = os.pipe()
            os.write(write_fd, payload)
            os.close(write_fd)
            self.stdout = self
            self.read_fd = read_fd
            self.status = status

        def fileno(self):
            return self.read_fd

        def wait(self, timeout=None):
            del timeout
            return self.status

        def poll(self):
            return self.status

        def kill(self):
            self.status = -9

        def close(self):
            os.close(self.read_fd)

    original_popen = subprocess.Popen
    original_select = client["select"].select
    try:
        subprocess.Popen = lambda *_args, **_kwargs: FakeJournalProcess(
            (success + "\n").encode("ascii"))
        require(client["bounded_journal_evidence"]("a" * 32) == (True, False, False),
                "client bounded journal acquisition rejected canonical evidence")
        subprocess.Popen = lambda *_args, **_kwargs: FakeJournalProcess(overflow)
        try:
            client["bounded_journal_evidence"]("a" * 32)
        except RuntimeError as error:
            assert_clean(client["sanitized_diagnostic"](error, nonce),
                         "client acquired journal overflow")
        else:
            raise RuntimeError("client bounded journal acquisition accepted overflow")
        subprocess.Popen = lambda *_args, **_kwargs: FakeJournalProcess(
            (success + "\n").encode("ascii"), status=7)
        try:
            client["bounded_journal_evidence"]("a" * 32)
        except RuntimeError as error:
            rendered = client["sanitized_diagnostic"](error, nonce)
            assert_clean(rendered, "client journal nonzero")
            require("status 7" in rendered and success not in rendered,
                    "client journal nonzero diagnostic lost status or retained evidence")
        else:
            raise RuntimeError("client bounded journal acquisition accepted nonzero status")
        subprocess.Popen = lambda *_args, **_kwargs: FakeJournalProcess(b"")
        client["select"].select = lambda *_args, **_kwargs: ((), (), ())
        try:
            client["bounded_journal_evidence"]("a" * 32)
        except RuntimeError as error:
            rendered = client["sanitized_diagnostic"](error, nonce)
            assert_clean(rendered, "client journal timeout")
            require("timed out" in rendered,
                    "client journal timeout diagnostic lost fixed classification")
        else:
            raise RuntimeError("client bounded journal acquisition accepted timeout")
    finally:
        client["select"].select = original_select
        subprocess.Popen = original_popen

    malformed = subprocess.CompletedProcess(
        ("systemctl", "show"), 0, "LoadState=loaded\n" + secret + nonce + "\n", "")
    try:
        client["parse_unit_properties"](malformed, ("LoadState",))
    except RuntimeError as error:
        rendered = client["sanitized_diagnostic"](error, nonce)
        assert_clean(rendered, "client malformed property")
        require(secret not in rendered, "client malformed-property diagnostic retained raw line")
    else:
        raise RuntimeError("client malformed-property diagnostic fixture did not fail")

    containment_cases = (timeout, RuntimeError(secret + nonce + derived_path + "x" * 900))
    for index, error in enumerate(containment_cases):
        assert_clean(containment["bounded_sanitized_repr"](error, nonce),
                     f"containment case {index}")
    busctl_failure = subprocess.CompletedProcess(
        ("busctl",), 7, "", secret + nonce + derived_path)
    try:
        containment["parse_structured_command"](busctl_failure, "ExecStart")
    except RuntimeError as error:
        rendered = containment["bounded_sanitized_repr"](error, nonce)
        assert_clean(rendered, "containment busctl stderr")
        require("status 7" in rendered and secret not in rendered,
                "containment busctl diagnostic lost safe status or retained stderr")
    else:
        raise RuntimeError("containment busctl diagnostic fixture did not fail")
    duplicate = subprocess.CompletedProcess(
        ("busctl",), 0, '{"' + nonce + '":1,"' + nonce + '":2}', "")
    try:
        containment["parse_structured_command"](duplicate, "ExecStart")
    except RuntimeError as error:
        assert_clean(containment["bounded_sanitized_repr"](error, nonce),
                     "containment duplicate key")
    else:
        raise RuntimeError("containment duplicate-key diagnostic fixture did not fail")
    faulted = subprocess.CompletedProcess(
        service_argv, 1, secret + nonce + derived_path, other_hex64 + secret)
    classification = {"success_in_stdout": False, "property_unknown": True,
                      "action_unavailable": False}
    persistent = containment["persistent_failure_diagnostics"](
        "fixture", "show", faulted, classification, 4, 0, state, state, True,
        {"LoadState": "not-found"}, "", "", "", [])
    assert_clean(persistent, "containment persistent failure")
    require(secret not in persistent and "stdout_present=True" in persistent
            and "stderr_present=True" in persistent and "LoadState" in persistent
            and "ActiveState" in persistent and "Result" in persistent,
            "containment diagnostics retained streams or lost safe state/boolean evidence")


def require_default_run_context(mapping: dict, label: str) -> None:
    require(
        "shell" not in mapping and "working-directory" not in mapping,
        f"{label} must use the reviewed shell and working directory",
    )


def shell_commands(run_text: str) -> list[str]:
    logical = re.sub(r"\\\s*\n\s*", " ", run_text)
    return [
        " ".join(line.strip().split())
        for line in logical.splitlines()
        if line.strip() and not line.lstrip().startswith("#")
    ]


