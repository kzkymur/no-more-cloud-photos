            persistent_binding_violations.append(node)
        elif (isinstance(node, ast.Attribute) and isinstance(node.value, ast.Name)
              and node.value.id in protected_persistent_bindings
              and isinstance(node.ctx, (ast.Store, ast.Del))):
            persistent_binding_violations.append(node)
        elif (isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef, ast.ClassDef))
              and node.name in protected_persistent_bindings
              and node not in reviewed_persistent_functions | set(evidence_classes)):
            persistent_binding_violations.append(node)
        elif isinstance(node, ast.arg) and node.arg in protected_persistent_bindings:
            persistent_binding_violations.append(node)
        elif (isinstance(node, ast.ExceptHandler) and node.name in protected_persistent_bindings):
            persistent_binding_violations.append(node)
        elif isinstance(node, ast.alias):
            bound = node.asname or node.name.split(".", 1)[0]
            if ((bound in protected_persistent_bindings and node not in reviewed_import_aliases)
                    or node.name == "*"):
                persistent_binding_violations.append(node)
        elif isinstance(node, (ast.MatchAs, ast.MatchStar)) and node.name in protected_persistent_bindings:
            persistent_binding_violations.append(node)
        elif (isinstance(node, ast.MatchMapping)
              and node.rest in protected_persistent_bindings):
            persistent_binding_violations.append(node)
        elif (isinstance(node, ast.Constant)
              and node.value in protected_persistent_string_bindings):
            persistent_binding_violations.append(node)
        elif (isinstance(node, ast.Call) and isinstance(node.func, ast.Name)
              and node.func.id in {"globals", "locals", "vars", "setattr", "delattr",
                                   "getattr", "exec", "eval", "compile", "__import__"}):
            persistent_binding_violations.append(node)
        elif (isinstance(node, ast.Call) and isinstance(node.func, ast.Attribute)
              and node.func.attr in {"globals", "locals", "vars", "setattr", "delattr",
                                    "getattr", "exec", "eval", "compile", "__import__",
                                    "FunctionType", "MethodType", "CodeType", "loads"}
              and ast.dump(node) not in {reviewed_json_loads, reviewed_intent_json_loads}):
            persistent_binding_violations.append(node)
        elif (isinstance(node, ast.Attribute)
              and (node.attr.startswith("__") or node.attr in {
                                "__code__", "__defaults__", "__kwdefaults__", "__dict__",
                                "__globals__", "__closure__", "__setattr__", "__delattr__",
                                "setattr", "delattr", "getattr", "modules", "builtins",
                                "_getframe", "f_globals", "f_locals", "gi_frame", "cr_frame",
                                "tb_frame", "exec", "eval", "compile", "__import__"})
              and node not in reviewed_evidence_attributes):
            persistent_binding_violations.append(node)
        elif (isinstance(node, ast.ImportFrom)
              and (node.module or "").split(".", 1)[0] in {"__main__", "builtins", "importlib"}):
            persistent_binding_violations.append(node)
    require(not persistent_binding_violations,
            "containment persistent classification/diagnostic binding has a mutation path")
