    "migration-wrapper": ("migration compatibility wrapper", 0o755),
    "nmcp-admin-current": ("candidate migration admin", 0o755),
    "nmcp-admin-v18": ("approved v18 migration admin", 0o755),
    "nmcp.sysusers": ("nmcp system user declaration", 0o400),
    "phase": ("compatibility phase entrypoint", 0o500),
    "postgresql-roles.sql": ("database bootstrap SQL", 0o644),
    "role-mode": ("migration role mode wrapper", 0o755),
    "runtime-helper": ("runtime boundary helper", 0o500),
    "runtime-roles.sql": ("runtime role bootstrap SQL", 0o644),
    "supervisor": ("trusted root supervisor", 0o500),
    "verify-role-graph.sql": ("role graph verifier SQL", 0o644),
    "verify-runtime-roles.sql": ("independent runtime verifier SQL", 0o644),
    "verify-stage": ("closed snapshot verifier", 0o500),
}

TRUST_STATEMENT = """Build, seal, execute, and remove migration-role compatibility evidence.

Independent review authorizes candidate bytes. Manifests and AST checks provide
regression/integrity evidence, never authentication. Without an externally
protected workflow they cannot defend against candidate/verifier collusion.
The hostile-root threat model is explicitly out of scope.
"""


def literal_assignment(tree: ast.Module, name: str):
    matches = [
        node for node in tree.body
        if isinstance(node, ast.Assign) and len(node.targets) == 1
        and isinstance(node.targets[0], ast.Name) and node.targets[0].id == name
    ]
    require(len(matches) == 1, f"supervisor must define {name} exactly once")
    try:
        return ast.literal_eval(matches[0].value)
    except (TypeError, ValueError) as error:
        raise RuntimeError(f"supervisor {name} must be a literal") from error


def named_function(tree: ast.Module, name: str) -> ast.FunctionDef:
    matches = [node for node in tree.body if isinstance(node, ast.FunctionDef) and node.name == name]
    require(len(matches) == 1, f"program must define {name} exactly once")
    return matches[0]


def require_exact_function(tree: ast.Module, name: str, expected: str, message: str) -> None:
    observed = named_function(tree, name)
    expected_node = named_function(ast.parse(expected), name)
    require(ast.dump(observed) == ast.dump(expected_node), message)


def require_exact_assignment(tree: ast.Module, name: str, expected: str, message: str) -> None:
    matches = [
        node for node in tree.body if isinstance(node, ast.Assign) and len(node.targets) == 1
        and isinstance(node.targets[0], ast.Name) and node.targets[0].id == name
    ]
    expected_node = ast.parse(expected).body[0]
    require(len(matches) == 1 and ast.dump(matches[0]) == ast.dump(expected_node), message)


def constant_string(node: ast.AST):
    if isinstance(node, ast.Constant) and isinstance(node.value, str):
        return node.value
    if isinstance(node, ast.BinOp) and isinstance(node.op, ast.Add):
        left = constant_string(node.left)
        right = constant_string(node.right)
        return left + right if left is not None and right is not None else None
    if isinstance(node, ast.BinOp) and isinstance(node.op, ast.Mult):
        if (isinstance(node.left, ast.Constant) and isinstance(node.left.value, str)
                and isinstance(node.right, ast.Constant) and type(node.right.value) is int):
            return node.left.value * node.right.value
        if (isinstance(node.right, ast.Constant) and isinstance(node.right.value, str)
                and isinstance(node.left, ast.Constant) and type(node.left.value) is int):
            return node.right.value * node.left.value
    if isinstance(node, ast.JoinedStr):
        values = [constant_string(value) for value in node.values]
        return "".join(values) if all(value is not None for value in values) else None
    if (isinstance(node, ast.FormattedValue) and isinstance(node.value, ast.Constant)
            and isinstance(node.value.value, (str, int)) and node.format_spec is None):
        if node.conversion in (-1, ord("s")):
            return str(node.value.value)
        if node.conversion == ord("r"):
            return repr(node.value.value)
        if node.conversion == ord("a"):
            return ascii(node.value.value)
    if (isinstance(node, ast.Call) and isinstance(node.func, ast.Attribute)
            and node.func.attr == "join" and not node.keywords and len(node.args) == 1
            and isinstance(node.args[0], (ast.Tuple, ast.List))):
        separator = constant_string(node.func.value)
        values = [constant_string(item) for item in node.args[0].elts]
        return separator.join(values) if separator is not None and all(
            value is not None for value in values
        ) else None
    return None


def validate_runtime_helper(source: str) -> None:
    require(source.startswith("#!/usr/bin/env bash\nset -euo pipefail\numask 0077\n"),
            "runtime helper preamble changed")
    require(
        source.count("[[ $# -eq 1 && $1 =~ ^[0-9]+$ ]]") == 1
        and source.count("sql_fd=$1") == 1
        and source.count("[[ -r /proc/self/fd/$sql_fd ]]") == 1,
        "runtime helper must accept and check exactly one SQL descriptor",
    )
    require(
        source.count("/usr/bin/psql") == 1
        and "exec /usr/bin/env -i PATH=/usr/bin:/bin LC_ALL=C HOME=/var/lib/postgresql" in source
        and "/usr/sbin/runuser -u postgres -- /usr/bin/psql --no-psqlrc" in source
        and "--host=/var/run/postgresql --port=5432 --username=postgres --dbname=nmcp" in source
        and "--set=ON_ERROR_STOP=1 <&\"$sql_fd\"" in source,
        "runtime helper must execute the SQL descriptor with fixed peer-authenticated psql arguments",
    )
    require("--file=" not in source and "repo" not in source.lower() and "/usr/bin/install" not in source,
            "runtime helper must not reopen or restage a path")


def validate_stage_verifier(source: str) -> None:
    tree = ast.parse(source, filename="verify-ubuntu-migration-role-stage")
    named_function(tree, "main")
    require(literal_assignment(tree, "ALLOWED") == STAGE_ALLOWED,
            "stage verifier explicit asset allowlist changed")
    required = (
        'os.open(root, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)',
        'os.open("manifest.json", os.O_RDONLY | os.O_NOFOLLOW, dir_fd=root_fd)',
        'actual = set(os.listdir(root_fd))',
        'expected = set(names) | {"manifest.json"}',
        'if actual != expected:',
        'if names != sorted(names) or len(names) != len(set(names)) or set(names) != set(ALLOWED):',
        'required = {"name", "purpose", "provenance_commit", "provenance_tree", "toolchain", "type", "uid", "gid", "mode", "size", "sha256"}',
        'purpose, mode = ALLOWED[item["name"]]',
        'if item["purpose"] != purpose or item["mode"] != mode or item["uid"] != 0 or item["gid"] != 0:',
        'if item["name"].startswith("nmcp-admin-"):',
        'elif item["toolchain"] is not None:',
        'os.open(item["name"], os.O_RDONLY | os.O_NOFOLLOW, dir_fd=root_fd)',
        'if observed != recorded:',
    )
    require(all(source.count(fragment) == 1 for fragment in required),
            "stage verifier manifest/inventory contract changed")


def compatibility_cases(source: str) -> tuple[str, ...]:
    match = re.search(r"(?ms)^case \$phase in\n(?P<body>.*)^  \*\)", source)
    require(match is not None, "compatibility phase dispatcher changed")
    return tuple(re.findall(r"(?m)^  ([a-z0-9-]+)\)$", match.group("body")))


def validate_compatibility_phase(source: str) -> None:
    require(compatibility_cases(source) == PHASES,
            "compatibility phase table must be the exact 13 ordered phases")
    require(source.count("case $phase in") == 1 and source.count("unknown compatibility phase") == 1,
            "compatibility phase dispatcher must fail closed")
    require("repo_root" not in source and "/usr/bin/git" not in source
            and "verify-installed-runtime-roles" not in source,
            "compatibility phases must not read repository or restage runtime boundary assets")
    phase_inputs = (
        'wrapper=${NMCP_WRAPPER:?missing staged wrapper descriptor}',
        'role_mode=${NMCP_ROLE_MODE:?missing staged role-mode descriptor}',
        'current=${NMCP_CURRENT_ADMIN:?missing staged current admin descriptor}',
        'v18=${NMCP_V18_ADMIN:?missing staged v18 admin descriptor}',
        'postgresql_roles=${NMCP_POSTGRESQL_ROLES:?missing staged PostgreSQL bootstrap descriptor}',
        'verify_role_graph=${NMCP_VERIFY_ROLE_GRAPH:?missing staged role graph descriptor}',
    )
    require(all(source.count(item) == 1 for item in phase_inputs),
            "compatibility phase descriptor environment changed")
    for evidence in ("assert_hardened", "assert_compatibility", "assert_migration",
                     "unfinished-v18-rejection", "completed-v18-rejection", "writer-drain"):
        require(evidence in source, f"compatibility phase evidence missing {evidence}")


def validate_supervisor(source: str) -> None:
    tree = ast.parse(source, filename="verify-ubuntu-migration-role-supervisor")
    require(ast.get_docstring(tree, clean=False) == TRUST_STATEMENT,
            "supervisor trust statement changed")
    require(literal_assignment(tree, "CURRENT_ASSETS") == CURRENT_ASSETS,
            "supervisor current asset inventory changed")
    require(literal_assignment(tree, "PHASES") == PHASES,
            "supervisor phase table must be the exact 13 ordered phases")
    require(literal_assignment(tree, "HISTORICAL") == "172583179d860619ae2c79505971e10ae7f394fc",
            "supervisor historical provenance changed")
    require(literal_assignment(tree, "INTENT_PATH") == "/run/nmcp-ci/cleanup-intent.json",
            "supervisor cleanup intent path changed")
    require(literal_assignment(tree, "INTENT_READY_PATH") == "/run/nmcp-ci/cleanup-intent.ready",
            "supervisor cleanup intent ready path changed")
    require(literal_assignment(tree, "TOP_ALLOWLISTS") == {
        "/usr/local/libexec/nmcp": {"postgresql", "set-ubuntu-migration-role-mode", "run-ubuntu-migration-compatibility", "verify-installed-runtime-roles"},
        "/var/lib/nmcp": {"deployment"},
        "/opt/nmcp-role-compatibility": {"current", "v18", "test-work"},
    }, "supervisor cleanup top-level allowlists changed")
    require_exact_function(tree, "git", '''def git(repo, *args, stdout=None):
    return subprocess.run(("/usr/bin/git", "-c", f"safe.directory={repo}", "-C", repo, *args), cwd="/", env=clean_env(),
                          check=True, stdout=stdout or subprocess.PIPE).stdout
''', "supervisor git must use command-scoped safe.directory")
    require_exact_function(tree, "validate_launch_marker", '''def validate_launch_marker(path, nonce, suffix, absent_ok=False):
    root = "/run/nmcp-ci"
    expected_path = root + "/launch-" + nonce + suffix
    if path != expected_path:
        die("persistent launch protocol path does not match its nonce")
    directory = os.open(root, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    with CleanupScope() as cleanup:
        cleanup.defer("launch-marker-directory-close", os.close, directory)
        try:
            descriptor = os.open(os.path.basename(path),
                                 os.O_RDONLY | os.O_NONBLOCK | os.O_NOFOLLOW,
                                 dir_fd=directory)
        except FileNotFoundError:
            if absent_ok:
                return False
            raise
        cleanup.defer("launch-marker-close", os.close, descriptor)
        before = os.fstat(descriptor)
        if (not stat.S_ISREG(before.st_mode) or before.st_uid != 0 or before.st_gid != 0
                or before.st_nlink != 1 or stat.S_IMODE(before.st_mode) != 0o600):
            die("unsafe persistent launch protocol marker")
        payload = os.read(descriptor, len(nonce) + 2)
        after = os.fstat(descriptor)
        current = os.stat(os.path.basename(path), dir_fd=directory, follow_symlinks=False)
        identity = lambda value: (
            value.st_dev, value.st_ino, value.st_mode, value.st_uid, value.st_gid,
            value.st_nlink, value.st_size, value.st_mtime_ns, value.st_ctime_ns,
        )
        expected_payload = (nonce + "\\n").encode("ascii")
        if (identity(before) != identity(after) or identity(before) != identity(current)
                or before.st_size != len(expected_payload) or payload != expected_payload):
            die("persistent launch protocol marker was malformed or replaced")
        return True
''', "supervisor persistent launch marker validation changed")
    require_exact_function(tree, "validate_launch_required", '''def validate_launch_required(path, nonce):
    validate_launch_marker(path, nonce, ".required")
