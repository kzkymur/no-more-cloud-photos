    if len(payload) > JOURNAL_BYTE_LIMIT:
        fail("journal evidence exceeded byte limit")
    try:
        output = payload.decode("ascii")
    except UnicodeDecodeError:
        fail("journal evidence was not ASCII")
    if not output:
        return (False, False, False)
    lines = output.splitlines(keepends=True)
    if len(lines) > JOURNAL_LINE_LIMIT:
        fail("journal evidence contained extra lines")
    allowed = (CLEANUP_DATABASE_FAILURE, CLEANUP_ROLES_FAILURE, SUCCESS)
    observed = [line[:-1] for line in lines if line.endswith("\\n")]
    if (len(observed) != len(lines) or len(set(observed)) != len(observed)
            or any(line not in allowed for line in observed)
            or observed != [line for line in allowed if line in observed]
            or (SUCCESS in observed and len(observed) != 1)):
        fail("journal evidence was not an exact ordered allowlist")
    return (SUCCESS in observed, CLEANUP_DATABASE_FAILURE in observed,
            CLEANUP_ROLES_FAILURE in observed)
''', "client journal parser must accept only exact ordered category lines")
    require_exact_function(tree, "bounded_journal_evidence", '''def bounded_journal_evidence(invocation):
    deadline = bounded_deadline(JOURNAL_TIMEOUT)
    argv = ("/usr/bin/journalctl", "--quiet", "--no-pager", "--output=cat",
            "--case-sensitive=yes", "--since=-20min", f"--lines={JOURNAL_QUERY_LINE_LIMIT}",
            f"--grep=^({CLEANUP_DATABASE_FAILURE}|{CLEANUP_ROLES_FAILURE}|{SUCCESS})$",
            f"_SYSTEMD_INVOCATION_ID={invocation}")
    try:
        process = subprocess.Popen(argv, cwd="/", env=ENVIRONMENT, stdout=subprocess.PIPE,
                                   stderr=subprocess.DEVNULL)
    except OSError as error:
        raise evidence_failure("journal", "popen", "journal", error) from None
    payload = bytearray()
    try:
        os_call("journal", "set-blocking", "journal", os.set_blocking,
                process.stdout.fileno(), False)
        while True:
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                fail("journal evidence query timed out")
            readable, _writable, _exceptional = os_call(
                "journal", "read", "journal", select.select,
                (process.stdout.fileno(),), (), (), remaining)
            if not readable:
                fail("journal evidence query timed out")
            chunk = os_call("journal", "read", "journal", os.read, process.stdout.fileno(),
                            JOURNAL_BYTE_LIMIT + 1 - len(payload))
            if not chunk:
                break
            payload.extend(chunk)
            if len(payload) > JOURNAL_BYTE_LIMIT:
                fail("journal evidence exceeded byte limit")
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            fail("journal evidence query timed out")
        try:
            status = os_call("journal", "wait", "journal", process.wait, timeout=remaining)
        except subprocess.TimeoutExpired:
            fail("journal evidence query timed out")
        if status:
            fail(f"journal evidence query failed with status {status}")
    finally:
        if process.poll() is None:
            os_call("journal", "kill", "journal", process.kill)
            try:
                os_call("journal", "wait", "journal", process.wait, timeout=1)
            except subprocess.TimeoutExpired:
                pass
        os_call("journal", "close", "journal", process.stdout.close)
    return parse_journal_evidence(bytes(payload))
''', "client journal acquisition must be byte/line/time bounded and status-only")
