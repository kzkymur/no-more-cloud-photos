        ("fault fast recovery omitted", replace_once(containment,
            '            if f"intercepted {boundary} command before attempt" not in faulted.stderr:\n                fail(f"property retry did not retain its initial real error: {mode}")\n        fast_recovery(client, repo, commit, go_binary, mode)',
            '            if f"intercepted {boundary} command before attempt" not in faulted.stderr:\n                fail(f"property retry did not retain its initial real error: {mode}")\n        pass')),
        ("cleanup fault boundary omitted", containment.replace(
            '("show", "kill", "stop", "wait", "reset", "unload")',
            '("show", "kill", "stop", "wait", "reset")', 1)),
        ("cleanup interception counter weakened", replace_once(containment,
            '    if counter(intercepted) < minimum:', '    if False:')),
