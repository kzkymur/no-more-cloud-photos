            "containment work-budget launch/service/journal causal ordering changed")
    slow_starts = [
        index for index, node in enumerate(main_node.body)
        if isinstance(node, ast.Assign) and len(node.targets) == 1
        and isinstance(node.targets[0], ast.Name) and node.targets[0].id == "slow_mode"
    ]
    expected_slow = ast.parse('''slow_mode = "client-work-budget-slow-cleanup"
slow_ready = f"/run/nmcp-ci/{slow_mode}.ready"
slow_unloaded = f"/run/nmcp-ci/{slow_mode}-unloaded.ready"
slow_paths = {boundary: fault_paths(slow_mode, boundary)
