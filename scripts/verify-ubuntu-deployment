def validate_ubuntu_workflow(source: str) -> None:
    workflow = load_workflow(source)
    require(set(workflow) == {"name", "on", "permissions", "concurrency", "jobs"},
            "Ubuntu workflow top-level contract changed")
    require(workflow["name"] == "Ubuntu deployment", "Ubuntu workflow name changed")
    require(workflow["permissions"] == {"contents": "read"}, "Ubuntu workflow permissions changed")
    require(workflow["concurrency"] == {
        "group": "ubuntu-deployment-${{ github.ref }}", "cancel-in-progress": True,
    }, "Ubuntu workflow concurrency contract changed")
    triggers = workflow["on"]
    require(isinstance(triggers, dict) and set(triggers) == {"pull_request", "push", "workflow_dispatch"},
            "Ubuntu workflow trigger set changed")
    require(triggers["workflow_dispatch"] is None, "Ubuntu workflow_dispatch trigger changed")
    require(triggers["push"] == {"branches": ["main"], "paths": EXPECTED_PATHS},
            "Ubuntu workflow push routing changed")
    require(triggers["pull_request"] == {"paths": EXPECTED_PATHS},
            "Ubuntu workflow pull_request routing changed")
    job = workflow.get("jobs", {}).get("verify")
    require(isinstance(job, dict) and set(workflow["jobs"]) == {"verify"}
            and set(job) == {"runs-on", "timeout-minutes", "steps"},
            "Ubuntu verify job mapping changed")
    require(job["runs-on"] == "ubuntu-24.04" and type(job["timeout-minutes"]) is int
            and job["timeout-minutes"] == 60, "Ubuntu verify job runner or timeout changed")
    steps = job["steps"]
    require(isinstance(steps, list) and all(isinstance(step, dict) for step in steps),
            "Ubuntu verify steps must be mappings")
    require([step.get("name") for step in steps] == EXPECTED_STEP_NAMES,
            "Ubuntu workflow exact step sequence changed")
    require(steps[0] == {
        "uses": "actions/checkout@de0fac2e4500dabe0009e67214ff5f5447ce83dd",
        "with": {"fetch-depth": 0, "persist-credentials": False},
    }, "Ubuntu checkout action or typed inputs changed")
    require(steps[1] == {
        "name": "Install Go",
        "uses": "actions/setup-go@b7ad1dad31e06c5925ef5d2fc7ad053ef454303e",
        "with": {"go-version": "1.27.1", "cache": True},
    }, "Ubuntu setup-go action or typed inputs changed")
    uses = [step["uses"] for step in steps if "uses" in step]
    require(uses == [steps[0]["uses"], steps[1]["uses"]] and all(not value.startswith("./") for value in uses),
            "Ubuntu workflow must contain exactly the two pinned reviewed actions")
    for index, step in enumerate(steps[2:], 2):
        allowed = {"name", "run"}
        if index in (17, 18):
            allowed.add("env")
        if index in (18, 19):
            allowed.add("if")
        require(set(step) == allowed, f"Ubuntu workflow step {step['name']} mapping changed")
        require(type(step["run"]) is str, f"Ubuntu workflow step {step['name']} run must be a string")
        require_default_run_context(step, f"Ubuntu workflow step {step['name']}")
    require(steps[17]["env"] == {"RELEASE_ID": "ci-${{ github.run_id }}-${{ github.run_attempt }}"}
            and steps[18]["env"] == steps[17]["env"], "Ubuntu workflow release env changed")
    require(steps[18]["if"] == "always()" and steps[19]["if"] == "always()",
            "Ubuntu workflow cleanup conditions changed")
    require(all("env" not in step for index, step in enumerate(steps) if index not in (17, 18)),
            "Ubuntu workflow contains an unintended step env")
    dependency = shell_commands(steps[2]["run"])
    require(dependency == ["sudo apt-get update",
        "sudo apt-get install --yes --no-install-recommends ffmpeg libimage-exiftool-perl nginx-core postgresql python3-yaml shellcheck util-linux"],
        "Ubuntu parser dependency commands changed")
    require(steps[3]["run"] == EXPECTED_SUPERVISOR_LOADER,
            "Ubuntu workflow authorized supervisor loader changed")
    require(steps[5]["run"] == "/usr/bin/python3 scripts/verify-ubuntu-deployment",
            "Ubuntu workflow static verifier command changed")
    exact_short_runs = {
        6: ["go test -c -o /tmp/nmcp-storage-repair.test ./internal/storage", "go build -o /tmp/nmcp-repair-late-bind ./infra/validation/repair-mount-verifier", "sudo scripts/verify-ubuntu-repair-mount-boundaries /tmp/nmcp-storage-repair.test /tmp/nmcp-repair-late-bind"],
        7: ["scripts/verify-ubuntu-config-boundaries", "scripts/verify-ubuntu-firewall-fixtures"],
        8: ["sudo scripts/verify-ubuntu-trusted-inputs"],
        9: ["sudo scripts/verify-ubuntu-systemd-environment"],
        10: ["sudo ip address add 100.64.0.10/32 dev lo", "scripts/verify-ubuntu-nginx-http"],
        11: ["sudo scripts/verify-ubuntu-installed-nginx"], 12: ["sudo scripts/verify-ubuntu-systemd-mounts"],
        13: ["sudo scripts/verify-ubuntu-postgresql-dependency"], 14: ["sudo scripts/verify-ubuntu-service-gate"],
        15: ["sudo scripts/verify-ubuntu-migration-lock"], 16: ["sudo scripts/verify-ubuntu-release-failures"],
        19: ["sudo ip address delete 100.64.0.10/32 dev lo || true"],
    }
    for index, commands in exact_short_runs.items():
        require(shell_commands(steps[index]["run"]) == commands,
                f"Ubuntu workflow step {steps[index]['name']} commands changed")
    expected_shellcheck = (
        "/usr/bin/shellcheck scripts/install-ubuntu-host scripts/install-ubuntu-release "
        "scripts/check-ubuntu-tls-expiry scripts/renew-ubuntu-tls scripts/run-ubuntu-migration "
        "scripts/run-ubuntu-migration-compatibility scripts/set-ubuntu-migration-role-mode "
        "scripts/verify-ubuntu-migration-lock scripts/verify-ubuntu-migration-role-compatibility "
        "scripts/verify-ubuntu-repair-mount-boundaries scripts/verify-ubuntu-config-boundaries "
        "scripts/verify-ubuntu-firewall-fixtures scripts/verify-ubuntu-installed-nginx "
        "scripts/verify-ubuntu-nginx-http scripts/verify-ubuntu-postgresql-dependency "
        "scripts/verify-ubuntu-release-failures scripts/verify-ubuntu-service-gate "
        "scripts/verify-ubuntu-tls-certificate scripts/verify-ubuntu-systemd-environment "
        "scripts/verify-ubuntu-systemd-mounts scripts/verify-ubuntu-trusted-inputs "
        "scripts/verify-installed-runtime-roles"
    )
    require(shell_commands(steps[4]["run"]) == [expected_shellcheck],
            "Ubuntu workflow ShellCheck command changed")
    expected_release = """mkdir -p /tmp/nmcp-release/bin
for binary in core-api core-worker nmcp-admin; do
  printf '#!/bin/sh\\nexit 0\\n' > "/tmp/nmcp-release/bin/$binary"
  chmod 0755 "/tmp/nmcp-release/bin/$binary"
done
(cd /tmp/nmcp-release && sha256sum bin/* > MANIFEST.sha256)
chmod 0700 /tmp/nmcp-release/bin/core-api
if sudo scripts/install-ubuntu-release stage /tmp/nmcp-release "$RELEASE_ID-bad-mode"; then
  echo '0700 runtime binary unexpectedly staged' >&2
  exit 1
fi
chmod 0755 /tmp/nmcp-release/bin/core-api
sudo systemd-run --quiet --unit=nmcp-orphan-migration \\
  /usr/bin/flock /run/nmcp-deploy/migration-execution.lock \\
  /bin/sh -c 'touch /tmp/nmcp-orphan-migration-held; sleep 3'
for attempt in {1..30}; do
  test -e /tmp/nmcp-orphan-migration-held && break
  test "$attempt" -lt 30 || exit 1
  sleep 0.1
done
if sudo scripts/install-ubuntu-release stage /tmp/nmcp-release "$RELEASE_ID-orphan-migration"; then
  echo 'new deployment overlapped an ownerless migration execution' >&2
  exit 1
fi
for attempt in {1..50}; do
  orphan_state=$(sudo systemctl show --property=ActiveState --value nmcp-orphan-migration.service)
  case "$orphan_state" in
    inactive) break ;;
    active|activating|deactivating) ;;
    *) echo "unexpected orphan migration state: $orphan_state" >&2; exit 1 ;;
  esac
  test "$attempt" -lt 50 || exit 1
  sleep 0.1
done
test "$(sudo systemctl show --property=Result --value nmcp-orphan-migration.service)" = success
sudo flock /run/nmcp-deploy/deploy.lock -c 'touch /tmp/nmcp-deploy-lock-held; sleep 3' &
lock_pid=$!
for attempt in {1..30}; do
  test -e /tmp/nmcp-deploy-lock-held && break
  test "$attempt" -lt 30 || exit 1
  sleep 0.1
done
if sudo scripts/install-ubuntu-release stage /tmp/nmcp-release "$RELEASE_ID-locked"; then
  echo 'concurrent deployment operation unexpectedly staged' >&2
  exit 1
fi
if sudo env NMCP_DEPLOY_LOCKED=1 scripts/install-ubuntu-release stage /tmp/nmcp-release "$RELEASE_ID-spoofed"; then
  echo 'caller-controlled lock sentinel bypassed serialization' >&2
  exit 1
fi
wait "$lock_pid"
sudo scripts/install-ubuntu-release stage /tmp/nmcp-release "$RELEASE_ID"
sudo test "$(stat -c '%U:%G' "/opt/nmcp/releases/$RELEASE_ID/bin/core-api")" = root:root
sudo test "$(stat -c '%a' "/opt/nmcp/releases/$RELEASE_ID/bin/core-api")" = 755
sudo -u nmcp test -x "/opt/nmcp/releases/$RELEASE_ID/bin/core-api"
"""
    expected_cleanup = """sudo rm -rf -- "/opt/nmcp/releases/$RELEASE_ID" \\
  "/opt/nmcp/releases/$RELEASE_ID-bad-mode" \\
  "/opt/nmcp/releases/$RELEASE_ID-locked" \\
  "/opt/nmcp/releases/$RELEASE_ID-orphan-migration" \\
  "/opt/nmcp/releases/$RELEASE_ID-spoofed" /tmp/nmcp-release
sudo rm -f /tmp/nmcp-deploy-lock-held /tmp/nmcp-orphan-migration-held
"""
    require(steps[17]["run"] == expected_release,
            "Ubuntu immutable release staging transaction changed")
    require(steps[18]["run"] == expected_cleanup,
            "Ubuntu release cleanup transaction changed")


def replace_once(source: str, old: str, new: str) -> str:
    if source.count(old) != 1 and "def cgroup_pids(control_group):" in old:
        old = old.replace("def cgroup_pids(control_group):",
                          "def cgroup_pids(control_group, phase):")
        new = new.replace("def cgroup_pids(control_group):",
                          "def cgroup_pids(control_group, phase):")
    if source.count(old) != 1 and 'path_exists("cleanup-intent", "cleanup-intent",' in old:
        old = old.replace('path_exists("cleanup-intent", "cleanup-intent",',
                          'path_exists("retained-cleanup", "cleanup-intent",')
    require(source.count(old) == 1, f"mutation target is not unique: {old[:40]}")
    return source.replace(old, new, 1)


def swap_step_blocks(source: str, first: str, second: str) -> str:
    def bounds(marker):
        start = source.index("      - name: " + marker)
        end = source.find("\n      - ", start + 1)
        return start, len(source) if end < 0 else end + 1
    first_start, first_end = bounds(first)
    second_start, second_end = bounds(second)
    require(first_end <= second_start, "mutation step order assumption changed")
    return (source[:first_start] + source[second_start:second_end] + source[first_end:second_start]
            + source[first_start:first_end] + source[second_end:])


def expect_rejected(validator, source: str, label: str, expected: str) -> None:
    try:
        validator(source)
    except (RuntimeError, SyntaxError) as error:
        require(expected in str(error), f"{label} failed for the wrong reason: {error}")
        return
    raise RuntimeError(f"validator accepted mutation: {label}")


def validate_diagnostic_fixture(source: str) -> None:
    require(stable_source_digest(source)
            == "e69e5ab9e58c277c29919c97bbd0c20c8041e1ae8704249828412a05afdcbfb4",
            "diagnostic fixture source snapshot changed")


def verify_ubuntu_workflow_mutations(source: str) -> None:
    mutations = [
        ("YAML 1.1 octal timeout", replace_once(source, "    timeout-minutes: 60", "    timeout-minutes: 074"), "canonical lexical forms"),
        ("non-canonical fetch depth", replace_once(source, "          fetch-depth: 0", "          fetch-depth: 00"), "canonical lexical forms"),
        ("tag/unpinned checkout", replace_once(source, "actions/checkout@de0fac2e4500dabe0009e67214ff5f5447ce83dd", "actions/checkout@v6"), "checkout action"),
        ("persist credentials", replace_once(source, "persist-credentials: false", "persist-credentials: true"), "checkout action"),
        ("extra remote action", replace_once(source, "      - name: Install Go", "      - uses: actions/cache@v4\n\n      - name: Install Go"), "step sequence"),
        ("local action", replace_once(source, "      - name: Install Go", "      - uses: ./.github/actions/local\n\n      - name: Install Go"), "step sequence"),
        ("inserted step", replace_once(source, "      - name: Check shell scripts", "      - name: Injected\n        run: /bin/true\n\n      - name: Check shell scripts"), "step sequence"),
        ("reordered supervisor", swap_step_blocks(source, "Run trusted migration compatibility transaction", "Check shell scripts"), "step sequence"),
        ("workflow env", replace_once(source, "permissions:\n", "env:\n  PATH: /tmp\n\npermissions:\n"), "top-level contract"),
        ("job defaults", replace_once(source, "    runs-on: ubuntu-24.04", "    defaults:\n      run:\n        shell: /bin/true {0}\n    runs-on: ubuntu-24.04"), "job mapping"),
        ("step shell", replace_once(source, "        run: /usr/bin/python3 scripts/verify-ubuntu-deployment", "        shell: /bin/true {0}\n        run: /usr/bin/python3 scripts/verify-ubuntu-deployment"), "mapping changed"),
        ("step cwd", replace_once(source, "        run: /usr/bin/python3 scripts/verify-ubuntu-deployment", "        working-directory: /tmp\n        run: /usr/bin/python3 scripts/verify-ubuntu-deployment"), "mapping changed"),
        ("top-level true", replace_once(source, "on:\n", "true:\n"), "top-level true"),
        ("duplicate on", source + "\non:\n  workflow_dispatch:\n", "top-level plain on"),
        ("anchor", "x-anchor: &shared {}\n" + source, "anchors or aliases"),
        ("alias", "x-alias: *shared\n" + source, "anchors or aliases"),
        ("merge", replace_once(source, "    runs-on: ubuntu-24.04", "    <<: {}\n    runs-on: ubuntu-24.04"), "merge keys"),
        ("wrong supervisor order", swap_step_blocks(source, "Install parser and HTTP test dependencies", "Run trusted migration compatibility transaction"), "step sequence"),
        ("unsafe supervisor invocation", replace_once(source, "          cd /\n          /usr/bin/sudo", "          cd \"$GITHUB_WORKSPACE\"\n          /usr/bin/sudo"), "authorized supervisor loader"),
        ("wrong github sha", replace_once(source, '"${{ github.sha }}"', '"${{ github.ref }}"'), "authorized supervisor loader"),
        ("loader compile bypass", replace_once(source, 'exec(compile(source, namespace["__file__"], "exec"), namespace)', 'exec(source, namespace)'), "authorized supervisor loader"),
        ("missing resolve safe.directory", replace_once(source, '("/usr/bin/git", "-c", f"safe.directory={workspace}", "-C", workspace,\n               "rev-parse"', '("/usr/bin/git", "-C", workspace,\n               "rev-parse"'), "authorized supervisor loader"),
        ("containment commit path", replace_once(source, '"show", f"{commit}:scripts/verify-ubuntu-migration-role-containment"', '"show", "HEAD:scripts/verify-ubuntu-migration-role-containment"'), "authorized supervisor loader"),
        ("client commit path", replace_once(source, '"show", f"{commit}:scripts/verify-ubuntu-migration-role-client"', '"show", "HEAD:scripts/verify-ubuntu-migration-role-client"'), "authorized supervisor loader"),
        ("missing containment show safe.directory", replace_once(source, 'source = subprocess.run(\n              ("/usr/bin/git", "-c", f"safe.directory={workspace}", "-C", workspace,', 'source = subprocess.run(\n              ("/usr/bin/git", "-C", workspace,'), "authorized supervisor loader"),
        ("missing client show safe.directory", replace_once(source, 'client = subprocess.run(\n              ("/usr/bin/git", "-c", f"safe.directory={workspace}", "-C", workspace,', 'client = subprocess.run(\n              ("/usr/bin/git", "-C", workspace,'), "authorized supervisor loader"),
        ("workspace containment path execution", replace_once(source, 'source = subprocess.run(\n              ("/usr/bin/git", "-c", f"safe.directory={workspace}", "-C", workspace,\n               "show", f"{commit}:scripts/verify-ubuntu-migration-role-containment"),\n              cwd="/", env=git_environment, check=True, stdout=subprocess.PIPE,\n          ).stdout', 'source = open(os.path.join(workspace, "scripts/verify-ubuntu-migration-role-containment"), "rb").read()'), "authorized supervisor loader"),
        ("client publication follows symlinks", replace_once(source, "os.O_TRUNC | os.O_NOFOLLOW", "os.O_TRUNC"), "authorized supervisor loader"),
        ("client publication not fsynced", replace_once(source, "              os.fsync(descriptor)\n", ""), "authorized supervisor loader"),
        ("post-static injection", replace_once(source, "        run: /usr/bin/python3 scripts/verify-ubuntu-deployment\n", "        run: /usr/bin/python3 scripts/verify-ubuntu-deployment\n\n      - name: Post-static injection\n        run: /bin/true\n"), "step sequence"),
    ]
    duplicate_permissions = replace_once(source, "permissions:\n  contents: read", "permissions:\n  contents: read\n  contents: write")
    mutations.append(("duplicate mapping key", duplicate_permissions, "duplicate mapping key"))
    for label, mutation, expected in mutations:
        expect_rejected(validate_ubuntu_workflow, mutation, label, expected)


def verify_supervisor_mutations(
    supervisor: str,
    stage: str,
    phase: str,
    client: str,
    containment: str,
    helper: str,
    migration_wrapper: str,
    role_mode: str,
) -> None:
    terminal_return = (
        '    return emit_terminal_result(primary_error, cleanup_errors, nonce, result, final_evidence)')
    supervisor_mutations = [
        ("inventory omission", replace_once(supervisor, '    "nmcp.sysusers": ("infra/ubuntu/sysusers.d/nmcp.conf", "nmcp system user declaration", 0o400),\n', ""), "asset inventory"),
        ("inventory extra", replace_once(supervisor, "CURRENT_ASSETS = {\n", 'CURRENT_ASSETS = {\n    "extra": ("extra", "extra", 0o400),\n'), "asset inventory"),
