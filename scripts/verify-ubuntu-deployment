#!/usr/bin/env python3
"""Fail-closed static and parser checks for Ubuntu production assets."""

import ast
import os
import pathlib
import re
import shutil
import stat
import subprocess
import sys
import tempfile

try:
    import yaml
except ImportError:
    yaml = None


ROOT = pathlib.Path(__file__).resolve().parent.parent
UBUNTU = ROOT / "infra" / "ubuntu"


def require(condition: bool, message: str) -> None:
    if not condition:
        raise RuntimeError(message)


def run(command, **kwargs):
    print("+", " ".join(map(str, command)))
    return subprocess.run(command, check=True, text=True, **kwargs)


def text(path: pathlib.Path) -> str:
    return path.read_text(encoding="utf-8")


def require_default_run_context(mapping: dict, label: str) -> None:
    require(
        "shell" not in mapping and "working-directory" not in mapping,
        f"{label} must use the reviewed shell and working directory",
    )


def shell_commands(run_text: str) -> list[str]:
    logical = re.sub(r"\\\s*\n\s*", " ", run_text)
    return [
        " ".join(line.strip().split())
        for line in logical.splitlines()
        if line.strip() and not line.lstrip().startswith("#")
    ]


PHASES = (
    "fresh-current", "current-rerun", "hostile-libpq", "stale-compatibility",
    "migration-failure", "signal-int", "signal-term", "sigkill-recovery",
    "graph-verifier-failure", "upgrade-v18-v19", "unfinished-v18-rejection",
    "completed-v18-rejection", "writer-drain",
)

CURRENT_ASSETS = {
    "supervisor": ("scripts/verify-ubuntu-migration-role-supervisor", "trusted root supervisor", 0o500),
    "phase": ("scripts/verify-ubuntu-migration-role-compatibility", "compatibility phase entrypoint", 0o500),
    "runtime-helper": ("scripts/verify-installed-runtime-roles", "runtime boundary helper", 0o500),
    "verify-stage": ("scripts/verify-ubuntu-migration-role-stage", "closed snapshot verifier", 0o500),
    "role-mode": ("scripts/set-ubuntu-migration-role-mode", "migration role mode wrapper", 0o755),
    "migration-wrapper": ("scripts/run-ubuntu-migration-compatibility", "migration compatibility wrapper", 0o755),
    "runtime-roles.sql": ("infra/postgresql/runtime-roles.sql", "runtime role bootstrap SQL", 0o644),
    "verify-role-graph.sql": ("infra/postgresql/verify-runtime-role-graph.sql", "role graph verifier SQL", 0o644),
    "postgresql-roles.sql": ("infra/ubuntu/postgresql-roles.sql", "database bootstrap SQL", 0o644),
    "verify-runtime-roles.sql": ("infra/validation/verify-runtime-roles.sql", "independent runtime verifier SQL", 0o644),
    "nmcp.sysusers": ("infra/ubuntu/sysusers.d/nmcp.conf", "nmcp system user declaration", 0o400),
}

STAGE_ALLOWED = {
    "migration-wrapper": ("migration compatibility wrapper", 0o755),
    "nmcp-admin-current": ("candidate migration admin", 0o755),
    "nmcp-admin-v18": ("approved v18 migration admin", 0o755),
    "nmcp.sysusers": ("nmcp system user declaration", 0o400),
    "phase": ("compatibility phase entrypoint", 0o500),
    "postgresql-roles.sql": ("database bootstrap SQL", 0o644),
    "role-mode": ("migration role mode wrapper", 0o755),
    "runtime-helper": ("runtime boundary helper", 0o500),
    "runtime-roles.sql": ("runtime role bootstrap SQL", 0o644),
    "supervisor": ("trusted root supervisor", 0o500),
    "verify-role-graph.sql": ("role graph verifier SQL", 0o644),
    "verify-runtime-roles.sql": ("independent runtime verifier SQL", 0o644),
    "verify-stage": ("closed snapshot verifier", 0o500),
}

TRUST_STATEMENT = """Build, seal, execute, and remove migration-role compatibility evidence.

Independent review authorizes candidate bytes. Manifests and AST checks provide
regression/integrity evidence, never authentication. Without an externally
protected workflow they cannot defend against candidate/verifier collusion.
The hostile-root threat model is explicitly out of scope.
"""


def literal_assignment(tree: ast.Module, name: str):
    matches = [
        node for node in tree.body
        if isinstance(node, ast.Assign) and len(node.targets) == 1
        and isinstance(node.targets[0], ast.Name) and node.targets[0].id == name
    ]
    require(len(matches) == 1, f"supervisor must define {name} exactly once")
    try:
        return ast.literal_eval(matches[0].value)
    except (TypeError, ValueError) as error:
        raise RuntimeError(f"supervisor {name} must be a literal") from error


def named_function(tree: ast.Module, name: str) -> ast.FunctionDef:
    matches = [node for node in tree.body if isinstance(node, ast.FunctionDef) and node.name == name]
    require(len(matches) == 1, f"program must define {name} exactly once")
    return matches[0]


def require_exact_function(tree: ast.Module, name: str, expected: str, message: str) -> None:
    observed = named_function(tree, name)
    expected_node = named_function(ast.parse(expected), name)
    require(ast.dump(observed) == ast.dump(expected_node), message)


def validate_runtime_helper(source: str) -> None:
    require(source.startswith("#!/usr/bin/env bash\nset -euo pipefail\numask 0077\n"),
            "runtime helper preamble changed")
    require(
        source.count("[[ $# -eq 1 && $1 =~ ^[0-9]+$ ]]") == 1
        and source.count("sql_fd=$1") == 1
        and source.count("[[ -r /proc/self/fd/$sql_fd ]]") == 1,
        "runtime helper must accept and check exactly one SQL descriptor",
    )
    require(
        source.count("/usr/bin/psql") == 1
        and "exec /usr/bin/env -i PATH=/usr/bin:/bin LC_ALL=C HOME=/var/lib/postgresql" in source
        and "/usr/sbin/runuser -u postgres -- /usr/bin/psql --no-psqlrc" in source
        and "--host=/var/run/postgresql --port=5432 --username=postgres --dbname=nmcp" in source
        and "--set=ON_ERROR_STOP=1 <&\"$sql_fd\"" in source,
        "runtime helper must execute the SQL descriptor with fixed peer-authenticated psql arguments",
    )
    require("--file=" not in source and "repo" not in source.lower() and "/usr/bin/install" not in source,
            "runtime helper must not reopen or restage a path")


def validate_stage_verifier(source: str) -> None:
    tree = ast.parse(source, filename="verify-ubuntu-migration-role-stage")
    named_function(tree, "main")
    require(literal_assignment(tree, "ALLOWED") == STAGE_ALLOWED,
            "stage verifier explicit asset allowlist changed")
    required = (
        'os.open(root, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)',
        'os.open("manifest.json", os.O_RDONLY | os.O_NOFOLLOW, dir_fd=root_fd)',
        'actual = set(os.listdir(root_fd))',
        'expected = set(names) | {"manifest.json"}',
        'if actual != expected:',
        'if names != sorted(names) or len(names) != len(set(names)) or set(names) != set(ALLOWED):',
        'required = {"name", "purpose", "provenance_commit", "provenance_tree", "toolchain", "type", "uid", "gid", "mode", "size", "sha256"}',
        'purpose, mode = ALLOWED[item["name"]]',
        'if item["purpose"] != purpose or item["mode"] != mode or item["uid"] != 0 or item["gid"] != 0:',
        'if item["name"].startswith("nmcp-admin-"):',
        'elif item["toolchain"] is not None:',
        'os.open(item["name"], os.O_RDONLY | os.O_NOFOLLOW, dir_fd=root_fd)',
        'if observed != recorded:',
    )
    require(all(source.count(fragment) == 1 for fragment in required),
            "stage verifier manifest/inventory contract changed")


def compatibility_cases(source: str) -> tuple[str, ...]:
    match = re.search(r"(?ms)^case \$phase in\n(?P<body>.*)^  \*\)", source)
    require(match is not None, "compatibility phase dispatcher changed")
    return tuple(re.findall(r"(?m)^  ([a-z0-9-]+)\)$", match.group("body")))


def validate_compatibility_phase(source: str) -> None:
    require(compatibility_cases(source) == PHASES,
            "compatibility phase table must be the exact 13 ordered phases")
    require(source.count("case $phase in") == 1 and source.count("unknown compatibility phase") == 1,
            "compatibility phase dispatcher must fail closed")
    require("repo_root" not in source and "/usr/bin/git" not in source
            and "verify-installed-runtime-roles" not in source,
            "compatibility phases must not read repository or restage runtime boundary assets")
    phase_inputs = (
        'wrapper=${NMCP_WRAPPER:?missing staged wrapper descriptor}',
        'role_mode=${NMCP_ROLE_MODE:?missing staged role-mode descriptor}',
        'current=${NMCP_CURRENT_ADMIN:?missing staged current admin descriptor}',
        'v18=${NMCP_V18_ADMIN:?missing staged v18 admin descriptor}',
        'postgresql_roles=${NMCP_POSTGRESQL_ROLES:?missing staged PostgreSQL bootstrap descriptor}',
        'verify_role_graph=${NMCP_VERIFY_ROLE_GRAPH:?missing staged role graph descriptor}',
    )
    require(all(source.count(item) == 1 for item in phase_inputs),
            "compatibility phase descriptor environment changed")
    for evidence in ("assert_hardened", "assert_compatibility", "assert_migration",
                     "unfinished-v18-rejection", "completed-v18-rejection", "writer-drain"):
        require(evidence in source, f"compatibility phase evidence missing {evidence}")


def validate_supervisor(source: str) -> None:
    tree = ast.parse(source, filename="verify-ubuntu-migration-role-supervisor")
    require(ast.get_docstring(tree, clean=False) == TRUST_STATEMENT,
            "supervisor trust statement changed")
    require(literal_assignment(tree, "CURRENT_ASSETS") == CURRENT_ASSETS,
            "supervisor current asset inventory changed")
    require(literal_assignment(tree, "PHASES") == PHASES,
            "supervisor phase table must be the exact 13 ordered phases")
    require(literal_assignment(tree, "HISTORICAL") == "172583179d860619ae2c79505971e10ae7f394fc",
            "supervisor historical provenance changed")
    require(literal_assignment(tree, "INTENT_PATH") == "/run/nmcp-ci/cleanup-intent.json",
            "supervisor cleanup intent path changed")
    require(literal_assignment(tree, "TOP_ALLOWLISTS") == {
        "/usr/local/libexec/nmcp": {"postgresql", "set-ubuntu-migration-role-mode", "run-ubuntu-migration-compatibility", "verify-installed-runtime-roles"},
        "/var/lib/nmcp": {"deployment"},
        "/opt/nmcp-role-compatibility": {"current", "v18", "test-work"},
    }, "supervisor cleanup top-level allowlists changed")
    require_exact_function(tree, "git", '''def git(repo, *args, stdout=None):
    return subprocess.run(("/usr/bin/git", "-c", f"safe.directory={repo}", "-C", repo, *args), cwd="/", env=clean_env(),
                          check=True, stdout=stdout or subprocess.PIPE).stdout
''', "supervisor git must use command-scoped safe.directory")
    require_exact_function(tree, "archive_tree", '''def archive_tree(repo, commit, destination):
    resolved = git(repo, "rev-parse", "--verify", f"{commit}^{{commit}}").decode().strip()
    if resolved != commit:
        die(f"commit identity mismatch: {commit}")
    tree = git(repo, "rev-parse", "--verify", f"{commit}^{{tree}}").decode().strip()
    listing = git(repo, "ls-tree", "-r", "-z", commit).split(b"\\0")
    expected_files = {}
    for record in filter(None, listing):
        metadata, raw_name = record.split(b"\\t", 1)
        mode, kind, object_id = metadata.split(b" ")
        if kind != b"blob" or mode not in (b"100644", b"100755"):
            die(f"submodule or unexpected git mode in {commit}: {record!r}")
        try:
            name = raw_name.decode("utf-8")
        except UnicodeDecodeError as error:
            raise RuntimeError("non-UTF-8 archive name") from error
        expected_files[name] = (
            0o755 if mode == b"100755" else 0o644,
            object_id.decode("ascii"),
        )
    expected_directories = set()
    for name in expected_files:
        parent = os.path.dirname(name)
        while parent:
            expected_directories.add(parent)
            parent = os.path.dirname(parent)
    archive = git(repo, "archive", "--format=tar", commit)
    with tarfile.open(fileobj=io.BytesIO(archive), mode="r:") as source:
        seen_files = set()
        seen_directories = set()
        for member in source.getmembers():
            normalized = os.path.normpath(member.name)
            if normalized != member.name.rstrip("/") or normalized.startswith("../") or os.path.isabs(member.name):
                die("archive path escapes build tree")
            if member.isdir() and normalized in expected_directories:
                seen_directories.add(normalized)
                if member.mode not in (0o755, 0o775):
                    die(f"archive contains unexpected directory mode: {member.name}")
                member.mode = 0o755
            elif member.isreg() and normalized in expected_files:
                seen_files.add(normalized)
                expected_mode, _object_id = expected_files[normalized]
                if member.mode not in (expected_mode, expected_mode | 0o020):
                    die(f"archive contains unexpected file mode: {member.name}")
                member.mode = expected_mode
            else:
                die(f"archive contains nonregular member: {member.name}")
        if seen_files != set(expected_files) or seen_directories != expected_directories:
            die("archive inventory differs from the commit tree")
        source.extractall(destination, filter=lambda member, _path: member)
    for name, (expected_mode, object_id) in expected_files.items():
        path = os.path.join(destination, name)
        descriptor = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)
        try:
            metadata = os.fstat(descriptor)
            if (not stat.S_ISREG(metadata.st_mode) or metadata.st_nlink != 1
                    or stat.S_IMODE(metadata.st_mode) != expected_mode):
                die(f"unsafe extracted archive member: {name}")
            extracted = bytearray()
            while True:
                block = os.read(descriptor, 1024 * 1024)
                if not block:
                    break
                extracted.extend(block)
            after = os.fstat(descriptor)
            identity = lambda value: (
                value.st_dev, value.st_ino, value.st_mode, value.st_uid,
                value.st_gid, value.st_nlink, value.st_size,
                value.st_mtime_ns, value.st_ctime_ns,
            )
            if identity(after) != identity(metadata):
                die(f"archive member changed while verified: {name}")
        finally:
            os.close(descriptor)
        blob = git(repo, "cat-file", "blob", object_id)
        if extracted != blob:
            die(f"archive member differs from reviewed Git blob: {name}")
    return tree
''', "supervisor archive_tree blob binding/nofollow/metadata contract changed")
    require_exact_function(tree, "run_phase", '''def run_phase(argv, *, env, pass_fds):
    global ACTIVE_PHASE
    process = subprocess.Popen(argv, cwd="/", env=env, pass_fds=pass_fds,
                               start_new_session=True)
    ACTIVE_PHASE = process
    try:
        status = process.wait()
        if status:
            raise subprocess.CalledProcessError(status, argv)
    finally:
        if process.poll() is not None:
            ACTIVE_PHASE = None
''', "supervisor run_phase process/session/wait contract changed")
    main_node = named_function(tree, "main")
    loops = [
        node for node in ast.walk(main_node)
        if isinstance(node, ast.For) and isinstance(node.target, ast.Name)
        and node.target.id == "phase" and isinstance(node.iter, ast.Name) and node.iter.id == "PHASES"
    ]
    require(len(loops) == 1, "supervisor must execute the fixed phase table exactly once")
    phase_calls = [
        node for node in ast.walk(loops[0])
        if isinstance(node, ast.Expr) and isinstance(node.value, ast.Call)
        and isinstance(node.value.func, ast.Name) and node.value.func.id == "run_phase"
    ]
    expected_phase_call = ast.parse('''run_phase(("/bin/bash", "--noprofile", "--norc", f"/proc/self/fd/{phase_fd}", phase),
          env=phase_env, pass_fds=(phase_fd, *phase_inputs.values()))
''').body[0]
    require(len(phase_calls) == 1 and ast.dump(phase_calls[0]) == ast.dump(expected_phase_call),
            "supervisor run_phase invocation changed")
    loop_source = ast.get_source_segment(source, loops[0]) or ""
    for fragment in (
        'trace.append(f"phase-start:{phase}")',
        'trace.append(f"phase-success:{phase}")',
        'trace.append(f"boundary-start:{phase}")',
        'phase_fd = open_verified(snapshot_fd, manifest, "phase")',
        'phase_inputs = {}',
        '("NMCP_WRAPPER", "migration-wrapper")',
        '("NMCP_ROLE_MODE", "role-mode")',
        '("NMCP_CURRENT_ADMIN", "nmcp-admin-current")',
        '("NMCP_V18_ADMIN", "nmcp-admin-v18")',
        '("NMCP_POSTGRESQL_ROLES", "postgresql-roles.sql")',
        '("NMCP_RUNTIME_ROLES", "runtime-roles.sql")',
        '("NMCP_VERIFY_ROLE_GRAPH", "verify-role-graph.sql")',
        'installed_fd = os.open(installs[name], os.O_RDONLY | os.O_NOFOLLOW)',
        'die(f"installed phase asset mismatch: {name}")',
        'phase_env[variable] = f"/proc/self/fd/{installed_fd}"',
        'run_phase(("/bin/bash", "--noprofile", "--norc", f"/proc/self/fd/{phase_fd}", phase)',
        'env=phase_env, pass_fds=(phase_fd, *phase_inputs.values())',
        'phase_env.pop(variable, None)',
        'staged_helper = open_verified(snapshot_fd, manifest, "runtime-helper")',
        'staged_sql = open_verified(snapshot_fd, manifest, "verify-runtime-roles.sql")',
        'installed_helper = os.open(installs["runtime-helper"], os.O_RDONLY | os.O_NOFOLLOW)',
        'installed_sql = os.open(installs["verify-runtime-roles.sql"], os.O_RDONLY | os.O_NOFOLLOW)',
        '("/bin/bash", "--noprofile", "--norc", f"/proc/self/fd/{installed_helper}", str(installed_sql))',
        'pass_fds=(installed_helper, installed_sql, staged_helper, staged_sql)',
        'trace.append(f"boundary-success:{phase}")',
    ):
        require(loop_source.count(fragment) == 1, "supervisor phase descriptor/trace contract changed")
    trace_events = re.findall(r'trace\.append\(f"([a-z-]+):\{phase\}"\)', loop_source)
    require(trace_events == ["phase-start", "phase-success", "boundary-start", "boundary-success"],
            "supervisor phase and boundary trace order changed")
    require(not re.search(r"\b(?:git|archive_tree|copy_regular|current_source|historical_source|repo)\b", loop_source),
            "supervisor must not read repository or restage paths during phases")
    require(
        'expected = [entry for phase in PHASES for entry in (f"phase-start:{phase}", f"phase-success:{phase}", f"boundary-start:{phase}", f"boundary-success:{phase}")]' in source
        and 'if trace != expected:' in source,
        "supervisor final trace must derive from the fixed phase table",
    )
    require(
        'run(("/usr/bin/python3", "-I", "-S", f"/proc/self/fd/{verifier_fd}", snapshot), pass_fds=(verifier_fd,))' in source,
        "supervisor stage verifier invocation must be descriptor-bound",
    )
    hardening_fragments = (
        'lock_fd = os.open("/run/nmcp-ci/transaction.lock", os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW, 0o600)',
        'if (not stat.S_ISREG(lock_stat.st_mode) or lock_stat.st_uid != 0\n'
        '            or lock_stat.st_gid != 0 or lock_stat.st_nlink != 1\n'
        '            or stat.S_IMODE(lock_stat.st_mode) != 0o600):',
        'for path, mode in (("/usr/local/libexec/nmcp", 0o755), ("/var/lib/nmcp", 0o700),\n'
        '                           ("/opt/nmcp-role-compatibility", 0o755)):\n'
        '            entry = create_owned_top(path, mode, intents, TOP_ALLOWLISTS[path])',
        'for path in ("/usr/local/libexec/nmcp", "/opt/nmcp-role-compatibility",\n'
        '                     "/opt/nmcp-role-compatibility/current", "/opt/nmcp-role-compatibility/v18"):\n'
        '            os.chmod(path, 0o755)',
        'fsync_directory(snapshot_build)\n        os.rename(snapshot_build, snapshot)\n'
        '        fsync_directory(run_root)\n        snapshot_fd = os.open(snapshot, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)',
        'if ACTIVE_PHASE is not None and ACTIVE_PHASE.poll() is None:',
        'os.killpg(ACTIVE_PHASE.pid, signal.SIGTERM)',
        'os.killpg(ACTIVE_PHASE.pid, signal.SIGKILL)',
        'pass_fds=(lock_fd,), start_new_session=True',
        'recover_intents()\n    intents = []',
    )
    require(all(source.count(fragment) == 1 for fragment in hardening_fragments),
            "supervisor lock/snapshot/traversal/signal cleanup contract changed")
    manifest_fragments = (
        'records.append({"name": name, "purpose": purpose, "provenance_commit": current_commit,',
        '"provenance_tree": current_tree, "type": "regular", "uid": 0, "gid": 0,',
        '"mode": mode, "size": size, "sha256": digest, "toolchain": None})',
        'records.append({"name": name, "purpose": purpose, "provenance_commit": commit,',
        '"provenance_tree": tree, "type": "regular", "uid": 0, "gid": 0,',
        '"mode": 0o755, "size": size, "sha256": digest, "toolchain": toolchain})',
    )
    require(all(source.count(fragment) == 1 for fragment in manifest_fragments),
            "supervisor manifest inventory/purpose/mode/toolchain schema changed")
    require("__file__" not in source,
            "supervisor must rely on authorized loader bytes, not an __file__ path comparison")

    intent_contract = (
        'descriptor = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)',
        'os.fsync(descriptor)',
        'os.replace(temporary, INTENT_PATH)',
        'fsync_directory("/run/nmcp-ci")',
        'descriptor = os.open(INTENT_PATH, os.O_RDONLY | os.O_NOFOLLOW)',
        '"parent_identity", "absence_policy", "expected_metadata", "identity", "allowlist"',
        'entry["absence_policy"] != "must-be-absent"',
        'parent_fd = os.open(parent, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)',
        'metadata(os.fstat(parent_fd)) != entry["parent_identity"]',
        'os.stat(os.path.basename(path), dir_fd=parent_fd, follow_symlinks=False)',
        'expected is not None and metadata(top) != expected',
        'remove_tree_fd(parent_fd, os.path.basename(path), entry["allowlist"])',
        'descriptor = os.open(name, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=parent_fd)',
        'if allowed is not None and not names <= set(allowed):',
        'old_mask = signal.pthread_sigmask(signal.SIG_BLOCK, {signal.SIGINT, signal.SIGTERM, signal.SIGHUP, signal.SIGQUIT})',
        'if os.path.lexists(path):',
        '"parent_identity": metadata(os.fstat(parent_fd))',
        '"absence_policy": "must-be-absent"',
        'entries.append(entry)\n        durable_intents(entries)\n        fault(f"{fault_name or path}:after-intent")',
        'os.mkdir(name, mode, dir_fd=parent_fd)',
        'os.fsync(parent_fd)\n        fault(f"{fault_name or path}:after-mkdir")',
        'top_fd = os.open(name, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=parent_fd)',
        'entry["identity"] = metadata(top)\n            durable_intents(entries)',
        'signal.pthread_sigmask(signal.SIG_SETMASK, old_mask)',
    )
    require(all(fragment in source for fragment in intent_contract)
            and source.count('fsync_directory("/run/nmcp-ci")') == 2,
            "supervisor durable intent/bounded cleanup contract changed")
    cleanup_contract = (
        'cleanup_errors = []',
        '("drop database", ("/usr/sbin/runuser", "-u", "postgres", "--", "/usr/bin/dropdb", "--if-exists", "nmcp"))',
        '("drop roles", ("/usr/sbin/runuser", "-u", "postgres", "--", "/usr/bin/psql", "--no-psqlrc"',
        'result = subprocess.run(arguments, cwd="/", env=clean_env(), stdout=subprocess.PIPE,',
        'if result.returncode:',
        'cleanup_errors.append(RuntimeError(',
        'cleanup_errors.append(RuntimeError(f"{label} could not run: {error}"))',
        'if cleanup_errors:\n            raise RuntimeError("cleanup failed: " + "; ".join(map(str, cleanup_errors)))',
        'if retained_process is not None:\n        die("retained cleanup dependency unexpectedly permitted cleanup")',
        'print("Ubuntu migration role compatibility verification passed", flush=True)',
    )
    require(all(fragment in source for fragment in cleanup_contract),
            "supervisor independent cleanup/result aggregation contract changed")
    cleanup_assignments = [
        node for node in ast.walk(main_node)
        if isinstance(node, ast.Assign) and len(node.targets) == 1
        and isinstance(node.targets[0], ast.Name) and node.targets[0].id == "cleanup_commands"
    ]
    expected_cleanup_assignment = ast.parse('''cleanup_commands = () if FAULT_MODE in ("fast-success", "fast-fail", "fast-hold") else (
    ("drop database", ("/usr/sbin/runuser", "-u", "postgres", "--", "/usr/bin/dropdb", "--if-exists", "nmcp")),
    ("drop roles", ("/usr/sbin/runuser", "-u", "postgres", "--", "/usr/bin/psql", "--no-psqlrc",
                    "--dbname=postgres", "--set=ON_ERROR_STOP=1", "--command",
                    "DROP ROLE IF EXISTS nmcp_graph_probe,nmcp_graph_bridge,nmcp_api,nmcp_worker,nmcp_migrator,nmcp_runtime,nmcp_worker_runtime,nmcp_purge_function_owner,nmcp_check_runtime,nmcp_repair_runtime,nmcp_check_function_owner,nmcp_repair_function_owner")),
)
''').body[0]
    require(len(cleanup_assignments) == 1
            and ast.dump(cleanup_assignments[0]) == ast.dump(expected_cleanup_assignment),
            "supervisor only exact fast modes may skip the fixed database cleanup commands")
    cleanup_loops = [
        node for node in ast.walk(main_node)
        if isinstance(node, ast.For)
        and ast.dump(node.target) == ast.dump(
            ast.parse("for label, arguments in cleanup_commands:\n    pass").body[0].target)
        and isinstance(node.iter, ast.Name) and node.iter.id == "cleanup_commands"
    ]
    require(len(cleanup_loops) == 1,
            "supervisor must execute the selected cleanup command tuple exactly once")
    cleanup_loop_source = ast.get_source_segment(source, cleanup_loops[0]) or ""
    checked_cleanup_fragments = {
        'result = subprocess.run(arguments, cwd="/", env=clean_env(), stdout=subprocess.PIPE,': 1,
        'if result.returncode:': 1,
        'cleanup_errors.append(RuntimeError(': 2,
        'cleanup_errors.append(RuntimeError(f"{label} could not run: {error}"))': 1,
    }
    require(all(cleanup_loop_source.count(fragment) == count
                for fragment, count in checked_cleanup_fragments.items()),
            "supervisor normal database cleanup commands must remain independently checked")
    require(source.index('print("Ubuntu migration role compatibility verification passed", flush=True)')
            > source.index('if cleanup_errors:'),
            "supervisor success marker must follow successful cleanup")
    require(source.count('print("Ubuntu migration role compatibility verification passed", flush=True)') == 2
            and 'if fast_success:\n            print("Ubuntu migration role compatibility verification passed", flush=True)' in source,
            "supervisor fast and full success markers changed")
    nonce_contract = (
        'if os.geteuid() != 0 or len(sys.argv) not in (5, 6):',
        'die("usage: supervisor REPOSITORY CURRENT_COMMIT ABSOLUTE_GO NONCE [FAULT_POINT]")',
        'nonce = sys.argv[4]',
        'if (len(nonce) != 64 or any(character not in "0123456789abcdef" for character in nonce)',
        'or os.environ.get("NMCP_VERIFIER_NONCE") != nonce):',
        'die("supervisor launch nonce does not match its environment")',
        'FAULT_MODE = sys.argv[5] if len(sys.argv) == 6 else ""',
    )
    require(all(source.count(fragment) == 1 for fragment in nonce_contract),
            "supervisor nonce argv/environment validation changed")


def validate_client(source: str) -> None:
    tree = ast.parse(source, filename="verify-ubuntu-migration-role-client")
    require(literal_assignment(tree, "UNIT") == "nmcp-migration-role-verifier.service",
            "client fixed transient service unit name changed")
    require(literal_assignment(tree, "NONCE_VARIABLE") == "NMCP_VERIFIER_NONCE"
            and literal_assignment(tree, "DESCRIPTION_PREFIX") == "NMCP migration role verifier ",
            "client nonce launch labels changed")
    require(literal_assignment(tree, "SERVICE_PROPERTIES") == {
        "Type": "exec", "KillMode": "control-group", "SendSIGKILL": "yes",
        "TimeoutStopUSec": "15s", "RuntimeMaxUSec": "15min", "Delegate": "no",
        "RemainAfterExit": "yes", "User": "root", "Group": "root", "UMask": "0077",
        "WorkingDirectory": "/", "StandardOutput": "journal", "StandardError": "journal",
    }, "client immutable service property table changed")
    require(literal_assignment(tree, "CLIENT_FAULTS") == {
        "client-fault-after-launch", "client-fault-after-invocation",
        "client-fault-after-properties", "client-fault-at-terminal",
        "client-fault-after-journal", "client-fault-missing-invocation",
        "client-property-fault-immediate", "client-property-fault-recovery",
        "client-property-fault-owned",
    }, "client exact fault boundary table changed")
    require(literal_assignment(tree, "PROPERTY_RETRIES") == 4
            and literal_assignment(tree, "PROPERTY_RETRY_BUDGET") == 3.0,
            "client property retry bounds changed")
    cancellation_assignments = [
        node for node in tree.body if isinstance(node, ast.Assign)
        and len(node.targets) == 1 and isinstance(node.targets[0], ast.Name)
        and node.targets[0].id == "CANCELLATION_SIGNALS"
    ]
    expected_cancellation = ast.parse(
        "CANCELLATION_SIGNALS = {signal.SIGINT, signal.SIGTERM, signal.SIGHUP, signal.SIGQUIT}"
    ).body[0]
    require(len(cancellation_assignments) == 1
            and ast.dump(cancellation_assignments[0]) == ast.dump(expected_cancellation),
            "client cancellation signal set must be exactly INT TERM HUP QUIT")
    require('PROGRAM = RUN + "/supervisor.py"' in source,
            "client published supervisor path changed")
    require_exact_function(tree, "interrupted", '''def interrupted(signum, _frame):
    CANCELLED.append(signum)
''', "client signal handler must only latch cancellation")
    require_exact_function(tree, "exec_start_argv", '''def exec_start_argv(value):
    marker = "argv[]="
    start = value.find(marker)
    end = value.find(" ;", start)
    if start < 0 or end < 0:
        return None
    try:
        return tuple(shlex.split(value[start + len(marker):end]))
    except ValueError:
        return None
''', "client ExecStart argv parser changed")
    require_exact_function(tree, "launch_matches", '''def launch_matches(state, nonce, service_command):
    if state.get("Description") != DESCRIPTION_PREFIX + nonce:
        return False
    if state.get("Environment") != f"{NONCE_VARIABLE}={nonce}":
        return False
    if exec_start_argv(state.get("ExecStart", "")) != service_command:
        return False
    return all(state.get(name) == expected for name, expected in SERVICE_PROPERTIES.items())
''', "client full nonce/argv/property launch identity changed")
    require_exact_function(tree, "bounded_deadline", '''def bounded_deadline(seconds):
    deadline = time.monotonic() + seconds
    return min(deadline, COMMAND_DEADLINE) if COMMAND_DEADLINE is not None else deadline
''', "client deadlines must remain subordinate to its absolute budget")
    require_exact_function(tree, "command", '''def command(argv, *, check=True, stdout=subprocess.PIPE, timeout=30):
    if COMMAND_DEADLINE is not None:
        remaining = COMMAND_DEADLINE - time.monotonic()
        if remaining <= 0:
            fail("absolute client command budget exhausted")
        timeout = min(timeout, remaining)
    return subprocess.run(argv, cwd="/", env=ENVIRONMENT,
                          check=check, stdout=stdout, stderr=subprocess.PIPE, text=True,
                          timeout=timeout)
''', "client subprocesses must remain bounded by the absolute budget")
    require_exact_function(tree, "unit_properties", '''def unit_properties(*names, context="show"):
    requested = tuple(dict.fromkeys(("LoadState", *names)))
    deadline = bounded_deadline(PROPERTY_RETRY_BUDGET)
    errors = []
    for attempt in range(PROPERTY_RETRIES):
        try:
            command_path(context)
            result = command(("/usr/bin/systemctl", "show", UNIT,
                              *(f"--property={name}" for name in requested)), check=False,
                             timeout=max(0.05, deadline - time.monotonic()))
            if result.returncode:
                fail(f"systemctl show failed ({result.returncode}): {result.stderr.strip()}")
            if not result.stdout:
                fail("systemctl show returned empty output")
            values = {}
            for line in result.stdout.splitlines():
                key, separator, value = line.partition("=")
                if not separator or not key or key in values:
                    fail(f"systemctl show returned malformed output: {line!r}")
                values[key] = value
            missing = [name for name in requested if name not in values]
            if missing:
                fail(f"systemctl show omitted required properties: {', '.join(missing)}")
            if errors:
                RECOVERED_ERRORS.extend(errors)
            return values
        except (OSError, subprocess.SubprocessError, RuntimeError) as error:
            errors.append(error)
            if attempt + 1 >= PROPERTY_RETRIES or time.monotonic() >= deadline:
                break
            time.sleep(min(0.05 * (2 ** attempt), max(0, deadline - time.monotonic())))
    fail("unit properties remain unknown: " + "; ".join(map(str, errors)))
''', "client property reads must fail closed with bounded retry and retained errors")
    require("if not values" not in source and "return {\"LoadState\": \"not-found\"" not in source,
            "client must not infer absence from an empty or failed property query")
    require_exact_function(tree, "launch_state", '''def launch_state(*, context="show"):
    return unit_properties("LoadState", "InvocationID", "ActiveState", "SubState", "ControlGroup",
                           "Description", "Environment", "ExecStart", *SERVICE_PROPERTIES,
                           context=context)
''', "client launch identity observation changed")
    require_exact_function(tree, "owned_state", '''def owned_state(invocation, nonce, service_command, *properties, context="owned-state"):
    state = unit_properties("LoadState", "InvocationID", "ActiveState", "SubState",
                            "ControlGroup", "Description", "Environment", "ExecStart",
                            *SERVICE_PROPERTIES, *properties, context=context)
    if state.get("LoadState") == "not-found":
        return state
    if not launch_matches(state, nonce, service_command):
        fail(f"fixed unit launch identity lost; refusing name-based cleanup: {state}")
    if state.get("InvocationID") != invocation:
        fail(f"fixed unit ownership lost; refusing name-based cleanup: {state}")
    return state
''', "client owned state must bind launch identity and InvocationID")
    require_exact_function(tree, "owned_command", '''def owned_command(invocation, nonce, service_command, *arguments):
    state = owned_state(invocation, nonce, service_command)
    if state.get("LoadState") == "not-found":
        return False
    command_path("reset" if arguments[0] == "reset-failed" else arguments[0])
    result = command(("/usr/bin/systemctl", *arguments, UNIT), check=False)
    if result.returncode:
        fail(f"owned unit command failed ({' '.join(arguments)}): {result.stderr.strip()}")
    return True
''', "client must revalidate exact ownership immediately before name-based commands")
    require_exact_function(tree, "durable_marker", '''def durable_marker(name):
    path = f"{RUN}/{name}"
    descriptor = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
    try:
        os.write(descriptor, b"ready\\n")
        os.fsync(descriptor)
    finally:
        os.close(descriptor)
    directory = os.open(RUN, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    try:
        os.fsync(directory)
    finally:
        os.close(directory)
''', "client attempting/acquired markers must be durably fsynced")
    require_exact_function(tree, "valid_invocation", '''def valid_invocation(value):
    return len(value) == 32 and all(character in "0123456789abcdef" for character in value)
''', "client exact InvocationID validator changed")
    contract = (
        '"GIT_NO_REPLACE_OBJECTS": "1", "GIT_CONFIG_NOSYSTEM": "1"',
        '"GIT_CONFIG_GLOBAL": "/dev/null"', 'env=ENVIRONMENT',
        '"rev-parse", "--verify", f"{commit}^{{commit}}"',
        'if resolved != commit:',
        '"show", f"{commit}:scripts/verify-ubuntu-migration-role-supervisor"',
        'os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o500)',
        'os.fsync(descriptor)', 'os.replace(temporary, PROGRAM)', 'os.fsync(directory)',
        'nonce = secrets.token_hex(32)',
        'supervisor_argv = ("/usr/bin/python3", "-I", "-S", PROGRAM,',
        'repo, commit, go_binary, nonce) + ((supervisor_mode,) if supervisor_mode else ())',
        'exec_argv = ("/usr/bin/env", "-i", "PATH=/usr/bin:/bin:/usr/sbin:/sbin", "LC_ALL=C", "LANG=C",',
        '"HOME=/root", f"{NONCE_VARIABLE}={nonce}", *supervisor_argv)',
        '"/usr/bin/systemd-run", "--quiet", f"--unit={UNIT}", "--service-type=exec"',
        'f"--description={DESCRIPTION_PREFIX}{nonce}"',
        'f"--property=Environment={NONCE_VARIABLE}={nonce}"',
        '"--property=KillMode=control-group", "--property=SendSIGKILL=yes"',
        '"--property=TimeoutStopSec=15s", "--property=RuntimeMaxSec=15min"',
        '"--property=Delegate=no", "--property=RemainAfterExit=yes"',
        '"--property=User=root", "--property=Group=root"',
        '"--property=UMask=0077", "--property=WorkingDirectory=/"',
        '"--property=StandardOutput=journal", "--property=StandardError=journal"',
        '*exec_argv,',
        'if valid_invocation(candidate_invocation) and launch_matches(observed, nonce, exec_argv):',
        'fail(f"missing exact invocation identity: {observed}")',
        'current = owned_state(invocation, nonce, exec_argv,',
        'current.get("Result") == "success" and current.get("ExecMainCode") == "exited"',
        'f"_SYSTEMD_INVOCATION_ID={invocation}"',
        'journal.count("Ubuntu migration role compatibility verification passed") != 1',
        'teardown_owned(invocation, nonce, exec_argv)',
        'if cgroup_pids(current.get("ControlGroup", "")):',
        'for signum in CANCELLATION_SIGNALS:',
        'signal.signal(signum, interrupted)',
        'previous_mask = signal.pthread_sigmask(signal.SIG_BLOCK, CANCELLATION_SIGNALS)',
        'signal.pthread_sigmask(signal.SIG_SETMASK, previous_mask)',
        'launch_attempted = False',
        'launch_attempted = True',
        'COMMAND_DEADLINE = time.monotonic() + 17 * 60',
        'discovered = launch_state(context="recovery")',
        'except BaseException as error:\n            primary_error = error',
        'f"launched unit has no safe nonce-bound identity: {discovered}"',
        'cleanup_errors.append(error)',
        'raise RuntimeError(f"{primary_error}; cleanup failed: {detail}") from primary_error',
        'client_pause("client-terminal-race-a-unloaded")',
        'Hostile root is explicitly outside this verifier\'s threat model.',
    )
    require(all(fragment in source for fragment in contract),
            "client fixed transient service/attestation/owned cleanup contract changed")

    main_node = named_function(tree, "main")
    parents = {}
    for parent in ast.walk(main_node):
        for child in ast.iter_child_nodes(parent):
            parents[child] = parent
    routing_starts = [
        index for index, node in enumerate(main_node.body)
        if isinstance(node, ast.Assign) and len(node.targets) == 1
        and isinstance(node.targets[0], ast.Name) and node.targets[0].id == "supervisor_mode"
        and isinstance(node.value, ast.Name) and node.value.id == "requested_mode"
    ]
    expected_routing = ast.parse('''supervisor_mode = requested_mode
if requested_mode in CLIENT_FAULTS:
    supervisor_mode = "fast-fail"
elif requested_mode == "client-terminal-race-a":
    supervisor_mode = ""
elif (requested_mode.startswith("client-cleanup-fault-")
      or requested_mode.startswith("client-cleanup-persistent-")
      or requested_mode.startswith("client-signal-")):
    boundary = requested_mode.rsplit("-", 1)[1]
    if boundary in ("kill", "wait"):
        supervisor_mode = "fast-hold"
    elif boundary == "stop":
        supervisor_mode = "fast-success"
    else:
        supervisor_mode = "fast-fail"
elif requested_mode in ("client-terminal-race-b", "client-reuse-pause"):
    supervisor_mode = "run-root:after-intent"
''').body
    require(len(routing_starts) == 1
            and [ast.dump(node) for node in main_node.body[routing_starts[0]:routing_starts[0] + 2]]
            == [ast.dump(node) for node in expected_routing],
            "client mode routing must reserve full cleanup for terminal-race-a and fast modes for hook tests")
    lock_calls = [
        node for node in ast.walk(main_node)
        if isinstance(node, ast.Call) and isinstance(node.func, ast.Attribute)
        and isinstance(node.func.value, ast.Name) and node.func.value.id == "fcntl"
        and node.func.attr == "flock"
    ]
    require(len(lock_calls) == 1, "client must acquire client.lock exactly once")
    lock_try = parents.get(lock_calls[0])
    while lock_try is not None and not isinstance(lock_try, ast.Try):
        lock_try = parents.get(lock_try)
    expected_close = ast.parse("os.close(client_lock)").body[0]
    require(isinstance(lock_try, ast.Try) and len(lock_try.finalbody) == 1
            and ast.dump(lock_try.finalbody[0]) == ast.dump(expected_close),
            "client.lock must encompass the complete transaction through owned unload")
    lock_source = ast.get_source_segment(source, lock_try) or ""
    ordered_lock_fragments = (
        'durable_marker("client-terminal-race-b.attempting")',
        "fcntl.flock(client_lock, fcntl.LOCK_EX)",
        "COMMAND_DEADLINE = time.monotonic() + 17 * 60",
        'durable_marker("client-terminal-race-b.acquired")',
        "nonce = secrets.token_hex(32)",
        "publish_supervisor(repo, commit)",
        "launch_attempted = True",
        "launched = command(service_argv, check=False)",
        'owned_state(invocation, nonce, exec_argv)',
        'current = owned_state(invocation, nonce, exec_argv,',
        'f"_SYSTEMD_INVOCATION_ID={invocation}"',
        'if cgroup_pids(current.get("ControlGroup", "")):',
        "teardown_owned(invocation, nonce, exec_argv)",
        "raise primary_error",
        'client_pause("client-terminal-race-a-unloaded")',
        "return result",
        "os.close(client_lock)",
    )
    positions = [lock_source.find(fragment) for fragment in ordered_lock_fragments]
    require(all(position >= 0 for position in positions)
            and positions == sorted(positions),
            "client.lock lifecycle ordering no longer covers reap through confirmed unload")
    require(lock_source.count('durable_marker("client-terminal-race-b.started")') == 1
            and lock_source.index('durable_marker("client-terminal-race-b.started")')
            > lock_source.index("launched = command(service_argv, check=False)"),
            "client B started marker must follow its distinct service launch")
    prelaunch_starts = [
        index for index, node in enumerate(lock_try.body)
        if isinstance(node, ast.Assign) and len(node.targets) == 1
        and isinstance(node.targets[0], ast.Name) and node.targets[0].id == "before"
    ]
    expected_prelaunch = ast.parse('''before = unit_properties("LoadState", "InvocationID", "ActiveState", "SubState", "ControlGroup",
                         context="prelaunch")
if before.get("LoadState") != "not-found":
    fail(f"fixed verification unit is not explicitly absent: {before}")
occupants = cgroup_pids(before.get("ControlGroup", ""))
if occupants:
    fail(f"verification unit control group is not empty: {occupants}")
''').body
    require(len(prelaunch_starts) == 1
            and [ast.dump(node) for node in lock_try.body[prelaunch_starts[0]:prelaunch_starts[0] + 4]]
            == [ast.dump(node) for node in expected_prelaunch],
            "client prelaunch must reject every state except explicit not-found in live lock-held flow")
    require(source.count("secrets.token_hex(32)") == 1,
            "client must generate exactly one cryptographic 64-hex nonce")

    launch_assignments = [
        node for node in ast.walk(main_node)
        if isinstance(node, ast.Assign) and any(
            isinstance(target, ast.Name) and target.id == "launched" for target in node.targets
        )
    ]
    require(len(launch_assignments) == 1, "client must launch the fixed unit exactly once")
    launch_tries = [
        node for node in lock_try.body
        if isinstance(node, ast.Try) and launch_assignments[0] in ast.walk(node)
    ]
    require(len(launch_tries) == 1, "client needs one encompassing post-launch try/finally")
    launch_try = launch_tries[0]
    signal_tries = [
        node for node in launch_try.body
        if isinstance(node, ast.Try) and launch_assignments[0] in ast.walk(node)
    ]
    require(len(signal_tries) == 1,
            "client systemd-run and immediate InvocationID capture must share one signal-masked try")
    signal_try = signal_tries[0]
    require(parents.get(launch_try) is lock_try and parents.get(signal_try) is launch_try,
            "client systemd-run return and all post-launch checks need one encompassing try/finally")
    expected_masked_launch = ast.parse('''previous_mask = signal.pthread_sigmask(signal.SIG_BLOCK, CANCELLATION_SIGNALS)
try:
    launch_attempted = True
    launched = command(service_argv, check=False)
    capture_error = None
    try:
        observed = launch_state(context="immediate")
    except BaseException as error:
        capture_error = error
        observed = {}
    candidate_invocation = observed.get("InvocationID", "")
    if requested_mode in ("client-fault-missing-invocation",
                          "client-property-fault-recovery"):
        candidate_invocation = ""
    if valid_invocation(candidate_invocation) and launch_matches(observed, nonce, exec_argv):
        invocation = candidate_invocation
finally:
    signal.pthread_sigmask(signal.SIG_SETMASK, previous_mask)
''').body
    require([ast.dump(node) for node in launch_try.body[:2]]
            == [ast.dump(node) for node in expected_masked_launch],
            "client launch attempt, systemd-run, and immediate InvocationID capture must stay signal-masked")
    expected_launch_failures = ast.parse('''if launched.returncode:
    fail(f"fixed unit launch failed: {launched.stderr.strip()}")
if capture_error is not None:
    raise capture_error
if invocation is None:
    fail(f"missing exact invocation identity: {observed}")
''').body
    require([ast.dump(node) for node in launch_try.body[2:4] + launch_try.body[5:6]]
            == [ast.dump(node) for node in expected_launch_failures],
            "client nonzero launch and missing InvocationID must fail into owned recovery")
    expected_handler = ast.parse('''try:
    pass
except BaseException as error:
    primary_error = error
''').body[0].handlers[0]
    expected_finally = ast.parse('''try:
    pass
finally:
    previous_mask = signal.pthread_sigmask(signal.SIG_BLOCK, CANCELLATION_SIGNALS)
    try:
        if launch_attempted and invocation is None:
            try:
                discovered = launch_state(context="recovery")
                candidate_invocation = discovered.get("InvocationID", "")
                if discovered.get("LoadState") == "not-found":
                    pass
                elif (valid_invocation(candidate_invocation)
                      and launch_matches(discovered, nonce, exec_argv)):
                    invocation = candidate_invocation
                    teardown_owned(invocation, nonce, exec_argv)
                else:
                    cleanup_errors.append(RuntimeError(
                        f"launched unit has no safe nonce-bound identity: {discovered}"))
            except BaseException as error:
                cleanup_errors.append(error)
        elif launch_attempted:
            try:
                teardown_owned(invocation, nonce, exec_argv)
            except BaseException as error:
                cleanup_errors.append(error)
    finally:
        signal.pthread_sigmask(signal.SIG_SETMASK, previous_mask)
    if CANCELLED:
        cancellation = RuntimeError(f"verification client cancelled by signal {CANCELLED[0]}")
        if primary_error is None:
            primary_error = cancellation
        elif str(cancellation) not in str(primary_error):
            cleanup_errors.append(cancellation)
    if RECOVERED_ERRORS:
        cleanup_errors.extend(RECOVERED_ERRORS)
''').body[0].finalbody
    require(len(launch_try.handlers) == 1
            and ast.dump(launch_try.handlers[0]) == ast.dump(expected_handler)
            and [ast.dump(node) for node in launch_try.finalbody]
            == [ast.dump(node) for node in expected_finally],
            "client post-launch failures must aggregate owned teardown errors")
    expected_outcome = ast.parse('''if cleanup_errors:
    detail = "; ".join(map(str, cleanup_errors))
    if primary_error is not None:
        raise RuntimeError(f"{primary_error}; cleanup failed: {detail}") from primary_error
    fail(f"cleanup failed: {detail}")
if primary_error is not None:
    raise primary_error
if requested_mode == "client-terminal-race-a":
    client_pause("client-terminal-race-a-unloaded")
return result
''').body
    launch_index = lock_try.body.index(launch_try)
    require([ast.dump(node) for node in lock_try.body[launch_index + 1:]]
            == [ast.dump(node) for node in expected_outcome],
            "client must immediately resolve primary/cleanup errors after the inner finally")

    invocation_assignments = [
        node for node in ast.walk(main_node)
        if isinstance(node, ast.Assign) and len(node.targets) == 1
        and isinstance(node.targets[0], ast.Name) and node.targets[0].id == "invocation"
    ]
    null_assignments = [
        node for node in invocation_assignments
        if isinstance(node.value, ast.Constant) and node.value.value is None
    ]
    validated_assignments = [node for node in invocation_assignments if node not in null_assignments]
    expected_validations = {
        ast.dump(ast.parse("valid_invocation(candidate_invocation) and launch_matches(observed, nonce, exec_argv)", mode="eval").body),
        ast.dump(ast.parse("valid_invocation(candidate_invocation) and launch_matches(discovered, nonce, exec_argv)", mode="eval").body),
    }
    require(len(null_assignments) == 1 and len(validated_assignments) == 2
            and all(isinstance(parents.get(node), ast.If)
                    and ast.dump(parents[node].test) in expected_validations
                    and parents[node].body[0] is node
                    for node in validated_assignments),
            "client may assign an owned InvocationID only after nonce-bound launch validation")

    literal_systemctl = []
    for function in (node for node in tree.body if isinstance(node, ast.FunctionDef)):
        for call in ast.walk(function):
            if (isinstance(call, ast.Call) and isinstance(call.func, ast.Name)
                    and call.func.id == "command" and call.args
                    and isinstance(call.args[0], ast.Tuple) and call.args[0].elts
                    and isinstance(call.args[0].elts[0], ast.Constant)
                    and call.args[0].elts[0].value == "/usr/bin/systemctl"
                    and (len(call.args[0].elts) < 2
                         or not isinstance(call.args[0].elts[1], ast.Constant)
                         or call.args[0].elts[1].value != "show")):
                literal_systemctl.append(function.name)
    require(literal_systemctl == ["owned_command"],
            "client name-based systemctl action bypasses exact InvocationID revalidation")

    retry_source = ast.get_source_segment(source, named_function(tree, "retry_owned_command")) or ""
    retry_contract = (
        "for attempt in range(3):", "cleanup_boundary(name)",
        "acted = owned_command(invocation, nonce, service_command, action, *arguments)",
        "RECOVERED_ERRORS.extend(errors)", "if attempt < 2:",
        "time.sleep(0.05 * (2 ** attempt))", "owned {name} command remains unavailable",
    )
    require(all(retry_source.count(fragment) == 1 for fragment in retry_contract),
            "client cleanup actions must retry the same owned command and retain initial failures")
    teardown = ast.get_source_segment(source, named_function(tree, "teardown_owned")) or ""
    teardown_contract = (
        'errors = []',
        'context="show"', 'cleanup_boundary("wait")', 'context="wait"',
        'retry_owned_command(invocation, nonce, service_command,\n                                    "kill", "kill", "--kill-whom=all", "--signal=KILL")',
        'retry_owned_command(invocation, nonce, service_command, "stop", "stop")',
        'retry_owned_command(invocation, nonce, service_command, "reset", "reset-failed")',
        'wait_unloaded(invocation, nonce, service_command)',
        'if errors:\n        raise RuntimeError("; ".join(map(str, errors)))',
    )
    require(all(teardown.count(fragment) == 1 for fragment in teardown_contract),
            "client teardown must retry pre-action failures and aggregate kill/stop/wait/reset/unload errors")
    require(teardown.count("owned_state(invocation, nonce, service_command") == 3,
            "client teardown must revalidate full ownership before each poll/name operation")
    wait_source = ast.get_source_segment(source, named_function(tree, "wait_unloaded")) or ""
    require(wait_source.count('owned_state(invocation, nonce, service_command, context="unload")') == 1
            and 'cleanup_boundary("unload")' in wait_source
            and "deadline = bounded_deadline(timeout)" in wait_source,
            "client unload polling/fault boundary ownership contract changed")

    command_path_source = ast.get_source_segment(source, named_function(tree, "command_path")) or ""
    command_path_contract = (
        'REQUESTED_MODE == "client-cleanup-fault-" + name',
        'REQUESTED_MODE == "client-cleanup-persistent-" + name',
        '"client-property-fault-immediate": "immediate"',
        '"client-property-fault-recovery": "recovery"',
        '"client-property-fault-owned": "owned-state"',
        'record_counter(name + ".intercepted")', 'record_counter(name + ".attempted")',
        'if REQUESTED_MODE == "client-cleanup-fault-stop":',
        'durable_marker(REQUESTED_MODE + ".blocked")',
        'required = 4 if name in ("show", "wait", "unload") else 3',
        'if persistent and interception == required:',
        'durable_marker(REQUESTED_MODE + ".handoff.ready")',
        'release = f"{RUN}/{REQUESTED_MODE}.handoff.release"',
        'fail("timed out awaiting persistent-fault teardown handoff")',
        'fail(f"intercepted {name} command before attempt")',
    )
    require(all(command_path_source.count(fragment) == 1 for fragment in command_path_contract)
            and command_path_source.index('fail(f"intercepted {name} command before attempt")')
            < command_path_source.index('record_counter(name + ".attempted")'),
            "client fault hooks must intercept before real actions and count retries exactly")

    fault_fragments = (
        'if requested_mode in ("client-fault-missing-invocation",\n                                      "client-property-fault-recovery"):\n                    candidate_invocation = ""',
        'if requested_mode == "client-fault-missing-invocation":\n                client_pause("client-fault-missing-invocation")',
        'if requested_mode == "client-fault-after-launch":\n                fail("injected client failure after launch")',
        'owned_state(invocation, nonce, exec_argv)\n            if requested_mode == "client-fault-after-invocation":',
        'if requested_mode == "client-fault-after-properties":\n                fail("injected client failure after property attestation")',
        'if requested_mode == "client-fault-at-terminal":\n                fail("injected client failure at terminal state")',
        'if requested_mode == "client-fault-after-journal":\n                fail("injected client failure after journal capture")',
    )
    require(all(source.count(fragment) == 1 for fragment in fault_fragments),
            "client launch/invocation/property/terminal/journal fault boundaries changed")


def validate_containment(source: str, phase: str) -> None:
    tree = ast.parse(source, filename="verify-ubuntu-migration-role-containment")
    require(literal_assignment(tree, "UNIT") == "nmcp-migration-role-verifier.service",
            "containment fixed unit name changed")
    require(literal_assignment(tree, "PID_FILES") == ("wrapper.pid", "admin.pid", "descendant.pid"),
            "containment nested process evidence changed")
    require(literal_assignment(tree, "SUCCESS") == "Ubuntu migration role compatibility verification passed",
            "containment canonical success marker changed")
    require_exact_function(tree, "run", '''def run(argv, **kwargs):
    kwargs.setdefault("timeout", 18 * 60)
    return subprocess.run(argv, cwd="/", env=ENV, text=True, **kwargs)
''', "containment subprocesses must have a bounded default wait")
    require_exact_function(tree, "show", '''def show(*properties):
    requested = tuple(dict.fromkeys(("LoadState", *properties)))
    errors = []
    for attempt in range(4):
        try:
            result = run(("/usr/bin/systemctl", "show", UNIT,
                          *(f"--property={item}" for item in requested)), check=False,
                         stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=1)
            if result.returncode:
                fail(f"containment systemctl show failed ({result.returncode}): {result.stderr.strip()}")
            if not result.stdout:
                fail("containment systemctl show returned empty output")
            values = {}
            for line in result.stdout.splitlines():
                key, separator, value = line.partition("=")
                if not separator or not key or key in values:
                    fail(f"containment systemctl show returned malformed output: {line!r}")
                values[key] = value
            missing = [name for name in requested if name not in values]
            if missing:
                fail(f"containment systemctl show omitted required properties: {', '.join(missing)}")
            return values
        except (OSError, subprocess.SubprocessError, RuntimeError) as error:
            errors.append(error)
            if attempt < 3:
                time.sleep(0.05 * (2 ** attempt))
    fail("containment unit properties remain unknown: " + "; ".join(map(str, errors)))
''', "containment property reads must fail closed with bounded retry")
    require("if not values" not in source and "return {\"LoadState\": \"not-found\"" not in source,
            "containment must not infer absence from an empty or failed property query")
    require_exact_function(tree, "assert_client_lock_reusable", '''def assert_client_lock_reusable():
    descriptor = os.open("/run/nmcp-ci/client.lock", os.O_RDWR | os.O_NOFOLLOW)
    try:
        fcntl.flock(descriptor, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        fail("client lock was not reusable after client exit")
    finally:
        os.close(descriptor)
''', "containment client-lock acquisition/release assertion changed")
    require_exact_function(tree, "assert_client_failure", '''def assert_client_failure(result, mode):
    if result.returncode == 0 or SUCCESS in result.stdout:
        fail(f"client fault unexpectedly succeeded or emitted canonical success: {mode}")
    state = show("LoadState", "ControlGroup")
    if state.get("LoadState") != "not-found":
        fail(f"client fault left the fixed unit loaded: {mode}: {state}")
    if cgroup_pids(state.get("ControlGroup", "")):
        fail(f"client fault left control-group processes: {mode}: {state}")
    if cgroup_pids("/system.slice/" + UNIT):
        fail(f"client fault left processes in the fixed unit cgroup: {mode}")
    assert_client_lock_reusable()
''', "containment causal client failure residue/lock assertions changed")
    require_exact_function(tree, "fast_recovery", '''def fast_recovery(client, repo, commit, go_binary, context):
    recovered = run(("/usr/bin/python3", "-I", "-S", client, repo, commit, go_binary,
                     "fast-success"), stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    if recovered.returncode or recovered.stdout.count(SUCCESS) != 1:
        fail(f"fast clean recovery failed after {context}: {recovered.stdout} {recovered.stderr}")
    wait_unit_absent()
    assert_client_lock_reusable()
''', "containment causal fast recovery assertion changed")
    require_exact_function(tree, "assert_interception", '''def assert_interception(mode, boundary, *, persistent=False):
    intercepted, attempted = fault_paths(mode, boundary)
    minimum = 4 if persistent and boundary in ("show", "wait", "unload") else 3 if persistent else 1
    if counter(intercepted) < minimum:
        fail(f"command path was not intercepted as required: {mode}")
    attempts = counter(attempted)
    if persistent and attempts:
        fail(f"persistent interception reached the real command path: {mode}: {attempts}")
    if not persistent and attempts < 1:
        fail(f"transient interception did not retry the real command path: {mode}")
''', "containment interception counters changed")
    require_exact_function(tree, "cleanup_exact_invocation", '''def cleanup_exact_invocation(invocation):
    state = show("InvocationID", "ActiveState", "ControlGroup")
    if state["LoadState"] == "not-found":
        return
    if state.get("InvocationID") != invocation:
        fail(f"persistent-fault cleanup refused a different invocation: {state}")
    run(("/usr/bin/systemctl", "stop", UNIT),
        check=False, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    deadline = time.monotonic() + 20
    while True:
        state = show("InvocationID", "ActiveState")
        if state["LoadState"] == "not-found":
            return
        if state.get("InvocationID") != invocation:
            fail(f"persistent-fault cleanup observed name reuse: {state}")
        if state.get("ActiveState") in ("failed", "inactive"):
            break
        if time.monotonic() >= deadline:
            fail(f"persistent-fault invocation did not terminate: {state}")
        time.sleep(0.1)
    run(("/usr/bin/systemctl", "reset-failed", UNIT), check=True,
        stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    wait_unit_absent()
''', "containment persistent-fault recovery must bind the exact InvocationID")
    contract = (
        'client_faults = (\n        "client-fault-after-launch", "client-fault-missing-invocation",\n        "client-fault-after-invocation", "client-fault-after-properties",\n        "client-fault-at-terminal", "client-fault-after-journal",\n        "client-property-fault-immediate", "client-property-fault-recovery",\n        "client-property-fault-owned",\n    )',
        '"client-property-fault-immediate": "immediate"',
        '"client-property-fault-recovery": "recovery"',
        '"client-property-fault-owned": "owned-state"',
        'for mode in client_faults:',
        'matching = show("LoadState", "InvocationID", "Description", "Environment", "ExecStart")',
        '"NMCP_VERIFIER_NONCE=" not in matching.get("Environment", "")',
        '"NMCP_VERIFIER_NONCE=" not in matching.get("ExecStart", "")',
        '"matching-nonce adoption fixture lacks the real launched service identity"',
        '"matching-nonce adoption test did not exercise missing initial InvocationID"',
        'assert_client_failure(faulted, mode)',
        'fast_recovery(client, repo, commit, go_binary, mode)',
        'for boundary in ("show", "kill", "stop", "wait", "reset", "unload"):',
        'f"intercepted {boundary} command before attempt" not in faulted.stderr',
        'mode = "client-cleanup-persistent-" + boundary',
        'cleanup_exact_invocation(invocation)',
        '"remains unknown", "remains unavailable"',
        'for signal_name, signum in (("int", signal.SIGINT), ("term", signal.SIGTERM),',
        '("hup", signal.SIGHUP), ("quit", signal.SIGQUIT)):',
        'mode = f"client-signal-{signal_name}-{boundary}"',
        'os.kill(cancelled.pid, signum)',
        '"cancelled by signal" not in cancelled_stderr',
        'if result.returncode == 0 or SUCCESS in result.stdout:',
        'state.get("LoadState") != "not-found"',
        'cgroup_pids("/system.slice/" + UNIT)',
        'assert_client_lock_reusable()',
        'for stage in ("after-intent", "after-mkdir", "after-open", "after-register"):',
        'f"run-root:{stage}"', 'os.path.exists("/run/nmcp-ci/cleanup-intent.json")',
        '"containment-supervisor-kill"', 'wait_path(READY)',
        'if not set(descendants) <= set(all_service_pids):',
        'os.kill(first.pid, signal.SIGKILL)',
        'orphaned.get("InvocationID") != invocation or orphaned.get("ActiveState") != "active"',
        'os.kill(main_pid, signal.SIGKILL)',
        'with open("/run/nmcp-ci/lock-keeper.pid", encoding="ascii") as source:',
        'keeper_pid not in all_service_pids or not process_has_inode(',
        'fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)',
        '"live in-cgroup lock keeper released the transaction lock"',
        '"second invocation overlapped the live orphaned client service"',
        'cgroup_pids(state["ControlGroup"]) or any(pid_exists(pid) for pid in all_service_pids)',
        '"client B did not block behind terminal-state client A"',
        '"client B replaced client A before A unloaded"',
        'for name in ("client-terminal-race-a", "client-terminal-race-a-unloaded",',
        '"client A reported teardown before the fixed name unloaded"',
        '"client B acquired client.lock before A confirmed unload"',
        '"client B did not launch a distinct post-unload invocation"',
        '"client B fault transaction unexpectedly succeeded"',
        '"client did not fail safely after fixed-name ownership loss"',
        '"old client teardown touched the reused-name sentinel"',
        '"retained-cleanup-dependency"',
        'if retained.returncode == 0:',
        '"drop database exited" not in retained.stdout or "drop roles exited" not in retained.stdout',
        '"failed retained-dependency cleanup emitted success"',
        'if recovered.returncode or os.path.exists("/run/nmcp-ci/cleanup-intent.json"):',
        '"retained-dependency recovery did not harden and clean"',
        'for target in ("/usr/local/libexec/nmcp", "/var/lib/nmcp", "/opt/nmcp-role-compatibility"):',
        'assert_replaced_or_absent(*prior)',
    )
    require(all(fragment in source for fragment in contract)
            and source.count('("after-intent", "after-mkdir", "after-open", "after-register")') == 2,
            "containment causal death/overlap/lock/recovery/fault contract changed")
    main_node = named_function(tree, "main")
    stale_starts = [
        index for index, node in enumerate(main_node.body)
        if isinstance(node, ast.Assign) and len(node.targets) == 1
        and isinstance(node.targets[0], ast.Name) and node.targets[0].id == "stale_nonce"
    ]
    expected_stale = ast.parse('''stale_nonce = secrets.token_hex(32)
run(("/usr/bin/systemd-run", "--quiet", f"--unit={UNIT}", "--service-type=exec",
     f"--description=NMCP migration role verifier {stale_nonce}",
     f"--property=Environment=NMCP_VERIFIER_NONCE={stale_nonce}",
     "--property=KillMode=control-group", "--property=SendSIGKILL=yes",
     "--property=TimeoutStopSec=15s", "--property=RuntimeMaxSec=15min",
     "--property=Delegate=no", "--property=RemainAfterExit=yes",
     "--property=User=root", "--property=Group=root", "--property=UMask=0077",
     "--property=WorkingDirectory=/", "--property=StandardOutput=journal",
     "--property=StandardError=journal", "/usr/bin/false"), check=True,
    stdout=subprocess.PIPE, stderr=subprocess.PIPE)
deadline = time.monotonic() + 20
while show("ActiveState").get("ActiveState") != "failed":
    if time.monotonic() >= deadline:
        fail("stale fixed-unit fixture did not reach failed state")
    time.sleep(0.1)
stale = show("InvocationID", "ActiveState", "ControlGroup", "Environment")
stale_invocation = stale["InvocationID"]
rejected = run(("/usr/bin/python3", "-I", "-S", client, repo, commit, go_binary,
                "fast-success"), stdout=subprocess.PIPE, stderr=subprocess.PIPE)
if rejected.returncode == 0 or "not explicitly absent" not in rejected.stderr:
    fail("client accepted a stale loaded fixed unit")
unchanged = show("InvocationID", "ActiveState", "Environment")
if (unchanged.get("InvocationID") != stale_invocation or unchanged.get("ActiveState") != "failed"
        or unchanged.get("Environment") != f"NMCP_VERIFIER_NONCE={stale_nonce}"):
    fail("rejected prelaunch client touched the stale fixed unit")
assert_client_lock_reusable()
cleanup_exact_invocation(stale_invocation)
wait_unit_absent()
''').body
    require(len(stale_starts) == 1
            and [ast.dump(node) for node in main_node.body[stale_starts[0]:stale_starts[0] + len(expected_stale)]]
            == [ast.dump(node) for node in expected_stale],
            "containment stale loaded fixed-unit rejection/identity/cleanup flow changed")

    persistent_loops = []
    for node in ast.walk(main_node):
        if not isinstance(node, ast.For):
            continue
        assignments = [
            child for child in node.body
            if isinstance(child, ast.Assign) and len(child.targets) == 1
            and isinstance(child.targets[0], ast.Name) and child.targets[0].id == "mode"
        ]
        if any(ast.dump(item.value) == ast.dump(
                ast.parse('"client-cleanup-persistent-" + boundary', mode="eval").body)
                for item in assignments):
            persistent_loops.append(node)
    expected_persistent = ast.parse('''for boundary in ("show", "kill", "stop", "wait", "reset", "unload"):
    mode = "client-cleanup-persistent-" + boundary
    intercepted, attempted = fault_paths(mode, boundary)
    handoff_ready = f"/run/nmcp-ci/{mode}.handoff.ready"
    handoff_release = f"/run/nmcp-ci/{mode}.handoff.release"
    reset_paths(intercepted, attempted, handoff_ready, handoff_release)
    process = subprocess.Popen(
        ("/usr/bin/python3", "-I", "-S", client, repo, commit, go_binary, mode),
        cwd="/", env=ENV, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True,
    )
    expected_interceptions = 4 if boundary in ("show", "wait", "unload") else 3
    wait_counter(intercepted, expected_interceptions)
    wait_path(handoff_ready, timeout=30)
    observed = show("InvocationID", "Description", "Environment", "ExecStart")
    invocation = observed.get("InvocationID", "")
    if observed["LoadState"] != "not-found":
        if (len(invocation) != 32 or "NMCP_VERIFIER_NONCE=" not in observed.get("Environment", "")
                or "NMCP_VERIFIER_NONCE=" not in observed.get("ExecStart", "")):
            fail(f"persistent-fault fixture lacks exact launch identity: {mode}: {observed}")
    release(mode + ".handoff")
    fault_stdout, fault_stderr = process.communicate(timeout=60)
    faulted = subprocess.CompletedProcess(process.args, process.returncode,
                                          fault_stdout, fault_stderr)
    if faulted.returncode == 0 or SUCCESS in faulted.stdout:
        fail(f"persistent command failure claimed success: {mode}")
    assert_client_lock_reusable()
    after_exit = show("InvocationID", "ActiveState", "ControlGroup")
    if after_exit["LoadState"] != "not-found":
        if not invocation or after_exit.get("InvocationID") != invocation:
            fail(f"persistent fault changed invocation before recovery: {mode}: {after_exit}")
        cleanup_exact_invocation(invocation)
    wait_unit_absent()
    if cgroup_pids("/system.slice/" + UNIT):
        fail(f"persistent fault recovery left cgroup processes: {mode}")
    assert_interception(mode, boundary, persistent=True)
    if SUCCESS in faulted.stdout or not any(message in faulted.stderr for message in (
            "remains unknown", "remains unavailable")):
        fail(f"persistent command failure claimed success or lost unknown state: {mode}")
    fast_recovery(client, repo, commit, go_binary, mode)
''').body[0]
    require(len(persistent_loops) == 1
            and ast.dump(persistent_loops[0]) == ast.dump(expected_persistent),
            "containment persistent fault handoff/exit/lock/owned cleanup sequence changed")
    loop_pairs = []
    for node in ast.walk(main_node):
        if isinstance(node, ast.For):
            loop_pairs.append(ast.dump(node.iter))
    expected_faults = ast.dump(ast.parse("client_faults", mode="eval").body)
    expected_boundaries = ast.dump(ast.parse(
        '("show", "kill", "stop", "wait", "reset", "unload")', mode="eval").body)
    expected_signal_boundaries = ast.dump(ast.parse(
        '("kill", "stop", "wait", "reset", "unload")', mode="eval").body)
    expected_signals = ast.dump(ast.parse(
        '(("int", signal.SIGINT), ("term", signal.SIGTERM), ("hup", signal.SIGHUP), ("quit", signal.SIGQUIT))',
        mode="eval").body)
    require(loop_pairs.count(expected_faults) == 1
            and loop_pairs.count(expected_boundaries) == 3
            and loop_pairs.count(expected_signal_boundaries) == 2
            and loop_pairs.count(expected_signals) == 1,
            "containment causal matrix must execute nine client faults and transient/persistent cleanup hooks")
    call_names = [
        node.func.id for node in ast.walk(main_node)
        if isinstance(node, ast.Call) and isinstance(node.func, ast.Name)
    ]
    require(call_names.count("assert_client_failure") == 3
            and call_names.count("fast_recovery") == 4,
            "containment causal fault families must each assert failure and fast recovery")
    race_fragments = (
        'go_binary, "client-terminal-race-a"),',
        'wait_path("/run/nmcp-ci/client-terminal-race-a.ready")',
        'go_binary, "client-terminal-race-b"),',
        'wait_path(attempting_b, timeout=30)',
        'or os.path.exists(acquired_b) or os.path.exists(started_b)',
        'if show("InvocationID")["InvocationID"] != invocation_a:',
        'release("client-terminal-race-a")',
        'wait_path("/run/nmcp-ci/client-terminal-race-a-unloaded.ready", timeout=60)',
        'if show("LoadState").get("LoadState") != "not-found":',
        'or os.path.exists(acquired_b) or os.path.exists(started_b)',
        'release("client-terminal-race-a-unloaded")',
        'recovered_stdout, recovered_stderr = recovered.communicate(timeout=60)',
        'wait_path(acquired_b, timeout=60)',
        'wait_path(started_b, timeout=60)',
        'wait_path("/run/nmcp-ci/client-terminal-race-b.ready", timeout=60)',
        'if terminal_b["InvocationID"] == invocation_a:',
        'release("client-terminal-race-b")',
    )
    race_positions = []
    race_offset = 0
    for fragment in race_fragments:
        position = source.find(fragment, race_offset)
        race_positions.append(position)
        if position >= 0:
            race_offset = position + len(fragment)
    require(all(position >= 0 for position in race_positions),
            "containment causal terminal two-client serialization race changed")
    reuse_fragments = (
        '"client-reuse-pause")',
        'wait_path("/run/nmcp-ci/client-reuse-pause.ready", timeout=60)',
        'replaced_invocation = replaced_a["InvocationID"]',
        'replaced_environment = replaced_a["Environment"]',
        '("/usr/bin/systemctl", "kill", "--kill-whom=all", "--signal=KILL", UNIT)',
        '("/usr/bin/systemctl", "reset-failed", UNIT)',
        'wait_unit_absent()',
        'sentinel_nonce = secrets.token_hex(32)',
        '("/usr/bin/systemd-run", "--quiet", f"--unit={UNIT}", "--service-type=exec"',
        'f"--description=NMCP migration role verifier {sentinel_nonce}"',
        'f"--property=Environment=NMCP_VERIFIER_NONCE={sentinel_nonce}"',
        'sentinel_invocation = sentinel_state["InvocationID"]',
        'sentinel_state.get("Environment") != f"NMCP_VERIFIER_NONCE={sentinel_nonce}"',
        '"reused-name sentinel did not expose its mismatched nonce"',
        'release("client-reuse-pause")',
        'if replaced.returncode == 0 or "launch identity lost" not in replaced.stderr:',
        'if after_replaced["InvocationID"] != sentinel_invocation or after_replaced["ActiveState"] != "active":',
    )
    reuse_positions = [source.find(fragment, race_positions[-1]) for fragment in reuse_fragments]
    require(all(position >= 0 for position in reuse_positions)
            and reuse_positions == sorted(reuse_positions),
            "containment causal actual reused-name sentinel counterexample changed")
    phase_contract = (
        'if [[ ${NMCP_TEST_SUPERVISOR_CONTAINMENT:-} == 1 ]]; then',
        "/usr/bin/setsid /bin/sh -c",
        '/usr/bin/setsid "$wrapper" "$work/kill/nmcp-admin" migrate up --json &',
        '/usr/bin/touch "$work/kill/supervisor-kill.ready"',
        'exit 97',
    )
    require(all(fragment in phase for fragment in phase_contract)
            and phase.count('/usr/bin/setsid /bin/sh -c') == 1
            and phase.count('/usr/bin/setsid "$wrapper" "$work/kill/nmcp-admin" migrate up --json &') == 2,
            "compatibility nested setsid containment fixture changed")


def validate_fd_wrappers(migration_wrapper: str, role_mode: str) -> None:
    require(
        'role_mode=${NMCP_ROLE_MODE:-/usr/local/libexec/nmcp/set-ubuntu-migration-role-mode}'
        in migration_wrapper
        and '"$role_mode" compatibility' in migration_wrapper
        and '"$role_mode" hardened' in migration_wrapper,
        "migration wrapper descriptor override changed",
    )
    wrapper_contract = (
        'if [[ $admin =~ ^/proc/self/fd/[0-9]+$ ]]; then',
        '[[ -f $admin && -x $admin ]]',
        'migration_status=0\nsignal_status=0\nfinalized=false\nchild_pid=',
        '/usr/bin/setsid /usr/bin/setpriv --reuid=nmcp --regid=nmcp --init-groups --no-new-privs',
        '/usr/bin/kill -s "$signal" -- "-$child_pid" 2>/dev/null || true',
        '/usr/bin/kill -KILL -- "-$child_pid" 2>/dev/null || true',
        'signal_status=130\n  stop_child INT\n  exit 130',
        'signal_status=143\n  stop_child TERM\n  exit 143',
    )
    require(all(migration_wrapper.count(fragment) == 1 for fragment in wrapper_contract),
            "migration wrapper descriptor/session/signal cleanup contract changed")
    require(
        'bootstrap=${NMCP_RUNTIME_ROLES:-$bootstrap_dir/runtime-roles.sql}' in role_mode
        and 'verifier=${NMCP_VERIFY_ROLE_GRAPH:-$bootstrap_dir/verify-runtime-role-graph.sql}' in role_mode
        and '<"$bootstrap"' in role_mode
        and 'psql_local <"$verifier"' in role_mode,
        "role-mode wrapper descriptor overrides changed",
    )
    role_mode_fd_contract = (
        'if [[ $path =~ ^/proc/self/fd/[0-9]+$ ]]; then',
        '[[ -f $path && $(/usr/bin/stat -L -c \'%U:%G:%a\' "$path") == root:root:644 ]]',
        '[[ -f $path && ! -L $path && $(/usr/bin/stat -c \'%U:%G:%a\' "$path") == root:root:644 ]]',
    )
    require(all(role_mode.count(fragment) == 1 for fragment in role_mode_fd_contract),
            "role-mode wrapper verified descriptor path contract changed")


def validate_validation_env(source: str) -> None:
    preflight = '''require_container_readable_sql_fixtures() {
  for fixture in \\
    "$root/infra/validation/postgres-init.sql" \\
    "$root/infra/validation/verify-runtime-roles.sql" \\
    "$root/infra/postgresql/runtime-roles.sql" \\
    "$root/infra/postgresql/verify-runtime-role-graph.sql" \\
    "$root/infra/ubuntu/postgresql-roles.sql"; do
    mode=$(stat -c '%a' "$fixture")
    case ${mode#${mode%?}} in
      4|5|6|7) ;;
      *)
        echo "error: container SQL bind fixture is not other-readable (chmod 0644): $fixture (mode $mode)" >&2
        exit 1
        ;;
    esac
  done
}
'''
    require(source.count(preflight) == 1,
            "validation-env exact five-fixture other-readable SQL preflight changed")
    require(source.count("require_container_readable_sql_fixtures") == 3,
            "validation-env SQL preflight must be defined once and invoked exactly twice")
    dispatch = source[source.index('case "${1:-}" in'):]
    require(dispatch.count("    require_container_readable_sql_fixtures\n") == 2
            and "  up)\n    require_container_readable_sql_fixtures\n" in dispatch
            and "  verify)\n    require_container_readable_sql_fixtures\n" in dispatch,
            "validation-env SQL preflight must run for up and verify only")
    fixture_paths = re.findall(r'"\$root/([^" ]+\.sql)"', preflight)
    require(fixture_paths == [
        "infra/validation/postgres-init.sql",
        "infra/validation/verify-runtime-roles.sql",
        "infra/postgresql/runtime-roles.sql",
        "infra/postgresql/verify-runtime-role-graph.sql",
        "infra/ubuntu/postgresql-roles.sql",
    ], "validation-env SQL bind fixture inventory changed")


class WorkflowLoader(yaml.SafeLoader if yaml is not None else object):
    pass


if yaml is not None:
    WorkflowLoader.yaml_implicit_resolvers = {
        key: [resolver for resolver in values if resolver[0] != "tag:yaml.org,2002:bool"]
        for key, values in yaml.SafeLoader.yaml_implicit_resolvers.items()
    }
    WorkflowLoader.add_implicit_resolver(
        "tag:yaml.org,2002:bool", re.compile(r"^(?:true|false)$"), list("tf")
    )

    def construct_unique_mapping(loader, node, deep=False):
        mapping = {}
        for key_node, value_node in node.value:
            require(isinstance(key_node, yaml.ScalarNode), "workflow mapping keys must be scalar strings")
            key = loader.construct_object(key_node, deep=deep)
            require(isinstance(key, str), "workflow mapping keys must be strings")
            require(key not in mapping, f"workflow contains duplicate mapping key: {key}")
            mapping[key] = loader.construct_object(value_node, deep=deep)
        return mapping

    WorkflowLoader.add_constructor(yaml.resolver.BaseResolver.DEFAULT_MAPPING_TAG,
                                   construct_unique_mapping)


def load_workflow(source: str) -> dict:
    require(yaml is not None, "PyYAML is required to validate the Ubuntu workflow")
    require(not re.search(r"(?m)^true:[ \t]*(?:#.*)?$", source),
            "Ubuntu workflow must not use a top-level true: key")
    require(len(re.findall(r"(?m)^on:[ \t]*(?:#.*)?$", source)) == 1,
            "Ubuntu workflow needs exactly one top-level plain on: key")
    require(len(re.findall(r"(?m)^    timeout-minutes: 60$", source)) == 1
            and len(re.findall(r"(?m)^          fetch-depth: 0$", source)) == 1,
            "Ubuntu workflow numeric scalars must use canonical lexical forms")
    try:
        tokens = list(yaml.scan(source, Loader=WorkflowLoader))
        require(not any(isinstance(token, (yaml.AnchorToken, yaml.AliasToken)) for token in tokens),
                "Ubuntu workflow must not use YAML anchors or aliases")
        require(not any(isinstance(token, yaml.ScalarToken) and token.value == "<<" for token in tokens),
                "Ubuntu workflow must not use YAML merge keys")
        workflow = yaml.load(source, Loader=WorkflowLoader)
    except (yaml.YAMLError, RuntimeError) as error:
        raise RuntimeError(f"Ubuntu workflow YAML rejected: {error}") from error
    require(isinstance(workflow, dict), "Ubuntu workflow root must be a mapping")
    return workflow


