    render_source = ast.get_source_segment(source, named_function(tree, "render_client_result")) or ""
    render_contract = (
        "def render_client_result(primary_error, final_evidence):",
        'f"{ordinal}.{boundary}.{category}.{retries}.{interceptions}.{attempts}"',
        "for ordinal, boundary, category, retries, interceptions, attempts in RESULT_EVENTS",
        "events_complete={int(RESULT_EVENTS_COMPLETE)}",
        "final_scanned={int(scanned)}",
        "final_observed={int(observed)}",
        "final_empty={int(empty)}",
        "return=1;stdout=0;success=0",
        "len(encoded) > RESULT_BYTE_LIMIT",
    )
    require(all(render_source.count(fragment) == 1 for fragment in render_contract)
            and "sorted(" not in render_source and "set(" not in render_source,
            "client append-only result rendering derivation or bound changed")
    require_exact_function(tree, "result_failure", '''def result_failure(primary_error, human, final_evidence):
    raise ClientResultFailure(render_client_result(primary_error, final_evidence), human) from None
''', "client result failure rendering changed")
    require_exact_function(tree, "resolve_outcome", '''def resolve_outcome(primary_error, cleanup_errors, nonce, final_evidence):
    if (type(final_evidence) is not tuple or len(final_evidence) != 4
            or any(type(bit) is not bool for bit in final_evidence[:3])
            or final_evidence[2] and not (final_evidence[0] and final_evidence[1])
            or (final_evidence[:3] != (True, True, True))
                != (final_evidence[3] is not None)):
        fail("final cgroup evidence was not immutable and complete")
    if isinstance(primary_error, CgroupFailure):
        record_cgroup_failure(primary_error, "final")
    final_error = final_evidence[3]
    if final_error is not None:
        record_cgroup_failure(final_error, "final")
    for error in cleanup_errors:
        if not cleanup_error_mapped(error):
            if isinstance(error, CgroupFailure):
                record_cgroup_failure(error, "final")
            else:
                cleanup_result("unexpected", "final", (error,))
    if not RESULT_EVENTS_COMPLETE:
        cleanup_errors = [*cleanup_errors, RuntimeError("cleanup event evidence overflowed")]
    if final_error is not None or cleanup_errors:
        errors = []
        if final_error is not None:
            append_unique_diagnostic(errors, sanitized_diagnostic(final_error, nonce))
            if primary_error is not None:
                append_unique_diagnostic(errors, sanitized_diagnostic(primary_error, nonce))
        for error in cleanup_errors:
            append_unique_diagnostic(errors, sanitized_diagnostic(error, nonce))
        detail = sanitized_diagnostic("; ".join(errors), nonce)
        if final_error is not None:
            result_failure(primary_error, detail, final_evidence)
        if primary_error is not None:
            primary = sanitized_diagnostic(primary_error, nonce)
            result_failure(primary_error, f"{primary}; cleanup failed: {detail}", final_evidence)
