        "after_exit", "body", "budgeted", "calls", "cancelled", "categories", "character",
        "counts", "descendants", "document",
        "cleanup_errors", "dict", "early_observed", "environment", "errors", "evidence", "expected_slow_counts", "fcntl", "first", "functools",
        "digits", "emitted", "field", "fields_by_name", "found", "json", "kwargs", "kill_stderr", "line", "loaded", "matching", "mode", "mutations",
        "barrier_name", "name", "names", "labels", "message", "observed", "orphaned", "os", "pairs", "part", "parts", "post_cleanup", "post_cleanup_cgroup", "prefix", "process",
        "parsed_events", "predicates", "property_boundaries", "raw_event",
        "partial", "recovered", "recovered_observed", "rendered", "replaced", "result", "runpy",
        "schema", "secrets", "sentinel_state",
        "identities", "kept", "path", "payload", "results", "signature", "slow", "slow_paths",
        "slow_state", "source", "stat", "state", "stream",
        "stderr",
        "stale_after_client", "stale_observed",
        "stale_post_cleanup", "stale_post_cleanup_cgroup", "stale_program",
        "stopped", "reset", "RESULT_BOUNDARIES", "RESULT_CLEANUP_CATEGORIES",
        "subprocess", "target", "text", "time", "value", "values", "wait_stderr", "waiting",
    }
    for node in ast.walk(tree):
        if not isinstance(node, ast.Call):
            continue
        if isinstance(node.func, ast.Name):
            target = "name:" + node.func.id
            require(node.func.id in reviewed_name_callees,
                    "containment gained an unreviewed named call target")
        else:
            chain = rooted_attribute_chain(node.func)
            if chain is None:
                target = "dynamic:" + ast.dump(node.func)
            else:
                target = "attr:" + chain
                require(chain.split(".", 1)[0] in reviewed_attribute_callee_roots,
                        "containment gained an unreviewed attribute call root")
        call_target_counts[target] = call_target_counts.get(target, 0) + 1
        parent, field = child_relations[id(node)]
        context = (node_regions[id(node)], target, type(parent).__name__, field,
                   ast.dump(node))
        call_contexts.append(context)
        statement = node
        while not isinstance(statement, ast.stmt):
            statement = child_relations[id(statement)][0]
        control_flow_call_contexts.append((node_regions[id(node)], target,
                                           node_paths[id(node)], node_paths[id(statement)],
                                           ast.dump(statement)))
        if (target == "name:run"
                or target.startswith(("attr:subprocess.", "attr:os.", "attr:fcntl.",
                                      "attr:runpy."))):
            security_call_contexts.append(context)
    for node in ast.walk(tree):
        if isinstance(node, ast.Attribute):
            chain = rooted_attribute_chain(node)
            if chain is not None and chain.split(".", 1)[0] in reviewed_imports:
                parent, field = child_relations[id(node)]
                call_contexts.append((node_regions[id(node)], "module-attribute:" + chain,
                                      type(parent).__name__, field, ast.dump(node)))
    # These normalized AST fingerprints only guard the exact reviewed inventory/context;
    # they are not source authentication and never replace the semantic inventories above.
    observed_call_fingerprints = (
        hashlib.sha256(repr(sorted(call_target_counts.items())).encode()).hexdigest(),
        hashlib.sha256(repr(sorted(call_contexts)).encode()).hexdigest(),
        hashlib.sha256(repr(sorted(security_call_contexts)).encode()).hexdigest(),
        hashlib.sha256(repr(sorted(control_flow_call_contexts)).encode()).hexdigest(),
    )
