        'previous_mask = signal.pthread_sigmask(signal.SIG_BLOCK, CANCELLATION_SIGNALS)',
        'signal.pthread_sigmask(signal.SIG_SETMASK, previous_mask)',
        'launch_attempted = False',
        'launch_attempted = True',
        'total_deadline = time.monotonic() + TOTAL_BUDGET',
        'work_deadline = total_deadline - CLEANUP_RESERVE',
        'COMMAND_DEADLINE = work_deadline',
        'cleanup_deadline = min(total_deadline, time.monotonic() + CLEANUP_BUDGET)',
        'COMMAND_DEADLINE = cleanup_deadline',
        'CLEANUP_ACTIVE = True',
        'CLEANUP_ACTIVE = False',
        'discovered = launch_state("recovery", context="recovery")',
        'except BaseException as error:\n            primary_error = error',
        'f"{sanitized_state(discovered)}"',
        'cleanup_errors.append(error)',
        'raise RuntimeError(f"{primary}; cleanup failed: {detail}") from None',
        'client_pause("unload", "client-terminal-race-a-unloaded")',
        'Hostile root is explicitly outside this verifier\'s threat model.',
    )
