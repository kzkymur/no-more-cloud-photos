            '    result = command(("/usr/bin/systemctl", *arguments, UNIT), check=False)\n    command_path("reset" if arguments[0] == "reset-failed" else arguments[0])')),
        ("cleanup aggregation omitted", replace_once(client,
            '    if errors:\n        raise RuntimeError("; ".join(map(str, errors)))', '    pass')),
        ("B attempting marker after flock", replace_once(client,
            '        if requested_mode == "client-terminal-race-b":\n            durable_marker("client-terminal-race-b.attempting")\n        fcntl.flock(client_lock, fcntl.LOCK_EX)',
            '        fcntl.flock(client_lock, fcntl.LOCK_EX)\n        if requested_mode == "client-terminal-race-b":\n            durable_marker("client-terminal-race-b.attempting")')),
        ("B acquired marker before flock", replace_once(client,
            '        fcntl.flock(client_lock, fcntl.LOCK_EX)\n        COMMAND_DEADLINE = time.monotonic() + 17 * 60\n        if requested_mode == "client-terminal-race-b":\n            durable_marker("client-terminal-race-b.acquired")',
            '        if requested_mode == "client-terminal-race-b":\n            durable_marker("client-terminal-race-b.acquired")\n        fcntl.flock(client_lock, fcntl.LOCK_EX)\n        COMMAND_DEADLINE = time.monotonic() + 17 * 60')),
        ("launch fault hook omitted", replace_once(client, '            if requested_mode == "client-fault-after-launch":\n                fail("injected client failure after launch")\n', '')),
        ("invocation fault hook omitted", replace_once(client, '            if requested_mode == "client-fault-after-invocation":\n                fail("injected client failure after invocation capture")\n', '')),
        ("property fault hook omitted", replace_once(client, '            if requested_mode == "client-fault-after-properties":\n                fail("injected client failure after property attestation")\n', '')),
        ("terminal fault hook omitted", replace_once(client, '            if requested_mode == "client-fault-at-terminal":\n                fail("injected client failure at terminal state")\n', '')),
        ("journal fault hook omitted", replace_once(client, '            if requested_mode == "client-fault-after-journal":\n                fail("injected client failure after journal capture")\n', '')),
        ("post-unload lock-held pause omitted", replace_once(client, '        if requested_mode == "client-terminal-race-a":\n            client_pause("client-terminal-race-a-unloaded")\n', '')),
    ]
    for label, mutation in client_mutations:
        expect_rejected(validate_client, mutation, label, "client")
    containment_mutations = [
        ("containment nonzero show treated as absent", replace_once(containment,
            '            if result.returncode:\n                fail(f"containment systemctl show failed ({result.returncode}): {result.stderr.strip()}")',
