        self.assertIn('-C /opt nmcp-native-ci',workflow)
        self.assertEqual(workflow.count('backup-live-inputs/backup-native-toolchain.tar.gz'),2)
        self.assertIn('ProtectHome=yes',(repo/'infra/ubuntu/systemd/nmcp-worker.service').read_text())

