    def test_receipt_directory_must_be_root_private(self):
        for uid, mode in ((1000, 0o40700), (0, 0o40755), (0, 0o120700)):
            path = Mock()
            path.lstat.return_value = types.SimpleNamespace(st_uid=uid, st_mode=mode)
            with self.assertRaisesRegex(RuntimeError, 'unsafe receipt directory'):
                MODULE.private_directory(path)

    def test_structural_isolation_and_receipt_contract(self):
        for required in ('--private-network', '--boot', '--settings=no', '--register=yes',
                         ':norbind', '--bind-ro=', "MIRROR = 'https://archive.ubuntu.com/ubuntu'",
                         "KEYRING = '/usr/share/keyrings/ubuntu-archive-keyring.gpg'",
                         "'--cache-dir=' + str(work / 'deb-cache')",
                         'systemd-sysusers', '0o755', 'O_NOFOLLOW', '0o600', '0o700',
                         'os.fsync', 'root_inode', 'leader_start', 'launcher_start',
                         "('mnt', 'pid', 'net')", "record.get('stopped')"):
            self.assertIn(required, SOURCE)
        for forbidden in ('--bind=', 'systemctl stop', 'shutil.rmtree', 'no-check-gpg',
                          "'--bind-ro=' + str(temp)"):
            self.assertNotIn(forbidden, SOURCE)
        self.assertNotIn('postgresql-common', MODULE.PACKAGES)
        for package in ('libssl3t64', 'libreadline8t64', 'libimage-exiftool-perl'):
            self.assertIn(package, MODULE.PACKAGES.split(','))
        for forbidden in ('allow-unauthenticated', 'AllowUnauthenticated', '--no-check-certificate',
                          'unpack-tarball', 'timeout=900', 'timeout=1200'):
            self.assertNotIn(forbidden, SOURCE)


class DebCacheAndBudget(unittest.TestCase):
    DEB = 'libc6_2.39-0ubuntu8_amd64.deb'

    def make(self, entries, mode=0o755):
        base = pathlib.Path(tempfile.mkdtemp())
        src = base / 'debootstrap-deb-cache'
        src.mkdir(mode=mode); src.chmod(mode)
        for name, data in entries.items():
            (src / name).write_bytes(data)
        work = base / 'work'; work.mkdir(mode=0o700)
        return base, src, work

    def test_miss_creates_empty_private_cache(self):
        base = pathlib.Path(tempfile.mkdtemp()); work = base / 'work'; work.mkdir(mode=0o700)
        r = MODULE.import_deb_cache(base / 'debootstrap-deb-cache', work)
        self.assertEqual(r['status'], 'miss')
        self.assertEqual(list((work / 'deb-cache').iterdir()), [])
        self.assertEqual((work / 'deb-cache').stat().st_mode & 0o777, 0o700)

    def test_valid_restore_is_copied_not_linked_and_source_untouched(self):
        base, src, work = self.make({self.DEB: b'x' * 10, 'apt_2.7.14build2_amd64.deb': b'y'})
        r = MODULE.import_deb_cache(src, work)
        self.assertEqual((r['status'], r['files'], r['bytes']), ('restored', 2, 11))
        copy = work / 'deb-cache' / self.DEB
        self.assertEqual(copy.read_bytes(), b'x' * 10)
        self.assertNotEqual(copy.stat().st_ino, (src / self.DEB).stat().st_ino)
        self.assertEqual(copy.stat().st_mode & 0o777, 0o600)
        self.assertEqual(sorted(p.name for p in src.iterdir()), sorted([self.DEB, 'apt_2.7.14build2_amd64.deb']))
        self.assertFalse((work / 'deb-cache-import').exists())

    def test_any_shape_violation_rejects_whole_cache(self):
        cases = {
            'unexpected name': lambda src: (src / 'Packages').write_bytes(b'p'),
            'path traversal name': lambda src: (src / '..deb').write_bytes(b'p'),
            'symlink': lambda src: (src / 'evil_1_amd64.deb').symlink_to('/etc/shadow'),
            'hardlink': lambda src: os.link(src / self.DEB, src / 'dup_1_all.deb'),
            'empty file': lambda src: (src / 'empty_1_all.deb').write_bytes(b''),
            'subdirectory': lambda src: (src / 'dir_1_all.deb').mkdir(),
            'fifo': lambda src: os.mkfifo(src / 'fifo_1_all.deb'),
        }
        import os
        for label, mutate in cases.items():
            with self.subTest(label):
                base, src, work = self.make({self.DEB: b'x'})
                mutate(src)
                with patch('builtins.print'):
                    r = MODULE.import_deb_cache(src, work)
                self.assertEqual(r['status'], 'rejected')
                self.assertEqual(list((work / 'deb-cache').iterdir()), [])
                self.assertEqual(list((work / 'deb-cache-import').iterdir()), [])
                self.assertTrue((src / self.DEB).exists())

    def test_writable_or_symlinked_cache_directory_rejected(self):
        base, src, work = self.make({self.DEB: b'x'}, mode=0o777)
        with patch('builtins.print'):
            self.assertEqual(MODULE.import_deb_cache(src, work)['status'], 'rejected')
        base, src, work = self.make({self.DEB: b'x'})
        link = base / 'linked'; link.symlink_to(src)
        with patch('builtins.print'):
            self.assertEqual(MODULE.import_deb_cache(link, work)['status'], 'rejected')

    def test_limits_reject(self):
        base, src, work = self.make({self.DEB: b'x' * 8})
        with patch.object(MODULE, 'DEB_MAX_FILE', 4), patch('builtins.print'):
            self.assertEqual(MODULE.import_deb_cache(src, work)['status'], 'rejected')
        base, src, work = self.make({'a_1_all.deb': b'x', 'b_1_all.deb': b'y'})
        with patch.object(MODULE, 'DEB_MAX_FILES', 1), patch('builtins.print'):
            self.assertEqual(MODULE.import_deb_cache(src, work)['status'], 'rejected')

    def test_cached_bytes_are_verified_by_debootstrap_never_bypassed(self):
        self.assertIn("'--cache-dir=' + str(work / 'deb-cache')", SOURCE)
        for forbidden in ('--no-check-gpg', 'unpack-tarball', 'make-tarball', 'force-check-gpg=0',
                          '--keep-debootstrap-dir', 'rootfs-cache', 'shutil.copytree'):
            self.assertNotIn(forbidden, SOURCE)
        main = SOURCE[SOURCE.index('def main():'):]
        # Fresh rootfs every run: import precedes bootstrap into the new work dir.
        self.assertLess(main.index('import_deb_cache('), main.index('bootstrap_with_retry('))
        self.assertLess(main.index('bootstrap_with_retry('), main.index('export_deb_cache('))
        self.assertIn("if cache['status'] == 'miss':", main)
        self.assertIn('tempfile.mkdtemp(prefix=', main)

    def test_export_only_regular_named_debs_owned_by_runner(self):
        base = pathlib.Path(tempfile.mkdtemp()); work = base / 'work'; (work / 'deb-cache').mkdir(parents=True)
        (work / 'deb-cache' / self.DEB).write_bytes(b'z')
        (work / 'deb-cache' / 'partial').mkdir()
        (work / 'deb-cache' / 'x_1_all.deb').symlink_to('/etc/passwd')
        (work / 'deb-cache' / 'notes.txt').write_bytes(b'n')
        self.assertEqual(MODULE.export_deb_cache(work, base), 1)
        out = base / 'debootstrap-deb-cache'
        self.assertEqual([p.name for p in out.iterdir()], [self.DEB])
        self.assertEqual((out / self.DEB).stat().st_mode & 0o777, 0o644)
        with self.assertRaises(FileExistsError):
            MODULE.export_deb_cache(work, base)  # Never merges into existing content.

    def test_release_indices_require_valid_signature_and_use_verified_plaintext(self):
        d = pathlib.Path(tempfile.mkdtemp()); inrel = d / 'InRelease'; plain = d / 'Release'
        good = 'a' * 64
        body = ('Origin: Ubuntu\nSHA256:\n ' + good + ' 1 main/binary-amd64/Packages.xz\n '
                + 'b' * 64 + ' 2 universe/binary-amd64/Packages.xz\n ' + 'c' * 64
                + ' 3 main/binary-i386/Packages.xz\nMD5Sum:\n ' + 'd' * 32 + ' 1 main/binary-amd64/Packages\n')
        def gpgv(argv, **kw):
            self.assertEqual(argv[:3], ['/usr/bin/gpgv', '--keyring', MODULE.KEYRING])
            pathlib.Path(argv[argv.index('--output') + 1]).write_text(body)
            return types.SimpleNamespace(stdout='[GNUPG:] VALIDSIG F6EC 2024\n')
        with patch.object(MODULE, 'run', side_effect=gpgv):
            got = MODULE.verified_release_indices(inrel, plain)
        self.assertEqual([f[2] for f in got], ['main/binary-amd64/Packages.xz', 'universe/binary-amd64/Packages.xz'])
        self.assertEqual(got[0][0], good)
        def bad(argv, **kw):
            pathlib.Path(argv[argv.index('--output') + 1]).write_text(body)
            return types.SimpleNamespace(stdout='[GNUPG:] BADSIG x\n')
        with patch.object(MODULE, 'run', side_effect=bad), self.assertRaises(RuntimeError):
            MODULE.verified_release_indices(inrel, plain)
        def gpgv_fail(argv, **kw):
            raise MODULE.sp.CalledProcessError(2, argv)
        with patch.object(MODULE, 'run', side_effect=gpgv_fail), self.assertRaises(MODULE.sp.CalledProcessError):
            MODULE.verified_release_indices(inrel, plain)

    def budget_env(self):
        return patch.dict(MODULE.os.environ, {'GITHUB_REPOSITORY': 'o/r', 'RUNNER_NAME': 'GitHub Actions 7',
                                               'GITHUB_RUN_ID': '11', 'GITHUB_RUN_ATTEMPT': '1',
                                               'BUDGET_RUN_SHA': 'b' * 40})

    def test_budget_check_identity_policy_and_cap(self):
        out = '{"deadline_mono": 9.0, "job_id": 5, "phase": "active", "timeout_seconds": 700}'
        with self.budget_env(), patch.object(MODULE, 'run', return_value=types.SimpleNamespace(stdout=out)) as run, \
                patch('builtins.print'):
            self.assertEqual(MODULE.budget_seconds(pathlib.Path('/repo'), pathlib.Path('/t'), 'live', 'a' * 40,
                                                   'active', 900, 300), 700)
        argv = run.call_args.args[0]
        self.assertEqual(argv[:4], ['/usr/bin/python3', '-I', '/repo/scripts/backup-ci-admission', 'check'])
        flags = dict(zip(argv[4::2], argv[5::2]))
        self.assertEqual(flags['--job-name'], MODULE.JOB_NAMES['live'])
        self.assertEqual(flags['--receipt'], '/t/.nmcp-budget-live.json')
        self.assertEqual(flags['--job-seconds'], '2400')
        self.assertEqual(flags['--cleanup-seconds'], '300')
        self.assertEqual(flags['--sha'], 'b' * 40)  # Run head, not PR merge candidate.
        with patch.dict(MODULE.os.environ, {'BUDGET_RUN_SHA': 'HEAD'}), self.assertRaises(RuntimeError):
            MODULE.budget_seconds(pathlib.Path('/repo'), pathlib.Path('/t'), 'live', 'a' * 40, 'active', 900, 300)
        self.assertNotIn('GITHUB_TOKEN', ' '.join(argv))
        for bogus in ('{"job_id": 5, "phase": "active", "timeout_seconds": 901}',
                      '{"job_id": 5, "phase": "active", "timeout_seconds": 10}',
                      '{"job_id": 5, "phase": "cleanup", "timeout_seconds": 700}'):
            with self.budget_env(), patch.object(MODULE, 'run', return_value=types.SimpleNamespace(stdout=bogus)), \
                    self.assertRaises(RuntimeError):
                MODULE.budget_seconds(pathlib.Path('/repo'), pathlib.Path('/t'), 'live', 'a' * 40, 'active', 900, 300)

    def test_budget_refusal_is_closed_and_not_reflected(self):
        for stderr, expected in (('admission_refused:insufficient_budget\n', 'admission_refused:insufficient_budget'),
                                 ('SECRET token=abc', 'unknown')):
            err = MODULE.sp.CalledProcessError(1, ['x'], stderr=stderr)
            with self.budget_env(), patch.object(MODULE, 'run', side_effect=err), \
                    self.assertRaises(RuntimeError) as raised:
                MODULE.budget_seconds(pathlib.Path('/repo'), pathlib.Path('/t'), 'offline', 'a' * 40, 'active', 900, 300)
            self.assertEqual(str(raised.exception), 'budget admission refused: ' + expected)

    def test_phase_budget_reserves_all_downstream_phases(self):
        with patch.object(MODULE, 'budget_seconds', return_value=1800) as check:
            got = MODULE.phase_budget('/r', '/t', 'live', 'a' * 40, 900, 1470, 300)
        self.assertEqual(got, 330)
        check.assert_called_once_with('/r', '/t', 'live', 'a' * 40, 'active', 21600, 1770)
        with patch.object(MODULE, 'budget_seconds', return_value=5000):
            self.assertEqual(MODULE.phase_budget('/r', '/t', 'live', 'a' * 40, 900, 1470, 300), 900)
        p = MODULE.BUDGET_POLICY
        # Static worst case of the fixed caps fits inside the job, excluding
        # the separately reserved cleanup and margin.
        self.assertLessEqual(MODULE.SETUP_ALLOWANCE + MODULE.BOOTSTRAP_CAP + MODULE.BOOT_CAP
                             + MODULE.GUEST_SETUP_RESERVE + MODULE.TEST_CAP + 32,
                             p['job_seconds'] - p['cleanup_seconds'] - p['margin_seconds'])
        # Teardown's own fixed bounds (210+30+45+15) fit the cleanup reserve.
        self.assertGreaterEqual(p['cleanup_seconds'], 210 + 30 + 45 + 15)
        workflow = (SCRIPT.parent.parent / '.github/workflows/ci.yml').read_text()
        for name in MODULE.JOB_NAMES.values():
            job = workflow[workflow.index('name: ' + name):]
            job = job[:job.index('\n  backup-') if '\n  backup-' in job else len(job)]
            self.assertIn('timeout-minutes: %d\n' % (p['job_seconds'] // 60), job)
            self.assertIn('--job-seconds %d' % p['job_seconds'], job)
            self.assertIn('--cleanup-seconds %d' % p['cleanup_seconds'], job)
            self.assertIn('--margin-seconds %d' % p['margin_seconds'], job)
            self.assertIn('--required-seconds %d' % (MODULE.BOOTSTRAP_REQUIRED + MODULE.BOOT_CAP
                          + MODULE.GUEST_SETUP_RESERVE + MODULE.TEST_REQUIRED), job)
        self.assertLessEqual(p['job_seconds'], 2400)  # Hosted job cap; never raised to fit.
        self.assertGreaterEqual(MODULE.TEST_REQUIRED, 18 * 60 + 30)
        self.assertLessEqual(MODULE.TEST_REQUIRED, MODULE.TEST_CAP)

    def test_insufficient_budget_fails_before_owned_root_resources(self):
        main = SOURCE[SOURCE.index('def main():'):]
        first = main.index('phase_budget(')
        self.assertLess(first, main.index("receipt_dir.mkdir(mode=0o700)"))
        self.assertLess(first, main.index('tempfile.mkdtemp('))
        for phase in ('bootstrap_timeout = phase_budget(', 'time.monotonic() + phase_budget(',
                      'test_timeout = phase_budget('):
            self.assertIn(phase, main)
        self.assertIn('timeout=test_timeout', main)
        with self.assertRaises(RuntimeError):
            MODULE.observed_bootstrap([], {}, None, pathlib.Path('/private'),
                                      dict(head='a'*40, run='1', attempt='1', slot='live'), MODULE.BOOTSTRAP_CAP + 1)

    def test_cache_key_mode_is_unprivileged_and_first(self):
        main = SOURCE[SOURCE.index('def main():'):]
        self.assertLess(main.index("['--deb-cache-key']"), main.index("os.geteuid() == 0"))


class BootstrapRetry(unittest.TestCase):
    def run_attempts(self, outcomes, timeout=520, clock=None, mounts=False):
        work = pathlib.Path(tempfile.mkdtemp())
        root = work / 'rootfs'
        calls = []
        def fake(argv, env, log, work_, identity, t):
            calls.append(t)
            root.mkdir()
            outcome = outcomes[len(calls) - 1]
            if outcome is None:
                return {'result': 'success'}
            exc = MODULE.BootstrapFailure('x')
            exc.summary = {'error_class': outcome[0], 'phase': outcome[1]}
            raise exc
        ident = dict(head='a'*40, run='1', attempt='1', slot='live')
        with patch.object(MODULE, 'observed_bootstrap', side_effect=fake), \
                patch.object(MODULE, 'root_has_mounts', return_value=mounts), \
                patch.object(MODULE.time, 'sleep'), patch('builtins.print') as printed:
            if clock:
                with patch.object(MODULE.time, 'monotonic', side_effect=clock):
                    result = self._call(work, root, ident, timeout)
            else:
                result = self._call(work, root, ident, timeout)
        return result, calls, work, printed

    def _call(self, work, root, ident, timeout):
        try:
            return MODULE.bootstrap_with_retry(lambda target: ['debootstrap', str(target)], {}, work, root, ident, timeout)
        except MODULE.BootstrapFailure as exc:
            return exc

    def test_connect_in_download_is_retried_on_fresh_root_with_shared_deadline(self):
        result, calls, work, printed = self.run_attempts([('connect', 'validate'), None])
        self.assertEqual(result, {'result': 'success'})
        self.assertEqual(len(calls), 2)
        self.assertLessEqual(calls[1], calls[0])  # never reset
        self.assertTrue((work / 'rootfs-failed-attempt-1').is_dir())
        self.assertTrue(any('Bootstrap attempt' in str(c) for c in printed.call_args_list))

    def test_non_connect_or_late_phase_never_retried(self):
        for outcome in [('DNS', 'download'), ('timeout', 'download'), ('connect', 'configure'), ('dpkg', 'unpack'), ('unknown', 'unknown')]:
            result, calls, _, _ = self.run_attempts([outcome, None])
            self.assertIsInstance(result, MODULE.BootstrapFailure, outcome)
            self.assertEqual(len(calls), 1, outcome)

    def test_attempts_bounded_and_mounts_or_low_budget_stop_retry(self):
        result, calls, _, _ = self.run_attempts([('connect', 'download')] * 3)
        self.assertIsInstance(result, MODULE.BootstrapFailure)
        self.assertEqual(len(calls), MODULE.BOOTSTRAP_ATTEMPTS)
        result, calls, _, _ = self.run_attempts([('connect', 'download'), None], mounts=True)
        self.assertIsInstance(result, MODULE.BootstrapFailure)
        self.assertEqual(len(calls), 1)
        # deadline=0+520; after the failure only 30 s remain -> below retry minimum.
        result, calls, _, _ = self.run_attempts([('connect', 'download'), None], clock=[0, 0, 490, 490, 490])
        self.assertIsInstance(result, MODULE.BootstrapFailure)
        self.assertEqual(len(calls), 1)

    def test_retry_never_deletes(self):
        self.assertNotIn('shutil.rmtree', SOURCE)
        body = SOURCE[SOURCE.index('def bootstrap_with_retry'):SOURCE.index('def bootstrap_environment')]
        self.assertNotIn('unlink', body)
        self.assertIn('os.rename(root', body)


if __name__ == '__main__':
    unittest.main()
