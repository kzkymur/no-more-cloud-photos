                patch.object(MODULE.sys, 'argv', ['wrapper', '--cleanup', 'live']), \
                patch.object(pathlib.Path, 'exists', return_value=False), \
                patch.object(pathlib.Path, 'is_symlink', return_value=False), \
                patch.object(MODULE, 'run') as run:
            self.assertEqual(MODULE.main(), 0)
            run.assert_not_called()

    def test_nonroot_and_nonci_rejected(self):
        with patch.object(MODULE.os, 'geteuid', return_value=1000):
            with self.assertRaisesRegex(RuntimeError, 'root required'):
                MODULE.main()
        with patch.object(MODULE.os, 'geteuid', return_value=0), \
                patch.dict(MODULE.os.environ, {}, clear=True):
            with self.assertRaisesRegex(RuntimeError, 'hosted CI only'):
                MODULE.main()

    def test_host_snapshot_change_fails_without_repair(self):
