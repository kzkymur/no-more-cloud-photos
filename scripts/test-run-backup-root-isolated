#!/usr/bin/env python3
"""Pure mocks and structure checks: no root, provisioning, units or boot."""
import ast
import pathlib
import types
import tempfile
import textwrap
import unittest
from unittest.mock import Mock, patch

SCRIPT = pathlib.Path(__file__).with_name('run-backup-root-isolated')
TEXT = SCRIPT.read_text()
SOURCE = TEXT.split("<<'PY'\n", 1)[1].rsplit('\nPY', 1)[0]
MODULE = types.ModuleType('isolated_wrapper_tests')
exec(compile(SOURCE, str(SCRIPT), 'exec'), MODULE.__dict__)


class Isolation(unittest.TestCase):
    def test_guest_nonzero_exact_propagation(self):
        MODULE.verify_guest_exit(Mock(side_effect=MODULE.sp.CalledProcessError(17, 'guest')))
        for guest in (Mock(), Mock(side_effect=MODULE.sp.CalledProcessError(1, 'guest'))):
            with self.assertRaises(RuntimeError):
                MODULE.verify_guest_exit(guest)

    def test_guest_target_never_host(self):
        for machine in ('', '.host', 'host', 'nmcp-backup-', 'other'):
            with self.assertRaises(RuntimeError):
                MODULE.guest_command(machine, '/repo', ['/binary'])

    def test_test_unit_drain_is_before_pg_cleanup(self):
        r = dict(machine='nmcp-backup-'+'a'*32, repo='/repo', head='a'*40, launcher=123)
        with patch.object(MODULE, 'attest'), patch.object(MODULE, 'save_receipt'), \
                patch.object(MODULE, 'stop_owned_tests', side_effect=RuntimeError('still running')), \
                patch.object(MODULE, 'run') as run:
            with self.assertRaisesRegex(RuntimeError, 'still running'):
                MODULE.teardown_guest(r, pathlib.Path('/not-written'))
            run.assert_not_called()

    def test_test_unit_scope_and_stop_script(self):
        r = dict(machine='nmcp-backup-'+'a'*32, repo='/repo', head='a'*40)
        r['test_units'] = [MODULE.test_unit(r,k) for k in ('timeout','cancel','actual')]
        cmd = MODULE.owned_test_command(r,'actual',['/binary'])
        self.assertIn('--unit='+r['test_units'][-1],cmd)
        self.assertIn('--property=KillMode=control-group',cmd)
        with patch.object(MODULE,'run') as run:
            MODULE.stop_owned_tests(r)
            args=run.call_args.args[0]
            script=args[args.index('-c')+1]
            ast.parse(script)
            for token in ('Transient','FragmentPath','MainPID','populated 0'):
                self.assertIn(token,script)
        r['test_units']=['unrelated.service']
        with patch.object(MODULE,'run') as run:
            with self.assertRaises(RuntimeError):
                MODULE.stop_owned_tests(r)
            run.assert_not_called()

    def test_diagnostics_are_bounded_and_missing_is_safe(self):
        with patch.object(MODULE.os, 'open', side_effect=FileNotFoundError) as opened:
            MODULE.emit_fixture_diagnostics(pathlib.Path('/owned'), pathlib.Path('/owned/rootfs'))
            self.assertEqual(opened.call_count,1)
            self.assertTrue(all(c.args[1] & MODULE.os.O_NOFOLLOW for c in opened.call_args_list))
        st=types.SimpleNamespace(st_mode=MODULE.stat.S_IFREG,st_uid=0,st_nlink=1,st_size=999999)
        with patch.object(MODULE.os,'open',return_value=20), patch.object(MODULE.os,'fstat',return_value=st), \
                patch.object(MODULE.os,'lseek') as seek, patch.object(MODULE.os,'read',return_value=b'diagnostic') as read, \
                patch.object(MODULE.os,'close') as close, patch('builtins.print'):
            MODULE.emit_fixture_diagnostics(pathlib.Path('/owned'),pathlib.Path('/owned/rootfs'))
            self.assertEqual(read.call_count,1)
            self.assertTrue(all(c.args==(20,65536) for c in read.call_args_list))
            seek.assert_called_with(20,999999-65536,MODULE.os.SEEK_SET)
            self.assertEqual(close.call_count,1)
        for uid,mode,links in ((1000,MODULE.stat.S_IFREG,1),(0,MODULE.stat.S_IFIFO,1),(0,MODULE.stat.S_IFREG,2)):
            st=types.SimpleNamespace(st_mode=mode,st_uid=uid,st_nlink=links,st_size=1)
            with patch.object(MODULE.os,'open',return_value=20),patch.object(MODULE.os,'fstat',return_value=st), \
                    patch.object(MODULE.os,'read') as read,patch.object(MODULE.os,'close'):
                with self.assertRaises(RuntimeError):
                    MODULE.emit_fixture_diagnostics(pathlib.Path('/owned'),pathlib.Path('/owned/rootfs'))
                read.assert_not_called()

    def test_bootstrap_closed_enums(self):
        phases = [('I: Retrieving package', 'download'), ('I: Validating package', 'validate'),
                  ('I: Extracting package', 'extract'), ('I: Unpacking package', 'unpack'),
                  ('I: Configuring package', 'configure'), ('not progress', 'unknown')]
        errors = [('Temporary failure in name resolution', 'DNS'),
                  ('Connection refused', 'connect'), ('certificate verification failed', 'TLS'),
                  ('ERROR 503: unavailable', 'HTTP'), ('dpkg: error processing package', 'dpkg'),
                  ('No space left on device', 'disk'), ('unclassified failure', 'unknown')]
        for line, expected in phases:
            self.assertEqual(MODULE.bootstrap_log_enums(line)[0], expected)
        for line, expected in errors:
            self.assertEqual(MODULE.bootstrap_log_enums(line)[1], expected)
        self.assertEqual(MODULE.bootstrap_log_enums('I: Retrieving first\nI: Configuring last')[0], 'configure')

    def test_bootstrap_summary_success_failure_same_identity_no_reflection(self):
        secret = 'SENSITIVE-https://user:password@mirror.invalid/file?token=secret'
        identity = dict(head='a'*40, run='12345', attempt='2', slot='offline')
        for failure, expected in [(None, 'unknown'), (MODULE.sp.TimeoutExpired([secret],900), 'timeout'),
                                  (MODULE.sp.CalledProcessError(1,[secret]), 'DNS'),
                                  (RuntimeError(secret), 'DNS')]:
            with self.subTest(expected=expected), \
                    patch.object(MODULE, 'run_bootstrap', side_effect=failure) as run, \
                    patch.object(MODULE, 'bootstrap_log_tail', return_value=
                        'I: Unpacking '+secret+'\nTemporary failure in name resolution '+secret), \
                    patch.object(MODULE.time, 'monotonic', side_effect=[10.1, 914.9]), \
                    patch('builtins.print') as printed:
                if failure is None:
                    MODULE.observed_bootstrap([secret], {'SECRET':secret}, None, pathlib.Path('/private'), identity, 520)
                else:
                    with self.assertRaises(MODULE.BootstrapFailure) as raised:
                        MODULE.observed_bootstrap([secret], {'SECRET':secret}, None, pathlib.Path('/private'), identity, 520)
                    self.assertNotIn(secret,str(raised.exception))
                run.assert_called_once_with([secret], {'SECRET':secret}, None, timeout=520)
                printed.assert_called_once()
                output = printed.call_args.args[0]
                self.assertNotIn(secret,output)
                summary = MODULE.json.loads(output.removeprefix('Bootstrap diagnostic: '))
                self.assertEqual(set(summary), set(identity)|{'phase','error_class','result',
                    'elapsed_seconds','last_progress_age','capture'})
                for key,value in identity.items(): self.assertEqual(summary[key],value)
                self.assertEqual(summary['phase'],'unpack')
                self.assertEqual(summary['error_class'],expected)
                self.assertEqual(summary['elapsed_seconds'],904)
                self.assertEqual(summary['last_progress_age'],'unknown')
                self.assertEqual(summary['result'],'success' if failure is None else 'failure')

    def test_bootstrap_capture_failure_no_reflection_or_success_authority_change(self):
        identity = dict(head='a'*40,run='1',attempt='1',slot='live')
        with patch.object(MODULE, 'run_bootstrap'), \
                patch.object(MODULE,'bootstrap_log_tail',side_effect=OSError('SECRET unsafe path')), \
                patch('builtins.print') as printed:
            MODULE.observed_bootstrap([],{},None,pathlib.Path('/private'),identity,520)
            value=printed.call_args.args[0]
            self.assertNotIn('SECRET',value)
            summary=MODULE.json.loads(value.removeprefix('Bootstrap diagnostic: '))
            self.assertEqual(summary['capture'],'unavailable')
            self.assertEqual(summary['phase'],'unknown')
            self.assertEqual(summary['result'],'success')
        for key in ('head','run','attempt','slot'):
            bad=dict(identity);bad[key]='SECRET'
            with patch.object(MODULE,'run_bootstrap') as run,patch('builtins.print') as printed:
                with self.assertRaisesRegex(RuntimeError,'invalid bootstrap diagnostic identity'):
                    MODULE.observed_bootstrap([],{},None,pathlib.Path('/private'),bad,520)
                run.assert_not_called();printed.assert_not_called()

    def test_bootstrap_safe_log_tail_fd_ancestry_and_bound(self):
        directory=types.SimpleNamespace(st_mode=MODULE.stat.S_IFDIR|0o700,st_uid=0)
        leaf=types.SimpleNamespace(st_mode=MODULE.stat.S_IFREG|0o644,st_uid=0,st_nlink=1,st_size=999999)
        with patch.object(MODULE,'private_directory') as private, \
                patch.object(MODULE.os,'open',side_effect=[10,11,12,13]) as opened, \
                patch.object(MODULE.os,'fstat',side_effect=[directory,directory,directory,leaf]), \
                patch.object(MODULE.os,'lseek') as seek, \
                patch.object(MODULE.os,'read',return_value=b'partial\nI: Extracting safe\n') as read, \
                patch.object(MODULE.os,'close') as close:
            text=MODULE.bootstrap_log_tail(pathlib.Path('/private'),'rootfs/debootstrap/debootstrap.log')
            self.assertEqual(text,'I: Extracting safe\n')
            private.assert_called_once_with(pathlib.Path('/private'))
            self.assertTrue(all(c.args[1]&MODULE.os.O_NOFOLLOW for c in opened.call_args_list))
            self.assertEqual([c.kwargs.get('dir_fd') for c in opened.call_args_list],[None,10,11,12])
            read.assert_called_once_with(13,65536)
            seek.assert_called_once_with(13,999999-65536,MODULE.os.SEEK_SET)
            self.assertEqual([c.args[0] for c in close.call_args_list],[13,12,11,10])
        with patch.object(MODULE.os,'open') as opened:
            with self.assertRaises(RuntimeError):
                MODULE.bootstrap_log_tail(pathlib.Path('/private'),'../secret')
            opened.assert_not_called()

    def test_bootstrap_safe_log_rejects_metadata_before_read(self):
        directory=types.SimpleNamespace(st_mode=MODULE.stat.S_IFDIR|0o700,st_uid=0)
        for uid, mode, links in [(1000,MODULE.stat.S_IFREG|0o600,1),
                                  (0,MODULE.stat.S_IFIFO|0o600,1),
                                  (0,MODULE.stat.S_IFREG|0o666,1),
                                  (0,MODULE.stat.S_IFREG|0o600,2)]:
            leaf=types.SimpleNamespace(st_mode=mode,st_uid=uid,st_nlink=links,st_size=20)
            with patch.object(MODULE,'private_directory'), \
                    patch.object(MODULE.os,'open',side_effect=[10,11]), \
                    patch.object(MODULE.os,'fstat',side_effect=[directory,leaf]), \
                    patch.object(MODULE.os,'read') as read,patch.object(MODULE.os,'close') as close:
                with self.assertRaises(RuntimeError):
                    MODULE.bootstrap_log_tail(pathlib.Path('/private'),'provision.log')
                read.assert_not_called()
                self.assertEqual(close.call_count,2)

    def test_bootstrap_log_missing_or_symlink_parent_never_reads(self):
        directory=types.SimpleNamespace(st_mode=MODULE.stat.S_IFDIR|0o700,st_uid=0)
        for error in (FileNotFoundError('missing private log'), OSError('symlink parent')):
            with patch.object(MODULE,'private_directory'), \
                    patch.object(MODULE.os,'open',side_effect=[10,error]), \
                    patch.object(MODULE.os,'fstat',return_value=directory), \
                    patch.object(MODULE.os,'read') as read,patch.object(MODULE.os,'close') as close:
                with self.assertRaises(OSError):
                    MODULE.bootstrap_log_tail(pathlib.Path('/private'),'rootfs/debootstrap/debootstrap.log')
                read.assert_not_called();close.assert_called_once_with(10)

    def test_bootstrap_raw_log_and_exception_fallback_removed(self):
        diagnostic=SOURCE[SOURCE.index('def emit_fixture_diagnostics'):SOURCE.index('class BootstrapFailure')]
        self.assertNotIn("work / 'provision.log'",diagnostic)
        self.assertNotIn("root / 'debootstrap/debootstrap.log'",diagnostic)
        self.assertIn('if not isinstance(exc, BootstrapFailure):',SOURCE)
        bootstrap=SOURCE[SOURCE.index('def run_bootstrap'):SOURCE.index('def machine_scope')]
        self.assertNotIn('str(cleanup_error)',bootstrap)
        self.assertNotIn('str(restore_error)',bootstrap)
        self.assertIn('raise sp.TimeoutExpired(argv, timeout)',SOURCE)
        self.assertEqual(MODULE.KEYRING,'/usr/share/keyrings/ubuntu-archive-keyring.gpg')
        self.assertIn("'--keyring=' + KEYRING",SOURCE)

    def test_guest_closure_is_runtime_only(self):
        packages=MODULE.PACKAGES.split(',')
        self.assertEqual(len(packages),len(set(packages)))
        # Never executed in the guest; their closures dominated bootstrap bytes.
        for dropped in ('ffmpeg','libglib2.0-dev','libjpeg-turbo8-dev','libpng-dev','libwebp-dev',
                        'libexif-dev','libde265-dev','libpgm-5.3-0t64','libcdio19t64','libpgm-5.3-0','libcdio19'):
            self.assertNotIn(dropped,packages)
        self.assertFalse([p for p in packages if p.endswith('-dev')])
        # Exactly the shared objects resolved by guest ldd of the bound artifacts.
        for runtime in ('libglib2.0-0t64','libjpeg-turbo8','libpng16-16t64','libwebp7','libwebpmux3',
                        'libwebpdemux2','libsharpyuv0','libexif12','libde265-0','libexpat1','libffi8',
                        'libimage-exiftool-perl','util-linux','python3','systemd-sysv','dbus'):
            self.assertEqual(packages.count(runtime),1)
        ldd=SOURCE[SOURCE.index('executables = [binary'):SOURCE.index("record['test_units']")]
        for tool in ("'nmcp-video-helper'","'ffmpeg'","'ffprobe'","'not found' not in r.stdout"):
            self.assertIn(tool,ldd)
        self.assertNotIn('force-depends',SOURCE)
        self.assertNotIn('--no-check-gpg',SOURCE)

    def test_fresh_minbase_config_directories(self):
        with tempfile.TemporaryDirectory() as temp:
            root=pathlib.Path(temp)/'rootfs'
            root.mkdir()
            MODULE.prepare_guest_config_dirs(root)
            config=root/'etc/sysusers.d/nmcp-ci.conf'
            config.write_text('u postgres - - /var/lib/postgresql /usr/sbin/nologin\n')
            self.assertTrue(config.is_file())
            for rel in ('etc/sysusers.d','etc/postgresql/17','var/lib/systemd/timers'):
                self.assertTrue((root/rel).is_dir())
            MODULE.prepare_guest_config_dirs(root)
        with tempfile.TemporaryDirectory() as temp:
            root=pathlib.Path(temp)/'rootfs';root.mkdir()
            outside=pathlib.Path(temp)/'outside';outside.mkdir()
            (root/'etc').mkdir();(root/'etc/sysusers.d').symlink_to(outside)
            with self.assertRaises(RuntimeError):
                MODULE.prepare_guest_config_dirs(root)
            self.assertEqual(list(outside.iterdir()),[])

    def test_guest_config_symlink_parent_never_creates_external_leaf(self):
        with tempfile.TemporaryDirectory() as temp:
            root=pathlib.Path(temp)/'rootfs';root.mkdir()
            outside=pathlib.Path(temp)/'outside';outside.mkdir()
            (root/'etc').symlink_to(outside)
            with self.assertRaises(RuntimeError):
                MODULE.prepare_guest_config_dirs(root)
            self.assertEqual(list(outside.iterdir()),[])

    def test_entire_preboot_setup_on_fresh_root(self):
        # Execute the real preboot preparation block on a fresh filesystem.
        # Only chown and the privileged sysusers command are mocked; this is
        # prerequisite coverage, not proof of root ownership or guest boot.
        start=SOURCE.index("        require(not any(root.glob('usr/lib/systemd/system/postgresql*'))")
        end=SOURCE.index("        boot = [",start)
        setup=compile(textwrap.dedent(SOURCE[start:end]),str(SCRIPT),'exec')
        with tempfile.TemporaryDirectory() as temp:
            root=pathlib.Path(temp)/'rootfs';root.mkdir()
            repo=SCRIPT.resolve().parent.parent
            def sysusers(command):
                self.assertEqual(command,['/usr/bin/systemd-sysusers','--root='+str(root)])
                config=root/'etc/sysusers.d/nmcp-ci.conf'
                self.assertEqual(config.read_text(),(repo/'infra/ubuntu/sysusers.d/nmcp.conf').read_text()+
                    '\nu postgres - "Private PostgreSQL fixture" /var/lib/postgresql /usr/sbin/nologin\n')
                for rel in ('etc/sysusers.d','etc/postgresql','etc/postgresql/17','var/lib/systemd/timers'):
                    self.assertTrue((root/rel).is_dir())
                for rel in ('etc/postgresql','etc/postgresql/17'):
                    self.assertEqual((root/rel).stat().st_mode & 0o777,0o755)
            with patch.object(MODULE.os,'chown') as chown:
                run=Mock(side_effect=sysusers)
                env=dict(MODULE.__dict__,root=root,repo=repo,run=run)
                exec(setup,env)
                self.assertEqual(chown.call_args_list,[unittest.mock.call(root/'etc/postgresql',0,0),
                    unittest.mock.call(root/'etc/postgresql/17',0,0)])
                run.assert_called_once()
                # Absence of the required checked-out sysusers input fails
                # before any system command, rather than silently omitting UIDs.
                env['repo']=root/'missing-repo';run.reset_mock()
                with self.assertRaises(FileNotFoundError):
                    exec(setup,env)
                run.assert_not_called()

    def test_machine_scope_public_property_and_exact_identity(self):
        machine='nmcp-backup-'+'a'*32
        expected=r'machine-nmcp\x2dbackup\x2d'+'a'*32+'.scope'
        with patch.object(MODULE,'output',return_value=expected) as output:
            self.assertEqual(MODULE.machine_scope(machine),expected)
            output.assert_called_once_with(['/usr/bin/machinectl','show',machine,'--property=Unit','--value'])
        for scope in ('','machine-other.scope',expected.replace('a'*32,'b'*32),
                      expected.replace('.scope','.service'),'machine-'+machine+'.scope'):
            with patch.object(MODULE,'output',return_value=scope):
                with self.assertRaises(RuntimeError):
                    MODULE.machine_scope(machine)
        for machine in ('','.host','host','nmcp-backup-not-a-uuid'):
            with patch.object(MODULE,'output') as output:
                with self.assertRaises(RuntimeError):
                    MODULE.machine_scope(machine)
                output.assert_not_called()

    def test_private_bootstrap_transport_configuration(self):
        with tempfile.TemporaryDirectory() as temp, patch.object(MODULE,'private_directory') as private:
            work=pathlib.Path(temp)
            env=MODULE.bootstrap_environment(work)
            private.assert_called_once_with(work)
            config=work/'wgetrc'
            self.assertEqual(config.stat().st_mode & 0o777,0o600)
            self.assertEqual(config.read_text(),'dns_timeout = 10\nconnect_timeout = 10\nread_timeout = 30\n'
                             'tries = 3\nwaitretry = 1\ncheck_certificate = on\n')
            self.assertEqual(env,dict(MODULE.HOST_ENV,WGETRC=str(config)))
            self.assertNotIn('WGETRC',MODULE.HOST_ENV)
            self.assertNotIn('WGETRC',MODULE.KEYS)
            with self.assertRaises(FileExistsError):
                MODULE.bootstrap_environment(work)

    def test_bootstrap_timeout_group_identity_and_reaping(self):
        parent=MODULE.os.getpid()
        initial=(parent,99,99,'start')
        for current in (initial,(parent,99,99,'reused'),(parent,98,99,'start'),(parent,99,98,'start'),(parent+1,99,99,'start'),None):
            proc=Mock(pid=99,returncode=None)
            timeout=MODULE.sp.TimeoutExpired(['debootstrap'],900)
            with patch.object(MODULE.sp,'Popen',return_value=proc) as popen, \
                    patch.object(MODULE,'bootstrap_identity',side_effect=[initial,current]), \
                    patch.object(MODULE,'observe_bootstrap_exit',side_effect=timeout), \
                    patch.object(MODULE.os,'killpg') as kill,patch.object(MODULE,'reap_bootstrap_group'),patch('builtins.print'):
                with self.assertRaises(MODULE.sp.TimeoutExpired) as raised:
                    MODULE.run_bootstrap(['debootstrap'],{'WGETRC':'/private/wgetrc'},None,900)
                self.assertIs(raised.exception,timeout)
                self.assertTrue(popen.call_args.kwargs['start_new_session'])
                if current==initial:
                    kill.assert_called_once_with(99,MODULE.signal.SIGKILL)
                    proc.wait.assert_called_once_with(timeout=30)
                else:
                    kill.assert_not_called()
                    proc.wait.assert_not_called()

    def test_bootstrap_lost_wait_ownership_never_signals(self):
        proc=Mock(pid=99,returncode=None)
        with patch.object(MODULE.sp,'Popen',return_value=proc), \
                patch.object(MODULE,'bootstrap_identity',return_value=(MODULE.os.getpid(),99,99,'start')), \
                patch.object(MODULE,'observe_bootstrap_exit',side_effect=ChildProcessError), \
                patch.object(MODULE.os,'killpg') as kill,patch('builtins.print'):
            with self.assertRaises(ChildProcessError): MODULE.run_bootstrap(['fake'],{},None,900)
            kill.assert_not_called()
            proc.wait.assert_not_called()
        with patch.object(MODULE.signal,'getsignal',return_value=MODULE.signal.SIG_IGN),patch.object(MODULE.sp,'Popen') as launch:
            with self.assertRaises(RuntimeError): MODULE.run_bootstrap(['fake'],{},None,900)
            launch.assert_not_called()
        with patch.object(MODULE.Path,'iterdir',return_value=iter([1,2])),patch.object(MODULE.sp,'Popen') as launch:
            with self.assertRaises(RuntimeError): MODULE.run_bootstrap(['fake'],{},None,900)
            launch.assert_not_called()

    def test_actual_exited_bootstrap_leader_retains_cleanup_authority(self):
        before=MODULE.child_subreaper()
        program="""import os,signal,time,pathlib,sys
r,w=os.pipe()
p=os.fork()
if p==0:
 os.close(r)
 signal.signal(signal.SIGTERM,signal.SIG_IGN)
 pathlib.Path(sys.argv[1]).write_text(str(os.getpid()))
 os.write(w,b'1');os.close(w)
 time.sleep(90)
else:
 os.close(w);os.read(r,1);os.close(r)
 code=int(sys.argv[2])
 if code<0: os.kill(os.getpid(),-code)
 os._exit(code)
"""
        for code in (0,23,-15):
            with self.subTest(exit_code=code),tempfile.TemporaryDirectory() as temp:
                child=pathlib.Path(temp)/'child.pid'
                unrelated=MODULE.sp.Popen(['/usr/bin/python3','-c','import time;time.sleep(30)'],start_new_session=True)
                sentinel=MODULE.process_identity(unrelated.pid)
                real_kill=MODULE.os.killpg
                pins=[]
                def checked_kill(pgid,sig):
                    if sig==MODULE.signal.SIGKILL:
                        # This is a real zombie/direct child, deliberately not reaped.
                        identity=MODULE.bootstrap_identity(pgid)
                        self.assertEqual(identity[:3],(MODULE.os.getpid(),pgid,pgid))
                        status=MODULE.os.waitid(MODULE.os.P_PID,pgid,MODULE.os.WEXITED|MODULE.os.WNOHANG|MODULE.os.WNOWAIT)
                        self.assertEqual(status.si_status,abs(code))
                        self.assertEqual(status.si_code,MODULE.os.CLD_EXITED if code>=0 else MODULE.os.CLD_KILLED)
                        pins.append(pgid)
                    return real_kill(pgid,sig)
                try:
                    with patch.object(MODULE.os,'killpg',side_effect=checked_kill):
                        if code:
                            with self.assertRaises(MODULE.sp.CalledProcessError) as raised:
                                MODULE.run_bootstrap(['/usr/bin/python3','-c',program,str(child),str(code)],MODULE.HOST_ENV,None,timeout=5)
                            self.assertEqual(raised.exception.returncode,code)
                        else:
                            MODULE.run_bootstrap(['/usr/bin/python3','-c',program,str(child),str(code)],MODULE.HOST_ENV,None,timeout=5)
                    self.assertEqual(len(pins),1)
                    self.assertIsNone(MODULE.process_identity(pins[0]))
                    self.assertIsNone(MODULE.process_identity(int(child.read_text())))
                    self.assertEqual(MODULE.process_identity(unrelated.pid),sentinel)
                    self.assertIsNone(unrelated.poll())
                    self.assertEqual(MODULE.child_subreaper(),before)
                finally:
                    unrelated.terminate();unrelated.wait(timeout=5)

    def test_bootstrap_deferred_default_and_returning_handlers_cancel(self):
        previous=MODULE.signal.getsignal(MODULE.signal.SIGTERM)
        for handler in (MODULE.signal.SIG_DFL,lambda *_: None,MODULE.signal.SIG_IGN):
            injected=False
            def identity(pid):
                nonlocal injected
                if not injected:
                    injected=True
                    MODULE.signal.raise_signal(MODULE.signal.SIGTERM)
                return (MODULE.os.getpid(),99,99,'start')
            try:
                MODULE.signal.signal(MODULE.signal.SIGTERM,handler)
                with patch.object(MODULE.sp,'Popen',return_value=Mock(pid=99,returncode=None)), \
                        patch.object(MODULE,'bootstrap_identity',side_effect=identity), \
                        patch.object(MODULE,'observe_bootstrap_exit',return_value=0), \
                        patch.object(MODULE,'stop_bootstrap_group') as stop:
                    if handler==MODULE.signal.SIG_IGN:
                        MODULE.run_bootstrap(['fake'],{},None,900)
                    else:
                        with self.assertRaisesRegex(RuntimeError,'interrupted during acquisition'):
                            MODULE.run_bootstrap(['fake'],{},None,900)
                    stop.assert_called_once()
                self.assertEqual(MODULE.signal.getsignal(MODULE.signal.SIGTERM),handler)
            finally:
                MODULE.signal.signal(MODULE.signal.SIGTERM,previous)

    def test_bootstrap_partial_handler_install_restores(self):
        saved={sig:MODULE.signal.getsignal(sig) for sig in (MODULE.signal.SIGTERM,MODULE.signal.SIGINT)}
        real_signal=MODULE.signal.signal
        def install(sig,handler):
            if sig==MODULE.signal.SIGINT and getattr(handler,'__name__','')=='defer_cancel':
                raise RuntimeError('install refused')
            return real_signal(sig,handler)
        with patch.object(MODULE.signal,'signal',side_effect=install),patch.object(MODULE.sp,'Popen') as launch:
            with self.assertRaisesRegex(RuntimeError,'install refused'): MODULE.run_bootstrap(['fake'],{},None,900)
            launch.assert_not_called()
        for sig,handler in saved.items(): self.assertEqual(MODULE.signal.getsignal(sig),handler)

    def test_bootstrap_cancel_during_final_restore_cannot_succeed(self):
        saved=MODULE.signal.getsignal(MODULE.signal.SIGTERM)
        def reaper(value=None):
            if value==0:
                MODULE.signal.raise_signal(MODULE.signal.SIGTERM)
            return 0
        try:
            MODULE.signal.signal(MODULE.signal.SIGTERM,MODULE.signal.SIG_DFL)
            with patch.object(MODULE,'child_subreaper',side_effect=reaper), \
                    patch.object(MODULE.sp,'Popen',return_value=Mock(pid=99,returncode=None)), \
                    patch.object(MODULE,'bootstrap_identity',return_value=(MODULE.os.getpid(),99,99,'start')), \
                    patch.object(MODULE,'observe_bootstrap_exit',return_value=0), \
                    patch.object(MODULE,'stop_bootstrap_group') as stop:
                with self.assertRaisesRegex(RuntimeError,'interrupted during acquisition'):
                    MODULE.run_bootstrap(['fake'],{},None,900)
                stop.assert_called_once()
            self.assertEqual(MODULE.signal.getsignal(MODULE.signal.SIGTERM),MODULE.signal.SIG_DFL)
        finally:
            MODULE.signal.signal(MODULE.signal.SIGTERM,saved)

    def test_actual_bootstrap_capture_cancel_reaps_own_descendant(self):
        self.actual_bootstrap_cancel_at_phase('capture')

    def test_actual_bootstrap_cleanup_cancel_reaps_own_descendant(self):
        self.actual_bootstrap_cancel_at_phase('cleanup')

    def actual_bootstrap_cancel_at_phase(self,phase):
        previous=MODULE.child_subreaper(True)
        saved=MODULE.signal.getsignal(MODULE.signal.SIGTERM)
        replayed=False
        injected=False
        created=[]
        real_popen=MODULE.sp.Popen
        real_identity=MODULE.bootstrap_identity
        child_pid=None
        child_start=None
        initial=None
        captured=False
        real_kill=MODULE.os.killpg
        def cancel(*_):
            nonlocal replayed
            if phase=='cleanup':
                self.assertIsNone(MODULE.process_identity(created[0].pid))
                self.assertIsNone(MODULE.process_identity(child_pid))
            replayed=True
            raise RuntimeError('controlled acquisition cancel')
        def checked_kill(pgid,sig):
            nonlocal injected
            if phase=='cleanup' and sig==MODULE.signal.SIGKILL and not injected:
                injected=True
                MODULE.signal.raise_signal(MODULE.signal.SIGTERM)
                self.assertFalse(replayed,'cancellation unwound owned cleanup')
            return real_kill(pgid,sig)
        def launch(*args,**kwargs):
            proc=real_popen(*args,**kwargs)
            created.append(proc)
            return proc
        with tempfile.TemporaryDirectory() as temp:
            child=pathlib.Path(temp)/'child.pid'
            program="""import os,signal,time,pathlib,sys
r,w=os.pipe();p=os.fork()
if p==0:
 os.close(r);signal.signal(signal.SIGTERM,signal.SIG_IGN)
 pathlib.Path(sys.argv[1]).write_text(str(os.getpid()));pathlib.Path(sys.argv[1]+'.ready').touch()
 os.write(w,b'1');os.close(w);time.sleep(90)
else:
 os.close(w);os.read(r,1);os.close(r)
 if sys.argv[2]=='cleanup': os._exit(0)
 time.sleep(90)
"""
            unrelated=real_popen(['/usr/bin/python3','-c','import time;time.sleep(30)'],start_new_session=True)
            sentinel=MODULE.process_identity(unrelated.pid)
            def identity(pid):
                nonlocal injected,child_pid,child_start,initial,captured
                result=real_identity(pid)
                if not captured:
                    captured=True
                    initial=result
                    deadline=MODULE.time.monotonic()+5
                    while not pathlib.Path(str(child)+'.ready').exists() and MODULE.time.monotonic()<deadline:
                        MODULE.time.sleep(0.02)
                    self.assertTrue(pathlib.Path(str(child)+'.ready').exists())
                    child_pid=int(child.read_text())
                    child_start=MODULE.process_identity(child_pid)
                    if phase=='capture':
                        injected=True
                        MODULE.signal.raise_signal(MODULE.signal.SIGTERM)
                        self.assertFalse(replayed,'cancellation unwound ownership capture')
                return result
            try:
                MODULE.signal.signal(MODULE.signal.SIGTERM,cancel)
                with patch.object(MODULE.sp,'Popen',side_effect=launch),patch.object(MODULE,'bootstrap_identity',side_effect=identity),patch.object(MODULE.os,'killpg',side_effect=checked_kill):
                    with self.assertRaisesRegex(RuntimeError,'controlled acquisition cancel'):
                        MODULE.run_bootstrap(['/usr/bin/python3','-c',program,str(child),phase],MODULE.HOST_ENV,None,timeout=5)
                self.assertTrue(replayed)
                self.assertIsNone(MODULE.process_identity(created[0].pid))
                self.assertIsNone(MODULE.process_identity(child_pid))
                self.assertEqual(MODULE.process_identity(unrelated.pid),sentinel)
                self.assertIsNone(unrelated.poll())
                self.assertEqual(MODULE.signal.getsignal(MODULE.signal.SIGTERM),cancel)
                self.assertEqual(MODULE.child_subreaper(),1)
            finally:
                MODULE.signal.signal(MODULE.signal.SIGTERM,saved)
                # Failure hygiene is limited to this test's retained direct
                # session leader, or its individually attested adopted child.
                for proc in created:
                    if proc.returncode is None and initial is not None and real_identity(proc.pid)==initial:
                        MODULE.os.killpg(proc.pid,MODULE.signal.SIGKILL)
                        proc.wait(timeout=5)
                        MODULE.reap_bootstrap_group(proc.pid)
                if child_pid is not None and MODULE.process_identity(child_pid)==child_start:
                    identity_now=real_identity(child_pid)
                    if identity_now is not None and identity_now[0]==MODULE.os.getpid():
                        MODULE.os.kill(child_pid,MODULE.signal.SIGKILL)
                        MODULE.os.waitpid(child_pid,0)
                unrelated.terminate();unrelated.wait(timeout=5)
                MODULE.child_subreaper(previous)

    def test_actual_bootstrap_timeout_reaps_own_descendant(self):
        before=MODULE.child_subreaper()
        with tempfile.TemporaryDirectory() as temp:
            child=pathlib.Path(temp)/'child.pid'
            program="import os,signal,time,pathlib,sys; p=os.fork(); signal.signal(signal.SIGTERM,signal.SIG_IGN); (pathlib.Path(sys.argv[1]).write_text(str(os.getpid())),pathlib.Path(sys.argv[1]+'.ready').touch()) if p==0 else None; time.sleep(90)"
            unrelated=MODULE.sp.Popen(['/usr/bin/python3','-c','import time; time.sleep(30)'],start_new_session=True)
            try:
                with self.assertRaises(MODULE.sp.TimeoutExpired):
                    MODULE.run_bootstrap(['/usr/bin/python3','-c',program,str(child)],MODULE.HOST_ENV,None,timeout=1)
                pid=int(child.read_text())
                self.assertIsNone(MODULE.process_identity(pid))
                self.assertIsNone(unrelated.poll(),'another session was affected')
                self.assertEqual(MODULE.child_subreaper(),before)
            finally:
                unrelated.terminate()
                unrelated.wait(timeout=5)

    def test_actual_bootstrap_cancel_reaps_own_descendant(self):
        with tempfile.TemporaryDirectory() as temp:
            child=pathlib.Path(temp)/'child.pid'
            program="import os,signal,time,pathlib,sys; p=os.fork(); signal.signal(signal.SIGTERM,signal.SIG_IGN); (pathlib.Path(sys.argv[1]).write_text(str(os.getpid())),pathlib.Path(sys.argv[1]+'.ready').touch()) if p==0 else None; time.sleep(90)"
            worker="""import runpy,signal,sys
m=runpy.run_path(sys.argv[1])['MODULE']
before=m.child_subreaper()
def cancel(*args): raise RuntimeError('controlled cancel')
signal.signal(signal.SIGTERM,cancel)
try: m.run_bootstrap(['/usr/bin/python3','-c',sys.argv[2],sys.argv[3]],m.HOST_ENV,None,timeout=15)
except RuntimeError:
    assert m.child_subreaper()==before
    sys.exit(37)
sys.exit(1)
"""
            proc=MODULE.sp.Popen(['/usr/bin/python3','-c',worker,str(pathlib.Path(__file__).resolve()),program,str(child)],
                                 stdout=MODULE.sp.PIPE,stderr=MODULE.sp.STDOUT,text=True)
            try:
                deadline=MODULE.time.monotonic()+5
                ready=pathlib.Path(str(child)+'.ready')
                while not ready.exists() and proc.poll() is None and MODULE.time.monotonic()<deadline:
                    MODULE.time.sleep(0.02)
                self.assertTrue(ready.exists(),'controlled descendant failed to start')
                pid=int(child.read_text())
                proc.send_signal(MODULE.signal.SIGTERM)
                output=proc.communicate(timeout=20)[0]
                self.assertEqual(proc.returncode,37,output)
                self.assertIn('Owned bootstrap process group absent and children reaped',output)
                self.assertIsNone(MODULE.process_identity(pid))
            finally:
                if proc.poll() is None:
                    proc.terminate()
                    proc.communicate(timeout=20)

