#!/usr/bin/env bash
# shellcheck disable=SC2317 # trap-dispatched handlers are reached indirectly
set -euo pipefail
umask 0077

[[ $EUID -eq 0 ]] || {
  printf 'run-ubuntu-migration-compatibility: must run as root\n' >&2
  exit 1
}
[[ $# -ge 3 ]] || {
  printf 'usage: run-ubuntu-migration-compatibility ADMIN migrate SUBCOMMAND [ARG...]\n' >&2
  exit 2
}
admin=$1
shift
[[ -f $admin && ! -L $admin && -x $admin ]] || {
  printf 'run-ubuntu-migration-compatibility: unsafe admin binary\n' >&2
  exit 1
}

role_mode=/usr/local/libexec/nmcp/set-ubuntu-migration-role-mode
migration_status=0
signal_status=0
finalized=false
child_pid=
finalize() {
  local exit_status=$1 harden_status=0 result
  [[ $finalized == false ]] || return
  finalized=true
  trap - EXIT INT TERM
  "$role_mode" hardened || harden_status=$?
  if ((signal_status != 0)); then
    result=$signal_status
  elif ((migration_status != 0)); then
    result=$migration_status
  elif ((exit_status != 0)); then
    result=$exit_status
  else
    result=$harden_status
  fi
  exit "$result"
}
stop_child() {
  local signal=$1 attempt grace_attempts=${NMCP_TEST_SIGNAL_GRACE_ATTEMPTS:-250}
  [[ $grace_attempts =~ ^[1-9][0-9]{0,2}$ ]] || grace_attempts=250
  [[ -n $child_pid ]] || return 0
  if /usr/bin/kill -0 -- "-$child_pid" 2>/dev/null; then
    /usr/bin/kill -s "$signal" -- "-$child_pid" 2>/dev/null || true
    for ((attempt=1; attempt<=grace_attempts; attempt++)); do
      /usr/bin/kill -0 -- "-$child_pid" 2>/dev/null || break
      /usr/bin/sleep 0.1
    done
    if /usr/bin/kill -0 -- "-$child_pid" 2>/dev/null; then
      /usr/bin/kill -KILL -- "-$child_pid" 2>/dev/null || true
    fi
  fi
  wait "$child_pid" 2>/dev/null || true
  child_pid=
}
on_int() {
  trap - INT TERM
  signal_status=130
  stop_child INT
  exit 130
}
on_term() {
  trap - INT TERM
  signal_status=143
  stop_child TERM
  exit 143
}

# Arm cleanup before the first compatibility transition. Hardened mode is
# idempotent, so even a failed preflight takes the same fail-closed exit path.
trap 'finalize "$?"' EXIT
trap on_int INT
trap on_term TERM
"$role_mode" compatibility

set +e
/usr/bin/setsid /usr/bin/setpriv --reuid=nmcp --regid=nmcp --init-groups --no-new-privs \
  "$admin" "$@" &
child_pid=$!
wait "$child_pid"
migration_status=$?
child_pid=
set -e
exit "$migration_status"
