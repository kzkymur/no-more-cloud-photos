#!/usr/bin/env python3
"""Require consecutive API readiness and active production units."""

import argparse
import subprocess
import sys
import time
import urllib.request


def active(unit: str) -> bool:
    return subprocess.run(
        ["/usr/bin/systemctl", "is-active", "--quiet", unit], check=False
    ).returncode == 0


def ready(url: str, timeout: float) -> bool:
    request = urllib.request.Request(url, headers={"Accept": "application/json"})
    try:
        with urllib.request.urlopen(request, timeout=timeout) as response:
            return response.status == 200 and response.read() == b'{"status":"ok"}\n'
    except OSError:
        return False


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--postgresql-unit", required=True)
    parser.add_argument("--api-url", default="http://127.0.0.1:8080/readyz")
    parser.add_argument("--consecutive", type=int, default=5)
    parser.add_argument("--interval", type=float, default=1.0)
    parser.add_argument("--attempts", type=int, default=30)
    parser.add_argument(
        "--unit", action="append", dest="units",
    )
    args = parser.parse_args()
    if args.consecutive < 1 or args.attempts < args.consecutive or args.interval < 0:
        parser.error("invalid stability window")
    units = [*(args.units or [
        "nmcp-api.service", "nmcp-worker.service", "nmcp-files.service", "nmcp.target"
    ]), args.postgresql_unit]
    stable = 0
    last_failed: list[str] = []
    for attempt in range(args.attempts):
        last_failed = [unit for unit in units if not active(unit)]
        if not last_failed and ready(args.api_url, max(1.0, args.interval + 0.5)):
            stable += 1
            if stable >= args.consecutive:
                print(f"Ubuntu services stable for {stable} consecutive checks")
                return 0
        else:
            stable = 0
        if attempt + 1 < args.attempts:
            time.sleep(args.interval)
    detail = ", ".join(last_failed) if last_failed else "API readiness"
    print(f"check-ubuntu-services: stability gate failed: {detail}", file=sys.stderr)
    return 1


if __name__ == "__main__":
    sys.exit(main())
