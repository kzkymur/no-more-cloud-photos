#!/usr/bin/env bash
set -euo pipefail

[[ $# -gt 0 ]] || { printf 'usage: %s COMMAND [ARG ...]\n' "$0" >&2; exit 2; }

repo=$(cd -- "$(dirname -- "$0")/.." && pwd)
state=${NMCP_VALIDATION_STATE_DIR:-$repo/.validation}
data=$state/postgresql/data
log=$state/postgresql/postgresql.log
socket=${NMCP_POSTGRES_SOCKET_DIR:-/tmp/nmcp-postgres-$(printf %s "$repo" | sha256sum | cut -c1-12)}
bin=${NMCP_POSTGRES_BIN:-$(pg_config --bindir)}
share=${NMCP_POSTGRES_SHARE:-$(pg_config --sharedir)}
if [[ -n ${NMCP_POSTGRES_LIB:-} ]]; then
  export LD_LIBRARY_PATH="$NMCP_POSTGRES_LIB${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
fi
export PATH="$bin:$PATH"

mkdir -p "$(dirname -- "$data")" "$socket"
exec 9>"$state/postgresql.lock"
flock -n 9 || { printf 'another local PostgreSQL validation owns %s\n' "$state" >&2; exit 1; }
chmod 0700 "$socket"
if [[ ! -s $data/PG_VERSION ]]; then
  rm -rf -- "$data"
  "$bin/initdb" -D "$data" -L "$share" --no-locale --encoding=UTF8 \
    --auth-local=trust --auth-host=trust --username=nmcp
fi

stop() {
  "$bin/pg_ctl" -D "$data" -m fast -w stop >/dev/null 2>&1 || true
  rm -rf -- "$socket"
}
trap stop EXIT INT TERM
"$bin/pg_ctl" -D "$data" -l "$log" \
  -o "-c listen_addresses='' -k $socket -F" -w start
if ! "$bin/psql" -h "$socket" -U nmcp -d postgres -Atqc \
  "SELECT 1 FROM pg_database WHERE datname = 'nmcp_test'" | grep -qx 1; then
  "$bin/createdb" -h "$socket" -U nmcp nmcp_test
fi
export TEST_DATABASE_URL="postgresql://nmcp@/nmcp_test?host=$socket"
"$@"
