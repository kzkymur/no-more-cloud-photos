#!/usr/bin/env python3
"""Copy root-controlled regular inputs through already-validated file descriptors."""

import os
import pathlib
import shutil
import stat
import sys


def fail(message: str) -> None:
    raise ValueError(message)


def trusted_directory(path: pathlib.Path) -> None:
    current = pathlib.Path("/")
    for part in path.parts[1:]:
        current /= part
        info = current.lstat()
        if not stat.S_ISDIR(info.st_mode) or stat.S_ISLNK(info.st_mode):
            fail(f"untrusted non-directory path component: {current}")
        if info.st_uid != 0 or info.st_mode & (stat.S_IWGRP | stat.S_IWOTH):
            fail(f"path component must be root-owned and not group/world-writable: {current}")


def capture(source_text: str, destination: pathlib.Path) -> None:
    source = pathlib.Path(source_text)
    if not source.is_absolute():
        fail(f"input path must be absolute: {source}")
    if source != pathlib.Path(os.path.normpath(source)):
        fail(f"input path must be normalized: {source}")
    trusted_directory(source.parent)
    descriptor = os.open(source, os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW)
    try:
        info = os.fstat(descriptor)
        if not stat.S_ISREG(info.st_mode) or info.st_uid != 0:
            fail(f"input must be a root-owned regular file: {source}")
        if info.st_mode & (stat.S_IWGRP | stat.S_IWOTH):
            fail(f"input must not be group/world-writable: {source}")
        output = os.open(destination, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_CLOEXEC, 0o600)
        try:
            with os.fdopen(os.dup(descriptor), "rb") as reader, os.fdopen(output, "wb") as writer:
                shutil.copyfileobj(reader, writer)
                writer.flush()
                os.fsync(writer.fileno())
        except BaseException:
            try:
                os.close(output)
            except OSError:
                pass
            raise
    finally:
        os.close(descriptor)


def main() -> int:
    if len(sys.argv) < 4 or (len(sys.argv) - 2) % 2:
        print("usage: capture-trusted-inputs DEST SOURCE NAME [SOURCE NAME ...]", file=sys.stderr)
        return 2
    destination = pathlib.Path(sys.argv[1])
    info = destination.lstat()
    if not stat.S_ISDIR(info.st_mode) or info.st_uid != 0 or stat.S_IMODE(info.st_mode) != 0o700:
        fail("destination must already be a root-owned mode-0700 directory")
    names = sys.argv[3::2]
    if len(names) != len(set(names)) or any(not name or "/" in name or name in (".", "..") for name in names):
        fail("destination names must be unique basenames")
    for source, name in zip(sys.argv[2::2], names):
        capture(source, destination / name)
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (OSError, ValueError) as error:
        print(f"capture-trusted-inputs: {error}", file=sys.stderr)
        sys.exit(1)
