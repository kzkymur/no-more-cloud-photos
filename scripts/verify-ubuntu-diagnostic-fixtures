#!/usr/bin/env python3
"""Unprivileged causal fixtures for closed diagnostics and cgroup snapshots."""

import errno
import fcntl
import io
import json
import os
import pathlib
import runpy
import signal
import stat
import subprocess
import tempfile
import threading
import types


ROOT = pathlib.Path(__file__).resolve().parent
CLIENT_PATH = ROOT / "verify-ubuntu-migration-role-client"
CONTAINMENT_PATH = ROOT / "verify-ubuntu-migration-role-containment"
SUPERVISOR_PATH = ROOT / "verify-ubuntu-migration-role-supervisor"
SECRET = "nonce-0123456789abcdef" * 4
HOSTILE_PATH = "/hostile/" + SECRET
HOSTILE_ARGV = ("/hostile/program", "--secret=" + SECRET)


def require(condition, message):
    if not condition:
        raise RuntimeError(message)


def injected(number=errno.EACCES):
    error = OSError(number, "hostile " + SECRET, HOSTILE_PATH)
    error.filename2 = "second-" + SECRET
    return error


def assert_safe(error, expected):
    rendered = str(error)
    require(rendered == expected, f"wrong closed diagnostic: {rendered!r}")
    require("\n" not in rendered and len(rendered) < 128, "diagnostic is multiline or unbounded")
    require(SECRET not in rendered and HOSTILE_PATH not in rendered
            and not any(argument in rendered for argument in HOSTILE_ARGV),
            "diagnostic leaked injected state")


def assert_raises(function, expected):
    try:
        function()
    except RuntimeError as error:
        assert_safe(error, expected)
    else:
        raise RuntimeError("injected boundary unexpectedly succeeded")


def assert_fails_with(function, expected):
    try:
        function()
    except RuntimeError as error:
        require(str(error) == expected, f"wrong causal failure: {error!s}")
    else:
        raise RuntimeError("causal fixture unexpectedly succeeded")


def capture_final(client):
    globals_ = client["capture_final_cgroup_evidence"].__globals__
    held = globals_["CLIENT_LOCK_HELD"]
    globals_["CLIENT_LOCK_HELD"] = True
    try:
        return client["capture_final_cgroup_evidence"]()
    finally:
        globals_["CLIENT_LOCK_HELD"] = held


class FakeFile:
    def __init__(self, payload):
        self.payload = payload

    def __enter__(self):
        return self

    def __exit__(self, *_args):
        return False

    def fileno(self):
        return 91

    def read(self):
        return self.payload

    def close(self):
        return None


class FakeCounter(FakeFile):
    def __init__(self, payload):
        super().__init__(payload)
        self.close_calls = 0

    def seek(self, _offset):
        return 0

    def truncate(self):
        return 0

    def write(self, value):
        return len(value)

    def flush(self):
        return None

    def close(self):
        self.close_calls += 1
        return None


def directory(inode):
    return types.SimpleNamespace(st_mode=stat.S_IFDIR | 0o755, st_dev=7, st_ino=inode)


def regular(inode=20):
    return types.SimpleNamespace(st_mode=stat.S_IFREG | 0o444, st_dev=7, st_ino=inode)


def cgroup_case(namespace, kind):
    function = namespace["cgroup_pids"]
    globals_ = function.__globals__
    module_os = globals_["os"]
    original_open = globals_.get("open")
    originals = module_os.lstat, module_os.walk, module_os.fstat
    root_calls = 0
    open_calls = 0
    walk_calls = 0
    read_calls = 0
    child_calls = 0
    fstat_calls = 0
    phase = "prelaunch" if "prelaunch" in namespace["DIAGNOSTIC_PHASES"] else "preflight"

    def fake_lstat(path):
        nonlocal root_calls, child_calls
        if path.endswith("/fixture"):
            root_calls += 1
            if kind == "initial-root-nondirectory" and root_calls == 1:
                return regular(10)
            if kind == "root-becomes-nondirectory" and root_calls == 3:
                return regular(10)
            if kind == "root-disappears" and root_calls > 1:
                raise FileNotFoundError(errno.ENOENT, SECRET, HOSTILE_PATH)
            if kind == "same-attempt-root-reuse" and root_calls >= 3:
                return directory(99)
            if kind == "cross-attempt-root-reuse" and root_calls >= 5:
                return directory(99)
            if kind == "transient-root-residue" and root_calls in (5, 6):
                raise FileNotFoundError(errno.ENOENT, SECRET, HOSTILE_PATH)
            if kind == "two-absent-root-observations" and root_calls in (5, 6, 7, 8):
                raise FileNotFoundError(errno.ENOENT, SECRET, HOSTILE_PATH)
            if kind in ("empty-root-removal", "residue-root-removal") and root_calls >= 5:
                raise FileNotFoundError(errno.ENOENT, SECRET, HOSTILE_PATH)
            if kind == "partial-residue-root-removal" and root_calls >= 3:
                raise FileNotFoundError(errno.ENOENT, SECRET, HOSTILE_PATH)
            if kind == "absent-live-recheck-absent" and root_calls in (5, 6, 7, 9, 10):
                raise FileNotFoundError(errno.ENOENT, SECRET, HOSTILE_PATH)
            if kind == "complete-absent-complete" and root_calls in (5, 6):
                raise FileNotFoundError(errno.ENOENT, SECRET, HOSTILE_PATH)
            return directory(10)
        if path.endswith("/child"):
            child_calls += 1
            if kind == "final-directory-recheck-mismatch" and child_calls == 3:
                return directory(99)
            if kind == "directory-becomes-nondirectory" and child_calls == 3:
                return regular(11)
            return directory(11)
        if kind == "child-disappears" and path.endswith("/gone"):
            raise FileNotFoundError(errno.ENOENT, SECRET, HOSTILE_PATH)
        if kind == "nondirectory-child" and path.endswith("/bad"):
            return regular(31)
        return directory(11)

    def fake_walk(root, **kwargs):
        nonlocal walk_calls
        del kwargs
        walk_calls += 1
        if kind == "reordered-topology":
            children = ((root + "/a", [], ["cgroup.procs"]),
                        (root + "/b", [], ["cgroup.procs"]))
            return iter(((root, ["a", "b"], []), *(children if walk_calls % 2 else reversed(children))))
        if kind == "renamed-same-inode":
            name = "a" if walk_calls == 1 else "b"
            return iter(((root, [name], []), (root + "/" + name, [], ["cgroup.procs"])))
        if kind == "child-disappears":
            return iter(((root, ["gone"], []),))
        if kind == "nondirectory-child":
            return iter(((root, ["bad"], []),))
        if kind in ("final-directory-recheck-mismatch", "directory-becomes-nondirectory"):
            return iter(((root, ["child"], []),
                         (root + "/child", [], ["cgroup.procs"])))
        return iter(((root, [], ["cgroup.procs"]),))

    def fake_open(_path, **_kwargs):
        nonlocal open_calls, read_calls
        open_calls += 1
        if (kind in ("root-disappears", "file-disappears")
                or kind == "cross-attempt-root-reuse" and open_calls == 1):
            raise FileNotFoundError(errno.ENOENT, SECRET, HOSTILE_PATH)
        if kind == "transient-file-residue" and open_calls == 1:
            raise FileNotFoundError(errno.ENOENT, SECRET, HOSTILE_PATH)
        if kind == "complete-interrupted-complete" and open_calls == 2:
            raise FileNotFoundError(errno.ENOENT, SECRET, HOSTILE_PATH)
        if kind == "changing-pids":
            read_calls += 1
            return FakeFile("17\n" if read_calls == 1 else "23\n")
        if kind == "malformed-pids":
            return FakeFile("17 hostile\n")
        return FakeFile("17 23\n" if kind in (
            "residue", "transient-file-residue", "transient-root-residue",
            "two-absent-root-observations", "residue-root-removal",
            "partial-residue-root-removal") else "")

    def fake_fstat(_descriptor):
        nonlocal fstat_calls
        fstat_calls += 1
        if kind == "before-after-fstat-mismatch":
            return regular(20 if fstat_calls % 2 else 21)
        return regular()

    module_os.lstat = fake_lstat
    module_os.walk = fake_walk
    module_os.fstat = fake_fstat
    globals_["open"] = fake_open
    try:
        if kind == "root-disappears":
            require(function("/fixture", phase) == [], "disappeared root was not valid empty")
        elif kind == "empty-root-removal":
            require(function("/fixture", phase) == [],
                    "confirmed removal after an empty snapshot was not valid empty")
            require(root_calls >= 8,
                    "empty root removal was not confirmed by two absent observations")
        elif kind == "residue-root-removal":
            assert_raises(lambda: function("/fixture", phase),
                          f"phase={phase} operation=walk resource=evidence errno=11")
            require(open_calls == 1,
                    "nonempty residue was not observed before permanent root removal")
        elif kind == "partial-residue-root-removal":
            assert_raises(lambda: function("/fixture", phase),
                          f"phase={phase} operation=walk resource=evidence errno=11")
            require(open_calls == 1 and root_calls >= 10,
                    "partial PID evidence was not preserved through permanent root removal")
        elif kind == "complete-interrupted-complete":
            require(function("/fixture", phase) == [],
                    "complete snapshot did not stabilize after an interrupted observation")
            require(open_calls == 4,
                    "interrupted observation was counted toward complete snapshot stability")
        elif kind == "absent-live-recheck-absent":
            assert_raises(lambda: function("/fixture", phase),
                          f"phase={phase} operation=walk resource=evidence errno=11")
            require(root_calls == 10,
                    "live root recheck did not break consecutive absent observations")
        elif kind == "complete-absent-complete":
            require(function("/fixture", phase) == [],
                    "complete snapshot did not stabilize after confirmed absence")
            require(open_calls == 3 and root_calls == 14,
                    "confirmed absence did not invalidate the prior complete snapshot")
        elif kind == "two-absent-root-observations":
            assert_raises(lambda: function("/fixture", phase),
                          f"phase={phase} operation=walk resource=evidence errno=11")
            require(open_calls == 2,
                    "confirmed absence allowed prior residue snapshot reuse")
        elif kind in ("residue", "transient-root-residue"):
            observed = function("/fixture", phase)
            require(observed == [17, 23],
                    f"nonempty cgroup residue was lost: {kind}:{phase}:{observed}:{root_calls}")
        elif kind == "file-disappears":
            assert_raises(lambda: function("/fixture", phase),
                          f"phase={phase} operation=walk resource=evidence errno=11")
            require(root_calls >= namespace["CGROUP_SNAPSHOT_ATTEMPTS"] * 2,
                    "persistent file disappearance was not retried to the bound")
        elif kind in ("cross-attempt-root-reuse", "same-attempt-root-reuse",
                      "renamed-same-inode", "before-after-fstat-mismatch",
                      "final-directory-recheck-mismatch"):
            assert_raises(lambda: function("/fixture", phase),
                          f"phase={phase} operation=stat resource=evidence errno=116")
        elif kind == "initial-root-nondirectory":
            assert_fails_with(lambda: function("/fixture", phase),
                              "unit control group is not a directory")
        elif kind == "root-becomes-nondirectory":
            assert_fails_with(lambda: function("/fixture", phase),
                              "unit control group changed type")
        elif kind == "directory-becomes-nondirectory":
            assert_fails_with(lambda: function("/fixture", phase),
                              "unit control group traversal changed type")
        elif kind == "malformed-pids":
            assert_fails_with(lambda: function("/fixture", phase),
                              "unit control group contained malformed process evidence")
        elif kind in ("reordered-topology", "nondirectory-child"):
            require(function("/fixture", phase) == [], f"{kind} did not stabilize safely")
        elif kind == "transient-file-residue":
            require(function("/fixture", phase) == [17, 23],
                    "transient cgroup.procs disappearance lost stable residue")
        elif kind == "changing-pids":
            require(function("/fixture", phase) == [23], "changing PIDs did not stabilize")
        elif kind == "child-disappears":
            assert_raises(lambda: function("/fixture", phase),
                          f"phase={phase} operation=walk resource=evidence errno=11")
    finally:
        module_os.lstat, module_os.walk, module_os.fstat = originals
        if original_open is None:
            del globals_["open"]
        else:
            globals_["open"] = original_open


def diagnostic_cases(client, containment):
    hostile = injected()
    for operation in ("open", "read", "stat", "replace", "write", "fsync"):
        assert_raises(
            lambda operation=operation: client["os_call"](
                "source-publication", operation, "helper",
                lambda: (_ for _ in ()).throw(hostile)),
            f"phase=source-publication operation={operation} resource=helper errno=13")
    assert_safe(client["evidence_failure"](SECRET, SECRET, SECRET, hostile),
                "phase=uncategorized operation=unknown resource=unknown errno=13")

    original_run = subprocess.run
    try:
        subprocess.run = lambda *_args, **_kwargs: (_ for _ in ()).throw(injected(errno.ENOENT))
        assert_raises(lambda: client["command"](HOSTILE_ARGV, "launch"),
                      "phase=launch operation=run resource=process errno=2")
        assert_raises(lambda: containment["run"]("client-fault", HOSTILE_ARGV),
                      "phase=client-fault operation=run resource=process errno=2")
    finally:
        subprocess.run = original_run

    original_popen = subprocess.Popen
    try:
        subprocess.Popen = lambda *_args, **_kwargs: (_ for _ in ()).throw(injected(errno.ENOEXEC))
        assert_raises(lambda: containment["popen"]("client-fault", HOSTILE_ARGV),
                      "phase=client-fault operation=popen resource=process errno=8")
        assert_raises(lambda: client["bounded_journal_evidence"](SECRET),
                      "journal_failure=io")
    finally:
        subprocess.Popen = original_popen

    original_run_path = runpy.run_path
    try:
        runpy.run_path = lambda *_args, **_kwargs: (_ for _ in ()).throw(injected(errno.EIO))
        assert_raises(lambda: containment["assert_property_parser_contract"](HOSTILE_PATH),
                      "phase=runpy operation=read resource=client errno=5")
    finally:
        runpy.run_path = original_run_path

    assert_safe(client["top_level_diagnostic"](injected(errno.EIO)),
                "phase=uncategorized operation=unknown resource=unknown errno=5")
    containment_line = containment["top_level_diagnostic"](injected(errno.EIO))
    require(containment_line ==
            b"containment-test: 'scenario=containment;failure=os-error;finality=unknown;"
            b"detail=phase=uncategorized operation=unknown resource=unknown errno=5'\n",
            "containment top-level OS diagnostic was not an exact serialized line")

    categorized = containment["evidence_failure"](
        "persistent-cleanup", "read", "evidence", hostile)
    require(containment["retained_diagnostic"](categorized, "capture failed") ==
            "phase=persistent-cleanup operation=read resource=evidence errno=13",
            "typed diagnostic was not retained")
    require(containment["retained_diagnostic"](
        RuntimeError("hostile " + SECRET), "capture failed") == "capture failed",
        "arbitrary diagnostic detail was retained")
def cgroup_boundary_cases(namespace):
    function = namespace["cgroup_pids"]
    globals_ = function.__globals__
    module_os = globals_["os"]
    original_open = globals_.get("open")
    originals = module_os.lstat, module_os.walk, module_os.fstat
    phase = "prelaunch" if "prelaunch" in namespace["DIAGNOSTIC_PHASES"] else "preflight"
    hostile = injected()
    try:
        module_os.lstat = lambda *_args: (_ for _ in ()).throw(hostile)
        assert_raises(lambda: namespace["cgroup_stat"](phase, "/fixture"),
                      f"phase={phase} operation=stat resource=cgroup errno=13")

        module_os.walk = lambda *_args, **_kwargs: (_ for _ in ()).throw(hostile)
        assert_raises(lambda: list(namespace["cgroup_walk"](phase, "/fixture")),
                      f"phase={phase} operation=walk resource=cgroup errno=13")
        assert_raises(lambda: namespace["cgroup_walk_error"](phase, hostile),
                      f"phase={phase} operation=walk resource=cgroup errno=13")

        globals_["open"] = lambda *_args, **_kwargs: (_ for _ in ()).throw(hostile)
        assert_raises(lambda: namespace["cgroup_open"](phase, "/fixture/cgroup.procs"),
                      f"phase={phase} operation=open resource=cgroup errno=13")

        source = FakeFile("")
        module_os.fstat = lambda *_args: (_ for _ in ()).throw(hostile)
        assert_raises(lambda: namespace["cgroup_fstat"](phase, source),
                      f"phase={phase} operation=stat resource=evidence errno=13")
        source.read = lambda: (_ for _ in ()).throw(hostile)
        assert_raises(lambda: namespace["cgroup_read"](phase, source),
                      f"phase={phase} operation=read resource=evidence errno=13")
        source.close = lambda: (_ for _ in ()).throw(hostile)
        assert_raises(lambda: namespace["cgroup_close"](phase, source),
                      f"phase={phase} operation=close resource=evidence errno=13")
    finally:
        module_os.lstat, module_os.walk, module_os.fstat = originals
        if original_open is None:
            del globals_["open"]
        else:
            globals_["open"] = original_open


def explicit_marker_phase_cases(containment):
    globals_ = containment["wait_path"].__globals__
    module_os = globals_["os"]
    original_stat = module_os.stat
    original_open = module_os.open
    wait_cases = (
        ("preflight", "/opt/nmcp-role-compatibility/test-work/kill/supervisor-kill.ready"),
        ("stale-attestation", "/run/nmcp-ci/stale-ready"),
        ("client-fault", "/run/nmcp-ci/client-fault.ready"),
        ("work-budget", "/run/nmcp-ci/client-work-budget-launch.ready"),
        ("slow-cleanup", "/run/nmcp-ci/client-work-budget-slow-cleanup.ready"),
        ("transient-cleanup", "/run/nmcp-ci/client-cleanup-fault-stop.blocked"),
        ("persistent-cleanup", "/run/nmcp-ci/client-cleanup-persistent-stop.handoff.ready"),
        ("signal-cleanup", "/run/nmcp-ci/client-signal-int-kill.ready"),
        ("terminal-race", "/run/nmcp-ci/client-terminal-race-a.ready"),
        ("name-reuse", "/run/nmcp-ci/client-reuse-pause.ready"),
    )
    release_cases = (
        ("stale-attestation", "stale-release"),
        ("stale-cleanup", "stale-release"),
        ("client-fault", "client-fault"),
        ("work-budget", "client-work-budget-launch-unloaded"),
        ("slow-cleanup", "client-work-budget-slow-cleanup-unloaded"),
        ("transient-cleanup", "client-cleanup-fault-stop"),
        ("persistent-cleanup", "client-cleanup-persistent-stop.handoff"),
        ("terminal-race", "client-terminal-race-a"),
        ("name-reuse", "client-reuse-pause"),
    )
    try:
        module_os.stat = lambda *_args, **_kwargs: (_ for _ in ()).throw(injected())
        for phase, path in wait_cases:
            assert_raises(lambda phase=phase, path=path: containment["wait_path"](phase, path),
                          f"phase={phase} operation=stat resource=marker errno=13")
        module_os.open = lambda *_args, **_kwargs: (_ for _ in ()).throw(injected())
        for phase, name in release_cases:
            assert_raises(lambda phase=phase, name=name: containment["release"](phase, name),
                          f"phase={phase} operation=open resource=directory errno=13")
    finally:
        module_os.stat = original_stat
        module_os.open = original_open


def persistent_launch_release_cases(containment):
    globals_ = containment["wait_persistent_launch_required"].__globals__
    original_barriers = globals_["persistent_launch_barriers"]
    nonce = "0123456789abcdef" * 4
    name = "launch-" + nonce + ".required"
    try:
        globals_["persistent_launch_barriers"] = lambda _phase: (name,)
        discovered = containment["wait_persistent_launch_required"](
            "persistent-cleanup", (), timeout=0)
        required, ready, release = containment["persistent_launch_paths"](discovered)
        require(discovered == nonce
                and required == "/run/nmcp-ci/" + name
                and ready == f"/run/nmcp-ci/launch-{nonce}.ready"
                and release == f"/run/nmcp-ci/launch-{nonce}.release",
                "validated nonce filename did not independently derive every launch path")
        for invalid in ("", nonce.upper(), nonce + "0", "g" * 64, None):
            assert_fails_with(
                lambda invalid=invalid: containment["persistent_launch_paths"](invalid),
                "persistent launch nonce was not canonical")
    finally:
        globals_["persistent_launch_barriers"] = original_barriers


def persistent_handoff_state_cases(containment):
    function = containment["persistent_handoff_state_accepted"]
    path = "/usr/bin/env"
    argv = (path, "-i", "KEY=value", "/opt/nmcp/helper", "--mode", "exact")
    signature = containment["launch_identity_signature"](
        "a" * 32, "exact fixture", "KEY=value", path, argv)
    loaded = {
        "LoadState": "loaded", "InvocationID": "a" * 32,
        "Description": "exact fixture", "Environment": "KEY=value",
        "Command": {"path": path, "argv": argv}, **containment["SERVICE_PROPERTIES"],
    }
    absent = {"LoadState": "not-found"}
    require(function("unload", absent, signature, []),
            "unload handoff rejected explicit post-reset absence")
    require(function("unload", loaded, signature, []),
            "unload handoff rejected exact retained launch identity")
    require(not function("reset", absent, signature, []),
            "non-unload handoff accepted explicit absence")
    require(not function("unload", {**loaded, "InvocationID": "b" * 32}, signature, []),
            "unload handoff accepted changed loaded identity")
    require(not function("unload", absent, signature, [1234]),
            "unload handoff accepted recorded cgroup residue")


def cancellation_accounting_cases(client):
    helper = client["account_latched_cancellation"]
    globals_ = helper.__globals__
    original_events = list(globals_["RESULT_EVENTS"])
    original_mapped = set(globals_["RESULT_MAPPED_CLEANUP_ERRORS"])
    original_complete = globals_["RESULT_EVENTS_COMPLETE"]
    original_accounted = globals_["CANCELLATION_ACCOUNTED"]
    original_failure = globals_["CANCELLATION_FAILURE"]
    original_cancelled = list(globals_["CANCELLED"])
    original_sigpending = globals_["signal"].sigpending

    def reset():
        globals_["RESULT_EVENTS"][:] = []
        globals_["RESULT_MAPPED_CLEANUP_ERRORS"].clear()
        globals_["RESULT_EVENTS_COMPLETE"] = True
        globals_["CANCELLATION_ACCOUNTED"] = False
        globals_["CANCELLATION_FAILURE"] = None
        globals_["CANCELLED"][:] = []

    try:
        reset()
        prior = client["PrimaryFailure"]("cleanup-test", "prior")
        cancellation = client["CancellationFailure"](signal.SIGINT)
        primary, cleanup = helper(prior, [], cancellation)
        primary, cleanup = helper(primary, cleanup, cancellation)
        require(primary is prior and cleanup == [cancellation]
                and globals_["RESULT_EVENTS"] == [(0, "final", "cancelled", 0, 0, 0)],
                "post-teardown and terminal cancellation accounting duplicated or replaced primary")

        reset()
        cancellation = client["CancellationFailure"](signal.SIGTERM)
        primary, cleanup = helper(None, [], cancellation)
        primary, cleanup = helper(primary, cleanup, cancellation)
        require(primary is cancellation and cleanup == [] and globals_["RESULT_EVENTS"] == [],
                "first cancellation was not retained as the sole primary")

        reset()
        globals_["signal"].sigpending = lambda: {signal.SIGTERM}
        pending = client["terminal_cancellation_exception"]()
        primary, cleanup = helper(None, [], pending)
        primary, cleanup = helper(primary, cleanup, pending)
        require(isinstance(primary, client["CancellationFailure"])
                and cleanup == [] and globals_["RESULT_EVENTS"] == [],
                "terminal-mask pending cancellation was lost or duplicated")

        reset()
        prior = client["PrimaryFailure"]("cleanup-test", "prior")
        cancellation = client["CancellationFailure"](signal.SIGINT)
        client["cleanup_result"]("cancelled", "final", (cancellation,))
        primary, cleanup = helper(prior, [], cancellation)
        primary, cleanup = helper(primary, cleanup, cancellation)
        require(primary is prior and cleanup == [cancellation]
                and globals_["RESULT_EVENTS"] == [(0, "final", "cancelled", 0, 0, 0)],
                "already-mapped cancellation was dropped or duplicated")
    finally:
        globals_["RESULT_EVENTS"][:] = original_events
        globals_["RESULT_MAPPED_CLEANUP_ERRORS"].clear()
        globals_["RESULT_MAPPED_CLEANUP_ERRORS"].update(original_mapped)
        globals_["RESULT_EVENTS_COMPLETE"] = original_complete
        globals_["CANCELLATION_ACCOUNTED"] = original_accounted
        globals_["CANCELLATION_FAILURE"] = original_failure
        globals_["CANCELLED"][:] = original_cancelled
        globals_["signal"].sigpending = original_sigpending


def signal_result_cases(containment):
    prefix = containment["RESULT_PREFIX"]

    def result(mode, signum):
        expected, human = containment["expected_signal_result"](mode, signum)
        events = (",".join(
            f"{ordinal}.{boundary}.{category}.{retries}.{interceptions}.{attempts}"
            for ordinal, boundary, category, retries, interceptions, attempts
            in expected["events"]) or "-")
        machine = (
            f"{prefix}primary={expected['primary']};events={events};"
            f"events_complete={expected['events_complete']};"
            f"final_scanned={expected['final_scanned']};"
            f"final_observed={expected['final_observed']};final_empty={expected['final_empty']};"
            f"return={expected['return']};stdout={expected['stdout']};success={expected['success']}")
        stderr = machine + "\nverification-client: " + human + "\n"
        return subprocess.CompletedProcess(("client", mode), 1, "", stderr)

    for signal_name, signum in (("int", signal.SIGINT), ("term", signal.SIGTERM)):
        for boundary in ("startup", "work", "kill", "stop"):
            mode = f"client-signal-{signal_name}-{boundary}"
            exact = result(mode, signum)
            require(containment["signal_result_contract"](exact, mode, signum),
                    f"exact {signal_name}/{boundary} signal schema was rejected")
            dirty = subprocess.CompletedProcess(
                exact.args, 1, "", exact.stderr.replace("final_empty=1", "final_empty=0", 1))
            missing = subprocess.CompletedProcess(
                exact.args, 1, "", exact.stderr.replace("final_observed=1;", "", 1))
            require(not containment["signal_result_contract"](dirty, mode, signum)
                    and not containment["signal_result_contract"](missing, mode, signum),
                    f"dirty or missing {signal_name}/{boundary} finality was accepted")


def release_marker_security_cases(client, containment):
    client_globals = client["durable_marker"].__globals__
    original_run = client_globals["RUN"]
    module_os = client_globals["os"]
    originals = module_os.fstat, module_os.stat, module_os.write

    def root_owned(metadata, *, inode=None):
        values = list(metadata)
        values[1] = metadata.st_ino if inode is None else inode
        values[4] = 0
        values[5] = 0
        return os.stat_result(values)

    try:
        with tempfile.TemporaryDirectory() as root:
            os.chmod(root, 0o700)
            client_globals["RUN"] = root
            real_fstat, real_stat, real_write = originals
            module_os.fstat = lambda descriptor: root_owned(real_fstat(descriptor))
            module_os.stat = lambda *args, **kwargs: root_owned(real_stat(*args, **kwargs))
            nonce = "0123456789abcdef" * 4
            payload = (nonce + "\n").encode("ascii")

            client["durable_marker"]("final-close", "launch-" + nonce + ".release", payload)
            path = root + "/launch-" + nonce + ".release"
            require(client["validated_marker"]("final-close", path, payload, "release"),
                    "fresh nonce release marker did not validate")
            client["durable_marker"]("final-close", "launch-" + nonce + ".release", payload)

            malformed = root + "/malformed.release"
            pathlib.Path(malformed).write_bytes(b"release\n")
            os.chmod(malformed, 0o600)
            assert_fails_with(
                lambda: client["validated_marker"](
                    "final-close", malformed, payload, "release"),
                "release was malformed or replaced")

            target = root + "/target"
            pathlib.Path(target).write_bytes(payload)
            os.chmod(target, 0o600)
            symlink = root + "/symlink.release"
            os.symlink(target, symlink)
            try:
                client["validated_marker"]("final-close", symlink, payload, "release")
            except RuntimeError as error:
                require("resource=release" in str(error),
                        "symlink release did not fail with closed release evidence")
            else:
                raise RuntimeError("symlink release unexpectedly validated")

            rebound = root + "/rebound.release"
            pathlib.Path(rebound).write_bytes(payload)
            os.chmod(rebound, 0o600)
            def rebound_stat(*args, **kwargs):
                observed = real_stat(*args, **kwargs)
                if args and args[0] == "rebound.release" and kwargs.get("dir_fd") is not None:
                    return root_owned(observed, inode=observed.st_ino + 1)
                return root_owned(observed)
            module_os.stat = rebound_stat
            assert_fails_with(lambda: client["validated_marker"](
                "final-close", rebound, payload, "release"),
                "release was malformed or replaced")
            module_os.stat = lambda *args, **kwargs: root_owned(real_stat(*args, **kwargs))

            partial = []
            def partial_write(descriptor, remaining):
                count = max(1, len(remaining) // 2) if not partial else len(remaining)
                partial.append(count)
                return real_write(descriptor, remaining[:count])
            module_os.write = partial_write
            client["durable_marker"]("final-close", "partial.release", payload)
            require(len(partial) == 2 and client["validated_marker"](
                        "final-close", root + "/partial.release", payload, "release"),
                    "partial release write was not completed and validated")

            module_os.write = lambda _descriptor, _payload: 0
            assert_fails_with(lambda: client["durable_marker"](
                "final-close", "short.release", payload),
                "short write while publishing marker")
            module_os.write = real_write

        containment_globals = containment["release"].__globals__
        containment_os = containment_globals["os"]
        containment_originals = (containment_os.open, containment_os.close,
                                 containment_globals["validated_payload_marker"])
        calls = []
        try:
            def existing_open(path, flags, *args, **kwargs):
                if path == "/run/nmcp-ci":
                    return 91
                raise FileExistsError(errno.EEXIST, "exists")
            containment_os.open = existing_open
            containment_os.close = lambda descriptor: calls.append(("close", descriptor))
            containment_globals["validated_payload_marker"] = (
                lambda phase, path, expected, resource: calls.append(
                    (phase, path, expected, resource)) or True)
            containment["release"]("persistent-cleanup", "launch-" + nonce)
            require(calls[-1] == (
                        "persistent-cleanup", "/run/nmcp-ci/launch-" + nonce + ".release",
                        payload, "release"),
                    "prepublished containment release was not nonce-validated")
        finally:
            containment_os.open, containment_os.close = containment_originals[:2]
            containment_globals["validated_payload_marker"] = containment_originals[2]
    finally:
        client_globals["RUN"] = original_run
        module_os.fstat, module_os.stat, module_os.write = originals


def signed_cleanup_lock_cases(containment):
    cleanup_if_owned = containment["cleanup_signed_launch_if_owned"]
    signature = ("attested",)
    calls = []

    def cleanup(observed_signature, phase):
        calls.append((observed_signature, phase))

    require(not cleanup_if_owned(
        False, signature, {"LoadState": "loaded"}, "persistent-cleanup", cleanup),
        "contended cleanup lock was treated as owned")
    require(not calls, "signed cleanup ran without the client lock")
    require(not cleanup_if_owned(
        True, signature, {"LoadState": "not-found"}, "persistent-cleanup", cleanup),
        "absent signed launch was treated as cleanup work")
    require(not cleanup_if_owned(
        True, signature, {"EvidenceError": "passive capture failed"},
        "persistent-cleanup", cleanup),
        "unknown passive state was treated as a loaded signed launch")
    assert_fails_with(lambda: cleanup_if_owned(
        True, None, {"LoadState": "loaded"}, "persistent-cleanup", cleanup),
        "loaded post-exit unit lacks an attested launch signature")
    require(not calls, "signed cleanup ran without loaded, locked, attested state")
    require(cleanup_if_owned(
        True, signature, {"LoadState": "loaded"}, "persistent-cleanup", cleanup),
        "owned signed cleanup did not run")
    require(calls == [(signature, "persistent-cleanup")],
            "signed cleanup callback did not run exactly once with owned identity")


def stale_diagnostic_cases(containment):
    classify = containment["stale_client_classification"]
    identity_evidence = containment["stale_identity_evidence"]
    failure_category = containment["stale_failure_category"]
    diagnostic = containment["stale_failure_message"]
    expected = containment["stale_expected_rejection"]({
        "LoadState": "loaded", "InvocationID": "i" * 32, "ActiveState": "failed",
        "SubState": "failed", "ControlGroup": "", "Result": "exit-code",
        "ExecMainCode": "1", "ExecMainStatus": "73",
    })
    require(expected == containment["STALE_REJECTION_PREFIX"]
            + "{'LoadState': 'loaded', 'InvocationID': '" + "i" * 32
            + "', 'ActiveState': 'failed', 'SubState': 'failed', 'ControlGroup': ''}\n",
            "stale expected rejection did not match the exact prelaunch state diagnostic")
    machine = (
        containment["RESULT_PREFIX"] + "primary=verification;events=-;events_complete=1;"
        "final_scanned=1;final_observed=1;final_empty=1;return=1;stdout=0;success=0")
    exact_stderr = machine + "\n" + expected
    cases = (
        (False, None, "", exact_stderr,
         (False, False, False, False, True, True, False, False, False)),
        (True, None, "", exact_stderr,
         (True, False, False, False, True, True, False, False, False)),
        (True, 0, "", exact_stderr,
         (True, True, True, False, True, True, False, False, False)),
        (True, 1, containment["SUCCESS"], exact_stderr,
         (True, True, True, True, True, True, False, False, False)),
        (True, 1, "", exact_stderr,
         (True, True, False, False, True, True, True, True, False)),
    )
    for attempted, returncode, stdout, stderr, wanted in cases:
        observed = classify(attempted, returncode, stdout, stderr, expected)
        require(tuple(observed[name] for name in (
            "attempted", "result_available", "accepted", "success_marker",
            "machine_contract", "human_rejection", "result_contract",
            "expected_rejection", "wrong_reason")) == wanted,
            "stale client outcome classification lost exact result/rejection semantics")

    stderr_mutations = (
        machine + "\n", expected,
        machine + "\n" + expected + "extra\n",
        expected + machine + "\n",
        " " + machine + "\n" + expected,
        machine + "\n " + expected,
        machine + "\n" + expected.rstrip("\n") + " appended\n",
        machine.replace("primary=verification", "primary=unexpected") + "\n" + expected,
        machine.replace("events=-", "events=0.final.unexpected.0.0.0") + "\n" + expected,
        machine.replace("events_complete=1", "events_complete=0") + "\n" + expected,
        machine.replace("final_scanned=1", "final_scanned=0") + "\n" + expected,
        machine.replace("final_observed=1", "final_observed=0") + "\n" + expected,
        machine.replace("final_empty=1", "final_empty=0") + "\n" + expected,
        machine.replace("return=1", "return=0") + "\n" + expected,
        machine.replace("stdout=0", "stdout=1") + "\n" + expected,
        machine.replace("success=0", "success=1") + "\n" + expected,
    )
    for mutated in stderr_mutations:
        observed = classify(True, 1, "", mutated, expected)
        require(not observed["result_contract"] and observed["wrong_reason"],
                "stale classifier accepted a missing, extra, reordered, padded, or wrong contract")
    for returncode, stdout in ((2, ""), (1, "unexpected")):
        observed = classify(True, returncode, stdout, exact_stderr, expected)
        require(not observed["result_contract"] and observed["wrong_reason"],
                "stale classifier ignored the actual return/stdout contract")

    signature = containment["launch_identity_signature"](
        "a" * 32, "exact fixture", "KEY=value", "/bin/true", ("/bin/true",))
    terminal = {
        "LoadState": "loaded", "InvocationID": "a" * 32,
        "Description": "exact fixture", "Environment": "KEY=value",
        "Command": {"path": "/bin/true", "argv": ("/bin/true",)},
        **containment["SERVICE_PROPERTIES"], "ActiveState": "failed", "SubState": "failed",
        "Result": "exit-code", "ExecMainCode": "1", "ExecMainStatus": "73",
        "ExecMainPID": "1234",
    }
    unchanged = identity_evidence(terminal, signature, "1234", ())
    require(unchanged == {
        "signature_unchanged": True, "terminal_unchanged": True,
        "pid_unchanged": True, "cgroup_empty": True, "identity_unchanged": True,
    }, "stale exact post-client identity evidence was not retained independently")
    identity_mutations = (
        ({**terminal, "InvocationID": "b" * 32}, ()),
        ({**terminal, "ExecMainStatus": "1"}, ()),
        ({**terminal, "ExecMainPID": "4321"}, ()),
        (terminal, (4321,)),
    )
    require(all(not identity_evidence(state, signature, "1234", pids)["identity_unchanged"]
                for state, pids in identity_mutations),
            "stale identity evidence accepted changed signature, terminal, PID, or cgroup state")
    exact = classify(True, 1, "", exact_stderr, expected)
    wrong = classify(True, 1, "", machine + "\nverification-client: unrelated failure\n", expected)
    require(failure_category(wrong, False, True) == "wrong-reason"
            and failure_category(exact, True, True) == "identity-change"
            and failure_category(wrong, True, True) == "result-identity",
            "stale result-contract and identity-change categories were collapsed")

    classification = wrong
    rendered = diagnostic(
        "wrong-reason", False, classification, True, True, True, True, False,
        True, True, True, True, True, True, True, True, "none", False,
        False, False).decode("ascii")
    fields = (
        "scenario=stale;", ";failure=wrong-reason;", ";attempted=1;",
        ";result_available=1;", ";client_zero=0;", ";success_marker=0;",
        ";machine_contract=1;", ";human_rejection=0;", ";result_contract=0;",
        ";expected_rejection=0;", ";wrong_reason=1;", ";unit_absent=1;",
        ";recorded_empty=1;", ";canonical_empty=1;", ";identity_unchanged=1;",
        ";identity_changed=0;",
        ";cleanup_attempted=1;", ";cleanup_succeeded=1;", ";lock_reusable=1;",
        ";artifacts_removed=1;", ";post_evidence_complete=1;", ";ready=1;",
        ";release=1;", ";ack=1;", ";error_category=none;", ";fixture_error=0;",
        ";client_output=0;", ";cleanup_error=0",
    )
    positions = [rendered.index(field) for field in fields]
    require(positions == sorted(positions) and all(rendered.count(field) == 1 for field in fields),
            "stale diagnostic lost a leading outcome/cleanup field or field order")
    hostile = "x" * 4096
    equivalents = (RuntimeError(hostile), {"Description": hostile}, ("signature", hostile))
    messages = []
    for failure_name in ("accepted", "wrong-reason", "identity-change", "result-identity",
                         "fixture-error", "cleanup-error", hostile):
        for error_category in ("none", "fixture", "release", "state", "identity",
                               "action", "post", "lock", "paths", hostile):
            emitted = diagnostic(
                failure_name, False, classification, False, False, False, False, True,
                True, False, False, False, False, True, True, True, error_category,
                True, True, True)
            require(len(emitted) <= 512 and b"<truncated>" not in emitted,
                    "complete stale diagnostic exceeded its final emitted bound")
            messages.append(emitted)
    require(all(value for value in equivalents)
            and all(hostile.encode("ascii") not in value for value in messages),
            "stale diagnostic depended on hostile error/signature/state equivalents")
    emitted = rendered.encode("ascii")
    require(len(emitted) <= 512 and b"<truncated>" not in emitted,
            "required stale diagnostic fields were truncated by top-level rendering")
    forbidden = ("signature=", "state=", "InvocationID", "Description", "Environment",
                 "Command", "stdout=", "stderr=", "/run/", "pid=", "nonce")
    require(not any(item.encode("ascii") in emitted for item in forbidden),
            "stale diagnostic leaked forbidden identity, stream, path, PID, or nonce evidence")


def containment_serialization_cases(containment):
    class UnrenderableError(Exception):
        def __str__(self):
            raise RuntimeError("hostile string conversion")

    class HostileErrno(OSError):
        @property
        def errno(self):
            raise RuntimeError(SECRET)

    class OpenErrno(OSError):
        @property
        def errno(self):
            return SECRET

    class PartialStream:
        def __init__(self):
            self.payload = bytearray()
            self.flushed = 0

        def write(self, payload):
            written = min(7, len(payload))
            self.payload.extend(payload[:written])
            return written

        def flush(self):
            self.flushed += 1

    containment["assert_machine_result_contract"]()
    long_line = containment["top_level_diagnostic"](RuntimeError("x" * 4096))
    require(len(long_line) == 512 and long_line.count(b"\n") == 1
            and long_line.endswith(b"...<truncated>'\n")
            and long_line.startswith(
                b"containment-test: 'scenario=containment;failure=unexpected;finality=unknown;"),
            "long top-level diagnostic did not retain exact bounded leading evidence")
    escaped = containment["top_level_diagnostic"](
        RuntimeError("quote=' newline=\n nonascii=é"))
    require(len(escaped) == 117 and escaped.count(b"\n") == 1
            and b"newline=\\n" in escaped and b"nonascii=\\xe9" in escaped,
            "escaping or non-ASCII changed the exact serialized byte form")
    redacted = containment["top_level_diagnostic"](RuntimeError("a" * 64))
    require(len(redacted) == 101 and b"<redacted-hex64>" in redacted
            and b"a" * 64 not in redacted,
            "hex64 redaction changed the exact serialized byte form")
    nonce = "nonce-value-that-must-not-survive"
    nonce_line = containment["serialize_diagnostic"](
        "containment", "unexpected", (("finality", "unknown"),),
        detail="prefix-" + nonce + "-suffix", active_nonce=nonce)
    require(nonce.encode("ascii") not in nonce_line and b"<redacted-nonce>" in nonce_line,
            "active nonce survived centralized serialization")
    state_line = containment["top_level_diagnostic"](
        RuntimeError("Description=hostile Environment=secret"))
    require(b"Description" not in state_line and b"Environment" not in state_line
            and b"diagnostic contained redacted launch identity" in state_line,
            "launch state survived centralized serialization")
    conversion_line = containment["top_level_diagnostic"](UnrenderableError())
    require(b"detail=diagnostic conversion failed" in conversion_line
            and len(conversion_line) <= 512,
            "hostile exception string conversion suppressed the bounded diagnostic")
    for hostile_errno in (HostileErrno(), OpenErrno()):
        require(containment["diagnostic_errno"](hostile_errno) == "unknown",
                "hostile errno property escaped the closed unknown category")
        errno_line = containment["top_level_diagnostic"](hostile_errno)
        require(b"errno=unknown" in errno_line and SECRET.encode("ascii") not in errno_line,
                "hostile errno property broke or leaked through serialization")
        errno_text = containment["sanitized_diagnostic_text"](hostile_errno)
        require(errno_text.endswith("errno=unknown") and SECRET not in errno_text,
                "hostile errno property broke or leaked through sanitized text")
    stream = io.BytesIO()
    written = containment["write_diagnostic"](stream, RuntimeError("x" * 4096))
    require(written == 512 and stream.getvalue() == long_line,
            "real diagnostic write did not preserve the exact serialized byte line")
    partial = PartialStream()
    written = containment["write_diagnostic"](partial, RuntimeError("partial"))
    require(written == len(partial.payload) and partial.flushed == 1,
            "diagnostic writer did not complete bounded short writes and flush exactly once")
    for result in (0, None):
        broken = PartialStream()
        broken.write = lambda _payload, observed=result: observed
        try:
            containment["write_diagnostic"](broken, RuntimeError("broken"))
        except RuntimeError:
            pass
        else:
            raise RuntimeError("diagnostic writer accepted a non-progressing stream")
    overcount = PartialStream()
    overcount.write = lambda payload: len(payload) + 1
    try:
        containment["write_diagnostic"](overcount, RuntimeError("overcount"))
    except RuntimeError:
        pass
    else:
        raise RuntimeError("diagnostic writer accepted an impossible write count")

    predicate_names = (
        "case_exact", "lifecycle_match", "schema_shape", "schema_exact", "primary_exact",
        "events_exact", "return_match", "stdout_match", "success_match", "events_complete",
        "final_scanned", "final_observed", "final_empty", "intercept_match", "attempt_match",
        "retry_match", "lock_handoff_ok", "cleanup_error_empty", "cleanup_categories",
        "lock_reuse", "signed_cleanup_required", "signed_cleanup_ran", "release", "reap",
        "unit_absent", "recorded_category", "recorded_required", "recorded_scan",
        "canonical_scan", "recorded_empty", "canonical_empty", "artifacts_absent",
    )
    families = tuple((boundary, "normal", "none") for boundary in
                     ("show", "kill", "stop", "wait", "reset", "unload")) + (
                         ("kill", "parse", "non-canonical"),
                         ("wait", "timeout", "timeout"),
                     )
    for boundary, case, lifecycle in families:
        for failed in predicate_names:
            predicates = {name: True for name in predicate_names}
            predicates[failed] = False
            payload = containment["persistent_scalar_diagnostic"](
                case, boundary, lifecycle, predicates,
                {"line_count": 999999, "byte_count": 999999, "byte_bounded": False,
                 "leading_whitespace": False, "trailing_whitespace": False})
            require(len(payload) <= 512 and b"<truncated>" not in payload
                    and f";boundary={boundary};".encode("ascii") in payload,
                    "persistent case/boundary finality failure lost complete serialization")
            stream = io.BytesIO()
            failure = containment["SerializedDiagnosticFailure"](payload)
            written = containment["write_diagnostic"](stream, failure)
            require(written == len(payload) and stream.getvalue() == payload,
                    "live persistent failure path replaced or recomposed fixed finality evidence")

    trusted_payload = containment["persistent_scalar_diagnostic"](
        "normal", "kill", "none", {name: True for name in predicate_names},
        {"line_count": 1, "byte_count": 1, "byte_bounded": True,
         "leading_whitespace": False, "trailing_whitespace": False})
    stale_payload = containment["stale_failure_message"](
        "accepted", True,
        {"attempted": True, "result_available": True, "accepted": True,
         "success_marker": False, "machine_contract": True, "human_rejection": True,
         "result_contract": False, "expected_rejection": False, "wrong_reason": False},
        True, True, True, True, False, True, True, True, True, True, True, True, True,
        "none", False, False, False)
    accepted_stream = io.BytesIO()
    containment["write_diagnostic"](
        accepted_stream, containment["SerializedDiagnosticFailure"](stale_payload))
    require(accepted_stream.getvalue() == stale_payload,
            "diagnostic sink rejected a complete stale payload")
    invalid_internal_payloads = (
        bytearray(trusted_payload),
        trusted_payload.replace(b"containment-test: ", b"untrusted: ", 1),
        trusted_payload[:-1],
        trusted_payload[:-2] + b";bad=\xff'\n",
        trusted_payload + b"x" * 512,
        b"containment-test: 'scenario=containment;failure=unexpected;finality=unknown'\n",
        trusted_payload.replace(b";case=", b";case=normal;case=", 1),
        trusted_payload.replace(b";release=1", b"", 1),
        trusted_payload.replace(b";release=1", b";invented=1;release=1", 1),
        trusted_payload.replace(b";case=normal;boundary=kill;",
                                b";boundary=kill;case=normal;", 1),
        trusted_payload.replace(b";release=1", b";release=2", 1),
        stale_payload.replace(b";attempted=1", b";attempted=2", 1),
        stale_payload.replace(b";error_category=none", b";error_category=unknown", 1),
    )
    for invalid_payload in invalid_internal_payloads:
        rejected_stream = io.BytesIO()
        try:
            containment["write_diagnostic"](
                rejected_stream, containment["SerializedDiagnosticFailure"](invalid_payload))
        except RuntimeError:
            pass
        else:
            raise RuntimeError("diagnostic sink accepted an untrusted internal payload")
        require(rejected_stream.getvalue() == b"",
                "diagnostic sink wrote an internal payload before validation")

    serializer = containment["serialize_diagnostic"]
    for fields in (
            (("finality", "unknown"), ("finality", "complete")),
            (("bad-name", "unknown"),),
            (("finality", "bad.value"),)):
        try:
            serializer("containment", "unexpected", fields, complete=True)
        except RuntimeError:
            pass
        else:
            raise RuntimeError("diagnostic schema accepted duplicate or open fields")
    try:
        serializer("containment", "unexpected", (("finality", "unknown"),),
                   detail="x" * 4096, complete=True)
    except RuntimeError:
        pass
    else:
        raise RuntimeError("complete diagnostic accepted an over-cap tail")


def client_cgroup_lifecycle_cases(client):
    globals_ = client["retain_control_group"].__globals__
    recorded = globals_["RECORDED_CGROUP"]
    canonical = globals_["CANONICAL_CGROUP"]
    original_recorded = list(recorded)
    original_cgroup_pids = globals_["cgroup_pids"]
    original_owned_state = globals_["owned_state"]
    calls = []
    residue = {}

    def fake_cgroup_pids(control_group, phase):
        calls.append((control_group, phase))
        return list(residue.get(control_group, ()))

    try:
        recorded[:] = []
        client["retain_control_group"]({"LoadState": "loaded", "ControlGroup": "/recorded-a"})
        client["retain_control_group"]({
            "LoadState": "loaded", "ControlGroup": "/recorded-b", "InvocationID": "mismatch",
        })
        client["retain_control_group"]({"LoadState": "loaded", "ControlGroup": "/recorded-a"})
        assert_fails_with(lambda: client["retain_control_group"]({"LoadState": "not-found"}),
                          "fixed unit observation omitted ControlGroup")
        assert_fails_with(lambda: client["retain_control_group"]({
            "LoadState": "not-found", "ControlGroup": None,
        }), "loaded fixed unit has an invalid control group path")
        client["retain_control_group"]({"LoadState": "not-found", "ControlGroup": ""})
        client["retain_control_group"]({
            "LoadState": "not-found", "ControlGroup": "/recorded-not-found",
        })
        client["retain_control_group"]({"LoadState": "loaded", "ControlGroup": ""})
        require(client["fixed_cgroup_paths"]() == (
                    "/recorded-a", "/recorded-b", "/recorded-not-found", canonical),
                "later/mismatched/minimal/empty states replaced retained control groups")
        assert_fails_with(lambda: client["retain_control_group"]({"LoadState": "loaded"}),
                          "fixed unit observation omitted ControlGroup")
        for invalid in (None, 7, "relative", "/", "/a/../b"):
            state = {"LoadState": "loaded", "ControlGroup": invalid}
            assert_fails_with(lambda state=state: client["retain_control_group"](state),
                              "loaded fixed unit has an invalid control group path")
        require(client["fixed_cgroup_paths"]() == (
                    "/recorded-a", "/recorded-b", "/recorded-not-found", canonical),
                "invalid loaded state changed the retained control group")
        recorded[:] = [f"/recorded-{index}" for index in range(globals_["RECORDED_CGROUP_LIMIT"])]
        assert_fails_with(lambda: client["retain_control_group"]({
            "LoadState": "loaded", "ControlGroup": "/overflow",
        }), "too many fixed unit control group paths were observed")
        require(recorded[-1] == "/overflow",
                "retained control group bound omitted the overflow state")
        recorded[:] = ["/recorded-a", "/recorded-b"]

        globals_["cgroup_pids"] = fake_cgroup_pids
        residue["/recorded-a"] = (41,)
        assert_fails_with(lambda: client["assert_fixed_cgroups_empty"]("teardown"),
                          "fixed-cgroup-residue=true")
        require(calls == [("/recorded-a", "teardown"), ("/recorded-b", "teardown"),
                          (canonical, "teardown")],
                "recorded residue check skipped an earlier/later/canonical fixed cgroup")

        calls.clear()
        assert_fails_with(lambda: client["assert_prelaunch_absent"]({
            "LoadState": "loaded", "ActiveState": "failed", "SubState": "failed",
            "ExecMainStatus": "73", "ControlGroup": "",
        }), "fixed verification unit is not explicitly absent: "
            "{'LoadState': 'loaded', 'ActiveState': 'failed', 'SubState': 'failed', "
            "'ControlGroup': '', 'ExecMainStatus': '73'}")
        require(not calls, "loaded prelaunch rejection scanned cgroups before LoadState")

        calls.clear()
        residue.clear()
        residue[canonical] = (42,)
        assert_fails_with(lambda: client["assert_fixed_cgroups_empty"]("prelaunch"),
                          "fixed-cgroup-residue=true")
        require(calls == [("/recorded-a", "prelaunch"), ("/recorded-b", "prelaunch"),
                          (canonical, "prelaunch")],
                "canonical residue check skipped retained control groups")

        calls.clear()
        residue.clear()
        client["assert_prelaunch_absent"]({
            "LoadState": "not-found", "ControlGroup": "/recorded-not-found",
        })
        require(calls == [("/recorded-a", "prelaunch"), ("/recorded-b", "prelaunch"),
                          ("/recorded-not-found", "prelaunch"), (canonical, "prelaunch")],
                "explicit absence did not retain and scan recorded/canonical cgroups")

        calls.clear()
        residue.clear()
        recorded[:] = [canonical]
        client["assert_fixed_cgroups_empty"]("final-close")
        require(calls == [(canonical, "final-close")],
                "canonical and recorded control groups were not deduplicated")

        recorded[:] = ["/recorded-a", "/recorded-b"]
        globals_["owned_state"] = lambda *_args, **_kwargs: {
            "LoadState": "not-found", "ControlGroup": "",
        }
        calls.clear()
        client["teardown_owned"]("i" * 32, "n" * 64, ("/fixture",))
        require(calls == [("/recorded-a", "teardown"), ("/recorded-b", "teardown"),
                          (canonical, "teardown")],
                "cleanup accepted minimal not-found without both cgroup checks")
        calls.clear()
        client["wait_unloaded"]("i" * 32, "n" * 64, ("/fixture",))
        require(calls == [("/recorded-a", "unload"), ("/recorded-b", "unload"),
                          (canonical, "unload")],
                "unload accepted minimal not-found without both cgroup checks")

        calls.clear()
        residue["/recorded-a"] = (43,)
        assert_fails_with(lambda: client["teardown_owned"](
            "i" * 32, "n" * 64, ("/fixture",)),
            "fixed-cgroup-residue=true")

        calls.clear()
        final_evidence = capture_final(client)
        assert_fails_with(lambda: client["resolve_outcome"](
            RuntimeError("primary-original"), [], "n" * 64, final_evidence),
            "fixed-cgroup-residue=true; primary-original")
        require(calls == [("/recorded-a", "final-close"),
                          ("/recorded-b", "final-close"), (canonical, "final-close")],
                "primary error bypassed final cgroup evidence")

        calls.clear()
        final_evidence = capture_final(client)
        assert_fails_with(lambda: client["resolve_outcome"](
            None, [RuntimeError("cleanup-original")], "n" * 64, final_evidence),
            "fixed-cgroup-residue=true; cleanup-original")
        require(calls == [("/recorded-a", "final-close"),
                          ("/recorded-b", "final-close"), (canonical, "final-close")],
                "cleanup error bypassed final cgroup evidence")

        calls.clear()
        residue.clear()
        final_evidence = capture_final(client)
        assert_fails_with(lambda: client["resolve_outcome"](
            RuntimeError("minimal-not-found-primary"), [], "n" * 64, final_evidence),
            "minimal-not-found-primary")
        require(calls == [("/recorded-a", "final-close"),
                          ("/recorded-b", "final-close"), (canonical, "final-close")],
                "minimal not-found primary path bypassed final cgroup evidence")
    finally:
        recorded[:] = original_recorded
        globals_["cgroup_pids"] = original_cgroup_pids
        globals_["owned_state"] = original_owned_state


def client_prelaunch_production_path_case(client):
    globals_ = client["unit_properties"].__globals__
    recorded = globals_["RECORDED_CGROUP"]
    canonical = globals_["CANONICAL_CGROUP"]
    originals = (
        list(recorded), globals_["command"], globals_["command_path"],
        globals_["cgroup_pids"], globals_["PROPERTY_RETRIES"],
    )
    response = ""
    scans = []

    def fake_command(*_args, **_kwargs):
        return subprocess.CompletedProcess(("systemctl", "show"), 0, response, "")

    def fake_cgroup_pids(control_group, phase):
        scans.append((control_group, phase))
        return []

    try:
        recorded[:] = ["/prior"]
        globals_["command"] = fake_command
        globals_["command_path"] = lambda *_args, **_kwargs: None
        globals_["cgroup_pids"] = fake_cgroup_pids
        globals_["PROPERTY_RETRIES"] = 1

        response = ("LoadState=loaded\nInvocationID=fixture\nActiveState=failed\n"
                    "SubState=failed\nControlGroup=\n")
        loaded = client["unit_properties"](
            "prelaunch", "LoadState", "InvocationID", "ActiveState", "SubState",
            "ControlGroup", context="prelaunch", retain=False)
        assert_fails_with(lambda: client["assert_prelaunch_absent"](loaded),
                          "fixed verification unit is not explicitly absent: "
                          "{'LoadState': 'loaded', 'InvocationID': 'fixture', "
                          "'ActiveState': 'failed', 'SubState': 'failed', 'ControlGroup': ''}")
        require(recorded == ["/prior"] and not scans,
                "production prelaunch loaded read retained or scanned before LoadState rejection")

        response = "LoadState=not-found\n"
        minimal_absent = client["unit_properties"](
            "prelaunch", "LoadState", context="prelaunch")
        require(minimal_absent == {"LoadState": "not-found"},
                "minimal explicit-absence parser contract changed without ControlGroup request")
        assert_fails_with(lambda: client["unit_properties"](
            "work", "LoadState", "ControlGroup"),
            "unit properties remain unknown: fixed unit observation omitted ControlGroup")

        response = "LoadState=not-found\nControlGroup=/current-not-found\n"
        absent = client["unit_properties"](
            "prelaunch", "LoadState", "ControlGroup", context="prelaunch", retain=False)
        client["assert_prelaunch_absent"](absent)
        require(recorded == ["/prior", "/current-not-found"],
                "production explicit-absence path did not retain its nonempty current cgroup")
        require(scans == [("/prior", "prelaunch"), ("/current-not-found", "prelaunch"),
                          (canonical, "prelaunch")],
                "production explicit-absence path skipped accumulated or canonical evidence")

        response = "LoadState=loaded\nControlGroup=/work-observed\n"
        client["unit_properties"]("work", "LoadState", "ControlGroup")
        require(recorded[-1] == "/work-observed",
                "non-prelaunch unit property observation lost required cgroup retention")

        launch_properties = {
            "LoadState": "loaded", "InvocationID": "i" * 32,
            "ActiveState": "active", "SubState": "running", "ControlGroup": "",
            "Description": "fixture", "Environment": "fixture", "ExecStart": "fixture",
            **globals_["SERVICE_PROPERTIES"],
        }
        response = "".join(f"{name}={value}\n" for name, value in launch_properties.items())
        assert_fails_with(lambda: client["launch_state"]("immediate", context="immediate"),
                          "loaded launch observation has no control group path")
        require(recorded == ["/prior", "/current-not-found", "/work-observed"],
                "empty launch observation changed retained control groups")

        launch_properties["ControlGroup"] = "/launch-observed"
        response = "".join(f"{name}={value}\n" for name, value in launch_properties.items())
        client["launch_state"]("recovery", context="recovery")
        require(recorded[-1] == "/launch-observed",
                "nonempty launch attestation did not retain its control group")
    finally:
        recorded[:] = originals[0]
        globals_["command"] = originals[1]
        globals_["command_path"] = originals[2]
        globals_["cgroup_pids"] = originals[3]
        globals_["PROPERTY_RETRIES"] = originals[4]


def client_final_residue_diagnostic_cases(client):
    globals_ = client["retain_control_group"].__globals__
    recorded = globals_["RECORDED_CGROUP"]
    canonical = globals_["CANONICAL_CGROUP"]
    original_recorded = list(recorded)
    original_cgroup_pids = globals_["cgroup_pids"]
    calls = []
    residue_paths = set()

    def fake_cgroup_pids(control_group, phase):
        calls.append((control_group, phase))
        return [987654] if control_group in residue_paths else []

    try:
        globals_["cgroup_pids"] = fake_cgroup_pids
        recorded[:] = [f"/recorded-{index}" for index in range(globals_["RECORDED_CGROUP_LIMIT"])]
        try:
            client["retain_control_group"]({
                "LoadState": "loaded", "ControlGroup": "/overflow",
            })
        except RuntimeError as error:
            overflow_error = error
        else:
            raise RuntimeError("65th retained control group did not fail closed")
        require(recorded[-1] == "/overflow", "65th control group was not retained before failure")
        residue_paths.add("/overflow")
        final_evidence = capture_final(client)
        try:
            client["resolve_outcome"](
                overflow_error, [RuntimeError("cleanup-" + "c" * 512)], "n" * 64,
                final_evidence)
        except RuntimeError as error:
            diagnostic = str(error)
        else:
            raise RuntimeError("overflow residue did not fail final outcome resolution")
        require(("/overflow", "final-close") in calls,
                "final outcome did not inspect the retained overflow path")
        require(diagnostic.startswith("fixed-cgroup-residue=true; ")
                and "too many fixed unit control group paths were observed" in diagnostic,
                "overflow residue did not precede and preserve the overflow error")
        require(len(diagnostic) <= 512 and "/overflow" not in diagnostic
                and "987654" not in diagnostic,
                "overflow residue diagnostic leaked path/PID evidence or exceeded its bound")

        calls.clear()
        recorded[:] = ["/recorded-a", "/recorded-b"]
        residue_paths.clear()
        residue_paths.update(("/recorded-a", canonical))
        final_evidence = capture_final(client)
        try:
            client["resolve_outcome"](
                RuntimeError("p" * 512),
                [RuntimeError("r" * 512), RuntimeError("c" * 512)], "n" * 64,
                final_evidence)
        except RuntimeError as error:
            diagnostic = str(error)
        else:
            raise RuntimeError("long prior errors hid final cgroup residue")
        require(diagnostic.startswith("fixed-cgroup-residue=true; p") and len(diagnostic) <= 526,
                "fixed residue indicator was truncated behind prior errors")
        require("/recorded-a" not in diagnostic and "/recorded-b" not in diagnostic
                and canonical not in diagnostic and "987654" not in diagnostic,
                "fixed residue diagnostic exposed a retained path or PID")
        require(calls == [("/recorded-a", "final-close"),
                          ("/recorded-b", "final-close"), (canonical, "final-close")],
                "long-error final residue check skipped retained/canonical paths")
    finally:
        recorded[:] = original_recorded
        globals_["cgroup_pids"] = original_cgroup_pids


def client_terminal_empty_launch_routing_cases(client):
    globals_ = client["teardown_owned"].__globals__
    recorded = globals_["RECORDED_CGROUP"]
    canonical = globals_["CANONICAL_CGROUP"]
    originals = (
        list(recorded), globals_["command"], globals_["command_path"],
        globals_["cgroup_pids"], globals_["PROPERTY_RETRIES"],
    )
    nonce = "n" * 64
    invocation = "a" * 32
    service_command = ("/fixture",)

    def loaded_state(active, sub, *, result, code, status):
        return {
            "LoadState": "loaded", "InvocationID": invocation,
            "ActiveState": active, "SubState": sub, "ControlGroup": "",
            "Description": globals_["DESCRIPTION_PREFIX"] + nonce,
            "Environment": globals_["NONCE_VARIABLE"] + "=" + nonce,
            "ExecStart": "argv[]=/fixture ;",
            **globals_["SERVICE_PROPERTIES"],
            "Result": result, "ExecMainCode": code, "ExecMainStatus": status,
        }

    try:
        globals_["command_path"] = lambda *_args, **_kwargs: None
        globals_["PROPERTY_RETRIES"] = 1
        terminal_cases = (
            ("success", loaded_state(
                "active", "exited", result="success", code="1", status="0"), True),
            ("failure", loaded_state(
                "failed", "failed", result="exit-code", code="1", status="73"), False),
        )
        for phase in ("immediate", "recovery"):
            for outcome, terminal, successful in terminal_cases:
                label = phase + "-" + outcome
                prior = "/prior-" + outcome if phase == "immediate" else None
                recorded[:] = [prior] if prior else []
                scans = []
                actions = []
                unit_unloaded = False
                settled = dict(terminal)
                settled["ActiveState"] = "inactive"
                settled["SubState"] = "dead"
                states = [terminal]
                if phase == "immediate":
                    states.extend((terminal, terminal))
                states.extend((terminal, terminal))
                if successful:
                    states.append(terminal)
                states.extend((settled, settled, {
                    "LoadState": "not-found", "ControlGroup": "",
                }))

                def fake_command(argv, *_args, **_kwargs):
                    nonlocal unit_unloaded
                    if len(argv) > 1 and argv[1] == "show":
                        require(states, f"{label} issued an unexpected property read")
                        state = states.pop(0)
                        if state.get("LoadState") == "not-found":
                            unit_unloaded = True
                        requested = [argument.removeprefix("--property=")
                                     for argument in argv if argument.startswith("--property=")]
                        payload = "".join(f"{name}={state[name]}\n" for name in requested
                                          if name in state)
                        return subprocess.CompletedProcess(argv, 0, payload, "")
                    actions.append(argv[1])
                    return subprocess.CompletedProcess(argv, 0, "", "")

                def fake_cgroup_pids(control_group, scan_phase):
                    if scan_phase == "final-close":
                        require(unit_unloaded,
                                f"{label} reached final resolution while its unit remained loaded")
                    scans.append((control_group, scan_phase))
                    return []

                globals_["command"] = fake_command
                globals_["cgroup_pids"] = fake_cgroup_pids
                observed = client["launch_state"](phase, context=phase)
                candidate_invocation = observed.get("InvocationID", "")
                captured_invocation = None
                if (client["valid_invocation"](candidate_invocation)
                        and client["launch_matches"](observed, nonce, service_command)):
                    captured_invocation = candidate_invocation
                require(captured_invocation == invocation,
                        f"{label} did not capture its exact terminal launch identity")

                primary_error = RuntimeError("capture-original") if phase == "recovery" else None
                if phase == "immediate":
                    client["owned_state"](
                        "ownership-read", captured_invocation, nonce, service_command)
                    current = client["owned_state"](
                        "work", captured_invocation, nonce, service_command,
                        "Result", "ExecMainCode", "ExecMainStatus")
                    observed_success = client["successful_terminal_state"](current)
                    require(observed_success is successful,
                            f"{label} empty-cgroup terminal decision changed")
                    if observed_success:
                        client["assert_fixed_cgroups_empty"]("work")
                    else:
                        primary_error = RuntimeError(
                            f"verification invocation failed: {client['sanitized_state'](current)}; "
                            "cleanup_database_failed=False; cleanup_roles_failed=False")
                client["teardown_owned"](captured_invocation, nonce, service_command)
                final_evidence = capture_final(client)
                if primary_error is None:
                    client["resolve_outcome"](None, [], nonce, final_evidence)
                else:
                    assert_fails_with(lambda: client["resolve_outcome"](
                        primary_error, [], nonce, final_evidence), str(primary_error))
                require(unit_unloaded and not states,
                        f"{label} did not complete every routed property observation")
                require(recorded == ([prior] if prior else []),
                        f"{label} empty observation cleared or invented a retained control group")
                expected_phases = (["work"] if phase == "immediate" and successful else []) + [
                    "teardown", "unload", "final-close",
                ]
                expected_paths = ([prior] if prior else []) + [canonical]
                require(scans == [(path, scan_phase) for scan_phase in expected_phases
                                  for path in expected_paths],
                        f"{label} lost sticky/canonical cleanup-driving scans")
                expected_actions = (["stop"] if successful else []) + ["reset-failed"]
                require(actions == expected_actions,
                        f"{label} did not route through owned stop/reset-failed actions")
    finally:
        recorded[:] = originals[0]
        globals_["command"] = originals[1]
        globals_["command_path"] = originals[2]
        globals_["cgroup_pids"] = originals[3]
        globals_["PROPERTY_RETRIES"] = originals[4]


def client_cgroup_observation_cases(client):
    globals_ = client["fixed_cgroup_residue"].__globals__
    recorded = globals_["RECORDED_CGROUP"]
    canonical = globals_["CANONICAL_CGROUP"]
    original_recorded = list(recorded)
    original_cgroup_pids = globals_["cgroup_pids"]
    original_owned_state = globals_["owned_state"]
    original_retry_owned_command = globals_["retry_owned_command"]
    calls = []
    residue_paths = set()
    error_paths = set()

    def fake_cgroup_pids(control_group, phase):
        calls.append((control_group, phase))
        if control_group in error_paths:
            raise client["evidence_failure"](phase, "walk", "evidence", injected())
        return [987654] if control_group in residue_paths else []

    try:
        globals_["cgroup_pids"] = fake_cgroup_pids
        permutations = (
            ("error-before-residue", ("/error-first", "/residue-second", "/later")),
            ("residue-before-error", ("/residue-first", "/error-second", "/later")),
        )
        for label, paths in permutations:
            error_path = next(path for path in paths if "error" in path)
            residue_path = next(path for path in paths if "residue" in path)
            expected = [*(path for path in paths), canonical]
            recorded[:] = list(paths)
            error_paths.clear()
            error_paths.add(error_path)
            residue_paths.clear()
            residue_paths.add(residue_path)

            calls.clear()
            residue, errors = client["fixed_cgroup_residue"]("final-close")
            require(residue == {residue_path: [987654]},
                    f"{label} lost confidential known residue")
            require(tuple(map(str, errors)) == (
                "phase=final-close operation=walk resource=evidence errno=13",),
                f"{label} lost or changed its safe observation diagnostic")
            require(calls == [(path, "final-close") for path in expected],
                    f"{label} did not exhaustively inspect later/canonical paths")

            calls.clear()
            final_evidence = capture_final(client)
            try:
                client["resolve_outcome"](
                    RuntimeError("primary-original"), [], "n" * 64, final_evidence)
            except RuntimeError as error:
                diagnostic = str(error)
            else:
                raise RuntimeError(f"{label} final outcome unexpectedly succeeded")
            require(diagnostic.startswith(
                "fixed-cgroup-residue=true; phase=final-close ")
                and "primary-original" in diagnostic,
                f"{label} did not prioritize residue before observation/primary errors")
            require(calls == [(path, "final-close") for path in expected],
                    f"{label} final rescan skipped later/canonical paths")
            require(all(path not in diagnostic for path in expected)
                    and "987654" not in diagnostic and SECRET not in diagnostic,
                    f"{label} final diagnostic leaked path, PID, or error details")

            owned_calls = 0
            kill_calls = []

            def fake_owned_state(*_args, **_kwargs):
                nonlocal owned_calls
                owned_calls += 1
                if owned_calls <= 3:
                    return {
                        "LoadState": "loaded", "ActiveState": "inactive", "SubState": "dead",
                        "ControlGroup": "",
                    }
                return {"LoadState": "not-found", "ControlGroup": ""}

            def fake_retry_owned_command(_invocation, _nonce, _service_command,
                                         name, action, *_arguments):
                kill_calls.append((name, action))
                residue_paths.clear()
                return True

            globals_["owned_state"] = fake_owned_state
            globals_["retry_owned_command"] = fake_retry_owned_command
            calls.clear()
            try:
                client["teardown_owned"]("i" * 32, "n" * 64, ("/fixture",))
            except RuntimeError as error:
                teardown_diagnostic = str(error)
            else:
                raise RuntimeError(f"{label} teardown discarded its observation error")
            require(kill_calls == [("kill", "kill")],
                    f"{label} observation error prevented known-residue cleanup")
            expected_scan = [(path, "teardown") for path in expected]
            require(calls and len(calls) % len(expected_scan) == 0
                    and all(calls[index:index + len(expected_scan)] == expected_scan
                            for index in range(0, len(calls), len(expected_scan))),
                    f"{label} teardown scan skipped later/canonical paths")
            require("phase=teardown operation=walk resource=evidence errno=13"
                    in teardown_diagnostic
                    and all(path not in teardown_diagnostic for path in expected)
                    and "987654" not in teardown_diagnostic and SECRET not in teardown_diagnostic,
                    f"{label} teardown lost or leaked its safe observation failure")

        recorded[:] = ["/arbitrary-error", "/later"]
        error_paths.clear()
        residue_paths.clear()

        def arbitrary_error(control_group, phase):
            calls.append((control_group, phase))
            if control_group == "/arbitrary-error":
                raise RuntimeError(f"hostile {SECRET} {control_group} pid=987654")
            return []

        globals_["cgroup_pids"] = arbitrary_error
        calls.clear()
        assert_fails_with(lambda: client["assert_fixed_cgroups_empty"]("final-close"),
                          "phase=final-close operation=unknown resource=cgroup errno=5")
        require(calls == [("/arbitrary-error", "final-close"),
                          ("/later", "final-close"), (canonical, "final-close")],
                "no-residue observation failure skipped later/canonical paths")
    finally:
        recorded[:] = original_recorded
        globals_["cgroup_pids"] = original_cgroup_pids
        globals_["owned_state"] = original_owned_state
        globals_["retry_owned_command"] = original_retry_owned_command


def client_cgroup_diagnostic_dedup_cases(client):
    globals_ = client["teardown_owned"].__globals__
    recorded = globals_["RECORDED_CGROUP"]
    canonical = globals_["CANONICAL_CGROUP"]
    original_recorded = list(recorded)
    original_cgroup_pids = globals_["cgroup_pids"]
    original_owned_state = globals_["owned_state"]
    original_retry_owned_command = globals_["retry_owned_command"]
    original_command_deadline = globals_["COMMAND_DEADLINE"]
    calls = []
    owned_calls = 0

    def persistent_error(control_group, phase):
        calls.append((control_group, phase))
        raise client["evidence_failure"](phase, "walk", "evidence", injected())

    def fake_owned_state(*_args, **_kwargs):
        nonlocal owned_calls
        owned_calls += 1
        if owned_calls <= 2:
            return {
                "LoadState": "loaded", "ActiveState": "active", "SubState": "exited",
                "ControlGroup": "",
            }
        return {"LoadState": "not-found", "ControlGroup": ""}

    def cleanup_error(_invocation, _nonce, _service_command, name, action, *_arguments):
        require((name, action) == ("stop", "stop"),
                "persistent observation fixture reached an unexpected cleanup action")
        raise RuntimeError("distinct-cleanup-evidence")

    try:
        recorded[:] = ["/persistent-error"]
        globals_["cgroup_pids"] = persistent_error
        globals_["owned_state"] = fake_owned_state
        globals_["retry_owned_command"] = cleanup_error
        globals_["COMMAND_DEADLINE"] = globals_["time"].monotonic() - 1
        try:
            client["teardown_owned"]("i" * 32, "n" * 64, ("/fixture",))
        except RuntimeError as error:
            diagnostic = str(error)
        else:
            raise RuntimeError("persistent observation diagnostic fixture unexpectedly succeeded")
        observation = "phase=teardown operation=walk resource=evidence errno=13"
        cleanup = "distinct-cleanup-evidence"
        deadline = "absolute client cleanup deadline exhausted before owned unload"
        require(diagnostic.count(observation) == 1,
                "persistent identical cgroup diagnostic was not appended exactly once")
        require(cleanup in diagnostic and deadline in diagnostic
                and diagnostic.index(observation) < diagnostic.index(cleanup) < diagnostic.index(deadline),
                "distinct cleanup/deadline diagnostics were lost, reordered, or over-deduplicated")
        require(len(diagnostic) <= 526,
                "deduplicated teardown diagnostic exceeded the sanitizer bound")
        require(calls == [
            ("/persistent-error", "teardown"), (canonical, "teardown"),
            ("/persistent-error", "teardown"), (canonical, "teardown"),
        ], "polling/final persistent-error scans were not both exhaustive")
    finally:
        recorded[:] = original_recorded
        globals_["cgroup_pids"] = original_cgroup_pids
        globals_["owned_state"] = original_owned_state
        globals_["retry_owned_command"] = original_retry_owned_command
        globals_["COMMAND_DEADLINE"] = original_command_deadline


def client_phase_routing_cases(client):
    globals_ = client["unit_properties"].__globals__
    module_os = globals_["os"]
    original_run = subprocess.run
    original_open = module_os.open
    original_retries = globals_["PROPERTY_RETRIES"]
    original_mode = globals_["REQUESTED_MODE"]
    original_lock_held = globals_["CLIENT_LOCK_HELD"]
    original_counter = globals_["record_counter"]
    original_interceptions = dict(globals_["INTERCEPTIONS"])
    original_boundaries = set(globals_["BOUNDARIES"])
    property_cases = (
        ("prelaunch", lambda: client["unit_properties"]("prelaunch", "LoadState")),
        ("immediate", lambda: client["launch_state"]("immediate", context="immediate")),
        ("recovery", lambda: client["launch_state"]("recovery", context="recovery")),
        ("ownership-read", lambda: client["owned_state"](
            "ownership-read", "i" * 32, "n" * 64, ("/fixture",))),
        ("work", lambda: client["owned_state"](
            "work", "i" * 32, "n" * 64, ("/fixture",))),
        ("teardown", lambda: client["teardown_owned"](
            "i" * 32, "n" * 64, ("/fixture",))),
        ("unload", lambda: client["wait_unloaded"](
            "i" * 32, "n" * 64, ("/fixture",))),
    )
    try:
        globals_["PROPERTY_RETRIES"] = 1
        globals_["CLIENT_LOCK_HELD"] = True
        subprocess.run = lambda *_args, **_kwargs: (_ for _ in ()).throw(injected())
        for phase, call in property_cases:
            assert_fails_with(call,
                              f"unit properties remain unknown: phase={phase} "
                              "operation=run resource=process errno=13")

        module_os.open = lambda *_args, **_kwargs: (_ for _ in ()).throw(injected())
        assert_raises(lambda: client["durable_marker"]("final-close", "fixture"),
                      "phase=final-close operation=open resource=directory errno=13")

        globals_["REQUESTED_MODE"] = "client-cleanup-persistent-unload"
        globals_["INTERCEPTIONS"].clear()
        assert_raises(lambda: client["command_path"]("unload", "unload"),
                      "phase=unload operation=read resource=counter category=io")

        globals_["record_counter"] = lambda _phase, _name: None
        globals_["REQUESTED_MODE"] = "client-cleanup-persistent-show"
        globals_["INTERCEPTIONS"].clear()
        globals_["INTERCEPTIONS"]["show"] = 3
        assert_raises(lambda: client["command_path"]("teardown", "show"),
                      "phase=teardown operation=open resource=directory errno=13")

        globals_["REQUESTED_MODE"] = "client-cleanup-fault-stop"
        globals_["INTERCEPTIONS"].clear()
        assert_raises(lambda: client["command_path"]("teardown", "stop"),
                      "phase=teardown operation=open resource=directory errno=13")

        globals_["REQUESTED_MODE"] = "client-signal-int-unload"
        globals_["BOUNDARIES"].clear()
        assert_raises(lambda: client["cleanup_boundary"]("unload"),
                      "phase=unload operation=open resource=directory errno=13")
    finally:
        subprocess.run = original_run
        module_os.open = original_open
        globals_["PROPERTY_RETRIES"] = original_retries
        globals_["REQUESTED_MODE"] = original_mode
        globals_["CLIENT_LOCK_HELD"] = original_lock_held
        globals_["record_counter"] = original_counter
        globals_["INTERCEPTIONS"].clear()
        globals_["INTERCEPTIONS"].update(original_interceptions)
        globals_["BOUNDARIES"].clear()
        globals_["BOUNDARIES"].update(original_boundaries)


def counter_atomic_cases(client, containment):
    client_globals = client["record_counter"].__globals__
    containment_globals = containment["counter"].__globals__
    module_os = client_globals["os"]
    original_run = client_globals["RUN"]
    original_mode = client_globals["REQUESTED_MODE"]
    original_lock_held = client_globals["CLIENT_LOCK_HELD"]
    original_client_identity = client_globals["counter_identity"]
    original_directory_identity = client_globals["counter_directory_identity"]
    original_containment_identity = containment_globals["counter_identity"]

    def fixture_client_identity(phase, metadata, operation="read"):
        if not stat.S_ISREG(metadata.st_mode):
            raise client["counter_failure"](phase, operation, "unsafe-type")
        if stat.S_IMODE(metadata.st_mode) != 0o600:
            raise client["counter_failure"](phase, operation, "unsafe-mode")
        return metadata.st_dev, metadata.st_ino

    def fixture_containment_identity(phase, metadata):
        if not stat.S_ISREG(metadata.st_mode):
            raise containment["counter_failure"](phase, "read", "unsafe-type")
        if stat.S_IMODE(metadata.st_mode) != 0o600:
            raise containment["counter_failure"](phase, "read", "unsafe-mode")
        return metadata.st_dev, metadata.st_ino

    def fixture_directory_identity(phase, metadata):
        if not stat.S_ISDIR(metadata.st_mode):
            raise client["counter_failure"](phase, "publish", "unsafe-type")
        if stat.S_IMODE(metadata.st_mode) != 0o700:
            raise client["counter_failure"](phase, "publish", "unsafe-mode")
        return metadata.st_dev, metadata.st_ino

    def bounded_call(function):
        result = []
        failure = []

        def invoke():
            try:
                result.append(function())
            except BaseException as error:
                failure.append(error)

        worker = threading.Thread(target=invoke, daemon=True)
        worker.start()
        worker.join(2)
        require(not worker.is_alive(), "hostile counter open did not complete boundedly")
        return result, failure

    def assert_bounded_raises(function, expected):
        result, failure = bounded_call(function)
        require(not result and len(failure) == 1 and expected in str(failure[0]),
                f"expected bounded counter failure containing {expected!r}, got {failure!r}")

    parser_cases = (
        (b"", "empty"), (b"1", "non-canonical"), (b"01\n", "non-canonical"),
        (b"+1\n", "non-canonical"), (b"-1\n", "non-canonical"),
        (b" 1\n", "non-canonical"), (b"1 \n", "non-canonical"),
        (b"1\n2\n", "non-canonical"), (b"\xff\n", "non-ascii"),
        (b"1000000\n", "oversize"),
    )
    for namespace in (client, containment):
        phases = (("work",) if namespace is client else
                  ("slow-cleanup", "transient-cleanup", "persistent-cleanup"))
        for payload, category in parser_cases:
            for phase in phases:
                assert_raises(
                    lambda namespace=namespace, payload=payload, phase=phase:
                        namespace["parse_counter"](phase, payload),
                    f"phase={phase} operation=parse resource=counter category={category}")

    unsafe = types.SimpleNamespace(
        st_mode=stat.S_IFREG | 0o600, st_uid=1, st_gid=0, st_dev=1, st_ino=2)
    assert_raises(lambda: original_client_identity("work", unsafe),
                  "phase=work operation=read resource=counter category=unsafe-owner")
    assert_raises(lambda: original_containment_identity("persistent-cleanup", unsafe),
                  "phase=persistent-cleanup operation=read resource=counter category=unsafe-owner")
    synthetic_block = types.SimpleNamespace(
        st_mode=stat.S_IFBLK | 0o600, st_uid=0, st_gid=0, st_dev=1, st_ino=3)
    assert_raises(lambda: original_client_identity("work", synthetic_block),
                  "phase=work operation=read resource=counter category=unsafe-type")
    assert_raises(lambda: original_containment_identity("persistent-cleanup", synthetic_block),
                  "phase=persistent-cleanup operation=read resource=counter category=unsafe-type")

    try:
        client_globals["REQUESTED_MODE"] = "fixture"
        client_globals["counter_identity"] = fixture_client_identity
        client_globals["counter_directory_identity"] = fixture_directory_identity
        containment_globals["counter_identity"] = fixture_containment_identity
        with tempfile.TemporaryDirectory() as directory:
            client_globals["RUN"] = directory
            path = os.path.join(directory, "fixture.count")

            client_globals["CLIENT_LOCK_HELD"] = False
            assert_raises(lambda: client["record_counter"]("work", "count"),
                          "phase=work operation=publish resource=counter category=lock-required")
            require(not os.listdir(directory),
                    "false client-lock state published a counter artifact")
            client_globals["CLIENT_LOCK_HELD"] = True

            os.mkfifo(path, 0o600)
            assert_bounded_raises(
                lambda: containment["counter"]("persistent-cleanup", path),
                "category=unsafe-type")
            assert_bounded_raises(
                lambda: client["record_counter"]("work", "count"),
                "category=unsafe-type")
            os.unlink(path)

            assert_bounded_raises(
                lambda: containment["counter"]("persistent-cleanup", "/dev/null"),
                "category=unsafe-type")
            pathlib.Path(path).write_bytes(b"0\n")
            os.chmod(path, 0o600)
            original_open = module_os.open
            original_fstat = module_os.fstat
            original_write = module_os.write
            original_close = module_os.close
            original_unlink = module_os.unlink
            original_lseek = module_os.lseek
            original_ftruncate = module_os.ftruncate
            synthetic_block_anchors = set()

            def synthetic_block_open(target, flags, *args, **kwargs):
                if target == "fixture.count" and flags == (os.O_PATH | os.O_NOFOLLOW):
                    descriptor = original_open(target, flags, *args, **kwargs)
                    synthetic_block_anchors.add(descriptor)
                    return descriptor
                return original_open(target, flags, *args, **kwargs)

            def synthetic_block_fstat(descriptor):
                metadata = original_fstat(descriptor)
                if descriptor in synthetic_block_anchors:
                    synthetic_block_anchors.remove(descriptor)
                    return types.SimpleNamespace(
                        st_mode=stat.S_IFBLK | 0o600, st_uid=metadata.st_uid,
                        st_gid=metadata.st_gid, st_dev=metadata.st_dev, st_ino=metadata.st_ino)
                return metadata

            module_os.open = synthetic_block_open
            module_os.fstat = synthetic_block_fstat
            assert_bounded_raises(
                lambda: client["record_counter"]("work", "count"),
                "category=unsafe-type")
            module_os.open = original_open
            module_os.fstat = original_fstat
            require(pathlib.Path(path).read_bytes() == b"0\n",
                    "device-anchor rejection changed the published counter")

            pathlib.Path(path).write_bytes(b"3\n")
            os.chmod(path, 0o600)
            original_read = module_os.read
            disappear_once = True

            def disappear_during_read(descriptor, size):
                nonlocal disappear_once
                payload = original_read(descriptor, size)
                if payload and disappear_once:
                    disappear_once = False
                    os.unlink(path)
                return payload

            module_os.read = disappear_during_read
            assert_raises(lambda: containment["counter"]("persistent-cleanup", path),
                          "phase=persistent-cleanup operation=read resource=counter "
                          "category=rebound")
            module_os.read = original_read

            pathlib.Path(path).write_bytes(b"4\n")
            os.chmod(path, 0o600)
            disappear_once = True
            module_os.read = disappear_during_read
            assert_raises(lambda: client["record_counter"]("work", "count"),
                          "phase=work operation=read resource=counter category=rebound")
            module_os.read = original_read
            require(not os.path.exists(path),
                    "producer reset a counter that disappeared after observation")

            pathlib.Path(path).write_bytes(b"0\n")
            os.chmod(path, 0o600)
            fifo_stale = path + ".tmp." + "c" * 32
            os.mkfifo(fifo_stale, 0o600)
            stale_result, stale_failure = bounded_call(
                lambda: client["record_counter"]("work", "count"))
            require(stale_result == [None] and not stale_failure,
                    f"stale FIFO cleanup failed: {stale_failure!r}")
            require(stat.S_ISFIFO(os.lstat(fifo_stale).st_mode)
                    and containment["counter"]("persistent-cleanup", path) == 1,
                    "stale FIFO cleanup blocked, removed the FIFO, or skipped publication")
            os.unlink(fifo_stale)

            block_stale = path + ".tmp." + "e" * 32
            pathlib.Path(block_stale).write_bytes(b"synthetic block\n")
            os.chmod(block_stale, 0o600)
            block_anchors = set()

            def stale_block_open(target, flags, *args, **kwargs):
                descriptor = original_open(target, flags, *args, **kwargs)
                if target == os.path.basename(block_stale) and flags == (os.O_PATH | os.O_NOFOLLOW):
                    block_anchors.add(descriptor)
                return descriptor

            def stale_block_fstat(descriptor):
                metadata = original_fstat(descriptor)
                if descriptor in block_anchors:
                    block_anchors.remove(descriptor)
                    return types.SimpleNamespace(
                        st_mode=stat.S_IFBLK | 0o600, st_uid=metadata.st_uid,
                        st_gid=metadata.st_gid, st_dev=metadata.st_dev, st_ino=metadata.st_ino)
                return metadata

            module_os.open = stale_block_open
            module_os.fstat = stale_block_fstat
            block_result, block_failure = bounded_call(
                lambda: client["record_counter"]("work", "count"))
            module_os.open = original_open
            module_os.fstat = original_fstat
            require(block_result == [None] and not block_failure and os.path.exists(block_stale),
                    "stale synthetic block entry blocked, was deleted, or prevented publication")
            os.unlink(block_stale)
            pathlib.Path(path).write_bytes(b"0\n")
            os.chmod(path, 0o600)

            before_replace = threading.Event()
            permit_replace = threading.Event()
            original_replace = module_os.replace

            def barrier_replace(*args, **kwargs):
                before_replace.set()
                require(permit_replace.wait(5), "counter publication barrier timed out")
                return original_replace(*args, **kwargs)

            module_os.replace = barrier_replace
            failure = []

            def publish_at_barrier():
                try:
                    client["record_counter"]("work", "count")
                except BaseException as error:
                    failure.append(error)

            publisher = threading.Thread(
                target=publish_at_barrier, daemon=True)
            publisher.start()
            require(before_replace.wait(5), "counter publisher did not reach replace barrier")
            require(containment["counter"]("persistent-cleanup", path) == 0,
                    "pre-replace reader did not retain the old counter")
            permit_replace.set()
            publisher.join(5)
            require(not publisher.is_alive() and not failure,
                    "counter publisher did not finish after replace barrier")
            module_os.replace = original_replace
            require(containment["counter"]("persistent-cleanup", path) == 1,
                    "post-replace reader did not observe the new counter")
            for expected in (2, 3, 4):
                client["record_counter"]("work", "count")
                require(containment["counter"]("persistent-cleanup", path) == expected,
                        "repeated counter publication was not monotonic")

            def replace_during_read(replacement):
                replaced = False

                def racing_read(descriptor, size):
                    nonlocal replaced
                    payload = original_read(descriptor, size)
                    if payload and not replaced:
                        replaced = True
                        os.replace(replacement, path)
                    return payload

                return racing_read

            pathlib.Path(path).write_bytes(b"10\n")
            replacement = path + ".race"
            pathlib.Path(replacement).write_bytes(b"11\n")
            os.chmod(path, 0o600)
            os.chmod(replacement, 0o600)
            module_os.read = replace_during_read(replacement)
            raced_value = containment["counter"]("persistent-cleanup", path)
            module_os.read = original_read
            require(raced_value in (10, 11) and raced_value == 11,
                    "reader rejected or returned the incoherent pre-replace snapshot")

            pathlib.Path(path).write_bytes(b"20\n")
            pathlib.Path(replacement).write_bytes(b"21\n")
            os.chmod(path, 0o600)
            os.chmod(replacement, 0o600)
            module_os.read = replace_during_read(replacement)
            client["record_counter"]("work", "count")
            module_os.read = original_read
            require(containment["counter"]("persistent-cleanup", path) == 22,
                    "producer did not retry a counter replaced during its old-value read")
            pathlib.Path(path).write_bytes(b"4\n")
            os.chmod(path, 0o600)

            original_replace_for_rebind = module_os.replace

            def rebind_publish_source(source, destination, *args, **kwargs):
                if ".tmp." in source and ".cleanup." not in destination:
                    source_directory = kwargs["src_dir_fd"]
                    os.unlink(source, dir_fd=source_directory)
                    hostile_descriptor = original_open(
                        source, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW,
                        0o600, dir_fd=source_directory)
                    try:
                        original_write(hostile_descriptor, b"777\n")
                    finally:
                        module_os.close(hostile_descriptor)
                return original_replace_for_rebind(source, destination, *args, **kwargs)

            module_os.replace = rebind_publish_source
            assert_raises(lambda: client["record_counter"]("work", "count"),
                          "phase=work operation=publish resource=counter "
                          "category=published-uncertain")
            module_os.replace = original_replace_for_rebind
            require(pathlib.Path(path).read_bytes() == b"777\n",
                    "source-name rebound was reported successful or hidden")
            pathlib.Path(path).write_bytes(b"4\n")
            os.chmod(path, 0o600)

            content_rebound = False
            publication_cleanup_closes = 0

            def corrupt_published_content(descriptor, offset, whence):
                nonlocal content_rebound
                result = original_lseek(descriptor, offset, whence)
                if not content_rebound:
                    content_rebound = True
                    original_ftruncate(descriptor, 0)
                    original_write(descriptor, b"888\n")
                    original_lseek(descriptor, 0, os.SEEK_SET)
                return result

            def fail_publication_cleanup_close(descriptor):
                nonlocal publication_cleanup_closes
                original_close(descriptor)
                if content_rebound:
                    publication_cleanup_closes += 1
                    raise injected()

            module_os.lseek = corrupt_published_content
            module_os.close = fail_publication_cleanup_close
            try:
                assert_raises(lambda: client["record_counter"]("work", "count"),
                              "phase=work operation=publish resource=counter "
                              "category=published-uncertain; cleanup=io|io|io")
            finally:
                module_os.lseek = original_lseek
                module_os.close = original_close
            require(content_rebound and publication_cleanup_closes == 3
                    and pathlib.Path(path).read_bytes() == b"888\n",
                    "destination content check or independent outer closes did not execute")
            pathlib.Path(path).write_bytes(b"4\n")
            os.chmod(path, 0o600)

            stale = path + ".tmp." + "a" * 32
            pathlib.Path(stale).write_bytes(b"99\n")
            os.chmod(stale, 0o600)
            hostile = path + ".tmp." + "b" * 32
            os.symlink(path, hostile)
            client["record_counter"]("work", "count")
            require(not os.path.lexists(stale) and os.path.islink(hostile),
                    "stale cleanup removed an unsafe path or retained its owned regular temp")

            rebound_stale = path + ".tmp." + "d" * 32
            pathlib.Path(rebound_stale).write_bytes(b"55\n")
            os.chmod(rebound_stale, 0o600)

            def rebind_cleanup_source(source, destination, *args, **kwargs):
                if source.endswith("d" * 32) and ".cleanup." in destination:
                    source_directory = kwargs["src_dir_fd"]
                    os.unlink(source, dir_fd=source_directory)
                    hostile_descriptor = original_open(
                        source, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW,
                        0o600, dir_fd=source_directory)
                    try:
                        original_write(hostile_descriptor, b"888\n")
                    finally:
                        module_os.close(hostile_descriptor)
                return original_replace_for_rebind(source, destination, *args, **kwargs)

            module_os.replace = rebind_cleanup_source
            assert_raises(lambda: client["record_counter"]("work", "count"),
                          "phase=work operation=publish resource=counter category=rebound")
            module_os.replace = original_replace_for_rebind
            preserved = [entry for entry in os.listdir(directory)
                         if entry.startswith(os.path.basename(rebound_stale) + ".cleanup.")]
            require(len(preserved) == 1
                    and pathlib.Path(directory, preserved[0]).read_bytes() == b"888\n",
                    "cleanup deleted or accepted an entry rebound before quarantine")
            os.unlink(os.path.join(directory, preserved[0]))

            original_write = module_os.write
            module_os.write = lambda descriptor, payload: original_write(descriptor, payload[:1])
            old = pathlib.Path(path).read_bytes()
            assert_raises(lambda: client["record_counter"]("work", "count"),
                          "phase=work operation=publish resource=counter category=short-write")
            module_os.write = original_write
            require(pathlib.Path(path).read_bytes() == old,
                    "positive short write changed the published counter")

            def zero_write(_descriptor, _payload):
                return 0

            old = pathlib.Path(path).read_bytes()
            module_os.write = zero_write
            assert_raises(lambda: client["record_counter"]("work", "count"),
                          "phase=work operation=publish resource=counter category=short-write")
            module_os.write = original_write
            require(pathlib.Path(path).read_bytes() == old,
                    "zero-write failure changed the published counter")

            module_os.write = lambda _descriptor, payload: len(payload) + 1
            assert_raises(lambda: client["record_counter"]("work", "count"),
                          "phase=work operation=publish resource=counter category=short-write")
            module_os.write = original_write
            require(pathlib.Path(path).read_bytes() == old,
                    "out-of-range write count changed the published counter")

            module_os.write = lambda *_args: (_ for _ in ()).throw(injected())
            assert_raises(lambda: client["record_counter"]("work", "count"),
                          "phase=work operation=publish resource=counter category=io")
            module_os.write = original_write
            require(pathlib.Path(path).read_bytes() == old,
                    "write failure changed the published counter")

            fstat_failed = False
            created_descriptors = set()

            def post_create_open(target, flags, *args, **kwargs):
                descriptor = original_open(target, flags, *args, **kwargs)
                if ".tmp." in str(target) and flags & os.O_EXCL:
                    created_descriptors.add(descriptor)
                return descriptor

            def post_create_fstat(descriptor):
                nonlocal fstat_failed
                if descriptor in created_descriptors and not fstat_failed:
                    fstat_failed = True
                    raise injected()
                return original_fstat(descriptor)

            module_os.open = post_create_open
            module_os.fstat = post_create_fstat
            entries_before_fstat_failure = set(os.listdir(directory))
            assert_raises(lambda: client["record_counter"]("work", "count"),
                          "phase=work operation=publish resource=counter category=io")
            module_os.open = original_open
            module_os.fstat = original_fstat
            require(fstat_failed and pathlib.Path(path).read_bytes() == old
                    and set(os.listdir(directory)) == entries_before_fstat_failure,
                    "post-create fstat failure leaked an artifact or changed the counter")

            uncertain_opened = []
            uncertain_closed = []
            uncertain_created = set()
            uncertain_unlinks = []
            uncertain_fstat_failures = 0

            def uncertain_open(target, flags, *args, **kwargs):
                descriptor = original_open(target, flags, *args, **kwargs)
                uncertain_opened.append((descriptor, str(target), flags))
                if ".tmp." in str(target) and flags & os.O_EXCL:
                    uncertain_created.add(descriptor)
                return descriptor

            def uncertain_fstat(descriptor):
                nonlocal uncertain_fstat_failures
                if descriptor in uncertain_created and uncertain_fstat_failures < 2:
                    uncertain_fstat_failures += 1
                    raise injected()
                return original_fstat(descriptor)

            def uncertain_close(descriptor):
                original_close(descriptor)
                uncertain_closed.append(descriptor)

            def uncertain_unlink(target, *args, **kwargs):
                uncertain_unlinks.append(str(target))
                return original_unlink(target, *args, **kwargs)

            entries_before_uncertainty = set(os.listdir(directory))
            module_os.open = uncertain_open
            module_os.fstat = uncertain_fstat
            module_os.close = uncertain_close
            module_os.unlink = uncertain_unlink
            try:
                assert_raises(lambda: client["record_counter"]("work", "count"),
                              "phase=work operation=publish resource=counter category=io; "
                              "cleanup=io|published-uncertain")
            finally:
                module_os.open = original_open
                module_os.fstat = original_fstat
                module_os.close = original_close
                module_os.unlink = original_unlink
            unresolved = set(os.listdir(directory)) - entries_before_uncertainty
            require(uncertain_fstat_failures == 2 and pathlib.Path(path).read_bytes() == old,
                    "bounded identity uncertainty changed the existing destination")
            require(len(unresolved) == 1, "bounded identity uncertainty did not preserve one temp")
            unresolved_name = next(iter(unresolved))
            unresolved_token = unresolved_name.removeprefix("fixture.count.tmp.")
            require(unresolved_name.startswith("fixture.count.tmp.")
                    and len(unresolved_token) == 32
                    and all(character in "0123456789abcdef" for character in unresolved_token)
                    and not uncertain_unlinks,
                    "bounded identity uncertainty unlinked a name without an identity")
            require(sorted(descriptor for descriptor, _target, _flags in uncertain_opened)
                    == sorted(uncertain_closed),
                    "bounded identity uncertainty left an opened descriptor unclosed")
            require(any(target == directory for _descriptor, target, _flags in uncertain_opened)
                    and any(target == unresolved_name and flags & os.O_EXCL
                            for _descriptor, target, flags in uncertain_opened),
                    "bounded identity uncertainty did not track directory and temp descriptors")

            recovery_opened = []
            recovery_closed = []
            recovery_replaces = []
            recovery_unlinks = []

            def recovery_open(target, flags, *args, **kwargs):
                descriptor = original_open(target, flags, *args, **kwargs)
                recovery_opened.append((descriptor, str(target), flags))
                return descriptor

            def recovery_close(descriptor):
                original_close(descriptor)
                recovery_closed.append(descriptor)

            def recovery_replace(source, destination, *args, **kwargs):
                recovery_replaces.append((str(source), str(destination)))
                return original_replace(source, destination, *args, **kwargs)

            def recovery_unlink(target, *args, **kwargs):
                recovery_unlinks.append(str(target))
                return original_unlink(target, *args, **kwargs)

            module_os.open = recovery_open
            module_os.close = recovery_close
            module_os.replace = recovery_replace
            module_os.unlink = recovery_unlink
            try:
                client["record_counter"]("work", "count")
            finally:
                module_os.open = original_open
                module_os.close = original_close
                module_os.replace = original_replace
                module_os.unlink = original_unlink
            quarantine_names = [destination for source, destination in recovery_replaces
                                if source == unresolved_name
                                and destination.startswith(unresolved_name + ".cleanup.")]
            require(len(quarantine_names) == 1 and unresolved_name not in recovery_unlinks
                    and recovery_unlinks.count(quarantine_names[0]) == 1,
                    "later recovery did not quarantine and remove the exact stale temp")
            require(not os.path.lexists(os.path.join(directory, unresolved_name))
                    and containment["counter"]("persistent-cleanup", path)
                        == int(old.decode("ascii").strip()) + 1,
                    "later recovery did not safely publish the monotonic counter")
            require(sorted(descriptor for descriptor, _target, _flags in recovery_opened)
                    == sorted(recovery_closed)
                    and any(target.startswith("/proc/self/fd/")
                            for _descriptor, target, _flags in recovery_opened),
                    "later recovery left a content, temp, or directory descriptor unclosed")

            def client_counter_read():
                directory_descriptor = original_open(
                    directory, os.O_RDONLY | os.O_DIRECTORY)
                try:
                    return client["read_counter"](
                        "work", directory_descriptor, "fixture.count")
                finally:
                    module_os.close(directory_descriptor)

            for namespace, invoke in (
                    (client, client_counter_read),
                    (containment, lambda: containment["counter"]("persistent-cleanup", path))):
                pathlib.Path(path).write_bytes(b"01\n")
                os.chmod(path, 0o600)
                opened = []
                closed = []

                def tracking_open(target, flags, *args, **kwargs):
                    descriptor = original_open(target, flags, *args, **kwargs)
                    if target == path or target == "fixture.count" or str(target).startswith("/proc/self/fd/"):
                        opened.append(descriptor)
                    return descriptor

                def failing_reader_close(descriptor):
                    original_close(descriptor)
                    if descriptor in opened:
                        closed.append(descriptor)
                        raise injected()

                module_os.open = tracking_open
                module_os.close = failing_reader_close
                try:
                    assert_raises(invoke,
                                  ("phase=work" if namespace is client else
                                   "phase=persistent-cleanup")
                                  + " operation=parse resource=counter category=non-canonical; "
                                    "cleanup=io|io")
                finally:
                    module_os.open = original_open
                    module_os.close = original_close
                require(len(set(closed)) == 2,
                        "coherent reader did not attempt both content and anchor closes")
            pathlib.Path(path).write_bytes(old)
            os.chmod(path, 0o600)

            cleanup_started = False
            cleanup_closes = 0
            cleanup_renames = 0
            def primary_write_failure(*_args):
                nonlocal cleanup_started
                cleanup_started = True
                raise injected()

            def failing_cleanup_close(descriptor):
                nonlocal cleanup_closes
                original_close(descriptor)
                if cleanup_started:
                    cleanup_closes += 1
                    raise injected()

            def failing_cleanup_rename(*_args, **_kwargs):
                nonlocal cleanup_renames
                cleanup_renames += 1
                raise injected()

            module_os.write = primary_write_failure
            module_os.close = failing_cleanup_close
            module_os.replace = failing_cleanup_rename
            try:
                assert_raises(lambda: client["record_counter"]("work", "count"),
                              "phase=work operation=publish resource=counter category=io; cleanup="
                              "io|io|io")
            finally:
                module_os.write = original_write
                module_os.close = original_close
                module_os.replace = original_replace_for_rebind
            require(cleanup_closes == 2 and cleanup_renames == 1,
                    "cleanup failure skipped a later independent cleanup action")

            original_fsync = module_os.fsync
            module_os.fsync = lambda _descriptor: (_ for _ in ()).throw(injected())
            assert_raises(lambda: client["record_counter"]("work", "count"),
                          "phase=work operation=publish resource=counter category=io")
            module_os.fsync = original_fsync
            require(pathlib.Path(path).read_bytes() == old,
                    "temporary fsync failure changed the published counter")

            def fail_publish_replace(source, destination, *args, **kwargs):
                if ".cleanup." not in destination:
                    raise injected()
                return original_replace(source, destination, *args, **kwargs)

            module_os.replace = fail_publish_replace
            assert_raises(lambda: client["record_counter"]("work", "count"),
                          "phase=work operation=publish resource=counter category=io")
            module_os.replace = original_replace
            require(pathlib.Path(path).read_bytes() == old,
                    "replace failure changed the published counter")

            fsync_calls = 0

            def fail_directory_fsync(descriptor):
                nonlocal fsync_calls
                fsync_calls += 1
                if stat.S_ISDIR(module_os.fstat(descriptor).st_mode):
                    raise injected()
                return original_fsync(descriptor)

            module_os.fsync = fail_directory_fsync
            assert_raises(lambda: client["record_counter"]("work", "count"),
                          "phase=work operation=publish resource=counter "
                          "category=published-uncertain")
            module_os.fsync = original_fsync
            require(fsync_calls == 2 and containment["counter"]("persistent-cleanup", path) == 6,
                    "directory fsync failure destroyed published evidence")

            pathlib.Path(path).write_bytes(b"999999\n")
            os.chmod(path, 0o600)
            assert_raises(lambda: client["record_counter"]("work", "count"),
                          "phase=work operation=parse resource=counter category=overflow")
            require(pathlib.Path(path).read_bytes() == b"999999\n",
                    "counter overflow changed the published bound")

            pathlib.Path(path).write_bytes(b"1\n")
            os.chmod(path, 0o644)
            assert_raises(lambda: containment["counter"]("persistent-cleanup", path),
                          "phase=persistent-cleanup operation=read resource=counter "
                          "category=unsafe-mode")
            os.chmod(path, 0o600)
            original_stat = module_os.stat

            rebound_stats = 0

            def rebound_stat(target, *args, **kwargs):
                nonlocal rebound_stats
                metadata = original_stat(target, *args, **kwargs)
                if target == path:
                    rebound_stats += 1
                    return types.SimpleNamespace(
                        st_mode=metadata.st_mode, st_uid=metadata.st_uid, st_gid=metadata.st_gid,
                        st_dev=metadata.st_dev, st_ino=metadata.st_ino + rebound_stats)
                return metadata

            module_os.stat = rebound_stat
            assert_raises(lambda: containment["counter"]("persistent-cleanup", path),
                          "phase=persistent-cleanup operation=read resource=counter "
                          "category=rebound")
            module_os.stat = original_stat
            require(rebound_stats == containment_globals["COUNTER_READ_ATTEMPTS"],
                    "counter rebound retries were not strictly bounded")

            pathlib.Path(path).write_bytes(b"30\n")
            pathlib.Path(replacement).write_bytes(b"31\n")
            os.chmod(path, 0o600)
            os.chmod(replacement, 0o600)

            def symlink_during_read(descriptor, size):
                payload = original_read(descriptor, size)
                if os.path.isfile(replacement):
                    os.unlink(path)
                    os.symlink(replacement, path)
                return payload

            module_os.read = symlink_during_read
            assert_raises(lambda: containment["counter"]("persistent-cleanup", path),
                          "phase=persistent-cleanup operation=read resource=counter "
                          "category=unsafe-type")
            module_os.read = original_read
            os.unlink(path)
            pathlib.Path(path).write_bytes(b"40\n")
            os.chmod(path, 0o600)

            rebound_to_fifo = True

            def fifo_during_read(descriptor, size):
                nonlocal rebound_to_fifo
                payload = original_read(descriptor, size)
                if rebound_to_fifo:
                    rebound_to_fifo = False
                    os.unlink(path)
                    os.mkfifo(path, 0o600)
                return payload

            module_os.read = fifo_during_read
            assert_bounded_raises(
                lambda: containment["counter"]("persistent-cleanup", path),
                "category=unsafe-type")
            module_os.read = original_read

            os.unlink(path)
            require(containment["counter"]("persistent-cleanup", path) == 0,
                    "missing counter did not read as zero")
            os.mkdir(path, 0o700)
            assert_raises(lambda: containment["counter"]("persistent-cleanup", path),
                          "phase=persistent-cleanup operation=read resource=counter "
                          "category=unsafe-type")
            os.rmdir(path)
            os.symlink(hostile, path)
            assert_raises(lambda: containment["counter"]("persistent-cleanup", path),
                          "phase=persistent-cleanup operation=read resource=counter "
                          "category=unsafe-type")
            os.unlink(path)
    finally:
        module_os.replace = original_replace if "original_replace" in locals() else module_os.replace
        module_os.write = original_write if "original_write" in locals() else module_os.write
        module_os.fsync = original_fsync if "original_fsync" in locals() else module_os.fsync
        module_os.read = original_read if "original_read" in locals() else module_os.read
        module_os.stat = original_stat if "original_stat" in locals() else module_os.stat
        module_os.fstat = original_fstat if "original_fstat" in locals() else module_os.fstat
        module_os.open = original_open if "original_open" in locals() else module_os.open
        module_os.close = original_close if "original_close" in locals() else module_os.close
        module_os.unlink = original_unlink if "original_unlink" in locals() else module_os.unlink
        module_os.lseek = original_lseek if "original_lseek" in locals() else module_os.lseek
        module_os.ftruncate = (original_ftruncate if "original_ftruncate" in locals()
                               else module_os.ftruncate)
        client_globals["RUN"] = original_run
        client_globals["REQUESTED_MODE"] = original_mode
        client_globals["CLIENT_LOCK_HELD"] = original_lock_held
        client_globals["counter_identity"] = original_client_identity
        client_globals["counter_directory_identity"] = original_directory_identity
        containment_globals["counter_identity"] = original_containment_identity


def actual_boundary_cases(client, containment):
    client_globals = client["publish_supervisor"].__globals__
    containment_globals = containment["release"].__globals__
    module_os = client_globals["os"]

    original_open = module_os.open
    try:
        module_os.open = lambda *_args, **_kwargs: (_ for _ in ()).throw(injected())
        assert_raises(lambda: client["durable_marker"]("work", "fixture"),
                      "phase=work operation=open resource=directory errno=13")
        assert_raises(client["open_client_lock"],
                      "phase=startup operation=open resource=lock errno=13")
        assert_raises(lambda: containment["release"]("client-fault", "fixture"),
                      "phase=client-fault operation=open resource=directory errno=13")
        assert_raises(containment["assert_client_lock_reusable"],
                      "phase=transaction-lock operation=open resource=lock errno=13")
        assert_raises(containment["open_transaction_lock"],
                      "phase=transaction-lock operation=open resource=transaction errno=13")
    finally:
        module_os.open = original_open

    producer_originals = {name: containment_globals[name] for name in (
        "path_exists", "producer_unit_evidence", "intent_journal_evidence",
        "producer_transaction_state")}
    try:
        containment_globals["path_exists"] = lambda *_args, **_kwargs: False
        containment_globals["producer_unit_evidence"] = lambda *_args: (
            {"LoadState": "not-found"}, None, None)
        containment_globals["intent_journal_evidence"] = lambda *_args: "absent"
        containment_globals["producer_transaction_state"] = lambda: "reusable"
        assert_fails_with(lambda: containment["producer_wait_evidence"](
            types.SimpleNamespace(poll=lambda: 1), "after-intent", "run-root", None,
            "/repo", "c" * 40, "/go", "intent:run-root:after-intent", 0,
            {"communicated": True, "stdout": "", "stderr": "", "reaped": True,
             "result_exact": False}), "producer-exit-before-ready")
    finally:
        for name, value in producer_originals.items():
            containment_globals[name] = value

    original_builtin_open = containment_globals.get("open")
    containment_globals["open"] = lambda *_args, **_kwargs: (_ for _ in ()).throw(injected())
    try:
        module_os.open = lambda *_args, **_kwargs: (_ for _ in ()).throw(injected())
        assert_raises(lambda: containment["counter"]("client-fault", HOSTILE_PATH),
                      "phase=client-fault operation=read resource=counter category=io")
        module_os.open = original_open
        containment_globals["open"] = lambda *_args, **_kwargs: (
            _ for _ in ()).throw(injected(errno.ENOENT))
        assert_raises(lambda: containment["read_pid"](HOSTILE_PATH, "preflight"),
                      "phase=preflight operation=open resource=pid errno=2")
    finally:
        if original_builtin_open is None:
            del containment_globals["open"]
        else:
            containment_globals["open"] = original_builtin_open

    original_unlink = module_os.unlink
    try:
        module_os.unlink = lambda *_args, **_kwargs: (_ for _ in ()).throw(injected())
        assert_raises(lambda: containment["reset_paths"]("client-fault", HOSTILE_PATH),
                      "phase=client-fault operation=unlink resource=marker errno=13")
    finally:
        module_os.unlink = original_unlink

    module_os.open = original_open

    original_command = client_globals["command"]
    original_unlink = module_os.unlink
    try:
        commit = "c" * 40
        client_globals["command"] = lambda argv, *_args, **_kwargs: types.SimpleNamespace(
            stdout=(commit + "\n" if "rev-parse" in argv else "fixture source"))
        module_os.unlink = lambda *_args, **_kwargs: (_ for _ in ()).throw(
            FileNotFoundError(errno.ENOENT, SECRET, HOSTILE_PATH))
        module_os.open = lambda *_args, **_kwargs: (_ for _ in ()).throw(injected())
        assert_raises(lambda: client["publish_supervisor"]("/repo", commit),
                      "phase=source-publication operation=open resource=helper errno=13")
    finally:
        client_globals["command"] = original_command
        module_os.unlink = original_unlink
        module_os.open = original_open

    original_flock = containment_globals["fcntl"].flock
    original_close = module_os.close
    try:
        class StatefulBlockingIOError(BlockingIOError):
            def __init__(self, observations):
                self.observations = tuple(observations)
                self.accesses = 0

            @property
            def errno(self):
                self.accesses += 1
                observation = self.observations[self.accesses - 1]
                if isinstance(observation, BaseException):
                    raise observation
                return observation

        containment_globals["fcntl"].flock = lambda *_args: (
            _ for _ in ()).throw(injected())
        assert_raises(lambda: client["lock_client"](90),
                      "phase=startup operation=flock resource=lock errno=13")
        assert_raises(lambda: containment["lock_transaction"](90),
                      "phase=transaction-lock operation=flock resource=transaction errno=13")

        contention = BlockingIOError(errno.EWOULDBLOCK, "hostile " + SECRET, HOSTILE_PATH)
        containment_globals["fcntl"].flock = lambda *_args: (
            _ for _ in ()).throw(contention)
        require(not containment["try_nonblocking_flock"](
            90, "transaction-lock", "lock"),
                "expected nonblocking contention was not returned explicitly")

        stateful_cases = (
            ((errno.EIO, errno.EWOULDBLOCK), False, "errno=5"),
            ((errno.EWOULDBLOCK, errno.EIO), True, None),
            ((RuntimeError(SECRET), errno.EWOULDBLOCK), False, "errno=unknown"),
            ((SECRET, errno.EWOULDBLOCK), False, "errno=unknown"),
            ((errno.EACCES, RuntimeError(SECRET)), False, "errno=13"),
        )
        for observations, expected_contention, expected_evidence in stateful_cases:
            stateful = StatefulBlockingIOError(observations)
            containment_globals["fcntl"].flock = lambda *_args, failure=stateful: (
                _ for _ in ()).throw(failure)
            if expected_contention:
                require(not containment["try_nonblocking_flock"](
                    90, "transaction-lock", "lock"),
                        "captured EWOULDBLOCK did not retain the contention result")
            else:
                try:
                    containment["try_nonblocking_flock"](
                        90, "transaction-lock", "lock")
                except RuntimeError as observed:
                    rendered = str(observed)
                    require(expected_evidence in rendered and SECRET not in rendered,
                            "captured flock errno did not retain closed evidence")
                else:
                    raise RuntimeError("non-contention captured flock errno was accepted")
            require(stateful.accesses == 1,
                    "caught BlockingIOError errno was not captured exactly once")

        containment_globals["fcntl"].flock = lambda *_args: (
            _ for _ in ()).throw(contention)
        require(not containment["lock_transaction"](90),
                "transaction contention was not returned explicitly")
        module_os.open = lambda *_args, **_kwargs: 90
        module_os.close = lambda *_args: None
        require(containment["assert_client_lock_held"]() is None,
                "held client lock did not take the expected contention branch")
        assert_raises(containment["assert_client_lock_reusable"],
                      "client lock was not reusable after client exit")

        arbitrary_eagain = OSError()
        arbitrary_eagain.errno = errno.EAGAIN
        arbitrary_eagain.filename = HOSTILE_PATH
        containment_globals["fcntl"].flock = lambda *_args: (
            _ for _ in ()).throw(arbitrary_eagain)
        assert_raises(lambda: containment["try_nonblocking_flock"](
            90, "transaction-lock", "lock"),
            "phase=transaction-lock operation=flock resource=lock errno=11")
        containment_globals["fcntl"].flock = lambda *_args: (
            _ for _ in ()).throw(BlockingIOError(errno.EACCES, SECRET, HOSTILE_PATH))
        assert_raises(lambda: containment["try_nonblocking_flock"](
            90, "transaction-lock", "lock"),
            "phase=transaction-lock operation=flock resource=lock errno=13")
    finally:
        containment_globals["fcntl"].flock = original_flock
        module_os.open = original_open
        module_os.close = original_close

    keeper_globals = containment["assert_keeper_lock_coherent"].__globals__
    keeper_originals = tuple(keeper_globals[name] for name in (
        "pid_exists", "open_transaction_lock", "lock_transaction",
        "process_has_inode", "close_transaction_lock"))
    closed = []
    try:
        keeper_globals["pid_exists"] = lambda pid, phase: pid == 41 and phase == "service-death"
        keeper_globals["open_transaction_lock"] = lambda: 90
        keeper_globals["close_transaction_lock"] = lambda descriptor: closed.append(descriptor)
        keeper_globals["process_has_inode"] = lambda *_args: True
        keeper_globals["lock_transaction"] = lambda _descriptor: False
        containment["assert_keeper_lock_coherent"](41, (7, 20))
        require(closed == [90], "contended keeper lock was not closed")

        closed.clear()
        keeper_globals["lock_transaction"] = lambda _descriptor: True
        keeper_globals["process_has_inode"] = lambda *_args: False
        containment["assert_keeper_lock_coherent"](41, (7, 20))
        require(closed == [90], "teardown-transition keeper lock was not released")

        keeper_globals["process_has_inode"] = lambda *_args: True
        assert_fails_with(lambda: containment["assert_keeper_lock_coherent"](41, (7, 20)),
                          "live matching in-cgroup lock keeper released the transaction lock")
    finally:
        for name, value in zip((
                "pid_exists", "open_transaction_lock", "lock_transaction",
                "process_has_inode", "close_transaction_lock"), keeper_originals):
            keeper_globals[name] = value


def intent_epoch_cases(containment):
    globals_ = containment["open_intent_epoch"].__globals__
    module_os = globals_["os"]
    originals = {name: getattr(module_os, name) for name in (
        "close", "fstat", "lseek", "lstat", "open", "read", "stat")}
    original_wait_path = globals_["wait_path"]
    original_show = globals_["show"]
    original_show_identity_until = globals_["show_identity_until"]
    original_intent_launch_signature = globals_["intent_launch_signature"]
    nonce = "a" * 64
    target = "/run/nmcp-ci/transaction-fixture"
    stage = "after-open"
    regular = stat.S_IFREG | 0o600
    ready_stat = types.SimpleNamespace(st_dev=1, st_ino=11, st_mode=regular, st_uid=0,
                                       st_gid=0, st_nlink=1, st_size=0,
                                       st_mtime_ns=1, st_ctime_ns=1)
    journal_stat = types.SimpleNamespace(st_dev=2, st_ino=22, st_mode=regular, st_uid=0,
                                         st_gid=0, st_nlink=1, st_size=0,
                                         st_mtime_ns=2, st_ctime_ns=2)
    target_stat = types.SimpleNamespace(st_dev=3, st_ino=33)
    ready = {"journal_dev": 2, "journal_ino": 22, "nonce": nonce, "pid": 101,
             "stage": stage, "target": target}
    entry = {"path": target, "parent": "/run/nmcp-ci", "parent_identity": {},
             "absence_policy": "must-be-absent", "expected_metadata": {},
             "identity": {"dev": 3, "ino": 33}, "allowlist": []}
    document = {"version": 2, "epoch": {"nonce": nonce, "stage": stage,
                                         "target": target}, "entries": [entry]}
    state = {"ready": ready, "document": document, "journal_current": journal_stat,
              "target_current": target_stat, "reads": [], "fail_journal_read": False,
              "closed": []}

    def encoded(value):
        return (json.dumps(value, sort_keys=True, separators=(",", ":")) + "\n").encode("ascii")

    def update_sizes():
        ready_stat.st_size = len(encoded(state["ready"]))
        journal_stat.st_size = len(encoded(state["document"]))

    def fake_open(path, *_args, **_kwargs):
        if path == "/run/nmcp-ci/cleanup-intent.ready":
            return 10
        if path == "/run/nmcp-ci/cleanup-intent.json":
            return 11
        raise RuntimeError(f"unexpected intent fixture open: {path}")

    def fake_fstat(descriptor):
        return ready_stat if descriptor == 10 else journal_stat

    def fake_read(descriptor, size):
        state["reads"].append(descriptor)
        if descriptor == 11 and state["fail_journal_read"]:
            raise OSError(errno.EIO, "injected anchored journal read failure")
        payload = encoded(state["ready"] if descriptor == 10 else state["document"])
        return payload[:size]

    def fake_stat(path, **_kwargs):
        if path == "/run/nmcp-ci/cleanup-intent.ready":
            return ready_stat
        if path == "/run/nmcp-ci/cleanup-intent.json":
            current = state["journal_current"]
            if current is None:
                raise FileNotFoundError(errno.ENOENT, "missing")
            return current
        raise RuntimeError(f"unexpected intent fixture stat: {path}")

    def fake_lstat(path):
        current = state["target_current"]
        if current is None:
            raise FileNotFoundError(errno.ENOENT, "missing", path)
        return current

    def anchor(prior=None):
        update_sizes()
        return containment["open_intent_epoch"](
            stage, "run-root", prior, "/repo", "c" * 40, "/go", f"run-root:{stage}")

    try:
        globals_["wait_path"] = lambda *_args, **_kwargs: None
        globals_["show"] = lambda *_args: {
            "ActiveState": "active", "MainPID": "101",
            "Environment": f"NMCP_VERIFIER_NONCE={nonce}",
        }
        globals_["show_identity_until"] = lambda *_args: {
            "LoadState": "loaded", "ActiveState": "active", "SubState": "running",
            "MainPID": "101", "Environment": f"NMCP_VERIFIER_NONCE={nonce}",
            "ControlGroup": "/system.slice/nmcp-migration-role-verifier.service",
        }
        globals_["intent_launch_signature"] = lambda *_args: (nonce, {"signed": True})
        module_os.open = fake_open
        module_os.fstat = fake_fstat
        module_os.lseek = lambda *_args: 0
        module_os.read = fake_read
        module_os.stat = fake_stat
        module_os.lstat = fake_lstat
        module_os.close = lambda descriptor: state["closed"].append(descriptor)

        observed = anchor()
        snapshot = containment["snapshot_intent_epoch"](observed, f"run-root:{stage}")
        require(snapshot["nonce"] == nonce and snapshot["target"] == target,
                "valid intent epoch did not preserve its exact binding")

        observed = anchor()
        state["journal_current"] = None
        reads_before = state["reads"].count(11)
        assert_raises(lambda: containment["snapshot_intent_epoch"](
            observed, f"run-root:{stage}"),
            "phase=intent-window operation=stat resource=cleanup-intent errno=2")
        require(state["reads"].count(11) == reads_before + 1,
                "missing current intent name bypassed the anchored descriptor read")

        state["journal_current"] = journal_stat
        observed = anchor()
        state["journal_current"] = types.SimpleNamespace(**{
            **journal_stat.__dict__, "st_ino": 23})
        assert_fails_with(lambda: containment["snapshot_intent_epoch"](
            observed, f"run-root:{stage}"),
            f"cleanup intent epoch changed after intended kill: run-root:{stage}")

        state["journal_current"] = journal_stat
        prior = {"nonce": "b" * 64, "target": target, "target_identity": None,
                 "journal_identity": (journal_stat.st_dev, journal_stat.st_ino)}
        assert_fails_with(lambda: anchor(prior), "prior cleanup-intent inode survived recovery")
        prior["journal_identity"] = (9, 99)
        prior["target_identity"] = {"dev": 3, "ino": 33}
        assert_fails_with(lambda: anchor(prior),
                          f"prior cleanup-intent inode survived recovery: {target}")

        for omitted in ("stage", "nonce"):
            saved = state["ready"]
            state["ready"] = {key: value for key, value in saved.items() if key != omitted}
            assert_fails_with(lambda: anchor(), "intent epoch ready marker schema changed")
            state["ready"] = saved
        state["fail_journal_read"] = True
        closes_before = len(state["closed"])
        assert_raises(lambda: anchor(),
                      "phase=intent-window operation=read resource=cleanup-intent errno=5")
        require(state["closed"][closes_before:] == [10, 11],
                "failure after ready open before journal anchor leaked evidence descriptors")
        state["fail_journal_read"] = False
        labels = {f"{kind}:{stage_name}" for kind in (
            "intent:run-root", "intent:usr-local-libexec-nmcp",
            "intent:var-lib-nmcp", "intent:opt-nmcp-role-compatibility") for stage_name in (
                "after-intent", "after-mkdir", "after-open", "after-register")}
        require(len(labels) == 16, "intent epoch fixture did not cover all 16 labels")
    finally:
        globals_["wait_path"] = original_wait_path
        globals_["show"] = original_show
        globals_["show_identity_until"] = original_show_identity_until
        globals_["intent_launch_signature"] = original_intent_launch_signature
        for name, value in originals.items():
            setattr(module_os, name, value)


def producer_epoch_state_cases(containment):
    wait_globals = containment["producer_wait_evidence"].__globals__
    finality_globals = containment["producer_epoch_finality"].__globals__
    saved = {name: wait_globals[name] for name in (
        "producer_unit_evidence", "path_exists", "open_intent_epoch",
        "communicate_producer_once", "intent_journal_evidence",
        "producer_transaction_state", "reset_paths", "popen",
        "producer_epoch_finality",
    )}
    finality_saved = {name: finality_globals[name] for name in (
        "terminate_and_reap_producer", "show_identity_until", "show_until",
        "intent_launch_signature", "cleanup_signed_launch_until", "cgroup_pids",
        "assert_client_lock_reusable", "assert_transaction_lock_reusable",
    )}
    monotonic_original = wait_globals["time"].monotonic
    sleep_original = wait_globals["time"].sleep
    nonce = "a" * 64
    signed_state = {
        "LoadState": "loaded", "ActiveState": "active", "SubState": "running",
        "MainPID": "101", "Result": "success", "Environment": f"NMCP_VERIFIER_NONCE={nonce}",
        "ControlGroup": "/recorded",
    }
    absent_state = {"LoadState": "not-found"}

    class Process:
        def __init__(self, returncode):
            self.returncode = returncode

        def poll(self):
            return self.returncode

    def lifecycle():
        return {"communicated": False, "stdout": "", "stderr": "",
                "reaped": False, "result_exact": False}

    try:
        wait_globals["time"].sleep = lambda _delay: None
        wait_globals["producer_unit_evidence"] = lambda *_args: (
            signed_state, nonce, {"signed": True})
        wait_globals["path_exists"] = lambda *_args: False
        communicate_calls = []
        def communicate(process, state, _timeout):
            communicate_calls.append(process)
            state.update({"communicated": True, "stdout": "", "stderr": "exact",
                          "reaped": True, "result_exact": True})
            return "", "exact"
        wait_globals["communicate_producer_once"] = communicate
        wait_globals["intent_journal_evidence"] = lambda *_args: "signed"
        wait_globals["producer_transaction_state"] = lambda: "blocked"
        state = lifecycle()
        try:
            containment["producer_wait_evidence"](
                Process(1), "after-intent", "run-root", None,
                "/repo", "c" * 40, "/go", "intent:run-root:after-intent", 10, state)
        except containment["ProducerEpochFailure"] as error:
            require(error.category == "producer-exit-before-ready"
                    and error.evidence["journal"] == "signed"
                    and error.evidence["transaction"] == "blocked"
                    and error.evidence["client"] == "exited"
                    and error.evidence["return_code"] == 1
                    and error.evidence["result"] == "exact"
                    and error.evidence["state"] is not signed_state
                    and len(communicate_calls) == 1 and state["result_exact"],
                    "signed-journal ready failure lost immutable client or unit evidence")
        else:
            raise RuntimeError("early producer exit was accepted without readiness")

        recovery_calls = []
        def recovery_failure(*_args):
            recovery_calls.append(True)
            if len(recovery_calls) == 1:
                return signed_state, nonce, {"signed": True}
            raise RuntimeError("injected recovery observation failure")
        class DelayedExit(Process):
            def __init__(self):
                super().__init__(None)
                self.polls = 0

            def poll(self):
                self.polls += 1
                if self.polls >= 2:
                    self.returncode = 1
                return self.returncode

        wait_globals["producer_unit_evidence"] = recovery_failure
        wait_globals["intent_journal_evidence"] = lambda *_args: "unsigned"
        wait_globals["time"].monotonic = lambda: 0
        try:
            containment["producer_wait_evidence"](
                DelayedExit(), "after-intent", "run-root", None,
                "/repo", "c" * 40, "/go", "intent:run-root:after-intent", 10, lifecycle())
        except containment["ProducerEpochFailure"] as error:
            require(error.category == "producer-exit-before-ready"
                    and len(recovery_calls) == 2
                    and error.evidence["signature"] == {"signed": True}
                    and error.evidence["journal"] == "unsigned",
                    "recovery observation failure lost unsigned-journal exit evidence")
        else:
            raise RuntimeError("unsigned-journal producer exit was accepted")

        wait_globals["producer_unit_evidence"] = lambda *_args: (absent_state, None, None)
        wait_globals["intent_journal_evidence"] = lambda *_args: "absent"
        wait_globals["time"].monotonic = lambda: 20
        try:
            containment["producer_wait_evidence"](
                Process(None), "after-mkdir", "/var/lib/nmcp", None,
                "/repo", "c" * 40, "/go", "intent:var-lib-nmcp:after-mkdir", 10,
                lifecycle())
        except containment["ProducerEpochFailure"] as error:
            require(error.category == "producer-timeout-before-ready"
                    and error.evidence["state"] == absent_state
                    and error.evidence["transaction"] == "blocked"
                    and error.evidence["client"] == "live"
                    and error.evidence["return_code"] == "unknown"
                    and error.evidence["result"] == "unavailable",
                    "transaction-lock blockage did not classify as immutable bounded timeout")
        else:
            raise RuntimeError("live producer plus absent unit escaped its deadline")

        wait_globals["time"].monotonic = lambda: 0
        wait_globals["path_exists"] = lambda *_args: True
        ready_calls = []
        def ready_anchor(*_args):
            ready_calls.append(True)
            return {"state": signed_state, "nonce": nonce, "signature": {"signed": True},
                    "recorded_cgroup": "/recorded"}
        wait_globals["open_intent_epoch"] = ready_anchor
        anchor, evidence = containment["producer_wait_evidence"](
            Process(1), "after-open", "run-root", None,
            "/repo", "c" * 40, "/go", "intent:run-root:after-open", 10, lifecycle())
        require(len(ready_calls) == 1 and anchor["signature"] == {"signed": True}
                and evidence["ready"] == "present",
                "ready-vs-exit race did not require the signed ready anchor")

        # Exercise the narrower race: readiness is absent during the ordinary
        # observation but becomes visible after poll reports exit.  The final
        # observation must still pass through the full identity-bound anchor.
        ready_observations = iter((False, True))
        wait_globals["path_exists"] = lambda *_args: next(ready_observations)
        ready_calls.clear()
        anchor, evidence = containment["producer_wait_evidence"](
            Process(1), "after-open", "run-root", None,
            "/repo", "c" * 40, "/go", "intent:run-root:after-open", 10, lifecycle())
        require(len(ready_calls) == 1 and anchor["nonce"] == nonce
                and anchor["signature"] == {"signed": True}
                and evidence["ready"] == "present",
                "final identity-bound ready observation did not win the exit race")

        # Mere post-exit file presence or a mismatched nonce/stage/target/inode
        # must remain rejected by the existing anchored validator.
        wait_globals["path_exists"] = lambda *_args: True
        for mismatch in ("nonce", "stage", "target", "inode"):
            wait_globals["open_intent_epoch"] = lambda *_args, mismatch=mismatch: (
                _ for _ in ()).throw(RuntimeError(f"ready {mismatch} mismatch"))
            assert_fails_with(lambda: containment["producer_wait_evidence"](
                Process(1), "after-open", "run-root", None,
                "/repo", "c" * 40, "/go", "intent:run-root:after-open", 10, lifecycle()),
                f"ready {mismatch} mismatch")

        finality_calls = []
        wait_globals["reset_paths"] = lambda *_args: None
        wait_globals["popen"] = lambda *_args, **_kwargs: Process(1)
        wait_globals["open_intent_epoch"] = lambda *_args: (
            _ for _ in ()).throw(RuntimeError("ready open failed before anchor"))
        wait_globals["producer_epoch_finality"] = lambda process, state, evidence, *_args: (
            finality_calls.append((process, state, evidence)) or {
                "cleanup": "complete", "unit_absent": True,
                "scanned": {"recorded": True, "canonical": True},
                "scans": {"recorded": [], "canonical": []},
                "locks": {"client": True, "transaction": True},
            })
        assert_fails_with(lambda: containment["exercise_intent_epoch"](
            "/client", "/repo", "c" * 40, "/go", "after-open", "run-root", None),
            "ready open failed before anchor")
        require(len(finality_calls) == 1,
                "ready-present open-before-anchor failure bypassed epoch finality")

        finality_globals["terminate_and_reap_producer"] = lambda _process, state: (
            state.update({"reaped": True}) or [])
        finality_globals["show_identity_until"] = lambda *_args: signed_state
        finality_globals["show_until"] = lambda *_args: absent_state
        finality_globals["intent_launch_signature"] = lambda *_args: (nonce, {"signed": True})
        cleanup_calls = []
        finality_globals["cleanup_signed_launch_until"] = lambda signature, *_args: (
            cleanup_calls.append(signature))
        finality_globals["cgroup_pids"] = lambda *_args: []
        finality_globals["assert_client_lock_reusable"] = lambda: None
        finality_globals["assert_transaction_lock_reusable"] = lambda: None
        final = containment["producer_epoch_finality"](
            Process(1), lifecycle(), {"signature": {"signed": True}, "nonce": nonce,
                                      "recorded_cgroup": "/recorded"},
            "/repo", "c" * 40, "/go", "intent:run-root:after-open")
        require(final["cleanup"] == "complete" and final["unit_absent"]
                and final["scanned"] == {"recorded": True, "canonical": True}
                and not any(final["scans"].values()) and all(final["locks"].values())
                and cleanup_calls == [{"signed": True}],
                "timeout finality did not prove signed cleanup, both scans, and both locks")

        failure_cases = (
            ("action", "cleanup_signed_launch_until"),
            ("cgroup", "cgroup_pids"),
            ("lock", "assert_client_lock_reusable"),
            ("reap", "terminate_and_reap_producer"),
            ("state", "show_until"),
        )
        for category, failing_name in failure_cases:
            replacements = dict(finality_saved)
            replacements.update({
                "terminate_and_reap_producer": lambda _process, state: (
                    state.update({"reaped": True}) or []),
                "show_identity_until": lambda *_args: signed_state,
                "show_until": lambda *_args: absent_state,
                "intent_launch_signature": lambda *_args: (nonce, {"signed": True}),
                "cleanup_signed_launch_until": lambda *_args: None,
                "cgroup_pids": lambda *_args: [],
                "assert_client_lock_reusable": lambda: None,
                "assert_transaction_lock_reusable": lambda: None,
            })
            replacements[failing_name] = lambda *_args: (
                [RuntimeError("injected reap failure")]
                if failing_name == "terminate_and_reap_producer" else
                (_ for _ in ()).throw(RuntimeError("injected finality failure")))
            for name, value in replacements.items():
                finality_globals[name] = value
            failed = containment["producer_epoch_finality"](
                Process(1), lifecycle(), {"signature": {"signed": True}, "nonce": nonce,
                                          "recorded_cgroup": "/recorded"},
                "/repo", "c" * 40, "/go", "intent:run-root:after-open")
            require(failed["cleanup"] == category,
                    f"producer finality did not isolate injected {category} category")

        unsigned_cleanup_calls = []
        finality_globals["terminate_and_reap_producer"] = lambda _process, state: (
            state.update({"reaped": True}) or [])
        finality_globals["show_identity_until"] = lambda *_args: signed_state
        finality_globals["show_until"] = lambda *_args: absent_state
        finality_globals["intent_launch_signature"] = lambda *_args: (
            _ for _ in ()).throw(RuntimeError("unsigned loaded state"))
        finality_globals["cleanup_signed_launch_until"] = lambda *_args: (
            unsigned_cleanup_calls.append(True))
        finality_globals["cgroup_pids"] = lambda *_args: []
        finality_globals["assert_client_lock_reusable"] = lambda: None
        finality_globals["assert_transaction_lock_reusable"] = lambda: None
        unsigned = containment["producer_epoch_finality"](
            Process(1), lifecycle(), {"signature": None, "nonce": nonce,
                                      "recorded_cgroup": "/recorded"},
            "/repo", "c" * 40, "/go", "intent:run-root:after-open")
        require(unsigned["cleanup"] == "unsigned-loaded" and not unsigned_cleanup_calls,
                "unsigned loaded fixed name was cleaned without exact launch identity")

        finality_globals["show_identity_until"] = lambda *_args: (
            _ for _ in ()).throw(RuntimeError("recovery observation failed"))
        recovered = containment["producer_epoch_finality"](
            Process(1), lifecycle(), {"signature": None, "nonce": nonce,
                                      "recorded_cgroup": "/recorded"},
            "/repo", "c" * 40, "/go", "intent:run-root:after-open")
        require(recovered["cleanup"] == "action",
                "recovery observation failure lost its isolated action category")

        fields_finality = {
            "cleanup": "complete", "reaped": True, "unit_absent": True,
            "scanned": {"recorded": True, "canonical": True},
            "scans": {"recorded": [], "canonical": []},
            "locks": {"client": True, "transaction": True},
        }
        diagnostic = containment["producer_failure_message"](
            "producer-exit-before-ready", "after-register",
            "/opt/nmcp-role-compatibility",
            {"state": signed_state, "signature": {"signed": True},
             "transaction": "blocked", "journal": "signed", "ready": "absent",
             "client": "exited", "return_code": 1, "result": "exact",
             "primary": "verification", "journal_failure": "none",
             "primary_detail": "fixture failure"},
            fields_finality)
        containment["validate_serialized_diagnostic"](diagnostic)
        require(len(diagnostic) <= containment["DIAGNOSTIC_TEXT_LIMIT"]
                and b"failure=producer-exit-before-ready" in diagnostic
                and b"stage=after-register" in diagnostic
                and b"target=opt-nmcp-role-compatibility" in diagnostic
                and b"primary=verification" in diagnostic
                and b"jf=none" in diagnostic
                and b"detail=fixture failure" in diagnostic,
                "producer scalar diagnostic lost its exact bounded label")
        exact_labels = set()
        timed_out = {"state": absent_state, "signature": None,
                     "transaction": "blocked", "journal": "absent", "ready": "absent",
                     "client": "live", "return_code": "unknown",
                     "result": "unavailable", "primary": "unknown",
                     "journal_failure": "none"}
        for target, target_label in containment["INTENT_TARGETS"].items():
            for stage_name in containment["INTENT_STAGES"]:
                payload = containment["producer_failure_message"](
                    "producer-timeout-before-ready", stage_name, target,
                    timed_out, fields_finality)
                containment["validate_serialized_diagnostic"](payload)
                require(f"stage={stage_name};target={target_label}".encode("ascii") in payload,
                        "producer timeout diagnostic lost an exact stage/target label")
                require(b"client=live;return_code=unknown;result=unavailable" in payload,
                        "post-cleanup state replaced immutable timeout client evidence")
                exact_labels.add((stage_name, target_label))
        require(len(exact_labels) == 16,
                "producer diagnostics did not cover all 16 exact stage/target labels")

        machine = ("NMCP_CLIENT_RESULT_V1:primary=verification;events=-;events_complete=1;"
                   "final_scanned=1;final_observed=1;final_empty=1;return=1;stdout=0;"
                   "success=0")
        stderr = machine + "\nverification-client: fixture failure\n"
        primary_category, journal_category, primary_detail = containment["client_primary_diagnostic"](stderr)
        require(primary_category == "verification" and journal_category == "none"
                and primary_detail == "fixture failure",
                "producer diagnostic discarded the bounded primary client stderr")
        invalid_category, invalid_journal, invalid_detail = containment["client_primary_diagnostic"]("malformed")
        require(invalid_category == "invalid" and invalid_journal == "none" and invalid_detail,
                "producer diagnostic accepted malformed client stderr")
        require(containment["exact_failed_producer_result"](Process(1), "", stderr),
                "canonical failed producer result was rejected")
        none_primary = stderr.replace("primary=verification", "primary=none", 1)
        require(not containment["exact_failed_producer_result"](
                    Process(1), "", none_primary)
                and not containment["exact_failed_producer_result"](
                    Process(0), "", stderr)
                and not containment["exact_failed_producer_result"](
                    Process(1), "unexpected", stderr),
                "non-failure producer output was accepted as an exact failed result")
    finally:
        wait_globals["time"].monotonic = monotonic_original
        wait_globals["time"].sleep = sleep_original
        for name, value in saved.items():
            wait_globals[name] = value
        for name, value in finality_saved.items():
            finality_globals[name] = value


def client_cleanup_result_cases(client, containment):
    globals_ = client["resolve_outcome"].__globals__
    mutable_names = (
        "CLEANUP_ACTIVE", "REQUESTED_MODE", "COMMAND_DEADLINE",
    )
    originals = {name: globals_[name] for name in mutable_names}
    call_originals = {name: globals_[name] for name in (
        "assert_fixed_cgroups_empty", "command", "command_path", "durable_marker",
        "validated_marker", "record_counter", "owned_state",
    )}
    sleep_original = globals_["time"].sleep

    def reset(mode):
        globals_["CLEANUP_ACTIVE"] = True
        globals_["REQUESTED_MODE"] = mode
        globals_["COMMAND_DEADLINE"] = None
        globals_["RESULT_EVENTS_COMPLETE"] = True
        for name in ("RESULT_EVENTS", "RESULT_MAPPED_CLEANUP_ERRORS",
                     "RETRIES", "INTERCEPTIONS", "ATTEMPTS"):
            globals_[name].clear()
        globals_["RECOVERED_ERRORS"].clear()

    def schema(primary, cleanup):
        try:
            globals_["assert_fixed_cgroups_empty"]("final-close")
            final_evidence = (True, True, True, None)
        except BaseException as final_error:
            observed = not (isinstance(final_error, globals_["CgroupFailure"])
                            and final_error.observation_errors)
            final_evidence = (True, observed, False, final_error)
        try:
            client["resolve_outcome"](primary, cleanup, "n" * 64,
                                      final_evidence)
        except globals_["ClientResultFailure"] as error:
            parsed = containment["parse_client_result"](error.machine)
            require([event[0] for event in parsed["events"]]
                    == list(range(len(parsed["events"]))),
                    "client result event ordinals were not contiguous")
            parsed["events"] = tuple(event[1:] for event in parsed["events"])
            require(str(error), "client result failure lost its human diagnostic")
            return parsed
        raise RuntimeError("failing client outcome omitted its machine result")

    def require_failure(function, prefix):
        try:
            function()
        except RuntimeError as error:
            require(str(error).startswith(prefix), f"wrong causal failure: {error!s}")
            return error
        raise RuntimeError("expected causal cleanup failure was not raised")

    primary = client["PrimaryFailure"]("cleanup-test", "fixture primary")
    globals_["assert_fixed_cgroups_empty"] = lambda _phase: None
    globals_["durable_marker"] = lambda *_args: None
    globals_["validated_marker"] = lambda *_args: True
    globals_["record_counter"] = lambda *_args: None
    globals_["time"].sleep = lambda _delay: None
    try:
        reset("")
        client["interrupted"](client["signal"].SIGTERM, None)
        try:
            client["check_cancelled"]()
        except client["CancellationFailure"] as cancellation:
            require(cancellation.category == "cancelled"
                    and client["primary_exception"](cancellation, "final") is cancellation,
                    "typed cancellation was not preserved as the primary exception")
        else:
            raise RuntimeError("direct signal fixture did not raise typed cancellation")
        wrapped = client["primary_exception"](RuntimeError("later verification"), "final")
        require(isinstance(wrapped, client["PrimaryFailure"])
                and wrapped.category == "verification",
                "later cancellation replaced the first verification primary")
        globals_["CANCELLED"].clear()

        for signum in sorted(globals_["CANCELLATION_SIGNALS"]):
            reset("")
            cancellation = client["CancellationFailure"](signum)
            preserved = client["preserve_primary"](primary, cancellation, "final")
            parsed = schema(preserved, [cancellation])
            require(preserved is primary and parsed["primary"] == "cleanup-test"
                    and parsed["events"] == (("final", "cancelled", 0, 0, 0),),
                    f"later cancellation replaced the first primary: {signum}")
            globals_["CANCELLED"].clear()
        reset("")
        cancellation = client["CancellationFailure"](globals_["signal"].SIGTERM)
        preserved = client["preserve_primary"](
            cancellation, RuntimeError("later verification"), "final")
        parsed = schema(preserved, [])
        require(preserved is cancellation and parsed["primary"] == "cancelled"
                and parsed["events"] == (("final", "unexpected", 0, 0, 0),),
                "later verification replaced the first cancellation primary")

        reset("")
        observation_error = globals_["EvidenceFailure"](
            "phase=final-close operation=walk resource=evidence errno=13")
        original_residue = globals_["fixed_cgroup_residue"]
        original_lock_held = globals_["CLIENT_LOCK_HELD"]
        globals_["fixed_cgroup_residue"] = lambda _phase: ({}, (observation_error,))
        globals_["CLIENT_LOCK_HELD"] = True
        try:
            final_evidence = client["capture_final_cgroup_evidence"]()
        finally:
            globals_["fixed_cgroup_residue"] = original_residue
            globals_["CLIENT_LOCK_HELD"] = original_lock_held
        require(final_evidence[:3] == (True, False, False)
                and isinstance(final_evidence[3], globals_["CgroupFailure"]),
                "final observation failure claimed an empty cgroup")
        residue_error = globals_["CleanupFailure"]("fixed-cgroup-residue=true")
        valid_residue = globals_["CgroupFailure"](
            "fixed-cgroup-residue=true", residue_error, ())
        valid_observation = globals_["CgroupFailure"](
            str(observation_error), None, (observation_error,))
        for valid in ((True, True, False, valid_residue),
                      (True, False, False, valid_observation),
                      (False, False, False, valid_observation)):
            try:
                client["resolve_outcome"](None, [], "n" * 64, valid)
            except globals_["ClientResultFailure"]:
                pass
            else:
                raise RuntimeError("non-clean final evidence unexpectedly resolved successfully")
        for contradictory in (
                (False, True, True, None), (True, False, True, None),
                (True, True, False, None), (False, False, False, None),
                (True, True, True, valid_residue)):
            assert_fails_with(lambda contradictory=contradictory: client["resolve_outcome"](
                None, [], "n" * 64, contradictory),
                "final cgroup evidence was not immutable and complete")
        globals_["assert_fixed_cgroups_empty"] = lambda _phase: None

        globals_["command"] = lambda *_args, **_kwargs: subprocess.CompletedProcess(
            ("systemctl", "show"), 0, "LoadState=not-found\n", "")

        reset("")
        for boundary in globals_["CLEANUP_BOUNDARIES"]:
            for category in globals_["CLEANUP_CATEGORIES"]:
                if boundary != "none" or category == "unexpected":
                    client["cleanup_result"](category, boundary)
        for boundary in globals_["CLEANUP_BOUNDARIES"]:
            globals_["RETRIES"][boundary] = globals_["COUNTER_MAX"]
            globals_["INTERCEPTIONS"][boundary] = globals_["COUNTER_MAX"]
            globals_["ATTEMPTS"][boundary] = globals_["COUNTER_MAX"]
        try:
            client["result_failure"](
                client["PrimaryFailure"]("verification", "maximum aggregation"),
                "maximum aggregation", (True, True, True, None))
        except globals_["ClientResultFailure"] as error:
            maximum = error.machine
        else:
            raise RuntimeError("maximum legitimate client result was not emitted")
        maximum_parsed = containment["parse_client_result"](maximum)
        require(len(maximum_parsed["events"]) == globals_["RESULT_EVENT_LIMIT"]
                and [event[0] for event in maximum_parsed["events"]]
                    == list(range(globals_["RESULT_EVENT_LIMIT"]))
                and maximum_parsed["events_complete"] == 0
                and all(event[3:] == (0, 0, 0)
                        for event in maximum_parsed["events"])
                and len(maximum.encode("ascii")) <= globals_["RESULT_BYTE_LIMIT"],
                "maximum legitimate client result did not render and parse within its bound")

        for mode, context in (
                ("client-property-fault-immediate", "immediate"),
                ("client-property-fault-recovery", "recovery"),
                ("client-property-fault-owned", "owned-state")):
            reset(mode)
            globals_["CLEANUP_ACTIVE"] = False
            globals_["command_path"] = call_originals["command_path"]
            client["unit_properties"]("teardown", "LoadState", context=context)
            parsed = schema(primary, list(globals_["RECOVERED_ERRORS"]))
            require(parsed["events"] == (("show", "property-recovered", 1, 1, 1),),
                    f"{context} recovered property evidence was not causally preserved")

        reset("client-cleanup-fault-show")
        globals_["command_path"] = call_originals["command_path"]
        client["unit_properties"]("teardown", "LoadState", context="show")
        parsed = schema(primary, list(globals_["RECOVERED_ERRORS"]))
        require(parsed["events"] == (("show", "property-recovered", 1, 1, 1),),
                "recovered property retry produced the wrong causal result")

        reset("")
        globals_["RETRIES"]["show"] = 1
        globals_["INTERCEPTIONS"]["show"] = 1
        globals_["ATTEMPTS"]["show"] = 1
        client["cleanup_result"]("property-recovered", "show")
        globals_["RETRIES"]["show"] = 3
        globals_["INTERCEPTIONS"]["show"] = 4
        client["cleanup_result"]("property-unavailable", "show")
        parsed = schema(primary, [])
        require(parsed["events"] == (
                    ("show", "property-recovered", 1, 1, 1),
                    ("show", "property-unavailable", 3, 4, 1)),
                "same-boundary recovered and unavailable events lost causal snapshots")

        reset("client-cleanup-fault-show")
        globals_["command_path"] = call_originals["command_path"]
        client["unit_properties"]("teardown", "LoadState", context="show")
        parsed = schema(primary, [*globals_["RECOVERED_ERRORS"],
                                  RuntimeError("uncategorized cleanup failure")])
        require(parsed["events"] == (
                    ("show", "property-recovered", 1, 1, 1),
                    ("final", "unexpected", 0, 0, 0)),
                "mixed mapped and unmapped cleanup errors omitted unexpected")

        reset("client-cleanup-fault-show")
        globals_["command_path"] = call_originals["command_path"]
        client["unit_properties"]("teardown", "LoadState", context="show")
        residue_error = globals_["CleanupFailure"]("fixed-cgroup-residue=true")
        observation_error = globals_["EvidenceFailure"](
            "phase=final-close operation=walk resource=evidence errno=13")
        final_cgroup_error = globals_["CgroupFailure"](
            "fixed-cgroup-residue=true; phase=final-close operation=walk "
            "resource=evidence errno=13", residue_error, (observation_error,))
        globals_["assert_fixed_cgroups_empty"] = lambda _phase: (
            _ for _ in ()).throw(final_cgroup_error)
        parsed = schema(primary, [*globals_["RECOVERED_ERRORS"],
                                  RuntimeError("uncategorized cleanup failure")])
        require(parsed["events"] == (
                    ("show", "property-recovered", 1, 1, 1),
                    ("final", "cgroup-residue", 0, 0, 0),
                    ("final", "cgroup-observation", 0, 0, 0),
                    ("final", "unexpected", 0, 0, 0)),
                "mixed recovered, final cgroup evidence, and unknown cleanup lost identity")
        globals_["assert_fixed_cgroups_empty"] = lambda _phase: None

        reset("client-cleanup-persistent-show")
        property_error = require_failure(
            lambda: client["unit_properties"]("teardown", "LoadState", context="show"),
            "unit properties remain unknown")
        parsed = schema(primary, [property_error])
        require(parsed["events"] == (("show", "property-unavailable", 3, 4, 0),),
                "unavailable property path produced the wrong causal result")

        globals_["owned_state"] = lambda *_args, **_kwargs: {"LoadState": "loaded"}

        reset("client-cleanup-fault-stop")
        stop_calls = []
        def stop_path(_phase, name):
            stop_calls.append(name)
            if len(stop_calls) == 1:
                globals_["INTERCEPTIONS"][name] = 1
                raise RuntimeError("intercepted stop command before attempt")
            globals_["ATTEMPTS"][name] = 1
        globals_["command_path"] = stop_path
        client["retry_owned_command"](
            "i" * 32, "n" * 64, ("/fixture",), "stop", "stop")
        parsed = schema(primary, list(globals_["RECOVERED_ERRORS"]))
        require(parsed["events"] == (("stop", "stop-recovered", 1, 1, 1),),
                "recovered stop path produced the wrong causal result")

        reset("client-cleanup-persistent-reset")
        def reset_path(_phase, name):
            globals_["INTERCEPTIONS"][name] = globals_["INTERCEPTIONS"].get(name, 0) + 1
            raise RuntimeError("intercepted reset command before attempt")
        globals_["command_path"] = reset_path
        reset_error = require_failure(lambda: client["retry_owned_command"](
            "i" * 32, "n" * 64, ("/fixture",), "reset", "reset-failed"),
            "owned reset command remains unavailable")
        parsed = schema(primary, [reset_error])
        require(parsed["events"] == (("reset", "reset-unavailable", 1, 2, 0),),
                "unavailable reset path produced the wrong causal result")

        reset("client-cleanup-persistent-reset")
        globals_["command_path"] = reset_path
        mapped_error = require_failure(lambda: client["retry_owned_command"](
            "i" * 32, "n" * 64, ("/fixture",), "reset", "reset-failed"),
            "owned reset command remains unavailable")
        aggregate = client["aggregate_cleanup_failure"](
            [mapped_error, RuntimeError("unknown aggregate constituent")], "n" * 64)
        parsed = schema(primary, [aggregate])
        require(parsed["events"] == (
                    ("reset", "reset-unavailable", 1, 2, 0),
                    ("final", "unexpected", 0, 0, 0)),
                "teardown aggregate laundered an unmapped constituent")

        reset("")
        unload_error = require_failure(lambda: client["wait_unloaded"](
            "i" * 32, "n" * 64, ("/fixture",), timeout=0),
            "fixed unit did not unload")
        parsed = schema(primary, [unload_error])
        require(parsed["events"] == (("unload", "unload-timeout", 0, 0, 0),),
                "unload timeout produced the wrong causal result")

        reset("")
        residue_error = globals_["CleanupFailure"]("fixed-cgroup-residue=true")
        globals_["assert_fixed_cgroups_empty"] = lambda _phase: (
            _ for _ in ()).throw(globals_["CgroupFailure"](
                "fixed-cgroup-residue=true", residue_error, ()))
        parsed = schema(primary, [])
        require(parsed["events"] == (("final", "cgroup-residue", 0, 0, 0),),
                "final cgroup residue produced the wrong causal result")

        reset("")
        residue_error = globals_["CleanupFailure"]("fixed-cgroup-residue=true")
        observation_error = globals_["EvidenceFailure"](
            "phase=work operation=walk resource=evidence errno=13")
        primary_cgroup_error = globals_["CgroupFailure"](
            "fixed-cgroup-residue=true; phase=work operation=walk resource=evidence errno=13",
            residue_error, (observation_error,))
        globals_["assert_fixed_cgroups_empty"] = lambda _phase: None
        wrapped = client["primary_exception"](primary_cgroup_error, "final")
        parsed = schema(wrapped, [])
        require(parsed["primary"] == "verification" and parsed["events"] == (
                    ("final", "cgroup-residue", 0, 0, 0),
                    ("final", "cgroup-observation", 0, 0, 0)),
                "primary cgroup wrapping discarded structured constituent evidence")

        reset("")
        residue_error = globals_["CleanupFailure"]("fixed-cgroup-residue=true")
        observation_error = globals_["EvidenceFailure"](
            "phase=unload operation=walk resource=evidence errno=13")
        unload_cgroup_error = globals_["CgroupFailure"](
            "fixed-cgroup-residue=true; phase=unload operation=walk resource=evidence errno=13",
            residue_error, (observation_error,))
        globals_["assert_fixed_cgroups_empty"] = lambda _phase: (
            _ for _ in ()).throw(unload_cgroup_error)
        globals_["owned_state"] = lambda *_args, **_kwargs: {"LoadState": "not-found"}
        unload_error = require_failure(lambda: client["wait_unloaded"](
            "i" * 32, "n" * 64, ("/fixture",)), "fixed-cgroup-residue=true")
        globals_["assert_fixed_cgroups_empty"] = lambda _phase: None
        parsed = schema(primary, [unload_error])
        require(parsed["events"] == (
                    ("unload", "cgroup-residue", 0, 0, 0),
                    ("unload", "cgroup-observation", 0, 0, 0)),
                "unload cgroup failure collapsed residue or observation evidence")
    finally:
        for name, value in originals.items():
            globals_[name] = value
        for name, value in call_originals.items():
            globals_[name] = value
        globals_["time"].sleep = sleep_original
        for name in ("RESULT_EVENTS", "RESULT_MAPPED_CLEANUP_ERRORS",
                     "RETRIES", "INTERCEPTIONS", "ATTEMPTS"):
            globals_[name].clear()
        globals_["RECOVERED_ERRORS"].clear()
        globals_["CANCELLED"].clear()


def client_teardown_transition_cases(client, containment):
    globals_ = client["teardown_owned"].__globals__
    call_names = (
        "assert_fixed_cgroups_empty", "bounded_deadline", "command", "durable_marker",
        "fixed_cgroup_residue", "owned_state", "record_counter", "validated_marker",
        "retry_owned_command",
    )
    originals = {name: globals_[name] for name in call_names}
    mutable_names = ("CLEANUP_ACTIVE", "COMMAND_DEADLINE", "REQUESTED_MODE")
    mutable_originals = {name: globals_[name] for name in mutable_names}
    sleep_original = globals_["time"].sleep
    recorded = globals_["RECORDED_CGROUP"]
    recorded_original = list(recorded)
    invocation = "i" * 32
    nonce = "n" * 64
    service_command = ("/fixture",)
    expected = {
        "show": (("property-unavailable",), True, 3, 4),
        "kill": (("kill-unavailable",), False, 1, 2),
        "stop": (("stop-unavailable", "unload-timeout"), True, 1, 2),
        "wait": (("property-unavailable",), False, 3, 4),
        "reset": (("reset-unavailable", "unload-timeout"), True, 1, 2),
        "unload": (("property-unavailable",), False, 3, 4),
    }

    def reset(boundary):
        globals_["CLEANUP_ACTIVE"] = True
        globals_["COMMAND_DEADLINE"] = None
        globals_["REQUESTED_MODE"] = "client-cleanup-persistent-" + boundary
        globals_["RESULT_EVENTS_COMPLETE"] = True
        for name in ("RESULT_EVENTS", "RESULT_MAPPED_CLEANUP_ERRORS",
                     "RETRIES", "INTERCEPTIONS", "ATTEMPTS"):
            globals_[name].clear()
        globals_["RECOVERED_ERRORS"].clear()
        recorded.clear()

    globals_["assert_fixed_cgroups_empty"] = lambda _phase: None
    globals_["durable_marker"] = lambda *_args: None
    globals_["validated_marker"] = lambda *_args: True
    globals_["record_counter"] = lambda *_args: None
    globals_["time"].sleep = lambda _delay: None
    try:
        for boundary, (categories, expected_loaded, retries, interceptions) in expected.items():
            reset(boundary)
            state = {
                "loaded": True,
                "active": "active" if boundary in ("kill", "wait", "stop") else "failed",
                "sub": "exited" if boundary == "stop" else
                       "running" if boundary in ("kill", "wait") else "failed",
                "occupants": boundary in ("kill", "wait"),
            }

            def fake_fixed_cgroup_residue(_phase):
                return ({"/fixture-cgroup": (41,)} if state["occupants"] else {}, ())

            def fake_command(argv, _phase, **_kwargs):
                action = argv[1]
                if action == "show":
                    requested = [item.split("=", 1)[1] for item in argv if item.startswith("--property=")]
                    if not state["loaded"]:
                        payload = "".join(
                            f"{name}={'not-found' if name == 'LoadState' else ''}\n"
                            for name in requested)
                    else:
                        values = {
                            "LoadState": "loaded", "InvocationID": invocation,
                            "ActiveState": state["active"], "SubState": state["sub"],
                            "ControlGroup": "/fixture-cgroup",
                            "Description": globals_["DESCRIPTION_PREFIX"] + nonce,
                            "Environment": f"{globals_['NONCE_VARIABLE']}={nonce}",
                            "ExecStart": "{ path=/fixture ; argv[]=/fixture ; }",
                            "Result": "success" if state["sub"] == "exited" else "exit-code",
                            "ExecMainCode": "1", "ExecMainStatus": "0",
                            **globals_["SERVICE_PROPERTIES"],
                        }
                        payload = "".join(f"{name}={values[name]}\n" for name in requested)
                    return subprocess.CompletedProcess(argv, 0, payload, "")
                if action == "kill":
                    state.update(active="failed", sub="failed", occupants=False)
                elif action == "stop":
                    state.update(active="inactive", sub="dead", occupants=False)
                elif action == "reset-failed" and state["active"] != "active":
                    state.update(loaded=False, active="inactive", sub="dead", occupants=False)
                return subprocess.CompletedProcess(argv, 0, "", "")

            globals_["fixed_cgroup_residue"] = fake_fixed_cgroup_residue
            globals_["command"] = fake_command
            globals_["bounded_deadline"] = lambda timeout: (
                globals_["time"].monotonic()
                if timeout in (globals_["KILL_WAIT_TIMEOUT"], globals_["UNLOAD_TIMEOUT"])
                else globals_["time"].monotonic() + 100)
            try:
                client["teardown_owned"](invocation, nonce, service_command)
            except RuntimeError as teardown_error:
                captured_error = teardown_error
            else:
                raise RuntimeError(f"persistent {boundary} teardown unexpectedly succeeded")

            after_exit_loaded = state["loaded"]
            signed_cleanup_ran = containment["cleanup_signed_launch_if_owned"](
                True, {"fixture": boundary},
                {"LoadState": "loaded" if after_exit_loaded else "not-found"},
                "persistent-cleanup",
                lambda _signature, _phase: state.update(
                    loaded=False, active="inactive", sub="dead", occupants=False))
            try:
                    client["resolve_outcome"](
                        client["PrimaryFailure"]("cleanup-test", "fixture primary"),
                        [captured_error], nonce, (True, True, True, None))
            except globals_["ClientResultFailure"] as error:
                parsed = containment["parse_client_result"](error.machine)
            else:
                raise RuntimeError(f"persistent {boundary} result schema was not emitted")
            expected_events = tuple(
                (ordinal, event_boundary, category,
                 retries if event_boundary == boundary else 0,
                 interceptions if event_boundary == boundary else 0, 0)
                for ordinal, (event_boundary, category) in enumerate(
                    ((boundary, categories[0]),)
                    + ((("unload", categories[1]),) if len(categories) == 2 else ())))
            require(parsed["events"] == expected_events,
                    f"persistent {boundary} teardown produced the wrong machine result: "
                    f"{parsed}; error={captured_error}")
            require(after_exit_loaded == expected_loaded
                    and signed_cleanup_ran == expected_loaded and not state["loaded"],
                    f"persistent {boundary} external cleanup transition was incorrect")

        reset("")
        globals_["RETRIES"]["wait"] = 2
        globals_["INTERCEPTIONS"]["wait"] = 3
        globals_["ATTEMPTS"]["wait"] = 4
        state = {"loaded": True}
        globals_["owned_state"] = lambda *_args, **_kwargs: (
            {"LoadState": "loaded", "ActiveState": "active", "SubState": "running"}
            if state["loaded"] else {"LoadState": "not-found"})
        globals_["fixed_cgroup_residue"] = lambda _phase: ({"/fixture": (41,)}, ())
        def deadline_action(_invocation, _nonce, _command, boundary, *_args):
            if boundary == "stop":
                state["loaded"] = False
            return True
        globals_["retry_owned_command"] = deadline_action
        globals_["bounded_deadline"] = lambda _timeout: globals_["time"].monotonic()
        captured_error = None
        try:
            client["teardown_owned"](invocation, nonce, service_command)
        except RuntimeError as error:
            captured_error = error
            require("owned unit did not terminate its control group" in str(error),
                    "wait deadline returned the wrong causal failure")
        else:
            raise RuntimeError("wait deadline teardown unexpectedly succeeded")
        parsed = None
        try:
            client["resolve_outcome"](
                client["PrimaryFailure"]("cleanup-test", "fixture primary"),
                [captured_error], nonce, (True, True, True, None))
        except globals_["ClientResultFailure"] as error:
            parsed = containment["parse_client_result"](error.machine)
        require(parsed is not None and parsed["events"] == (
                    (0, "wait", "cgroup-residue", 2, 3, 4),),
                "actual wait deadline lost its immutable causal residue snapshot")
    finally:
        for name, value in originals.items():
            globals_[name] = value
        for name, value in mutable_originals.items():
            globals_[name] = value
        globals_["time"].sleep = sleep_original
        recorded[:] = recorded_original
        for name in ("RESULT_EVENTS", "RESULT_MAPPED_CLEANUP_ERRORS",
                     "RETRIES", "INTERCEPTIONS", "ATTEMPTS"):
            globals_[name].clear()
        globals_["RECOVERED_ERRORS"].clear()


def client_terminal_emission_cases(client, containment):
    globals_ = client["emit_terminal_result"].__globals__
    original_render = globals_["render_client_result"]
    original_mask = globals_["signal"].pthread_sigmask
    original_pending = globals_["signal"].sigpending
    original_write = globals_["os"].write
    writes = []
    masks = []

    def reset():
        writes.clear()
        masks.clear()
        globals_["CANCELLED"].clear()
        globals_["CANCELLATION_FAILURE"] = None
        globals_["CANCELLATION_ACCOUNTED"] = False
        globals_["RESULT_EVENTS"].clear()
        globals_["RESULT_EVENTS_COMPLETE"] = True
        globals_["RESULT_MAPPED_CLEANUP_ERRORS"].clear()
        globals_["render_client_result"] = original_render
        globals_["signal"].sigpending = lambda: set()

    def fake_mask(operation, signals):
        masks.append((operation, signals))
        return set()

    def fake_write(descriptor, payload):
        writes.append((descriptor, payload))
        return len(payload)

    globals_["signal"].pthread_sigmask = fake_mask
    globals_["os"].write = fake_write
    try:
        reset()
        evidence = (True, True, True, None)
        status = client["emit_terminal_result"](None, [], "n" * 64, 0, evidence)
        require(status == 0 and writes == [(1, (globals_["SUCCESS"] + "\n").encode("ascii"))],
                "successful terminal result was not one low-level stdout write")
        require(masks == [(globals_["signal"].SIG_BLOCK, globals_["CANCELLATION_SIGNALS"])],
                "successful terminal result did not enter one non-restored signal mask")

        reset()
        def cancelling_mask(operation, signals):
            masks.append((operation, signals))
            client["interrupted"](globals_["signal"].SIGTERM, None)
            return set()
        globals_["signal"].pthread_sigmask = cancelling_mask
        status = client["emit_terminal_result"](None, [], "n" * 64, 0, evidence)
        parsed = containment["parse_client_result"](
            writes[0][1].splitlines()[0].decode("ascii"))
        require(status == 1 and len(writes) == 1 and writes[0][0] == 2
                and parsed["primary"] == "cancelled",
                "cancellation latched by terminal masking emitted stale success")
        globals_["signal"].pthread_sigmask = fake_mask

        reset()
        render_calls = 0
        def cancel_during_render(primary_error, final_evidence):
            nonlocal render_calls
            render_calls += 1
            client["interrupted"](globals_["signal"].SIGTERM, None)
            return original_render(primary_error, final_evidence)
        globals_["render_client_result"] = cancel_during_render
        status = client["emit_terminal_result"](
            client["PrimaryFailure"]("verification", "fixture failure"), [], "n" * 64, 1,
            evidence)
        parsed = containment["parse_client_result"](
            writes[0][1].splitlines()[0].decode("ascii"))
        require(status == 1 and len(writes) == 1 and writes[0][0] == 2
                and parsed["primary"] == "verification" and render_calls == 1,
                "post-decision cancellation replaced the frozen primary result")
        require(writes[0][1].count(b"NMCP_CLIENT_RESULT_V1:") == 1
                and writes[0][1].count(b"verification-client: ") == 1,
                "failing terminal result was buffered or duplicated")

        reset()
        def cancel_at_pending_check():
            client["interrupted"](globals_["signal"].SIGHUP, None)
            return set()
        globals_["signal"].sigpending = cancel_at_pending_check
        status = client["emit_terminal_result"](None, [], "n" * 64, 0, evidence)
        parsed = containment["parse_client_result"](
            writes[0][1].splitlines()[0].decode("ascii"))
        require(status == 1 and len(writes) == 1 and writes[0][0] == 2
                and parsed["primary"] == "cancelled",
                "cancellation immediately before the pending check emitted success")

        reset()
        globals_["signal"].sigpending = lambda: {globals_["signal"].SIGQUIT}
        status = client["emit_terminal_result"](None, [], "n" * 64, 0, evidence)
        parsed = containment["parse_client_result"](
            writes[0][1].splitlines()[0].decode("ascii"))
        require(status == 1 and len(writes) == 1 and parsed["primary"] == "cancelled",
                 "kernel-pending handled signal did not replace successful output")

        reset()
        attempts = []
        def interrupted_once(descriptor, payload):
            attempts.append((descriptor, payload))
            if len(attempts) == 1:
                raise InterruptedError()
            return len(payload)
        globals_["os"].write = interrupted_once
        status = client["emit_terminal_result"](None, [], "n" * 64, 0, evidence)
        require(status == 0 and len(attempts) == 2 and attempts[0][1] is attempts[1][1]
                and len(attempts[0][1]) <= globals_["select"].PIPE_BUF,
                "EINTR did not retry the same frozen PIPE_BUF-bounded payload")

        for label, failing_write in (
                ("short", lambda _descriptor, payload: len(payload) - 1),
                ("zero", lambda _descriptor, _payload: 0),
                ("error", lambda _descriptor, _payload: (_ for _ in ()).throw(OSError(errno.EIO,
                                                                                       "failed")))):
            reset()
            calls = []
            def fail_once(descriptor, payload, function=failing_write):
                calls.append((descriptor, payload))
                return function(descriptor, payload)
            globals_["os"].write = fail_once
            try:
                client["emit_terminal_result"](None, [], "n" * 64, 0, evidence)
            except globals_["TerminalEmissionFailure"]:
                pass
            else:
                raise RuntimeError(f"{label} terminal write unexpectedly succeeded")
            require(len(calls) == 1, f"{label} terminal write attempted a second emission")
    finally:
        globals_["render_client_result"] = original_render
        globals_["signal"].pthread_sigmask = original_mask
        globals_["signal"].sigpending = original_pending
        globals_["os"].write = original_write
        globals_["CANCELLED"].clear()
        globals_["RESULT_EVENTS"].clear()
        globals_["RESULT_MAPPED_CLEANUP_ERRORS"].clear()


def supervisor_process_group_case(supervisor):
    child = '''import os, signal
pid = os.fork()
if pid:
    os._exit(0)
signal.pause()
'''
    globals_ = supervisor["run_phase"].__globals__
    original_owned = globals_["OWNED_PHASE_GROUP"]
    with tempfile.TemporaryDirectory() as root:
        lock_fd = os.open(root + "/transaction.lock", os.O_RDWR | os.O_CREAT, 0o600)
        contender_fd = None
        try:
            fcntl.flock(lock_fd, fcntl.LOCK_EX)
            assert_fails_with(lambda: supervisor["run_phase"](
                ("/usr/bin/python3", "-I", "-S", "-c", child),
                env=supervisor["clean_env"](), pass_fds=(lock_fd,)),
                "phase leader exited while its process group remained live")
            group = globals_["OWNED_PHASE_GROUP"]
            require(globals_["ACTIVE_PHASE"] is None and group is not None
                    and supervisor["process_group_exists"](group["pgid"]),
                    "reaped phase leader erased live process-group ownership evidence")
            os.close(lock_fd)
            lock_fd = None
            contender_fd = os.open(root + "/transaction.lock", os.O_RDWR)
            try:
                fcntl.flock(contender_fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except BlockingIOError:
                pass
            else:
                raise RuntimeError("live background phase group did not retain its lock")
            cleanup_errors = []
            terminated = supervisor["terminate_process_group"](
                group, "causal-background-group", 1, cleanup_errors)
            require(terminated and not cleanup_errors
                    and not supervisor["process_group_exists"](group["pgid"]),
                    "live background phase group was not terminated to finality")
            fcntl.flock(contender_fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        finally:
            group = globals_["OWNED_PHASE_GROUP"]
            if group is not None:
                try:
                    os.killpg(group["pgid"], supervisor["signal"].SIGKILL)
                except ProcessLookupError:
                    pass
            globals_["OWNED_PHASE_GROUP"] = original_owned
            if contender_fd is not None:
                os.close(contender_fd)
            if lock_fd is not None:
                os.close(lock_fd)


def supervisor_atomic_launch_cases(supervisor):
    globals_ = supervisor["run_phase"].__globals__
    originals = (
        globals_["subprocess"].Popen, globals_["os"].getpgid,
        globals_["os"].killpg, globals_["os"].close,
        globals_["signal"].pthread_sigmask, globals_["recover_intents"],
        globals_["OWNED_PHASE_GROUP"], globals_["ACTIVE_PHASE"],
        globals_["BODY_ACTIVE"], tuple(globals_["SIGNAL_ERRORS"]),
    )

    class Process:
        def __init__(self, pid):
            self.pid = pid

        def poll(self):
            return None

        def wait(self, timeout=None):
            del timeout
            return 0

    def empty_resources(lock_fd):
        return {
            "lock_fd": lock_fd, "lock_keeper": None, "lock_keeper_group": None,
            "snapshot_fd": None, "retained_process": None, "retained_group": None,
            "lock_held": True, "intents_acquired": True,
            "keeper_marker": False, "database_cleanup": False,
        }

    try:
        globals_["BODY_ACTIVE"] = True
        for label, pid in (("phase", 501), ("keeper", 502), ("retained", 503)):
            state = {"blocked": False, "pending": False, "killed": False, "closed": False}
            resources = empty_resources(600 + pid)
            process = Process(pid)
            globals_["OWNED_PHASE_GROUP"] = None
            globals_["ACTIVE_PHASE"] = None
            globals_["subprocess"].Popen = lambda *_args, **_kwargs: process

            def fake_getpgid(observed_pid, case=label):
                require(state["blocked"] and observed_pid == pid,
                        f"{case} validation ran outside the termination mask")
                if case == "phase":
                    group = globals_["OWNED_PHASE_GROUP"]
                    registered = globals_["ACTIVE_PHASE"] is process
                else:
                    group_key = "lock_keeper_group" if case == "keeper" else "retained_group"
                    process_key = "lock_keeper" if case == "keeper" else "retained_process"
                    group = resources[group_key]
                    registered = resources[process_key] is process
                require(group == {"process": process, "pgid": pid} and registered,
                        f"{case} validation preceded provisional ownership publication")
                state["pending"] = True
                return observed_pid

            def fake_mask(how, mask, case=label):
                require(mask == (globals_["HANDLED_TERMINATION_SIGNALS"]
                                 if how == globals_["signal"].SIG_BLOCK
                                 else {globals_["signal"].SIGUSR1}),
                        f"{case} launch used the wrong termination mask")
                if how == globals_["signal"].SIG_BLOCK:
                    state["blocked"] = True
                    return {globals_["signal"].SIGUSR1}
                require(state["blocked"] and state["pending"],
                        f"{case} restored its mask before validation completed")
                state["blocked"] = False
                globals_["interrupted"](globals_["signal"].SIGTERM, None)

            def fake_killpg(observed_pid, signum):
                require(observed_pid == pid, f"{label} cleanup targeted the wrong group")
                if signum == 0:
                    if state["killed"]:
                        raise ProcessLookupError()
                    return
                state["killed"] = True

            def fake_close(descriptor):
                require(descriptor == resources["lock_fd"] and state["killed"],
                        f"{label} lock closed before its provisional group was killed")
                state["closed"] = True

            globals_["os"].getpgid = fake_getpgid
            globals_["signal"].pthread_sigmask = fake_mask
            globals_["os"].killpg = fake_killpg
            globals_["os"].close = fake_close
            globals_["recover_intents"] = lambda: None
            try:
                if label == "phase":
                    supervisor["run_phase"](("/fixture",), env={}, pass_fds=())
                elif label == "keeper":
                    supervisor["launch_lock_keeper"](resources, resources["lock_fd"])
                else:
                    supervisor["launch_retained_process"](resources)
            except globals_["SupervisorCleanupFailure"] as error:
                require(error.primary_error is None
                        and tuple(category for category, _item in error.cleanup_errors) == (
                            label + "-signal-mask-restore",),
                        f"{label} pending termination was not delivered after publication")
            else:
                raise RuntimeError(f"{label} pending termination unexpectedly disappeared")

            cleanup_errors = supervisor["cleanup_supervisor"](resources)
            require(cleanup_errors == () and state["killed"] and state["closed"],
                    f"{label} provisional group was not contained before lock release")
    finally:
        globals_["subprocess"].Popen = originals[0]
        globals_["os"].getpgid = originals[1]
        globals_["os"].killpg = originals[2]
        globals_["os"].close = originals[3]
        globals_["signal"].pthread_sigmask = originals[4]
        globals_["recover_intents"] = originals[5]
        globals_["OWNED_PHASE_GROUP"] = originals[6]
        globals_["ACTIVE_PHASE"] = originals[7]
        globals_["BODY_ACTIVE"] = originals[8]
        globals_["SIGNAL_ERRORS"][:] = originals[9]


def supervisor_cleanup_cases(supervisor):
    globals_ = supervisor["cleanup_supervisor"].__globals__
    original_body = globals_["supervisor_body"]
    original_run_body = globals_["run_supervisor_body"]
    original_cleanup = globals_["cleanup_supervisor"]
    original_transition_errors = globals_["CLEANUP_TRANSITION_ERRORS"]
    original_signal_errors = tuple(globals_["SIGNAL_ERRORS"])
    original_body_active = globals_["BODY_ACTIVE"]
    original_active = globals_["ACTIVE_PHASE"]
    original_owned_phase = globals_["OWNED_PHASE_GROUP"]
    original_recover = globals_["recover_intents"]
    original_fsync = globals_["fsync_directory"]
    original_run = globals_["subprocess"].run
    original_open = globals_["os"].open
    original_close = globals_["os"].close
    original_fstat = globals_["os"].fstat
    original_read = globals_["os"].read
    original_stat = globals_["os"].stat
    original_unlink = globals_["os"].unlink
    original_killpg = globals_["os"].killpg
    original_stderr = globals_["sys"].stderr
    original_argv = globals_["sys"].argv
    original_environ = globals_["os"].environ
    original_geteuid = globals_["os"].geteuid
    original_chdir = globals_["os"].chdir
    original_umask = globals_["os"].umask
    original_signal = globals_["signal"].signal
    original_pthread_sigmask = globals_["signal"].pthread_sigmask
    original_monotonic = globals_["time"].monotonic
    original_sleep = globals_["time"].sleep
    original_makedirs = globals_["os"].makedirs
    original_lstat = globals_["os"].lstat
    original_flock = globals_["fcntl"].flock
    original_git = globals_["git"]

    def resources(**updates):
        values = {
            "lock_fd": None, "lock_keeper": None, "lock_keeper_group": None,
            "snapshot_fd": None, "retained_process": None, "retained_group": None,
            "lock_held": False, "intents_acquired": False,
            "keeper_marker": False, "database_cleanup": False,
        }
        values.update(updates)
        return values

    class Process:
        def __init__(self, pid, calls, wait_errors=(), status=None):
            self.pid = pid
            self.calls = calls
            self.wait_errors = list(wait_errors)
            self.status = status

        def poll(self):
            self.calls.append(("poll", self.pid))
            return self.status

        def wait(self, timeout=None):
            self.calls.append(("wait", self.pid, timeout))
            if self.wait_errors:
                raise self.wait_errors.pop(0)
            self.status = 0
            return 0

    try:
        unsafe = []
        primary = RuntimeError("early-primary")
        globals_["supervisor_body"] = lambda _resources: (_ for _ in ()).throw(primary)
        globals_["recover_intents"] = lambda: unsafe.append("recover")
        globals_["fsync_directory"] = lambda _path: unsafe.append("fsync")
        globals_["subprocess"].run = lambda *_args, **_kwargs: unsafe.append("database")
        globals_["os"].unlink = lambda _path: unsafe.append("unlink")
        try:
            supervisor["main"]()
        except RuntimeError as error:
            require(error is primary and error.__cause__ is None,
                    "early supervisor failure did not preserve its original exception")
        else:
            raise RuntimeError("early supervisor failure unexpectedly succeeded")
        require(unsafe == [], "pre-lock failure attempted unsafe name or database cleanup")

        nonce = "a" * 64
        early_resources = resources()
        directory_stat = types.SimpleNamespace(
            st_mode=stat.S_IFDIR | 0o700, st_uid=0, st_gid=0)
        lock_stat = types.SimpleNamespace(
            st_mode=stat.S_IFREG | 0o600, st_uid=0, st_gid=0, st_nlink=1)
        globals_["sys"].argv = ["supervisor", "/repo", "commit", "/go", nonce]
        globals_["os"].environ = {"NMCP_VERIFIER_NONCE": nonce}
        globals_["os"].geteuid = lambda: 0
        globals_["os"].chdir = lambda _path: None
        globals_["os"].umask = lambda _mask: 0o022
        globals_["signal"].signal = lambda *_args: None
        globals_["git"] = lambda *_args, **_kwargs: b"commit\n"
        globals_["os"].makedirs = lambda *_args, **_kwargs: None
        globals_["os"].lstat = lambda _path: directory_stat
        globals_["os"].open = lambda *_args, **_kwargs: 44
        globals_["os"].fstat = lambda _descriptor: lock_stat
        globals_["fcntl"].flock = lambda *_args: None
        early_failure = RuntimeError("early normal setup failed")
        globals_["recover_intents"] = lambda: (_ for _ in ()).throw(early_failure)
        try:
            supervisor["supervisor_body"](early_resources)
        except RuntimeError as error:
            require(error is early_failure, "early normal-mode failure lost its cause")
        else:
            raise RuntimeError("early normal-mode setup failure unexpectedly succeeded")
        require(early_resources["lock_held"] and early_resources["intents_acquired"]
                and not early_resources["database_cleanup"],
                "database cleanup became eligible before PostgreSQL startup")

        globals_["sys"].argv = original_argv
        globals_["os"].environ = original_environ
        globals_["os"].geteuid = original_geteuid
        globals_["os"].chdir = original_chdir
        globals_["os"].umask = original_umask
        globals_["signal"].signal = original_signal
        globals_["git"] = original_git
        globals_["os"].makedirs = original_makedirs
        globals_["os"].lstat = original_lstat
        globals_["os"].open = original_open
        globals_["os"].fstat = original_fstat
        globals_["fcntl"].flock = original_flock

        partial = []
        globals_["recover_intents"] = lambda: partial.append("recover")
        globals_["os"].close = lambda descriptor: partial.append(("close", descriptor))
        cleanup = supervisor["cleanup_supervisor"](resources(
            lock_fd=41, lock_held=True, intents_acquired=True))
        require(cleanup == () and partial == ["recover", ("close", 41)],
                "partially acquired supervisor resources were not cleaned to finality")

        cleanup_calls = []
        globals_["cleanup_supervisor"] = lambda _resources: cleanup_calls.append("cleanup") or ()
        globals_["signal"].pthread_sigmask = lambda *_args: set()
        def interrupted_body(_resources):
            globals_["interrupted"](globals_["signal"].SIGTERM, None)
        globals_["supervisor_body"] = interrupted_body
        try:
            supervisor["main"]()
        except RuntimeError as error:
            require(str(error) == "supervisor interrupted by signal 15"
                    and cleanup_calls == ["cleanup"] and not globals_["BODY_ACTIVE"],
                    "body signal did not interrupt normally and finalize before cleanup")
        else:
            raise RuntimeError("body signal unexpectedly succeeded")

        cleanup_calls.clear()
        globals_["supervisor_body"] = lambda _resources: 0
        def signal_after_body_finally(resources):
            result = original_run_body(resources)
            require(not globals_["BODY_ACTIVE"],
                    "body wrapper returned before clearing its active latch")
            globals_["interrupted"](globals_["signal"].SIGTERM, None)
            return result
        globals_["run_supervisor_body"] = signal_after_body_finally
        try:
            supervisor["main"]()
        except globals_["SupervisorCleanupFailure"] as error:
            require(error.primary_error is None and cleanup_calls == ["cleanup"]
                    and tuple(category for category, _item in error.cleanup_errors) == (
                        "cleanup-transition-signal",),
                    "signal after body wrapper finalization skipped cleanup or became primary")
        else:
            raise RuntimeError("post-body signal unexpectedly succeeded")

        cleanup_calls.clear()
        propagation_primary = RuntimeError("body-propagation-primary")
        globals_["supervisor_body"] = lambda _resources: (
            _ for _ in ()).throw(propagation_primary)
        def signal_during_propagation(resources):
            try:
                return original_run_body(resources)
            except BaseException:
                require(not globals_["BODY_ACTIVE"],
                        "body wrapper propagated before clearing its active latch")
                globals_["interrupted"](globals_["signal"].SIGINT, None)
                raise
        globals_["run_supervisor_body"] = signal_during_propagation
        try:
            supervisor["main"]()
        except globals_["SupervisorCleanupFailure"] as error:
            require(error.primary_error is propagation_primary
                    and error.__cause__ is propagation_primary
                    and cleanup_calls == ["cleanup"]
                    and tuple(category for category, _item in error.cleanup_errors) == (
                        "cleanup-transition-signal",),
                    "propagation signal replaced the primary or skipped cleanup")
        else:
            raise RuntimeError("propagation signal unexpectedly succeeded")

        globals_["run_supervisor_body"] = original_run_body

        primary = RuntimeError("primary-before-cleanup-transition")
        globals_["supervisor_body"] = lambda _resources: (_ for _ in ()).throw(primary)
        cleanup_calls = []
        globals_["cleanup_supervisor"] = lambda _resources: cleanup_calls.append("cleanup") or ()

        def signal_inside_mask(operation, signals):
            require(operation == globals_["signal"].SIG_BLOCK
                    and signals == globals_["HANDLED_TERMINATION_SIGNALS"],
                    "cleanup transition used the wrong signal mask")
            globals_["interrupted"](globals_["signal"].SIGTERM, None)
            return set()

        globals_["signal"].pthread_sigmask = signal_inside_mask
        try:
            supervisor["main"]()
        except globals_["SupervisorCleanupFailure"] as error:
            require(error.primary_error is primary and error.__cause__ is primary
                    and cleanup_calls == ["cleanup"]
                    and tuple(category for category, _item in error.cleanup_errors)
                    == ("cleanup-transition-signal",)
                    and "signal 15" in str(error.cleanup_errors[0][1]),
                    "signal inside cleanup mask aborted cleanup or masked its primary")
        else:
            raise RuntimeError("signal-inside-mask cleanup transition unexpectedly succeeded")

        mask_error = OSError(errno.EIO, "cleanup mask failed")
        cleanup_calls.clear()
        def failing_cleanup_mask(_operation, _signals):
            raise mask_error
        globals_["signal"].pthread_sigmask = failing_cleanup_mask
        try:
            supervisor["main"]()
        except globals_["SupervisorCleanupFailure"] as error:
            require(error.primary_error is primary and error.__cause__ is primary
                    and cleanup_calls == ["cleanup"]
                    and error.cleanup_errors == (("cleanup-transition-mask", mask_error),),
                    "cleanup mask failure aborted cleanup or replaced its primary")
        else:
            raise RuntimeError("failing cleanup mask transition unexpectedly succeeded")

        globals_["cleanup_supervisor"] = original_cleanup

        calls = []
        masks = []
        blocked = False
        injected = False
        killed = set()
        active = Process(91, calls)
        retained = Process(92, calls)
        primary = RuntimeError("primary-before-cleanup-signal")

        def signal_wait_body(acquired):
            globals_["OWNED_PHASE_GROUP"] = {"process": active, "pgid": 91}
            acquired.update(resources(
                snapshot_fd=93, retained_process=retained,
                retained_group={"process": retained, "pgid": 92}))
            raise primary

        def cleanup_mask(operation, signals):
            nonlocal blocked
            masks.append((operation, signals))
            require(operation == globals_["signal"].SIG_BLOCK
                    and signals == globals_["HANDLED_TERMINATION_SIGNALS"],
                    "cleanup transition used or restored the wrong signal mask")
            blocked = True
            return set()

        def cleanup_killpg(pid, signum):
            calls.append(("kill", pid, signum))
            if signum == 0:
                if pid in killed:
                    raise ProcessLookupError()
                return
            if signum == globals_["signal"].SIGKILL or pid == 92:
                killed.add(pid)

        clock = 0.0
        def cleanup_monotonic():
            nonlocal clock
            clock += 0.25
            return clock

        def cleanup_sleep(_seconds):
            nonlocal injected
            require(blocked, "cleanup wait ran before termination signals were blocked")
            if not injected:
                injected = True
                globals_["interrupted"](globals_["signal"].SIGTERM, None)

        globals_["supervisor_body"] = signal_wait_body
        globals_["signal"].pthread_sigmask = cleanup_mask
        globals_["os"].killpg = cleanup_killpg
        globals_["os"].close = lambda descriptor: calls.append(("close", descriptor))
        globals_["time"].monotonic = cleanup_monotonic
        globals_["time"].sleep = cleanup_sleep
        try:
            supervisor["main"]()
        except globals_["SupervisorCleanupFailure"] as error:
            categories = tuple(category for category, _item in error.cleanup_errors)
            require(error.primary_error is primary and error.__cause__ is primary
                    and str(error).startswith("primary-before-cleanup-signal; cleanup failed: ")
                    and categories == ("cleanup-transition-signal",)
                    and masks == [(globals_["signal"].SIG_BLOCK,
                                   globals_["HANDLED_TERMINATION_SIGNALS"])]
                    and blocked and injected
                    and ("kill", 91, globals_["signal"].SIGKILL) in calls
                    and ("kill", 92, globals_["signal"].SIGTERM) in calls
                    and ("close", 93) in calls,
                    "cleanup-wait signal masked the primary or aborted later safe handling")
        else:
            raise RuntimeError("cleanup-wait signal injection unexpectedly succeeded")

        globals_["supervisor_body"] = lambda _resources: (_ for _ in ()).throw(primary)
        globals_["signal"].pthread_sigmask = original_pthread_sigmask
        globals_["time"].monotonic = original_monotonic
        globals_["time"].sleep = original_sleep

        calls = []
        active = Process(101, calls, status=0)
        keeper = Process(102, calls)
        globals_["ACTIVE_PHASE"] = None
        globals_["OWNED_PHASE_GROUP"] = {"process": active, "pgid": 101}
        def unknown_group(pid, signum):
            calls.append(("kill", pid, signum))
            if signum == 0:
                raise OSError(errno.EIO, "group probe failed")
        globals_["os"].killpg = unknown_group
        globals_["os"].unlink = lambda path: calls.append(("unlink", path))
        globals_["fsync_directory"] = lambda path: calls.append(("fsync", path))
        globals_["os"].close = lambda descriptor: calls.append(("close", descriptor))
        globals_["subprocess"].run = lambda *_args, **_kwargs: calls.append(("database",))
        globals_["recover_intents"] = lambda: calls.append(("recover",))
        cleanup = supervisor["cleanup_supervisor"](resources(
            lock_fd=43, lock_keeper=keeper,
            lock_keeper_group={"process": keeper, "pgid": 102}, snapshot_fd=42,
            lock_held=True, intents_acquired=True, keeper_marker=True,
            database_cleanup=True))
        categories = tuple(category for category, _error in cleanup)
        require(categories == (
                    "active-phase-probe", "active-phase-containment-retained")
                and ("kill", 101, 0) in calls
                and not any(call == ("kill", 101, globals_["signal"].SIGTERM)
                            or call == ("kill", 101, globals_["signal"].SIGKILL)
                            for call in calls)
                and ("close", 42) in calls
                and not any(call[0] in ("database", "unlink", "fsync", "recover")
                            or call == ("close", 43)
                            or call[:2] == ("kill", 102) for call in calls),
                "unconfirmed active process group dismantled transaction quarantine")

        calls = []
        active = Process(101, calls)
        keeper = Process(102, calls)
        retained = Process(103, calls)
        globals_["ACTIVE_PHASE"] = None
        globals_["OWNED_PHASE_GROUP"] = {"process": active, "pgid": 101}
        signalled = set()

        def killpg(pid, signum):
            calls.append(("kill", pid, signum))
            if signum == 0:
                if pid in signalled:
                    raise ProcessLookupError()
                return
            signalled.add(pid)
            if pid in (101, 103):
                raise OSError(errno.EIO, f"kill {pid} failed")

        def close(descriptor):
            calls.append(("close", descriptor))
            if descriptor == 42:
                raise OSError(errno.EIO, "snapshot close failed")

        def run_cleanup(arguments, **_kwargs):
            calls.append(("database", arguments[4]))
            if arguments[4] == "/usr/bin/dropdb":
                return types.SimpleNamespace(returncode=1, stdout="drop out", stderr="drop err")
            raise OSError(errno.EIO, "role cleanup failed")

        globals_["os"].killpg = killpg
        globals_["os"].unlink = lambda path: (
            calls.append(("unlink", path)),
            (_ for _ in ()).throw(OSError(errno.EIO, "unlink failed")),
        )[-1]
        globals_["fsync_directory"] = lambda path: (
            calls.append(("fsync", path)),
            (_ for _ in ()).throw(OSError(errno.EIO, "fsync failed")),
        )[-1]
        globals_["os"].close = close
        globals_["subprocess"].run = run_cleanup
        globals_["recover_intents"] = lambda: (
            calls.append(("recover",)),
            (_ for _ in ()).throw(OSError(errno.EIO, "recovery failed")),
        )[-1]
        class BrokenStderr:
            def write(self, _value):
                raise OSError(errno.EIO, "stderr write failed")

            def flush(self):
                raise OSError(errno.EIO, "stderr flush failed")
        globals_["sys"].stderr = BrokenStderr()
        cleanup = supervisor["cleanup_supervisor"](resources(
            lock_fd=43, lock_keeper=keeper,
            lock_keeper_group={"process": keeper, "pgid": 102}, snapshot_fd=42,
            retained_process=retained,
            retained_group={"process": retained, "pgid": 103},
            lock_held=True, intents_acquired=True,
            keeper_marker=True, database_cleanup=True))
        categories = tuple(category for category, _error in cleanup)
        require(categories == (
            "active-phase-kill", "retained-process-kill",
            "snapshot-close", "drop database", "drop database-report", "drop roles",
            "drop roles-report", "lock-keeper-marker-unlink",
            "lock-keeper-marker-fsync", "intent-recovery"),
            f"supervisor cleanup categories or order changed: {categories!r}")
        require(("kill", 102, globals_["signal"].SIGTERM) in calls
                and ("kill", 101, globals_["signal"].SIGTERM) in calls
                and ("unlink", globals_["LOCK_KEEPER_PID_PATH"]) in calls
                and ("fsync", "/run/nmcp-ci") in calls
                and ("kill", 103, globals_["signal"].SIGTERM) in calls
                and ("close", 42) in calls and ("database", "/usr/bin/dropdb") in calls
                and ("database", "/usr/bin/psql") in calls and ("recover",) in calls
                and ("close", 43) in calls,
                f"one supervisor cleanup failure blocked a later eligible operation: {calls!r}")
        globals_["sys"].stderr = original_stderr

        primary = RuntimeError("create-owned-primary")
        local_calls = []
        original_durable = globals_["durable_intents"]
        original_fault = globals_["fault"]
        original_lexists = globals_["os"].path.lexists
        original_mkdir = globals_["os"].mkdir
        original_fsync_call = globals_["os"].fsync
        original_mask = globals_["signal"].pthread_sigmask
        descriptors = iter((71, 72))
        owned_stat = types.SimpleNamespace(
            st_dev=1, st_ino=2, st_mode=stat.S_IFDIR | 0o700,
            st_uid=0, st_gid=0)
        try:
            globals_["os"].open = lambda *_args, **_kwargs: next(descriptors)
            globals_["os"].fstat = lambda _descriptor: owned_stat
            globals_["os"].path.lexists = lambda _path: False
            globals_["os"].mkdir = lambda *_args, **_kwargs: None
            globals_["os"].fsync = lambda _descriptor: None
            globals_["durable_intents"] = lambda _entries: None
            globals_["fault"] = lambda _entries, _path, stage, _label: (
                (_ for _ in ()).throw(primary) if stage == "after-register" else None)
            def causal_close(descriptor):
                local_calls.append(("close", descriptor))
                raise OSError(errno.EIO, f"close {descriptor}")
            def causal_umask(mask):
                local_calls.append(("umask", mask))
                if mask == 0o077:
                    raise OSError(errno.EIO, "umask restore")
                return 0o077
            def causal_mask(how, mask):
                local_calls.append(("mask", how, mask))
                if how == globals_["signal"].SIG_SETMASK:
                    raise OSError(errno.EIO, "mask restore")
                return {globals_["signal"].SIGUSR1}
            globals_["os"].close = causal_close
            globals_["os"].umask = causal_umask
            globals_["signal"].pthread_sigmask = causal_mask
            try:
                supervisor["create_owned_top"](
                    "/fixture/owned", 0o700, [], set(), "fixture")
            except globals_["SupervisorCleanupFailure"] as error:
                require(error.primary_error is primary and error.__cause__ is primary
                        and tuple(category for category, _item in error.cleanup_errors) == (
                            "owned-top-close", "umask-restore", "owned-parent-close",
                            "signal-mask-restore")
                        and local_calls[-4:] == [
                            ("close", 72), ("umask", 0o077), ("close", 71),
                            ("mask", globals_["signal"].SIG_SETMASK,
                             {globals_["signal"].SIGUSR1})],
                        "create_owned_top cleanup masked its primary or skipped restoration")
            else:
                raise RuntimeError("create_owned_top causal cleanup unexpectedly succeeded")
        finally:
            globals_["durable_intents"] = original_durable
            globals_["fault"] = original_fault
            globals_["os"].path.lexists = original_lexists
            globals_["os"].mkdir = original_mkdir
            globals_["os"].fsync = original_fsync_call
            globals_["signal"].pthread_sigmask = original_mask

        phase_primary = RuntimeError("phase-primary")
        phase_calls = []
        try:
            with supervisor["CleanupScope"]() as cleanup_scope:
                for descriptor in (81, 82, 83):
                    cleanup_scope.defer("phase-input-close", lambda value: (
                        phase_calls.append(value),
                        (_ for _ in ()).throw(OSError(errno.EIO, f"close {value}")),
                    )[-1], descriptor)
                raise phase_primary
        except globals_["SupervisorCleanupFailure"] as error:
            require(error.primary_error is phase_primary and error.__cause__ is phase_primary
                    and phase_calls == [83, 82, 81]
                    and len(error.cleanup_errors) == 3,
                    "phase-style descriptor cleanup skipped a close or replaced the primary")
        else:
            raise RuntimeError("phase-style descriptor cleanup unexpectedly succeeded")

        aggregate_primary = RuntimeError("primary-first")
        aggregate_cleanup = (
            ("snapshot-close", RuntimeError("snapshot-detail")),
            ("lock-close", RuntimeError("lock-detail")),
        )
        globals_["supervisor_body"] = lambda _resources: (
            _ for _ in ()).throw(aggregate_primary)
        globals_["cleanup_supervisor"] = lambda _resources: aggregate_cleanup
        try:
            supervisor["main"]()
        except globals_["SupervisorCleanupFailure"] as error:
            require(str(error) == ("primary-first; cleanup failed: "
                                   "snapshot-close: snapshot-detail; lock-close: lock-detail")
                    and error.primary_error is aggregate_primary
                    and error.cleanup_errors == aggregate_cleanup
                    and error.__cause__ is aggregate_primary,
                    "supervisor aggregate did not expose primary-first cleanup detail and cause")
        else:
            raise RuntimeError("supervisor aggregate failure unexpectedly succeeded")

        nonce = "a" * 64
        marker_stat = types.SimpleNamespace(
            st_dev=1, st_ino=2, st_mode=stat.S_IFREG | 0o600, st_uid=0, st_gid=0,
            st_nlink=1, st_size=65, st_mtime_ns=3, st_ctime_ns=4)
        descriptors = iter((10, 11))
        closed = []
        globals_["os"].open = lambda *_args, **_kwargs: next(descriptors)
        globals_["os"].fstat = lambda _descriptor: marker_stat
        globals_["os"].read = lambda _descriptor, _size: (nonce + "\n").encode("ascii")
        globals_["os"].stat = lambda *_args, **_kwargs: marker_stat
        def fail_close(descriptor):
            closed.append(descriptor)
            raise OSError(errno.EIO, f"close {descriptor} failed")
        globals_["os"].close = fail_close
        try:
            supervisor["validate_launch_marker"](
                "/run/nmcp-ci/launch-" + nonce + ".release", nonce, ".release")
        except globals_["SupervisorCleanupFailure"] as error:
            require(closed == [11, 10]
                    and error.primary_error is None
                    and tuple(category for category, _item in error.cleanup_errors) == (
                        "launch-marker-close", "launch-marker-directory-close"),
                    "launch marker validation did not independently close both descriptors")
        else:
            raise RuntimeError("injected launch marker close failures unexpectedly succeeded")
    finally:
        globals_["supervisor_body"] = original_body
        globals_["run_supervisor_body"] = original_run_body
        globals_["cleanup_supervisor"] = original_cleanup
        globals_["CLEANUP_TRANSITION_ERRORS"] = original_transition_errors
        globals_["SIGNAL_ERRORS"][:] = original_signal_errors
        globals_["BODY_ACTIVE"] = original_body_active
        globals_["ACTIVE_PHASE"] = original_active
        globals_["OWNED_PHASE_GROUP"] = original_owned_phase
        globals_["recover_intents"] = original_recover
        globals_["fsync_directory"] = original_fsync
        globals_["subprocess"].run = original_run
        globals_["os"].open = original_open
        globals_["os"].close = original_close
        globals_["os"].fstat = original_fstat
        globals_["os"].read = original_read
        globals_["os"].stat = original_stat
        globals_["os"].unlink = original_unlink
        globals_["os"].killpg = original_killpg
        globals_["sys"].stderr = original_stderr
        globals_["sys"].argv = original_argv
        globals_["os"].environ = original_environ
        globals_["os"].geteuid = original_geteuid
        globals_["os"].chdir = original_chdir
        globals_["os"].umask = original_umask
        globals_["signal"].signal = original_signal
        globals_["signal"].pthread_sigmask = original_pthread_sigmask
        globals_["time"].monotonic = original_monotonic
        globals_["time"].sleep = original_sleep
        globals_["os"].makedirs = original_makedirs
        globals_["os"].lstat = original_lstat
        globals_["fcntl"].flock = original_flock
        globals_["git"] = original_git


def main():
    client = runpy.run_path(str(CLIENT_PATH), run_name="diagnostic_client_fixture")
    containment = runpy.run_path(str(CONTAINMENT_PATH), run_name="diagnostic_containment_fixture")
    supervisor = runpy.run_path(str(SUPERVISOR_PATH), run_name="diagnostic_supervisor_fixture")
    supervisor_process_group_case(supervisor)
    supervisor_atomic_launch_cases(supervisor)
    supervisor_cleanup_cases(supervisor)
    containment["assert_persistent_cgroup_routing_contract"]()
    diagnostic_cases(client, containment)
    explicit_marker_phase_cases(containment)
    persistent_launch_release_cases(containment)
    persistent_handoff_state_cases(containment)
    cancellation_accounting_cases(client)
    signal_result_cases(containment)
    release_marker_security_cases(client, containment)
    signed_cleanup_lock_cases(containment)
    stale_diagnostic_cases(containment)
    containment_serialization_cases(containment)
    client_cgroup_lifecycle_cases(client)
    client_prelaunch_production_path_case(client)
    client_final_residue_diagnostic_cases(client)
    client_terminal_empty_launch_routing_cases(client)
    client_cgroup_observation_cases(client)
    client_cgroup_diagnostic_dedup_cases(client)
    client_phase_routing_cases(client)
    counter_atomic_cases(client, containment)
    actual_boundary_cases(client, containment)
    intent_epoch_cases(containment)
    producer_epoch_state_cases(containment)
    client_cleanup_result_cases(client, containment)
    client_terminal_emission_cases(client, containment)
    client_teardown_transition_cases(client, containment)
    for namespace in (client, containment):
        cgroup_boundary_cases(namespace)
        for kind in ("root-disappears", "file-disappears", "residue",
                     "cross-attempt-root-reuse", "same-attempt-root-reuse",
                     "reordered-topology", "renamed-same-inode", "transient-file-residue",
                     "changing-pids", "child-disappears", "nondirectory-child",
                     "transient-root-residue", "two-absent-root-observations",
                     "empty-root-removal", "residue-root-removal",
                     "partial-residue-root-removal",
                     "complete-interrupted-complete", "absent-live-recheck-absent",
                     "complete-absent-complete",
                     "before-after-fstat-mismatch", "final-directory-recheck-mismatch",
                     "initial-root-nondirectory", "root-becomes-nondirectory",
                     "directory-becomes-nondirectory", "malformed-pids"):
            cgroup_case(namespace, kind)
    print("Ubuntu diagnostic fixtures passed")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
