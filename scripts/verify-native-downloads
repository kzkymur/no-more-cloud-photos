assert expected_cache_parent_probe in prepare_text, "native capability probe must cover every real cache parent"

tracked = subprocess.run(
    ["git", "ls-files", "-z"],
    cwd=repo,
    check=True,
    stdout=subprocess.PIPE,
).stdout.decode().split("\0")
snapshot_exclusions = {"internal/nativevalidation/download-verified", "scripts/verify-native-downloads"}
canonical_repository_sha256 = "a58628cd8026e9b34366d1e93992aca85f01e81e7556e75ae119d5eeb2c264c8"


def repository_source_digest(contents):
    digest = hashlib.sha256()
    for relative in sorted(contents):
        if relative in snapshot_exclusions:
            continue
        digest.update(relative.encode())
        digest.update(b"\0")
        digest.update(contents[relative])
        digest.update(b"\0")
    return digest.hexdigest()


tracked_contents = {relative: (repo / relative).read_bytes() for relative in filter(None, tracked)}
assert repository_source_digest(tracked_contents) == canonical_repository_sha256, "canonical tracked source snapshot changed"

split_constructed_consumer = b'''#!/usr/bin/env bash
suffix=-verified
helper=download
"$repo/internal/nativevalidation/$helper$suffix" "$target" "$url" "$digest"
'''
mutated_contents = dict(tracked_contents)
mutated_contents["scripts/new-split-constructed-consumer"] = split_constructed_consumer
assert repository_source_digest(mutated_contents) != canonical_repository_sha256, "new tracked constructed consumer escaped repository snapshot"

literal_reference_allowlist = set(consumer_tuples) | {"scripts/verify-native-downloads", ".github/workflows/ci.yml"}
variable_reference_allowlist = set(consumer_tuples) | {"scripts/verify-native-downloads"}


def assert_tracked_consumer_inventory(relative, text):
    if "internal/nativevalidation/download" in text:
        assert relative in literal_reference_allowlist, f"unvalidated downloader consumer/reference: {relative}"
    if "download_verified" in text:
        assert relative in variable_reference_allowlist, f"unvalidated downloader variable consumer: {relative}"


discovered_literal_references = set()
discovered_variable_references = set()
for relative in filter(None, tracked):
    try:
        text = (repo / relative).read_text()
    except UnicodeDecodeError:
        continue
    assert_tracked_consumer_inventory(relative, text)
    if "internal/nativevalidation/download" in text:
        discovered_literal_references.add(relative)
    if "download_verified" in text:
        discovered_variable_references.add(relative)

assert discovered_literal_references == literal_reference_allowlist, "tracked downloader reference inventory changed"
assert discovered_variable_references == variable_reference_allowlist, "tracked downloader variable inventory changed"

try:
    assert_tracked_consumer_inventory("scripts/new-constructed-consumer", constructed_downloader_mutation)
except AssertionError:
    pass
else:
    raise AssertionError("new tracked constructed downloader consumer was accepted")


def lexists(path):
    return os.path.lexists(path)


def entries(path):
    return sorted(item.name for item in pathlib.Path(path).iterdir())


def assert_no_internal_residue(directory):
    assert not any(name.startswith(".download-verified.") for name in entries(directory)), entries(directory)


def consume_retained_quarantine(directory, *, expected_bytes=None, expected_type=stat.S_IFREG, symlink_target=None):
    quarantines = [item for item in pathlib.Path(directory).iterdir() if item.name.startswith(".download-verified.quarantine.")]
    assert len(quarantines) == 1, [item.name for item in quarantines]
    quarantine = quarantines[0]
    assert stat.S_IMODE(quarantine.stat().st_mode) == 0o700
    entry = quarantine / "entry"
    metadata = entry.lstat()
    assert stat.S_IFMT(metadata.st_mode) == expected_type
    if expected_bytes is not None:
        if not metadata.st_mode & stat.S_IRUSR:
            entry.chmod(0o600)
        assert entry.read_bytes() == expected_bytes
    if symlink_target is not None:
        assert entry.is_symlink() and os.readlink(entry) == os.fspath(symlink_target)
    shutil.rmtree(quarantine)


def consume_empty_quarantine(directory):
    quarantines = [item for item in pathlib.Path(directory).iterdir() if item.name.startswith(".download-verified.quarantine.")]
    assert len(quarantines) == 1, [item.name for item in quarantines]
    assert entries(quarantines[0]) == []
    shutil.rmtree(quarantines[0])


def wait_for(path, process):
    deadline = time.monotonic() + 10
    while not path.exists():
        if process.poll() is not None:
            raise AssertionError(f"downloader exited before barrier {path.name}: {process.returncode}")
        if time.monotonic() >= deadline:
            raise AssertionError(f"timed out waiting for barrier {path.name}")
        time.sleep(0.01)


with tempfile.TemporaryDirectory() as temporary:
    work = pathlib.Path(temporary)
    fake_bin = work / "bin"
    fake_bin.mkdir()
    fake_curl = fake_bin / "curl"
    fake_curl.write_text(
        """#!/usr/bin/env bash
set -euo pipefail
printf '%s\\n' "${FAKE_CURL_MODE:-success}" >>"$FAKE_CURL_LOG"
case ${FAKE_CURL_MODE:-success} in
  success) cat -- "$FAKE_CURL_SOURCE" ;;
  bad-download) printf 'bad downloaded bytes\\n' ;;
  failure) exit 47 ;;
  hup)
    kill -HUP "$PPID"
    sleep 30
    ;;
  interrupt)
    kill -INT "$PPID"
    sleep 30
    ;;
  signal)
    kill -TERM "$PPID"
    sleep 30
    ;;
  *) exit 98 ;;
esac
"""
    )
    fake_curl.chmod(0o755)
    source = work / "source"
    source.write_bytes(b"verified native download fixture\n")
    digest = hashlib.sha256(source.read_bytes()).hexdigest()
    curl_log = work / "curl.log"
    outside = work / "outside"
    outside.mkdir()
    (outside / "sentinel").write_text("outside sentinel\n")
    base_env = os.environ.copy()
    base_env.update(
        {
            "PATH": f"{fake_bin}:{base_env['PATH']}",
            "FAKE_CURL_SOURCE": str(source),
            "FAKE_CURL_LOG": str(curl_log),
        }
    )

    def invoke(target, mode="success", env=None):
        run_env = base_env.copy()
        run_env["FAKE_CURL_MODE"] = mode
        if env:
            run_env.update(env)
        return subprocess.run(
            [str(downloader), str(target), "fixture://native", digest],
            env=run_env,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
        )

    def barrier_case(target, event, mutate, mode="success"):
        barrier_root = pathlib.Path(tempfile.mkdtemp(prefix="barrier-", dir=work))
        run_env = base_env.copy()
        run_env.update(
            {
                "FAKE_CURL_MODE": mode,
                "NMCP_DOWNLOAD_TEST_BARRIER_DIR": str(barrier_root),
                "NMCP_DOWNLOAD_TEST_BARRIER": event,
            }
        )
        process = subprocess.Popen(
            [str(downloader), str(target), "fixture://native", digest],
            env=run_env,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
        )
        ready = barrier_root / f"{event}.ready"
        release = barrier_root / f"{event}.release"
        wait_for(ready, process)
        mutate(process, barrier_root)
        release.touch()
        stdout, stderr = process.communicate(timeout=15)
        return process.returncode, stdout, stderr

    def barrier_sequence_case(target, events, mutations, mode="success"):
        assert len(events) == len(mutations)
        barrier_root = pathlib.Path(tempfile.mkdtemp(prefix="barrier-sequence-", dir=work))
        run_env = base_env.copy()
        run_env.update(
            {
                "FAKE_CURL_MODE": mode,
                "NMCP_DOWNLOAD_TEST_BARRIER_DIR": str(barrier_root),
                "NMCP_DOWNLOAD_TEST_BARRIER": ",".join(events),
            }
        )
        process = subprocess.Popen(
            [str(downloader), str(target), "fixture://native", digest],
            env=run_env,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
        )
        for event, mutate in zip(events, mutations):
            ready = barrier_root / f"{event}.ready"
            wait_for(ready, process)
            mutate(process, barrier_root)
            (barrier_root / f"{event}.release").touch()
        stdout, stderr = process.communicate(timeout=15)
        return process.returncode, stdout, stderr

    cache = work / "cache"
    cache.mkdir()
    capability = subprocess.run(
        [str(downloader), "--probe-parent", str(cache)],
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
    )
    assert capability.returncode == 0, capability.stderr
    capability_entries = entries(cache)
    assert len(capability_entries) == 1
    assert capability_entries[0].startswith(".download-verified.capability-retained.")
    marker = cache / capability_entries[0]
    assert stat.S_IMODE(marker.stat().st_mode) == 0o600
    assert marker.read_bytes() == b"no-more-cloud-photos native cache capability\n"
    unsupported = subprocess.run(
        [str(downloader), "--probe-parent", "/proc"],
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
    )
    assert unsupported.returncode == 1
    assert "cache parent lacks O_TMPFILE support at /proc:" in unsupported.stderr, unsupported.stderr

    warm_targets = (
        cache / ".tools/exiftool-13.36.tar.gz",
        cache / ".native-work/downloads/sRGB2014.icc",
        cache / ".native-work/still/downloads/lcms2-2.14.tar.gz",
        cache / ".native-work/animation/downloads/libwebp-1.6.0.tar.gz",
        cache / ".native-work/video/downloads/ffmpeg-9.0.2.tar.xz",
    )
    for target in warm_targets:
        target.parent.mkdir(parents=True, exist_ok=True)
        target.write_bytes(b"corrupt warm cache\n")
        result = invoke(target)
        assert result.returncode == 0, result.stderr
        assert target.read_bytes() == source.read_bytes()
        consume_retained_quarantine(target.parent, expected_bytes=b"corrupt warm cache\n")
        assert_no_internal_residue(target.parent)
    initial_downloads = len(curl_log.read_text().splitlines())
    assert initial_downloads == len(warm_targets)
    result = invoke(warm_targets[-1])
    assert result.returncode == 0, result.stderr
    assert len(curl_log.read_text().splitlines()) == initial_downloads

    failures = cache / "failures"
    failures.mkdir()
    for mode, expected in (("failure", 47), ("bad-download", 1), ("hup", 129), ("interrupt", 130), ("signal", 143)):
        target = failures / f"{mode}.tar.xz"
        result = invoke(target, mode)
        assert result.returncode == expected, (mode, result.returncode, result.stderr)
        assert not lexists(target)
        assert_no_internal_residue(failures)

    shapes = cache / "shapes"
    shapes.mkdir()
    directory_target = shapes / "directory.tar.xz"
    directory_target.mkdir()
    (directory_target / "sentinel").write_text("directory sentinel\n")
    before = len(curl_log.read_text().splitlines())
    result = invoke(directory_target)
    assert result.returncode == 73, result.stderr
    assert entries(directory_target) == ["sentinel"]
    assert len(curl_log.read_text().splitlines()) == before
    fifo_target = shapes / "fifo.tar.xz"
    os.mkfifo(fifo_target)
    result = invoke(fifo_target)
    assert result.returncode == 0, result.stderr
    assert stat.S_ISREG(fifo_target.stat().st_mode) and fifo_target.read_bytes() == source.read_bytes()
    consume_retained_quarantine(shapes, expected_type=stat.S_IFIFO)
    symlink_target = shapes / "symlink.tar.xz"
    symlink_target.symlink_to(outside, target_is_directory=True)
    result = invoke(symlink_target)
    assert result.returncode == 0, result.stderr
    assert not symlink_target.is_symlink() and symlink_target.read_bytes() == source.read_bytes()
    assert entries(outside) == ["sentinel"]
    consume_retained_quarantine(shapes, expected_type=stat.S_IFLNK, symlink_target=outside)
    assert_no_internal_residue(shapes)

    unreadable_target = shapes / "unreadable.tar.xz"
    unreadable_target.write_bytes(b"unreadable corrupt cache\n")
    unreadable_target.chmod(0)
    result = invoke(unreadable_target)
    assert result.returncode == 0, result.stderr
    assert unreadable_target.read_bytes() == source.read_bytes()
    consume_retained_quarantine(shapes, expected_bytes=b"unreadable corrupt cache\n")

    initial_parent = cache / "initial-parent-link"
    initial_parent.symlink_to(outside, target_is_directory=True)
    result = invoke(initial_parent / "escaped.tar.xz")
    assert result.returncode == 1
    assert entries(outside) == ["sentinel"]

    races = cache / "races"
    races.mkdir()

    no_named_temp = races / "unnamed-temp.tar.xz"
    def assert_unnamed(_process, _barriers):
        assert entries(races) == []
    status, _, stderr = barrier_case(no_named_temp, "temp-opened", assert_unnamed)
    assert status == 0, stderr
    assert no_named_temp.read_bytes() == source.read_bytes()

    def install_collision(target, shape):
        if shape == "directory":
            target.mkdir()
            (target / "sentinel").write_text("collision directory\n")
        elif shape == "symlink":
            target.symlink_to(outside, target_is_directory=True)
        else:
            target.write_text("collision regular\n")

    def assert_collision(target, shape):
        if shape == "directory":
            assert target.is_dir() and entries(target) == ["sentinel"]
        elif shape == "symlink":
            assert target.is_symlink() and os.readlink(target) == os.fspath(outside)
        else:
            assert target.read_text() == "collision regular\n"

    for shape in ("directory", "symlink", "regular"):
        target = races / f"linkat-collision-{shape}"
        before = len(curl_log.read_text().splitlines())
        def collide_after_precheck(_process, _barriers, target=target, shape=shape):
            install_collision(target, shape)
        status, _, _ = barrier_case(target, "after-publish-absence-check", collide_after_precheck)
        assert status == 1
        assert len(curl_log.read_text().splitlines()) == before + 1
        assert_collision(target, shape)
        assert entries(outside) == ["sentinel"]
        assert_no_internal_residue(races)

    for event in ("warm-lstat-before-opath-open", "warm-readable-open-before-identity"):
        for shape in ("directory", "symlink", "regular"):
            target = races / f"{event}-{shape}"
            held = races / f"{event}-{shape}-held"
            target.write_bytes(source.read_bytes())
            original = target.stat().st_dev, target.stat().st_ino
            before = len(curl_log.read_text().splitlines())
            def replace_warm_boundary(_process, _barriers, target=target, held=held, shape=shape):
                target.rename(held)
                install_collision(target, shape)
            status, _, _ = barrier_case(target, event, replace_warm_boundary)
            assert status == (73 if event == "warm-lstat-before-opath-open" and shape == "directory" else 1)
            assert (held.stat().st_dev, held.stat().st_ino) == original
            assert held.read_bytes() == source.read_bytes()
            assert_collision(target, shape)
            assert len(curl_log.read_text().splitlines()) == before
            assert entries(outside) == ["sentinel"]
            assert_no_internal_residue(races)

    for event in ("temp-downloaded", "temp-hashed", "before-publish"):
        target = races / f"appeared-{event}.tar.xz"
        def create_foreign(_process, _barriers, target=target):
            target.write_text("foreign target\n")
        status, _, _ = barrier_case(target, event, create_foreign)
        assert status == 1
        assert target.read_text() == "foreign target\n"
        assert_no_internal_residue(races)

    warm_swap = races / "warm-open-swap.tar.xz"
    warm_swap.write_bytes(source.read_bytes())
    held_warm = races / "warm-open-owned"
    def replace_warm(_process, _barriers):
        warm_swap.rename(held_warm)
        warm_swap.write_bytes(source.read_bytes())
    status, _, _ = barrier_case(warm_swap, "warm-opened", replace_warm)
    assert status == 1
    assert warm_swap.read_bytes() == source.read_bytes()
    assert held_warm.read_bytes() == source.read_bytes()

    warm_mutation = races / "warm-hash-mutation.tar.xz"
    warm_mutation.write_bytes(source.read_bytes())
    def mutate_warm_inode(_process, _barriers):
        warm_mutation.write_bytes(b"mutated warm inode\n")
    status, _, _ = barrier_case(warm_mutation, "warm-hashed", mutate_warm_inode)
    assert status == 1
    assert warm_mutation.read_bytes() == b"mutated warm inode\n"

    for event in ("before-final-binding-1", "after-final-binding-1"):
        target = races / f"final-swap-{event}.tar.xz"
        held = races / f"held-{event}"
        def replace_published(_process, _barriers, target=target, held=held):
            target.rename(held)
            target.write_bytes(source.read_bytes())
        status, _, _ = barrier_case(target, event, replace_published)
        assert status == 1
        assert target.read_bytes() == source.read_bytes()
        assert held.read_bytes() == source.read_bytes()
        consume_empty_quarantine(races)
        assert_no_internal_residue(races)

    aba_target = races / "final-aba.tar.xz"
    aba_held = races / "final-aba-held"
    def rename_away_and_back(_process, _barriers):
        aba_target.rename(aba_held)
        aba_held.rename(aba_target)
    status, _, _ = barrier_case(aba_target, "after-final-binding-1", rename_away_and_back)
    assert status == 1
    assert not lexists(aba_target)
    consume_retained_quarantine(races, expected_bytes=source.read_bytes())
    assert_no_internal_residue(races)

    same_inode_mutation = races / "same-inode-after-final-hash.tar.xz"
    def mutate_published_inode(_process, _barriers):
        same_inode_mutation.write_bytes(b"mutated after final hash\n")
    status, _, _ = barrier_case(same_inode_mutation, "after-final-hash", mutate_published_inode)
    assert status == 1
    assert not lexists(same_inode_mutation)
    consume_retained_quarantine(races, expected_bytes=b"mutated after final hash\n")
    assert_no_internal_residue(races)

    signal_target = races / "signal-after-publish.tar.xz"
    def interrupt_after_publish(process, _barriers):
        process.send_signal(signal.SIGTERM)
    status, _, _ = barrier_case(signal_target, "after-publish", interrupt_after_publish)
    assert status == 143
    assert not lexists(signal_target)
    consume_retained_quarantine(races, expected_bytes=source.read_bytes())
    assert_no_internal_residue(races)

    rebound_root = cache / "rebound"
    rebound_parent = rebound_root / "downloads"
    rebound_parent.mkdir(parents=True)
    rebound_held = rebound_root / "held"
    rebound_target = rebound_parent / "archive.tar.xz"
    def rebind_parent(_process, _barriers):
        rebound_parent.rename(rebound_held)
        rebound_parent.symlink_to(outside, target_is_directory=True)
    status, _, _ = barrier_case(rebound_target, "before-publish", rebind_parent)
    assert status == 1
    assert entries(outside) == ["sentinel"]
    assert entries(rebound_held) == []
    rebound_parent.unlink()
    rebound_held.rename(rebound_parent)

    replacement_held = rebound_root / "replacement-held"
    replacement_target = rebound_parent / "replacement.tar.xz"
    def replace_parent(_process, _barriers):
        rebound_parent.rename(replacement_held)
        rebound_parent.mkdir()
        (rebound_parent / "sentinel").write_text("replacement sentinel\n")
    status, _, _ = barrier_case(replacement_target, "before-publish", replace_parent)
    assert status == 1
    assert entries(rebound_parent) == ["sentinel"]
    assert entries(replacement_held) == []
    shutil.rmtree(rebound_parent)
    replacement_held.rename(rebound_parent)

    published_rebound_held = rebound_root / "published-held"
    published_rebound_target = rebound_parent / "published.tar.xz"
    def rebind_after_publish(_process, _barriers):
        rebound_parent.rename(published_rebound_held)
        rebound_parent.symlink_to(outside, target_is_directory=True)
    status, _, _ = barrier_case(published_rebound_target, "after-publish", rebind_after_publish)
    assert status == 1
    assert entries(outside) == ["sentinel"]
    consume_retained_quarantine(published_rebound_held, expected_bytes=source.read_bytes())
    assert entries(published_rebound_held) == []
    rebound_parent.unlink()
    published_rebound_held.rename(rebound_parent)

    invalid_target = races / "invalid-quarantine.tar.xz"
    invalid_target.write_bytes(b"invalid\n")
    invalid_held = races / "invalid-held"
    def replace_before_quarantine(_process, _barriers):
        invalid_target.rename(invalid_held)
        invalid_target.write_text("foreign target\n")
    status, _, _ = barrier_case(invalid_target, "before-invalid-quarantine", replace_before_quarantine)
    assert status == 1
    assert invalid_target.read_text() == "foreign target\n"
    assert invalid_held.read_text() == "invalid\n"
    consume_empty_quarantine(races)
    assert_no_internal_residue(races)

    quarantined_target = races / "after-quarantine.tar.xz"
    quarantined_target.write_bytes(b"invalid\n")
    quarantined_held = races / "quarantined-held"
    def replace_quarantine(_process, _barriers):
        quarantine = next(item for item in races.iterdir() if item.name.startswith(".download-verified.quarantine."))
        entry = quarantine / "entry"
        entry.rename(quarantined_held)
        entry.write_text("foreign quarantine\n")
    status, _, _ = barrier_case(quarantined_target, "after-invalid-quarantine", replace_quarantine)
    assert status == 1
    assert quarantined_target.read_text() == "foreign quarantine\n"
    assert quarantined_held.read_text() == "invalid\n"
    consume_empty_quarantine(races)
    assert_no_internal_residue(races)

    invalid_identity_target = races / "invalid-identity-boundary.tar.xz"
    invalid_identity_target.write_bytes(b"invalid identity boundary\n")
    invalid_identity_held = races / "invalid-identity-held"
    def replace_after_invalid_identity(_process, _barriers):
        quarantine = next(item for item in races.iterdir() if item.name.startswith(".download-verified.quarantine."))
        entry = quarantine / "entry"
        entry.rename(invalid_identity_held)
        entry.write_text("foreign after invalid identity\n")
        _process.send_signal(signal.SIGTERM)
        _process.send_signal(signal.SIGHUP)
    status, _, _ = barrier_case(
        invalid_identity_target,
        "after-invalid-quarantine-identity-before-unlink",
        replace_after_invalid_identity,
    )
    assert status == 1
    assert invalid_identity_target.read_text() == "foreign after invalid identity\n"
    assert invalid_identity_held.read_bytes() == b"invalid identity boundary\n"
    consume_empty_quarantine(races)
    assert_no_internal_residue(races)

    invalid_finally_target = races / "invalid-finally-boundary.tar.xz"
    invalid_finally_target.write_bytes(b"invalid finally boundary\n")
    invalid_finally_held = races / "invalid-finally-held"
    def replace_after_invalid_finally_identity(_process, _barriers):
        quarantine = next(item for item in races.iterdir() if item.name.startswith(".download-verified.quarantine."))
        entry = quarantine / "entry"
        entry.rename(invalid_finally_held)
        entry.write_text("foreign after invalid finally identity\n")
        _process.send_signal(signal.SIGHUP)
        _process.send_signal(signal.SIGINT)
    status, _, stderr = barrier_case(
        invalid_finally_target,
        "after-invalid-finally-identity-before-unlink",
        replace_after_invalid_finally_identity,
    )
    assert status == 129, stderr
    assert not lexists(invalid_finally_target)
    assert invalid_finally_held.read_bytes() == b"invalid finally boundary\n"
    consume_retained_quarantine(races, expected_bytes=b"foreign after invalid finally identity\n")
    assert_no_internal_residue(races)

    def interrupt_published(process, _barriers):
        process.send_signal(signal.SIGTERM)

    owned_identity_target = races / "owned-identity-boundary.tar.xz"
    owned_identity_held = races / "owned-identity-held"
    def replace_after_owned_identity(_process, _barriers):
        quarantine = next(item for item in races.iterdir() if item.name.startswith(".download-verified.quarantine."))
        entry = quarantine / "entry"
        entry.rename(owned_identity_held)
        entry.write_text("foreign after owned identity\n")
        _process.send_signal(signal.SIGHUP)
    status, _, _ = barrier_sequence_case(
        owned_identity_target,
        ("after-publish", "after-owned-quarantine-identity-before-unlink"),
        (interrupt_published, replace_after_owned_identity),
    )
    assert status == 143
    assert owned_identity_target.read_text() == "foreign after owned identity\n"
    assert owned_identity_held.read_bytes() == source.read_bytes()
    consume_empty_quarantine(races)
    assert_no_internal_residue(races)

    owned_finally_target = races / "owned-finally-boundary.tar.xz"
    owned_finally_held = races / "owned-finally-held"
    def replace_after_owned_finally_identity(_process, _barriers):
        quarantine = next(item for item in races.iterdir() if item.name.startswith(".download-verified.quarantine."))
        entry = quarantine / "entry"
        entry.rename(owned_finally_held)
        entry.write_text("foreign after owned finally identity\n")
        _process.send_signal(signal.SIGINT)
    status, _, _ = barrier_sequence_case(
        owned_finally_target,
        ("after-publish", "after-owned-finally-identity-before-unlink"),
        (interrupt_published, replace_after_owned_finally_identity),
    )
    assert status == 143
    assert not lexists(owned_finally_target)
    assert owned_finally_held.read_bytes() == source.read_bytes()
    consume_retained_quarantine(races, expected_bytes=b"foreign after owned finally identity\n")
    assert_no_internal_residue(races)

    late_primary_target = races / "late-signal-primary-cleanup.tar.xz"
    def corrupt_after_final_hash(_process, _barriers):
        late_primary_target.write_bytes(b"primary checksum failure\n")
    def signal_during_primary_cleanup(process, _barriers):
        process.send_signal(signal.SIGTERM)
    status, _, _ = barrier_sequence_case(
        late_primary_target,
        ("after-final-hash", "after-owned-quarantine-identity-before-unlink"),
        (corrupt_after_final_hash, signal_during_primary_cleanup),
    )
    assert status == 1
    assert not lexists(late_primary_target)
    consume_retained_quarantine(races, expected_bytes=b"primary checksum failure\n")
    assert_no_internal_residue(races)

    late_finally_target = races / "late-signal-finally-cleanup.tar.xz"
    def corrupt_before_finally_cleanup(_process, _barriers):
        late_finally_target.write_bytes(b"primary state failure\n")
    def signal_during_finally_cleanup(process, _barriers):
        process.send_signal(signal.SIGHUP)
    status, _, _ = barrier_sequence_case(
        late_finally_target,
        ("after-final-hash", "after-owned-finally-identity-before-unlink"),
        (corrupt_before_finally_cleanup, signal_during_finally_cleanup),
    )
    assert status == 1
    assert not lexists(late_finally_target)
    consume_retained_quarantine(races, expected_bytes=b"primary state failure\n")
    assert_no_internal_residue(races)

    assert entries(outside) == ["sentinel"]

print("Native descriptor-relative download fixtures: PASS")
