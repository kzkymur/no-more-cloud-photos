"$repo/internal/nativevalidation/download$suffix" "$tools/extra.tar.gz" https://invalid.example/extra.tar.gz aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
'''
mutated_prepare = (repo / "scripts/prepare-native-validation").read_text() + constructed_downloader_mutation
try:
    assert_canonical_consumer("scripts/prepare-native-validation", mutated_prepare)
except AssertionError:
    pass
else:
    raise AssertionError("constructed downloader invocation was accepted in an actual consumer")

