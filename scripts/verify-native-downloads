# These four scripts are the complete tracked downloader-consumer inventory.
# Tuple parsing explains the contract; a canonical source digest additionally
# rejects shell-equivalent variable/path constructions that a partial parser
# cannot safely prove equivalent to one of the 15 blessed calls.
consumer_source_sha256 = {
    "scripts/prepare-native-validation": "8fce746de4602d9ccc97812918e332e116281510e6266b09cea6a4ac941f89e8",
    "internal/stillprocessor/helper/build-pinned-toolchain.sh": "cd1d57ccb03a836240a159a43c78c3cc50fa53107e7fd5e8a5fac667f5dc2bbd",
    "internal/animationprocessor/helper/build-pinned-codecs.sh": "b0cbaf149af53f5e3b1fd96e0f07c0411ff079f644523346e271815c1b106dbf",
    "internal/videoprocessor/helper/build-pinned-toolchain.sh": "5ac5ed7f03d177dc583d138b3f8dfae748cedbf20986a071b967b71501c802e5",
}
assert set(consumer_source_sha256) == set(consumer_tuples), "canonical consumer inventory differs from tuple inventory"


def assert_canonical_consumer(relative, text):
    actual = hashlib.sha256(text.encode()).hexdigest()
    assert actual == consumer_source_sha256[relative], f"{relative}: canonical consumer source changed"


for relative, expected in consumer_tuples.items():
    text = (repo / relative).read_text()
    assert_canonical_consumer(relative, text)
    assert "download() {" not in text, f"{relative}: retains private downloader"
    assert "download_verified=$repo/internal/nativevalidation/download-verified" in text, f"{relative}: downloader binding changed"
    assert_no_fetch_bypass(relative, text)
    assert_no_direct_downloader(relative, text)
    logical = text.replace("\\\n", "")
    actual = []
    probe_count = 0
    for line_number, line in enumerate(logical.splitlines(), 1):
        tokens = shlex.split(line, comments=True, posix=True)
        if tokens and tokens[0] == "$download_verified":
            if tokens[1:] == ["--probe-parent", "$cache_parent"]:
                assert relative == "scripts/prepare-native-validation", f"{relative}:{line_number}: unexpected capability probe"
                probe_count += 1
                continue
            assert len(tokens) == 4, f"{relative}:{line_number}: downloader requires exact target/URL/digest arguments"
            actual.append(tuple(tokens[1:]))
    assert actual == expected, f"{relative}: exact target/URL/digest tuples changed\nexpected={expected!r}\nactual={actual!r}"
    expected_probes = 1 if relative == "scripts/prepare-native-validation" else 0
    assert probe_count == expected_probes, f"{relative}: capability probe invocation changed"
    assert logical.count("$download_verified") == len(actual) + probe_count, f"{relative}: unparsed downloader invocation or alias"
    assert text.count("internal/nativevalidation/download-verified") == 1, f"{relative}: direct or aliased downloader reference"
    assert text.count("download-verified") == 1, f"{relative}: split-path or direct downloader reference"
    expected_identifier_count = 1 + len(actual) + probe_count
    assert len(re.findall(r"\bdownload_verified\b", text)) == expected_identifier_count, f"{relative}: downloader identifier alias or hidden invocation"

constructed_downloader_mutation = '''
