#!/usr/bin/env python3
import hashlib
import os
import pathlib
import re
import shutil
import shlex
import signal
import stat
import subprocess
import sys
import tempfile
import time

if sys.flags.optimize:
    raise SystemExit("verify-native-downloads requires Python assertions; do not use -O or PYTHONOPTIMIZE")

repo = pathlib.Path(__file__).resolve().parent.parent
downloader = repo / "internal/nativevalidation/download-verified"

fetch_tools = {"aria2c", "aria2p", "curl", "fetch", "ftp", "http", "httpie", "https", "lftp", "wget", "wget2", "xh"}
fetch_pattern = re.compile(
    r"(?<![A-Za-z0-9_.-])(" + "|".join(sorted(map(re.escape, fetch_tools), key=len, reverse=True)) + r")(?![A-Za-z0-9_.:-])"
)
shell_command_prefixes = {"do", "elif", "else", "if", "then", "until", "while"}
assignment = re.compile(r"^[A-Za-z_][A-Za-z0-9_]*=")
allowed_fetch_declaration = (
    "for", "command", "in", "autoconf", "automake", "cmake", "ctest", "curl", "git", "go", "ldd",
    "make", "meson", "nasm", "ninja", "pkg-config", "prlimit", "python3", "sha256sum", "stat", "tar",
    "timeout", "xz",
)
allowed_git_fetch = (
    "git", "-C", "$work/source/aom", "fetch", "--quiet", "--depth=1", "origin",
    "615b5f541e4434aebd993036bc97ebc1a77ebc25",
)


def shell_basename(token):
    return os.path.basename(token).strip("$(){}")


def shell_segments(line):
    lexer = shlex.shlex(line, posix=True, punctuation_chars=";&|")
    lexer.whitespace_split = True
    lexer.commenters = "#"
    segment = []
    for token in lexer:
        if token in {";", "&&", "||", "|", "|&", "&"}:
            if segment:
                yield segment
                segment = []
        else:
            segment.append(token)
    if segment:
        yield segment


def assert_no_fetch_bypass(relative, text):
    logical = text.replace("\\\n", "")
    for line_number, line in enumerate(logical.splitlines(), 1):
        for segment in shell_segments(line):
            first = shell_basename(segment[0])
            if relative == "scripts/prepare-native-validation" and tuple(segment) == allowed_fetch_declaration:
                continue
            index = 0
            if first in shell_command_prefixes:
                index += 1
            while index < len(segment) and assignment.match(segment[index]):
                index += 1
            used = set(fetch_pattern.findall(" ".join(segment)))
            if index == len(segment):
                assert not used, f"{relative}:{line_number}: bypasses shared downloader with {sorted(used)!r}"
                continue
            executable = shell_basename(segment[index])
            if executable == "git" and used == {"fetch"}:
                if relative == "internal/stillprocessor/helper/build-pinned-toolchain.sh" and tuple(segment) == allowed_git_fetch:
                    used = set()
            assert not used, f"{relative}:{line_number}: bypasses shared downloader with {sorted(used)!r}"


def assert_no_direct_downloader(relative, text):
    binding = "download_verified=$repo/internal/nativevalidation/download-verified"
    logical = text.replace("\\\n", "")
    for line_number, line in enumerate(logical.splitlines(), 1):
        if line.strip() == binding:
            continue
        for segment in shell_segments(line):
            direct = [token for token in segment if shell_basename(token) == "download-verified"]
            assert not direct, f"{relative}:{line_number}: direct or concatenated downloader invocation"


fetch_mutations = (
    "curl https://invalid.example",
    "/usr/bin/curl https://invalid.example",
    "command -- curl https://invalid.example",
    "env curl https://invalid.example",
    "env TOKEN=value /usr/bin/wget https://invalid.example",
    "TOKEN=value curl https://invalid.example",
    "timeout 1m wget https://invalid.example",
    "nice -n 1 aria2c https://invalid.example",
    "sudo -n -- /usr/bin/fetch https://invalid.example",
    "busybox wget https://invalid.example",
    "true && command env TOKEN=value /usr/bin/curl https://invalid.example",
    "time /usr/bin/curl https://invalid.example",
    "true |& /usr/bin/curl https://invalid.example",
    "timeout --signal TERM 1m curl https://invalid.example",
    "nice --adjustment=1 aria2c https://invalid.example",
    "wget2 https://invalid.example",
    "if /usr/bin/curl https://invalid.example; then true; fi",
    "then wget2 https://invalid.example",
    "while busybox wget https://invalid.example; do true; done",
    "case x in x) /usr/bin/curl https://invalid.example ;; esac",
    "function pull { wget2 https://invalid.example; }; pull",
    "for item in $(curl https://invalid.example); do true; done",
    "artifact=$(curl https://invalid.example)",
    'artifact="$(/usr/bin/wget2 https://invalid.example)"',
    "cu\\\nrl https://invalid.example",
    "/usr/bin/wg\\\net https://invalid.example",
    "httpie https://invalid.example",
)
for mutation in fetch_mutations:
    try:
        assert_no_fetch_bypass("causal-fetch-mutation", mutation)
    except AssertionError:
        pass
    else:
        raise AssertionError(f"fetch mutation was accepted: {mutation}")

git_fetch_mutation = "git -C $work/source/aom fetch --quiet --depth=1 origin deadbeef"
try:
    assert_no_fetch_bypass("internal/stillprocessor/helper/build-pinned-toolchain.sh", git_fetch_mutation)
except AssertionError:
    pass
else:
    raise AssertionError("non-pinned git fetch mutation was accepted")

